msgid "\"A bow.\""
msgstr "\"활.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0015_Text
msgctxt "006fc44a-1624-406d-8aab-97edd72fe593"
msgid "\"A quiver of arrows.\""
msgstr "\"화살통.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0015_Text_1
msgctxt "67e59efe-6f94-457c-b681-2f737d2e42da"
msgid "\"A quiver of arrows.\""
msgstr "\"화살통.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0015_Text_2
msgctxt "5fc8dd5d-8e1b-4e18-9b0f-008ac0817550"
msgid "\"A quiver of arrows.\""
msgstr "\"화살통.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0016_Text
msgctxt "686a0c9c-de4e-4a00-af1e-7aa5bf8ca85f"
msgid "\"A wooden shield.\""
msgstr "\"나무 방패.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0016_Text_1
msgctxt "4f776b10-01d4-49c9-9d0a-cd9aa51d7717"
msgid "\"A wooden shield.\""
msgstr "\"나무 방패.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0016_Text_2
msgctxt "0ee223e8-7079-447c-94d2-b3037afb4c21"
msgid "\"A wooden shield.\""
msgstr "\"나무 방패.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0017_Text
msgctxt "c42f0140-822b-4eed-8914-296ab905e867"
msgid ""
"\"I've changed my mind. Just make whatever you think will come out best.\""
msgstr "\"마음을 바꿨어. 네가 만들 수 있는 최고의 것을 만들어봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0017_Text_1
msgctxt "b7dcc4d5-78f5-4e75-96c0-c6a3a6837e74"
msgid "\"I changed my mind. Just think of something yourself.\""
msgstr "\"마음을 바꿨어. 네가 만들고 싶은 걸 만들어줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0017_Text_2
msgctxt "31447f38-b926-4687-b55a-77773d28a31c"
msgid "\"I've changed my mind. Just think of something yourself.\""
msgstr "\"마음을 바꿨어. 네가 만들고 싶은 걸 만들어줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0023_Text
msgctxt "0bfc1421-e48f-4e1a-948f-9c2fcf456146"
msgid "\"No, Kimo… it was a joke.\""
msgstr "\"안 돼... 키모. 그냥 농담이었어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0023_Text_1
msgctxt "6f790599-858e-4850-a38b-0707e6548224"
msgid "\"No, Kimo... It was a joke.\""
msgstr "\"안 돼... 키모. 그냥 농담이었어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0025_Text
msgctxt "672db183-0f64-490e-a619-05001560261f"
msgid "\"Yes. You must leave, Kimo.\""
msgstr "\"그래... 떠나.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0025_Text_1
msgctxt "e2748a44-0e25-4367-b60f-3a141a039bb5"
msgid "\"Yes. You have to leave, Kimo.\""
msgstr "\"그래... 떠나.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0041_Text
msgctxt "648fc230-4a65-49d3-8358-5ba094d23655"
msgid ""
"\"Do not despair! I'm glad to see you back. We'll think of something, I "
"promise. But for now, you must go rest.\""
msgstr "\"실망하지 마! 너를 다시 봐서 기뻐. 분명 다른 방법이 있을 거야. 일단 가서 쉬어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0042_Text
msgctxt "8b6b0aca-c755-4709-b632-19cbf532cf28"
msgid "\"Don't make any rash decisions, Kimo. Let's talk about it later.\""
msgstr "\"섣부른 판단 하지마. 키모. 다음에 얘기하자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0043_Text
msgctxt "b38261b8-f7f3-47ba-a4cb-6c9b3b8f2124"
msgid "\"Good riddance.\""
msgstr "\"속 시원하다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Answer_0046_Text
msgctxt "54b6dbde-2628-4c09-bba6-a1e71169f116"
msgid "\"Remind me, who are you and what are you working on?\""
msgstr "\"다시 알려줘, 네가 누구고 무슨 일을 했었지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0001_Text
msgctxt "2777c95a-53bb-4222-8969-dc79721d93bd"
msgid ""
"{n}Kimo bows elegantly, a broad smile dancing on his lips.{/n} \"It's ready. "
"I brought you something!\""
msgstr "{n}키모가 우아하게 인사했고 그의 입술에는 미소가 춤을 춥니다.{/n} \"완성됐습니다. 뭔가 보여드리겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0001_Text_1
msgctxt "feebbe31-104c-4995-93c8-7cb5123be05b"
msgid ""
"{n}{d|Kimo}Kimo{/d} bows awkwardly, a broad smile dancing on his lips.{/n} "
"\"It is ready. I brought you something!\""
msgstr "{n}키모가 우아하게 인사했고 그의 입술에는 미소가 춤을 춥니다.{/n} \"완성됐습니다. 뭔가 보여드리겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0006_Text
msgctxt "d8c10572-d944-46ee-b491-7a97d75172c3"
msgid ""
"{n}{d|Kimo}Kimo{/d} can barely contain his excitement.{/n} \"Here you go! "
"I'm all done! It's a very fine bow, I must say… Of course, I always try my "
"best when I'm making something for you. But I've never tried as hard as "
"this! And the wood, it's from... errr... a common friend of ours.\" {n}Kimo "
"winks at you.{/n}"
msgstr ""
"{n}{d|Kimo}키모{/d}는 흥분을 감추지 못합니다.{/n} \"받으세요! 제가 해냈습니다! 장담컨데, 정말 좋은 활이에요... "
"물론, 당신께 드릴 물건을 만들 때는 언제나 최선을 다했습니다만, 이 정도로 공을 들인 적은 처음이에요! 그리고 이 나무는... 음... "
"당신도 아는 사람한테서 받은 거죠.\" {n}키모가 당신에게 윙크합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0010_Text
msgctxt "8f765005-dec8-4cc1-bbef-6ae83755113b"
msgid "\"A special piece? Why, of course, my pleasure! What sort exactly?\""
msgstr "\"특별한 걸 만들어달라고요? 물론 만들어 드리죠! 어떤 장비가 필요하신지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0010_Text_1
msgctxt "3624fdbf-b294-44a2-a2a9-e6ab33ce1da9"
msgid "\"Specific? Why, of course. With pleasure! But... what exactly?\""
msgstr "\"특정한 것? 뭐, 여부가 있겠습니까! 근데... 뭘 만들면 되죠?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0018_Text
msgctxt "d3a58a70-1604-499a-bcbf-14aa9ec6fe21"
msgid "\"As you wish. I'll think of something.\""
msgstr "\"바라시는 대로. 생각해 보겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0018_Text_1
msgctxt "120a3c52-939c-45eb-8c8d-04573ec1370b"
msgid "\"Fine. I will think of something.\""
msgstr "\"좋아요. 생각해 보겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0019_Text
msgctxt "9b20373d-0473-42df-91f8-ebc2dea6052a"
msgid "{n}The elf gives a leisurely nod.{/n} \"Consider it done.\""
msgstr "{n}엘프가 느긋하게 끄덕입니다.{/n} \"그리하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0019_Text_1
msgctxt "55c4ba10-002a-412f-ab2e-7ce6753afd4e"
msgid "{n}The elf gives a leisurely nod.{/n} \"I will do it.\""
msgstr "{n}엘프는 느긋하게 끄덕입니다.{/n} \"그럴게요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0020_Text
msgctxt "e7c2bd5e-7e0f-4acd-8adf-8a03ebe2143f"
msgid "\"You're welcome!\""
msgstr "\"천만에요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0020_Text_1
msgctxt "5a565952-c2f2-4343-9070-b65914668935"
msgid "\"You are welcome!\""
msgstr "\"천만에요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0021_Text
msgctxt "af1a766c-0b10-4b34-9939-835c40d60405"
msgid ""
"{n}Kimo looks at you with wide-open eyes, then looks around the throne room, "
"then stares at you again.{/n} \"So… does that mean… that I have to leave?\""
msgstr ""
"{n}키모는 눈이 휘둥그레져서 알현실 주위를 돌아보더니 당신을 다시 봅니다.{/n} \"그러니까... 그 말은... 저 보고 떠나라는 "
"말씀이신가요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0021_Text_1
msgctxt "ea9a46da-8a69-4a3f-a01f-f9a8ff1731ba"
msgid ""
"{n}Kimo looks at you with wide eyes, looks around the throne room, then "
"stares at you again.{/n} \"So... does that mean... Do I have to leave?\""
msgstr ""
"{n}키모는 눈이 휘둥그레져서 알현실 주위를 돌아보더니 당신을 다시 봅니다.{/n} \"그러니까... 그 말은... 제가 떠나야 되나요?"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0022_Text
msgctxt "b2ed2f56-e7e5-4822-902f-dadbc13a208e"
msgid "{n} The elf heaves a sigh of relief.{/n}"
msgstr "{n}엘프는 안도의 한숨을 쉽니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0022_Text_1
msgctxt "01c33f70-3fb6-4a34-aa88-6605b9fefe66"
msgid "{n}The elf gives a sigh of relief.{/n}"
msgstr "{n}엘프는 안도의 한숨을 쉽니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0026_Text
msgctxt "bd4df72a-581f-44f7-ad00-54ef8090fa27"
msgid ""
"\"Mhm. I see…\" {n}The elf furrows his brow in concentration.{/n} \"I do not "
"fully understand the laws of these lands… I just want to say I am very glad "
"I met you. And I'm sad that I have to leave. But, if that is what I must do… "
"Farewell, {name}!\""
msgstr ""
"\"음... 알았어요.\" {n}엘프는 생각에 잠겨 미간을 찌푸립니다.{/n} \"이 땅의 법이 어떤지 잘 모르지만... 당신을 만나 "
"즐거웠습니다. 떠나야 한다니 슬프네요. 하지만 그래야만 한다면... 잘있어요, {name}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0026_Text_1
msgctxt "0340e993-0e77-40ad-b5f8-c0a2b88845af"
msgid ""
"{n}The elf furrows his brow in concentration.{/n} \"I do not fully "
"understand the laws of these lands... I just want to say that I am very glad "
"I met you. And I am sad that I have to leave. But, if that is what I must "
"do... Farewell, {name}!\""
msgstr ""
"{n}엘프는 생각에 잠겨 미간을 찌푸립니다.{/n} \"이 땅의 법이 어떤지 잘 모르지만... 당신을 만나 즐거웠습니다. 떠나야 한다니 "
"슬프네요. 하지만 그래야만 한다면... 잘있어요, {name}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0028_Text
msgctxt "772cff56-c2eb-43f4-a5c7-be2e6671f7de"
msgid ""
"{n}Just as he's about to leave, Kimo stops and turns to you.{/n} \"Oh, yes, "
"by the way! I needed to ask you something… Could you please help me?\""
msgstr ""
"{n}키모는 떠나려다가 멈춰서 당신을 돌아 봅니다.{/n} \"아, 맞다. 그게 있었지! 부탁드릴게 있는데... 저 좀 도와주시겠어요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0028_Text_1
msgctxt "1cec7140-abbc-45af-9a48-c530dc99b079"
msgid ""
"{n}Kimo coughs in his fist, clearly embarrassed.{/n} \"I almost forgot... "
"Please, come and talk to me! I... I have to ask you something. Something "
"personal.\""
msgstr ""
"{n}키모는 주먹에 대고 헛기침을 합니다. 당황한 기색이 완연합니다. {/n} \"잊어버릴 뻔했네... 부디, 저를 찾아와서 얘기좀 "
"해요! 그... 부탁드릴게 좀 있어서요. 개인적으로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0030_Text
msgctxt "98a1a304-c486-4664-90ed-5c090e98e7ee"
msgid "\"Come to my place. I'll tell you everything.\""
msgstr "\"제 집으로 와주세요. 모두 말씀 드릴게요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0036_Text
msgctxt "9f30732f-6adf-401a-b551-bef7b471e573"
msgid "{n}Red as a lobster, Kimo leaves the throne room.{/n}"
msgstr "{n}키모는 랍스터처럼 얼굴이 붉어지더니 알현실을 떠납니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0037_Text
msgctxt "d1df9ac3-a76c-40c1-81d1-9b772c0e3712"
msgid "{n}His face drawn and haggard, {d|Kimo}Kimo{/d} bows to you.{/n}"
msgstr "{n}키모는 시무룩해져서 당신에게 인사합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0038_Text
msgctxt "f7278bdd-6749-48a6-9e19-73358c34c241"
msgid ""
"\"Forgive me for not coming for so long. And please accept this humble gift –"
" my final gift to you.\""
msgstr "\"찾아 뵌지 너무 오래되서 죄송합니다. 부디 이 작은 선물을 받아주시길. 당신께 드리는 마지막 선물이에요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0039_Text
msgctxt "9dc8bef1-e7c1-4e58-a13d-aa8fbdc2c112"
msgid ""
"\"She has rejected me. She will not listen to my pleas. My work has no sense "
"anymore – just as my life. I shall bid you farewell and leave these lands "
"forever.\""
msgstr ""
"\"그녀가 저를 차버렸어요. 아무리 애원해도 들어주지 않겠죠. 제 작업은 더 이상 의미가 없어요. 제 인생처럼 말이죠. 작별을 고하고 이 "
"땅을 영원히 떠나겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0044_Text
msgctxt "3d7395d0-bcb3-475f-9adb-b5b3451ee179"
msgid "{n}Kimo shrugs.{/n} \"As you wish…\""
msgstr "{n}키모가 어깨를 으쓱합니다.{/n} \"그러시지요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0045_Text
msgctxt "da480211-ec7a-4ad5-b1c5-7699d5a000c7"
msgid ""
"\"Farewell, {name}. You've helped me on this path – but you couldn't have "
"known where it would lead me.\" {n}Kimo sighs deeply and leaves the throne "
"room.{/n}"
msgstr ""
"\"안녕히, {name}. 당신께 도움을 많이 받았는데, 당신도 일이 이렇게 될 줄은 모르셨겠지요.\" {n}키모는 깊은 한숨을 쉬고는 "
"알현실을 떠납니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/KTC_Gift/Cue_0047_Text
msgctxt "3d5fc9c4-ec80-413b-9b70-b4742afe477c"
msgid ""
"\"I'm Kimo, Kimo Tavon! A carpenter, engraver and so on. I can make bows, "
"and spears and staffs too… but my bows are the best! I have something "
"special in mind – a bow that will shoot an arrow's deadly reflection with "
"each shot. I will make it, I know it! If only my inspiration doesn't fail me."
"\""
msgstr ""
"\"키모입니다. 키모 타본! 목수이자, 판화가이자 기타 등등이지요. 활이나 창을 만들 수 있고 지팡이도 만들고... 하지만 그 중에서도 "
"제 활이 최고죠! 전 특별한 것을 구상중입니다 - 쏘는 화살마다 치명적인 반향을 갖는 활이죠. 전 해낼 겁니다, 알 수 있어요! 제 "
"영감이 절 망치지만 않으면 말이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0003_Text
msgctxt "57430050-dc1c-480c-b07d-022a322e7ec2"
msgid "\"You wanted to ask something of me…\""
msgstr "\"나에게 부탁하고 싶은 게 있다고 했지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0003_Text_1
msgctxt "82dfa3a9-57c3-4784-9913-6c8b5d94560d"
msgid "\"Why did you want that flower so bad?\""
msgstr "\"왜 그렇게 꽃을 원하는 거야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0004_Text
msgctxt "0065ffab-bedf-4229-bcd2-89fe05d597ae"
msgid "\"Where do you hail from, Kimo?\""
msgstr "\"너는 어디에서 왔지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0004_Text_1
msgctxt "5e99f402-b2f0-47aa-98cb-6ace608c8a9b"
msgid "\"Where do you hail from, Kimo?\""
msgstr "\"너는 어디에서 왔지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0005_Text
msgctxt "ba3fa6ac-9a2a-4057-b019-e395916c9d4e"
msgid "\"What made you leave Kyonin?\""
msgstr "\"쿄닌을 떠난 이유가 뭐지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0005_Text_1
msgctxt "9f46c9b4-e6c0-4c7d-b09c-3a4986cedcfa"
msgid "\"Why did you leave Kyonin?\""
msgstr "\"쿄닌을 떠난 이유가 뭐지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0013_Text
msgctxt "6f47916a-1831-41f2-ab2b-c61b55403d23"
msgid "\"And?\""
msgstr "\"그리고?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0014_Text
msgctxt "b67d0481-0207-4d6a-8f77-ccb464d99480"
msgid "[Say nothing]"
msgstr "[아무 말도 하지 않습니다]"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0015_Text
msgctxt "81d4309f-3ba2-4d59-ab91-2025b7fb6573"
msgid "\"I see. No need to tell me anything, then.\""
msgstr "\"좋아. 나에게 말할 필요는 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0018_Text
msgctxt "47fc43ed-528f-4312-884c-0569c0b381c6"
msgid "\"Are you going to tell me or what?''"
msgstr "\"말 할 거야? 말 거야?''"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0019_Text
msgctxt "0ccc52fb-6dfe-4d96-9198-b297d7a54653"
msgid "\"Kimo…\""
msgstr "\"키모…\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0024_Text
msgctxt "a7a7b7f3-1401-4906-8e49-34eb3b89b740"
msgid "\"I'm happy for you.\""
msgstr "\"덕분에 기쁘군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0026_Text
msgctxt "9243f9f8-f235-49cf-b53a-f61c1ac124e1"
msgid "\"You can't be serious…\""
msgstr "\"장난이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0030_Text
msgctxt "73a70387-c748-41f5-9f1d-b712b15466bf"
msgid "\"I'm sick and tired of you!\""
msgstr "\"나는 이제 네가 질렸어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0032_Text
msgctxt "026c947d-c44a-44a7-9760-1a955fdde4c1"
msgid "\"I must go.\""
msgstr "\"나는 가야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0033_Text
msgctxt "1a52366c-74b6-4baf-bab4-eb0dfa8c2f2d"
msgid "\"What did you want to ask me?\""
msgstr "\"나에게 무얼 부탁하고 싶지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0038_Text
msgctxt "546928c9-975a-4ad4-9146-1cfebf388cfb"
msgid "\"Tell me exactly what you need.\""
msgstr "\"네가 원하는 걸 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0039_Text
msgctxt "acc61fdd-20eb-4134-8a9a-b64af80cb80c"
msgid "\"You seem to put a lot of trust in this hunter's opinion.\""
msgstr "\"사냥꾼의 의견을 너무 믿는 것 같군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0040_Text
msgctxt "c2b71dce-dc5a-4eda-be23-1f055a4eaee1"
msgid "\"So be it.\""
msgstr "\"그러라지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0043_Text
msgctxt "d2aee2bd-0221-419d-b432-27a92364774f"
msgid "\"I'm not interested.\""
msgstr "\"흥미 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0044_Text
msgctxt "72e325ed-62fc-4681-8e60-69e771fceb64"
msgid "\"I'll think about it.\""
msgstr "\"생각해보지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0055_Text
msgctxt "7c2c51d7-767d-4ac5-a2fb-89370f055333"
msgid "\"Take a look – is this necklace any good?\""
msgstr "\"이 목걸이가 좋은 걸까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0064_Text
msgctxt "463c76d3-fa3e-4d56-ac68-1d8106cc083c"
msgid "\"Tell me what went wrong between you two. You had a fight?\""
msgstr "\"너희 둘 사이에서 문슨 일이 있었는지 말해줘. 싸운 거야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0066_Text
msgctxt "e166589f-b825-4795-aa52-42115feab34a"
msgid "\"What do you mean, she 'hid in her tree'?''"
msgstr "\"그녀의 나무에 숨었다니. 무슨 소리야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0068_Text
msgctxt "7cd0a71f-ce23-4908-8cde-4d1c0f70fc0e"
msgid "\"Show me on the map where to find her.\""
msgstr "\"어디서 그녀를 찾아야 할지 지도에 표시해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0069_Text
msgctxt "e58972ad-305f-4d2b-98a1-1386b8ae1914"
msgid "\"I see. Well, I have no wish to interfere in your affairs.\""
msgstr "\"이해했어. 나는 네 일에 참견하고 싶지 않아\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0073_Text
msgctxt "009d85f8-b152-4510-8645-ed9b3686bf15"
msgid "\"I've had a chat with your dryad.\""
msgstr "\"네 드라이어드와 대화했어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0076_Text
msgctxt "2191321e-b238-478d-9284-96bdd9423aa9"
msgid "\"Go to her. She's waiting for you.\""
msgstr "\"그녀에게 가. 너를 기다리고 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0077_Text
msgctxt "9d4238d6-55b9-4df9-afdd-d4151d0458b6"
msgid "\"It didn't work out… Sorry, Kimo.\""
msgstr "\"소용이 없었어... 미안. 키모.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Answer_0077_Text_1
msgctxt "1fa5d884-5f32-4e7c-949f-07158fca9663"
msgid "\"It didn't work out... I'm sorry, Kimo.\""
msgstr "\"소용이 없었어... 미안. 키모.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0001_Text
msgctxt "28fd4c40-7fa6-4608-b4ce-84aa1600e118"
msgid "{n}Kimo smiles at you absent-mindedly.{/n} \"Good day!\""
msgstr "{n}키모가 멍하니 웃습니다.{/n} \"안녕하세요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0001_Text_1
msgctxt "64f4af5a-82fe-42b4-a4bf-f5aecbe97db9"
msgid "{n}{d|Kimo}Kimo{/d} smiles at you absentmindedly.{/n} \"Good day!\""
msgstr "{n}키모가 당신을 보고 멍하니 웃습니다.{/n} \"안녕하세요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0006_Text
msgctxt "3cb84b3f-d877-4ef7-ad06-a40846cf08c8"
msgid ""
"{n}Kimo closes his eyes in reverie.{/n} \"Kyonin. The land of the elves. The "
"land of springs and forests. That is where I learned my craft…\""
msgstr "{n}키모가 떠올리듯 말합니다.{/n} \"쿄닌. 엘프의 땅. 봄과 숲의 땅. 제가 기술을 배운 곳이죠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0006_Text_1
msgctxt "2d71b61a-c3a9-414c-ad31-4bec583f6cca"
msgid ""
"{n}Kimo closes his eyes in reverie.{/n} \"Kyonin. The land of the elves. The "
"land of springs and forests. That is where I learned my craft...\""
msgstr "{n}키모가 떠올리듯 말합니다.{/n} \"쿄닌. 엘프의 땅. 봄과 숲의 땅. 제가 기술을 배운 곳이죠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0007_Text
msgctxt "6e9ad30d-ef20-4fb1-a828-75d75c0541c3"
msgid "\"You'd love it there. Everyone does.\""
msgstr "\"당신도 그곳이 마음에 들겁니다. 모두들 그러니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0007_Text_1
msgctxt "7207626e-da9d-4916-aeb5-8eb2c11c2642"
msgid "\"You would love it there. Everybody does.\""
msgstr "\"당신도 그곳이 마음에 들겁니다. 모두들 그러니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0008_Text
msgctxt "e5d91571-c287-47c0-82f8-114b3eea6151"
msgid ""
"\"But you must have been there already. And if not, then you should go! You "
"won't regret it.\""
msgstr "\"이미 가봤을테지만, 안가봤다면 꼭 가보세요! 후회하지 않을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0008_Text_1
msgctxt "144e1494-c0af-4a9f-9b62-6032091ee0e2"
msgid ""
"\"Nobody made me leave!\" {n}Kimo gives you an embarrassed look.{/n} \"I "
"just woke up one day, looked out the window… and the road called. And I went!"
"\""
msgstr ""
"\"특별한 이유는 없어요!\" {n}키모는 당황하여 당신을 봅니다.{/n} \"어느날 일어나서 창 밖을 봤는데... 길이 저를 불렀죠. "
"그래서 떠났습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0009_Text
msgctxt "196ccfe6-187a-4601-af4c-1cf7350f4933"
msgid ""
"\"Nobody made me leave.\" {n}Kimo glances at you sideways.{/n} \"I just woke "
"up one day, looked out the window... and the road called. And I went.\""
msgstr ""
"\"특별한 이유는 없어요.\" {n}키모는 곁눈질로 당신을 봅니다.{/n} \"어느날 일어나서 창 밖을 봤는데... 길이 저를 불렀죠. "
"그래서 떠났습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0009_Text_1
msgctxt "d3a0640d-4f6c-436a-b23f-e61821048f96"
msgid ""
"\"Oh! I don't want to tell! But since you asked me, it would have been "
"awkward if I refused.\""
msgstr "\"으! 별로 말하고 싶지 않네요! 하지만 당신이 묻는데 대답하지 않으면 그것도 어색하겠죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0010_Text
msgctxt "d3b9b449-9346-4c53-b48a-e0fa6a39edd9"
msgid "\"What?\""
msgstr "\"네?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0011_Text
msgctxt "682aa980-d0bf-4164-9bfa-c85e95295bba"
msgid ""
"\"But you must have been there already. And if not, then you should! You "
"won't regret it.\""
msgstr "\"이미 가봤을테지만, 안가봤다면 꼭 가보세요! 후회하지 않을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0016_Text
msgctxt "7ef5d980-edb3-433d-8ad0-8ff351925d3b"
msgid "\"Well… fine then.\" {n}The elf sounds somewhat disappointed.{/n}"
msgstr "\"그럼... 됐습니다.\" {n}엘프는 실망한 것 같습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0017_Text
msgctxt "9db539cf-64c2-453e-91ae-ec01c5891327"
msgid ""
"{n}The elf awkwardly picks at the ground with the toe-cap of his boot.{/n}"
msgstr "{n}엘프는 어색하게 발끝으로 땅을 두드리고 있습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0020_Text
msgctxt "d2aabbc8-def5-4fd4-a9c0-fb46ae3e06ea"
msgid "\"Alright, alright…\" {n}The elf takes a deep breath.{/n}"
msgstr "\"좋아. 좋아...\" {n}엘프는 깊은 숨을 쉽니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0021_Text
msgctxt "4f65185d-0a16-4cfa-924d-d6e4082f638d"
msgid "\"I… I am in love. With a lady in the forest.\""
msgstr "\"저는... 사랑에 빠졌어요. 숲의 여인에게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0022_Text
msgctxt "5400cda8-a948-42f7-8ae4-857afcb798ce"
msgid "\"Well…\""
msgstr "\"그럼…\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0027_Text
msgctxt "9faa36d2-5401-4dd6-b4d9-a6f6e75f2378"
msgid ""
"\"That flower was for her. I cannot tell you who she is. But she had hidden "
"herself from me, and that is what darkens my days.\""
msgstr ""
"\"그 꽃은 그녀를 위한 겁니다. 그녀가 누군지 말해줄 순 없어요. 하지만 그녀가 저를 피해 숨어버렸고, 그 후로 제 하루 하루에 어둠이 "
"드리웠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0028_Text
msgctxt "4168301a-17f1-41bb-9815-efeac8986b40"
msgid "\"Thank you! If only I could be happy as well…\""
msgstr "\"고맙습니다! 저도 행복하면 좋을 텐데요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0029_Text
msgctxt "f6fb390a-d1d6-4ebc-91b0-b32c13ec8a01"
msgid "{n}{d|Kimo}Kimo{/d} gives you a dreary nod.{/n} \"Good day…\""
msgstr "{n}{d|Kimo}키모{/d}는 우울하게 당신을 봅니다.{/n} \"안녕하세요…\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0031_Text
msgctxt "40bb15d9-40ee-48df-8cb5-bcf94647c1a1"
msgid ""
"{n}Kimo looks at you with regret.{/n} \"Forgive me, friend! I did not wish "
"to disappoint you…\""
msgstr "{n}키모는 후회하는 눈빛으로 당신을 봅니다.{/n} \"용서해주세요, 친구여! 당신을 실망시키고 싶지 않았어요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0034_Text
msgctxt "b6f2a1d0-725f-404c-8952-3367c3b1be5c"
msgid "\"You won't believe this! It's about her!\""
msgstr "\"믿겨지시나요? 그녀가 말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0035_Text
msgctxt "a486ea7a-1d90-430b-ad4d-05070f80b4dd"
msgid "\"She finally agreed to go on a date with me! I need to get ready!\""
msgstr "\"그녀가 드디어 저를 만나주겠다네요! 어서 준비해야겠어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0036_Text
msgctxt "9856b0d1-9835-44fb-be5d-7db52eadac73"
msgid ""
"\"A hunter I know said that you only need one thing to woo a lady: a gift. "
"Maybe... maybe an emerald necklace would do! But I wouldn't even know where "
"to start looking for such a thing! Please, help me. I will repay you, I "
"promise.\""
msgstr ""
"\"제가 아는 사냥꾼이 그러는데 여자에게 구애하기 위해 필요한 것은 단 한 가지, 바로 선물이라 합니다. 아마... 아마도 에메랄드 "
"목걸이면 충분할 겁니다! 하지만 그런 걸 어디에서 찾아야 할지 도통 감을 못잡겠네요! 제발, 도와주세요. 보답할게요, 약속해요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0041_Text
msgctxt "ed090a64-64c5-4d5e-afc3-ddda4d441f52"
msgid ""
"\"Well… I don't really know… But surely, something that can't be found in "
"every shop or roadside tavern.\""
msgstr "\"그게... 정말 잘 모르겠어요... 확실한 건, 길가 선술집이나 상점을 뒤진다고 나올 물건은 아닐겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0042_Text
msgctxt "9e2b63a6-cfad-40c5-b8e8-6469237473ae"
msgid ""
"\"He talks a lot, and the other villagers listen to him.\" {n}Kimo bends "
"over and whispers in a conspiratorial tone.{/n} \"To be completely honest, I "
"sometimes think that he's… you know… a bit slow.\" {n}The elf gives you a "
"meaningful glance, his eyebrows raised high.{/n} \"But he has a lot of "
"experience. He knows a lot of things that I have no idea about!\""
msgstr ""
"\"그는 많은 얘기를 해주고, 마을 주민들은 그 얘기를 들어줍니다.\" {n}키모는 허리를 숙여 조용히 당신에게 속삭입니다.{/n} "
"\"솔직히 나는 가끔 그가... 뭐랄까... 좀 둔하다고 생각해요.\" {n}엘프는 눈썹을 치켜올리며 당신에게 의미심장한 눈길을 "
"보냅니다.{/n} \"하지만 그는 경험이 풍부합니다. 제가 전혀 몰랐던 것도 많이 알고 있죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0045_Text
msgctxt "1556d929-e086-4044-a875-f6a391b4f392"
msgid ""
"\"I knew it!\" {n}Kimo is as happy as a cat that's found a pot of cream.{/n} "
"\"You are always so kind! And I will help you in return – you'll see!\""
msgstr ""
"\"그럴줄 알았어요!\" {n}키모는 물고기 만난 고양이처럼 행복해 합니다.{/n} \"당신은 언제나 친절하시군요! 언젠가는 꼭 은혜를 "
"갚겠습니다. 정말로요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0047_Text
msgctxt "532cdc7a-0ff7-4e73-8b85-54db1a1c00fd"
msgid ""
"{n}Kimo is scratching his head helplessly.{/n} \"Of course, {name}. As you "
"wish! Thanks for hearing me out…\""
msgstr ""
"{n}키모는 힘없이 머리를 긁습니다.{/n} \"물론이죠, {name}. 바라시는 대로! 제 이야기를 들어주셔서 고맙습니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0048_Text
msgctxt "7c1e1cf3-b622-42f8-8bea-09eb84f2dd38"
msgid ""
"\"Oh, thank you so much! That's very noble of you – after all, you're so "
"busy all the time…\" {n}Kimo's face radiates wholehearted gratitude.{/n} "
"\"Take as much time as you need.\""
msgstr ""
"\"오, 정말 감사드립니다! 정말 고결하시군요. 항상 분주하신 이유가 있었네요...\" {n}키모의 얼굴에 감사의 기색이 "
"완연합니다.{/n} \"편히 있다 가십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0049_Text
msgctxt "422ffede-61e2-43a1-8baf-49d6e89ed5d0"
msgid ""
"\"I'll come up with something so… so special…\" {n}Kimo's gaze wanders far "
"away.{/n}"
msgstr "\"아주... 아주 특별한 걸 떠올려 보겠습니다...\" {n}키모의 시선이 먼 곳을 떠돕니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0059_Text
msgctxt "48c22d11-90e4-4695-82a7-a74d1718f9d5"
msgid "{n}Kimo looks dumbfounded.{/n} \"How pretty!\""
msgstr "{n}키모는 어안이 벙벙한 표정입니다.{/n} \"이렇게 예쁠수가!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0060_Text
msgctxt "7654d616-56a4-4ec4-9aa3-e294715f02e5"
msgid "{n}Kimo nods absent-mindedly.{/n}"
msgstr "{n}키모는 멍하니 끄덕입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0062_Text
msgctxt "5a6303be-6c03-493b-9be9-3a2fb5d4f46e"
msgid ""
"{n}A happy, dreamy smile blooms on the elf's face. The next moment, however, "
"his eyes widen, and huge beads of sweat cover his forehead.{/n}"
msgstr ""
"{n}엘프의 얼굴에 행복하고 몽환적인 미소가 피어납니다. 하지만 다음 순간, 눈이 휘둥그레지며 이마가 땀으로 흥건해집니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0063_Text
msgctxt "2c03a34e-7252-47e8-930a-26f37e09cd51"
msgid ""
"\"Then… then I should go.\" {n}Kimo gulps and gives you a weary sideways "
"look.{/n} \"Thanks, {name}. You've done me a great service. I already know "
"how I shall repay you – I'll make you a bow. The best bow in the world! But "
"now I must go.\" {n}Kimo exhales decisively and slowly walks away.{/n}"
msgstr ""
"\"그럼... 그럼 전 가보겠습니다.\" {n}키모는 침울 꿀꺽 삼키고는 시무룩한 표정을 짓습니다.{/n} \"고맙습니다, {name}. "
"제게 큰 도움이 되었습니다. 제가 당신에게 어떻게 보답해야 할지 이미 알고 있습니다. 제가 활을 만들어 드리죠. 세계 최고의 활을! "
"하지만 지금은 가봐야겠어요.\" {n}키모는 결심한 듯 숨을 내쉬고는 천천히 걸어나갑니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0065_Text
msgctxt "9012d229-8bd5-47fb-a04d-869a74160b67"
msgid ""
"\"I don't know… Everything went so well after our first date. We spent every "
"day together. We talked, we gathered flowers, we watched the clouds pass by… "
"And then, one evening, she said 'goodbye' – and hid herself inside her tree. "
"She hasn't shown her face or said a word to me ever since. No matter how "
"many times I've asked...\""
msgstr ""
"\"모르겠습니다... 첫 만남 이후로 모든게 괜찮았어요. 우리는 매일 함께 했죠. 이야기도 하고 꽃도 같이 모으고 하늘의 구름도 같이 "
"보고... 그런데 어느 날 밤 그녀가 작별 인사를 하고는 자기 나무에 숨어버렸습니다. 그 후로 말을 걸지도 모습을 보이지도 않아요. "
"아무리 말을 걸어도 소용이 없었죠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0071_Text
msgctxt "fdbeb0c2-e743-49fb-8380-2e8e979ea507"
msgid ""
"{n}Kimo heaves another heavy sigh.{/n} \"She's a dryad… Her body and spirit "
"are tied to an oak. She takes care of it and protects it. I met her when I "
"was in the forest, trying to find my way to this settlement.\""
msgstr ""
"{n}키모는 깊은 한숨을 쉽니다.{/n} \"그녀는 드라이어드입니다... 몸과 영혼이 오크 나무에 묶여있지요. 그녀는 그 나무를 돌보고 "
"보호해요. 숲에서 이 마을을 찾아 돌아다닐 때 그녀를 만났었죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0072_Text
msgctxt "08f59c5a-1c7e-459e-a285-67301548e193"
msgid ""
"\"But you can't help… Her heart knows no mercy. You cannot change her wooden "
"mind…\""
msgstr "\"소용없을 겁니다... 그녀의 마음에 자비란 없어요. 당신이라도 그녀의 목석같은 마음을 돌리진 못할겁니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0074_Text
msgctxt "06e2d4c9-0d2f-483b-a391-1c4cc50aeb0f"
msgid "\"And?\" {n}The elf's fingers are twisting into a knot.{/n}"
msgstr "\"그래서요?\" {n}엘프는 손을 비비 꼬며 기다립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0078_Text
msgctxt "d8cf5eee-daf4-4039-9e0a-2648b9ae80ac"
msgid "\"It can't… it can't be! Thank you, {name}!\""
msgstr "\"오. 이럴 수가! 감사합니다, {name}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0078_Text_1
msgctxt "a0d50bf5-a632-46ad-8efe-9ceaded680f9"
msgid "\"It... it cannot be! Thank you, {name}!\""
msgstr "\"오. 이럴 수가! 감사합니다, {name}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0079_Text
msgctxt "f88c6203-7d7a-46f8-bfa1-203c8a6b19c5"
msgid "\"I knew this would happen. Thank you for at least trying...\""
msgstr "\"이렇게 될 줄 알았습니다. 그래도 시도해줘서 고맙습니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/MainDialogue/Cue_0079_Text_1
msgctxt "1006d6ef-def6-41b5-8bb2-338d53f03c77"
msgid ""
"\"I knew this would happen. Thank you for at least trying… It's time for me "
"to go. Far, far away from here.\""
msgstr ""
"\"\"이렇게 될 줄 알았습니다. 그래도 시도해줘서 고맙습니다... 저는 이제 떠날 시간이네요. 이곳에서 멀리, 아주 먼 곳으로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/ElvenMaleWoodmasterCG/SwampPranks_Event_String
msgctxt "b0215b25-d2f0-4729-8dc4-a56c11a3bbde"
msgid "Bog Mischief"
msgstr "늪지 장난"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/Barks/Bark_ClickAfterErrandCompleted_String
msgctxt "3c9701d6-9941-4c9c-8d18-997f7d0b2cf4"
msgid ""
"\"I can't wait to get back to work, Your {mf|Grace|Grace|Highness|Highness}! "
"I'm so excited to see my new workshop...\""
msgstr "\"어서 가서 일하고 싶네요, {mf|영주님|영주님|전하|전하}! 새 공방을 볼 생각을 하니 정말 흥분돼요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/Barks/Bark_ClickAfterErrandRefused_String
msgctxt "64d22c7b-9be3-49c8-bbdb-a361c979ee25"
msgid "\"Nice meeting you, Your {mf|Grace|Grace|Highness|Highness}!\""
msgstr "\"만나서 반가워요, {mf|영주님|영주님|전하|전하}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/Barks/TalonPeak_Battle_String
msgctxt "701f69b2-aa1c-432e-a7ca-5ded4cb62f8e"
msgid "\"That'll teach you!\""
msgstr "\"당신도 알게 될 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/Barks/TalonPeak_BeforeDialog_String
msgctxt "41d8c9f3-829a-470c-b0c0-db9f5006cec4"
msgid "\"Here! Help! Help!\""
msgstr "\"여기에요! 도와줘요! 도와주세요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/Barks/TalonPeak_GoHome_String
msgctxt "af0efad3-86fa-47ca-968f-4c1727f5f893"
msgid "\"I should probably get going... Farewell!\""
msgstr "\"이제 가봐야겠네요... 그럼 이만!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/Barks/TalonPeak_Top1_String
msgctxt "56f306cb-ba04-4568-870d-503832cf9a69"
msgid ""
"\"Thank you so, so much, {name}. If it weren't for your help, I... oh well. "
"I think I'll stay here just a bit longer. Don't worry, I'll find my way back."
"\""
msgstr ""
"\"정말 고마워요, {name}. 당신 도움이 없었다면... 오. 저는 여기에 조금 더 머물러야 할 것 같아요. 걱정 마세요. 돌아가는 "
"길은 찾을 수 있으니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/Barks/TalonPeak_Top_String
msgctxt "8de0f9e7-a9fb-4080-b4ef-445df165ff13"
msgid "\"What heavenly beauty...\""
msgstr "\"정말 아름답구나...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Answer_0003_Text
msgctxt "f130c8ea-2321-4224-b278-e4cfa2c1929c"
msgid "\"What is the greatest goldsmith in Restov doing in this backwater?\""
msgstr "\"레스토프 최고의 금세공인이 이런 시골 벽지에서 뭐하는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Answer_0004_Text
msgctxt "4d9ce03a-ce19-47cb-a949-8ec203548ea7"
msgid "\"Why should I help you?\""
msgstr "\"왜 내가 너를 도와야 하지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Answer_0005_Text
msgctxt "9918a383-e04f-435e-9651-30d793095b90"
msgid "\"Very well, you shall have your gemstone.\""
msgstr "\"좋아. 보석을 구해주지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Answer_0006_Text
msgctxt "1e14bef6-1d1b-437c-8554-1482c99f5cc2"
msgid "\"I'll think about it.\""
msgstr "\"생각해 보지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Answer_0007_Text
msgctxt "3fc22697-28b2-4c7c-9678-58a4ff2860a1"
msgid ""
"\"I have many important matters to deal with. I'm sorry, but I can't help "
"you.\""
msgstr "\"달리 해야할 중요한 일이 많아. 미안하지만 도와줄 수 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Answer_0017_Text
msgctxt "4a4efe38-546c-402d-aa0a-6a5e83564dcb"
msgid "\"Please remind me what you asked for.\""
msgstr "\"네가 무엇을 부탁했는지 다시 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Answer_0019_Text
msgctxt "ad7bcfa3-968e-4597-b1fe-3c855efb27cf"
msgid "\"I am still looking for a suitable jewel.\""
msgstr "\"아직도 적당한 보석을 찾고 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Answer_0020_Text
msgctxt "4545b456-7cda-4d06-a193-c689242e7d11"
msgid "\"Here is your emerald.\""
msgstr "\"여기 에메랄드다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Answer_Goodbye_Standard_String
msgctxt "2b3ca990-934e-49b5-9cdf-edd3089bb0c7"
msgid "\"I have to go.\""
msgstr "\"나는 가야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Cue_0001_Text
msgctxt "a11dc391-3713-46b9-a8f0-51ebacbcb37b"
msgid ""
"\"There you are! I've wanted to see you in person for a long time – all of "
"{g|Brevoy}Brevoy{/g} is talking about your feats...\" {n}The girl is smiling "
"curiously. Sizing you up, she finally nods to you.{/n} \"Mim Wobblegander, "
"the greatest goldsmith in {g|Restov}Restov{/g}, at your service! Happy to "
"meet the ruler of this land!\""
msgstr ""
"\"여기 있었군요! 오랫동안 당신을 직접 만나 보고 싶었어요. {g|Brevoy}브레보이{/g}에서 당신의 위업에 대한 얘기가 "
"자자하던데...\" {n}여성은 궁금한 듯 웃습니다. 당신을 훑어보고 그녀는 마침내 끄덕입니다.{/n} \""
"{g|Restov}레스토프{/g} 최고의 금세공인 밈 워블갠더, 여기 대령했습니다. 이 땅의 통치자를 만나서 기뻐요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Cue_0008_Text
msgctxt "72e98800-8f38-44b6-8eb2-d861c822f633"
msgid ""
"\"As you wish, as you wish... Alas, I was thinking about staying for a "
"while. But on the other hand, there are so many other places I want visit!\""
msgstr "\"바라시는 대로... 아이 참, 한동안 머물려고 했었는데. 하지만 그래도 제가 가고 싶은 곳은 아직 많으니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Cue_0009_Text
msgctxt "d8b575ab-7735-4119-89ed-706103677348"
msgid ""
"\"Hmmm. I suppose that'll have to do for now. I'm in no hurry to leave, "
"anyways – the marvelous views you have here are just too good!\""
msgstr "\"흠. 지금은 그걸로 충분한 거 같아요. 어쨌든 서둘러 떠날 생각은 없으니까요. 정말 경치가 끝내주는 곳에 살고 계시네요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Cue_0010_Text
msgctxt "47447728-997b-43b0-aa01-8d5368bbe317"
msgid "\"Wonderful! I shall impatiently await your return.\""
msgstr "\"멋져요! 당신이 돌아오길 목 빠지게 기다릴게요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Cue_0011_Text
msgctxt "d4016c8e-97e4-4d2b-9592-83a9cf2b1bef"
msgid ""
"\"Let's say... if I'm provided an appropriate place to work, I wouldn't mind "
"staying for a while, to draw upon the special inspiration that these lands "
"give me. Of course, I would express gratitude to my patron from time to "
"time, with gifts befitting {mf|his|her} status and my mastery.\""
msgstr ""
"\"음... 적당한 작업 장소를 제공해주시면 한동안 머물지 않을 이유가 없죠. 이 땅이 제게 주는 영감을 특별한 작품으로 승화할 시간이 "
"필요할 테니까요. 물론, 때때로 제 후원자에게 감사를 표할 생각이에요. 그분의 지위와 제 기술에 걸맞은 선물로 말이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Cue_0012_Text
msgctxt "696e09f8-7d33-46b3-aec1-85a8e68e2c04"
msgid ""
"\"Seeking recognition and inspiration! You see, not everyone in "
"{g|Restov}Restov{/g} realizes how unfairly destiny has divided its gifts "
"between me and my competitors. I got all the talent, you see, and they got "
"all the glory and respect. It's all nonsense, though – I'll soon remedy this "
"irksome situation...\""
msgstr ""
"\"인정과 영감을 위해서죠! 그게, 운명의 선물이 저와 제 경쟁자들사이에 얼마나 불공평하게 돌아갔는지를 {g|Restov}레스토프{/g}"
"의 모두가 알고 있지는 않아요. 재능은 모두 나에게 있는데, 이거 봐요, 영광과 존경은 전부 그들의 몫이죠. 완전 말도 안돼요. 그치만, "
"제가 곧 이 넌더리 나는 상황을 바로 잡을 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Cue_0013_Text
msgctxt "a9620594-f3d1-4426-853f-8e6b8fbc2a20"
msgid ""
"\"You know, it's quite beautiful here! The view of a lake, surrounded by "
"picturesque green forest, were inspiration for a lovely brooch design... I "
"do have a sapphire, but no green jewels, and I've no idea who can help me "
"with this. We're surrounded by simpletons here, who know nothing of sublime "
"matters... except for you, of course!\" {n}Mim looks at you meaningfully.{/n}"
msgstr ""
"\"저기, 여긴 정말로 아름다워요! 호수의 풍경이, 그림같은 푸른 숲에 둘러싸인게, 사랑스러운 브로치의 디자인에 영감을 주네요... "
"사파이어는 있는데, 녹색 보석이 없어요. 누가 저를 도울 수 있을 지 모르겠어요. 여긴 얼간이들 밖에 없어서, 이런 고상한 일에 대해서는 "
"아무 것도 몰라요... 물론, 당신은 그렇지 않겠지만! {n}밈이 당신을 의미심장하게 바라봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Cue_0014_Text
msgctxt "428f1421-f129-4c0d-8d8f-c8a88300c6b7"
msgid ""
"\"Aha!\" {n}The girl looks at you with eager impatience.{/n} \"So what about "
"my request?\""
msgstr "\"아하!\" {n}그녀는 안달난 눈빛으로 간절하게 당신을 바라봅니다.{/n} \"그럼 제 요청은 어떻게 됐죠?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Cue_0018_Text
msgctxt "5a370afa-f97a-4e73-ad18-974d0a9c9b0a"
msgid ""
"\"For an emerald. I plan to make a brooch that will combine the hues of "
"these lands – the blue of the cold lake and the green of the young pines. I "
"do have a sapphire, but I'm missing a green jewel...\""
msgstr ""
"\"에메랄드가 필요해요. 저는 이 땅의 빛깔을 담고 있는 브로치를 만들 거예요. 차가운 호수의 푸른색과 어린 나무 숲의 초록색을 담은. "
"사파이어는 갖고 있는데, 녹색 보석이 없어요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Cue_0021_Text
msgctxt "475ec262-26a1-45f6-9078-54778450b0a6"
msgid ""
"{n}Mim's eyes flash.{/n} \"Look at that color! And the size! An excellent "
"item... Finally I'll be able to bring my idea to life!\""
msgstr ""
"{n}밈의 눈빛이 반짝입니다.{/n} \"이 색! 이 크기! 탁월한 물건이에요... 드디어 내 아이디어를 실현할 수 있겠어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Cue_0023_Text
msgctxt "c06d1928-998d-47e1-af78-bc118c9c815d"
msgid "\"I see...\" {n}Mim sighs.{/n}"
msgstr "\"알겠어요...\" {n}밈이 한숨을 쉽니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Cue_0024_Text
msgctxt "ebe4200c-e9c8-4e13-9cd0-db3f6b5a9538"
msgid ""
"\"Wonderful. I am ready to remain here and work for {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}. I only need a place to live and work. "
"I've brought all the necessary tools. All I need is four walls and a roof – "
"and a salary, of course, I do need to eat. But I'll make it up to you!\""
msgstr ""
"\"훌륭해요. 이제 여기 남아 {mf|영주님|영주님|전하|전하}를 위해 일할 준비가 되었어요. 저는 살 곳이랑 일할 곳만 있으면 돼요. "
"필요한 도구는 전부 챙겨왔거든요. 벽 네개랑 지붕만 있으면 충분하죠. 그리고 급료랑 먹을 것도 필요하고요. 물론 그저 받기만 하진 않을 "
"거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/FirstDialogue/Cue_0025_Text
msgctxt "287f84ea-3e60-4a03-ac1c-56475bbb8754"
msgid ""
"\"Besides, I'm mortally tired of {g|Restov}Restov{/g} dust and grayness. And "
"the view from here to the {g|Tors of Levenies}Tors of Levenies{/g} is beyond "
"compare! Just look at those peaks! Such mysterious power in their easy "
"dignity!\""
msgstr ""
"\"게다가, {g|Restov}레스토프{/g}의 먼지와 회색빛이 지겨워 죽겠어요. 그리고 여기서 보는 {g|Tors of Levenies}"
"레베니스 바위산맥{/g}의 경치는 정말 비교를 불허하네요! 저 봉우리들 좀 보세요! 편안함 속에 위엄을 갖춘게 정말 신비로운 힘이 "
"느껴져요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_ArtisanLost/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "9100d61f-44b1-4245-9332-a532c2079dca"
msgid ""
"\"There's a commotion in a village by {g|Lake Silverstep}lake Silverstep{/g}"
"! An artisan you know has gone missing – {d|Mim}Mim{/d} Wobblegander. A "
"local shepherd saw her walking with a backpack toward Talon Peak, but didn't "
"ask her where she was going.\""
msgstr ""
"\"{g|Lake Silverstep}실버스텝 호수{/g} 마을에서 소동이 일어났어요! 당신도 아는 장인 {d|Mim}밈{/d} "
"워블갠더가 사라졌대요. 현지 양치기가 그녀가 짐을 가지고 {g|Tors of Levenies}레베니스 바위산맥{/g} 쪽으로 가는 걸 "
"봤다는데, 정확히 어디로 갔는지는 모르나봐요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_ArtisanLost/Cue_0002_Text
#. Speaker : Linzi_Companion
msgctxt "af3c8c51-0c20-4f0e-97c0-fb6ee2ee9a3e"
msgid ""
"\"I think you should look for her. It's been a few days. She might have "
"gotten herself into a messy situation. I wish I knew what or where!\""
msgstr ""
"\"그녀를 찾아보셔야 할 것 같아요. 며칠이나 지났으니 아마 곤란한 상황에 처했을 수도 있어요. 뭐든지 단서가 있으면 좋겠는데!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_EE_StatGift_Mim/Cue_0001_Text
msgctxt "3692664c-b877-451a-b807-5fc887d56f05"
msgid ""
"\"Greetings!\" {n}Mim's face shines with enthusiasm.{/n} \"The trade in your "
"{mf|barony|barony|kingdom|kingdom} is so lively that I'm literally "
"overflowing with commissions! It's splendid! – The more interesting the "
"challenge, the better!\""
msgstr ""
"\"안녕하세요!\" {n}밈의 얼굴은 열정으로 빛납니다.{/n}\"{mf|남작령|남작령|왕국|왕국}의 거래가 아주 활발해서 말 그대로 "
"주문이 넘쳐나요! 아주 좋아요! 흥미로운 도전일 수록 보람찬 법이니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_EE_StatGift_Mim/Cue_0002_Text
msgctxt "bf327eb4-896a-47d5-a3e2-60d8f63266a8"
msgid ""
"\"Greetings. I've decided to take a break and spent some time traveling your "
"lands, and I'm surprised how well things are going here in your "
"{mf|barony|barony|kingdom|kingdom}! Trade is thriving, and I can easily "
"acquire rare materials and gemstones for my jewelry. And there are so many "
"talented people around! I left Restov to enjoy the peace and solitude of a "
"simple country life, but I must admit — I've missed the company of other "
"artists!\""
msgstr ""
"\"안녕하세요. 저는 당신의 영지를 여행하며 휴식을 취하기로 결정했었고, {mf|남작령|남작령|왕국|왕국}의 모든 것이 얼마나 잘 "
"돌아가는지 보고 놀랐어요! 상업도 번성한 덕분에 제 작품에 필요한 희귀 재료와 보석들을 쉽게 구할 수 있었죠. 재능있는 사람들은 또 "
"어찌나 많은지! 전 한적하고 평화로운 귀촌 생활을 생각하며 레스토프를 떠났었지만, 이건 인정해야겠어요 — 제가 다른 수많은 예술가들과 "
"함께했던 시절을 그리워했다는걸!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_EE_StatGift_Mim/Cue_0003_Text
msgctxt "916945ef-fa8b-4920-a439-05031b9ef08f"
msgid ""
"\"Finally! I have labored long on a special present for you, {mf|Your Grace|"
"Your Grace|Your Highness|Your Highness}. Mim is the best, isn't she?\""
msgstr ""
"\"드디어! 전 당신께 드릴 특별한 선물을 위해 매우 오랜 시간 동안 공을 들였어요. 역시 밈이 최고라니까, 안 그런가요, "
"{mf|영주님|영주님|전하|전하}?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Answer_0003_Text
msgctxt "7641a032-bd5c-4ff9-b6ba-74e9e24dd7a5"
msgid "\"Great. I can't wait to see your next creation.\""
msgstr "\"훌륭해. 네가 다음에 무얼 만들지 기대돼.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Answer_0004_Text
msgctxt "30111810-07ff-485b-b1ec-d3c4ba02ac98"
msgid "\"I wanted to order something specific from you.\""
msgstr "\"네가 특별한 물건을 만들어주었으면 좋겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Answer_0005_Text
msgctxt "2bc2c379-3aa4-43b6-8a58-0283aa9fa7f8"
msgid "\"Thank you. But I don't need your services any more.\""
msgstr "\"고마워. 하지만 지금 네 도움은 필요 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Answer_0007_Text
msgctxt "f567045d-bda8-4d35-89bf-a563df4dce2b"
msgid "\"A ring.\""
msgstr "\"반지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Answer_0009_Text
msgctxt "25a104bb-f3d9-4774-b5d6-869f0b333e08"
msgid "\"An amulet.\""
msgstr "\"목걸이.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Answer_0010_Text
msgctxt "cee76815-2cbb-4e4f-ba32-474b74517e27"
msgid "\"A headband.\""
msgstr "\"헤어 밴드.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Answer_0022_Text
msgctxt "a462b2a4-89a6-404a-9a45-a76e3d7ad828"
msgid "\"I will trust your inspiration.\""
msgstr "\"네 영감을 믿을게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Answer_0024_Text
msgctxt "9fe87c40-2759-4101-81db-035c14993829"
msgid "\"Remind me, who are you and what are you working on?\""
msgstr "\"다시 알려줘, 네가 누구고 무슨 일을 했었지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Cue_0001_Text
msgctxt "d9968543-25b7-493b-896f-0c815bf01024"
msgid ""
"{n}The {d|Mim}goldsmith's{/d} face shines.{/n} \"{mf|Your Grace|Your Grace|"
"Your Highness|Your Highness}! Please accept this humble gift as a token of "
"my deep affection... respect... and whatever else the rules tell me I'm "
"supposed to say. I very much hope you like it – I worked hard on it!\""
msgstr ""
"{n}{d|Mim}금세공인{/d}의 얼굴이 빛납니다.{/n} \"{mf|영주님|영주님|전하|전하}! 부디 이 보잘것 없는 선물을 "
"받아주시옵소서... 저의 깊은 애정과... 존경의 증표로서... 하여튼 정해진 예식에 따라 말씀드리옵나이다. 당신이 좋아해주셨으면 정말 "
"정말 좋겠어요. 되게 열심히 만들었거든요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Cue_0006_Text
msgctxt "57f89c51-a69a-4510-87cc-589f862ec60e"
msgid ""
"{n}Mim wrinkles her nose.{/n} \"You can't dictate genius... But well, I "
"suppose it's your right to try. What can I do for you?\""
msgstr ""
"{n}밈이 코를 찡그립니다.{/n} \"천재에게는 명령할 수 없는 법이지만... 그래요, 그러는 것도 당신의 권리겠죠. 제가 뭘 하면 "
"될까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Cue_0011_Text
msgctxt "56388c2d-b711-46e5-86b7-c74397fa0b7c"
msgid ""
"{n}The master craftsman nods at you pensively.{/n} \"All right... I think I "
"have a draft somewhere...\""
msgstr "{n}장인은 수심어린 표정으로 당신에게 끄덕입니다.{/n} \"알았어요... 어딘가에 그려뒀던 도안이 있을텐데...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Cue_0012_Text
msgctxt "df5d9e89-a1ad-4174-abcc-cfe8d36a7c45"
msgid ""
"{n}Smiling broadly, Mim looks away.{/n} \"Believe me, I won't disappoint you."
"\""
msgstr "{n}활짝 웃으며 밈은 눈길을 돌립니다.{/n} \"저를 믿으세요. 실망하지 않을 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Cue_0013_Text
msgctxt "690e309c-ea0f-436e-9238-e20ba0cc30b4"
msgid ""
"{n}The master craftsman raises an eyebrow, surprised.{/n} \"What, is my "
"jewelry suddenly not good enough? You think too much of yourself... It's "
"sad, too – I was only getting started. Anyway, I'm sure that I'll find a "
"grateful patron in a more civilized land, who can appreciate creative work..."
"\""
msgstr ""
"{n}장인이 놀라 눈썹을 치켜 올립니다.{/n} \"뭐에요, 갑자기 내 장신구가 별로라는 거예요? 정말 안하무인이시네요... 이제 막 "
"시작하려던 참이었는데 참 안타깝게 됐군요. 어쨌든, 저는 좀 더 문명화된 땅에서 창의적인 작업의 진가를 알아보는 고마운 후원자를 "
"찾을거예요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Cue_0015_Text
msgctxt "e7d0853c-b4c4-4ad2-b344-f9c62aca5ddd"
msgid ""
"\"As long as I'm here... I had this brilliant idea. It's going to be "
"something really special. Unique. Perhaps the best thing I've ever done...\" "
"{n}Mim brushes a forelock from her face.{/n} \"It's only... I can't say what "
"it's going to be EXACTLY...\""
msgstr ""
"\"여기 있으면서... 놀라운 생각이 떠올랐어요. 정말 특별하고, 독창적인 물건이 될 거예요. 제가 만든 것 중에 최고가 될지도...\" "
"{n}밈은 머리를 쓸어넘깁니다.{/n} \"아직 확실히 정해진 건 없지만...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Cue_0017_Text
msgctxt "0081e4fc-5a3f-4633-87d4-8a4d02988ca3"
msgid ""
"\"But I know how to figure it out. But to do this, I'll need you to grant me "
"three wishes. One is already fulfilled – there are two more to go. Please "
"visit me in my workshop and I'll tell you more.\""
msgstr ""
"\"확실하게 정하는 법은 알고 있죠. 그러러면 제 세 가지 소원을 들어주셔야 해요. 하나는 이미 들어주셨고, 두 가지가 남았네요. 제 "
"공방에 와주시면 더 자세히 말씀드릴게요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Cue_0018_Text
msgctxt "24f0c788-73d3-4707-a62b-1e750db653a1"
msgid ""
"{n}The {d|Mim}jeweler{/d} bows before you wearily. Her face is full of "
"pride, despite the dark circles under her eyes.{/n} \"It's ready, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}. Don't even ask how long it "
"took me to craft this thing... But I like the result!\""
msgstr ""
"{n}{d|Mim}보석 세공인{/d}이 당신에게 인사하는 모습에 지친 기색이 역력합니다. 눈 밑에 드리운 그늘에도 불구하고, 그녀의 "
"얼굴은 자부심으로 가득합니다. {/n} \"준비됐어요, {mf|영주님|영주님|전하|전하}. 이걸 만드는 데 얼마나 오래 걸렸는지는 묻지 "
"말아주시길... 그래도 결과물이 괜찮거든요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Cue_0021_Text
msgctxt "2934b9f5-fb39-4e1b-84ea-7ddf5f52f047"
msgid ""
"\"I also wanted to tell you that I'm finally ready to start working on my "
"masterpiece! My wishes have been granted! Now I know what I must set myself "
"at creation, and hope I will be able to thank you for your help. Unless you "
"require me to make something else first...\""
msgstr ""
"\"또 말씀드리고 싶은게 있는데, 드디어 제 걸작을 만들 준비가 끝났다는 거예요! 제 소원이 이루어졌으니까요! 이제 창작에 어찌 임해야 "
"할지 알았으니, 어서 당신의 도움에 감사를 표할 날이 왔으면 좋겠네요. 다른 걸 먼저 만들라고 하시지 않는다면 말이죠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Cue_0023_Text
msgctxt "37029196-dd5c-4a59-92c7-71c75c2c78c1"
msgid ""
"\"That means I can create my brilliant design... I can't wait to see your "
"delight when it's ready!\""
msgstr "\"그러면 제가 멋진 도안을 만들어낼 수 있겠죠... 어서 완성시켜서 당신이 기뻐하는 모습을 보고 싶네요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/KTC_Gift/Cue_0025_Text
msgctxt "e86d3c75-b6a0-4644-aeab-341434c2f815"
msgid ""
"\"Mim Wobblegander, the best jeweler of Restov – and your own "
"{mf|barony|barony|kingdom|kingdom} too! My rings and amulets are the best "
"you can imagine. Not only do they grant their wearers extraordinary powers, "
"they are also exceptionally beautiful! Right now I'm seeking inspiration for "
"a true masterpiece – a ring that will bring its wearer luck in every deed, "
"increase {mf|his|her} accuracy and protect {mf|him|her} from curses.\""
msgstr ""
"\"전 레스토프 – 그리고 당신 {mf|남작령|남작령|왕국|왕국} 최고의 보석세공사 밈 워블갠더예요 ! 제가 만든 반지와 목걸이들은 "
"당신이 상상할 수 있는 가장 좋은 물건들이죠. 착용자에게 엄청난 힘을 제공해줄뿐만 아니라 특출나게 아름답기까지 해요! 지금은 진정한 걸작 "
"– 사용자가 행하는 모든 일에 행운을 가져오고, 정확성을 올려주며 저주로부터 보호해주는 반지를 만들기 위한 구상을 하고 있어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Answer_0003_Text
msgctxt "1fc46800-95e5-4728-9779-7d1d856c82ec"
msgid "\"Who taught you goldwork?\""
msgstr "\"누가 너에게 금세공기술을 가르쳐 주었지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Answer_0004_Text
msgctxt "c7da682c-874f-4a94-a30b-29ddbbed41e3"
msgid ""
"\"You mentioned I could grant you three wishes to help you create your "
"masterpiece.\""
msgstr "\"네 작품을 만들기 위해 내가 세가지 부탁을 들어주어야 한다고 했지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Answer_0005_Text
msgctxt "58b74f92-2165-4e61-a5b0-ead8da46941f"
msgid "\"Why did you decide to move here from Restov?\""
msgstr "\"왜 레스토프를 떠나 여기로 올 결심을 했지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Answer_0013_Text
msgctxt "423723f0-552a-4c56-bf3d-f225459e6729"
msgid ""
"\"Isn't it difficult for a master craftsman from the capital to get used to "
"living in the country?\""
msgstr "\"수도에 살던 명장이 시골살이에 적응하는 게 쉽진 않을텐데?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Answer_0016_Text
msgctxt "dda54590-5b80-43b5-aa17-6964f0782bf4"
msgid "\"I have to go.\""
msgstr "\"나는 가야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Answer_0018_Text
msgctxt "faa386c0-323a-4b6b-af68-3792478efa64"
msgid "[Shake the bottle] \"Look what I've got!\""
msgstr "[병을 흔듭니다] \"내가 뭘 가져왔는지 봐봐!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Answer_0021_Text
msgctxt "0c1ea281-6cde-43a8-8891-4e2d26d65242"
msgid ""
"\"I don't get how an alcoholic beverage can help you find inspiration...\""
msgstr "\"술을 먹으면서 어떻게 영감을 얻겠다는 건지 모르겠지만...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Answer_0025_Text
msgctxt "ff8a6b0b-3e18-43e7-b5f6-87e2a2e5e21d"
msgid "\"I see.\""
msgstr "\"알았어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Answer_0027_Text
msgctxt "2179f10e-024a-4827-b36c-4490cfb7df8b"
msgid "\"Why did you have to go to Talon Peak all alone?\""
msgstr "\"왜 탈론 봉우리에 혼자 가야 했지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Answer_0030_Text
msgctxt "cd21c0a7-4754-4ab0-ac1d-6ef5c23e93ef"
msgid "\"How did you learn to make magical items?\""
msgstr "\"마법 물품 만드는 건 어디서 배웠어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Answer_0031_Text
msgctxt "0d780c26-ad77-4c2b-9e8d-77b0b3f9b586"
msgid "\"Do you have enough customers here?\""
msgstr "\"여기서 고객은 충분히 확보를 했나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Answer_0032_Text
msgctxt "34d130e0-9c58-403d-a316-2f732c0acdb5"
msgid "\"I see. Can we talk about something else?\""
msgstr "\"알았어. 다른 이야기를 해볼까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Answer_0041_Text
msgctxt "d5a8dba0-7656-443f-8956-143cfdfe4724"
msgid "\"What about your third wish? You haven't come up with one, have you?\""
msgstr "\"세번째 부탁은 뭐지? 아직 생각 못 했어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0001_Text
msgctxt "8c06e54c-a495-4895-a1e4-0b1712391fca"
msgid ""
"{n}{d|Mim}Mim{/d} blinks vacantly.{/n} \"Oh, it's you, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}. It's good to see you. What can I do for "
"you?\""
msgstr ""
"{n}{d|Mim}밈{/d}은 멍하니 눈을 깜빡입니다.{/n} \"아, 오셨군요, {mf|영주님|영주님|전하|전하}. 만나서 반가워요. "
"뭘 도와 드릴까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0006_Text
msgctxt "f17d5ac0-87a9-47e3-9ffb-8eb2ef0e62d7"
msgid ""
"\"Ah, yes. That's very true. You've granted my first wish. As to the "
"second... They say that ink is the blood of science. In that case, alcohol "
"is the blood of creation.\" {n} The girl gives you a provocative look.{/n}"
msgstr ""
"\"아, 맞아요. 그랬었죠. 당신은 이미 제 첫번째 소원들 이뤄주셨어요. 두번째는... 누가 말하길 잉크는 과학의 피라더군요. 그렇다면 "
"창조의 피는 술이라 할 수 있죠.\" {n} 여성은 도발적으로 당신을 봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0012_Text
msgctxt "3cc299d5-f301-4c3d-8f33-9c25fa3658e9"
msgid ""
"\"My father is a successful watchmaker. His shop supplies the richest "
"families of {g|Brevoy}Brevoy{/g}. When I grew up and it was time to teach "
"me, he decided to 'move from simple to complicated' – to start with the "
"shell, then move on to mechanisms. I learned how to make a golden chain, how "
"to cast a perfectly smooth case, how to etch and ornament and encrust with "
"jewels... and entirely lost interest in springs and gears!\""
msgstr ""
"\"제 아버지는 성공한 시계공이에요. 아버지의 가게는 {g|Brevoy}브레보이{/g}에서 가장 부유한 가문들을 고객으로 두고 있죠. "
"제가 어릴적에 아버지는 '단순한 것 부터 시작해서 복잡한 것까지', 즉 겉부분에서 시작해서 내부구조까지 가르치려고 하셨어요. 저는 금줄을 "
"만드는 법, 완벽하게 매끄러운 상자를 주조하는 법, 새기고, 장식하고, 보석으로 덮는 법 같은 걸 배우다가... 용수철과 톱니바퀴에 대한 "
"흥미를 완전히 잃어버렸죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0014_Text
msgctxt "c58fa4e3-a862-470e-9dbc-44eac5b7e5ee"
msgid ""
"\"I didn't decide any such thing. I just realized all my hair will go gray "
"of boredom if I spend even one more day in {g|Restov}Restov's{/g} mud. I "
"explained it to my father, packed my things and struck off, over the hills "
"and far away. I stopped here mostly because for the scenery. The {g|Tors of "
"Levenies}Tors of Levenies{/g} are the most beautiful thing I have ever seen! "
"I wish I could climb {g|Talon Peak}Talon Peak{/g}... but I can't seem to "
"find the time. And when I do get a free day, the weather is always bad.\""
msgstr ""
"\"결심이랄 것도 없었죠. 문득 이대로 가다간 레스토프의 지루함 속에 늙어죽겠다는 생각이 들었어요. 나는 아버지를 설득해서 짐을 싸서 산 "
"넘고 물 건너 떠나겠다고 했죠. 여기는 경치가 좋아서 머물게 된 거예요. {g|Tors of Levenies}레베니스 바위산맥{/g}은 "
"제가 봤던 것 중에 가장 아름다웠어요! {g|Talon Peak}발톱 봉우리{/g}에도 가보고 싶은데... 시간을 내기 힘들더라고요. "
"어쩌다 시간이 날때면 날씨가 좋지 않았고요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0015_Text
msgctxt "a5a9543f-34c8-4a32-8230-53c5f4b870ee"
msgid ""
"{n}Mim sniffs.{/n} \"Do you mean, getting used to fresh air and clean water? "
"To wearing simple comfortable clothes every day and forgetting about make "
"up? What about not having to watch out for stinky horse piles and puddles "
"wherever you step? Oh yes, it's tough out here.\""
msgstr ""
"{n}밈은 코웃음을 칩니다.{/n} \"그러니까, 신선한 공기가 깨끗한 물에 적응하기가 힘드냐고요? 매일 화장도 없이 옷 편하게 입고 "
"다니는 거? 걸을 때마다 냄새나는 말똥과 오줌을 밟을 걱정을 안해도 되는 거? 그러게요, 여기 정말 살기 힘드네요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0017_Text
msgctxt "ffd58797-e75c-477e-846a-e3412b6c8eee"
msgid ""
"\"Bring me a bottle, if you please. Of either. It will fill my restless "
"creative spirit! Just one gulp, and I will pierce the abyss of existence "
"with a stare... sink down into the bottom of my soul... and finally "
"comprehend what the hell I've been trying to drag from it, into the world!\""
msgstr ""
"\"괜찬다면 부디 제게 술 한 병 가져다 줘요. 제 창작 욕구가 불타오를 거예요! 한모금이면 사물의 본질을 꿰뚫어보는 통찰력이 "
"생겨요... 제 영혼의 밑바닥까지 가라앉고나면... 그제서야 거기서 제가 세상밖으로 끄집어내려는게 도대체 뭔지 이해할 수 있겠죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0020_Text
msgctxt "e21cd1a2-445e-4818-bf6b-dec1b0ef4cb0"
msgid ""
"{n}The girl has an eager gleam in her eyes.{/n} \"Oh, I've been waiting for "
"so long! Thank you so much, {name}... um... {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}!\""
msgstr ""
"{n}소녀는 간절함으로 눈을 반짝입니다.{/n} \"오. 너무 오래 기다렸어요! 정말 고마워요, {name}... 음... "
"{mf|영주님|영주님|전하|전하}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0022_Text
msgctxt "3fdd05d3-9052-4c51-998a-1d93abd34f70"
msgid ""
"\"In that case, you know nothing about the work of an artist, {mf|Your Grace|"
"Your Grace|Your Highness|Your Highness}! But no matter, everyone has their "
"own calling...\""
msgstr ""
"\"그건 예술인에 대해서 아무것도 모르고 하는 말씀이세요, {mf|영주님|영주님|전하|전하}! 뭐, 각자 나름의 소명이 있는 법이긴 "
"하지만요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0026_Text
msgctxt "6cdaaaa2-4d39-4c0b-8201-48d73b77e0b3"
msgid "{n}Mim nods and looks at you expectantly.{/n}"
msgstr "{n}밈은 끄덕이고는 무언가 기대한다는 듯 당신을 봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0033_Text
msgctxt "df604333-18c3-4937-bdce-12ef3ddfefa9"
msgid ""
"\"Thank you for asking, but your own orders are quite enough for me! I'm an "
"artist, not a craftsman. I don't feel the slightest desire to drudge over "
"tasteless trinkets for the wives of merchants and elderly pleasure seekers. "
"Besides, they wouldn't be able to afford my finest creations anyway...\""
msgstr ""
"\"물어봐줘서 고마워요, 하지만 저는 당신의 주문으로도 충분해요! 저는 장인이 아니라 예술가니까요. 저는 상인의 아내나 나이든 한량에게 "
"별거 없는 장신구를 팔려고 노동할 생각은 조금도 없어요. 게다가 어차피 그들은 제 최고 작품에 제 값을 지불할 능력도 없을 거예요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0034_Text
msgctxt "adb15f5e-2b03-48bb-bfd9-6d07e0004b27"
msgid ""
"\"Father insisted, once he realized I wasn't going to work with mechanisms. "
"He said I needed 'to have at least some practical skill', and arranged my "
"apprenticeship with his old client – an grumpy old professor of "
"transmutation. I pouted for a long time, but now I'm grateful – that "
"knowledge has actually come in quite useful.\""
msgstr ""
"\"제가 기계학에 투신할 생각이 없다는 걸 알고난 후, 아버지는 최소한 먹고살 기술은 배워야 한다면서, 저를 아버지의 옛 고객의 조수로 "
"집어넣었죠. 그는 변환술을 가르치는 심술궂은 노교수였어요. 그 일로 오랫동안 토라졌었지만, 이제는 감사하게 생각해요. 확실히 그 지식은 "
"꽤 쓸만했거든요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0035_Text
msgctxt "2285bb28-3f4d-49d4-a8c8-f26677df6394"
msgid ""
"\"Hmm?\" {n}It seems that Mim has again been carried away by the sight of "
"the mountains.{/n} \"Oh yes, of course... Uhh... about what?\""
msgstr ""
"\"음?\" {n}밈은 다시 산의 경치를 보고 넋을 잃은 것 같습니다다.{/n} \"오 그럼요, 물론이죠... 어... 무슨 얘기였죠?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0037_Text
msgctxt "a77a08c4-bbe2-4c99-be61-5b92cd4825c1"
msgid ""
"\"I... I don't completely understand it myself... I woke up that morning and "
"thought – it's now or never.\" {n}Mim sighs and shrugs.{/n} \"And it turns "
"out I was right!\""
msgstr ""
"\"저도... 저도 왜그랬는지 잘 모르겠어요... 아침에 일어나 생각해봤는데 지금 아니면 기회가 없다고 생각했죠.\" {n}밈은 한숨을 "
"쉬고는 어깨를 으쓱합니다.{/n} \"그리고 그게 옳았어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0038_Text
msgctxt "f34f530d-816b-461d-8f5f-06e3407702ba"
msgid ""
"{n}Mim laughs.{/n} \"I wish I knew the answer! But I never gave the decision "
"a second thought. I just grabbed my backpack and stepped out. And it all "
"turned out for the best!\""
msgstr ""
"{n}밈이 웃습니다.{/n} \"나도 왜그랬는지 알았으면 좋겠네요! 하지만 저는 결정을 재고하지 않았어요. 저는 제 배낭을 움켜쥐고 집을 "
"나섰죠. 결국 그건 최선의 결정이었어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0040_Text
msgctxt "120009ab-2c9e-4fff-acb8-966eaae36368"
msgid ""
"\"I have to admit, I have no idea what my third wish should be. I'll tell "
"you as soon as I come up with something. Now if you'll excuse me – art can't "
"wait!\""
msgstr "\"솔직히, 제 세번째 소원이 뭔지 저도 모르겠어요. 생각나는대로 말씀드릴게요. 이제 실례할게요. 예술엔 쉴틈이 없거든요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0042_Text
msgctxt "917cf997-373c-4bc9-8f34-8f830416b5c9"
msgid ""
"\"Not yet. You can't rush the delicate movements of the soul. I can feel it "
"growing within me, and that's all for now.\""
msgstr "\"아직이에요. 영혼의 섬세한 움직임을 재촉할 수는 없어요. 점점 커져가는 느낌이 들긴 하는데, 지금은 그게 다에요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/MainDialogue/Cue_0043_Text
msgctxt "9e4a7e09-6dca-4886-8a77-8e58a297af99"
msgid ""
"\"I don't mean the ordinary tavern booze. I need something delicate... "
"rare... like... like berry wine from {g|Kyonin}Kyonin{/g}! Or even... Oh "
"lord! Elven absinth!\" {n}She slaps her head, freezes for a second – and "
"starts speaking faster and faster, and waving her hands in excitement.{/n} "
"\"Why, of course! Why didn't I think of that? Elves! They're so close to the "
"nature. To be one with nature! That's the unity I'm looking for!\""
msgstr ""
"\"평범한 술집의 술을 말하는 게 아니예요. 저는 뭔가 섬세하고... 희귀한... 뭐냐... 이를테면... {g|Kyonin}쿄닌{/g}"
"산 베리 와인 같은거요! 아니면... 오 주여! 엘프 압생트는 어떨까요!\" {n}그녀는 자신의 이마를 치더니 잠시 얼어붙습니다. "
"그리고는 흥분해서 손을 흔들며 말이 점점 빨라지기 시작합니다.{/n} \"맞아! 왜 그 생각을 못했지! 엘프야! 엘프는 자연과 아주 "
"가까워요. 자연과 하나가 되죠! 그 합일이 제가 찾던 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0004_Text
msgctxt "efe9e1f4-2239-4919-833b-77f06d71fbd0"
msgid ""
"\"Not all of us were born for adventure, Mim. You'd better go back home.\""
msgstr "\"모두가 모험을 하도록 태어나지는 않았어, 밈. 너는 집에 가는 게 좋겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0005_Text
msgctxt "15df164e-1d57-46dc-b439-dbcc79ddda83"
msgid ""
"\"Everyone makes mistakes. But some give up, while others stand up and go "
"on! I'm going to climb this mountain, no matter what it takes. What about "
"you?\""
msgstr ""
"\"모두가 실수를 하지. 누군가는 포기하지만 다른 사람들은 계속해서 버티고 전진해! 나는 무슨 일이 있어도 산을 오르겠다고 생각했어. "
"너는 어때?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0006_Text
msgctxt "da3f6fa9-2595-47ac-8877-510d010b3aac"
msgid "\"What are you doing here?\""
msgstr "\"여기서 뭐해?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0012_Text
msgctxt "18b2cbf9-09de-4952-a6ca-d14155f9a171"
msgid "\"What's the matter here?\""
msgstr "\"여기 볼일 있어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0015_Text
msgctxt "fb15b843-3528-49e3-8207-acd0722538eb"
msgid "[Use magic] \"I have just the spell for you...\""
msgstr "[마법을 사용합니다] \"너에게 써줄만한 마법이 있어...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0016_Text
msgctxt "d662af16-5d10-4e23-b550-14776902bbdd"
msgid "\"Let me see.\""
msgstr "\"어디 보자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0017_Text
msgctxt "d5c45f43-ec0e-4b9c-9714-d62536b9726b"
msgid "\"I can't help you right now.\""
msgstr "\"지금은 도와줄 수 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0024_Text
msgctxt "1dda15f0-e67c-4240-be4b-ecb5aac73397"
msgid ""
"[Try fixing the dislocated joint] \"You didn't break your ankle, you twisted "
"it. Hold on for a second, all right?\""
msgstr "[빠진 뼈를 맞추며] \"발목이 부러지지는 않았고 접지른 것 뿐이야. 잠깐 가만히 있어봐, 괜찮아?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0025_Text
msgctxt "b1d5a4e0-1468-4cdf-92ac-fb02662f5de6"
msgid ""
"\"There's no fracture – it's just dislocated. But I'm not sure I can fix it "
"myself...\""
msgstr "\"골절은 아냐. 탈골이지. 하지만 고칠 수 있을지는 모르겠군...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0026_Text
msgctxt "66b0564b-2cb9-4935-b2a9-ff1aebe69151"
msgid "\"About your ankle...\""
msgstr "\"네 발목 말이지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0032_AlignmentShift.Description
msgctxt "172d525c-9a13-47a9-ae40-83f6629e8227"
msgid "Apologized for hurting Mim while trying to heal her leg."
msgstr "그녀의 다리를 고치려다 다치게 한 것을 사과합니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0032_Text
msgctxt "db881bf1-4cf7-4479-9fe6-c4006bb7173c"
msgid ""
"\"I'm sorry, I was trying to set it back in its socket. But it seems too "
"badly twisted.\""
msgstr "\"미안해. 나는 그저 뼈를 되돌리려던 것 뿐인데. 너무 많이 뒤틀린 것 같아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0033_AlignmentShift.Description
msgctxt "521fc49e-82b2-4bdb-ae25-eb2c05492086"
msgid "Hurt Mim while trying to heal her leg – and laughed it off."
msgstr "그녀의 다리를 치료하다 말고 다치게 하고는 웃어넘겼습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0033_Text
msgctxt "96c64671-8c52-4497-9a00-9487b42be928"
msgid "\"Ouch. That must have hurt.\""
msgstr "\"아이고. 아팠겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0034_AlignmentShift.Description
msgctxt "a1ad8e29-07ee-4196-a9d6-34ab27e263b0"
msgid "Threatened to cut out Mim's tongue."
msgstr "밈의 혀를 잘라버리겠다고 협박합니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0034_Text
msgctxt "8ccb7283-141b-4704-bbe5-4c5ee45c116f"
msgid "\"Watch your tongue if you want to keep it.\""
msgstr "\"혀를 간수하고 싶다면 함부로 놀리지 않는게 좋을걸.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0039_Text
msgctxt "f6d22c87-4fab-4feb-9ee6-f19aaeef71a5"
msgid "\"I have to go.\""
msgstr "\"나는 가야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Answer_0047_Text
msgctxt "85f978a6-9df3-4ff7-999d-2fd28b5295d6"
msgid "\"You decided to go on, even after you saw giant spiders?\""
msgstr "\"거대 거미를 보고서도 계속해서 가겠다는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0001_Text
msgctxt "c1bf60c9-8e6d-46d9-b2c5-b0c02a6c275f"
msgid "\"It's... it's you!\""
msgstr "\"당신... 당신이군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0002_Text
msgctxt "0dd106e3-73ff-4ad3-9f41-e0aaf6482c3d"
msgid ""
"{n}{d|Mim}Mim's{/d} clothes are dirty, and her hair is matted.{/n} \"Good "
"gods! I feared I would... I would have to stay... here forever...\" {n}Tears "
"are running down her dirty cheeks, leaving light trails on her skin.{/n}"
msgstr ""
"{n}{d|Mim}밈{/d}의 옷은 더러웠고 그녀의 머리는 지저분해졌습니다.{/n} \"신이시여! 저는... 여기서 꼼짝없이 죽을 줄 "
"알았어요...\" {n}눈물이 그녀의 더러운 뺨에 흘렀고 눈물 자국을 남깁니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0007_Text
msgctxt "f320e983-97a6-43ee-9a36-724407fd7a17"
msgid ""
"\"I... I wanted to climb {g|Talon Peak}Talon Peak{/g}. It was... a sudden "
"decision. I just thought, why put it off? Why ask for someone else to help, "
"like I always do? Why can't I just get my wish by myself? After all, I left "
"father so I could achieve everything on my own. So, I decided to climb the "
"mountain alone. Skies above, my pride nearly sent me to my grave!\""
msgstr ""
"\"저는... {g|Talon Peak}발톱 봉우리{/g}에 오르고 싶었어요. 그건... 갑작스러운 결정이었죠. 이런 생각이 들더라고요. "
"왜 미루지? 왜 항상 남한테 도와달라 하는거야? 그냥 스스로 소원을 이루면 안되나? 저는 아버지를 떠났기에 모든 걸 스스로 이룰 수 "
"있었어요. 그래서 이번에는 산에 혼자 오르기로 결정했죠. 하늘보다 높은 자존심 때문에 무덤으로 갈 뻔했어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0008_Text
msgctxt "7d27a36b-9b7d-4da4-be37-6e65ede5e3ad"
msgid ""
"{n}A smile appears on Mim's pale face.{/n} \"After all, what good would an "
"ascent be if there weren't any obstacles along the way? I'm not giving up! "
"Let's go! To the top! You're coming with me, right?\""
msgstr ""
"{n}밈의 창백한 얼굴에는 웃음이 나타납니다.{/n} \"결국, 어려움이 없다면 오르막에 좋은 점이 뭐가 있겠어요? 저는 포기하지 "
"않겠어요! 정상으로 가죠! 저와 함께 가는게 맞죠?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0009_Text
msgctxt "21d7cce7-b0af-4a71-8149-8543992919b3"
msgid ""
"{n}Mim lowers her head and sighs heavily.{/n} \"You're... you're right. I "
"should know that my place is in the workshop with my tools. Just show me the "
"way, and I'll be off.\""
msgstr ""
"{n}밈은 고개를 숙이며 한숨을 쉽니다.{/n} \"그말이... 그말이 맞아요. 제가 있을 곳은 제 도구들이 있는 제 작업장이겠죠. 길을 "
"알려주시면, 알아서 내려갈게요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0013_Text
msgctxt "932a0e63-0255-4440-a9f3-3365d011f937"
msgid ""
"\"I think I broke my ankle... I was fighting some spiders, and stepped on a "
"stone, and it slipped, and I tripped and fell, and hit my ankle... I managed "
"to drive away the beasts, but it's still messed up. It hurts too much to "
"walk on. I crawled for several hours, but I couldn't...\""
msgstr ""
"\"제 생각엔 발목이 부러진 것 같아요... 거미와 싸우다가 돌을 밟아서 넘어져 발을 다쳤어요... 어찌어찌 그 짐승들을 쫓아냈지만 "
"여전히 엉망진창이네요. 걷기에는 너무 아파요. 몇시간을 기어갔지만 더이상은...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0018_Text
msgctxt "d7c99a73-e9e6-46aa-b90c-095ed8102e6e"
msgid ""
"{n}Mim relaxes her shoulders in relief.{/n} \"Whew... That's much better. "
"Thank you so much!\""
msgstr "{n}밈은 안도로 어깨가 늘어집니다.{/n} \"휴... 훨씬 낫네요. 정말 고마워요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0019_Text
msgctxt "fb094ddd-5b22-4c57-be43-151c3636a097"
msgid ""
"{n}Mim's ankle is swollen and red. It looks more like a dislocation than a "
"fracture. You palpate the area to find the bone intact.{/n}"
msgstr "{n}밈의 발목은 부풀어올라 붉어졌습니다. 골절보다는 탈골인 것 같습니다. 당신은 뼈가 잘 이어져 있는지 만져보았습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0020_Text
msgctxt "918cbfc0-679b-4069-b2fe-7db3e59ee3f0"
msgid "\"Think of something, please...\""
msgstr "\"무슨 수 좀 써봐요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0022_Text
msgctxt "2ae140f6-aa8a-4a67-a734-9bfcc86f07ce"
msgid ""
"{n}Mim's ankle looks swollen and red. You'll need help of an expert "
"medic...{/n}"
msgstr "{n}밈의 발목은 부풀어올라 붉어졌습니다. 당신은 전문 의료사의 도움이 필요합니다...{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0029_Text
msgctxt "573f263e-9249-4e73-a410-fe7d83c18d18"
msgid ""
"\"Wait, what... OUCH!\" {n}The joint clicks back into place.{/n} \"Oh... "
"well... It feels better... Much better! Thank you very much! Here, I'll try "
"to get up...\""
msgstr ""
"\"잠깐만요... 아야!\" {n}탈골된 부분에서 소리가 납니다.{/n} \"오... 좋아요... 괜찮은것 같아요... 훨씬 좋아요! "
"정말 감사합니다! 일어나볼게요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0030_Text
msgctxt "c1bdaac1-a4b7-412a-9f16-7ac398535073"
msgid ""
"\"Wait, what... OUCH! Devil's mercy, that hurts! What the hell do you think "
"you're doing?\""
msgstr "\"잠깐, 무슨... 아야야! 이런 악마같으니, 아프잖아요! 대체 무슨 생각으로 이러는 거예요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0035_Text
msgctxt "b98a32f6-3ba8-439a-a68b-2b51405f2d37"
msgid "{n}Mim looks away.{/n} \"I see. Well, thanks for trying to help.\""
msgstr "{n}밈이 시선을 돌립니다.{/n} \"알았어요. 아무튼 도와줘서 고마워요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0036_Text
msgctxt "191a4fc6-5025-496f-be32-7837651ad75a"
msgid ""
"{n}Mim inhales, then breathes out slowly.{/n} \"Just... don't. All right?\""
msgstr "{n}밈이 천천히 한숨을 쉽니다.{/n} \"그냥.. 하지마세요. 알았어요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0037_Text
msgctxt "fe9091d1-6133-4bd1-8ff2-c23c1ffdcab6"
msgid "\"So, the bones are intact... So that's good. I think.\""
msgstr "\"어, 뼈가 맞춰졌네요... 괜찮은 것 같아요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0038_Text
msgctxt "1526769c-feae-47a4-923b-ffb2192ccbae"
msgid ""
"{n}Mim flinches and lowers her head.{/n} \"I'm sorry, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}. The pain is clouding my judgment.\""
msgstr "{n}밈은 고개를 숙입니다.{/n} \"죄송합니다, {mf|남작님|남작님|전하|전하}. 고통이 제 판단을 흐렸습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0040_Text
msgctxt "de355536-6263-4ce1-adcc-7a412ba438eb"
msgid "{n}Mim looks at you with hope.{/n}"
msgstr "{n}밈은 기대를 담아 당신을 봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0041_Text
msgctxt "5de8196e-63dc-4db4-b966-9f07a4300ef6"
msgid "\"Yes... I can walk now. But where should I go?\""
msgstr "\"좋아... 이제 걸을 수 있어요. 근데 어디로 가야 할까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0042_Text
msgctxt "70532c7c-e88d-4468-bab7-7848fff2b895"
msgid ""
"\"Don't get me wrong, {mf|Your Grace|Your Grace|Your Highness|Your Highness}"
". I... I suddenly realized what my third wish would be. What I need to do, "
"to find my inspiration. I must climb {g|Talon Peak}Talon Peak{/g}! To see "
"the world from that height, to rise above myself... that's what my soul has "
"been craving! But I don't know if I can make it.\""
msgstr ""
"\"오해하지 마세요, {mf|영주님|영주님|전하|전하}. 저는... 저는 갑자기 세번째 부탁이 떠올랐어요. 제 영감을 찾기 위해 뭘 "
"해야할지를 말이죠. 저는 {g|Talon Peak}발톱 봉우리{/g}로 올라가야 해요! 그 높이에서 세계를 보고 제 자신을 높이는 "
"거죠... 그게 제 영혼이 갈망하던 것이었어요! 하지만 제가 그걸 해낼 수 있을지 모르겠어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0044_Text
msgctxt "21f4ec23-e69e-436d-a467-c7ff897e523b"
msgid "\"For heaven's sake, come back soon!\""
msgstr "\"제발, 빨리 돌아와주셔야 해요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/GnomeFemale_JewelcrafterCN/TalonPeak_Dialogue/Cue_0046_Text
msgctxt "c791554d-d8be-4e63-98d4-1515d611602c"
msgid ""
"{n}Mim's face turns red.{/n} \"I'm a mage! Before I tripped, I was handling "
"them just fine! They were still afraid to attack, the spineless creeps...\""
msgstr ""
"{n}밈의 얼굴이 붉어집니다.{/n} \"저는 마법사에요! 넘어지기 전까지는 잘 상대하고 있었다고요! 아직도 겁먹어서 공격을 못하고 "
"있잖아요, 징그러운 무척추동물 같으니라고...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/ConflictLawGuard1_String
msgctxt "63ce21d4-938e-4ccb-bb42-ec44ba2d7b24"
msgid "\"You fools! What is this, a revolt?! Drop your weapons!\""
msgstr "\"멍청아! 이게 뭐야?! 무기 내려!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/ConflictLawGuard2_String
msgctxt "050b30c3-70c1-4ad8-b074-a01435ebfd06"
msgid ""
"\"Without the support of the throne, we're no militia — we're just plain "
"thieves! That won't do!''"
msgstr "\"왕의 지지가 없으면 우리는 민병대도 아니고 그냥 도둑일 뿐이야! 그만둬!''"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/ConflictLawGuard3_String
msgctxt "6a4ac4a0-d04d-4d53-ad3b-775625277275"
msgid "\"There will be no mutiny!\""
msgstr "\"반란은 없다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/ConflictLevy1_String
msgctxt "b9bc598e-1d8f-484e-b093-1288738d1ae2"
msgid ""
"\"Run back to your capital! This is my home, and I know best how to protect "
"the law here! You got that?!\""
msgstr "\"수도로 돌아가라! 여기는 내 집이고 여기 법은 내가 제일 잘 알아! 알아먹었냐?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/ConflictLevy2_String
msgctxt "c611bd5f-fb26-40dc-99b2-6d1c9b7d09d3"
msgid ""
"\"What good is the state to us? We're the militia. We can fight for "
"ourselves!\""
msgstr "\"나라가 무슨 소용이야? 우리는 민병대다. 우린 스스로를 위해 싸운다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/ConflictLevy3_String
msgctxt "cf1784bb-0c87-48a8-975d-b9aea469694a"
msgid "\"We plough this land! We should rule it as well!\""
msgstr "\"우리가 이 땅을 일궜다! 우리가 지배하는 건 당연해!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/ConflictLevy4_String
msgctxt "a85cab93-06da-4910-8d28-9f9c9b167e0c"
msgid "\"We're better off on our own!\""
msgstr "\"우리끼리 사는 게 더 나아!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/FightBeginning1_Levy_String
msgctxt "4da229c1-317a-479d-8d5a-5668a46dfb7a"
msgid "\"Why are we even wasting time on them? Let's kill these dogs!\""
msgstr "\"이놈들한테 우리 시간을 버릴 필요가 있나? 이 개자식들을 죽이자!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/FightBeginning2_LawGuard_String
msgctxt "a4540c2c-99bc-405d-98e4-e14110d08123"
msgid "\"They're coming at us! Get ready, lads!\""
msgstr "\"놈들이 덤벼든다! 준비해라! 얘들아!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/FightLawGuard1_String
msgctxt "1491a55d-f418-46ee-a94a-e364b74200f6"
msgid ""
"\"Drive off the rabble-rousers! We stand with the "
"{mf|baron|baroness|King|Queen}!\""
msgstr "\"분탕질 하지 말고 꺼져라! 우리는 {mf|남작|여남작|왕|여왕}의 편이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/FightLawGuard2_String
msgctxt "91c16c94-ceeb-4ca8-badc-d1a3f9e7f82f"
msgid "\"Watch out, you scoundrels! It's the gallows for you!\""
msgstr "\"조심해라, 이 악당들아! 교수대로 보내주마!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/FightLawGuard3_String
msgctxt "4e84315e-b2f7-4c00-9550-5619191ccded"
msgid "\"Drop your weapons! In the name of the law!\""
msgstr "\"무기를 버려라! 이건 법 집행이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/FightLevy1_String
msgctxt "c0fadcc8-76e3-4031-86bb-ca2bad2ab6c0"
msgid ""
"\"We stand for our homes, brothers! Hit them hard! Varnhold will be ours!\""
msgstr "\"우리는 집을 지켜야 한다, 형제들이여! 저놈들을 매우 쳐라! 반홀드는 우리 것이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/FightLevy2_String
msgctxt "fc96a047-08b5-47bd-975b-5501eda918be"
msgid ""
"\"For free Varnhold! Down with the {mf|baron|baroness|King|Queen} and "
"{mf|his|her} dogs!\""
msgstr "\"자유로운 반홀드를 위해! {mf|남작|여남작|왕|여왕}과 {mf|그|그녀}의 개들을 끌어내려라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Barks/FightLevy3_String
msgctxt "a1bb30ea-5543-4f89-bf72-e2f7cb9d2ef6"
msgid ""
"\"What the hell are you doing?! We're fighting for the same thing! For "
"freedom! For liberty!\""
msgstr "\"여기서 뭐하는 거야?! 우리는 같은 목적으로 싸우는 거야! 자유를 위해서!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Answer_0007_Text
msgctxt "2d51ec74-6d3d-4a5b-9da5-1b6ea55493cb"
msgid "\"I have to go.\""
msgstr "\"나는 가야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Answer_0013_Text
msgctxt "4bdc57dc-136b-422d-b6fa-aed8bcd601b1"
msgid "\"So, you were in a gang once?\""
msgstr "\"그럼, 건달패 출신이란 말인가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Answer_0014_Text
msgctxt "a1f0996b-e5cf-438a-9dc1-dd96f558e210"
msgid "\"Tell me about yourself.\""
msgstr "\"너에 대해 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Answer_0015_Text
msgctxt "5d6c6ab6-9f0a-4ffc-a253-d6fe9783bd16"
msgid "\"I'd like to know more about your craft.\""
msgstr "\"너의 공예에 대해 더 알고 싶은데.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Answer_0024_Text
msgctxt "0bf9f27c-25c6-41df-ae36-d192a6e12e99"
msgid "\"Why have you chosen to settle in Varnhold?\""
msgstr "\"왜 반홀드에 정착하기로 했지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Answer_0028_Text
msgctxt "99f4cacd-2c9a-472c-9af6-82a11fc45891"
msgid "\"How's the militia doing?\""
msgstr "\"반홀드 민병대는 어때?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Cue_0001_Text
msgctxt "85c0ad11-1acd-4baa-b82c-06aa5b8e0b36"
msgid ""
"{n}{d|Tirval}Tirval{/d} greets you with a friendly smile.{/n} \"Welcome! "
"We've just brought in a couple of new recruits. The guards are teaching them "
"all they need to know about standing night watch. And I'm busy making armor "
"for the boys. No one should fight bandits with a bare chest. Leather armor "
"can do wonders. — It won't make a lot of noise and give away your ambush, "
"but it will protect you just fine from a blade.\""
msgstr ""
"{n}{d|Tirval}터발{/d}은 친근한 미소로 당신을 맞이합니다.{/n} \"어서옵쇼! 방금 신병 몇 명을 받았습니다. 경비대가 "
"야간 근무에 대해 하나부터 열까지 가르쳐주고 있지요. 그리고 저는 그 애들을 위한 갑옷을 만드느라 바쁩니다. 맨몸으로 도적과 싸워서는 "
"안될 일이니까요. 가죽 갑옷은 놀라운 일을 해낼 수 있습니다. 시끄러운 소리로 매복을 망칠 일도 없으면서, 칼질을 당해도 멀쩡하게 몸을 "
"보호해주거든요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Cue_0002_Text
msgctxt "828f5ed9-5285-4e49-a276-6db1db6745f3"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}! What a surprise! "
"It is good to see you!\""
msgstr "\"{mf|영주님|영주님|전하|전하}! 세상에! 만나서 반갑습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Cue_0018_Text
msgctxt "0798d844-c3ff-4cb9-8e85-ec64713edba3"
msgid ""
"{n}{d|Tirval}Tirval{/d} gives a sour grin.{/n} \"Not much to tell, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}. And it's not a pretty story. "
"I grew up on the street in Daggermark. Not the best place to live, in case "
"you didn't know that already – especially for lonely children. But life "
"teaches us a lot of things. I was able to survive, then got involved with a "
"gang and built up my life from there, all on my own — not on my mom and "
"dad's sweat and blood, or some fancy title and a bunch of gold.\""
msgstr ""
"{n}{d|Tirval}터발{/d}은 당신에게 씁쓸한 미소를 짓습니다.{/n} \"별로 드릴 말씀은 없습니다, "
"{mf|영주님|영주님|전하|전하}. 그다지 좋은 이야기도 아니고요. 저는 대거마크 길바닥에서 자랐습니다. 살기 좋은 동네는 아니지요. "
"이미 알고 계실지 모르겠지만 고아들에게는 특히 그렇습니다. 하지만 인생은 우리에게 많은 것을 가르쳐주기 마련이죠. 저는 결국 살아남았고, "
"건달패로 흘러들어가 오직 제 힘으로 삶을 꾸려나갔습니다. 엄마 아빠의 피땀이나, 멋진 직함과 금더미 같은 것 없이 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Cue_0019_Text
msgctxt "cd48c5ed-ca08-429a-b881-be00341392d8"
msgid ""
"{n}Tirval gives you a suspicious look, but then chuckles and waves it "
"off.{/n} \"Oh yes, the mistakes of youth… There are a lot of youngsters in "
"Daggermark. Those who can think on their feet join in packs. Street gangs "
"fooling around, putting the squeeze on merchants, all that. But that's long "
"behind me now. And besides, we never messed anyone over. Or better to say – "
"we kept things in order. If anybody tried to lean on our neighbors or "
"started misbehaving, we took them in hand.\""
msgstr ""
"{n}터발은 당신을 의심의 눈초리를 보냈다가, 이내 웃으며 흘려보냅니다. .{/n} \"네 맞습니다, 어릴 적의 실수였지요... "
"대거마크에는 젊은이들이 많습니다. 개중에 약삭빠른 애들은 패거리에 들어가죠. 할 짓 없이 어슬렁 거리면서 상인들 겁이나 주는 동네 건달패 "
"같은 곳에. 근데 저는 손 씻은 지 한참 됐습니다. 게다가, 우린 절대 남을 괴롭힌 적 없어요. 오히려 질서를 지켰다고 할 수 있지요. "
"누가 우리 이웃에 빌붙거나 해코지를 하려하면 잡아다 혼줄을 내줬습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Cue_0020_Text
msgctxt "863b14c7-3211-47b3-abc1-4d140b5540cf"
msgid ""
"{n}The half-elf's eyes glisten and dance.{/n} \"Leatherworking, you mean? "
"With pleasure. You see, the trick is to remove the hide so that the tendons "
"don't stick to it. Otherwise it will go brittle. Then you only need "
"patience. — You let it rest, you drench it in saltwater. That way you get "
"sturdy leather – hard as wood, but still flexible. If you wear that, you can "
"rest easy even with some bastard poking you with a blade. It's not steel, of "
"course, but you won't be running around the woods all day in steel – or "
"sneaking up on someone from behind!"
msgstr ""
"{n}하프엘프의 눈이 빛납니다.{/n} \"가죽공예를 말씀하시는 거죠? 기꺼이 말씀드리죠. 이게, 비결이 뭐냐면 힘줄이 달라붙지 않도록 "
"가죽을 벗겨내는 겁니다. 그러지 않으면 부서지기 쉽습니다. 그 뒤부터는 인내심만 있으면 되지요. 가만히 놔뒀다가 소금물에 담궈놓습니다. "
"이렇게 하면 튼튼한 가죽을 만들 수 있어요. 단단하기는 나무와 같은데, 게다가 유연하기까지 합니다. 이걸 입으면 편히 쉬다가 어떤 "
"개자식이 칼침을 놔도 받아낼 수 있지요. 물론 강철은 만큼은 아니지만, 하루 종일 숲을 뛰어다니거나 누구 뒤로 몰래 다가갈 때 강철 "
"갑옷을 입지는 않으니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Cue_0022_Text
msgctxt "1318a31c-788f-41ec-9817-50915b75283f"
msgid ""
"\"People knew they could trust me, and that I've got my head screwed on "
"right. There were some who were ready to follow me – and I even thought "
"about becoming a bandit myself, but…\" {n}Tirval frowns, as if she "
"remembered something shameful and unpleasant.{/n} \"It wasn't meant to be, "
"that's all. I left Daggermark, traveled around a bit. At first I tried "
"hunting, but then I picked up leatherwork. And as it turns out, I'm pretty "
"good at it. Become a real master, in fact. That about covers it I guess.\""
msgstr ""
"\"사람들은 제가 믿을 만하고 똑 부러지는 사람이란 걸 알았습니다. 저를 따르려했던 사람들도 있었지요. 그래서 도적이 될까 생각도 "
"해봤지만...\" {n}터발은 뭔가 부끄럽고 불쾌한 것이 생각난 듯 얼굴을 찡그립니다.{n} \"그러고 싶지 않았습니다. 그게 전부에요. "
"저는 대거마크를 떠나 한동안 떠돌아다녔습니다. 처음에는 사냥꾼을 해보려 했는데, 나중엔 피혁공이 되었지요. 하다보니, 제가 꽤 소질이 "
"있더라고요. 사실, 이젠 진짜 장인의 경지에 올랐습니다. 이정도면 다 말씀드린 것 같군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Cue_0023_Text
msgctxt "d4c4f6e3-c4d5-4ccd-9b36-8df297efdd84"
msgid ""
"\"And then there's all the other equipment you need to survive a day in the "
"woods, or on the dark streets — and it's all made of leather as well. "
"Without a good pair of boots, the first snake will get you, if you haven't "
"drowned in some swamp already. And without gloves, every poisonous bush will "
"leave its nasty marks on your hands. And I won't even get started on belts — "
"the most useful thing you own, if you don't want to lose all your things "
"while you're on the run. All in all, it's a good craft to know — and it "
"keeps bread on the table.\""
msgstr ""
"\"그밖에 숲이나 어두운 골목에서 살아남는데 필수적인 장비들도 있습니다. 그것들도 전부 가죽으로 만들지요. 좋은 장화가 없으면 어찌어찌 "
"늪에 빠져죽지 않았다 해도 뱀한테 물립니다. 장갑이 없으면 독풀을 건드리는 족족 손에 끔찍한 상처를 남길 거고요. 허리띠는 뭐 말할 것도 "
"없습니다. 뛰면서 소지품을 줄줄 흘리고 다니고 싶지 않다면 허리띠부터 챙겨야 할 겁니다. 모로보나, 참 배워볼만한 기술이지요. 먹고 "
"살게도 해주고 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Cue_0025_Text
msgctxt "dd235ad2-0b2b-45bd-9616-64e16e8b6bf8"
msgid ""
"{n}The girl's face darkens as she turns her eyes to the ground in "
"silence.{/n} \"I killed the wrong man. I thought he was a villain. A threat "
"to those who were under my protection. I couldn't forgive myself, so I left. "
"I went wherever the road would take me. As for Varnhold... I was just "
"passing through when I suddenly felt — 'this is it'. It felt like the place "
"I could start a new life. An honest life, a life lived by the law. And here "
"I am.\""
msgstr ""
"{n}터발의 낯빛이 어두워지더니 입을 다물고 시선을 땅으로 떨어뜨립니다.{/n} \"엄한 사람을 죽였습니다. 그 사람이 악당이라고 "
"생각했어요. 내가 보호하는 사람들을 위협하는 자라고 생각한 겁니다. 내 자신을 용서할 수 없어서 떠났지요. 그래서 갈 수 있는 어디든 "
"돌아다녔습니다. 반홀드는... 지나가다 갑자기 '여기다'라는 느낌을 받았습니다. 여기라면 새로운 삶을 시작할 수 있을 것 같았지요. 법을 "
"지키며 정직하게 사는 삶 말입니다. 그래서 정착했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Cue_0026_Text
msgctxt "c055dc37-4342-48a5-9950-60a0d277e758"
msgid ""
"\"Things have quieted down a bit. As soon as you showed force, everyone who "
"used to speak out turned quiet and obedient. Finally we're serving the "
"people instead of arguing among ourselves!\""
msgstr ""
"\"조금 진정됐습니다. 당신이 힘을 보여주자마자, 목소리를 높이던 사람들이 조용하고 순종적으로 변했어요. 드디어 우리끼리의 싸움을 멈추고 "
"사람들에게 봉사하게 되었습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Cue_0027_Text
msgctxt "5c5ea592-e15c-4cd0-abec-123dc288c586"
msgid ""
"\"Never been better, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! "
"Ever since we ran off the bandits from these lands, no other troublemakers "
"have been bold enough to set foot here. Peace and quiet rule in Varnhold — "
"just as they should!\""
msgstr ""
"\"이보다 좋을 수가 없습니다, {mf|영주님|영주님|전하|전하}! 우리가 이 땅에서 도적들을 쫓아낸 이후 여기와서 말썽을 부릴 만큼 "
"대담한 녀석은 나타나지 않았습니다. 반홀드가 마땅히 누려야할 평화와 고요가 자리잡았습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/HalfElfFemaleLeatherworkerLG_Artisan/Cue_0029_Text
msgctxt "56fd02e9-ca7b-4149-a123-2e4c8b54dbdf"
msgid ""
"\"We're doing fine. We train volunteers, keep the hotheads separated, catch "
"thieves… Don't worry, if anything goes wrong I'll let you know right away!\""
msgstr ""
"\"잘 지내고 있습니다. 지원자를 훈련시키고, 싸움을 말리고, 도둑들을 잡고 있지요... 걱정마십시오, 문제가 생기면 바로 알려 "
"드리겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Items/VarnholdsThankDescription_String
msgctxt "81eade66-dec7-49cb-8b6d-dfac20bd983f"
msgid ""
"A magnificent set of leather armor, crafted from the hide of an unknown "
"predator."
msgstr "어떤 맹수의 가죽으로 만들었는지는 모르지만 훌륭한 가죽갑옷 한 벌입니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/Items/VarnholdsThank_String
msgctxt "54c73e6b-3fc8-4c57-a090-87130ee47719"
msgid "Varnhold's Gratitude"
msgstr "반홀드의 감사"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_EE_StatGift_Tirval/Cue_0001_Text
msgctxt "df095291-dba8-490a-9ae2-90070ae8c248"
msgid ""
"{n}Tirval frowns.{/n} \"Greetings, my {mf|baron|baroness|King|Queen}! I "
"heard a rumor that Daggermark, my accursed homeland, is trying to sink its "
"claws into your lands. Damn it!\""
msgstr ""
"{n}터발은 눈살을 찌푸렸습니다.{/n} \"안녕하십니까, {mf|남작|여남작|왕|여왕}님! 저는 제 빌어먹을 고향인 대거마크에서 당신의 "
"땅에 발톱을 박으려 한다는 소문을 들었습니다. 젠장할 자식들!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_EE_StatGift_Tirval/Cue_0002_Text
msgctxt "15ba0b5a-7bdd-4d27-81b7-858abfd4c3ff"
msgid ""
"\"Good day, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! It seems "
"that the war with Daggermark is boiling, is it not? I even see some in "
"Varnhold nowdays. They're everywhere, I tell you!\""
msgstr ""
"\"좋은 날입니다, {mf|영주님|영주님|전하|전하}! 대거마크와의 전쟁이 꽤나 달아올랐군요, 그렇지 않습니까? 심지어 요즈음엔 "
"반홀드에서도 녀석들이 종종 보입니다. 말씀드리건데, 그들은 어디에나 있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_EE_StatGift_Tirval/Cue_0003_Text
msgctxt "c7651c1d-4112-4032-a2c3-3f98897542ea"
msgid ""
"\"I would like to make a contribution, to assist you in this war against "
"those spying bastards. Here – take this. And put it to good use!\""
msgstr "\"저는 당신을 도와서 저 개같은 첩자놈들과의 전쟁에 기여하고 싶습니다. 이것을 드릴겠습니다. 잘 사용해주시길!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0010_Text
msgctxt "38338c8e-bc7a-4455-8e0f-153217be30dc"
msgid "\"Get to work on this special gift of yours.\""
msgstr "\"너의 그 특별한 선물이란걸 받고 싶은데.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0011_Text
msgctxt "94db0be3-2d73-4892-855c-b6a21e7104f6"
msgid "\"I thank you for your gift.\""
msgstr "\"네 선물은 감사히 받겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0012_Text
msgctxt "d259b0ab-30a4-4c71-a154-d801c99d65ab"
msgid "\"I'd like you to make something specific for me.\""
msgstr "\"특정한 물건을 만들어줬으면 좋겠군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0020_Text_String
msgctxt "d52ecbbf-3534-40a2-9dba-295dab859aa1"
msgid "\"Tell me more about your idea.\""
msgstr "\"네 생각에 대해 말해봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0022_Text
msgctxt "02e7315a-630f-4670-8e6e-adc51df840f5"
msgid "\"Leather armor.\""
msgstr "\"가죽갑옷.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0023_Text
msgctxt "25fb657c-38e5-4b4d-8a05-2b4b2607df3a"
msgid "\"Leather gloves.\""
msgstr "\"가죽 장갑.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0024_Text
msgctxt "8c583bf9-09b4-4d25-967b-8399ef66d1f5"
msgid "\"A pair of fine boots.\""
msgstr "\"질 좋은 장화.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0025_Text
msgctxt "3404a5cc-7e3d-475a-a9af-cdca904d7495"
msgid "\"A good belt.\""
msgstr "\"좋은 허리띠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0026_Text
msgctxt "992e1283-ef5e-4337-90be-a3285c594941"
msgid "\"Show off your leatherworking skills — make a magical item for me.''"
msgstr "\"네 가죽 공예 솜씨를 발휘해봐. 나에게 마법 물품을 만들어줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0027_Text
msgctxt "a34d280a-aced-42a4-bd95-e5923c5d455b"
msgid "\"On second thought, you can decide for yourself.\""
msgstr "\"다시 생각해보니 네가 결정하는 게 나을 거 같아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0040_Text
msgctxt "82678b52-a62b-47e3-af6d-c5c24e4c4944"
msgid "\"I like this idea. I'll see whether I can make it happen.\""
msgstr "\"좋은 생각이야. 할 수 있는지 두고 보자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0041_Text
msgctxt "b27dc3e9-e37a-4e1e-adbd-8b23b12832c7"
msgid "\"Varnhold does not need a militia.\""
msgstr "\"반홀드는 민병대가 필요하지 않아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0045_Text
msgctxt "3fe18222-4334-4ae2-ae9f-529d032e094b"
msgid "\"Why don't you simply come and serve as my guards?\""
msgstr "\"그냥 여기 와서 경비대로 복무하는 건 어때?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0047_Text
msgctxt "7892e94c-2396-4a41-a081-1e7aaa49750f"
msgid "\"'All manner of leather things'?\""
msgstr "\"모든 종류의 가죽 장비를 만드나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0050_Text
msgctxt "feb52faf-cab2-4e54-b4ae-12662c83dc54"
msgid "\"I do not require your services any longer.\""
msgstr "\"네 도움은 이제 필요치 않아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Answer_0054_Text
msgctxt "f8a4ed8b-fff2-40a9-bf25-635d57cdf895"
msgid "\"Remind me, who are you and what are you working on?\""
msgstr "\"다시 알려줘, 네가 누구고 무슨 일을 했었지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0001_Text
msgctxt "1db321f4-0c4a-4d42-9b12-b7b46e41d4eb"
msgid ""
"{n}Before you is a boyish half-elf. Her tight-fitting leather outfit is full "
"of patches, and a large, mean-looking blade rests on her hip. A tattoo "
"adorns the woman's neck.{/n} \"On behalf of the simple folk of Varnhold, I "
"greet you! My name is Tirval. I am here to represent our community, to "
"present you with a token of our loyalty, and to humbly beg your help.\""
msgstr ""
"{n}당신 앞에 선머슴 같은 하프엘프가 서있습니다. 그녀는 곳곳을 덧댄 몸에 달라붙는 가죽갑옷을 입었고, 크고 위협적으로 보이는 칼집을 "
"엉덩이에 걸치고 있습니다. 목에는 문신이 보입니다. {/n} \"반홀드의 소박한 사람들을 대신하여, 당신을 환영합니다! 제 이름은 "
"터발입니다. 저는 우리 지역사회를 대표하여 이곳에 왔고, 당신께 우리의 충성을 증명하는 선물을 드리며, 황송하옵게도 도움을 청하고자 "
"합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0002_Text
msgctxt "69a74a15-7498-42f4-babb-b4b4c39b79a1"
msgid ""
"{n}{d|Tirval}Tirval{/d} greets you with a half-bow.{/n} \"{mf|Your Grace|"
"Your Grace|Your Highness|Your Highness}, please, accept this new gift.\""
msgstr ""
"{n}{d|Tirval}터발{/d}은 반절하며 당신을 맞습니다.{/n} \"{mf|영주님|영주님|전하|전하}! 부디, 이 새 선물을 "
"받아주시길.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0005_Text
msgctxt "cd55176e-2af7-4323-96ed-1f64b7da5cc7"
msgid ""
"{n}With a bow, the half-elf hands you something wrapped in a piece of cloth. "
"— It is a set of leather armor.{/n} \"This is my finest creation, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}. I named it 'Royal Guardian'. "
"No blade shall wound your kind and generous heart, so long as this armor "
"protects it.\""
msgstr ""
"{n}인사와 함께, 하프엘프가 천으로 감싸진 무언가를 건냅니다. 그것은 가죽 갑옷 한 벌이었습니다.{/n} \"제 최고의 작품입니다, "
"{mf|영주님|영주님|전하|전하}. 저는 이걸 '충실한 수호자'라고 이름 지었습니다. 이 갑옷이 지키고 있는 한, 어떤 검도 당신의 "
"자애롭고 관대한 가슴을 해치지 못할 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0006_Text
msgctxt "35a40f09-5d36-4a3f-b20c-2ae5922c5382"
msgid ""
"\"And that is not all, {mf|Your Grace|Your Grace|Your Highness|Your Highness}"
"! The Varnhold militia is proud to report that the region has been freed "
"from bandits, and order has been restored. We hit 'em so hard, they flew all "
"the way to Mendev! The people know it's all thanks to you. If you hadn't "
"helped us to gather the militia, the damn crooks would still be robbing and "
"butchering us.\""
msgstr ""
"\"그게 다가 아닙니다, {mf|영주님|영주님|전하|전하}! 반홀드 민병대는 이 지역이 도적으로부터 자유로워졌으며, 질서를 되찾았음을 "
"자랑스럽게 보고드립니다. 그들은 우리에게 박살이 났고, 멘데브로 줄행랑을 쳤습니다! 백성들은 이게 모두 당신 덕분임을 알고 있습니다. "
"당신이 저희를 도와 민병대를 조직하지 않았다면, 그 망할 악당들은 우리를 약탈하고 학살하고 있었을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0007_Text
msgctxt "64c693d8-ed9a-45da-a6d7-d157af923ccf"
msgid ""
"{n}Tirval proudly hands over her gift and continues in a steady tone.{/n} "
"\"We ask you to let Varnhold assemble a militia of her own. Many of the "
"locals are eager to keep watch and defend their homes with weapons in hand — "
"especially so after the… well, you understand.\""
msgstr ""
"{n}터발은 선물을 자랑스럽게 건내며 안정된 어조로 말을 잇습니다.{/n} \"반홀드가 민병대를 조직할 수 있게 해주십시오. 많은 "
"주민들이 제 손에 무기를 들고 그들의 터전을 지키고 감시하기를 열망하고 있습니다. 특히 그... 예, 아시겠지요. 그 이후로는 더 "
"그렇습니다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0008_Text
msgctxt "fc81731a-ef6e-44e5-af9d-3b507d0de00b"
msgid ""
"\"We owe you a lot. And I would like to make something special for you. Not "
"long ago, I shot something down in the forest… I'm not even sure how to "
"describe it. It was like a dragon, only smaller. I've never seen a beast so "
"fierce! Its hide is a thing of beauty. And that's what I'll use for your "
"gift. It will make the best leather armor you've ever seen, let alone owned. "
"Just say the word, and I'll start working on it.\""
msgstr ""
"\"저희는 당신에게 많은 빚을 졌습니다. 그래서 당신께 특별한 걸 만들어 드리고 싶습니다. 얼마 전, 숲에서 무언가를 활로 "
"쏴잡았는데... 어떻게 말씀드려야 할지 모르겠군요. 꼭 드래곤같이 생겼는데 크기만 작습니다. 그렇게 거친 짐승은 처음 봤습니다! 근데 "
"가죽은 정말 아름답더군요. 그걸 당신의 선물을 만드는데 쓰려고 합니다. 만들어지면 당신이 가진 건 물론이고 구경만 한 것 중에서도 최고의 "
"갑옷이 될 겁니다. 말씀만 하시면 바로 작업을 시작하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0014_Text
msgctxt "0924b122-3a1e-410d-b202-0a3046883a8d"
msgid ""
"{n}The half-elf looks worried as she rubs the tattoo on her neck.{/n} \"I'm "
"sorry for everything that happened in Varnhold that day. It all seems quiet "
"there now. In any case, me and my people shall hold our word: we'll fight to "
"the end for our homes and our loved ones.\""
msgstr ""
"{n}하프 엘프는 목의 문신을 문지르며 걱정스러운 표정을 짓습니다.{/n} \"그날 반홀드에서 일어난 일은 정말 송구스럽습니다. 지금은 "
"거의 잠잠해 졌습니다. 저와 우리 백성들은, 무슨 일이 있어도 우리의 신조를 지킬겁니다. 우리는 우리의 집과 사랑하는 사람들을 위해 "
"끝까지 싸울 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0015_Text
msgctxt "8f2bfc6a-edfe-4627-add8-192ff477bf45"
msgid ""
"\"I shall work like never before! Trust me, you will not be disappointed!\""
msgstr "\"최선을 다해 만들겠습니다! 믿어주십시오, 실망하지 않으실 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0016_Text
msgctxt "5a6a7100-c2bb-4346-b5fa-50daf2c8d2f8"
msgid ""
"{n}Tirval smiles and nods.{/n} \"You're welcome. I hope it serves you well.\""
msgstr "{n}터발은 웃으며 끄덕입니다.{/n} \"천만에요. 잘 쓰셨으면 좋겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0017_Text
msgctxt "54a43edc-a21c-4563-9efe-52d5d8569340"
msgid "\"You have my complete attention. What is it that you require?\""
msgstr "\"성심성의껏 받들겠습니다. 무엇을 원하시는지요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0021_Text_String
msgctxt "877f26ca-81e6-4814-a22e-5f80176fe93f"
msgid ""
"\"I'll try to keep it short. I come from a long way from here — Daggermark, "
"that is. We've never had too much in the way of law. But we always had "
"order. It just wasn't the guard that looked after it, it was the local "
"bandits. Every village, every quarter, they all had a gang of their own. "
"They never touched anyone except other gangsters that came by. They were "
"just like the guard, you see, even though no one ever gave them any "
"authority. And if you don't have the authority, and you carry a blade — well "
"then you're a bandit.\""
msgstr ""
"\"짧게 말씀드리겠습니다. 저는 대거마크를 떠나 먼 길을 왔습니다. 우리는 법과는 거리가 먼 인생을 살았죠. 그래도 항상 질서는 "
"있었습니다. 그걸 유지한 건 경비대가 아니라 동네 도적들이었지요. 모든 마을, 모든 구역마다 그곳의 건달패가 자리잡고 있었습니다. 그들은 "
"다른 깡패들이 쳐들어올 때를 제외하고는 아무도 건드리지 않았찌요. 그들은 마치 경비대 같았습니다. 뭐, 아무도 그들에게 그런 권한을 "
"부여한 적이 없지만. 권한이 없는데 칼을 들고 다니니, 도적이라 부르는 것이지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0028_Text
msgctxt "b17b2558-0239-44ca-b537-fcf1a0bf522a"
msgid ""
"\"Right. Something light, but still sturdy, and make sure it doesn't creak. "
"No problem, I've got everything I need.\""
msgstr "\"알겠습니다. 가볍지만 단단하고 금이 가지 않는 것으로. 문제 없습니다. 필요한 건 다 가지고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0030_Text
msgctxt "a3e3deda-b7d4-4b00-a40b-a7ab598f6af3"
msgid ""
"\"He-he, you'll love what I come up with, I promise. When it comes to "
"leather, I'm the best around.\""
msgstr "\"헤-헤, 장담컨데 제가 가지고 돌아올 물건이 마음에 쏙 드실겁니다. 가죽이라면 제가 최고니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0031_Text
msgctxt "b8742652-1764-4b67-ac8e-ed60587f89b4"
msgid "\"As you wish. I'll do my best.\""
msgstr "\"바라시는 대로. 최선을 다하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0032_Text_String
msgctxt "75c2bb65-0bb3-4cfc-b3da-2fa974cc4171"
msgid ""
"\"You've sent your guard to Varnhold. But firstly, they're strangers here. "
"Second, they're not your best people. Think about it — who would ever want "
"to get posted all the way down here? So that's why there's are so many "
"guards there and so little order. As for us, we know the people we're "
"dealing with. We can tell the real thug from the harmless drunk who likes to "
"tie one on and wave his fists around. Who to watch because he's a dangerous "
"fool, and who to watch because he's an eager fool!\""
msgstr ""
"\"반홀드에 경비대를 파견하셨지요. 허나 첫째로, 그들은 여기에선 이방인입니다. 둘째로, 질적으로도 훌륭하다 보기 어렵지요. "
"생각해보십시오. 누가 이런데까지 내려오려고 하겠습니까? 그래서 여기에 이렇게 경비가 많아도 질서가 지켜지지 않는 겁니다. 우리로 말할 것 "
"같으면, 우선 상대할 사람들을 잘 알고 있지요. 진짜 깡패에서부터 고주망태가 돼서 허공에 주먹질을 해대는 무해한 주정뱅이까지 다 말씀드릴 "
"수 있습니다. 위험한 바보라서 지켜봐야 하는 놈이 있고, 열렬한 바보라서 지켜봐야 하는 놈이 있기 마련이지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0033_Text_String
msgctxt "7a536202-6285-442e-8693-a40fecba8c64"
msgid ""
"\"Long story short, we've got our ways. So that's why I'm asking for your "
"permission and your help — we want to bring a few brave and quick-witted "
"folks together, and do everything by the book.\""
msgstr ""
"\"간단히 말해서, 우린 우리 방식이 있습니다. 그게 제가 당신의 허락과 도움을 구하고자 하는 이유입니다. 우리는 용감하고 재빠른 사람 "
"몇명을 모아서 모든 것을 정석대로 하고 싶습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0035_Text
msgctxt "89651714-0c20-431a-bc07-84107d0fdbce"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness} took care to send "
"guards to Varnhold, and I am grateful for that. However, the townsfolk would "
"sleep better knowing that you've let us take the protection of our children "
"and elders into our own hands. I understand that this would require an "
"investment from you, but we will not remain in your debt for long. If there "
"is a workshop where I can work leather, I'd be more than happy to make all "
"manner of things for you — I used to make a living as a tanner back in "
"Daggermark.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}께서 반홀드에 경비대를 파견하여 신경써주시는 것에 감사드립니다만, 주민들은 우리 아이들과 노인들을 "
"스스로의 손으로 지킬 때 더 편안히 잠자리에 들 수 있을 거라 믿고 있습니다. 물론 이를 위해서는 당신의 투자가 필요하다는 것을 알고 "
"있습니다만, 저희는 그 빚을 오래 지고 있지는 않을 겁니다. 제가 가죽을 손질할 수 있는 공방이 있다면, 기꺼이 당신을 위해 저의 모든 "
"수완을 발휘하겠습니다. 저는 예전에 대거마크에서 피혁공으로 먹고 살던 사람입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0042_Text
msgctxt "2e983036-18df-4b07-9653-63e99e9bc994"
msgid ""
"\"Thank you, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! I hope "
"to hear from you soon.\""
msgstr "\"감사합니다, {mf|영주님|영주님|전하|전하}! 곧 답변을 주시리라 믿겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0044_Text
msgctxt "ddd95575-50e7-452b-8d22-6a57268a59c6"
msgid ""
"\"Ah…. I see. Well, you are in your rights.\" {n}The half-elf makes a sloppy "
"bow and turns away.{/n}"
msgstr "\"아... 알겠습니다. 뭐, 그러실 수도 있겠지요.\" {n}하프엘프는 인사를 하는둥 마는둥 하더니 돌아나갑니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0046_Text
msgctxt "ffa30d22-7d62-4245-9e6f-decd035f06ec"
msgid ""
"{n}The half-elf hesitates.{/n} \"You see… Right now, we're close to the "
"people. If we put on a uniform, well, they'll accuse us of selling out to "
"the authorities. And we wouldn't want that, would we?\""
msgstr ""
"{n}하프 엘프가 주저합니다.{/n} \"그게... 지금은 주민들이 우리 편이지만, 우리가 제복을 입으면, 그, 우리가 권리를 "
"팔아먹었다며 비난할 겁니다. 그게 우리가 바라는 상황은 아니잖습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0048_Text
msgctxt "4ef12ccf-7983-4985-8ec7-ddd83c70e774"
msgid ""
"{n}The half-elf livens up.{/n} \"Oh yes – I'm a master leatherworker, after "
"all! Armor, boots — I make it all. I just can't find a proper place to "
"practice my craft. If you help me with that, I can work for you. But only if "
"you satisfy my request and help us organize a militia!\""
msgstr ""
"{n}하프엘프가 반색합니다.{/n} \"아 그럼요. 저는 가죽공예의 명장니까요! 갑옷부터 신발까지 전부 다 만듭니다. 지금은 제 공예를 "
"연마할 적절한 장소를 찾지 못했습니다. 그 부분을 도와주시면, 당신을 위해 일할 수 있습니다. 하지만 제 요청을 들어주시고 민병대를 "
"만드는 데 도움을 주셔야겠지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0049_Text
msgctxt "ad2d616e-e8ee-4dd6-91ed-b2056de8fc96"
msgid ""
"{n}Tirval speaks with pride in her voice.{/n} \"Thank you for supporting our "
"militia. We bought the best equipment, and we've already begun with drills. "
"As it happens, at the meeting I was elected captain. It must mean they trust "
"me. Your soldiers are training my people as we speak. If you hadn't stepped "
"in to help, none of this would have happened.\""
msgstr ""
"{n}터발은 자신있게 말합니다.{/n} \"민병대 조직에 도움을 주셔서 감사드립니다. 저희는 최고의 장비를 구매했고, 이미 훈련을 "
"시작했습니다. 공교롭게도, 회의에서 제가 민병대장으로 선출되었습니다. 저를 믿는다는 뜻이겠지요. 말씀드렸듯이 당신의 병사들은 제 부하들을 "
"훈련시키고 있습니다. 당신이 도와주시지 않았다면 이럴 수 없었을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0051_Text
msgctxt "dd35825c-1a99-4e9c-ae29-11a6b21ac747"
msgid ""
"{n}Tirval purses her lips and remains silent for a few moments. She then "
"harrumphs, bow, and without a word, turns and walks away.{/n}"
msgstr "{n}터발은 입술을 오므리고 잠시 동안 침묵을 지킵니다. 그리고 헛기침을 하더니, 인사하고 말없이 돌아서서 걸어나갑니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_0055_Text
msgctxt "8f06a0da-d61d-4bda-b23d-7e4f711be32b"
msgid ""
"\"I'm Tirval, leatherworker – and the leader of Varnhold's militia! I can "
"handle any leather work, foot to finger, and I can enchant them as well. I'm "
"especially good at leather armor. One day I'll make something very special "
"for you – leather like steel, but light as a feather. You'll be able to move "
"like it was nothing at all.\""
msgstr ""
"\"저는 터발입니다. 피혁공이자 반홀드 민병대장이지요! 저는 머리부터 발끝까지 모든 가죽 제품을 다루고, 마법 부여까지 가능합니다만, "
"특히 가죽 갑옷이 특기입니다. 언젠가 당신에게 아주 특별한 물건을 만들어 드릴겁니다. 강철 같이 튼튼하고, 깃털처럼 가벼운 걸로 "
"말이지요. 입고도 마치 아무것도 안입은 듯 움직일 수 있을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Cue_Shared_Gift_Text_String
msgctxt "7932cc5a-204b-4236-9af7-a6e800b3f82a"
msgid ""
"\"But that was beside the point. I sincerely hope that my gift comes in "
"handy. Tell me if it's something special you need — I can make any wish come "
"true!\""
msgstr ""
"\"하지만 그것과는 별개로, 제 선물이 도움이 되기를 진심으로 바랍니다. 특별한 것이 필요하면 말씀하십시오. 어떤 소원이라도 이루어 드릴 "
"수 있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_HalfElfFemaleLeatherworkerLG/Shared_LEathermasterGift_String
msgctxt "a112a7d6-0997-465c-9079-256a7f4789a4"
msgid ""
"{n}The half-elf hands a wrapped parcel to you.{/n} \"I personally vouch for "
"its quality. I made it with my own hands, every stitch and cut. I hope "
"you'll like it!\""
msgstr ""
"{n}하프엘프는 포장된 꾸러미를 당신에게 건넵니다.{/n} \"제가 직접 품질을 보장하겠습니다. 제 손으로 직접 제단하여 한 땀 한 땀 "
"꿰멨습니다. 마음에 드셨으면 좋겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/KTC_Warden/Cue_0004_Text
#. Speaker : Linzi_Companion
msgctxt "b5369d36-b13f-4143-b330-bae2bf304eae"
msgid ""
"\"{name}, I've just received word… Did you know that there's trouble brewing "
"in Varnhold? Their militia is at odds with itself! The captain cannot keep "
"her soldiers in line. According to her, they've gotten completely out of "
"hand. – It might even come to bloodshed! I think you should pay them a visit "
"personally.\""
msgstr ""
"\"{name}. 방금 들은 소식이에요... 반홀드에 문제가 생긴 거 알아요? 그쪽의 민병대에 내분이 일어났어요! 대장이 자신의 부하들을 "
"단속하지 못했네요. 그녀가 말하길 완전히 통제를 벗어났대요. 유혈사태가 벌어질지도 몰라요! 제 생각엔 당신이 직접 가봐야 할거 같아요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0004_Text
msgctxt "4d997539-cc88-4b0d-81cb-41fb4ccf8676"
msgid "[Call out to the man] \"You there, what do you want?\""
msgstr "[남성을 부릅니다] \"거기. 원하는 게 뭐야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0005_Text
msgctxt "4e720f7e-18c6-42f2-9eb3-f712d33dda4e"
msgid "\"Tirval, what is happening here?\""
msgstr "\"터발. 무슨 일이야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0006_AlignmentShift.Description
msgctxt "e6c7914b-4629-40e5-b32f-095da457e1b1"
msgid "Demanded that Tirval quenches the mutiny in the militia's ranks."
msgstr "터발에게 민병대 내부의 반란을 진압하라고 요구했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0006_Text
msgctxt "b654ee63-0a9f-4ac2-80ec-b9e0879fddb5"
msgid "\"Tirval, take care of your people right now! I will support you.\""
msgstr "\"터발, 당장 부하들을 단속해! 내가 도와주지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0007_AlignmentShift.Description
msgctxt "7ce3ea14-3972-405d-a70d-e7de7fa55183"
msgid "Gave all the power in Varnhold to the militia."
msgstr "반홀드의 모든 권한을 민병대에게 넘겨주었습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0007_Text
msgctxt "7d8d42f4-4650-4b1a-a2cc-026ba799558c"
msgid ""
"\"I agree with this person. You are not fit to lead the militia, Tirval.\""
msgstr "\"이 사람 말이 맞아. 너는 민병대 대장에 어울리지 않아, 터발.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0013_AlignmentShift.Description
msgctxt "334e55d2-8696-4332-86e9-8c6ab41de22c"
msgid "Executed the mutineers from the Varnhold militia."
msgstr "반홀드 민병대의 반란군을 처형했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0013_Text
msgctxt "e7c2fc1d-cf6a-40bd-8c1b-f6766386654d"
msgid ""
"\"Hang the troublemakers and disband the militia. I am the law in this land."
"\""
msgstr "\"민병대의 반란군을 교수형에 처하고 민병대를 해체한다. 나는 이 땅의 법을 지키겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0014_AlignmentShift.Description
msgctxt "7725a1fc-9a85-4c80-974e-ae38102c39c5"
msgid "Disbanded the Varnhold militia."
msgstr "반홀드 민병대를 해산합니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0014_Text
msgctxt "01290a2d-472b-4ddc-8443-ebb2a4eacb25"
msgid ""
"\"Let them live. But the militia will have to be disbanded. You are too "
"unreliable.\""
msgstr "\"그들을 살려두어라. 하지만 민병대는 해산이다. 너희를 도저히 믿을 수 없군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0015_AlignmentShift.Description
msgctxt "ed44d92c-4e68-414f-be27-c4a56a888384"
msgid "Spared the members of the Varnhold militia."
msgstr "반홀드 민병대원들을 살려줍니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0015_Text
msgctxt "07631124-053d-45bb-8eee-188556a17f74"
msgid ""
"\"Place them under house arrest until they come to their senses. As for the "
"militia, I'll give you one more chance.\""
msgstr "\"그들이 정신을 차릴 때까지 체포해두어라. 민병대에게는 한번 더 기회를 주겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0072_Text
msgctxt "be3b3c3d-dcd5-45d4-acee-e11cf2772494"
msgid "\"Why hasn't this revolt already been dealt with, Tirval?\""
msgstr "\"왜 이 반란을 처리하지 못했지, 터발?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0074_AlignmentShift.Description
msgctxt "f6d37563-dbf5-49d1-bc70-e58bb4b397a1"
msgid "Slaughtered the Varnhold militia."
msgstr "반홀드 민병대를 학살했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Answer_0074_Text
msgctxt "bbf1b16c-8045-4286-8867-600509755479"
msgid ""
"[Attack] \"I'm sick and tired of you! It's time I took care of you myself!\""
msgstr "[공격] \"네놈들한테 완전히 질렸다! 이제 내가 너희를 직접 상대해주마!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0001_Text
msgctxt "4f9b0e29-90e9-401b-8a34-b9a7bd9a5f5a"
msgid ""
"{n}A fraught scene is playing out before you: {d|Tirval}Tirval{/d}, the "
"captain of the militia, is in a fiery argument with an angry man in heavy "
"armor. Their hands are on the hilts of their weapons, and their eyes are "
"locked. Their stares are so intense they could petrify a lesser warrior.{/n}"
msgstr ""
"{n}당신 앞에 좋지 않은 장면이 펼쳐집니다. 민병대 대장 {d|Tirval}터발{/d}이 중무장을 한 화난 남자와 격렬하게 말다툼을 "
"하고 있습니다. 그들은 무기를 쥐고 있었고 서로를 노려보고 있었습니다. 그들의 시선이 만들어내는 긴장감 때문에 부하 병사들을 꼼짝도 "
"못하고 있습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0011_Text
msgctxt "1e7ece59-58ea-418c-9b59-b9efd2110a75"
msgid ""
"{n}{d|Tirval}Tirval{/d} gives you a tired look, but there's an ingratiating "
"tone to her voice.{/n} \"Please, {mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}, do not execute these fools! Yes, they have… overstepped "
"their bounds. But this was simply folly, nothing more! I implore you, have "
"mercy on the guilty and do not disband the militia altogether!\""
msgstr ""
"{n}{d|Tirval}터발{/d}은 지친 기색으로 당신을 바라보면서도, 목소리 만큼은 당신의 비위를 맞추려 합니다. {/n} \""
"{mf|영주님|영주님|전하|전하}, 제발 이 멍청이들을 살려주십시오! 그래요. 그들은... 선을 넘었습니다. 하지만 그냥 바보짓을 했을 "
"뿐입니다! 죄를 지은 자들에게 자비를 베풀어 주시고, 민병대를 완전히 해산하지 말아 주시기를 간청합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0016_Text
msgctxt "37b84a56-2161-4dfc-b049-bcfe3dcd84ac"
msgid ""
"{n}Tirval gives you a solemn look.{/n} \"That would serve no purpose. All "
"these people wanted was to protect their homes and their streets. And all it "
"took was a single mistake for you to… But it shall be as you wish. But do "
"not expect me to stay here even a moment longer than necessary. Farewell, "
"{mf|Your Grace|Your Grace|Your Highness|Your Highness}.\""
msgstr ""
"{n}터발은 굳은 표정으로 당신을 바라봅니다.{/n} \"그건 아무런 소용이 없을 겁니다. 이 사람들이 원했던 것은 그들의 집과 거리를 "
"보호하는 것이었습니다. 근데 단 한 번의 실수로 당신은… 그러려면 그러십시오. 하지만 제가 이곳에 한 시라도 더 머물 필요는 없어진 것 "
"같군요. 그럼 안녕히 계십시오, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0017_Text
msgctxt "53ca097f-e6ec-401b-ad4d-a65a1e6c4c4a"
msgid ""
"{n}Tirval shakes her head in regret.{/n} \"What a pity… but perhaps the "
"people really cannot be trusted to protect themselves, after all. And still… "
"never mind. It's our fault.\""
msgstr ""
"{n}터발은 후회로 고개를 흔듭니다.{/n} \"어쩌다 이런 일이... 결국 사람들이 스스로를 지킨 다는 건 진정으로 믿을 게 못되는 "
"걸지도. 하지만 아직... 아닙니다. 이건 우리 잘못이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0018_Text
msgctxt "837528da-d524-4d95-b356-94eafaa89028"
msgid ""
"{n}Tirval smiles, her face beaming with gratitude.{/n} \"Thank you. You have "
"my word, this will not happen again. We won't let you down. Listen up, you "
"oafs! Away with you! Back to your homes, everyone!\""
msgstr ""
"{n}터발의 얼굴이 감사의 미소로 환하게 빛납니다.{/n} \"감사합니다. 맹세코 다시는 이런 일이 없을 겁니다. 실망시켜 드리지 "
"않겠습니다. 잘 들어라, 이 멍청이들! 저리 꺼져라! 여러분, 집으로 돌아가세요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0019_Text
#. Speaker : GuardFighterMeleeLevel6Leader
msgctxt "3727c3a2-a84b-4e6e-aa8f-477056046c89"
msgid ""
"\"What's there to explain… We got ourselves an army here, right? That means "
"we can defend our land on our own now, right? We build these little old huts "
"ourselves, we plow the fields, we fend off the bandits. That means we "
"deserve to rule Varnhold ourselves. We've no more need for strangers.\""
msgstr ""
"\"그러니까... 우리는 군대를 조직했잖아? 그 말은 우리가 스스로를 지켜야 한다는 것이고. 우리는 여기에 집을 짓고 땅을 일구며 도적을 "
"물리쳤어. 그러니까 우리는 반홀드를 지배할 권리가 있다는 거지. 우리는 이방인이 필요하지 않아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0020_Text
msgctxt "65f7e546-e852-493a-996e-563dde27f12a"
msgid ""
"\"These idiots here decided they want to pretend they're independent now! "
"They've all but forgotten the vows they gave you! The fools can't see that "
"if you were to leave Varnhold, the whole region would fall into chaos! The "
"bandits would be back fighting for dominance all over again! The rivers "
"would flow red! But we gave them law and order! And if they decide to give "
"it all up?! Why, if they'll be such fools, perhaps we should let them have "
"what they think they want...\""
msgstr ""
"\"여기 이 멍청이들은 이제 자기들이 독립이라도 한 줄 아나 봅니다! 이 자식들은 당신에게 한 맹세를 싸그리 잊어버렸어요! 당신이 "
"반홀드를 떠나게 되면 온 지역이 혼란에 빠질 거란 걸 이 바보들은 왜 모르는 걸까요! 도적단이 다시 돌아와 세력다툼이 온 지역에서 벌어질 "
"겁니다! 강이 피로 물들거고요! 우리는 그들에게 법과 질서를 주었는데, 왜 그걸 다 갖다 버리려는 거죠?! 이놈들이 그렇게 바보라면, "
"차라리 아예 하고싶은 대로 하라고 해야 할지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0021_Text
msgctxt "b29d32d7-6f26-4fdf-a155-95d82879efa5"
msgid ""
"\"Yes, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! Now we'll put "
"these upstarts in their place…\""
msgstr "\"예, {mf|영주님|영주님|전하|전하}! 이제 이 건방진 놈들을 제자리로 돌려 보내겠습니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0022_Text
#. Speaker : GuardFighterMeleeLevel6Leader
msgctxt "911fc919-3918-41ef-81f6-4861eb03f912"
msgid ""
"{n}The militiaman cracks a broad grin.{/n} \"There, heard that? The capital "
"cares about the will of the people after all! As for — go, run back to the "
"big city. You're not welcome here anymore! We'll run things our way here, "
"the Varnhold way! Thank you, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}, for taking our matter to heart, and for listening to the people!\""
msgstr ""
"{n}민병대 한명이 씩 웃습니다.{/n} \"\"자, 들었어? 수도에서는 무엇보다 국민들의 의지가 중요하다는데! 이건 어떨까, 어서 큰 "
"도시로 돌아가시지. 당신은 여기서 더이상 환영받지 못해! 우린 여기서 반홀드 식으로 해나갈테니! 고맙수다, "
"{mf|영주님|영주님|전하|전하}, 우리 문제를 마음에 새기고 국민 말씀을 들어주셔서!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0026_Text
#. Speaker : Artisan_Leatherworker
msgctxt "b0e026b2-7b34-40de-97df-76a811f81f0d"
msgid ""
"\"Thank the gods you're here! Reign in these dogs! They're inciting revolt "
"and trying to rile up my militia-men!\""
msgstr "\"신이시여 감사합니다! 오셨군요! 이 개자식들을 다스려주십시오! 반란을 선동하고 저희 민병대를 자극하고 있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0027_Text
#. Speaker : GuardFighterMeleeLevel6Leader
msgctxt "4b37c0ce-eadd-4e8a-9d3b-911498cdf3b7"
msgid ""
"\"Aha! She sees her master and runs to lick {mf|his|her} boots! This land "
"belongs to us, not this… bird of passage. We plow these fields – and we "
"protect them as well. When the bandits come, we'll be the ones out there "
"shedding blood for our homes, while the big city folk hide in their holes! I "
"say – no more!\""
msgstr ""
"\"아하! 주인이 오니까 개처럼 신발을 핥는구만! 이 땅은 우리 것이다, 이... 철새야, 네 것이 아냐. 우리가 이 밭을 갈고, 우리가 "
"그걸 지킨다. 도적이 오면, 우리는 우리의 터전을 위해 피를 흘릴 것이다. 도시놈들이 쥐구멍에 숨는 동안에 말이지! 내 말은... "
"여기까지다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0028_Text
#. Speaker : GuardFighterMeleeLevel6Leader
msgctxt "eacdd878-6535-431f-96b0-42eb927164f4"
msgid ""
"\"Heh, you wish! You hear that, folks? They want us to run home with our "
"tails between our legs! Whaddya think? We fighting for our land or what?\""
msgstr ""
"\"헤, 그러고 싶겠지! 여러분, 들으셨죠? 저놈들은 우리가 꼬리를 말고 집으로 줄행랑 치기를 바랍니다! 우째야겠습니까? 우리 땅을 위해 "
"싸울겁니까? 말겁니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0034_Text
msgctxt "242475fd-7bfd-4a1c-8f8d-fab41bb5cfe8"
msgid ""
"{n}Tirval gives you a solemn look.{/n} \"You know you've doomed this place, "
"don't you? Who are you leaving in charge? These nitwits? They'll do a damn "
"fine job running this place, they will… Without law, without order, this "
"land will descend into mayhem. I'd rather leave this land forever than watch "
"that happen. It was a pleasure knowing you, {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}. Farewell.\""
msgstr ""
"{n}터발은 굳은 얼굴로 당신을 봅니다.{/n} \"당신이 여길 망하게 만든겁니다. 알고 계시죠? 누구에게 책임을 넘긴 겁니까? 이 "
"팔푼이들에게? 이놈들이 참 잘도 이곳을 다스리겠습니다. 이 자식들은... 이 땅은 법도 질서도 없이 아수라장이 되겠지요. 그 꼴을 보느니 "
"차라리 이 땅을 떠나겠습니다. 만나서 즐거웠습니다. {mf|영주님|영주님|전하|전하}. 그럼 이만.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0036_Text
#. Speaker : GuardFighterMeleeLevel6Leader
msgctxt "ef5f8d21-282e-45cd-8082-761f9ca94f4d"
msgid ""
"\"What you say is true. You have helped us arm ourselves, and for that we "
"are thankful. That's why we don't want to break away from the "
"{mf|barony|barony|kingdom|kingdom} — we just want to rule our own homes! "
"What gives you the idea that you, living in the capital, know better than us "
"what Varnhold really needs? Trust me, you'll only thank us once you set us "
"free!\""
msgstr ""
"\"그건 맞는 말이군. 당신은 우리가 무장하는 걸 도왔수다, 그건 감사하게 생각합니다. 그래서 우리도 {mf|남작령|남작령|왕국|왕국}"
"에서 벗어나고 싶지는 않다우. 그냥 우리의 터전을 우리 생각대로 하고 싶을 뿐이지! 정말 수도에 살면서 반홀드가 진짜 필요한게 뭔지 "
"우리보다 잘 안다고 생각하쇼? 그러지 말고, 한번 우리한테 맡겨보면 외려 고마워 하게 될거요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0070_Text
msgctxt "13575955-c9d6-43aa-8773-5ab33fcbe597"
msgid ""
"\"Do you even remember whose gold bought those weapons? Who taught you to "
"fight? Who gathered the militia in the first place?\""
msgstr ""
"\"이 무기를 사려고 누구 돈을 썼는지 기억하나? 싸우는 법을 알려준 게 누구지? 처음 여기다 민병대를 조직한 사람이 누구라고 생각하나?"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0071_Text
#. Speaker : GuardFighterMeleeLevel6Leader
msgctxt "6593e8a4-fc56-4d22-8c5e-bed640f3819a"
msgid ""
"\"And what will you do? Hang us all? And then what? Send in your soldiers? "
"That's the true face of your 'grace' and 'mercy'! You butcher anyone who "
"speaks out against you! You two-faced bastards…\""
msgstr ""
"\"뭐 어떻게 한다고? 싹 다 교수형? 그러고 나면? 병사를 보낼건가? 이게 네놈이 말하는 '은혜'와 '자비'의 진면모구만! 네 말에 "
"반대한다고 모두 죽일 셈이냐! 빌어먹을 위선자 새끼...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfFemaleLeatherworkerLG/LeviesAndGuardians/Cue_0073_Text
msgctxt "c7fb77d1-cfd8-4696-95b6-87109e90ae85"
msgid ""
"\"Forgive me, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. It's "
"just…\" {n}The half-elf lowers her voice.{/n} \"These were our people, {mf|"
"Your Grace|Your Grace|Your Highness|Your Highness}. Our neighbors, farmers, "
"craftsmen… I didn't want to spill even more blood... But I... I suppose I've "
"failed, haven't I?\""
msgstr ""
"\"용서해주십시오. {mf|영주님|영주님|전하|전하}. 이건 그저...\" {n}하프엘프의 목소리가 낮아집니다.{/n} \"이들도 우리 "
"백성입니다, {mf|영주님|영주님|전하|전하}. 우리 이웃, 농부, 장인... 저는 더이상 피가 흐르는 걸 원치 않습니다... 하지만 "
"전... 안되나보군요, 그렇죠?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Answer_0003_Text
msgctxt "a85cae76-b3ff-4a88-9f96-b1dfb951bbff"
msgid ""
"\"Morhalan is under arrest. He's patching quilts in a prison cell right "
"about now.\""
msgstr "\"모할란은 체포되었어. 지금 감옥에 수감되어 있지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Answer_0008_Text
msgctxt "98015ee3-52d8-4ad9-a194-4ae719dc1277"
msgid "\"What did you want to tell me?\""
msgstr "\"내게 뭘 말하고 싶은거니?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Answer_0009_Text
msgctxt "d6958ce1-cb9d-49b1-8028-8eece7ecfc10"
msgid "\"I'd like to know more about you.\""
msgstr "\"너에 대해 더 알고 싶어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Answer_0010_Text
msgctxt "e01e9311-2729-4a44-b21a-e247a541f139"
msgid "\"I have to go.\""
msgstr "\"난 가야돼.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Answer_0014_Text
msgctxt "d8aa0796-08f2-422a-9e6c-e4318e97c13e"
msgid "\"Where are you from?\""
msgstr "\"넌 어디서 온 거야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Answer_0015_Text
msgctxt "c141087a-acc9-40dc-8886-18cde7353f55"
msgid "\"How did you become a tailor?\""
msgstr "\"어떻게 재단사가 되었어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Answer_0018_Text
msgctxt "50ed5d7f-6021-4ee9-b776-cfd1c8e2c9b8"
msgid "\"Let's discuss it later.\""
msgstr "\"나중에 논의합시다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Answer_0028_Text
msgctxt "7161ac2d-056e-4bdd-bd48-d2a0c85dd071"
msgid "\"Look at these skins. They were stripped off of murdered lizardfolk.\""
msgstr "\"이걸 봐. 도마뱀 인간의 가죽을 벗긴 것이군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Answer_0034_Text
msgctxt "bdec05c7-48ca-4b24-a434-a1d193771f3a"
msgid "\"You blush all the time.\""
msgstr "\"너는 항상 얼굴이 붉구나.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Answer_0036_Text
msgctxt "a31b42ed-e431-4717-ae9b-74b67b45f6dc"
msgid "\"All right, I'll track down the hunters.\""
msgstr "\"좋아. 내가 사냥꾼들을 추적하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Answer_0037_Text
msgctxt "6ad46554-bb39-4665-84c0-15641ca2d43b"
msgid "\"I can't make any promises.\""
msgstr "\"나는 어떤 약속도 할 수가 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Answer_0038_Text
msgctxt "7ebb7876-a1e9-46ca-959b-04b03b281c80"
msgid "\"I can't waste my time on this.\""
msgstr "\"나는 시간 낭비할 수 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0001_Text
msgctxt "307c2c26-5612-4769-8bd5-9c9442113b6f"
msgid ""
"\"Oh, it's you! Please, accept my gratitude for the workshop! The house is "
"beautiful, the neighbors are wonderful, and everyone is so kind and "
"friendly! I'm flooded with orders! And to think I could still be "
"{d|Shariel}rotting{/d} away in jail for a false accusation...\""
msgstr ""
"\"오. 당신이군요! 공방을 마련해 주신 것에 대해 부디 제 감사를 받아주세요! 이 집은 아름답고 이웃들은 훌륭해요. 모두 친절하고 "
"상냥합니다! 주문이 넘쳐 들어와요! 그리고 하마터면 누명으로 내가 여전히 감옥에서 {d|Shariel}썩고 있을 수 있겠다{/d} "
"생각해요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0011_Text
msgctxt "71ff9792-45ea-4e1f-a6cd-d960cf55b572"
msgid ""
"{n}The half-elf puts his hand on his heart.{/n} \"I am happy to see you at "
"any time!\""
msgstr "{n}하프엘프는 손을 가슴에 얹습니다.{/n} \"언제든 다시 와주세요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0017_Text
msgctxt "e7c10d45-88a5-42f9-98c8-8bd208e864a2"
msgid ""
"{n}Sharel looks around nervously.{/n} \"I beg your forgiveness, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}, for making you come all the "
"way to our distant region... There are too many guards in the palace that "
"were chasing me recently. The thing is, I think I know who wrongfully "
"accused me. There's a tailor in the capital – his name is Morhalan. He has "
"the reputation of a brilliant master, so I wanted to become his apprentice. "
"But when I went to his workshop...\""
msgstr ""
"{n}샤렐은 걱정스럽게 주변을 봅니다.{/n} \"용서를 구합니다, {mf|영주님|영주님|전하|전하}.  이런 먼 곳까지 오시게 "
"했습니다... 하지만 궁전에는 당시 저를 추적하던 경비들이 너무 많았어요. 중요한 건 제 생각에는 제가 저에게 누명을 쒸운 자를 알고 "
"있다는 겁니다. 수도에는 모할란이라고 불리는 재단사가 있지요. 그 사람은 유능한 재단사로 명성을 떨치고 있어서 전 그의 도제가 되길 "
"원했습니다. 하지만 제가 그의 공방에 찾아갔을 때에는...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0019_Text
msgctxt "e7b047de-0c56-4dc6-8ceb-561488a2cb3b"
msgid "\"As you wish. I'm always happy to talk to you.\""
msgstr "\"바라시는 대로. 언제든 오셔서 말씀 나눠 주세요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0020_Text
msgctxt "64bcb241-8565-43c4-b689-552fdec42c4c"
msgid ""
"\"I come from Erages. It's a small fishing town in Kyonin. That's the place "
"where the elves send my kind into exile. The exile for half breeds. My "
"father is a fisherman and a smuggler. He served as a steersmate on an "
"Andoran warship until he met my mother and settled down. My mother is a net "
"weaver. There's an art to weaving a fishing net! And my mother is simply the "
"best at it. She taught me to tie knots and weave patterns...\""
msgstr ""
"\"저는 에라지스에서 왔습니다. 쿄닌의 작은 어촌 마을이지요. 그곳에서 엘프들이 우리들을 추방했지요. 우리 같은 혼혈 말이에요. 우리 "
"아버지는 밀수하는 어부셨어요. 그는 우리 어머니를 만나 정착하기 전까지는 안도란 군함의 선원이었구요. 우리 어머니는 그물을 짰습니다. "
"어머니가 짠 그물은 정말 예술 작품과 같았죠. 우리 어머니의 솜씨는 최고였고. 그녀가 내게 매듭을 매는 방식을 알려주었죠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0021_Text
msgctxt "02fd4157-9649-46c1-8a09-bb2885b45aec"
msgid ""
"\"I started when I entered Erages Academy. I wasn't much into archeology, "
"but you don't have many options in Erages. It's either the Academy or a "
"fishing business. That was when I realized that an ancient elven ornament "
"can spruce up any object at all. I realized that using this sort of design "
"made anything I sewed exquisite – and quite popular. A couple of months "
"later, half the student body was wearing my vests and capes. I'd finally "
"found my passion. But then I left, in search for better opportunities.\""
msgstr ""
"\"저는 에라지스의 아카데미에 들어갔을 때부터 시작했습니다. 전 고고학에 흥미가 없었지만 에라지스에 있으면 선택 사항이 많지 않더 나은 "
"기아요. 그렇지 않으면 고기를 잡아야 했지요. 그 때 나는 고대 엘프 장식이 어떤 물건이라도 치장할 만큼 아름답다는 걸 알았어요. 그 "
"유물들의 디자인을 사용하면 옷을 만들어도 멋지다는 걸 깨달았습니다. 몇달 후 아카데미 학생 절반은 내가 만든 조끼와 겉옷을 입고 다녔죠. "
"자는 마침내 제 열정을 발견했던 거에요. 그때 저는 더 나은 기회를 찾아 위해 떠났습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0023_Text
msgctxt "b15bba9f-9774-42dd-b296-1e9fa25fb606"
msgid ""
"\"You'll hardly take my word for it – but it's true! A master tailor in the "
"capital is butchering lizardfolk to make clothes from their skins! I'm no "
"tracker. I can't go hunting down Morhalan's poachers... But you could! If "
"only you could find those murderers in the marshes and bring some evidence, "
"the guards will take this seriously, and we'll rid the capital of great evil!"
"\""
msgstr ""
"\"제 말을 믿기 어려우시겠지만 그건 진짜입니다! 수도의 한 장인 재단사가 도마뱀 인간의 가죽으로 옷을 만들려고 그들을 도륙하고 "
"있습니다! 저는 추적자가 아닙니다. 제가 모할란의 밀렵꾼들을 쫓아가는 건 불가능해요... 하지만 영주님은 가능하지요! 영주님이 증거를 "
"가져오면 경비들은 믿을 것이고 우리는 수도에서 거대한 악행을 제거하게 될겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0027_Text
msgctxt "ed5da865-bc08-483e-93c8-314d69f45454"
msgid ""
"\"Oh, I hope he finds enough Light in his soul that he can someday see the "
"graveness of his crime. You can't slaughter intelligent beings as if they "
"were beasts, and make clothes of their skins!\" {N}Sharel stays silent for a "
"few seconds and then shakes his head.{/N} \"Even now that it's over, it's "
"hard to believe this evil act really took place.\""
msgstr ""
"\"그가 자신의 영혼에 빛을 찾아 언젠가 죄를 뉘우치기를 바랍니다. 짐승이 아닌 한 지적 생명체를 죽여 그들의 가죽으로 옷을 만들 수는 "
"없어요!\" {N}샤렐은 잠시 침묵하고는 고개를 흔듭니다.{/N} \"이제 그게 끝났다고 해도 그런 일이 있었다는 건 정말 믿기 어렵군요."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0029_Text
msgctxt "e786c3a6-a3c3-4fcb-bd0f-20f999b1b068"
msgid ""
"{n}Sharel looks frightened. He touches the skins with evident disgust.{/n} "
"\"They were skinned very skillfully. There's no doubt about it. The butchers "
"meant to use these skins for leatherwork. If they were just trying to scare "
"someone with a bloody murder, they would have made more cuts. But here they "
"made the least. The butcher was clearly saving the skin. I was right! "
"Morhalan is buying the skins of lizardfolk! He's a monster! Thank you for "
"your support! Now I have all the evidence I need. Now I've taken too much of "
"your time already. I will go to the guards and see the monster arrested "
"myself.\""
msgstr ""
"{n}샤렐은 겁먹은 것처럼 보입니다. 그는 역겹다는 듯 그 가죽을 만집니다.{/n} \"아주 능숙한 솜씨로 가죽을 벗겼군요. 이것으로 "
"확실해졌습니다. 도살자들은 이 가죽으로 가죽 세공을 하려고 했던 겁니다. 그들이 누구를 겁주려고 살생을 한 거라면 더 많은 상처가 있어야 "
"해요. 하지만 상처가 거의 없어요. 도살자들은 깔끔하게 가죽을 제거했어요. 내가 옳았어! 모할란은 도마뱀 인간의 가죽을 사려고 했던 "
"거야! 괴물 같은 놈이군. 도와주어 고맙습니다! 이제 필요한 증거를 얻었어요. 당신의 시간을 이미 많이 뺏은 것 같군요. 저는 경비에게 "
"가서 그 놈이 잡혔는지 직접 확인해야겠어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0030_Text
msgctxt "9dcce7dd-022c-4154-9a71-62d546ba48ef"
msgid ""
"{n}The young Sharel looks embarrassed. He fixes his hair, trying to hide the "
"blush in his cheeks.{/n} \"What... what would you like to know?\""
msgstr ""
"{n}어린 샤렐은 당황한 것처럼 보입니다. 그는 머리를 고쳐 붉어진 뺨을 숨기려 합니다.{/n} \"뭐... 뭘 알고 싶으신 가요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0031_Text
msgctxt "b4bf6ab0-5807-4413-b07f-f56a09fb6700"
msgid ""
"{n}The {d|Shariel}half-elf{/d} is whistling carelessly. He gives you a "
"graceful bow as he sees you.{/n} \"It's good to see you! How can I help you?"
"\""
msgstr ""
"{n}{d|Shariel}하프 엘프{/d}는 태평하게 휘파람을 불고 있습니다. 당신을 알아차리자 우아하게 인사합니다.{/n} \"반갑습니다"
"! 뭐가 필요하죠?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0032_Text
msgctxt "2936c6e5-2ce6-4baa-aa8c-949840003015"
msgid ""
"\"Thank you! I could never have brought Morhalan's crimes to light without "
"your support. Now that he's in jail, I might return to the capital... but "
"you know what? I've quite gotten used to the air here. And I have wonderful "
"neighbors. Fate has brought me here. So be it. I'm staying. Especially since "
"I've begun making sketches for a unique piece! Another relocation would only "
"delay its creation.\""
msgstr ""
"\"고맙습니다! 당신이 없었다면 모할란의 범죄를 밝힐 수 없었을 겁니다. 이제 그는 감옥에 있고 저는 수도로 돌아가봐야겠어요... 그런데 "
"그거 아세요. 저는 이곳의 분위기에 이미 적응했어요. 이웃들도 좋고. 운명이 절 이곳으로 이끌었나 봅니다. 그럼 좋아. 나는 여기에 "
"머물러야 겠어요. 저는 독특한 작품의 설계도를 만들기 시작했거든요! 이사를 간다면 제 작업만 더뎌질 뿐이겠죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0033_Text
msgctxt "b129ae64-7210-4291-a3cf-1dfc0e81d349"
msgid ""
"\"In his workshop, I saw... things which alarmed me very much. Vests, shoes, "
"gloves, all made from reptile skin. But the pattern was... distinct. I've "
"only seen the pattern on lizardfolk – intelligent beings, who also live in "
"the {g|Stolen Lands}Stolen Lands{/g}, as far as I know. I tried asking "
"Morhalan about it, but he threw me out into the cold. And when I tried to "
"start my own business and open a shop, I was literally driven out of the "
"capital!\""
msgstr ""
"\"그의 공방에서... 놀라운 것들을 봤습니다. 조끼, 신발, 장갑 등 모든 것들이 파충류의 가죽으로 만든 것이더군요. 하지만 그 "
"무늬는... 조금 독특했지요. 그건 지능이 있는 도마뱀 인간의 것인데 그들은 지적인 존재로 제가 알기로는 {g|Stolen Lands}"
"도둑맞은 땅에{/g}에 살고 있어요. 모할란에게 그것에 관해 물어보았지만 그는 나를 쫓아내더군요. 그리고 나는 수도에서 먼 곳에 내 "
"공방을 열게 된 거고요. 저는 문자그대로 수도에서 내쳐졌던 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0035_Text
msgctxt "ae98af62-f9d8-4e95-a083-12aa72a1a866"
msgid ""
"\"Me? Oh... Yes, indeed.\" {n}Sharel turns purple and laughs.{/n} \"I beg "
"your pardon, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! I'm not "
"used to chatting with the ruler of the {mf|barony|barony|kingdom|kingdom} "
"{mf|himself|herself}! Before I met you, I'd always thought that rulers never "
"talk to ordinary people. You're different!\""
msgstr ""
"\"저요? 오... 그래요, 정말.\" {n}샤렐은 얼굴이 붉어지더니 웃습니다.{/n} \"죄송합니다,  {mf|영주님|영주님|전하|전하}"
". 제가 높은 분과 얘기한 적은 익숙지 않아서! 당신과 만나기 전에는 전 통치자들은 저 같은 평민과는 절대 대화를 하지 않을 거라고 "
"생각했어요. 그런데 당신은 다르십니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0039_Text
msgctxt "5e28fd3c-dd2f-4282-981f-cf1653e01524"
msgid ""
"\"Thank the gods! I'm sorry I cannot say exactly where to find the wretches. "
"But I'm certain they must be hunting in the {g|Narlmarches}Narlmarches{/g}. "
"That's where you'll find them.\""
msgstr ""
"\"신들이여 감사합니다! 그 쓰레기놈들이 정확히 어디에 있는지 말할 수 없어 안타깝군요. 하지만 그들은 "
"{g|Narlmarches}날마치{/g} 어디에선가 사냥을 했을 겁니다. 그곳에서 그들을 찾을 수 있을 거에요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0040_Text
msgctxt "9afefd36-5a4f-4fb5-9fa8-d48787fc3c59"
msgid ""
"\"I understand, I'm asking for too much... but still, if you ever come "
"across these poachers on your travels, don't let them get away with it!\""
msgstr "\"알겠습니다. 당신을 너무 귀찮게 했군요... 하지만 여행을 하다가 그 밀렵꾼들을 만나면 꼭 잡아주세요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ArtisanHalfElfMaleTailorNG/Cue_0041_Text
msgctxt "8213339b-5793-4801-b04d-2326c4e35f82"
msgid ""
"{n}Sharel steps back in fear.{/n} \"I... I'm sorry! Forget what I just said! "
"I will... handle it myself... I guess. I'm sorry!\""
msgstr ""
"{n}샤렐은 두려워하며 뒤로 물러납니다.{/n} \"저는... 미안합니다! 제가 말한 건 잊어줘요! 저는... 제가 알아서 할게요... "
"죄송합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Barks/EvilTailorPoacher1_String
msgctxt "5ea18ec9-3292-4ff0-ba72-766e6f34d3a0"
msgid ""
"\"Lizardfolk aren't real people! – There's nothing to be sorry about! "
"They're only good for making boots!\""
msgstr "\"도마뱀 인간은 사람과 달라! 걱정할 필요가 없다고! 그냥 좋은 신발 재료일 뿐이지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Barks/EvilTailorPoacher2_String
msgctxt "d883cfe7-2202-4e83-bfd2-161da7da62cb"
msgid ""
"\"Huh, your noble skin is soft and gentle... You'll make a fine pair of "
"pants.\""
msgstr "\"네 가죽은 정말 부드럽구나... 좋은 바지가 될 수 있겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Barks/ImprisonedTailor_01_Tailor_String
msgctxt "699e1e2c-7897-4262-9d29-b0640613123c"
msgid ""
"\"I'm innocent! It's... a mistake! A terrible mistake! I haven't taken "
"anything from anyone!\""
msgstr "\"나는 결백해! 그건... 실수였어! 끔찍한 실수! 나는 누구의 것도 뺏지 않았어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Barks/ImprisonedTailor_02_Guard_String
msgctxt "834e631d-c6f6-4fc2-a9d2-9862555b5c9f"
msgid ""
"\"That's exactly what everyone always says. Every prisoner says they're "
"innocent if you ask them.\""
msgstr "\"모두 그렇게 말하지. 죄수들은 항상 자신들이 죄가 없다고 말해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Barks/ImprisonedTailor_03_Tailor_String
msgctxt "17e06daa-8745-4f23-a233-b4538bab8bd8"
msgid "\"Ask Hassuf! He'll tell you himself!\""
msgstr "\"하수프에게 물어봐! 그가 말해줄 거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Barks/ImprisonedTailor_04_Guard_String
msgctxt "c3578975-779b-4622-8664-b87f40044a3c"
msgid ""
"\"Are you suggesting I should drag myself all the way to the capital? No "
"way. It's your own fault you ran all the way out here. But now we've got you!"
"\""
msgstr "\"내가 수도로 갔어야 한다고 말하는 거야? 말도 안 돼. 여기에 온 건 네 잘못이야. 이제 너는 우리 거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Barks/Poacher1_String
msgctxt "f83c5764-4fbe-4c47-93b4-fe65bfc5f3ec"
msgid ""
"\"Oh damn, we're busted. Let's put 'em down! – We'll bury the bodies in the "
"swamp.\""
msgstr "\"젠장. 걸렸군. 저들을 잡아! 늪지에 시체들을 던져버리자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Barks/Poacher2_String
msgctxt "a0bfbcee-3360-44e4-828c-8096ccd04f95"
msgid "\"You shouldn't have come to this place...\""
msgstr "\"너는 이곳에 오지 말았어야 했어...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Barks/SurrendEvilTailor_String
msgctxt "ae077142-01c1-4d3f-8b4c-b597d5e1f417"
msgid ""
"\"Stop! I'm beg your mercy, {mf|sire|milady}! You win! The jail is better "
"than the grave.\""
msgstr "\"멈춰! 부탁이야! 네가 이겼어! 죽을 바에는 감옥이 나아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/EvilTailor/Answer_0003_Text
msgctxt "963e1ec6-2c17-4627-9145-cb42cfb776c0"
msgid "\"What are you suggesting?\""
msgstr "\"무얼 제안하려는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/EvilTailor/Answer_0004_AlignmentShift.Description
msgctxt "0dd97812-cb96-4c4d-a945-89f5ebcae51e"
msgid "Captured the flaying tailor."
msgstr "가죽을 뜯는 재단사를 구속했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/EvilTailor/Answer_0004_Text
msgctxt "3be90ee7-c29b-4516-b0b4-47b3d2b6b8f8"
msgid "[Attack] \"I'm not listening to this.\""
msgstr "[공격] \"네 말은 듣지 않겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/EvilTailor/Answer_0005_AlignmentShift.Description
msgctxt "b75485f9-8882-4f2d-a1b5-ab2631ff2c74"
msgid "Made a bargain with the flaying tailor."
msgstr "가죽을 뜯는 재단사와 협상했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/EvilTailor/Answer_0005_Text
msgctxt "b7546a99-2d48-4cff-a1b2-71172884edb5"
msgid "\"I rather like this idea.\""
msgstr "\"그 생각이 마음에 들어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/EvilTailor/Answer_0009_AlignmentShift.Description
msgctxt "89f7ec1f-29dd-4ff9-bc93-cf6eec333029"
msgid "Captured the flaying tailor."
msgstr "가죽을 뜯는 재단사를 구속했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/EvilTailor/Answer_0009_Text
msgctxt "ae0e3fe1-092f-439b-9878-cbafd49b9d72"
msgid "[Attack] \"What a disgusting offer. You will be brought to justice.\""
msgstr "[공격] \"역겨운 제안이군. 너는 정의의 심판을 받아야 한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/EvilTailor/Cue_0001_Text
msgctxt "847ddf47-15cc-4f29-beb1-14d3c4de05fd"
msgid ""
"{n}Morhalan looks at you apprehensively, but his voice sounds confident.{/n} "
"\"Greetings, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. I can "
"see that my humble efforts to escape your observant royal gaze seem to have "
"miserably failed! Well that'll be all right, it remains for me to make you "
"an offer that you will find hard to resist!\""
msgstr ""
"{n}모할란은 당신을 바라보며 자신있게 말합니다.{/n} \"{mf|영주님이|영주님이|전하|전하}잖아, 어서 와. 네 눈에 뜨이지 "
"않으려는 노력도 실패인 것 같군! 뭐, 오히려 좋을지도. 정말로 거절하기 힘든 제안을 하나 할게!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/EvilTailor/Cue_0006_Text
msgctxt "4bfea879-4635-4646-816d-a6bf54151f82"
msgid ""
"\"The very same thing that I offer all the other over-meticulous hunters and "
"prying guards. Gold. Gold, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. All that I've managed to save and scrape up over my life. Rest "
"assured, it's a very substantial amount. You wouldn't reject an offer like "
"this just because some naive spring chicken decided they want to play "
"justice!\""
msgstr ""
"\"사냥꾼이나 경비들에게 하는 제안과 다르지 않아. 돈이지. 돈을 주겠어. 내가 가진 전 재산을 주겠어. 엄청나게 많은 양이야. 이런 "
"거저 먹는 제안을 거절하기란 쉽지 않을 거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/EvilTailor/Cue_0007_Text
msgctxt "b0ea3bec-5e9c-4f79-b48d-a8a8c87ce65d"
msgid "\"Help me! Help me, lads!\""
msgstr "\"도와줘! 제발!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/EvilTailor/Cue_0012_Text
msgctxt "846d9dd4-fa49-4a62-9910-ac7ec3b8bad9"
msgid ""
"\"I'm happy to hear that you have found my offer sensible. Please accept "
"this purse of gold. Your people can collect the rest from my workshop. Now "
"if you will excuse me, there is one more matter that I simply must address "
"before I leave these lands.\""
msgstr ""
"\"제 제안이 마음에 들었다니 기쁘군요. 이 돈 지갑을 받아주세요. 나머지는 제 공방에서 받을 수 있을 거에요. 그럼 실례하지만 제가 이 "
"땅을 떠나기 전에 말해드릴게 한 가지 더 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Answer_0003_AlignmentShift.Description_String
msgctxt "fd4a0bc8-d5db-4e72-9d40-af27dae86e70"
msgid "Helped the wrongfully accused clear his good name."
msgstr "그의 명성을 되찾도록 누명을 벗기는 것을 도왔습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Answer_0003_Text
msgctxt "083aa98c-7719-4fe7-8e1f-029bb99689dd"
msgid ""
"\"I brought confirmation of his innocence from Hassuf. All accusations of "
"theft are false.\""
msgstr "\"하수프에게서 그가 결백하다는 것을 들었다. 모든 죄는 그저 누명이었어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Answer_0004_Text
msgctxt "744af827-c2ac-49a4-bd3c-8fd31956749c"
msgid "\"What is going on here?\""
msgstr "\"무슨 일이야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Answer_0005_Text
msgctxt "19266753-1c46-4f97-a150-9f925f9c3c7e"
msgid "\"What is this half-elf charged with?\""
msgstr "\"이 하프엘프는 무슨 죄를 지었지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Answer_0006_Text
msgctxt "8532b310-0ae2-4d8c-9599-4724c390be2f"
msgid "\"I must go.\""
msgstr "\"나는 가야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Answer_0015_Text
msgctxt "14cbf404-832b-49c3-9c87-7132e997aa20"
msgid ""
"\"I'm tired of hearing this wretch's screams. Put him in jail at once.\""
msgstr "\"이 쓰레기가 징징대는 건 질렸어. 감옥에 넣어버려.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Answer_0017_Text
msgctxt "4ddad7a7-6de6-4c52-bce6-7c5ce2af8322"
msgid ""
"\"I order you to release this man! He is innocent! Next time, conduct a "
"proper investigation before you arrest honest people!\""
msgstr "\"이 자를 풀어줘라! 그는 결백하다! 다음에는 정직한 사람을 붙잡기 전에 적절한 조사를 먼저 해야 할 거다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Cue_0001_Text
#. Speaker : Artisan_Tailor
msgctxt "32e62d0c-a40f-4e30-8834-9b8378079b43"
msgid ""
"{n}The young half-elf looks up at you, exhausted. Somebody has recently "
"given him a black eye. There's panic in his voice.{/n} \"I beg you, help me! "
"I haven't done anything wrong!\""
msgstr ""
"{n}어린 하프엘프가 지쳐서 당신을 봅니다. 누군가 최근까지 그를 감시한 것 같습니다. 그의 목소리는 힘이 없습니다.{/n} \"부탁이야"
". 도와줘! 나는 잘못한 게 없어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Cue_0007_Text
#. Speaker : Artisan_Tailor
msgctxt "559a8150-506b-4da9-a0ad-8687197d21b9"
msgid ""
"{n}The half-elf raises his head as you approach, and looks up at you with "
"eyes full of hope.{/n}"
msgstr "{n}하프엘프는 당신이 오자 고개를 들고 희망에 찬 눈으로 봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Cue_0008_Text
#. Speaker : GuardCapital
msgctxt "27c67ab5-9d63-4908-92b1-02f523f4d76c"
msgid ""
"\"Theft, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. We chased "
"him all the way out here from the capital. Stole something from a merchant "
"and escaped! Just another scoundrel, {mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}. Never mind him. They're all the same. He was found out, so "
"now he's yelling about being innocent.\""
msgstr ""
"\"절도죄 입니다, {mf|영주님|영주님|전하|전하}. 우리는 수도에서부터 그를 추적했습니다. 한 상인에게서 무언가를 훔치고 "
"달아났거든요! 그저 악당이나 다름 없습니다. {mf|영주님|영주님|전하|전하}, 신경 쓰지 마세요. 이놈들은 다 똑같습니다. 잡힌 후에 "
"자기는 무죄라고 소리를 질러대는 거죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Cue_0009_Text
#. Speaker : Artisan_Tailor
msgctxt "e07734d0-7e65-4906-9751-64824f43f6cc"
msgid ""
"{n}The half-elf looks shocked and terrified by his circumstance.{/n} \"You"
"'re the local ruler, aren't you? I beg you for your mercy! I've been "
"arrested as a thief, and I'm about to go to jail! But haven't done anything "
"wrong! I've never taken anything that wasn't mine. Someone slandered me for "
"stealing property from a merchant in the capital!\""
msgstr ""
"{n}하프엘프는 겁에 질린 것 같습니다.{/n} \"당신이 이곳의 통치자입니까? 부탁입니다! 저는 지금 도둑질로 감옥에 가게 생겼습니다! "
"하지만 저는 잘못한 게 없어요! 저는 도둑질하지 않았습니다. 누군가가 어떤 수도 상인의 물건을 제가 도둑질했다고 누명을 씌운겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Cue_0010_Text
#. Speaker : Artisan_Tailor
msgctxt "28cecf4d-9ed8-4c8d-b735-ab0dfb1a7185"
msgid ""
"{n}There's hope in the half-elf's eyes, and his voice trembles with awe.{/n} "
"\"You... you really did it! For me! I've never seen anyone so honorable! My "
"name is Sharel, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. I'm "
"pleased to meet you. If there's any way I can repay you... oh wait! Do you "
"need the services of a good tailor?\""
msgstr ""
"{n}하프엘프는 무언가 기대했지만 여전히 목소리는 떨립니다.{/n} \"정말... 해냈군요! 나를 위해! 이렇게 친절한 사람을 본 적이 "
"없어요! 저는 샤렐입니다,  {mf|영주님|영주님|전하|전하}. 만나서 반갑습니다.. 제가 뭔가 보답할 방법이 있다면... 오, 잠깐! "
"좋은 재단사의 봉사가 필요하지 않으신가요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Cue_0011_Text
#. Speaker : Artisan_Tailor
msgctxt "195f0c30-3d74-4f4d-a8a4-e41b4409daf5"
msgid ""
"\"We had a deal. He promised to lend me money for a new workshop. But I "
"didn't take a single coin! It's all a lie! I beg you, please! Nobody "
"believes me. The merchant's name is Hassuf! He would help me, if only he "
"knew I was in trouble! Please, talk to the merchant in the capital. He will "
"confirm I'm innocent!\""
msgstr ""
"\"우리는 거래를 했습니다. 그가 내가 공방을 열 돈을 빌려주기로 했어요. 하지만 저는 한푼도 받지 못했죠. 모두 사기였던 겁니다! "
"부탁입니다! 아무도 나를 믿지 않습니다. 상인의 이름은 하수프입니다! 제가 어려움에 처한 걸 안다면 그가 도와줄 겁니다! 제발 수도에 그 "
"상인을 만나주십시오. 그가 제가 무죄라는 걸 밝혀줄 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Cue_0012_Text
#. Speaker : Artisan_Tailor
msgctxt "1d20998e-b131-4373-acbc-f259ea47ac2a"
msgid ""
"\"Trust me, I can work wonders with a needle and a thread. It's only...\" {n}"
"The half-elf stops.{/n} \"I can't afford a workshop of my own. If I could "
"find a workplace... even one out here! I don't feel like returning to the "
"capital after all that's happened.\" {n}Sharel rubs his black eye.{/n} "
"\"Please help me set up a workshop, if you're in need of decent tailored "
"cloth. I'll make it worth your while. May the Gods protect you.\""
msgstr ""
"\"절 믿어주세요. 저는 바늘과 실로 경이로운 것들을 만들 수 있습니다...\" {n}하프엘프가 말을 멈춥니다.{/n} \"전 제 소유의 "
"공작소를 가질 여유가 없어요. 하지만 제가 일할 장소를 찾을 수 있다면, 공작소 하나만이라도 가진다면... 여기에서라도! 이런 일을 겪은 "
"후로는 수도로 가고 싶진 않아요.\" {n}샤렐은 눈을 비빕니다.{/n} \"만약 당신께서 준수히 재단된 의복이 필요하시다면, 제발 제가 "
"공작소를 열게끔 도와주세요. 제가 당신께 가치있는 걸 만들겠습니다. 신들께서 당신을 보호하시길.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Cue_0013_Text
#. Speaker : GuardCapital
msgctxt "4bbf18f9-a6d6-4cee-8d0e-6265338905be"
msgid ""
"\"So that's how this is going to go... Pardon me, {mf|Your Grace|Your Grace|"
"Your Highness|Your Highness}! But better safe than sorry. Here, let's set "
"you free there, lad. Be careful now. You should keep your eyes peeled with "
"enemies like yours.\""
msgstr ""
"\"그래서 일이 그렇게 된 것이로군요... 용서해 주십시오, {mf|영주님|영주님|전하|전하}! 그렇지만 조심하는 것이 그렇지 않았다고 "
"후회하는 것보단 낫지요. 자, 너를 풀어줄게, 젊은이. 조심하라구. 자네 같은 부류로 보이는 적들에게서 눈을 떼어선 안돼\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Cue_0014_Text
#. Speaker : GuardCapital
msgctxt "fa8ebab9-cb8e-4503-bfc1-26eead4ebfc1"
msgid ""
"\"Greetings, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! I "
"apologize for the noise. Our captain thought it would be good to make an "
"example of this criminal. Keep the public in line, you know. This one turned "
"out to be a little noisy...\""
msgstr ""
"\"어서오십시오, 영주님! 소란을 피워 죄송합니다. 우리 대장이 범죄자들에게 본보기를 보여주는 게 나을 거라고 생각했거든요. 질서를 "
"지키는 것이지요. 이놈은 조금 시끄러웠습니다만....\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/ImprisonedTailor/Cue_0016_Text
#. Speaker : GuardCapital
msgctxt "2c258071-3124-4add-bf20-25782708329b"
msgid ""
"\"Right away, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! You're "
"right, my head is throbbing with all this noise. Let him cool down in a "
"quiet place for a while.\""
msgstr ""
"\"당장 실행하겠습니다. {mf|영주님|영주님|전하|전하}! 당신이 옳습니다. 너무나 시끄러워 머리가 다 지끈거리네요. 그를 조용한 곳에 "
"보내 한 동안 진정시키겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Items/BestRobeDescription_String
msgctxt "ce137ae7-4a25-4c73-8db4-0122727e7ee2"
msgid "A glorious robe made of amazing fabric."
msgstr "화려한 직물로 만든 거룩한 로브입니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Items/BestRobe_String
msgctxt "ca0d5372-4996-4a93-a1f3-86571f80b1a8"
msgid "Robe of the Pure Heart"
msgstr "순수한 마음의 로브"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Items/LizardfolkSkinsDescription_String
msgctxt "c456729a-6338-47e0-9aec-ccd1cab907a7"
msgid "Scaly skin, flayed by a ruthless butcher."
msgstr "무자비한 도살자가 벗긴 껍질입니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Items/LizardfolkSkins_String
msgctxt "2815644c-f12f-4cce-8e2c-fdc45deccaac"
msgid "Lizardfolk Skins"
msgstr "리저드맨의 가죽"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Items/WarrantyForTailorDescription_String
msgctxt "89b35b0c-fef8-4420-98d5-25c5e197b8fe"
msgid "A letter that repudiates all accusations against Sharel, the half-elf."
msgstr "하프엘프 샤렐의 누명을 벗겨줄 편지입니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/Items/WarrantyForTailor_String
msgctxt "37cd6949-50a2-4596-b697-a790866627cf"
msgid "Confirmation of Sharel's Innocence"
msgstr "샤렐의 무죄 증명서"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_EE_StatGift_Shariel/Cue_0001_Text
msgctxt "6c160511-4bdd-401a-809d-2d78b1fab6fe"
msgid ""
"\"Good day, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! I "
"received a curious reminder of my status as court artisan. A few preachers "
"visited my workshop, praising you and expressing their gratitude for the "
"warm welcome they've received in your lands. After they left, I decided to "
"make a contribution to our common cause.\""
msgstr ""
"\"안녕하십니까, 영주님! 저는 궁중 장인의 제 신분에 대한 묘한 영감을 얻었습니다. 설교자 몇명이 제 가게에 방문해서는 자신들에게 "
"따뜻한 환영을 해주어서 영주님을 찬양하고 이 땅에서 받은 따뜻한 환대에 고마움을 표했습니다. 그들이 가고 나니, 저도 이 나라에 공헌하고 "
"싶은 마음이 들었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_EE_StatGift_Shariel/Cue_0002_Text
msgctxt "9a729f9d-6126-46ec-be13-a201015991ff"
msgid ""
"\"Greetings!\" {n}Sharel blushes slightly.{/n} \"There are so many arcanists "
"and priests in the {mf|barony|barony|kingdom|kingdom} now – many of them new "
"customers. I've had a lot of commissions recently, and my techniques have "
"improved with the practice. I'd be happy to share the results with you.\""
msgstr ""
"\"안녕하십니까!\" {n}샤렐의 얼굴이 살짝 붉어졌습니다.{/n} \"최근 {mf|남작령|남작령|왕국|왕국}에 비전학자들과 사제들이 "
"많아졌습니다 – 그리고 그들 대다수는 저의 새로운 고객이죠. 최근들어 부쩍 주문량이 많아졌고, 제 기술또한 그 많은 작업들로 인해 "
"향상되었습니다. 그 결과물을 당신과 나눌 수 있어 기쁘군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_EE_StatGift_Shariel/Cue_0003_Text
msgctxt "097a92ba-68da-4e2b-9c3e-748b4ff68e45"
msgid ""
"\"Here's a special gift for you, {mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}. I hope it will prove useful!\""
msgstr "\"여기, 선물이옵니다, 영주님. 유용하게 쓰신다면 좋겠군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Answer_0007_Text
msgctxt "1dd1a5be-1908-4b40-88c1-4bded0793653"
msgid "\"Thank you. I hope to see more proof of your mastery in the future.\""
msgstr "\"고마워. 미래에 네 실력을 더 보도록 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Answer_0010_Text
msgctxt "c63cf241-a3ea-4a59-a6cd-55d91dda5731"
msgid "\"I need something from you.\""
msgstr "\"너에게서 원하는 것이 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Answer_0011_Text
msgctxt "19bb9873-2189-40d6-bfe3-1bd68e5af0da"
msgid "\"I don't want to see you anymore.\""
msgstr "\"너를 더는 보기 싫어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Answer_0016_Text
msgctxt "2fb8e52d-6ee2-4216-81f6-01e3dfc1e60e"
msgid ""
"\"Why don't you set to work on that special thing you were making for me?\""
msgstr "\"나에게 특별한 물건을 만들어주지 않겠어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Answer_0017_Text
msgctxt "823a2a01-9e19-4549-ac23-d9de93415896"
msgid "\"I need some new clothes.\""
msgstr "\"새로운 옷이 필요해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Answer_0018_Text
msgctxt "266f4b6e-7cab-4f85-b3c8-b02c11cd806c"
msgid "\"A decent robe for a mage.\""
msgstr "\"쓸만한 마법사 로브\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Answer_0019_Text
msgctxt "f94cf930-e0a3-457e-b923-6523e0652eb2"
msgid "\"A sturdy cape.\""
msgstr "\"튼튼한 망토.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Answer_0021_Text
msgctxt "472a014c-ad1b-4ee3-8468-5f4b8130c92f"
msgid "\"As a tailor, you should know best what's missing from my wardrobe.\""
msgstr "\"재단사로서 내 옷장에 가장 필요한 옷을 만들어봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Answer_0031_Text
msgctxt "8e47ec40-eb8c-44c6-839b-dc3f26d3af60"
msgid "\"Remind me, who are you and what are you working on?\""
msgstr "\"다시 알려줘, 네가 누구고 무슨 일을 했었지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Cue_0002_Text
msgctxt "e87564e8-b936-4608-bfdb-7c2df6f63aea"
msgid ""
"{n}The {d|Shariel}half-elf{/d} is clearly embarrassed to be in the palace. "
"He shuffles his feet and bows shyly.{/n} \"Greetings, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}! Here. I've brought you something.\""
msgstr ""
"{n}{d|Shariel}하프엘프{/d}는 궁전에 와서 당황한 것 같습니다. 그는 서투르게 인사합니다.{/n} \"안녕하십니까, "
"{mf|영주님|영주님|전하|전하}. 여기, 물건을 가져왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Cue_0003_Text
msgctxt "401adba4-8c87-4337-a0cb-687d7684c23d"
msgid ""
"{n}Sharel shifts from one foot to the other and then finally gets up the "
"nerve to speak up.{/n} \"You've done so much for me, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}! You cleared my name of slander, freed me "
"from jail, gave me a chance to do my job with honor! Someone wiser than I "
"would simply settle down and live a happy quiet life. But...\""
msgstr ""
"{n}샤렐은 엉거주춤 일어나더니 말합니다.{/n} \"영주님은 저에게 많은 것을 해주었죠. 저를 감옥에서 꺼내주고 누명을 벗겨주시고 "
"거기다 직업을 주셨죠! 저 보다 지혜로운 자라면 그냥 정착하고 조용히 살았을 테지만...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Cue_0004_Text
msgctxt "c11d07a3-a54c-4ff9-b8a2-515ce6394eee"
msgid "{n}Sharel bows as he hands you a bundle.{/n}"
msgstr "{n}샤렐은 당신에게 무언가를 건넵니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Cue_0005_Text
msgctxt "9bdb7a61-c47e-471b-94f2-d45b972356c6"
msgid ""
"{n}The tailor presents you with a magnificent robe.{/n} \"Attire of Arcane "
"Annihilation is my masterpiece! Now that I know that rascal is in prison, "
"I'm at peace once more, and my mind isn't troubled by worry. I'm sure my "
"further creations will improve, but this robe... oh, there will be no other "
"like this!\""
msgstr ""
"{n}재단사가 당신에게 멋진 로브를 보여줍니다.{/n} \"비전 절멸의 의복은 나의 걸작이야! 그 자식이 감옥에 있는 것을 알고 나니, "
"마음이 평온해졌어. 더 이상 걱정하지 않아도 되겠지. 앞으로 더 좋은 작품을 만들 수 있겠어. 그렇다만... 이 로브는... 오오, 이런 "
"걸작은 다시 나오기 힘들 거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Cue_0008_Text
msgctxt "b632ebc4-7ac6-45ac-aeb7-82578fa22fc2"
msgid ""
"\"Oh, and about Morhalan... I reported his crimes to the guards. However, "
"someone must have warned him. He escaped. He has eyes and ears everywhere. "
"I'm afraid your personal Warden is the only one who can find him.\" {n}"
"Sharel is shaken by righteous anger.{/n} \"I pray to {g|Torag}Torag{/g} not "
"to let him make more mischief before the guards find him! And I pray you "
"don't to let him go unpunished!\""
msgstr ""
"\"모할란에 대해서는... 그의 죄를 경비에게 고발했습니다. 하지만 도망가버렸습니다. 누군가 놈에게 경고를 한 게 틀림 없을 테죠. "
"첩자를 온 사방에 심어둔 모양입니다. 유감스럽지만 당신의 감시관만이 그를 찾을 수 있습니다.\" {n}샤렐은 분노로 떱니다.{/n} \""
"{g|Torag}토락{/g}께서 그놈이 더한 음모를 꾸미지 않도록 해주시길 바랄 뿐입니다. 만약 잡으면 엄벌을 내려주십시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Cue_0009_Text
msgctxt "e4a2da7f-6a88-4d1d-b960-69bf19130e31"
msgid "{n}The half-elf blushes and bows hurriedly.{/n}"
msgstr "{n}하프엘프는 얼굴이 붉어져서는 급하게 인사합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Cue_0012_Text
msgctxt "de6f529d-9566-422c-b2ac-26ddca00997a"
msgid ""
"{n}The half-elf shivers, and freezes like a scared animal. After a pause, he "
"nods slowly and heavily.{/n} \"As you wish. I'm sorry for offending or "
"interrupting you. I didn't mean to do anything wrong. Farewell.\""
msgstr ""
"{n}하프엘프는 마치 겁에 질린 짐승처럼 떱니다. 그는 잠시 후 천천히 끄덕입니다.{/n} \"네가 원하는 대로. 너를 방해해서 미안해. "
"방해하려던 건 아니었어. 안녕히.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Cue_0013_Text
msgctxt "6928355d-4400-415d-8c1d-c901a156cb9b"
msgid ""
"{n}Sharel gives you a quick glance.{/n} \"Just tell me what you need. I'll "
"take care of it.\""
msgstr "{n}샤렐은 당신을 슬쩍 봅니다.{/n} \"무엇이 필요한지 말씀만 하세요. 내가 신경써서 잘 해드리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Cue_0015_Text
msgctxt "ea56612f-41e8-4eab-bfc2-0b68e952ddc3"
msgid ""
"\"After you and I brought that wretch Morhalan to justice, peace has once "
"more filled my heart. Thank you for returning tranquility to my life, {mf|"
"Your Grace|Your Grace|Your Highness|Your Highness}. I would like to give "
"you... a special gift in thanks. Give me some time and freedom to work on my "
"own, and I will make something very special, just for you.\""
msgstr ""
"\"모할란이 심판을 받고 난 후 내 마음에 평화가 찾아왔어. 고마워. 너에게... 특별한 선물을 하고 싶어. 내게 시간을 주면 너를 위한 "
"특별한 선물을 만들어줄게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Cue_0020_Text
msgctxt "6b8c0af7-600a-432e-9da0-00ba6ae2ecdb"
msgid ""
"\"Thank you. Believe me, I'll spare no effort or time! You won't be "
"disappointed.\""
msgstr "\"고마워. 최선을 다할게! 실망하지 않을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Cue_0022_Text
msgctxt "98b27dc2-367d-40d9-9a11-0b03aab80981"
msgid "\"You will look irresistible in the clothing I'll make for you.\""
msgstr "\"내가 만든 옷을 입으시면 아주 멋질 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Cue_0028_Text
msgctxt "3f094d56-c78a-493d-8439-3f1f64c5f349"
msgid ""
"\"There's a reason I was arrested at the outskirts of your domain. I don't "
"want to discuss it here. Please, come over to my village when you have a "
"moment. We can talk there. Believe me, I have quite a story to tell you.\""
msgstr ""
"\"영주님의 영지 외곽에서 제가 붙잡힌 데에는 이유가 있습니다. 여기서 그것을 논하고 싶지는 않습니다. 제발, 시간을 내서 제 마을에 "
"방문해 주세요. 그 곳에서 이야기 할 수 있습니다. 믿어주시길, 저에겐 당신에게 해야 할 이야기가 많습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_HalfElfMaleTailorNG/Cue_0032_Text
msgctxt "c216b14c-b926-4914-90f7-51cbe77cd9bf"
msgid ""
"\"I'm Sharel the tailor. You helped me clear my name, and now I live freely, "
"practicing my craft with nothing to fear. I usually make cloaks, robes, "
"gloves and other garments, suitable for adventuring. I'd be glad to make "
"something special for you. The Robe of Arcane Annihilation, for example. A "
"true treasure for someone who uses ray or elemental spells.\""
msgstr ""
"\"저는 재단사 샤렐입니다. 당신은 제가 결백하다는 것을 증명하는걸 도와주셨고, 그 덕분에 어떤 공포감도 없이 자유롭게 지내며 제 기술을 "
"연마하고 있습니다. 저는 주로 모험에 도움을 주는 망토, 로브, 장갑, 그리고 그 밖의 의류를 제작합니다. 저는 당신을 위해 특별한 "
"물건을 만들어드릴 수 있습니다. 예를 들면, 광선이나 원소 주문 사용자들의 진정한 보물인 비전 절멸의 로브같은 것들이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_Linzi/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "a7eac5bd-2448-43c4-9a36-75dbadfd97eb"
msgid ""
"{n}Linzi's cheeks are wet with tears. She weeps and sniffles.{/n} \""
"{d|Shariel}Sharel{/d}... the half-elf you saved from wrongful accusation and "
"hired as the court tailor... he's been murdered!\""
msgstr ""
"{n}린지의 뺨에 눈물이 흐릅니다. 그녀는 눈물을 닦고는 코를 풉니다.{/n} \"{d|Shariel}샤렐{/d}... 누명을 벗고 궁정 "
"재단사가 되었는데... 살해당했어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfElfMaleTailorNG/KTC_Linzi/Cue_0002_Text
#. Speaker : Linzi_Companion
msgctxt "06240869-084d-4d6e-87e7-50b4f7195a05"
msgid ""
"\"Someone butchered him – cut open his stomach! Right in front of his own "
"workshop! His neighbor was scared to death when she found him this "
"morning... oh, this is so horrible! He was such a nice fellow!\""
msgstr ""
"\"누군가 그를 도륙했어요. 그의 배를 째서 열었대요. 바로 그의 공방에서 말이에요! 이웃 사람이 아침에 발견했어요... 오, 정말 "
"끔찍해요! 그는 정말 좋은 친구였는데!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Barks/InquisitorAttack_String
msgctxt "0f74d4f2-f7c3-46a1-9f50-11d4e3565d7a"
msgid "\"Iomedae, I am the sword of your justice!\""
msgstr "\"이오메데님. 나는 당신의 검입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Barks/InquisitorGraceful_String
msgctxt "bc363719-b40a-4e9f-b2d9-cd847df6e7c0"
msgid ""
"\"Thank you! That rascal Varrask will pay for his crimes! We'll have "
"captured him by the time you reach the capital.\""
msgstr "\"고마워! 바라스크는 죗값을 치뤘을 거야! 네가 수도에 도착할 때까지 그를 잡겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Barks/Warrask1_String
msgctxt "189102f5-09f6-4ada-bb0d-5af9665672e5"
msgid ""
"\"Here you are, you old fool. No money, no tools... You're in real trouble "
"this time, Varrask, you old fool!\""
msgstr "\"여기있다, 이 늙은 바보야. 돈도 없고 도구도 없이... 이번엔 정말 큰일 났구만. 바라스크, 이 늙은 머저리 같으니!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Barks/Warrask2_String
msgctxt "03cc3d08-d76d-4aa8-b402-00252fa42028"
msgid ""
"\"The elders were right – we're cursed, our whole bloodline. We're dumb. And "
"unlucky.\""
msgstr "\"장로들 말이 맞았어. 우리는 저주 받았어. 운도 없군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Barks/Warrask3_String
msgctxt "ed93d0f3-3c40-439c-88c2-f22636e10853"
msgid "\"A good master can always find a place… Ah, but without my tools!\""
msgstr "\"장인은 항상 제 자리를 찾지... 하지만 도구가 없어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0005_Text
msgctxt "79992749-b4c7-4bda-b7d0-5f4dae662656"
msgid "\"I brought you the blood of the one who murdered your family.\""
msgstr "\"네 가족을 죽인 자의 피를 가져왔다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0006_Text
msgctxt "7c6f42a7-51a1-44dc-9409-fc2b76ed3c71"
msgid "\"I brought you the metal you need.\""
msgstr "\"너가 필요로 하는 금속을 가져왔어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0007_Text
msgctxt "1f773ac2-2ecb-4980-9575-04b19468af1e"
msgid "\"What was that relic you spoke of? Can I help you fix it?\""
msgstr "\"무슨 유물이었지? 내가 그것을 고쳐 줄까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0008_Text
msgctxt "92cf657f-bfd9-49a0-bd3a-4bddecca900d"
msgid "\"You lied about the murderer of your family. It was the inquisitor.\""
msgstr "\"가족을 살인한 사람에 대해 거짓말했군. 그건 인퀴지터였어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0009_Text
msgctxt "8fa75e76-ca4f-4d1e-8d9f-b3cbd05289fe"
msgid "\"Tell me about yourself.\""
msgstr "\"너에 대해 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0010_Text
msgctxt "6b01f710-0e8a-4a36-9be0-f8367d66de06"
msgid "\"Where are you from?\""
msgstr "\"너는 어디에서 왔지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0011_Text
msgctxt "944730eb-0584-4142-bcda-75e623054b78"
msgid "\"Remind me what you require to reforge your hammer.\""
msgstr "\"네 망치를 고치기 위해 뭐가 필요한지 다시 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0014_Text
msgctxt "57adbc16-dd9f-438d-84c4-eaaa85986dee"
msgid "\"How did your family die?\""
msgstr "\"너희 가족이 어떻게 죽었다고?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0015_Text
msgctxt "e45b8a88-59d8-4170-8130-0c5efabe5d7f"
msgid "\"Tell me about your craft.\""
msgstr "\"네 재주에 대해 말해봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0018_Text
msgctxt "0b0963d7-9425-4e22-99e4-beef20e67550"
msgid "\"Hold up your end of the bargain.\""
msgstr "\"너의 책무를 계속해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0019_Text
msgctxt "ffa0dc09-4177-4d0d-bf4e-599d84a80e2b"
msgid "[Attack] \"Your lies will be punished!\""
msgstr "[공격] \"거짓말하면 벌을 받는다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0024_Text
msgctxt "a650c7fe-ce27-4a81-8c39-befea253932e"
msgid "\"We'll speak later. Get to work.\""
msgstr "\"다음에 얘기하지. 가 봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0029_Text
msgctxt "dcddb0d1-08e1-4e4c-b76d-26cddba84031"
msgid "\"Let's put off this conversation until later.\""
msgstr "\"이 대화는 다음에 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0032_Text
msgctxt "d8ec7628-e859-4e16-a5d2-74548999db8d"
msgid "\"Remind me where I can… collect the blood you need.\""
msgstr "\"네가 원하는 피를 어디서 얻을 수 있는지 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0045_AlignmentShift.Description
msgctxt "7d70fe5d-9906-4bff-88e5-b4d3574ff1c7"
msgid "Approved of Varrask's revenge."
msgstr "바라스크의 복수를 승낙했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0045_Text
msgctxt "22015037-965b-4fb6-814e-fde01870afb5"
msgid ""
"\"Don't worry. The malicious woman deserved to die. You did the right thing."
"\""
msgstr "\"걱정 마. 그 여자는 죽어 마땅해. 너는 옳은 일을 했어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0046_AlignmentShift.Description
msgctxt "06c66e52-9935-4586-95e3-9933fc6be30d"
msgid "Supported Varrask's desire for revenge."
msgstr "복수하려고 하는 바라스크를 도와주었습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Answer_0046_Text
msgctxt "558dcffb-52a5-4ef6-9e0e-35f66b6322d3"
msgid ""
"\"You're a bandit and a murderer, but you had the right to avenge your "
"family.\""
msgstr "\"너는 도둑에 살인자지만 가족의 복수는 할 수 있지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0002_Text
msgctxt "f1d718f6-8aaa-4214-ba5b-e47c9f22c59d"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}! Decided to see how "
"old {d|Varrask}Varrask{/d} is doing? I've set up nicely here! I forge armor "
"and weapons for anyone who's got the coin. Though the fighters in these "
"lands are weak – some can't even lift a normal axe. They cannot hold a "
"candle to my sons...\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}! 늙은 {d|Varrask}바라스크{/d}가 무얼 하는지 보기로 했어? 나는 여기를 멋지게 "
"꾸며놓았어! 나는 돈을 받고 갑옷과 무기를 고쳐주지. 이 땅의 전사들은 약해서 도끼도 들지 못해도 말이야. 약골들이야...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0003_Text
msgctxt "906fcb2b-b5ea-48b4-9131-0399ccbeb840"
msgid ""
"\"Greetings, patron. How can I serve you? Looking for a hatchet or a helmet?"
"\""
msgstr "\"안녕. 어떻게 도와줄까? 손도끼나 투구를 찾으러 왔어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0012_Text
msgctxt "fc2629c1-e046-49bc-a86b-c5d59764165e"
msgid "\"What interest do you take in old Varrask?\""
msgstr "\"이 늙은 바라스크에게 원하는 게 뭐지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0012_Text_1
msgctxt "50b8e418-f5ea-4c27-8d81-cf4419dbb6cb"
msgid ""
"\"What should I tell you? I have no idea... ask me what you want to know.\""
msgstr "\"내가 무슨 말을 할 수 있겠어? 모르겠군... 무얼 알고 싶은지 말해봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0016_Text
msgctxt "da3e09e9-8da5-423f-9f49-00723efbaaaf"
msgid ""
"{n}The old man looks at you angrily, but cautiously.{/n} \"Hm... It is truly "
"so. My family had faults, indeed. We committed robbery and murder. These are "
"common things in our kingdom. I didn't lose my family to bandits, but to a "
"bunch of inquisitors from Lastwall. Should I not long for revenge because I "
"am a thief, like my wife and my kids? What are you going to do with me now?\""
msgstr ""
"{n}노인은 호기심 어린 눈빛으로 당신을 봅니다.{/n} \"흠... 그렇군. 우리 가족이 잘못을 저질렀어. 우리는 강도와 살인을 "
"저질렀지. 우리 왕국에서는 흔한 일이야. 우리 가족을 도적들에게 잃어버린 게 아니라 라스트월의 인퀴지터였어. 내가 도둑이라서 복수를 하면 "
"안 되는 거야? 이제 날 어떻게 할꺼지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0016_Text_1
msgctxt "2ae07a69-e288-4696-ade7-51486f0976ed"
msgid ""
"{n}The old man looks at you angrily and warily.{/n} \"Yes... it's true. Our "
"family committed some petty sins. But do I want revenge for my family less, "
"because I'm a little light-fingered?\" {n}Varrask licks his lips.{/n} \"So "
"what are you going to do now?\""
msgstr ""
"{n}노인은 걱정스러운 눈길로 당신을 봅니다.{/n} \"그래... 맞아. 우리 가족은 죄를 저질렀지. 내가 도둑놈이라 복수를 하면 안 "
"되는건가?\" {n}바라스크는 입술을 핥습니다.{/n} \"어떻게 생각해?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0022_Text
msgctxt "7e5f5ade-3227-4baa-b858-3d7776073293"
msgid ""
"{n}The old man slaps himself on the thigh, happy enough to dance.{/n} \"Yes! "
"My clan is avenged! Ha ha! Old Varrask outlived you, you arrogant witch! Oh, "
"how I would love to taste her blood! It must be so sweet. But I can't afford "
"the pleasure. I'm going to need every bit of it to harden Earthbreaker.\""
msgstr ""
"{n}노인은 기뻐서 무릎을 칩니다.{/n} \"그렇지! 우리 가족의 복수를 해야지! 하하! 그녀의 피를 어서 맛보고 싶군! 하지만 그럴 "
"수는 없지. 피를 전부 지진 망치(Earthbreaker)에 담을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0023_Text
msgctxt "150a013b-a11a-4618-97a2-316808567a40"
msgid ""
"{n}Varrask swells with pride.{/n} \"It's a hammer named Obliteration. Hold "
"it with both hands. Whatever you hit, the only thing left there will be a "
"greasy spot. I gave it to my son when it got too heavy for me. He named it "
"Nibbler. You see, its head has beak-like wedges made of inubrix. Inubrix is "
"a very hard celestial metal. It cuts through iron like a knife cuts through "
"butter.\""
msgstr ""
"{n}바라스크는 자신감이 넘칩니다.{/n} \"말살이라고 불리는 망치야. 양손 무기일세. 이것에 맞으면 흔적도 남지 않게 되지. 내가 들 "
"수 없을 때 아들에게 주었어. 아들은 이것을 절단기라고 불렀지. 머리부분에 부리같은 쐐기 가 있는데, 이누브릭스라는 천상의 금속으로 만든 "
"것이야. 쇠를 버터처럼 가를 수 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0025_Text
msgctxt "1ba67f92-816c-45a0-9c9e-b3b2ab76926e"
msgid ""
"\"Inubrix. It's a celestial metal that looks a little like lead. It's pretty "
"rare, but you might find just enough in the {g|Technic League}Technic "
"League{/g} camp.\""
msgstr ""
"\"이누브릭스. 천상의 금속이야. 아주 귀하지만 {g|Technic League}기술 연맹{/g} 캠프에 가면 구할 수 있을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0026_Text
msgctxt "ca80cfcf-6375-46d2-832b-d29b7eba9609"
msgid ""
"{n}Varrask grows grim, and his eyes start watering.{/n} \"I left my house. "
"Went to a tribe that had ordered weapons from me. As I got back to my house, "
"I was ambushed. They'd hid in my own yard! I have no idea how I survived. "
"But I saw the dead bodies of my wife and children with my own eyes. I had "
"four lads, all of age, all carried weapons. Three daughters too, and they "
"knew how to fight.\""
msgstr ""
"{n}바라스크는 어두워지더니 눈물을 흘립니다.{/n} \"나는 집을 떠났어. 나에게서 무기를 주문한 부족에게 갔지. 집으로 되돌아갔을 때 "
"기습을 당했어. 내 마당에 숨어있더군! 어떻게 살아남았는지 기억도 나지 않아. 하지만 내 아내와 자식들의 시체를 내 두 눈으로 봤어. "
"아들 넷은 모두 무기를 사용할 수 있었고 세 딸들도 싸우는 법을 알았지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0027_Text
msgctxt "04109074-fdb3-4f68-9b18-64ba9e0a9a73"
msgid ""
"\"There's nothing to tell. It's a traditional orc thing. Any decent battle "
"gear must be big, heavy, and tough. Fragile and brittle materials don't "
"last. The orcs' strength rages and storms! Small and light objects get lost "
"all the time. That's why orcs need a weapon that can't be broken in half on "
"the enemy's head. Orc armor must be even sturdier, because they fight each "
"other far more often than they fight their enemies. Thin armor would result "
"in many deaths among the tribe.\""
msgstr ""
"\"말할 것도 없어. 좋은 전투용 장비는 크고 무겁고 거칠어야 하지. 부서지기 쉬운 재료는 오래가지 않아. 오크들은 아주 힘이 세. 작고 "
"가벼운 것은 부서지기 쉽지. 그래서 오크들은 적의 머리를 부수고도 두 동강 나지 않을 무기가 필요하지. 오크의 갑옷은 단단해야 해. "
"그들은 적들 보다 서로 싸우는 경우가 더 많으니까. 얇은 갑옷은 부족과 싸울 때 입은 자의 죽음을 가져오지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0027_Text_1
msgctxt "a371cf52-d04a-44f0-b6c1-c56ae5c37e3f"
msgid ""
"\"There's nothing to tell. Barbarians think all good things must be sturdy, "
"heavy and big. Fragile and brittle things are no match for their strength – "
"they have so much, and it begs to come out. Small and light things are "
"easily lost in battle. A weapon must be sturdy, or a warrior might break it "
"over the enemy's head. And armor must be even sturdier.\""
msgstr ""
"\"말할 것도 없어. 좋은 전투용 장비는 크고 무겁고 거칠어야 하지. 부서지기 쉬운 재료는 오래가지 않아. 작고 가벼운 것은 부서지기 "
"쉽지. 적의 머리를 부수고도 두 동강 나지 않을 무기가 필요해. 그리고 갑옷은 더 단단해야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0028_Text
msgctxt "8769e406-1c23-4ee0-afe3-d4273681794f"
msgid ""
"\"I was born in {g|Hold of Belkzen}Belkzen{/g}. I had to take off when I was "
"still a snot-nosed kid. Got in a fight with some bonehead... And I hit him. "
"I mean, not the bonehead. Was aiming at him, but I hit chief's son. And he "
"suddenly went and died. I had to run away as far as I could, just to stay "
"alive.\""
msgstr ""
"\"나는 {g|Hold of Belkzen}벨크젠{/g}에서 태어났어. 코흘리개였을 때 그곳을 떠나야 했지. 어떤 멍청이들과 싸움이 "
"났었거든... 그 중 한 놈을 때렸지. 그런데 그 녀석은 족장의 아들이었어. 그런데 죽어버렸지. 나는 살아남기 위해서 도망쳐야 했어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0030_Text
msgctxt "7afc7a6d-2af4-4e73-968f-abb68893c62b"
msgid ""
"\"As you say. I'll gladly tell you all that I know. What else can an old man "
"like me do?\""
msgstr "\"원하는 대로. 알고 싶은 것은 모두 말해주지. 무엇을 알고 싶은가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0030_Text_1
msgctxt "21cbfa77-6283-4232-a420-b7e937c34eb2"
msgid ""
"\"As you say. We old people have nothing to do but tell stories. Come, I'll "
"tell you one.\""
msgstr "\"원하는 대로. 우리 노인들은 이야기를 좋아하지. 이리 오게. 하나 해주지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0031_Text
msgctxt "89040717-eb4e-481c-ba5a-faa93a889c9b"
msgid ""
"\"Perfect! Now I have enough material. But here comes the hard part. I need "
"blood. An enemy's blood. The creator of this hammer hardened it in the blood "
"of a sworn enemy. This made the hammer incredibly powerful and furious. "
"Should you want to reforge it, it will require another such hardening.\""
msgstr ""
"\"완벽해! 이제 재료는 충분해. 하지만 이제 어려운 부분이야. 피가 필요해. 적의 피 말이지. 이 망치의 제작자는 적의 피로 이것을 "
"단련했어. 피가 망치를 강력하고 거칠게 만드는 거야. 망치를 얻고 싶다면 단련을 해야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0033_Text
msgctxt "5136625f-e108-4e7f-9c1f-286ff444ba35"
msgid ""
"\"They say there's a secluded outpost out there in the forest. The huntress "
"that lives there gives shelter to travelers. I think her name is Dumra. I "
"hear an armed girl is staying there. She's missing two fingers. That's her!\""
msgstr ""
"\"숲 밖에 오두막 하나가 있대. 덤라라는 이름의 사냥꾼이 여행자에게 쉼터를 제공하지. 거기 무장한 여성이 머물고 있다고 들었어. 손가락 "
"두 개가 없는 여자를 찾아. 우리가 찾는 사람이니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0034_Text
msgctxt "2a4fe85b-74f8-45d1-8310-75941de12421"
msgid ""
"{n}The half-orc has a dark, angry, and threatening grimace. It's not hard to "
"believe he once lived a life of robbery.{/n} \"It means I'll die as I lived, "
"with a weapon in my hands. Nulgreth, see Old Varrask die in his final battle!"
"\""
msgstr ""
"{n}하프오크는 화가 나서 험악한 표정을 짓습니다. 강도질로 연명했다는 이야기가 떠오르는 모습입니다.{/n} \"이 손에 무기를 쥐었으니 "
"목숨이 다하는 순간까지 싸우겠다는 의미다, 널그레이쓰여. 늙은 바라스크는 마지막까지 싸우겠노라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0035_Text
msgctxt "f143a3da-8ee1-4bba-b4ec-554a084a067f"
msgid ""
"{n}The old man gives a sigh of relief.{/n} \"I appreciate it. I'm old, but I "
"still want to walk the earth a little longer.\""
msgstr ""
"{n}늙은 남자는 안도의 한숨을 쉽니다.{/n} \"고맙군. 이만큼 나이가 들긴 했어도, 오늘이 마지막 날은 아니었으면 하거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0035_Text_1
msgctxt "53f760ee-5642-4627-a52b-7f20042480e6"
msgid ""
"{n}The half-orc heaves a sigh of relief.{/n} \"Thank you. I'm an old man, "
"but I still wish to trample the ground a little longer.\""
msgstr ""
"{n}늙은 남자는 안도의 한숨을 쉽니다.{/n} \"고맙군. 이만큼 나이가 들긴 했어도, 오늘이 마지막 날은 아니었으면 하거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0036_Text
msgctxt "52bc2072-c7a1-4a03-9b08-5eacb4fe360d"
msgid ""
"{n}The half-orc grows grim, and his voice becomes dull and soft.{/n} \"My "
"eldest was a strong one. He could hit an ogre with a hammer so hard that it "
"would leave behind its teeth along with its boots. But they are gone... Both "
"the son and his hammer. For twelve generations my family has owned this "
"hammer. It's a relic, you could say. I wish I could fix it, but how? And for "
"whom?\""
msgstr ""
"{n}하프오크는 어두운 표정으로 힘없이 말합니다.{/n} \"우리 족장은 강했지. 망치질 한 방으로 오거의 강냉이를 털었어. 족장도, "
"족장의 아들도 죽고, 망치는 부서졌지만. 그래도 망치는 우리 가족이 열두 세대 동안 보관해오고 있어. 지금은 고물이나 다름없지만, 다시 "
"고치고 싶어도 뭐 방법이 있나. 어떻게 고친다 해도, 이걸 누가 쓰겠어? 죽은 족장이? 아니면 족장의 죽은 아들이?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0037_Text
msgctxt "07119f80-bd2d-4b0f-92f4-26a3a33c54d7"
msgid ""
"\"It was a fine hammer. Nobody knows how many skulls it cracked. It broke "
"the day my son was killed. The hammer's head cracked all over from a magical "
"blow. It needs to be reforged, but where can I possibly get any inubrix? "
"Without that, the hammer is just an ordinary sledge. You can use it to "
"hammer in posts, or tie it to your neck and drown.... Hmm... The {g|Technic "
"League}Technic League{/g} is bound to have some. If you come across one of "
"their camps, you might find inubrix there.\""
msgstr ""
"\"괜찮은 망치야. 아마 셀 수 없이 많은 골통을 박살 냈을걸. 내 아들이 죽은 날 부서졌지만. 마법 한 방에 망치 머리에 금이 갔지. "
"고치는 건 어렵지 않은데 이누브릭스를 구할 데가 없어. 그게 없으면 이 망치는 말뚝 박을 때 쓰는 평범한 망치보다 나을 게 없다고... "
"{g|Technic League}기술 연맹{/g}이라면 모를까, 이누브릭스를 구하긴 힘들 거야. 여행하다가 기술 연맹 캠프가 보이면 한번 "
"찾아 봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0038_Text
msgctxt "b534a7bc-080d-4b76-a104-4e4251a56fd2"
msgid ""
"\"I'm old. Most of my enemies are dead. But there's one that's still "
"breathing. The witch that slew my family. Oh, how I would love to harden the "
"hammer in her blood! I could never defeat her, though. But I know she's been "
"spotted in an isolated outpost in the forest. She has a distinguishing mark –"
" she's missing two fingers. And she's got the look of a devil.\""
msgstr ""
"\"나는 늙었어. 적을 많이 만들었지만, 걔들도 다 늙어 죽었지. 하지만 아직 살아있는 녀석이 있어. 내 가족을 살해한 마녀 말이야. 그 "
"피로 망치를 벼릴 수 있다면 얼마나 좋을까! 나 따윈 그 여자의 상대도 안 되겠지만. 그래도 최근에 한 숲 속 외딴 기지에서 마녀가 "
"목격됐다 하더라고. 손가락 두 개가 없어서 금방 알아볼 수 있을 거야. 데블처럼 생기기도 했고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0039_Text
msgctxt "899349d0-2ba8-4a61-b6bf-1d489e1ed0c6"
msgid ""
"\"If you slay the wretch, collect her blood and bring it to me. I'll give "
"you the reforged hammer in exchange. I don't have anyone to leave it to. "
"This will make you a clan member, avenging my family.\""
msgstr ""
"\"마녀의 피를 내게 가져와. 그럼 답례로 망치를 복구해주지. 어차피 유산으로 남길 가족도 없으니 괜찮겠지. 가족의 복수를 대신 해주는 "
"자가 부족의 일원이 아니면 뭐겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0040_Text
msgctxt "e7984cf6-8c7c-4ff2-9c9b-44a1cd537fa0"
msgid ""
"\"Then I settled in Lastwall. A godforsaken place. Orcs are treated like "
"scum. – It's understandable, I guess. Orcs kill many more people than you "
"can count. I moved in near the Thorn Scar's territory, out of harm's way. "
"They're a tribe, or what's left of one. They worship {g|Lamashtu}Mother "
"Lamashtu{/g}, so they stay busy. They needed new armor and weapons every "
"year. And so I worked my force in return for their protection.\""
msgstr ""
"\"나는 라스트월에 정착했지. 오크라면 죄다 쓰레기 취급하는 재미없는 동네야. 이해해. 오크가 인간을 좀 많이 죽였겠냐고. 아무튼 나는 "
"가시 흉터 부족의 영토로 이사를 갔어. {g|Lamashtu}어머니 라마슈투{/g}를 숭배하는 영락한 부족이지. 부지런하게 일해서 부족을 "
"먹여 살려야 하는 상황이라, 매년 새 갑옷과 무기가 필요했어. 나는 가시 흉터 부족의 보호를 받으며 대장장이 일을 해줬고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0040_Text_1
msgctxt "86a5ef63-cdfc-4cfb-b98b-bf053ee4c64a"
msgid ""
"\"So I ended up in Lastwall. An awful place. Anyone with orc blood is a "
"misfit. Which is fair enough. Orcs have killed so many of them… But I "
"settled there, started my business, and a family.\""
msgstr ""
"\"결국 라스트월에 정착했지. 끔찍한 곳이야. 오크의 피가 한 방울만 섞여도 쓰레기 취급을 당하거든. 하지만 그럴 만 해. 항상 오크의 "
"습격에 시달리는 곳이니까. 어쨌든 나는 라스트월에 정착해서, 사업을 시작하고, 가정을 꾸렸어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0041_Text
msgctxt "264d78a8-16e9-4041-b719-629a3d9b1395"
msgid ""
"\"It's how I learned my craft. That's what the Thorn Scar used to say: 'Big "
"thumbs up to Varrask's hands! Big thumbs up to Varrask's head!' Which meant "
"they respected me.\""
msgstr ""
"\"그렇게 대장장이 기술을 배웠지. 가시 흉터 부족은 날 좋아했어. 존경의 의미로, 날 보면 '최고의 손 바라스크'라며 엄지를 세웠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0042_Text
msgctxt "e74ccde4-436d-48ee-b005-bae8c448c181"
msgid ""
"\"I'll get to work immediately. {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}, when Verex the Blood God asks of me whether my revenge for my "
"family's death was bloody enough, I can tell him the best assassin I've ever "
"met was entrusted with the task.\""
msgstr ""
"\"즉시 작업에 착수하겠어. 피의 신 베렉스가 가족의 복수는 끝났느냐고 물으시면, 나는 최고의 암살자에게 일을 맡겼다고 말할 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0042_Text_1
msgctxt "4c13015d-bb4a-488e-93f6-71d896ea33b8"
msgid ""
"\"More of the scoundrels kept coming. I guess they'd tracked us down, waited "
"to catch us by surprise. And I guess I was lucky... they didn't kill me with "
"the others. I fought them off and got lost in the woods. Walked for a long "
"time without a road... and finally ended up here. You know the rest. But the "
"gods didn't see a long life for those bandits. – I heard they're all dead. "
"Only their chief is still breathing, the fingerless witch.\""
msgstr ""
"\"놈들이 계속해서 몰려왔어. 바로 죽일 수 있었을 텐데, 우리를 사냥감처럼 풀어두고 불시에 습격할 생각이었던 거지. 그게 나한텐 운으로 "
"작용했어... 추격자를 떨쳐내려다 숲에서 길을 잃었거든. 그래서 살아남았지. 흔한 흙길도 나지 않은 숲 속에서 한참을 헤맸고, 결국엔 "
"이곳에 도착했어. 그 후엔 어떻게 됐는지 알지? 신께서 굽어 살피셨는지, 도적 나부랭이들은 단명했어. 다만 '손가락 없는 마녀'라고 "
"불리는 대장이 아직 살아있고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0043_Text
msgctxt "2d4fa01a-d869-4c5c-88a8-8ffa4c075589"
msgid ""
"\"I remember my pledge. Your army will have something to cover their soft "
"flesh.\""
msgstr "\"난 약속은 지켜. 네 군대는 연약한 피부를 가릴 좋은 갑옷을 얻게 될 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0044_Text
msgctxt "7a627ab5-3d66-4bf3-a526-9a2b4813aa44"
msgid ""
"{n}Varrask shows his enormous fists on disproportionately large arms.{/n} "
"\"You see, a blacksmith must be strong, even by orc standards... Just like "
"his tools. Big, heavy, and tough. And patient. There's the catch. That's why "
"the craftsmen are valued so much. I'm telling you, they can't even hit us!\""
msgstr ""
"{n}바라스크는 비정상적으로 큰 팔뚝을 보여 줍니다.{/n} \"보이나. 대장장이는 오크들 중에서도 힘이 강해야 하지. 본인만큼 크고, "
"무겁고, 거친 도구를 다뤄야 하니까 말이야. 인내심도 있어야 해. 그래서 대장장이의 역할을 아주 높이 평가하지. 어느 정도냐면, 아무리 "
"화가 나도 대장장이한테는 절대 주먹을 날리지 않는다니까!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0044_Text_1
msgctxt "a111e578-5d42-4e17-a684-fb0a9df70949"
msgid ""
"\"And a blacksmith, I figure, needs to be like his armor – sturdy and strong."
"\" {n}Varrask shows you his huge fists and absurdly thick arms.{/n} \"And "
"patient. Barbarians have trouble with this last one. That's why a master is "
"so valuable.\""
msgstr ""
"\"대장장이는 자신이 만든 갑옷만큼 단단하고 강해야 하지.\" {n}바라스크는 당신에게 두꺼운 팔뚝을 보여 줍니다.{/n} \"그리고 "
"인내심 필요해. 야만스러운 전사들은 인내심과 거리가 멀어. 그래서 오크들은 장인을 높이 평가하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0045_Text
msgctxt "69220d78-6870-49f8-8476-b982c5968b2e"
msgid ""
"\"The bandits had greater numbers. They must have tracked us and timed their "
"strike carefully. You see, our outpost was isolated. They waited for me to "
"leave, then slew everyone else. And then they waited to ambush me. I was "
"lucky to escape. I took the hammer from my elder son's hands, fought them "
"off, and fled into the woods. After that, once my head cooled, I started "
"hunting them. Eventually I lost them in the swamps by the "
"{g|Kamelands}Kamelands{/g}. You know what happened next. I heard things "
"turned out badly for the bandits. They're all dead except their leader. The "
"fingerless wretch is still alive.\""
msgstr ""
"\"도적은 수가 엄청나게 많았어. 우리를 계속 추격하면서 습격할 기회를 보고 있었나 봐. 보다시피, 우리 기지가 외진 곳에 있잖아. "
"그들은 내가 떠나길 기다렸다가 모두를 학살했어. 마지막으로 나를 죽이려고 매복했지. 거기서 빠져나올 수 있었다니 굉장히 운이 좋았지. "
"나는 족장 아들의 손에서 망치를 빼내 싸웠고, 도적 무리를 헤쳐 나올 수 있었어. 그리고 입장을 바꿔, 잔당을 사냥하기 시작했지. "
"{g|Kamelands}케임랜드{/g}의 늪지에서 흔적을 놓쳤지만. 그다음에 일어난 일은 잘 알 테지. 우두머리 빼고는 다 죽었다 "
"하더라고. 대장이었던 손가락 없는 마녀만 아직 살아있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcArtisan/Cue_0047_Text
msgctxt "d64d34bb-6ec7-4c28-aacf-80a2cc2dc69d"
msgid ""
"{n}The half-orc grins happily.{/n} \"I'm glad I trusted someone like you "
"with my revenge.\""
msgstr "{n}하프오크는 행복하게 웃습니다.{/n} \"너 같은 자가 내 복수를 맡아주다니 기쁘군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Answer_0003_Text
msgctxt "6ef3e1e4-bc65-490d-8546-42fb191d5cca"
msgid "\"What happened to you?\""
msgstr "\"무슨 일이 일어났던 거야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Answer_0004_Text
msgctxt "2c1a07f1-b1f7-48c2-9bb0-7d1de0c5f2eb"
msgid "\"What is your name?\""
msgstr "\"이름은 뭐야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Answer_0005_AlignmentShift.Description
msgctxt "f4965dbb-dc01-4fc8-8e3c-a3bdebfda23a"
msgid "Killed old half-orc Varrask for no reason."
msgstr "이유 없이 하프오크 바라사크를 죽였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Answer_0005_AlignmentShift.Description_1
msgctxt "f21c6e43-7b0f-42ee-8464-0888c1d81651"
msgid "Killed old Varrask without any cause."
msgstr "이유 없이 하프오크 바라사크를 죽였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Answer_0005_Text
msgctxt "ca624a83-a4d8-42ab-949b-73c5ae0a6a0a"
msgid ""
"[Attack] \"You look like you're at death's door. Let me give you a little "
"push.\""
msgstr "[공격] \"너는 죽을 때가 된 것 같군. 내가 도와주지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Answer_0006_Text
msgctxt "bd56668d-51f5-44d6-84a9-8c2a679eb116"
msgid "\"I won't distract you from your woes.\""
msgstr "\"너를 방해하지 않겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Answer_0010_Text
msgctxt "facc1ab4-c193-45ba-ae7e-126f722440d1"
msgid "\"Here are your tools.\""
msgstr "\"여기 네 도구다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Cue_0001_Text
msgctxt "06c5ad8e-9aa1-4cca-9d25-5799a9b8d909"
msgid ""
"{n}An elderly half-orc looks at you without any friendliness. His clothes "
"are covered with spots, and he looks exhausted and sickly.{/n} \"What are "
"you looking at? Can't you see, master Varrask is not well. On my last legs. "
"Go along, leave me to my unhappy fate.\" {n}Despite the cantankerous tone, "
"there is certain confidence in the half-orc's voice, especially in how "
"proudly he spoke the word 'master'.{/n}"
msgstr ""
"{n}늙은 하프오크는 무뚝뚝하게 당신을 봅니다. 그의 옷은 얼룩져있고 그는 지쳐 보입니다.{/n} \"무엇을 찾는 거지? 보다시피 내 "
"몸은 좋지 않아. 내가 최후를 맞게 나를 내버려둬.\" {n}지친 목소리에도 하프오크의 목소리에는 자신감이 들어있습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Cue_0007_Text
msgctxt "2897e0d7-3905-41dd-b614-2c02f1a2dbb6"
msgid ""
"{n}The half-orc harrumphs brashly in response, but his eyes seem "
"disappointed.{/n}"
msgstr "{n}하프오크는 시원하게 대답하지만 실망한 것 같습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Cue_0008_Text
msgctxt "31556871-e14c-47ae-933d-143af7fe9e4d"
msgid ""
"\"What happened... It was a calamity! I was going about my business, and "
"then I fell ill. Cut down by a fever. I'd been burning up for three weeks. I "
"thought I would die more than once. A local merchant saved me... a kind "
"soul, damn him. He saved me, but not for free. Took everything I had as "
"payment – even my precious work tools, the last of my treasures!\""
msgstr ""
"\"그것은... 재앙이었어! 나는 일을 하려고 했지만 병에 걸렸지. 열이 높아 쓰러졌지. 3주 내내 열병을 앓았어. 한번 더 이런 일을 "
"겪으면 죽을 거란 생각이 들더군. 한 지역 상인이 나를 구해줬어... 친절한 자였지. 제길, 하지만 공짜는 아니었어. 돈이 될만한 건 "
"모두 가져갔어. 심지어 내 가장 소중한 작업 도구마저도!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Cue_0009_Text
msgctxt "b565b401-691f-4af2-8040-ac99f22020e2"
msgid ""
"\"I'm useless like this. What good am I to anyone? But if I got my tools "
"back I'd be quite all right! I used to make such weapons and armor – they "
"sold faster than I could make them. But without my tools I'm useless. If you "
"tried to use a regular hammer to forge like I do, you'd just ruin a good "
"thing. I'd bend the tongs, and wouldn't make anything worth putting my name "
"to. That trickster got everything I need!\""
msgstr ""
"\"나는 쓸모 없어. 내가 무슨 소용이겠어? 하지만 도구를 돌려받으면 나는 괜찮아! 나는 무기와 갑옷을 만들지. 만드는 것보다 팔리는 "
"속도가 더 빠를 지경이야. 하지만 도구가 없다면 나는 쓸모 없어. 보통의 망치를 사용한다면 소용 없어. 그럴 바에는 만들지 말고 이름도 "
"붙이지 않겠어. 그 사기꾼이 내 모든 걸 가져갔어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Cue_0011_Text
msgctxt "f5618bf3-f531-4e33-8aec-e577fe154fc4"
msgid ""
"{n}Varrask looks at you with eyes full of despair and clenches his huge "
"fists.{/n} \"Old Varrask is listening. What are we going to talk about?\""
msgstr "{n}바라사크는 실망한 눈으로 당신을 보고는 주먹을 쥡니다.{/n} \"듣고 있다. 무슨 얘기를 하고 싶은 건가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Cue_0012_Text
msgctxt "34571bdd-ecbd-4dbf-89ec-c1c9b746481d"
msgid ""
"{n}The half-orc touches the tools tenderly, as if he can't believe his eyes, "
"and then clutches them as tightly as he can.{/n} \"Can I have them back? "
"Really? Thank you so much! Well now I'll be all right! I'll have food on the "
"table, I'll get rid of this damn fever, and do what I promised my children! "
"And I'll keep my promise. Give me a place to set up a shop, and I'll work "
"hard to repay you!\""
msgstr ""
"{n}하프오크는 부드럽게 자신의 도구를 만집니다. 자신이 보고 있는 것을 믿을 수 없는 듯했지만 도구를 꽉 쥡니다.{/n} \"이걸 "
"돌려받을 수 있어? 정말이야? 고마워! 나는 괜찮을 거야! 이 망할 병도 낫고 내 아이들에게 한 약속을 지킬 거야! 나에게 가게를 차릴 "
"곳을 마련해주면 빚을 갚도록 하지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Cue_0013_Text
msgctxt "29274436-1889-4d4d-9c31-4b83335e74d9"
msgid ""
"\"Varrask. Varrask the Wildfist, they call me. I was once an armor and "
"weapons maker. I'm more of a corpse than a master now. Some evil people took "
"everything from me. My family, my house, my craft... Even took my tools. "
"Everything.\""
msgstr ""
"\"바라스크, 거친주먹 바라스크라고 해. 나는 무기와 갑옷을 만들지. 나는 지금 몹시 몸이 안 좋아. 나쁜 놈들이 내 소중한 것들을 "
"가져갔지. 내 가족과 집 도구도... 모든 것을 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/HalfOrcFirstMeeting/Cue_0015_Text
msgctxt "6bae574a-4068-4313-9dd6-4ab4d0d0f470"
msgid ""
"{n}The half-orc pierces you with his angry eyes.{/n} \"Listen, I can tell "
"you got money... maybe you need an armorer? If you help me, I'll serve you. "
"I'll make formidable weapons for you! Ones that just beg for enemy blood! "
"But first I need my tools back.\""
msgstr ""
"{n}하프 오크는 화난 눈으로 당신을 봅니다.{/n} \"잘 들어. 갑옷 만드는 대장장이가 필요한가 보지? 나를 도와주면 너를 섬기겠어. "
"좋은 무기를 만들어주겠다 이거야! 하지만 우선 도구가 필요해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0005_Text
msgctxt "c6c73c45-a6ba-47cf-b360-dd482b6efd01"
msgid "[Attack] \"Varrask sends his regards.\""
msgstr "[공격] \"바라사크가 안부를 전해달라는군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0010_Text
msgctxt "a3b1d27a-a258-4a31-9ae6-bff38e5ae9a0"
msgid "\"Have you heard the name Varrask?\""
msgstr "\"바라스크라고 들어봤나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0011_Text
msgctxt "2965cb35-df2b-4f60-ae93-aec39eddc99d"
msgid "\"What has this criminal done?\""
msgstr "\"이 범죄자가 무슨 짓을 한 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0012_AlignmentShift.Description
msgctxt "7a4df8f7-b720-400d-9e22-15f709edaf31"
msgid "Killed the Lastwall inquisitor at Varrask's request."
msgstr "바라사크의 요청대로 라스트월의 인퀴지터를 죽입니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0012_AlignmentShift.Description_1
msgctxt "2e43847b-4360-4b59-9eb2-5a9f63a54a04"
msgid "Killed the inquisitor of Iomedae at Varrask's request."
msgstr "바라사크의 요청대로 이오메데의 인퀴지터를 죽입니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0012_Text
msgctxt "cc69927e-fd2a-458d-beeb-6f85a8e0b83a"
msgid "[Attack] \"Enough talk. I've come for your blood.\""
msgstr "[공격] \"대화는 됐다. 네 피를 얻으러 왔다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0013_Text
msgctxt "511ddb92-1da2-453a-919e-945d3f93658e"
msgid "\"With a common traveler. Never mind me.\""
msgstr "\"그냥 여행자다. 신경 쓰지 마라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0019_AlignmentShift.Description
msgctxt "d2863cd4-a28a-4733-bbf5-acd46ac49e88"
msgid "Killed the Lastwall inquisitor at Varrask's request."
msgstr "바라사크의 요청대로 라스트월의 인퀴지터를 죽입니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0019_AlignmentShift.Description_1
msgctxt "83866ef4-d463-410d-9e0f-aed7f65647b2"
msgid "Killed the inquisitor of Iomedae at Varrask's request."
msgstr "바라사크의 요청대로 이오메데의 인퀴지터를 죽입니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0019_Text
msgctxt "cd1525e8-8e91-4900-9345-ee9e9eb43ab9"
msgid ""
"[Attack] \"I need Varrask, and he wants your blood. It's as simple as that.\""
msgstr "[공격] \"나는 바라사크가 필요한데 그는 네 피를 원해. 아주 간단하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0020_Text
msgctxt "fdda44ab-c124-415c-975e-f4e1257ba63e"
msgid "\"Varrask is on the right side of the law now. He won't hurt anyone.\""
msgstr "\"바라스크는 지금 법의 편이다. 그는 누구도 해치지 않을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0021_AlignmentShift.Description
msgctxt "19b2112d-ebdd-4a7a-81d3-f48d9c06a069"
msgid "Handed Varrask over to the Lastwall inquisition."
msgstr "바라스크를 라스트월 심문에 넘깁니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0021_AlignmentShift.Description_1
msgctxt "650b4853-8c4b-4ce6-9e01-569cdcc1410d"
msgid "Handed Varrask over to the inquisition."
msgstr "바라스크를 심문에 넘깁니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0021_Text
msgctxt "a1dc9fa8-4178-4694-8b79-b50d378333aa"
msgid "\"Hand me the map. I'll point to the rascal.\""
msgstr "\"지도를 줘. 그 자식이 있는 곳을 알려주지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0025_Text
msgctxt "fe38deec-5994-4ed9-8c36-c1c3318ed71d"
msgid ""
"\"I am {name}, the {mf|baron|baroness|king|queen} of these lands. Who are "
"you?\""
msgstr "\"나는 {name}. 너는 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Answer_0027_Text
msgctxt "77eb6841-bc1f-41f8-a583-80ff743c7033"
msgid "\"You must do as you see fit.\""
msgstr "\"당신이 맞다고 생각하는데로 행하시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Cue_0001_Text
msgctxt "34551221-3e1f-4558-8aba-b9bad23f2580"
msgid ""
"{n}The girl is eyeing you expectantly, her hand laying casually over her "
"weapon. The hand is missing its two smallest fingers.{/n} \"Who do I have "
"the pleasure of addressing?\""
msgstr ""
"{n}여성은 당신을 관찰하고는 무기에 손을 댑니다. 손에는 가장 작은 손가락이 두 개가 없습니다.{/n} \"누가 나를 찾지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Cue_0014_Text
msgctxt "43c71588-0522-4a91-adc8-18b98008a342"
msgid "{n}The girl looks at you with distrust.{/n} \"Hm... Whatever you say.\""
msgstr "{n}여성은 믿지 못하겠다는 듯 당신을 봅니다.{/n} \"흠... 어쨌든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Cue_0016_Text
msgctxt "2120b876-76b3-4077-bd71-a2f5c5533eb1"
msgid ""
"\"The half-orc formed a gang with his wife, sons, and daughters. "
"{g|Iomedae}Iomedae{/g} alone knows how many people he killed for their "
"money, how many children he deprived of parents... His whole family was "
"awash in bloodshed until my comrades and I tracked them down and put an end "
"to the violence. Only Varrask managed to escape.\""
msgstr ""
"\"그 하프오크는 그의 아내, 아들, 딸들과 함께 패거리를 만들었다. 그가 돈을 위해 얼마나 많은 자를 죽였는지, 얼마나 많은 아이들을 "
"부모에게서 빼앗았는지... 는 {g|Iomedae}아이오메데{/g}만이 알겠지... 나와 내 동료들이 그들을 처치하고 나서야 그 비극을 "
"멈출수 있었지. 그런데 바라스크만 빠져나갔어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Cue_0017_Text
msgctxt "34d32a77-f81e-4bf2-8d0b-223a1d584f3c"
msgid ""
"{n}The girl looks eagerly at you.{/n} \"Of course, I know the "
"{d|Varrask}name{/d}. He is the criminal I'm after! What do you know of him?\""
msgstr ""
"{n}여성은 당신을 봅니다.{/n} \"물론 {d|Varrask}바라스크{/d}를 잘 알지. 내가 쫓고 있는 범죄자야. 그에 대해 무엇을 "
"알지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Cue_0022_Text
msgctxt "6ffed27b-f99c-4ad2-823e-2e8d583c2c4e"
msgid ""
"{n}The girl studies you for a moment and then speaks with regret:{/n} \"Do "
"you think I'll give up on my mission just like that? I won't. I know he's "
"alive. I know where he is. He's in your capital, right? Even if he's not "
"there, he must be somewhere nearby. I shall keep looking until I fulfill my "
"vow.\""
msgstr ""
"{n}여성은 잠시 당신을 보더니 후회하듯 말합니다.{/n} \"내 임무를 그렇게 쉽게 포기할 것 같아? 아니. 그 녀석은 살아있어. "
"어디에 있는지는 알지. 네 수도에 있지? 거기에 없다면 그 주변 어딘가에 있겠지. 나는 내 임무를 수행할 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Cue_0023_Text
msgctxt "98d873e3-218c-4d15-b0ad-857e299f4e1f"
msgid ""
"{n}She narrows her eyes as she draws a breath, as if she's trying to sniff "
"out Varrask.{/n} \"Thank you. {g|Iomedae}Iomedae{/g} must have brought you "
"to me. The bloody bastard will finally be punished.\""
msgstr ""
"{n}그녀는 한숨을 쉬면서 눈을 가늘게 뜹니다.{/n} \"고마워. {g|Iomedae}아이오메데{/g}가 우리를 만나게 한 것 같군. "
"그 살인마가 마침내 벌을 받게 될거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Cue_0024_Text
msgctxt "22f316a4-0053-4e71-afd4-895ebb09f288"
msgid ""
"\"I couldn't let the criminal go unpunished, and swore to pursue him until "
"one of us falls dead. I only here lost his track, at the edge of the swamps "
"of the {g|Stolen Lands}Stolen Lands{/g}... You would hardly take an interest "
"in this matter if you weren't involved. Do you know anything about Varrask? "
"Where is he now? Say the word, and I'll rid your lands of the bastard.\""
msgstr ""
"\"난 그 범죄자를 포기할 수 없어. 죽기 전까지 그를 쫓을 거야. 나는 {g|Stolen Lands}도둑맞은 땅{/g}의 늪지에서 그 "
"녀석의 흔적을 잃어버렸어... 관련이 없다면 너는 관심이 없을 텐데. 바라스크에 대해 아는 것이 있어? 그는 지금 어디에 있지? 말해. "
"네 땅에서 그 개자식을 없애버릴 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Cue_0026_Text
msgctxt "ceb4761c-5a82-4f67-ba54-2c0a099ac71c"
msgid ""
"\"I am the Lastwall inquisitor, {g|Iomedae}Iomedae's{/g} servant. I'm "
"looking for a dangerous criminal. His trail leads to the {g|Stolen Lands}"
"Stolen Lands{/g}. The rascal is the only remaining member of the gang that "
"spread terror across the lands. I took a vow to put an end to their bloody "
"tale.\""
msgstr ""
"\"나는 라스트월의 인퀴지터이자 {g|Iomedae}아이오메데{/g}의 추종자다. 나는 위험한 범죄자를 쫓고 있어. 그의 흔적이 {g|"
"Stolen Lands}도둑맞은 땅{/g}으로 이어졌더군. 그 악당은 전국에 공포를 몰고온 범죄 조직 중 유일하게 살아 남은 멤버다. "
"나는 그 자의 악행을 끝내기로 맹세했어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Inquisitor/Cue_0028_Text
msgctxt "fc986f40-8ea5-4df3-8190-e46e7556d059"
msgid ""
"{n}The girl sighs.{/n} \"Thank you for not keeping me from my task. My "
"little holiday is over! Varrask is in one of the local settlements – and one "
"step away from being arrested! His time will soon come. Farewell, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}.\""
msgstr ""
"{n}여성이 한숨을 쉽니다.{/n} \"나를 내버려두어 고마워. 내 휴가도 끝이야. 바라스크는 그 마을 어딘가에 있을 텐데. 조금만 더 "
"찾으면 잡을 수 있을 거 같아! 그는 곧 잡히겠지. 그럼 안녕히.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Items/EnemysBloodDescription_String
msgctxt "6f571e9c-a833-44d7-9132-7dca12eda03c"
msgid "This is the blood of the murderer who took lives of Varrask's family."
msgstr "바라스크의 가족의 생명을 앗아간 살인자의 피입니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Items/EnemysBlood_String
msgctxt "b2a1946b-26b8-4475-a97f-f9646eca29e7"
msgid "The Blood of the Murderer of Varrask's Family"
msgstr "바라스크 가족 살해자의 피"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Items/InubrixDescription_String
msgctxt "62a9d180-75dd-4828-a84a-91e6198231a1"
msgid ""
"Ordinary-looking metal, rather soft. Who would have thought that Varrask "
"would need it to craft a deadly weapon?"
msgstr "평범하게 생긴 철이고 조금은 물러보입니다. 바라스크가 이런 것으로 치명적인 무기를 만들거라고 누가 생각했을까요?"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Items/InubrixDescription_String_1
msgctxt "eff2cc2b-505b-4a99-9489-f9ac1640960f"
msgid "Several ingots of soft grey metal."
msgstr "무른 회색 금속 괴 몇 덩이."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Items/Inubrix_String
msgctxt "0b8d9474-f0bb-40b2-bbbf-00815682739d"
msgid "Inubrix"
msgstr "이누브릭스"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Items/WarrasksToolsDescription_String
msgctxt "7d133c8c-e7db-4ca6-8865-a6d8896ddd03"
msgid "Varrask's blacksmithing tools"
msgstr "바라스크의 대장장이 도구"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/Items/WarrasksTools_String
msgctxt "6bd7cd79-9a30-4b8f-a4c3-7c53cc58ef2d"
msgid "Varrask's Tools"
msgstr "바라스크의 도구"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Answer_0006_Text
msgctxt "ed52dc2f-6d63-4294-a165-eae2e8665fbf"
msgid "\"Thank you. Keep at it, Varrask.\""
msgstr "\"고마워. 바라스크.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Answer_0007_Text
msgctxt "77a7cb10-847f-473b-9576-f398b6174701"
msgid "\"I have a specific request for you.\""
msgstr "\"너에게 부탁이 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Answer_0008_Text
msgctxt "848979a9-2f42-4fc2-aa20-1d2b66a654ff"
msgid "\"Get out of my lands. Your service is no longer required.\""
msgstr "\"내 땅에서 나가. 너의 도움은 필요 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Answer_0013_Text
msgctxt "c7cb2783-8924-4117-8177-719ef3ef81f5"
msgid "\"A two-handed sword.\""
msgstr "\"양손 검.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Answer_0014_Text
msgctxt "7cf1a1c1-1d07-41c3-aea0-0eb0fabc87a0"
msgid "\"A two-handed axe.\""
msgstr "\"양손 도끼.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Answer_0015_Text
msgctxt "f8d14167-d0a6-492c-913e-8d99435307b2"
msgid "\"Armor.\""
msgstr "\"갑옷.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Answer_0016_Text
msgctxt "63364701-c85e-4156-a962-0da7bf39360f"
msgid "\"Give me a Kellid-style weapon.\""
msgstr "\"켈리드 스타일의 무기를 만들어줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Answer_0017_Text
msgctxt "cbe3f1aa-cbab-48c4-8ae6-b032d0f2367d"
msgid ""
"\"You're familiar with orc weapons and armor... can you make something like "
"that?\""
msgstr "\"너는 오크의 무기와 갑옷을 만들지... 그런 것을 만들어줄 수는 없나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Answer_0018_Text
msgctxt "29d719a5-35ff-42d0-871e-e6e09e3cc174"
msgid "\"A two-handed mace.\""
msgstr "\"양손 메이스.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Answer_0019_Text
msgctxt "2ba33657-9a93-4a8d-bbd8-04ef97e9295f"
msgid "\"Forget it. Make whatever your heart tells you to.\""
msgstr "\"잊어버려. 네가 원하는 것을 만들어줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Answer_0032_Text
msgctxt "44b17546-78c1-4211-9895-adf119a5a91e"
msgid "\"Remind me, who are you and what are you working on?\""
msgstr "\"다시 알려줘, 네가 누구고 무슨 일을 했었지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0001_Text
msgctxt "c1f81df3-8e3d-45b0-9dab-d547dd910e3c"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}! I have a gift for "
"you. This is an orc weapon, and they know a thing or two about war.\""
msgstr "\"안녕! 선물을 가져왔다. 이것은 오크 무기로 아주 치명적이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0001_Text_1
msgctxt "e02fd3e9-4aa6-49b2-abc5-c95b6b1ee3ff"
msgid ""
"\"Here, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! Obliteration "
"has been reforged and hardened. It has drunk itself full of enemy's blood. "
"This weapon means business. Let your enemies fear for their empty skulls! No "
"helmet can withstand a blow from this monster!\""
msgstr ""
"\"안녕! 말살을 고치고 단련했다. 피로 단련했지. 이 무기는 강력할 거다. 적의 대가리를 부수어 공포를 선사해주라고! 투구 없이 이 "
"괴물을 견딜 수 있는 녀석은 없을 거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0002_Text
msgctxt "48f16b1b-dd0a-4b84-8be8-3c677d860e2f"
msgid ""
"\"However, I could give you something much more impressive.\" {n}The old man "
"gives you a wink and a bloodthirsty grin.{/n} \"A weapon worthy of "
"{g|Gorum}Gorum's{/g} herald! It's a family relic. Come to my forge, and I'll "
"tell you more.\""
msgstr ""
"\"너에게 더 많은 인상을 줄 수 있어.\" {n}나이 든 남성은 씨익 웃습니다.{/n} \"{g|Numeria}고룸{/g}의 축복을 "
"받은 무기지! 이건 가보다. 내 대장간으로 오면 더 설명해주지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0002_Text_1
msgctxt "ac2d8a51-6e19-44e9-8f9e-3451faecc110"
msgid ""
"\"With such weapons you can go on raids and protect your lands! Everything "
"has been tempered in lamb blood, with proper prayers to all the proper gods. "
"Everything is done with care for you personally!\""
msgstr ""
"\"이런 무기가 있어야 전쟁도 하고 네 땅을 지킬 수 있지! 모든 것이 양의 피로 의식을 치루었고 기도를 드렸지. 모든 것은 너를 위해 "
"만들었어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0003_Text
msgctxt "743a519b-1e06-4e65-a219-c1ef7fdc9dea"
msgid ""
"\"I've completed my work, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. Obliterationr has been reforged and hardened! And I swear, it is "
"now even more deadly than before. Please, accept this glorious weapon as a "
"token of my gratitude for avenging me. Let your enemies fear for their empty "
"skulls! This hammer will make you invincible.\""
msgstr ""
"\"임무를 완수했다. 말살을 고치고 단련했지. 이전보다 더 치명적일 거야. 이 영광스러운 무기를 내 선물로 받아줘. 적들에게 공포를 "
"선사하라고! 이 망치는 너를 무적으로 만들어줄 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0003_Text_1
msgctxt "edd38284-e1fa-46cb-ba2e-5d435664cdca"
msgid ""
"\"Anyway, it was amusing work. But I could give you something even more "
"impressive. – A weapon worthy of {g|Gorum}Gorum's{/g} herald! But I'll need "
"your help with something... Come by if you're interested!\""
msgstr ""
"\"즐거웠다. 하지만 너에게 더 많은 인상을 줄 수 있어. {g|Numeria}고룸{/g}의 축복을 받은 무기지! 하지만 네 도움이 "
"필요해. 내 대장간으로 오면 더 설명해주지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0004_Text
msgctxt "9fa7b536-2b9e-4c1d-8a5f-b25523de2a82"
msgid ""
"{n}The {d|Varrask}half-orc{/d} bows diligently, trying to adhere to "
"etiquette.{/n} \"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, I "
"come bearing gifts. A sign of my gratitude for taking an old man into your "
"service.\""
msgstr ""
"{n}{d|Varrask}하프 오크{/d}는 예의 바르게 인사합니다.{/n} \"안녕하신가! 선물을 가져왔어. 내 감사의 표시야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0009_Text
msgctxt "ad32ef98-473c-4303-970d-40a44ee2a078"
msgid ""
"{n}For several moments the half-orc looks at you, baffled. He starts to "
"breathe heavily, trying to puff himself up, makes a few angry faces... But "
"then nothing. The old man's shoulders drop, and he turns away silently.{/n}"
msgstr ""
"{n}잠시동안 하프오크는 당신을 보더니 당황한 표정을 짓습니다. 그는 깊은 한숨을 쉬고는 험악한 표정이 드러납니다... 하지만 아무 일도 "
"없었습니다. 노인은 어깨를 늘어뜨린 채 조용히 걸어갑니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0010_Text
msgctxt "4a8f562a-87a7-4f87-8969-447f2ef38e0e"
msgid ""
"{n}The half-orc's face becomes serious.{/n} \"Well. What are we making? "
"Armor, weapons?\""
msgstr "{n}하프오크의 얼굴이 심각해집니다.{/n} \"좋아. 무엇을 만들까? 갑옷? 무기?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0011_Text
msgctxt "e0e49006-3c35-40c0-92d8-f1bcc76ef02f"
msgid ""
"\"Gladly. When a weapon or armor is made for a good fight, the work does "
"itself. And I know that many great fights await you!\""
msgstr "\"좋아. 좋은 무기나 갑옷이 만들어지면 좋겠군. 이 무기로 너는 전투에서 강력해질 거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0020_Text
msgctxt "b6e9487f-ef5a-4016-a9dc-501f9dc1109c"
msgid "\"As you say. I'll keep working.\""
msgstr "\"원하는 대로. 나는 계속 일하겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0021_Text
msgctxt "c6797211-1f07-4e63-82c4-27f0c0f6ce21"
msgid ""
"{n}The half-orc winks at you.{/n} \"Why strike with one hand when you have "
"two, right?\""
msgstr "{n}하프오크가 당신을 보고 찡긋합니다.{/n} \"두 손이 있는데 왜 한 손으로 무기를 들려고 하지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0024_Text
msgctxt "e7aa6682-107c-4472-908e-d57d70383f33"
msgid ""
"\"A good warrior always has good armor – otherwise he doesn't live long. "
"I'll get right to work!\""
msgstr "\"좋은 전사는 항상 좋은 갑옷이 있지. 그렇지 않으면 곧 죽어. 이제 일해야겠군!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0025_Text
msgctxt "bea1d3a4-2bd9-4643-bdf2-8827000999e4"
msgid "\"Sturdy, frightening, and elegantly simple. Got it, will do.\""
msgstr "\"단단하고 무시무시하고 단순한 모양의 것이라. 알겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0026_Text
msgctxt "50cc670a-60d2-4030-ba09-2d7234259e85"
msgid ""
"\"To be sure! I can make you some first class gear – you'll be like an orc "
"chief!\""
msgstr "\"확실히! 최고급 장비를 만들어주지. 오크 족장처럼 멋질 거다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0030_Text
msgctxt "6761ad64-006b-4dfa-a996-b4210ddee786"
msgid ""
"\"There's something else... I have all I need to start reforging "
"Earthbreaker. You'd better not give me any big orders for a while, so I can "
"concentrate on the hammer... and make sure you don't forget my payment!\""
msgstr ""
"\"그리고... 지진 망치(Earthbreaker)를 고치기 위해 필요한 건 모두 모았어. 나에게 시간이 있으니 망치에 집중할 수 "
"있어... 그리고 돈은 준비해두라고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0031_Text
msgctxt "d994ce9a-cfb9-4205-9c8b-73d2979350b3"
msgid "\"Well, I'll get to work on Earthbreaker then.\""
msgstr "\"좋아. 지진 망치(Earthbreaker)를 만들겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_ArtisanHalfOrc/Cue_0033_Text
msgctxt "14ba9f7f-3fa4-4c33-8440-cefeb3a5046f"
msgid ""
"\"I'm Varrask – weaponsmith. I'm good at making two-handed weapons — "
"everything good for cutting off heads off or smashing them! Though I can "
"make some armor, too. There's one special thing old Varrask wants to do "
"before death takes him. – To reforge the great warhammer, Obliteration. That "
"one breaks enemy armor like an egg shell. It was passed down through a dozen "
"generations in my family, and was broken when its last master died. My son. "
"My son… I cannot get him back. But at least I can give his weapon a new life!"
"\""
msgstr ""
"\"나는 무기 장인 바라스크야. 내가 주로 만드는건 양손 무기지 — 적의 대가리를 베거나 부숴버리는데 딱이지! 물론 갑옷도 만들 수 "
"있고. 이 늙은 바라스크에게는 죽기 전까지 완성하고 싶은 매우 특별한 작업이 있지. – 그것은 적들의 방어구를 달걀 껍질처럼 부숴버릴 수 "
"있는 위대한 전쟁망치, '말살'을 주조하는 일이야. 그것은 가업으로서 우리 가문의 열 두 세대를 거쳐 내려왔고, 마지막 세대의 장인이 "
"죽음으로서 끝나버렸지. 내 아들. 내 아들이여... 나는 아들을 되살릴 수는 없어. 그러나 최소한 그의 무기에는 새 생명을 불어넣을 수 "
"있지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_EE_StatGift_Varrask/Cue_0001_Text
msgctxt "19cce330-aed0-41a4-8b67-3bec7e61dc11"
msgid ""
"\"Greetings, {mf|baron|baroness|King|Queen}. A good land you have here. So "
"many seasoned warriors around. – More customers for old Varrask's weapons. I "
"like it when there's so many good cutters around. I can breathe here, with "
"fighters like these.\""
msgstr ""
"\"안녕하신가, {mf|남작|여남작|왕|여왕}. 이곳은 좋은 땅이오. 숙련된 전사들이 도처에 많이 있지. – 늙은 바라스크의 무기를 찾는 "
"고객들이기도 하오. 나는 주변에 많은 절단자들이 있는게 좋소. 이렇게 뛰어난 전사들과 함께라면, 나도 여기서 살 수 있을 것 같군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_EE_StatGift_Varrask/Cue_0002_Text
msgctxt "d8630ca6-8e87-4767-b29a-0de049acf7ab"
msgid ""
"\"Greetings! Yours is a strong army, {mf|baron|baroness|King|Queen}, and it "
"seems you know how to keep an eye on those sneaky enemy scouts swarming "
"around. But a little extra help wouldn't hurt, right?\""
msgstr ""
"\"안녕하신가! 당신의 군대는 아주 강력하오, {mf|남작|여남작|왕|여왕}. 또한 당신은 적국의 은밀한 첩보원들이 날벌레들처럼 당신을 "
"주시하고 있는 걸 파악했을 것이오. 그래도 소소한 도움 정도라면 나쁠 건 없겠지, 안그렇소?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalfOrcMaleEnforcerCE/KTC_EE_StatGift_Varrask/Cue_0003_Text
msgctxt "18267f37-7410-4250-b896-e61e0d2a51e4"
msgid "\"Here, take this. It's my gift – it's a good one!\""
msgstr "\"이것을 받으시오. 나의 선물이요. 좋은 놈으로 골랐다오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Answer_0005_Text
msgctxt "abb0111b-3cff-4d10-b7b2-aa11f3a4ac8a"
msgid "\"Tell me more about your offer.\""
msgstr "\"네 제안에 대해 말해봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Answer_0007_Text
msgctxt "68b782d8-92ad-4f38-95a7-11e3957ab008"
msgid "\"I don't want any part in your affairs!\""
msgstr "\"나는 끼어들고 싶지 않아!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Answer_0008_Text
msgctxt "989ff772-8d3e-4df9-91ce-ac1dbd1e3be7"
msgid ""
"\"I won't tolerate smuggling in my domain. Guards! Take her to prison!\""
msgstr "\"내 땅에서 밀수라니. 경비! 그녀를 감옥에 가둬라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Answer_0010_Text
msgctxt "faf82fb9-8748-4a77-b6fa-16f9f2cfd8ea"
msgid "\"I'll see what I can do.\""
msgstr "\"내가 할 수 있는 일을 찾아보겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Answer_0013_AlignmentShift.Description
msgctxt "730b5aec-7352-4c7b-a441-0508eaa6d33a"
msgid "Jailed the smuggler."
msgstr "밀수꾼을 감옥에 가둡니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Answer_0013_Text
msgctxt "c297d640-e58b-45ed-9e2c-35dfed0bc3cd"
msgid "[To guards] \"Didn't you hear me? Take her away!\""
msgstr "[경비에게] \"못 들었어? 그녀를 데려가!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Answer_0014_AlignmentShift.Description
msgctxt "f47b7ca9-4df1-4fe8-85b0-41e97099afdf"
msgid "Exiled the smuggler."
msgstr "밀수꾼을 추방했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Answer_0014_Text
msgctxt "4925c6e0-3838-47e1-8e6f-44e3e67a4eaa"
msgid ""
"[To Irlene] \"Since this is your first time, I'll give you a break. Never "
"set foot here again.\""
msgstr "[얼린에게] \"네게 휴식을 주지. 다시는 여기로 오지 말아라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Answer_0015_AlignmentShift.Description
msgctxt "1e0d8638-0e0f-4dd3-af40-5dc344c95ace"
msgid "Ordered the smuggler to be executed."
msgstr "밀수꾼을 처형하라고 명령했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Answer_0015_Text
msgctxt "dc0834fc-b124-423d-ba6d-01be81baa76f"
msgid "[To guards] \"Execute her. Immediately.\""
msgstr "[경비에게] \"그녀를 처형해라. 당장.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Cue_0001_Text
msgctxt "44284c90-71b0-448c-858c-c6a575cb6b0a"
msgid ""
"\"Greetings, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! Allow "
"me to pay my respects and deliver a gift on behalf of my master, a well-"
"known connoisseur of magical artifacts, kindly welcomed by you in the "
"capital!\""
msgstr ""
"\"안녕하신지요, {mf|영주님|영주님|전하|전하}! 유명한 마법 유물 감정가인 제 주인을 대신해 {mf|영주님|영주님|전하|전하}의 "
"따뜻한 환영에 보답하여 선물을 전해드리도록 허락해 주십시오. 제 경의를 담아 바치오니 받아주시길!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Cue_0002_Text
msgctxt "d9442580-d54e-47fa-b940-362f8e9a8cec"
msgid ""
"\"Let me introduce myself. Irlene Greyridge, at your service.\" {n}The girl "
"bows briefly and springs back up. She casts curious, assessing glances "
"across the throne room and holds out a package.{/n} \"This is a modest gift "
"from my master, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. May "
"it serve you well! And in case you're looking for more...\""
msgstr ""
"\"명하신대로, 제 소개를 드리겠습니다. 저는 얼린 그레이리지입니다.\" {n}소녀는 잠깐 절을 하고 일어섰습니다. 그녀는 호기심에 찬 "
"눈으로 알현실을 얼른 훑어보고 보고는 선물을 내밉니다.{/n} \"이건 제 주인이 보내는 소박한 선물입니다, "
"{mf|영주님|영주님|전하|전하}. 마음에 드시길! 혹시 더 필요한 게 있으시다면...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Cue_0003_Text
msgctxt "ea4f9281-9cd6-44f6-8829-8a0be99fce87"
msgid ""
"{n}Irlene looks at you sideways and smiles mysteriously.{/n} \"I beg you to "
"forgive my audacity, but since destiny is giving me the opportunity to speak "
"with you face-to-face... You see, my master is a highly educated and "
"respected specialist, but unfortunately, he has no business acumen "
"whatsoever. For my part, as much as I appreciate collectible items of great "
"aesthetic value, I'm far more interested in turning my knowledge in this "
"sphere toward tangible profit. If you take an interest in obtaining magical "
"items without all this hassle... I could arrange it.\""
msgstr ""
"{n}얼린이 흘긋 눈치 보며 오묘한 미소를 흘립니다.{/n} \"부디 제 무례를 용서해주시길... 사정이 여의치 않아 홀로 알현하게 "
"되었습니다. 주인님께서는... 학식 높은 전문가지만, 아쉽게도 사업에는 전혀 소질이 없으십니다. 하여 제가 수집품의 진가를 어림하여 "
"수익을 내는 부분을 도맡았지요. 관심 있으시다면 번거로운 과정 없이 마법 물품을 취득하실 수 있도록 도와드리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Cue_0009_Text
msgctxt "4ca08328-f483-4e86-b5eb-857ad6d20b69"
msgid ""
"\"You see, over all my years of travel, I've built up... a long list of "
"contacts across {g|Golarion}Golarion{/g}. In other words, I can acquire "
"magical rarities, no matter the distance or difficulty. If you kindly help "
"me open my own shop, I'll gladly quit my master and use my talents for your "
"benefit.\" {n}Irlene stops speaking and looks at you expectantly.{/n}"
msgstr ""
"\"여행하는 동안 저는... {g|Golarion}골라리온{/g} 도처에 많은 거래처를 만들어두었습니다. 그래서 저는 거리나 그밖의 "
"어려움에 관계없이 마법적 귀중품을 조달할 수 있지요. 제 가게를 차릴 수 있게 도와주신다면 기꺼이 주인 곁을 떠나 제 재능을 당신의 "
"이익을 위해 쓰겠습니다.\" {n} 얼린은 말을 멈추고 당신을 기대에 찬 눈으로 바라봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Cue_0011_Text
msgctxt "69774f16-e270-4d74-98e7-e3ad9fdc077a"
msgid ""
"\"Oh, thank you! May your reign last for years to come!\" {n}Irlene bows.{/n}"
" \"I dare not distract you any longer, {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}!\""
msgstr ""
"\"오, 감사합니다! 당신의 통치가 앞으로도 계속되기를!\" {n} 얼린은 고개를 숙여 인사합니다.{/n} \"이만 물러가겠습니다, "
"{mf|영주님|영주님|전하|전하}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Cue_0012_Text
msgctxt "753234c0-90d8-4545-b78b-225c51bf272f"
msgid ""
"{n}Irlene cowers in fear.{/n} \"No... {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}, I beg you... Forgive me my insolence! Don't kill me!"
"\""
msgstr ""
"{n}얼린은 두려움에 떱니다.{/n} \"안 돼... {mf|영주님|영주님|전하|전하}, 제 무례함을 용서해주시옵소서! 살려주시옵소서!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/01_Introduction/Cue_0017_Text
msgctxt "bc78dd36-b234-44be-9666-ed4306d3cfbe"
msgid ""
"{n}The halfling utters a sigh.{/n} \"Such a shame... In that case, I won't "
"let my presence here bother you further. Farewell, {mf|Your Grace|Your Grace|"
"Your Highness|Your Highness}!\""
msgstr ""
"{n}하플링은 한숨을 쉽니다.{/n} \"정말 안타깝습니다... 그럼, 더이상 귀찮게 굴지 않겠습니다. 안녕히계십시오, "
"{mf|영주님|영주님|전하|전하}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Items/Gembox_Description_String
msgctxt "14211e10-ea7d-41ed-9685-6ca3aee6964d"
msgid "A delicately carved box filled with pure gems."
msgstr "보석으로 가득 찬 세공한 상자입니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Items/Gembox_Name_String
msgctxt "557dca8c-21e9-4f2c-88e7-0fd48003fcd3"
msgid "Chest of Genuine Gemstones"
msgstr "진품 보석이 담긴 상자"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Items/UnicornHorn_Description_String
msgctxt "a19bf86c-353a-409b-bff0-dbba5f64dbf5"
msgid "The ivory twisted horn seems to glow softly."
msgstr "휘어진 뿔이 빛을 희미하게 냅니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Items/UnicornHorn_Name_String
msgctxt "562eaa45-9c3d-4011-9950-0134d5b324f5"
msgid "Unicorn's Horn"
msgstr "유니콘의 뿔"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_EE_StatGift_Irlene/Cue_0001_Text
msgctxt "10244b76-6171-488a-b7d7-d780689ae0fa"
msgid ""
"\"Good day to you, my {mf|baron|baroness|King|Queen}! Travelers from other "
"lands often visit the capital, and your subjects have many contacts in "
"foreign lands, as well. I've managed to acquire something particularly "
"curious from one of my new acquaintances!\""
msgstr ""
"\"좋은 날 되십시오, {mf|남작님|여남작님|왕 전하|여왕 전하}! 다른 영지에서 온 여행객들이 종종 수도에 들르고, 그리고 당신의 "
"국민들 또한 외국에서 많은 접촉을 합니다. 그러다 생긴 새로운 지인을 통해 특별히 흥미로운 물건을 얻었답니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_EE_StatGift_Irlene/Cue_0002_Text
msgctxt "7d0303bc-99d5-4773-b70d-2a74bc5825de"
msgid ""
"\"I couldn't be more proud of my decision to do business in your lands, {mf|"
"Your Grace|Your Grace|Your Highness|Your Highness}. It's easy to stay in "
"touch with my old contacts here, and gain new ones as well. And some of "
"those new contacts are gorgeous! There's plenty of powerful arcanists in the "
"capital these days, and with their help I can acquire truly unique artifacts."
"\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 저는 당신의 영토에서 사업하기로 결정한 게 더 이상 말할 수 없을 정도로 자랑스럽습니다. 제 옛 "
"고객들과 자주 접촉할 수 있는 것은 물론이고, 새로운 인연까지 얻을 수 있었습니다. 그리고 그들 중 일부는 고상하기까지! 최근 수도에 "
"강력한 비전학자들이 많이 찾아왔고, 그들의 도움을 받아서 저는 정말로 특별한 아티팩트를 얻을 수 있었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_EE_StatGift_Irlene/Cue_0003_Text
msgctxt "6c730840-da00-4e06-88ac-266f5bd13473"
msgid "\"Here's my latest trophy. A gift for my favorite customer!\""
msgstr "\"여기, 최근에 건진 물건입니다. 제가 가장 좋아하는 고객님께 드리는 선물이지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Answer_0008_Text
msgctxt "24312097-71eb-4bc9-ac9d-9b5e8428bd43"
msgid "\"Thank you. I'll be expecting your future creations.\""
msgstr "\"고마워. 다음 작품도 기대하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Answer_0009_Text
msgctxt "246d1e15-b10a-4ad8-9252-0e38f92bb920"
msgid "\"I would like to order a specific item.\""
msgstr "\"특별한 물품을 부탁하고 싶어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Answer_0010_Text
msgctxt "e0757e36-0d28-4b7c-82af-a434e66f2d93"
msgid "\"Your services are no longer needed.\""
msgstr "\"너의 도움은 이제 필요 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Answer_0013_Text
msgctxt "904af8e5-c7ed-4376-8062-c7f80c84650c"
msgid "\"A set of magic scrolls.\""
msgstr "\"마법 스크롤 세트.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Answer_0014_Text
msgctxt "e12563f1-ff91-4755-9c5c-0b1262ef4b39"
msgid "\"Wand.\""
msgstr "\"완드.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Answer_0015_Text
msgctxt "4dd99d37-89e6-4906-a3c4-6618f31d862b"
msgid "\"Rod.\""
msgstr "\"지팡이.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Answer_0016_Text
msgctxt "376e688c-e2ce-4d40-b032-e1d6e1ef74d2"
msgid "\"Staff.\""
msgstr "\"스태프.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Answer_0017_Text
msgctxt "1e583ec2-b4b7-4da4-aced-306416b0fffe"
msgid "\"I changed my mind. Do as you wish.\""
msgstr "\"마음을 바꾸었어. 마음대로 만들어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Answer_0020_Text
msgctxt "a6216696-bfee-4e2d-a656-a22a986bff54"
msgid "\"Of course!\""
msgstr "\"물론!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Answer_0021_Text
msgctxt "22b0ef7c-6f88-4cd1-908b-192ecaf93e0a"
msgid "\"No, Irlene, your regular deliveries are enough.\""
msgstr "\"아니. 그냥 평소대로 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Answer_0028_Text
msgctxt "e043969c-6a25-4036-afe7-13ed29034a5c"
msgid "\"Remind me, who are you and what are you working on?\""
msgstr "\"다시 알려줘, 네가 누구고 무슨 일을 했었지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Cue_0001_Text
msgctxt "d9a4dae5-f606-4347-9c3c-ba07fb4b556c"
msgid ""
"{n}{d|Irlena}Irlene{/d} bows.{/n} \"Greetings, {mf|Your Grace|Your Grace|"
"Your Highness|Your Highness}! Allow me to alleviate your daily concerns with "
"a humble gift from your admirer!\""
msgstr ""
"{n}{d|Irlena}얼린{/d}이 인사합니다.{/n} \"안녕하십니까, {mf|영주님|영주님|전하|전하}! 전하의 충실한 백성이 "
"약소한 선물을 바치오니 받아주시옵고 부디 하루의 근심을 덜어내시길 청하옵니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Cue_0002_Text
msgctxt "69070355-d08c-443e-8f24-eae180e09a85"
msgid ""
"\"I am certain that you or one of your friends will find this... trinket "
"useful. It's come a long way to get to your hands.\""
msgstr ""
"\"아주 좋은 장신구는 아니지만... 당신의 친구들 중에 이걸 쓸만한 사람이 있을 겁니다. 당신께 드리기에는 한참 못미치지만요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Cue_0004_Text
msgctxt "ab76e2fb-4fd9-4b3f-b554-4fb8fcdb776d"
msgid ""
"\"I'd like to take this opportunity to thank you once again, {mf|Your Grace|"
"Your Grace|Your Highness|Your Highness}, for your kind generosity. I have "
"another... appealing offer for you.\""
msgstr ""
"\"이번 기회에 {mf|영주님|영주님|전하|전하}의 관대함에 다시 한 번 감사의 말씀을 드립니다. 실은... 관심 가지실만한 일을 하나 "
"더 가지고 왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Cue_0005_Text
msgctxt "0c85cd1e-6457-4821-ac41-08fb1025e0a1"
msgid ""
"{n}Irlene pales.{/n} \"But... have I done something to insult you? Well, I "
"suppose it's up to you. I won't trouble you again... But this was quite an "
"unexpected rejection.\""
msgstr ""
"{n}얼린이 새하얗게 질립니다.{/n} \"하지만... 제가 뭔가 기분이 상할만한 짓을 저질렀던 적이라도 있었나요? 물론, "
"{mf|영주님|영주님|전하|전하}의 뜻에 따라야지요. 다시는 방해하지 않겠습니다... 그치만 이러실 줄은 생각도 못했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Cue_0011_Text
msgctxt "83dd0b7a-d60b-48cb-a336-321432133c87"
msgid "{n}Irlene breaks into a smile.{/n} \"I won't keep you waiting.\""
msgstr "{n}얼린이 미소짓습니다.{/n} \"오래 기다시리지 않도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Cue_0012_Text
msgctxt "2030cf78-5ca3-4ce9-a6e0-436400ccfae5"
msgid "\"My quality for your money! What would you like?\""
msgstr "\"돈을 들이신 만큼 힘써 보겠습니다! 무엇을 원하십니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Cue_0018_Text
msgctxt "7000c174-b5e5-4b73-a956-36c80727e811"
msgid "\"Whatever you say!\""
msgstr "\"뭐든지 말씀만 해주세요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Cue_0019_Text
msgctxt "1aa41468-a9a3-49ef-ae92-077d07b9fd1b"
msgid ""
"{n}Irlene starts twisting her hair around her finger.{/n} \"My range of "
"goods is wide enough, no doubt. But just for you, I can get something "
"exquisite... One of my partners may have come across something valuable and "
"rare. However, I'll need your help to deliver it to you. Are you interested?"
"\""
msgstr ""
"{n}얼린이 손가락으로 머리를 꼽니다.{/n} \"저는 말할 것도 없이 다양한 상품을 취급하지만, 당신만을 위해서 더 특별한 물건을 "
"가져올 수도 있지요... 제 파트너 중 한 명이 값지고 희귀한 것을 발견한 것 같습니다. 하지만, 그걸 당신께 전달하려면 도움이 "
"필요합니다. 관심 있으십니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Cue_0022_Text
msgctxt "31fa81e6-5081-4773-9c00-2a0e54eab363"
msgid ""
"{n}Irlene claps.{/n} \"Come to my shop, {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}, so we can talk more in private.\""
msgstr ""
"{n}얼린이 박수를 친다.{/n} \"제 가게로 와주십시오, {mf|영주님|영주님|전하|전하}, 단 둘이서 할 이야기가 남아있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Cue_0023_Text
msgctxt "e4fc1b6d-c459-452f-b20e-bc0e5bd824dc"
msgid ""
"\"That's a shame. If you change your mind, you're welcome to visit my shop "
"to discuss the matter in private.\""
msgstr "\"안타깝습니다. 만약 생각이 바뀌시면, 언제든지 제 가게로 오셔서 이 문제를 상의하실 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Cue_0025_Text
msgctxt "703e951a-4528-4f75-b249-0b3fc6e45646"
msgid ""
"\"There is something else. My partner finally managed to send the article I "
"promised. Now I just need to arrange its delivery. If you want your trophy, "
"please, do not disturb my work. Allow me to do my job, and you'll have it "
"very soon!\""
msgstr ""
"\"부탁드릴게 하나 더 있습니다. 제 파트너가 드디어 제게 약속한 물건을 보냈습니다. 이제 그 물건이 배달되기만 기다리면 되죠. 물건을 "
"원하신다면, 저를 방해하지 말아주십시오. 제가 일을 할수 있게 해주시면 곧 드리도록 하겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Cue_0027_Text
msgctxt "2eec6400-df2a-4af6-908f-e6e2d4b778e0"
msgid ""
"{n}{d|Irlena}Irlene{/d} bows deeply and hands you a package.{/n} \"Here you "
"are, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. Please, accept "
"this gift as a token of my special respect and admiration. I swear, any "
"concerns you had while it was en route will be repaid!\""
msgstr ""
"{n}{d|Irlena}얼린{/d}이 인사를 하고는 물건을 건넵니다.{/n} \"여기있습니다, {mf|영주님|영주님|전하|전하}. 부디 "
"제 열렬한 경의와 존숭의 증표를 받아주소서. 맹세컨데, 그동안 쏟으셨던 염려를 보상하고도 남을 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/KTC_Gift/Cue_0029_Text
msgctxt "85a078d6-06b3-40fd-8061-431224ae916c"
msgid ""
"\"I'm Irlene, the smartest dealer in magical items in all the Stolen Lands! "
"With my connections I can find almost anything – rare spell scrolls, wands "
"and staffs. I've got a lead on one truly unique artifact – a rod that can "
"empower over any spell, and surpassed resistance to any magic! It won't be "
"easy to get our hands on this thing, but I'll do my best.\""
msgstr ""
"\"저는 얼린입니다. 도둑맞은 땅 전역에서 가장 똑똑한 마법 물품 거래상이죠! 제 동업자와 함께라면, 저는 거의 뭐든지 찾아낼 수 "
"있습니다. 희귀한 주문 스크롤, 완드와 지팡이들 말이죠. 저는 진짜 희귀한 아티팩트를 얻기 위한 단서를 찾고 있습니다. 어떤 주문이라도 "
"극대화할 수 있고 어떤 마법이라도 저항을 뚫을 수 있도록 만드는 로드랍니다! 물론 그것을 얻는게 쉽지는 않겠지만, 최선을 다해볼겠습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0008_Text
msgctxt "d72e69ca-5e03-4b81-a909-303ba13d95b0"
msgid ""
"\"You showed up and revealed your hand so easily... What's the real reason "
"behind that? I could have you thrown in prison, you know...\""
msgstr ""
"\"제 발로 찾아와서 그렇게 쉽게 패를 보이다니... 그런 짓을 한 진짜 이유가 뭐지? 내가 널 감옥에 던져 넣을 수도 있었잖아, 너도 "
"알다시피...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0013_Text
msgctxt "009b8633-1d21-4ff4-9873-702c92b18600"
msgid "\"Let's discuss this 'exquisite' item you can get only for me.\""
msgstr "\"네가 나에게 줄 수 있는 '특별한 것'에 대해 논의해볼까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0017_Text
msgctxt "60765185-26f7-4ab0-b4a3-ff51e162cc33"
msgid ""
"\"If you need to borrow money to pay your partner, I can help you out.\""
msgstr "\"네 파트너에게 지불할 돈이 필요하면 도와줄 수 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0019_Text
msgctxt "9af6b5fe-b2d2-42dc-b4bd-9e3a0d0032aa"
msgid "\"Here are your gemstones.\""
msgstr "\"여기 보석 받아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0021_Text
msgctxt "a45753e5-6cf7-43bd-805c-9e8b5553eb7d"
msgid "\"Tell me about yourself.\""
msgstr "\"너에 대해 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0022_Text
msgctxt "f95aa58f-8d6d-4a44-af98-24a9a0924baf"
msgid "\"I have to go.\""
msgstr "\"난 가야만 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0024_Text
msgctxt "852f3527-4fd8-41ac-9b2d-b380a221cb99"
msgid "\"How are things going in the shop?\""
msgstr "\"가게는 잘 돌아가고 있어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0026_Text
msgctxt "ac316787-f304-4db9-8996-bf62985501fe"
msgid "\"Can I buy something from you right now?\""
msgstr "\"물건을 살 수 있을까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0028_Text
msgctxt "4e180141-ba44-464e-bd22-8569890dbd75"
msgid "\"Describe Lidika so I can find her.\""
msgstr "\"리디카가 어떻게 생겼는지 말해줘. 내가 그녀를 찾을 수 있도록.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0034_AlignmentShift.Description
msgctxt "ecea6d67-2527-4de6-85de-c5448759231c"
msgid "Refused to kill a unicorn for a rare ingredient."
msgstr "희귀한 재료를 위해 유니콘을 죽이는 것을 반대한다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0034_Text
msgctxt "3599b7ab-a5e6-4138-90a7-b7187fb68409"
msgid ""
"\"I'm not killing a good-hearted, sapient being for some magical trinket!\""
msgstr "\"난 마법물품을 위해 선한 마음을 가진 존재를 해치지 않을 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0035_AlignmentShift.Description
msgctxt "4bc1d15c-d55f-4839-81b5-9c6b417e5b85"
msgid "Agreed to kill a unicorn for a rare ingredient."
msgstr "희귀한 재료를 위해 유니콘을 죽이는 것에 대해 동의하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0035_Text
msgctxt "a5cafea7-15b4-4522-bc0a-29179e1f75a1"
msgid "\"Very well, Irlene, I'll do it. Where can I find the unicorn?\""
msgstr "\"좋아. 하겠어. 어디서 유니콘을 찾을 수 있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0036_Text
msgctxt "1d34c842-776c-4ed6-9a06-996d089a253d"
msgid "\"Why don't you do it yourself?\""
msgstr "\"그 일은 네 스스로 하는 게 어때?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0040_Text
msgctxt "0ff9b5ce-e215-4b40-b2c3-afc13cc829ab"
msgid ""
"\"Here's the unicorn's horn. I hope your partner can be trusted to carry out "
"his part of the deal.\""
msgstr "\"여기 유니콘의 뿔이 있어. 너의 파트너가 계약에서 자신의 본분을 완수하길 빌어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0042_AlignmentShift.Description
msgctxt "2ac25616-e182-45d0-bc89-59f0ff61dd4e"
msgid "Promised to get a unicorn horn for Irlene."
msgstr "얼린에게 유니콘의 뿔을 구해줄 것을 약속했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Answer_0042_Text
msgctxt "87aa3a53-ee85-472f-8523-ebcae7ca86d8"
msgid ""
"\"I won't track down and hunt a unicorn, but I'll bring you a unicorn horn "
"if I ever come across one.\""
msgstr "\"난 유니콘을 추적하거나 사냥하지 않을 거야. 하지만 구하게 된다면, 유니콘의 뿔을 네게 가져다 주겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0005_Text
msgctxt "1bc590f5-2e2b-4689-a879-67fce2028af6"
msgid ""
"\"Greetings, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! It's an "
"honor to have you here. Now I can deliver all kinds of magical rarities for "
"you from all across {g|Golarion}Golarion{/g}! You may order something "
"specific, if you so choose, or I can act of my own accord! As I said, "
"nothing is impossible.\" {n}Irlene gives you a cheerful wink.{/n}"
msgstr ""
"\"안녕하십니까, {mf|영주님|영주님|전하|전하}! 여기 들러주시다니 영광입니다. 이제 {g|Golarion}골라리온{/g} 전역에서 "
"당신에게 드릴 희귀한 마법 물품들을 조달할 수 있습니다! 원하시는 종류의 물품을 주문하실 수도, 제 뜻에 맡기실 수도 있습니다. 제가 "
"말씀드렸듯이, 불가능한 것은 없으니까요.\" {n}얼린은 깜찍하게 윙크합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0007_Text
msgctxt "6ef5702d-ee77-4ae7-9db2-8d71557a610f"
msgid ""
"\"How can I serve you, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}?\""
msgstr "\"어떻게 도와드릴까요, {mf|영주님|영주님|전하|전하}?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0009_Text
msgctxt "ce4b4124-7993-4d68-b637-76dd85fc9268"
msgid ""
"{n}Irlene shakes her head.{/n} \"Nothing escapes your eye, {mf|Your Grace|"
"Your Grace|Your Highness|Your Highness}. The truth is that it was worth the "
"risk. Our... contract is as profitable for me as it is for you. Royal favor "
"is the best insurance against the mob of enemies I've made over my years of "
"traveling. I'd rather have {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness} as a friend than hire a bunch of bodyguards!\""
msgstr ""
"{n}얼린이 고개를 젓습니다.{/n} \"당신의 눈을 벗어날 수는 없습니다, {mf|영주님|영주님|전하|전하}. 진실은 언제나 위험을 "
"동반하는 법이지요. 우리... 계약은 서로에게 이득입니다. 공식적인 호의야말로 제가 여행하며 만난 적들에 대항할 최선의 보험인 셈이지요. "
"경호원을 한 무더기 고용하는 대신 {mf|영주님을|영주님을|전하를|전하를} 친구로 삼는게 낫지 않겠습니까!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0014_Text
msgctxt "ffb753d3-71b4-4c75-b0a0-6e91a7c4ed24"
msgid ""
"{n}Irlene clasps her hands in frustration.{/n} \"Oh, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}, this is so embarrassing! I'd love to, "
"but there's something...\""
msgstr ""
"{n}얼린은 당황해하며 손뼉을 칩니다.{/n} \"아, {mf|영주님|영주님|전하|전하}, 참으로 당황스럽군요! 저도 그러고싶지만, "
"걸리는 부분이 있답니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0015_Text
msgctxt "8f89df84-ed19-42de-bd11-1316a5acfd0a"
msgid ""
"\"I have an associate, shall we say. Name's Ollie. He's a human — my gopher. "
"Long legs, strong. He was due back with payment for a fat contract three "
"days ago. I have a feeling that something happened to him... or worse, that "
"he fled with my money, which was promised as a down payment to my partner "
"for that rarity I was procuring for you.\""
msgstr ""
"\"동료가 있어요. 이름은 올리. 그는 인간이지요. 다리도 길고 힘도 세요. 그는 삼일 전에 계약금을 지불하고 돌아오기로 되어있었습니다. "
"그에게 무슨 일이 일어난 것 같아요. 좋지 않은 쪽으로 말이예요. 당신한테 전달해주려던 희귀한 보물에 대한 계약금으로 내 파트너에게 "
"지불해야하는 돈을 훔쳐 달아난 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0016_Text
msgctxt "1dac8211-080d-4c89-94be-4194055dbc8e"
msgid ""
"\"Ollie has the chest of gemstones stashed somewhere near the southern "
"border. Without that, we're never getting your relic.\" {n}Irlene pauses a "
"moment.{/n} \"Why, if someone could find Ollie... maybe visit his family at "
"{g|Lake Silverstep}Lake Silverstep{/g} or talk to his wife Lidika... No, it "
"doesn't feel right to request this of you, {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}.\""
msgstr ""
"\"올리는 보석상자를 남쪽 국경 어딘가에다가 숨겨뒀습니다. 그게 없다면, 유물을 가져다드릴 수 없을 거예요.\" {n}얼린은 잠시 "
"멈춥니다.{/n} \"만약 누군가 올리를 찾았다면... {g|Lake Silverstep}실버스텝 호수{/g}에 있는 그의 가족을 "
"방문하거나 그의 아내인 리디카를 만나야 합니다... 아니, 이걸 당신에게 부탁하기엔 좀 적절치 않은 거 같군요. "
"{mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0018_Text
msgctxt "de890cdb-fd0a-45df-961a-d66c04dc74dd"
msgid ""
"{n}Irlene shakes her head.{/n} \"I wish it were so easy, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}. These aren't ordinary coins we're "
"talking about. These are genuine gemstones, suitable for crafting magical "
"items. I've been looking for them for so long... and traded quite a valuable "
"piece for them...\""
msgstr ""
"{n}얼린은 고개를 흔듭니다.{/n} \"쉬운 결정은 아니었겠죠. 그건 평범한 돈이 아니었으니까. 마법 물품을 만들기 위한 재료였습니다. "
"오랫동안 찾았는데... 아주 비싼 값을 지불했는데...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0020_Text
msgctxt "e2dda390-196f-45eb-b987-325e05239f34"
msgid ""
"{n}Irlene grabs the chest, counts the gemstones, and sighs in relief.{/n} "
"\"None are missing. What a relief! Rest assured, now I can strike a deal "
"with my new partner. Come back in a week. I'm sure I'll have good news for "
"you by then.\""
msgstr ""
"{n}얼린은 궤짝의 보석의 개수를 세고는 안도의 한숨을 쉽니다.{/n} \"하나도 사라지지 않았군요. 다행입니다! 이제 새로운 파트너와 "
"계약을 할 수 있겠어요. 일주일 뒤에 돌아와주십시오. 좋은 소식을 들을 수 있을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0023_Text
msgctxt "7ae6fa16-2952-40ce-8c74-7dd3405c7934"
msgid ""
"{n}Irlene tut-tuts.{/n} \"I really don't think this is necessary, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}. You're such a good {race}! I "
"don't feel like pulling the wool over your eyes. However, I'm afraid you "
"won't believe my stories without at least a little wool there to smooth "
"things over!\""
msgstr ""
"{n}얼린은 불평합니다.{/n} \"이게 필요한 거 같진 않군요, {mf|영주님|영주님|전하|전하}. 참으로 좋은 {race}이셔요! "
"당신을 속이려는 건 아니었습니다. 하지만 조금 과장하지 않으면 당신이 제 말을 들어주지 않을 것 같았습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0025_Text
msgctxt "0e14e325-bdd3-4679-9916-c3ed2cd91ef6"
msgid ""
"\"Very well! Couldn't be better! You know, there are so many magical trinket "
"hunters in your lands! They want to grab everything, be it expensive bric-à-"
"brac or a sophisticated professional tool! But don't you worry! Whatever "
"orders I receive, yours always come first.\""
msgstr ""
"\"좋아요! 최곱니다! 알겠지만, 이 땅엔 마법 장신구를 노리는 사냥꾼들이 참으로 많지요! 놈들은 돈이 된다면 비싼 장식품에서 복잡한 "
"전문 도구까지 모조리 쓸어갑니다! 하지만 걱정하지 마세요! 제가 어떤 주문을 받든, 언제나 당신이 가장 먼저니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0027_Text
msgctxt "38e62ec1-7789-4eb6-949c-89f595d9d009"
msgid ""
"\"Sorry to disappoint you. Everything I have in the shop has been ordered "
"individually. That's how I do things.\""
msgstr "\"실망시켜서 미안해요. 가게의 모든 물건이 다 예약된 거라서요. 전 원래 이렇게 한답니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0029_Text
msgctxt "3cfdaaf9-1a93-46d1-be31-686ac8259aba"
msgid ""
"\"How would I know what she looks like? I never paid attention when Ollie "
"talked about his family. Adorable, charming kids, his wife always waiting by "
"the water for him to return from adventures... Yuck.\""
msgstr ""
"\"그녀가 어떻게 생겼는지 내가 어떻게 알겠어요? 올리가 자기 가족에 대해 말해 줄 때 귀 기울여본 적이 없어서. 토끼 같은 자식과 예쁜 "
"아내가 기다리고 있다나... 으유.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0030_Text
msgctxt "6d9d28b6-119a-4ec2-ae71-2c5f4064a6c6"
msgid ""
"{n}Irlene looks at you with hesitation and almost fear.{/n} \"Greetings, {mf|"
"Your Grace|Your Grace|Your Highness|Your Highness}... You've... come to "
"fetch your order, right? So, here's the thing...\""
msgstr ""
"{n}얼린은 거의 공포에 가까울 정도로 주저하며 당신을 쳐다봅니다.{/n} \"반갑습니다, {mf|영주님|영주님|전하|전하}... "
"뭔가... 필요해서 오신 거 맞죠? 그래서인데, 여기 문제가 좀 있습니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0031_Text
msgctxt "fa5f10a0-0471-4aa9-9a71-ca4dbd8c0111"
msgid ""
"\"I sent the gemstones to my partner, as we agreed. Now it turns out it's "
"not enough! He wants something else from the {g|Stolen Lands}Stolen Lands{/g}"
"! You see, magic artifact gatherers need... extremely rare ingredients, at "
"times. Such as... such as unicorn's horn.\""
msgstr ""
"\"내 파트너에게 보석을 보냈습니다. 근데 그걸로도 충분하지 않다네요! {g|Stolen Lands}도둑맞은 땅{/g}에서 구할 수 있는 "
"뭔가가 더 필요하다더군요! 마법 유물 수집가들이 원하는... 특별하고 귀한 재료들이 말이예요. 뭐랄까... 유니콘 뿔 같은 거.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0032_Text
msgctxt "f0f2e5b2-5699-4bae-9721-02c868be93f0"
msgid ""
"\"These animals are rare. They don't come along very often. And many people "
"consider killing them for their horns to be pretty bad, because of their "
"intelligence... You're not someone to be stopped by petty superstition, are "
"you?\""
msgstr ""
"\"이 동물들은 희귀해요. 자주 모습을 드러내지 않지요. 많은 사람들이 뿔을 얻기 위해 그 동물을 죽이는 게 나쁜 짓이라고 생각하고 "
"있습니다만... 하지만 당신은 그런 미신따윈 믿지 않겠죠?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0037_Text
msgctxt "c7a2dd3a-4719-4a5f-bec6-8fbc9d3fbe91"
msgid ""
"\"I'm afraid I'm not much of a hunter, {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}. It'd skewer me on its horn in a flash! You're our "
"best shot.\""
msgstr ""
"\"저는 사냥꾼이 아닙니다, {mf|영주님|영주님|전하|전하}. 순식간에 절 뿔로 꿰어버릴 겁니다! 당신만이 상대할 수 있죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0038_Text
msgctxt "ac60edd9-2759-4d37-b8b1-c3ec5f0bf332"
msgid ""
"{n}Irlene smiles wryly.{/n} \"Just as you say, {mf|Your Grace|Your Grace|"
"Your Highness|Your Highness}. It's a shame, though. We were almost there.\""
msgstr ""
"{n}얼린은 얼굴을 뒤틀며 어색한 미소를 짓습니다.{/n} \"원하시는 대로, {mf|영주님|영주님|전하|전하}. 참으로 안타깝군요. "
"우리가 거의 다 왔는데 말이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0039_Text
msgctxt "e13d9eb5-cd17-41fb-baf3-aeafd87bfe95"
msgid ""
"{n}Irlene rubs her hands.{/n} \"It's so nice doing business with you, {mf|"
"Your Grace|Your Grace|Your Highness|Your Highness}. Regarding the unicorn's "
"whereabouts... Try tracking it down in the {g|Narlmarches}Narlmarches{/g}. I "
"hear it's been seen there.\""
msgstr ""
"{n}얼린은 그녀의 손을 문지른다.{/n} \"{mf|영주님과|영주님과|전하와|전하와} 거래하게 되서 기쁩니다. 유니콘이 어디있는 가에 "
"대해선... {g|Narlmarches}날마치{/g}에서 흔적을 찾아보세요. 유니콘이 그곳에 있다고 들었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0041_Text
msgctxt "230da11a-76ca-4bff-9464-9106f44ae792"
msgid ""
"{n}Irlene regards the unicorn's horn with admiration.{/n} \"Oh my... I never "
"hoped to hold such a rarity in my hands! Thank you, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}. I'm sure we can make it this time. I'll "
"keep you abreast of our progress.\""
msgstr ""
"{n}얼린은 경탄하며 유니콘의 뿔을 다룹니다.{/n} \"오, 내가 이런 희귀한 것을 손으로 쥐어보게 될지는 꿈에도 몰랐어요. "
"감사합니다. {mf|영주님|영주님|전하|전하}. 우린 제 시간에 만들 수 있을 거예요. 당신에게 진행 상황을 알리도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Main_Dialogue/Cue_0043_Text
msgctxt "173fc8a5-c58f-483a-83c2-110d94acbb02"
msgid ""
"{n}Irlene smiles sadly.{/n} \"Just as you say, {mf|Your Grace|Your Grace|"
"Your Highness|Your Highness}. We look to have a long wait before us, I think."
"\""
msgstr ""
"{n}얼린이 슬프게 미소짓습니다.{/n} \"말씀하신 대로, {mf|영주님|영주님|전하|전하}. 오래 기다려야 하실 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/UnicornFey/Fey_Bark1_String
msgctxt "6f7e022e-7f02-43f1-9328-7465d3ac0f91"
msgid "\"Hey! Leave our friend alone!\""
msgstr "\"이봐! 우리 친구는 내버려둬!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/UnicornFey/Fey_Bark2_String
msgctxt "5a59d6db-7b5d-42a9-aaac-94ba569a4343"
msgid "\"Go away! Go away!\""
msgstr "\"저리가! 저리가!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Answer_0002_Text
msgctxt "0994959c-7626-4f94-b588-463c0eab79f8"
msgid "\"Were you crying? May I help you?\""
msgstr "\"울고 있는 거니? 내가 도와줄 일이 있을까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Answer_0003_Text
msgctxt "5dfe6d37-40f8-4016-87f8-3d48e6815f2a"
msgid "\"Do you know Lidika? She lives in this village.\""
msgstr "\"리디카를 알아? 그녀는 이 마을에 살고 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Answer_0004_Text
msgctxt "8efde16d-6899-4e7e-a4ab-cb97e78f6239"
msgid "\"I have to go.\""
msgstr "\"난 가야만 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Answer_0009_Text
msgctxt "68a39800-0c99-444a-9c3a-fc0716b64218"
msgid ""
"\"Irlene sent me. She's looking for Ollie, and she said you might know where "
"to find him.\""
msgstr "\"얼린이 나를 보냈어. 그녀는 올리를 찾고 있고 네가 그의 소식을 알 거라고 했지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Answer_0012_AlignmentShift.Description
msgctxt "5015d5b8-c305-47e3-8067-c74276c31759"
msgid "Gave priceless gems to the widow of the courier."
msgstr "귀중한 보석을 과부에게 넘긴다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Answer_0012_Text
msgctxt "ef750174-49a2-4528-90ce-15b08cf69c04"
msgid ""
"[Give away the chest of gemstones] \"I found it on Ollie's body. I'm sure "
"he'd want his family to have it.\""
msgstr "[보석 상자를 넘깁니다] \"올리의 시체에서 이걸 찾았어. 가족이 가지고 있는 게 나아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Answer_0014_Text
msgctxt "438a4948-0ae7-426e-b81a-dd9c80aec90a"
msgid "\"I found Ollie's body. I'm so sorry.\""
msgstr "\"올리가 죽었어. 유감이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Answer_0016_Text
msgctxt "dbf7da35-6800-4c9a-9331-9f6005a10934"
msgid "[Let Lidika go]"
msgstr "[리디카를 보냅니다]"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Answer_0017_AlignmentShift.Description
msgctxt "b7ea5f66-dd2c-4655-9f6a-f097a161f211"
msgid "Granted a pension to the poor widow."
msgstr "가난한 과부에게 작은 집을 하사한다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Answer_0017_Text
msgctxt "cdf563ba-0015-4f3f-aa42-0360cb828a3e"
msgid ""
"\"The {mf|barony|barony|kingdom|kingdom} will support you, now that you've "
"lost your provider.\""
msgstr "\"돈을 벌어다 줄 남편이 없으니 내가 도와주지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Answer_0018_AlignmentShift.Description
msgctxt "f8e50905-a339-4f2e-8ccb-4ce43ef8e025"
msgid "Gave money to the poor widow."
msgstr "가난한 과부에게 돈을 준다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Answer_0018_Text
msgctxt "91ecbc7a-ebc2-4efc-b9fd-c9645d2007be"
msgid "\"Please, accept this money. It should last you for a while.\""
msgstr "\"제발 이 돈을 받아주시오. 당분간은 생활할 수 있을 거요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Barks/Widow_GemboxOrPension_String
msgctxt "cca5c7f2-3931-4f47-ae69-b6485c74839a"
msgid ""
"\"Thank you, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. Now our "
"kids will be all right.\""
msgstr "\"감사합니다, {mf|영주님|영주님|전하|전하}. 이제 우리 아이들은 무사할 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Barks/Widow_Money_String
msgctxt "3db97953-b7f0-4ca6-b53b-f34890accdbf"
msgid ""
"\"Thank you, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. We'll "
"manage... We'll survive through this.\""
msgstr "\"감사합니다, {mf|영주님|영주님|전하|전하}. 열심히... 열심히 살겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Cue_0001_Text
msgctxt "29e28b88-a587-4bad-a62b-67fac3dfcb2e"
msgid ""
"{n}A woman with dark circles under her eyes watches you anxiously as you "
"approach. When you come closer, she bows.{/n} \"Greetings, {mf|Your Grace|"
"Your Grace|Your Highness|Your Highness}!\""
msgstr ""
"{n}눈 밑이 잔뜩 그늘진 한 여자가 당신이 다가오자 불안한 표정으로 당신을 지켜본다. 당신이 가까이 오자, 그녀는 고개를 숙인다.{/n}"
" \"안녕하세요. {mf|영주님|영주님|전하|전하}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Cue_0006_Text
msgctxt "82b35e38-66c7-41bc-beeb-c7e5ac4391a9"
msgid "\"Yes, {mf|Your Grace|Your Grace|Your Highness|Your Highness}?\""
msgstr "\"네, {mf|영주님|영주님|전하|전하}?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Cue_0007_Text
msgctxt "7923979f-d6b1-46d7-b65e-2c8bee128f7d"
msgid ""
"\"If only you could track down and punish my lost husband, the bastard! Oh, "
"pardon my language, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. "
"I lost my temper. You see, Ollie, my husband, left on business a few days "
"ago, and he's disappeared. I'm just so angry! And a little scared...\""
msgstr ""
"\"실종된 남편 놈을 찾아서 벌을 주세요, 개자식 같으니! 오. 죄송합니다. 화가 나서 그만. 남편 올리는 며칠 전 사업으로 떠나고는 "
"오지 않았어요. 얼마나 화가 나던지! 겁도 나고...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Cue_0008_Text
msgctxt "502ff46d-c3a5-450b-89b9-e175a1a97f51"
msgid ""
"\"I'm Lidika. Has something happened? Something... Do you know something "
"about my husband?\" {n}The woman's voice rings with fear and anxiety.{/n}"
msgstr ""
"\"제가 리디카에요. 무슨 일 있나요? 뭔가... 내 남편에 대해 뭔가 알고 있는게 있으신가요?\" {n}여성의 목소리는 걱정으로 "
"가득합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Cue_0010_Text
msgctxt "838cb5c2-fd7e-4982-8b70-42bebbf9813a"
msgid ""
"\"{d|Irlena}Irlene{/d}! That greedy witch!\" {n}Lidika stomps her foot.{/n} "
"\"It was her who sent my Ollie on that mission! If not for her, my husband "
"wouldn't have dreamed of becoming rich! He wouldn't be slaving away for some "
"wench! She's been using him as a packhorse, always ordering him to deliver "
"all kinds of stuff. I have no idea what her deal was, but I can feel it in "
"my bones — no ordinary goods need to bypass guards and highroads in their "
"delivery!\""
msgstr ""
"\"{d|Irlena}얼린{/d}! 그 욕심 많은 마녀 년이!\" {n}리디카는 발을 구릅니다.{/n} \"올리를 보낸 자가 바로 그 "
"여자에요! 그녀가 아니었다면 제 남편은 부자가 될 꿈도 꾸지 않았을 텐데! 그를 짐말처럼 부려놓고 온갖 물건들을 배달을 시켰어요. 그녀가 "
"무슨 생각을 하는지 모르겠지만 저는 뼛 속까지 느낄 수 있어요. 배달하는데 경비대와 대로를 피해야 할 필요가 있는 걸 보면 그건 평범한 "
"물건들이 아니에요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Cue_0011_Text
msgctxt "5df3ce61-8eed-441a-aecd-345fa8cb39b8"
msgid ""
"\"I don't know where Ollie is. I've been racking my brain for what could "
"have happened! He mentioned he was going to the southern border to grab "
"something from some cleft. He said it was a desolate location, and that the "
"package was safe there... Guess it turns out it wasn't safe, after all!\" {n}"
"Lidika starts crying.{/n} \"He widowed me and orphaned our two children! "
"He's gone, he's dead, I can feel it! He would never just leave us to starve!"
"\""
msgstr ""
"\"올리가 어디에 있는지 모르겠어요. 무슨 일이 일어났는지 별에 별 생각이 다 들었어요! 남편은 남쪽 국경의 절벽으로 가서 무언가를 "
"가지러 간다고 했어요. 외진 곳이고 그곳에 물건이 안전하게 있다면서... 하지만 결코 안전하지 않은 곳이었죠!\" {n}리디카는 울기 "
"시작합니다.{/n} \"저는 과부가 되고 우리 아이들은 고아가 되었어요! 그이는 가버렸어요, 죽었어요, 전 알아요! 그이는 우리를 "
"버려두고 그냥 굶겨 죽일 사람이 아니에요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Cue_0013_Text
msgctxt "fb6413e6-218d-4c1b-bef3-3006fb7870af"
msgid ""
"\"Oh... This... This is a fortune! The cursed fortune that ruined my poor "
"husband! If it weren't for the kids, I wouldn't even touch them...\" {n}"
"Lidika wipes her face with a sleeve and smiles wearily.{/n} \"Thank you, {mf|"
"Your Grace|Your Grace|Your Highness|Your Highness}. You saved us, I swear "
"you did.\""
msgstr ""
"\"오... 이건... 저주 받은 돈이야! 내 남편을 앗아간 돈! 아이들만 아니었다면 손도 대지 않았을 텐데...\" {n}리디카는 "
"눈물을 닦고 약한 미소를 짓습니다.{/n} \"고마워요, {mf|영주님|영주님|전하|전하}. 당신이 우리를 구했어요. 정말로요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Cue_0015_Text
msgctxt "eca0e4e2-3b3b-4371-9ad9-30094738f254"
msgid ""
"{n}Lidika stares at you for a few moments, as if not understanding what you "
"just said. Then she buries her face in her palms and turns away.{/n}"
msgstr "{n}리디카는 이해하지 못한 듯 잠시 당신을 봅니다. 그리고는 얼굴을 손바닥으로 감싸고 등을 돌립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Cue_0019_Text
msgctxt "9eaaae35-0e47-40c6-ae7e-388638fa7fb9"
msgid ""
"{n}Lidika wipes the tears from her eyes. Her whisper is barely audible.{/n} "
"\"Thank you.\""
msgstr "{n}리디카는 눈물을 닦습니다. 그녀의 말소리가 거의 들리지 않습니다.{/n} \"고마워요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HalflingFemale_ShadytraderNE/Widow/Cue_0020_Text
msgctxt "7f02781b-ca98-40c5-8824-2e212cb684f6"
msgid ""
"{n}Lidika blinks away the tears and looks at you in astonishment.{/n} \"Th"
"... Thank you, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! Thank "
"you for not letting our children starve! And me... I'm nothing without my "
"Ollie...\""
msgstr ""
"{n}리디카는 눈물을 닦고는 놀라서 당신을 봅니다.{/n} \"고... 고마워요. 우리 아이들을 먹일 수 있겠어요! 그리고 저는... "
"올리 없이 어떻게 살아야 할까요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Answer_0005_Text
msgctxt "41a1c299-98dc-4155-a375-18efc9ce766d"
msgid "\"Jubilost is a renowned scholar and author. Talk to him.\""
msgstr "\"주빌로스트는 유명한 학자이자 작가이지. 그에게 말해봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Answer_0006_Text
msgctxt "15208538-8da5-4f1b-8e85-9d3295dc20de"
msgid "\"Linzi loves stories. You can talk to her.\""
msgstr "\"린지가 이야기를 좋아하지. 그녀와 이야기해봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Answer_0007_Text
msgctxt "dbda3e45-7d6e-411b-8469-0cea96de691a"
msgid "\"And so we meet. What next?\""
msgstr "\"그래. 우리는 만나게됐군. 그럼 이제 어떻게되는거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Answer_0016_Text
msgctxt "9792d4a7-6042-4975-a932-234a5b789cc5"
msgid "\"Who are you?\""
msgstr "\"너는 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Answer_0017_Text
msgctxt "1716a70b-8042-41c1-9003-8b248ed53b78"
msgid "\"I need to go.\""
msgstr "\"이만 가봐야겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Answer_0037_Text
msgctxt "09a09b37-655c-4dfe-9508-208e5e21c66b"
msgid "[Remain silent]"
msgstr "[아무 말도 안 합니다]"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Answer_0038_Text
msgctxt "844dc092-df0b-437e-b7f5-f4be04524e16"
msgid "\"Your story is truly incredible, Shaynih'a.\""
msgstr "\"믿을 수 없을 만큼 좋은 이야기가 아니라, 그냥 믿을 수 없는 이야기 같은데. 샤이니아\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Answer_0039_Text
msgctxt "a1447a4c-7a3f-42b0-a21e-4a8f535a7c5a"
msgid "\"I believe you, Shaynih'a!\""
msgstr "\"나는 네 이야기를 믿어. 샤이니아!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Answer_0044_Text
msgctxt "d542362d-6a16-4a18-8a12-f100144177c1"
msgid "\"I'm sorry, but I have to go!\""
msgstr "\"미안. 나는 이제 가봐야 해!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Answer_0045_Text
msgctxt "cec5b587-ec70-4c2f-9758-9225d38729a6"
msgid "[Listen to the story]"
msgstr "[이야기에 귀 기울입니다]"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Barks/Shai_idle_bark1_String
msgctxt "37111350-5a37-4f54-9826-65108a77ff83"
msgid "\"Greetings, o worthy one!\""
msgstr "\"안녕하신지요, 오 존귀하신 분이여!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Barks/Shai_idle_bark2_String
msgctxt "7442967b-a848-416f-bd83-86b71fa22aea"
msgid "\"The locals are kind and warm-hearted. But also impatient.\""
msgstr "\"주민들이 친절하군. 하지만 참을성이 없기도 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Barks/Shai_idle_bark3_String
msgctxt "fb9f589b-a0b4-471c-8a67-4515ff695c69"
msgid "\"Perhaps, it is my destiny to be an owlbear trainer? Or a painter?\""
msgstr "\"아마도. 아울베어 조련사가 되는 게 내 운명인가? 아니면 그림쟁이?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0001_Text
msgctxt "13fa07d4-0857-48bc-9057-b703ba33361c"
msgid ""
"{n}A young woman catches your eye. She looks like she has come from far "
"away. She approaches with a dancing gait and addresses you, speaking in an "
"unfamiliar drawl.{/n} \"May the Perfect Human protect you! I am happy to "
"meet you, o worthy one.\""
msgstr ""
"{n}한 젊은 여성이 당신의 눈길을 끕니다. 그녀는 먼 곳에서 온 것 같습니다. 그녀는 춤을 추듯 당신에게 오더니 특이한 억양으로 "
"말합니다.{/n} \"완벽한 인간께서 당신을 보호하기를! 당신을 만나게되어 기쁩니다, 오 존귀하신 분이시여.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0002_Text
msgctxt "52c9a12f-8146-4975-9c16-343015770d74"
msgid ""
"{n}Shaynih'a notices you and smiles broadly.{/n} \"Destiny has brought us "
"together once more, o worthy one! This is no mere coincidence! The Perfect "
"Human is telling us that our paths are deeply intertwined, like snakes "
"coiling around each other in an act of love!\""
msgstr ""
"{n}샤이니아는 미소를 지으며 당신을 봅니다.{/n} \"오 존귀하신 분이시여, 운명이 우리를 다시 만나게 했군요! 이건 필연이죠! "
"완벽한 인간께서 저희의 길이 마치 몸을 섞으며 서로 엉킨 뱀처럼 깊이 엮여있다고 말씀하셨어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0010_Text
msgctxt "1e30fc1b-54c7-4a4b-8584-16dd4e4c8348"
msgid ""
"\"Perhaps I chose wrongly when I decided to become a muse. Until I can "
"answer this question, I shall remain true to the calling I've always pursued "
"— weaponsmithing. If, in your kindness, you could indulge me once more, and "
"grant me a workshop in these lands – then I swear to you, I shall make for "
"you truly miraculous weapons, the likes of which these lands have never "
"seen! But for now, let me tell you a story that our conversation reminded me "
"of...\""
msgstr ""
"\"아마도 제가 시인이 되기로 결정한건 잘못된 결정이었던것 같습니다. 저 스스로 이 질문에 대답할 수 있을 때까지는, 저는 제가 항상 "
"추구해온 소명에 진실하게 남아있도록 해야 겠어요, 무기 제작자 말입니다. 만약, 당신께서 친절을 베풀어 저를 또 한 번 받아주실 수 "
"있다면, 그리고 이 지역에 저를 위한 공방을 만들어주실 수 있다면 – 약속드리죠, 당신을 위해 이 땅에서 한번도 보지 못했을 위대한 "
"무기를 만들어드리겠습니다! 하지만 지금은, 저희 대화에서 떠오른 이야기 하나를 들려드릴게요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0011_Text
msgctxt "a84bf025-90da-4d2f-baa0-2a62b7ca4637"
msgid ""
"\"Ah! Let us see, then, how learned this man truly is! I hope this esteemed "
"opium inhaler will enthrall me with the depth of his knowledge and the "
"richness of his verse!\""
msgstr ""
"\"아! 그러면, 이 사람이 진정으로 무엇을 배웠는지 보시죠! 저는 이 존경받는 마약 중독자가 그의 지식의 깊이와 언어의 방대함으로 제 "
"마음을 사로잡길 바랍니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0012_Text
msgctxt "ea1b0d92-115e-41b6-87c5-f1601040c41d"
msgid ""
"\"I am grateful, o worthy one! I shall relate to you the story of my "
"ancestor Vu Balak. Let us see if she is nimble enough to write it all down "
"without omitting any of the colorful details!\""
msgstr ""
"\"감사합니다. 가치있는 자여! 내 조상 부 발락의 이야기를 들려드리겠습니다. 화려한 내용까지 하나도 빼놓지 않고 모두 적어낼 만큼 "
"영리한지 한번 볼께요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0013_Text
msgctxt "68956574-cd36-4e3e-91cd-27f52384743a"
msgid ""
"\"You, o worthy one, can help me find my calling. I am beset by doubt — what "
"if, by choosing the path of a master smith, I am making a terrible mistake? "
"After all, I, Shaynih'a the Tulip, have seen many wonders, the likes of "
"which your humble realm has never heard of. And I wish to recount them. But "
"alas, I cannot write in your language! For this reason I require a writer, "
"and a worthy one!\""
msgstr ""
"\"오 존귀하신 분이여, 나의 소명을 찾도록 당신이 날 도와줄 수 있습니다. 나는 고민에 사로잡혀 있거든요. 만약 내가 직업으로 "
"대장장이의 길을 선택하는건, 끔찍한 실수가 아닌지 말이지요. 어쨋든 나, 샤이니아 더 튤립은 많은 경이로운 것들을 보았어요. 당신의 "
"소박한 왕국은 들어보지 못한 그런 것들이지요. 그리고 이제 내가 본 것들을 이야기로 전해주고 싶어요. 하지만 나는 당신들의 글을 쓸 수 "
"없어요! 이런 이유로 작가 한명과 존귀한 당신께서 나를 도와주기를 부탁하는겁니다.!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0018_Text
msgctxt "68f697d8-988a-4948-8fe7-24eee9394fe0"
msgid ""
"\"I am a traveler from the Impossible Kingdoms of Vudra! I was led here by "
"the will of the gods, by my love of amazing adventures, and by the promise "
"of inescapable retribution uttered by my former husband, who has since "
"become a revered sage and a dead man. I never doubted that my path would "
"bring me to a most worthy ruler, one who would help me. — And now you stand "
"before me!\""
msgstr ""
"\"저는 부드라 왕국에서 온 여행자입니다! 저는 신들의 의지, 놀라운 모험들에 대한 제 사랑 그리고 현자이자 지금은 죽은 전 남편이 "
"내뱉은 피할 수 없는 보복의 약속으로 인해 이곳으로 오게되었어요. 제가 가는 길이 이 땅의 가장 존귀한 통치자이자 저를 도와줄 분에게로 "
"인도해 줄 것이라는 것을 한순간도 의심한 적이 없었어요. 그리고 이제 이렇게 당신이 제 앞에 서있네요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0019_Text
msgctxt "a65fe941-e7ca-498e-843e-9c2a720bcff5"
msgid ""
"\"Go, o worthy one! Our paths shall cross again, for that is the will of the "
"gods!\""
msgstr "\"가세요 가치있는 자여! 우리의 길은 다시 교차될 겁니다. 그건 신의 의지에요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0020_Text
msgctxt "a200e5d0-b2e7-41d9-811f-382faef369ea"
msgid ""
"\"My name is Shaynih'a, but you may simply call me the Tulip, as all the "
"best of my friends do! Ever since the sun rose today, I've had a feeling "
"that I shall take part in a grand encounter — one that shall change our "
"fates forever! And, lo, it is so. Praised be the Perfect Human for this gift "
"he has bestowed upon these eyes that see the future!\""
msgstr ""
"\"제 이름은 샤이니아입니다. 하지만 절 튤립이라고 불러줘요! 제 친구들은 다들 그렇게 부르거든. 오늘 해가 뜬 이후로 우리의 운명을 "
"바꿔줄 만남을 가질 거라는 사실을 직감하고 있었어요.그리고 이제 정말 그렇게 되었네요. 나의 두 눈에 미래를 볼 수있는 능력을 내려주신 "
"완벽한 인간을 찬양하라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0021_Text
msgctxt "acea4fd2-6e0a-4f06-8fb0-791cb70c1302"
msgid ""
"\"I have witnessed master Chokhek cover emptiness in tattoos, and a human "
"grew out of them, for these patterns were so intricate and deep that the ink "
"became more important than the flesh. Trust me, for I have woven the tale of "
"these events myself! Perhaps I have been destined to become the muse of a "
"great writer! If, o worthy one, you find a suitable scribe for me, I shall "
"pay you back handsomely with my wisdom and advice!\""
msgstr ""
"\"전 초크헤크 스승님께서 문신으로 공허함을 메우는 모습을 보게되었는데 그 문신에서 한 인간이 자라나게 되었어요. 이유는 이 문신의 "
"무늬들은 너무나 깊고 복잡해서 잉크가 살보다 더 중요해졌기 때문입니다. 어때요? 저는 이 이야기를 직접 만들었어요. 아마도 나는 위대한 "
"작가에게 영감을 주는 뮤즈가 될 운명인 것 같죠! 오 존귀하신 분이여, 저에게 맞는 작가 한 명만 찾아준다면, 저는 제 지혜와 조언으로 "
"후하게 갚겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0022_Text
msgctxt "08d7d790-f76f-4315-bb13-19a3dfb42e9b"
msgid ""
"\"At a feast, Mahka once swallowed a whole tiger and the beast's rage and "
"hunger burned in his veins – until, consumed by it, he ate himself. Years "
"went by, and a young prince by the name of Purusav Vagbha destroyed Mahka's "
"empire, slaying all of his generals. For Purusav was a reincarnation of "
"Mahka, bent on restoring the empire to its true glory. Eventually, Purusav "
"was defeated in battle and his empire died with him, but it was Mahka "
"Abihcara who spawned the terrible race of rakshasa – cunning beasts, half "
"human and half animal. Trust me, for I have met these creatures many times!\""
msgstr ""
"\"한 연회에서, 마흐카는 호랑이 한 마리를 통째로 삼켰어요. 호랑이가 느낀 분노와 허기가 마흐카의 혈관에 타고 들어 갔지요. 그 분노에 "
"사로잡힌 마흐카는 자기 자신을 먹어치워 버렸답니다. 세월이 지나, 푸루사브 바그바라는 이름을 가진 젊은 왕자가 등장해요. 푸루사브는 "
"마흐카의 제국을 멸망시키며 마흐카의 장군을 모두 사살했지요. 그런데 이 푸루사브는 사실 마흐카의 환생으로, 다시 한번 제국의 황금기를 "
"가져올 음모를 꾸미고 있었답니다. 그러나 푸루사브는 전투에서 패했고, 제국은 두 번째로 멸망을 맞이했죠. 락샤샤의 기원을 말하려면 꼭 이 "
"얘기를 해야 한답니다. 락샤샤는 마흐카가 낳은 교활한 반인반수 종족이거든요. 저를 믿으세요. 저는 이 생물들을 여러 번 만나봤으니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0023_Text
msgctxt "17e39f90-ced8-4876-ba71-e15973764b84"
msgid ""
"\"Mahka always dreamed of leaving a mark on the world. And he did, but not "
"in the way he expected. It was not on the battlefield that his name became "
"immortalized, but in bed, surrounded by concubines. Each may be mistaken in "
"choosing their own path, even the wisest of all! Perhaps I am destined to be "
"your advisor, o most worthy one? Or your lover? Go now, for I need to be "
"alone to think upon my words.\""
msgstr ""
"\"마흐카는 항상 세상에 흔적을 남기는 꿈을 꾸었지요. 결국 그는 해냈지만 그가 기대한 방식은 아니었어요. 그의 이름이 불멸의 존재가 된 "
"것은, 전쟁터가 아니라 후궁들에게 둘러쌓인 침대였지. 결국, 각자 자신의 길을 선택한다는 것 자체가 잘못된 것일지도 몰라. 심지어 가장 "
"현명한 자의 선택일지라도 말이야! 아마도 저는 당신의 조언가가 될 운명인 걸까요, 오 가장 존귀하신 분이여? 아니면 당신의 연인? 이제 "
"가세요. 저는 이 말을 혼자서 생각해 볼 필요가 있겠어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0024_Text
msgctxt "0e8735f8-427a-4061-a6df-7fa3b178ba54"
msgid ""
"\"I greet you, o most worthy opiumist! I have heard much of your wisdom. "
"Now, lend me your ears, and I shall tell you a story that…\""
msgstr "\"반갑구나! 네 지혜에 대해서는 많이 들었어. 자, 이제 귀를 빌려줘. 이제부터 내 이야기를 들려줄게...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0025_Text
msgctxt "ca803c5d-b408-4a50-b1e9-0f5a2d637c28"
msgid ""
"\"I greet you, young Linzi! They say that you are writing a book. That is "
"most fortunate, for I can embellish it with a few stories that I have lived "
"through during my adventures! Once I met a monk from the House of "
"Perfection. He was an ascetic, and hadn't eaten for four whole years...\""
msgstr ""
"\"반갑구나. 린지! 네가 책을 쓰고있다고 들었어. 정말 다행이다. 내가 모험을 하면서 겪은 이야기들로 너의 책을 꾸며줄 수 있거든! "
"한번은 완벽함의 집에서 수도사를 한번 만난 적이 있어. 그는 금욕주의자였고, 4년 내내 한 끼도 먹지 않았지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0026_Text
#. Speaker : Jubilost_Companion
msgctxt "b5aff198-f7c8-4996-9568-9a9b7e1f34ea"
msgid ""
"\"Just a moment! Why on earth do you call me an opiumist?! Who came up with "
"that?!\""
msgstr "\"잠깐만! 내 얘기에 관해서 많이 들었다고? 도대체 무슨 얘기를 들은 거야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0027_Text
msgctxt "10794a16-d333-4485-a666-92f84aa5f2fc"
msgid ""
"\"Ermm, isn't every learned man supposed to be an opiumist? Back in Vudra, I "
"met many noble and illustrious scholars. Each and every one of them inhaled "
"the smoke of opium, so as to lose his mind, that the surrounding world with "
"its lowly impulses would not distract him from his scientific endeavors. I "
"have noticed how empty your eyes are, and...\""
msgstr ""
"\"음. 똑똑한 사람들은 원래 그런거 아닌가? 부드라에서 귀족 철학자를 많이 만났어. 모두 똑똑한 척을 하니까 가끔은 멍청해지더라고. "
"그들 눈이 멍해지는 모습을 볼 때 얼마나 멍청해 보이던지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0028_Text
#. Speaker : Jubilost_Companion
msgctxt "3fa3c363-2e02-4e50-a456-5b41c7f82929"
msgid ""
"\"Never have I inhaled anything, nor do I intend to. And I find it highly "
"unlikely that a whole caste of intellectuals would willingly expose "
"themselves to such substances in order to lose their minds!\""
msgstr "\"나는 멍청한 짓은 한 적이 없어. 그런 녀석들은 머리가 비었으니까 똑똑한 척 하려는 거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0029_Text
msgctxt "d1be9325-ff0e-47c0-96c9-38b3bfab2967"
msgid ""
"\"It is as true as the fact that the fastest black genies can outrun light "
"beams, thus evading the touch of the sun, which is fatal to them. Trust me, "
"for I have seen this with my own eyes!\""
msgstr "\"가장 빠른 검은 지니는 빛보다 빨라서 그들에게 치명적인 햇빛도 피해 간다고 해! 정말이야. 진짜 봤다니까!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0030_Text
#. Speaker : Jubilost_Companion
msgctxt "464c380c-3f78-4548-8e78-723c1eaa309e"
msgid ""
"\"It seems to me that you are spinning these wild tales on the go. I very "
"much doubt they have anything to do with your actual travels. I have no "
"interest in such things.\" {n}Jubilost turns his back in anger.{/n}"
msgstr ""
"\"내가 보기에는 네가 이야기를 지어내는 것 같은데. 정말 네 이야기가 모험과 관련이 있는 건지 의심스러워. 나는 관심도 없지만...\" "
"{n}주빌로스트는 화가 나서 등을 돌립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0031_Text
#. Speaker : Linzi_Companion
msgctxt "a5ac9a02-ce1b-4458-b0f3-046ddc643240"
msgid ""
"\"Hold on, four years? Are you sure that he ate absolutely nothing? Maybe it "
"was, well, you know, some sort of moderate fasting? More like a diet? Like "
"when you do eat, but only a little bit…\""
msgstr ""
"\"잠깐. 4년? 정말 아무것도 안 먹었은게 확실해? 어쩌면, 음, 알잖아 그왜, 적당한 단식 같은 건가? 다이어트 같은 건가? 식단 "
"조절하듯이 말이지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0032_Text
msgctxt "6e4ab7e4-78e8-4a22-bffe-767db051c9db"
msgid ""
"\"No no no, why would you think that? Breaking his askesis would have been a "
"shameful weakness! He did not eat at all. The people revered him as a pious "
"and enlightened man, whose spirit was very strong. But I, as soon as I met "
"him, suspected that he might be a liar! So I decided to expose him for what "
"he truly was. I...\""
msgstr ""
"\"아니야. 아니야. 왜 그렇게 생각하지? 먹는 것은 자신이 약한 모습을 보여 주는 거야! 그는 아무것도 먹지 않았어. 사람들은 그를 "
"경건하고 깨우친 사람으로 추앙하였는데, 그의 정신은 매우 강했어. 하지만 나는 그를 만나자마자 혹시 거짓말쟁이가 아닐까 의심했어! 그래서 "
"나는 그의 진실한 모습을 폭로하기로 결심했다. 나는...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0033_Text
#. Speaker : Linzi_Companion
msgctxt "2b91fd27-3702-47de-ae6b-270c38ca1bca"
msgid ""
"\"Wait a moment. Four years?! That's impossible! If I skip breakfast and "
"dinner, my stomach hurts so badly I can't even walk! It's really hard to "
"believe that the monk could spend a whole four years like…\""
msgstr ""
"\"잠깐. 4년이라고?! 그건 불가능해! 내가 아침 저녁을 굶으면 위장이 얼마나 아픈데! 걷지도 못 할 지경이지. 4년 동안 먹지 "
"않았다니 정말 믿기질 않아...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0034_Text
msgctxt "2d2131b9-3210-47d1-8074-a56fa5f3715c"
msgid ""
"\"Young Linzi, by paying attention to such unimportant details, you run the "
"risk of missing the heart of the matter! As I was saying, I decided to bring "
"the monk's dishonesty to light. I enlisted the services of a shaitan who "
"owed me a favor. This earth genie stood in front of the monk and sang a "
"song. And that very moment, the hermit's face twitched, and a stream of "
"stones erupted from his mouth! Imagine this — he had swallowed rocks to fill "
"up his stomach, to save himself the pangs of hunger!\""
msgstr ""
"\"린지. 불필요한 것에 주의를 기울이니 중요한 내용을 놓치고 있어! 방금 나는 수도승이 거짓말했다는 걸 밝히기로 했다고 얘기했잖아. "
"나에게 빚이 있는 샤이탄에게 부탁해서, 땅의 지니가 그 수도승 앞에 나와 노래를 부르게했지. 그 순간 이 수도승의 얼굴이 꿈틀대더니 "
"입에서 돌이 쏟아져 나왔어! 상상해봐. 그는 배를 채우기 위해, 배고픔을 참기위해 돌을 삼켰던 거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0035_Text
#. Speaker : Linzi_Companion
msgctxt "a01b93d6-6a8c-4639-87e0-2eb6cce61350"
msgid ""
"\"Mmm…He swallowed enough stones to fill his stomach? And lived? And never "
"had to eat again? As far as I know, it doesn't work like that… Of course, "
"I'll write down your story. But I doubt it will enjoy much success. It's "
"just… too incredible for our provincial audience!\" {n}With a guilty smile, "
"Linzi turns away.{/n}"
msgstr ""
"\"음... 배를 채우려고 돌을 삼켰다고? 그런데 살았다고? 그리고는 아무것도 먹지 않았어? 그렇게 될 리가 없는데... 너의 이야기는 "
"적을게. 하지만 이게 재밌을지는 모르겠어. 그냥... 허무맹랑한 이야기야!\" {n}미안한 듯 미소를 지으며 린지는 등을 돌립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0040_Text
msgctxt "3826ab80-a9d2-436a-b1de-c357da78f565"
msgid ""
"\"I thank you, o worthy one! It is such a shame that your path is the path "
"of a ruler, and not that of a wordsmith!\""
msgstr "\"고마워요! 오 존귀하신 분이여! 당신의 길이 작가의 길이 아니라 통치자의 길이라니 안타깝군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0041_Text
msgctxt "e8b53a97-c929-427e-8ed1-2e0fd699eefc"
msgid ""
"\"Hm… Perhaps I'm not as good at telling stories as I thought. After all, "
"putting the events of the past into words is not quite the same thing as "
"witnessing them!\""
msgstr ""
"\"흠... 아마도 저는 생각보다 이야기하는 것에 재능이 없는 것 같아요. 결국 과거의 목격한 사건들을 말로 바꿔서 이야기하는 게 "
"생각처럼 쉽지는 않네요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/FirstMeeting_HumanFemaleExoticSmith/Cue_0046_Text
msgctxt "3ef4535c-ef45-4835-8df4-99a3a33d16e4"
msgid ""
"\"This truthful story was divined for me by a woman who had eyes on the "
"palms of her hands. Once upon a time, the sorcerer Mahka Abihcara decided to "
"become immortal. He started living his life with such purpose and "
"determination, that his essence would be imprinted on all of his future "
"incarnations. Mahka studied the arts and became a great conqueror. He "
"consumed the flesh of his enemies and servants to gain their strength.\""
msgstr ""
"\"이 진실된 이야기는 손바닥에 눈이 달린 여자에 의해 저에게 계시되었습니다. 한 때, 마흐카 아비카라라는 마법사가 불멸의 존재가 되기로 "
"결심했어. 그는 자신의 본질은 앞으로 일어날 모든 미래의 생애에 새겨질것이라 믿고 그것을 목표로 살아가기 시작했어요. 마흐카는 기예들을 "
"습득했고 위대한 정복자가 되었지요. 그는 그의 적들과 종들의 힘을 얻기위해 그들의 살을 섭취했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0004_Text
msgctxt "96843b63-bba8-4a52-82a4-32e8adc62990"
msgid "[Lie] \"Hassuf was delighted to read your letter.\""
msgstr "[거짓말] \"하수프가 네 편지를 읽고 기뻐하더군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0005_Text
msgctxt "0155286c-f003-4641-b1d1-c4e4d46df0e5"
msgid ""
"[Tell the truth] \"Hassuf tore the letter into shreds, all the while cursing "
"your family.\""
msgstr "[진실을 말합니다] \"하수프가 편지를 찢어 조각내었어. 네 가족을 저주하면서.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0006_Text
msgctxt "3f511188-378f-4462-9b4c-3f1a884d6d8b"
msgid "\"What sort of help do you need?\""
msgstr "\"무슨 도움이 필요하지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0007_Text
msgctxt "67aa4bf0-20ef-4c0e-adda-c5a01cacf76b"
msgid "\"I would like to know more about you.\""
msgstr "\"너에 대해 좀더 알고 싶어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0008_Text
msgctxt "43f22baf-c3ea-4e37-8e24-5a3ebc8c90b9"
msgid "\"I have to go.\""
msgstr "\"이만 가봐야겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0009_Text
msgctxt "48f410d4-86ce-47cb-99f6-52a08717399e"
msgid "\"What happened this time?\""
msgstr "\"이번엔 무슨 일이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0010_Text
msgctxt "36bb9a0d-3aba-4779-ae71-8ec2db48d585"
msgid ""
"[Tell the truth] \"The Storyteller has seen that your ancestor was a coward "
"and a failure, not a hero. I am sorry.\""
msgstr "[진실을 말합니다] \"이야기꾼이 네 조상은 겁쟁이에 패배자였다고 하더군. 영웅이 아니야. 미안해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0011_Text
msgctxt "526caf12-135c-402f-bd56-ebb1f57b49f5"
msgid ""
"[Lie] \"The Storyteller told me that your ancestor was a hero. However, he "
"does not know where to seek the monster's heart.\""
msgstr "[거짓말] \"이야기꾼이 네 조상은 영웅이었다고 했어. 하지만 그는 괴물의 심장을 어디서 찾아야 할지 몰랐어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0027_Text
msgctxt "1f3f9b0a-1863-4f28-9a69-88007619f1b0"
msgid "\"How did you end up here?\""
msgstr "\"어떻게 여기에 오게 되었지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0028_Text
msgctxt "24d1949a-68a0-4e47-9866-ab83cb57fced"
msgid "\"You were a ruler?\""
msgstr "\"너는 지배자인가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0029_Text
msgctxt "3dcfd794-623e-4525-a685-db4603f484d6"
msgid "\"Tell me of your homeland.\""
msgstr "\"네 고향에 대해 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0030_Text
msgctxt "87f7184b-d49c-448b-be00-afa59da5eb60"
msgid ""
"\"It seems to me there are quite a few… exaggerations in your stories.\""
msgstr "\"네 이야기는... 조금 과장된 부분이 있는 거 같아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0035_Text
msgctxt "6400f46a-d650-4ddc-afb5-e7d60b92106f"
msgid "\"Do you enjoy living in my lands?\""
msgstr "\"내 땅은 마음에 드나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0037_Text
msgctxt "c17a1a0a-b50a-40fc-b212-3586ca8ff71f"
msgid "\"At times, you are insolent towards me.\""
msgstr "\"가끔 나에게 버릇 없이 말하는것 같군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0039_Text
msgctxt "2dc83155-75ca-4b6d-b2fa-fb31c5b98644"
msgid ""
"\"You've talked about the treasures of your homeland. How would one go about "
"trying to find them?\""
msgstr "\"네 고향의 보물에 대해 말해주었어. 그런데 그것들을 어떻게 찾을 수 있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0066_Text
msgctxt "b96685ac-7970-42c3-90c2-a4f68cf620cd"
msgid "\"Tell me of Vudra.\""
msgstr "\"부드라에 대해 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0068_Text
msgctxt "57f43851-709f-483e-b644-2e89213250ab"
msgid "\"Let's talk of your homeland some other time.\""
msgstr "\"네 고향에 대해 언젠가는 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0069_Text
msgctxt "6a9eb89f-5691-4afc-91b2-9c0a31289578"
msgid "\"Let's do this another time.\""
msgstr "\"이거 다음 기회에 하던가 하자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0072_Text
msgctxt "a62c1c5a-8df1-4b11-b12e-1804a820f9cc"
msgid "\"I'd like to listen to your story some other time.\""
msgstr "\"언제 다른 기회에 네 이야기를 듣는게 좋겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0075_Text
msgctxt "a40c4dd4-2d2e-45f3-82a3-9b223d085a35"
msgid "\"No, not now. Maybe later.\""
msgstr "\"아니. 지금말고. 다음에.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0079_Text
msgctxt "e40cec20-5a59-412c-8dbf-7ea7b100f684"
msgid "[Keep listening no matter what]"
msgstr "[계속해서 침묵합니다]"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0080_Text
msgctxt "a55b5e35-e0b8-40f0-8092-e941058f882b"
msgid "\"I can't go on. That's enough.\""
msgstr "\"그럴 수 없어. 그만.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0082_Text
msgctxt "16a5a6ce-6e09-42a0-8584-422f09b50db7"
msgid ""
"\"I think you haven't finished your story… The one about the genie-binder.\""
msgstr "\"아직 네 이야기가 끝나지 않은 것 같아... 지니에 관한 이야기야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0083_Text
msgctxt "93de3b58-6545-4816-a27e-47dd4350f8f0"
msgid "\"You wanted to tell me a story. I'm all ears.\""
msgstr "\"나에게 이야기를 하고 싶었다고. 들어주지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0084_Text
msgctxt "4b7301b2-58a1-40b0-a45e-18a9f23feac2"
msgid ""
"\"You wanted to tell me something about a spear and one of your ancestors.\""
msgstr "\"너는 어떤 창과 네 조상에 관해 이야기하고 싶다고 했어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0087_Text
msgctxt "6117720d-4355-4eef-9571-d0f082d04c19"
msgid "\"Ahem… Let's change the subject.\""
msgstr "\"에헴... 주제를 바꿔보지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0090_Text
msgctxt "f8f2a0fc-2544-4786-ad6a-90a70ed9e537"
msgid "\"That's more than enough, I can see where this is going.\""
msgstr "\"그정도면 충분해. 이게 지금 어디로 흘러가는지 알 것 같아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0093_Text
msgctxt "1b7eb6db-f464-434d-8c17-9b05847fe07d"
msgid "\"Oh no. Please, stop.\""
msgstr "\"아니야. 멈춰.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0095_Text
msgctxt "2e982166-2339-4c55-8a62-21000ff0c8c2"
msgid "\"Very interesting. Let's talk about something else.\""
msgstr "\"정말 흥미롭군. 그래?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Answer_0098_Text
msgctxt "9fafe613-5f93-404a-b165-7be831f13dbb"
msgid "\"A simple 'yes' would have sufficed.\""
msgstr "\"그렇다는 대답으로 충분해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0001_Text
msgctxt "1124e10b-08f5-423a-9bdf-b7e1927bef5f"
msgid ""
"\"{d|Shainiha}Shaynih'a{/d} is happy to see you, o most worthy one! Rest "
"your legs and listen to my stories – that is, if you've nothing more "
"important to do… such as assisting me in a delicate situation...\" {n}"
"Shaynih'a gives you a sly wink.{/n}"
msgstr ""
"\"{d|Shainiha}샤이니아{/d}가 당신은 반깁니다, 가장 가치있는 분이시여! 어디 편히 앉아서 제 이야기를 들어주세요 – "
"당신께서 중요한 일이 없다면요... 이를테면, 미묘한 상황에 봉착한 저를 돕는다던지...\" {n}샤이니아는 당신에게 교활한 윙크를 "
"합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0002_Text
msgctxt "d745c0aa-4444-48a8-9782-137853559100"
msgid ""
"\"I am pleased to see you again, o worthy one. What brings you to "
"{d|Shainiha}me{/d}?\""
msgstr "\"다시 보게 되어 기쁩니다, 오 존귀하신 분이시여. 무슨 일로 {d|Shainiha}저를{/d} 찾아오셨나요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0012_Text
msgctxt "a45a5846-9457-47a3-af1a-71afd0c7f642"
msgid ""
"{n}The Vudrani proffers a small scroll.{/n} \"This was written by my father. "
"It was meant for a family that has lived for centuries, near the home of my "
"relatives in Absalom. Life has scattered us all across Golarion, but we "
"never gave up hope of reuniting with those we once knew so well. My father "
"asked me to pass this letter to a member of this fine family, if I should "
"ever happen to stumble across one.\""
msgstr ""
"{n}그 부드라인은 작은 스크롤을 보여 줍니다.{/n} \"이것은 제 아버지가 작성하셨습니다. 저희 가족이 압살롬에서 친척과 수세기를 "
"살아왔다는 의미입니다. 삶이 저희 가족을 골라리온 전역으로 흩어놓았지만, 한 때 매우 친밀했던 우리가 다시 재회 할 수 있을거란 희망을 "
"저버리지 않았죠. 아버지께선 우연히라도 그 좋은 가족 중 하나를 만나게 되면 이 편지를 그 사람에게 전달해달라 하셨습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0013_Text
msgctxt "96b7e5cc-17d9-4093-9949-1ca8617aa056"
msgid ""
"{n}Shaynih'a peers at you in surprise, but her melodious words come off her "
"lips effortlessly:{/n} \"He wasn't pleased? How sad… This reminds me of a "
"story that took place a long, long time ago. Please, let me enlighten you, o "
"worthy one…\""
msgstr ""
"{n}샤이니아는 놀라서 당신을 봤지만, 마치 선율같은 그녀의 말들은 쉽게 그녀의 입술 밖으로 나왔습니다.{/n} \"그가 기뻐하지 "
"않았다고요? 저런... 그 소식을 들으니 옛날 옛적의 이야기가 하나 떠오르네요. 가치있는 분이시여, 제가 당신을 깨우치게끔 "
"허락해주세요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0014_Text
msgctxt "a143c0ab-abe6-42fe-b14b-d4a05a78139d"
msgid ""
"{n}Shaynih'a smiles joyfully.{/n} \"I knew that wise Hassuf would be most "
"pleased to receive news from home. All of this reminds me of a wonderful "
"story, one that took place a long, long time ago…\""
msgstr ""
"{n}샤이니아는 즐겁게 웃습니다.{/n} \"현명한 하수프가 고향에서 온 소식을 들으면 기뻐할 거란 걸 알고 있었습니다. 이 모든 것이 "
"옛날 옛적에 일어난 놀라운 이야기를 떠오르게 하네요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0015_Text
msgctxt "0993d357-ebec-4039-93f8-ac2d56bfbc97"
msgid ""
"\"There once lived a mighty warrior by the name of Khorkhor. His mother was "
"a white shark, and his father the most lustful – and most inventive – of all "
"mortals. Khorkhor inherited his fearlessness from his father, and from his "
"mother his strength and thirst for blood. His skin was as white as milk, and "
"his sharp, crooked teeth grew in three rows. There wasn't a warrior in the "
"world who was stronger or more warlike, and he served the Maharaja loyally.\""
msgstr ""
"\"한때 코르코르라는 이름을 가진 강력한 전사가 살았습니다. 그의 어머니는 백상아리였고, 아버지는 모든 인간 중에서 가장 정욕적이면서도 "
"창의적이었죠. 코르코르는 아버지로부터 대담무쌍함을, 어머니로부터 그의 강인함과 피에 대한 갈증을 물려받았어요. 그의 피부는 우유처럼 "
"하얗고, 날카롭고 구부러진 이빨은 세 줄로 자랐습니다. 이 세상에 그보다 더 강하거나 더 호전적인 전사는 없었고, 또한 마하라자를 "
"충성스럽게 섬겼답니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0016_Text
msgctxt "41460195-6607-41f8-a038-330275eea0b7"
msgid ""
"\"This story teaches us that however long and difficult the most worthy path "
"may be, happiness, honor and triumph always lie at the end of it. Our family "
"has feuded with the Hassuf for many centuries. Many of his kinsmen were "
"slain by our hand. Once we'd destroyed almost all of them, but we gained "
"wisdom and sought a truce. I am glad that this news brought joy to the wise "
"Hassuf, for he was noble enough to recognize suffering as a sign of "
"enlightenment, for which we work so tirelessly, in doing both good and evil. "
"Go now, o worthy one, for my heart has gained peace, and my mind attained "
"clarity, which is so important to a true master.\""
msgstr ""
"\"이 이야기는 가장 가치있는 길은 아무리 길고 험난하더라도 결국 그 끝에 행복, 영광, 그리고 승리가 있다는 걸 알려준답니다. 저희 "
"가문은 수 세기 동안 하수프와 다퉜습니다. 그의 많은 친족이 저희의 손에 죽었죠. 한 때 저희는 그들을 모두 없애버릴 뻔했지만, 저희는 "
"지혜를 얻고 휴전을 했습니다. 이 소식이 현명한 하수프를 기쁘게 해서 저도 좋아요. 그는 고난이 깨달음의 표시라는걸 잘 알정도로 "
"고귀하며, 저희는 선과 악 모두를 행함에 있어 지칠 줄 모르니까요. 이제 가셔도 됩니다, 가치있는 분이시여. 제 마음이 드디어 평화를 "
"찾았고, 제 생각이 명확히 정리되었습니다. 이건 진정한 장인이 되기 위해서 중요한겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0017_Text
msgctxt "0ef4b53f-943e-4c3c-a63f-8fc3a634db61"
msgid ""
"\"As you can see, both honor and disgrace may live in the same body, even "
"though it may belong to a person of worth. Why then cannot my family's deeds "
"be both honorable and disgraceful at the same time? Yes, my kinsmen have "
"spilled much blood, trying to destroy Hassuf's family, but it was also they "
"who first decided to seek out peace. I am grateful that I have been able to "
"fulfill my duty no matter the price. Go now, o worthy one, for my heart has "
"gained peace, and my mind attained clarity, which is so important to a true "
"master.\""
msgstr ""
"\"당신께서도 보셨다시피, 명예와 불명예는 같은 육신에 깃들 수 있습니다, 심지어는 가치있는 사람이라도 말이죠. 그러면 어째서 저희 "
"가문이 행한 일은 동시에 명예로울수도 불명예스러울수도 없을까요? 맞습니다, 제 친족은 하수프의 가문을 멸망시키기 위해 너무 많은 피를 "
"뿌렸습니다, 하지만 처음으로 평화를 찾고자 제안한 것 또한 저희 가문이죠. 어떤 대가를 치르더라도 제 의무를 수행할 수 있게 되어서 "
"기쁩니다. 이제 가셔도 됩니다, 가치있는 분이시여. 제 마음이 드디어 평화를 찾았고, 제 생각이 명확히 정리되었습니다. 이건 진정한 "
"장인이 되기 위해서는 정말 중요한겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0018_Text
msgctxt "5003cf22-2f79-4a1e-b057-1bd461076cc0"
msgid ""
"{n}Shaynih'a hands you a heavily worn piece of metal.{/n} \"I have heard, o "
"worthy one, that there lives a Storyteller in your realm, whose eyes can see "
"into the memories of things. Please, show him this. It was the tip of a "
"spear that once belonged to my esteemed ancestor Vu Balak. He was fated to "
"live in interesting times, for it was then that Kothogaz, the Dance of "
"Disharmony, Spawn of Rovagug, attacked Vudra. A million Vudrani came out to "
"fight him, and amongst them was the cleric Vu Balak.\""
msgstr ""
"{n}샤이니아는 상당히 닳은 쇳조각을 당신에게 건넵니다.{/n} \"오 존귀하신 분이시여, 당신의 영토에 사는 이야기꾼이라는 사람이 "
"물건의 기억을 볼 수 있다는 소문을 들었습니다. 부탁드리건데, 이것을 그에게 보여주셨으면 합니다. 이것은 저의 조상이신 부 발락이 쓰셨던 "
"창의 조각이죠. 그는 로바거그의 자식 중 하나인 불협화음의 춤 코소가즈가 부드라를 공격하던 때 살았습니다. 수백만 명의 부드라인들이 그와 "
"싸웠으며, 성직자 부 발락도 그 중 하나였습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0019_Text
msgctxt "42ed7c3b-04b0-4dcd-8811-6fd28223e5f2"
msgid ""
"{n}The Vudrani frowns, but then her face lightens, and a smile crosses her "
"lips.{/n} \"This is not news that I expected to hear. And still, is this "
"news all that bad? For it means that I need not sail back to Vudra, but may "
"instead continue my work here. This reminds me of a story...\""
msgstr ""
"{n}그 부드라인은 얼굴을 찡그렸지만, 그녀의 얼굴은 다시 밝아졌고, 이내 미소를 짓습니다.{/n} \"제가 듣고 싶었던 소식은 "
"아니었네요. 하지만, 그게 진짜 나쁜 소식일까요? 이제 부드라로 돌아갈 필요도 없어졌고, 대신 이곳에서 제 작업을 계속할 수 있다는 "
"뜻이니까요. 이야기 하나가 떠오르네요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0020_Text
msgctxt "5d56b66a-da62-43df-b225-bba3fab9685b"
msgid ""
"\"Hm… Perhaps, I was wrong. The Perfect Human has sent the Storyteller to "
"remind us all of the great purpose that we have each been given. I must not "
"leave for Vudra to seek the shards of the heart of Kothogaz. I must follow "
"my chosen path. I shall recount to you a tale that is well-suited to the "
"occasion.\""
msgstr ""
"\"흠... 아마도 제가 틀렸나봐요. 완벽한 인간께서 저희 각자에게 주어진 사명을 상기시키시기 위해서 이야기꾼을 보내신 것 같습니다. "
"코소가즈의 심장 조각을 찾으러 부드라로 돌아갈 필요가 없어졌군요. 저는 제가 선택한 길을 계속 따르겠습니다. 이 상황에 걸맞은 이야기를 "
"하나 들려 드리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0021_Text
msgctxt "6848ffbd-3267-4547-87ff-d500bcdf5d06"
msgid ""
"\"Maharajah Khiben-Sald etched his glorious name in history when he "
"conquered the kingdoms of the genies. He spied on the descendants of the "
"goddess Janasini, the Garuda, and saw how they charmed snakes by playing "
"their flutes. Through these secrets, he discovered a way to charm and bind "
"the genie to his will. Khiben-Sald openly declared his new mastery for all "
"to hear, and in doing so insulted their race. Emissaries from the vizier of "
"the djinni, the genie of air, came to demand an apology from the wizard – "
"only to be turned into slaves, and their bodies bound in chains. It was then "
"that the malik of the fire jinn, known as the efreet, sent his assassins. "
"They hid in a cloud of dust and approached as the mage was sleeping.\""
msgstr ""
"\"마하라자 크히벤-살드는 지니들의 왕국을 정복한 것으로 역사에 이름을 남겼습니다. 그는 가루다 여신 자나시니의 자손들을 감시했고, "
"그들이 어떻게 피리를 불어 뱀을 유혹하는지 보았죠. 그 비밀 덕분에, 그는 원하는대로 지니를 매혹하고 속박할 수 있는 방법을 "
"발견했습니다. 크히벤-살드는 자신이 배운 것을 널리 퍼뜨렸고, 그로 인해 그들 종족에게 큰 모욕을 주었어요. 공기의 지니인 진의 고관이 "
"보낸 사절들이 마법사에게 사과를 받으러 왔지만, 그들은 노예로 전락해 그들의 육신은 사슬에 묶였습니다. 그 때 이프리트라고 알려진 불의 "
"지니인 말리크가 암살자를 보냈어요. 그들은 먼지 구름 속에 숨어 잠자고 있는 마법사에게 접근했죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0022_Text
msgctxt "9a7a72b4-1cee-477a-9df2-ad2683fa491c"
msgid ""
"\"As you can see, even a mortal can accomplish such great deeds that their "
"memory shall live on longer than the palaces built by the magical genie. "
"This thought has given me the strength to create a great masterpiece, one "
"which will ensure the memory of my name.\""
msgstr ""
"\"당신께서도 보셨듯, 필멸자들조차 마법의 지니가 지은 궁궐보다 더 오래 기억되는 위업을 성취할 수 있습니다. 이 생각이 저에게, 제 "
"이름을 길이 남겨줄 위대한 걸작을 만들 힘을 주네요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0023_Text
msgctxt "15737f81-3e03-4186-b162-98eeddfe93e0"
msgid ""
"\"As you can see, your actions may be seen as valorous by some and heinous "
"by others. For it is still forbidden to utter the name of Khiben-Sald among "
"the genie, so much is it hated! Let others think of you as a villain or "
"lunatic – all that truly matters is that enlightenment and devotion to your "
"own goals blooms in your heart! It is decided. I shall continue my work on "
"my path to mastery, and will create a masterpiece which will immortalize my "
"name. May it serve you well, whether I be praised for it by your friends or "
"cursed for it by your enemies!\""
msgstr ""
"\"당신께서도 보셨다시피, 당신의 행동은 보는 이에 따라 용기있게 볼 수도 사악하게 볼 수도 있습니다. 오늘날까지도 크히벤-살드의 이름을 "
"꺼내는 것은 지니들 사이에서 금기시되고 있죠. 다른 이들이 악당이나 미친 녀석으로 생각하더라도 그냥 놔두십시오 – 진정으로 중요한 것은 "
"당신의 목표를 향한 깨달음과 헌신이 당신의 마음속에 피어났다는 점이니까요! 결정했어요. 저는 통달의 길을 따르기 위해 제 작업을 "
"계속해서, 제 이름을 영원히 남길만한 걸작을 만들겠습니다. 제가 당신의 친구들에게 찬양받거나 적들에게 저주를 받거나 신경쓰지 않고 그것을 "
"당신께 드릴게요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0024_Text
msgctxt "13140131-e61d-4207-9b20-7e23d08aba34"
msgid "\"I am flattered. Where should I begin?\""
msgstr "\"정말로 기분이 좋네요. 어디부터 시작할까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0025_Text
msgctxt "5d7f2112-076a-4cdc-af73-2b009de265ce"
msgid ""
"\"Until we meet again, o worthy one! It shall happen sooner than you think – "
"the Perfect Human has told me!\""
msgstr ""
"\"우리가 다시 만날 그날까지 안녕히,  오 존귀하신 분이시여! 그 날은 당신 생각보다 빨리 올겁니다 – 완벽한 인간께서 제게 "
"말해주셨습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0031_Text
msgctxt "e7464017-7b6b-41e0-bfc2-3cd7bd6b9bb7"
msgid ""
"\"Oh, they often say this about the Vudrani! Know then that the gods have "
"given me such lessons in humbleness, that it is quite against my nature to "
"lie and spread falsehood! Have you ever been to Niswan? It is the capital of "
"the Island of {g|Jalmeray}Jalmeray{/g}, the city of a thousand rooftops, "
"above which flutters a thousand silk banners. Not water, but the finest "
"wines flow from their magnificent jade fountains! There isn't a city more "
"beautiful in this world! But Niswan's greatest jewel is its Houses of "
"Perfection, monasteries wherein the world's finest warriors train.\""
msgstr ""
"\"오, 부드라인들은 그런 말을 자주 듣죠! 신께서 저에게 겸손함에 대해 가르치셨다는 사실을 알아주세요, 그러니 거짓말이나 거짓을 "
"퍼뜨리는 것은 저의 본성에 반하는 일이랍니다! 니스완에 가보신 적이 있나요? {g|Jalmeray}잘메레이{/g} 섬의 수도이며, 수천 "
"개의 지붕 위에 수천 개의 비단 깃발이 나부끼는 도시죠. 옥으로 만들어진 웅장한 분수에서는 물이 아니라 최고급 와인이 흘러나와요! 이 "
"세상에 그보다 더 아름다운 도시는 없겠죠! 하지만 니스완의 가장 큰 보물은 완벽함의 집이죠. 그곳은 세계 최고의 전사들이 훈련하는 "
"수도원이랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0032_Text
msgctxt "34e05a25-a989-40f7-ab9d-f54f3b74ea94"
msgid ""
"{n}Shaynih'a's eyes glisten, and her movements become so smooth it's as if "
"she's beginning to dance. It takes her a moment to stop herself.{/n} \"Vudra "
"is a land of wonders never seen in your realm. As witnessed by the ten "
"thousands lines of Mizravrtta Brahmodya, as recorded by the wise Balazastrin "
"from the words of the goddess Likha. Vudra is fifty thousand years old. That "
"means that it is far older than the rest of the world, which grew up around "
"Vudra to become its outer mantle, like shells and weeds grow upon the bottom "
"of a ship.\""
msgstr ""
"{n}샤이니아의 눈이 반짝였고, 그녀의 몸짓은 마치 춤을 추기 시작하는것 처럼 부드러워졌습니다. 그녀 스스로 멈출때까지 조금 "
"기다려야했습니다.{/n} \"부드라는 당신의 땅에서는 결코 보지 못할 놀라운 곳이죠. 미즈라브타 브라모디야에 적힌 일만 행이 증언해주며, "
"슬기로운 발라자스트린이 여신 리크하의 말씀을 기록한대로요. 부드라는 5만년의 역사를 자랑합니다. 이는 이 세계의 나머지보다 훨씬 "
"오래되었으며, 그들이 배의 하단에 자라는 조개와 해조류마냥 부드라 주위에 외피처럼 자라났다는 것을 의미하죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0033_Text
msgctxt "0765b6c4-8760-46b5-9198-553156d0862d"
msgid ""
"\"Yes, I am of the rajah caste, although I have lost all my lands.\" {n} "
"Shaynih'a speaks in a sing-song manner, as if she were reading a ballad or "
"verse.{/n} \"I once disturbed an ancient city of the dead, one that lay "
"hidden, deep in the jungle...\""
msgstr ""
"\"맞아요. 제 영토를 모두 잃었지만 저는 라자 카스트였답니다.\" {n} 샤이니아는 가곡이나 운문을 읽는 것처럼 노래하듯 "
"이야기했습니다.{/n} \"한 때 정글 깊은 곳에 숨겨진, 죽은 자의 고대 도시를 공격한 적이 있죠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0034_Text
msgctxt "b8b4ceaa-3aa0-49c1-873f-5055db509444"
msgid ""
"\"Have you heard of Rudrakavala? High in the Vudrani mountains lies the "
"Adhaarm monastery. Its monks are pious and devout, their duty is to feed a "
"dead man whose green-skinned body floats over a black metal altar as he "
"meditates. Back when Rudrakavala was alive, he was the vilest of the "
"rakshasa. However, one day he stepped upon a river bank and became a seeker "
"of truth. And thus he stood for a thousand years, unmoved...\""
msgstr ""
"\"루드라카발라라고 들어보신 적이 있나요? 부드라의 산 위에는 아다함 수도원이 있어요. 그곳의 수도승들은 독실하고 경건하며, 그들의 "
"임무는 명상하면서 흑철 제단 위로 떠오르는 초록색 피부의 죽은 남자에게 먹이를 주는 일이었죠. 루드라카발라가 살아있을 때, 그는 락샤사 "
"중 가장 사악한 존재였답니다. 하지만, 어느 날 그는 강둑 위에 올라가 진실을 탐구하는 사람이 되었어요. 그 후 그는 움직이지 않고 "
"천년을 서있었고...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0036_Text
msgctxt "c59332ac-b97f-4fe8-9b1c-057494f0d16b"
msgid ""
"\"This is a wondrous land! You have such strange cuisine! And kobolds? "
"Incredible creatures, we do not have them in Vudra. And those insolent "
"creatures... Squirrels! I have never seen such fierce creatures!\""
msgstr ""
"\"정말 놀라운 곳이에요! 음식들이 정말 특이하고요! 게다가 코볼트? 그것들도 놀라워요, 부드라에선 볼 수 없으니까요. 그리고 "
"버릇없는...다람쥐들! 이런 거친 생물은 전혀 본 적이 없어요!!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0038_Text
msgctxt "8e7d0782-ca2d-41e6-896a-88129e23b2a5"
msgid ""
"{n}The Vudrani stares at you in surprise.{/n} \"Insolent? I am a rajah, same "
"as you. We are equals by caste. True, I hold no power, but what does that "
"change? The sage Ulvantha told me a story. Once, he was a groom to the moon "
"herself, but he angered her with his rapturous nature, and was expelled from "
"the plane of Nirvana...\""
msgstr ""
"{n}부드라인이 놀란 눈으로 당신을 바라봅니다.{/n} \"오만하다고요? 저 또한 당신과 같은 라자에요. 카스트로 따지면 같은 계급이죠. "
"사실 저에겐 권력이 없지만, 그렇다고 뭐가 바뀌죠? 현자 울벤타가 제게 이야기 하나를 해준 적이 있어요. 한 때, 그는 달의 "
"신랑이었지만, 그의 열광적인 본성때문에 그녀의 분노를 사서 니르바나 차원에서 쫓겨났죠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0040_Text
msgctxt "e2ab7ee7-144b-48ed-81f8-b44f78779270"
msgid ""
"{n}A sly smile crosses the Vudrani's face.{/n} \"Greed is a dangerous thing. "
"Have you ever heard of the Consortium of Aspis, o worthy one? It is the "
"union of the greediest merchants of all Cheliax. The head of the Consortium "
"in Vudra learned of an abandoned palace of the princess Chhaya, rumored to "
"be filled with fabulous riches. He hired guides and porters and set out for "
"the palace, and the treasures they found there exceeded their wildest "
"expectations – but their robbery had not gone unnoticed. They had awakened "
"an evil spirit that sped towards them, taking the form of a white cobra...\""
msgstr ""
"{n}부드라 인의 얼굴에 교활한 미소가 나타납니다.{/n} \"탐욕은 위험한 것입니다. 가치있는 분이시여, 아스피스 컨소시엄에 대해 "
"들어보신 적이 있나요? 첼리악스 전역에서 가장 욕심 많은 상인들의 단체이죠. 그 단체의 우두머리는 츠하야 공주의 외딴 궁전에 엄청난 "
"재산이 쌓여있다는 소문을 들었어요. 그는 경비와 짐꾼들을 고용해 궁전으로 향했고, 거기에서 그들이 발견한 보물들은 소문조차 초월할 정도로 "
"많았답니다 – 하지만 들키지 않고 도둑질을 끝내는 데는 실패했죠. 그들은 하얀 코브라의 모습을 한 사악한 영혼을 깨웠고, 그것은 그들에게 "
"곧장 달려들었습니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0041_Text
msgctxt "34d2748d-0302-436a-8cb0-f931c5ae8c87"
msgid ""
"\"O most worthy one! It pains me to ask of you yet another favor, yet "
"{d|Shainiha}I{/d} desperately require your aid! I fear yet again that I may "
"have made the wrong choice when I set myself upon the path of master smith! "
"A rumor has come to my ears and has upset my heart, making me doubt myself! "
"The Perfect Human has sent me a sign — a sign that shows I was fated for a "
"great undertaking! I beseech you, help me!\""
msgstr ""
"\"가장 가치있는 분이시여! 당신께 또 다른 호의를 구하는게 고통스럽습니다만, {d|Shainiha}저는{/d} 반드시 당신의 도움이 "
"필요합니다! 아직도 제가 장인의 길을 걷기로 한 것이 잘못된 선택이 아니었을까 걱정됩니다. 소문이 제 귀로 들어왔고 제 심장을 "
"화나게했으며, 저 스스로를 의심하게 만들더군요! 완벽한 인간께서 저에게 신호를 보내왔습니다 — 바로 제가 넘어서야만 할 운명을 말이죠! "
"간청드리건데, 저를 도와주세요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0042_Text
msgctxt "0044d77b-207b-4f93-a031-8ee29809b64e"
msgid ""
"\"But this land lacks order. The gods granted Vudra castes. You have none "
"here, and that is why there is no order. For when you meet a member of the "
"lowest caste, you know that they only barely deserved to be born human. In "
"their previous lives, they were animals, or maybe even a vile things like "
"kobolds, who are lower than even the lowliest beggars. Trust me, for I have "
"more than once faced their wicked nature! Whereas when you encounter a "
"member of a higher caste, be he a padaprajna warrior or a rajah as you and "
"I, that signifies that in our past lives we were pious and noble, that our "
"words were strong and true. It is that understanding that these lands lack.\""
msgstr ""
"\"하지만 이 땅에는 질서가 부족하죠. 신은 부드라에 카스트를 주었지만, 여기엔 그와 같은 질서가 없으니까요. 당신께서 가장 낮은 "
"카스트를 만나보신다면, 그들이 간신히 사람 꼴로 태어나도록 허락받았을 뿐이라는걸 알게 되실겁니다. 전생에 그들은 짐승이나 가장 비천한 "
"거지만도 못한 코볼트 같은 생물이었을 수도 있죠. 믿어보세요, 저도 그들의 비열한 본성을 많이 겪어 봤으니까요! 반면에 당신이나 저와 "
"동등한, 파다프라즈나 전사나 라자같이 높은 카스트의 사람을 만난다면, 저희는 전생에 경건하고 고귀한 삶을 살았다는 뜻이며, 저희의 말은 "
"강하고 진실되었을거란 뜻이지요. 이 땅에는 이런 부분에 대한 이해가 부족합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0043_Text
msgctxt "75c5cb54-78bb-41e0-b502-bf26c3dc8d82"
msgid "\"Of the Kingdoms of a Thousand Wonders? Where should I begin…\""
msgstr "\"천 개의 불가사의 왕국에 대해서요? 어디서부터 시작해야 할지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0044_Text
msgctxt "176af80e-06b7-441e-ac10-9ffcc91ae6cf"
msgid ""
"\"As you wish, so shall it be. I have many interesting stories for you.\""
msgstr "\"원하시는대로. 당신을 위한 흥미로운 이야기는 많으니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0045_Text
msgctxt "6965803d-e1b8-461e-88fa-1cd37ff36ee8"
msgid ""
"\"...The Aspis realized that they would pay dearly for their greed, and ran "
"as fast as they could. The foolish Vudrani who had helped them ran as well. "
"They built ships and fled their homes. Many turned to piracy, and you can "
"find them still in the Protectorate of the Black Marquis, now known as the "
"Mandagara League. Woe is the fate of thieves and outcasts! Others settled in "
"Kaer Maga in {g|Varisia}Varisia{/g}. It was they who took the pyramid-box "
"from the palace and hid it from the Consortium. This box is covered in the "
"finest oil, and carried by dead men, and inside the box lives the Child "
"Goddess.\""
msgstr ""
"\"...아스피스는 자신들의 욕심에 대한 대가를 치루었다는 것을 깨닫고, 가능한 빠르게 도망치기 시작했죠. 그들을 도왔던 멍청한 "
"부드라인도 똑같이 도망쳤어요. 그들은 배를 건조하고 고향으로 도망쳤습니다. 그들 중 많은 이들이 해적이 되었으며, 지금도 만다가라 "
"연맹으로 알려진 그들을 검은 후작의 보호령에서 찾을 수 있답니다. 도둑과 추방자들에게 남은 운명은 불행뿐이겠죠! 다른 자들은 "
"{g|Varisia}바리시아{/g}에 위치한 카에르 마가에 정착했습니다. 궁궐에서 피라미드 상자를 가져가 컨소시엄으로부터 숨긴 것 또한 "
"이들이죠. 그 상자에는 최고급 기름이 발라져있었고, 죽은 자들이 옮긴다고 하는데, 상자 안에 어린 여신이 살고있다고 하네요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0046_Text
msgctxt "68a2b90c-b419-4f1a-ad3a-d854d9953c4f"
msgid ""
"\"Trust me, for the Child Goddess spoke to me once, and foretold that you "
"and I were destined to meet! The Vudrani hope that the deity's protection "
"will save them, but it is this box that the evil spirit seeks. It has since "
"transformed into a demonic ship, and it comes into ports by night. Sailors "
"who look like crocodiles search the towns, and the ship is gone by dawn. "
"There will come a day when the ship finds Kaer Maga's port, and the Vudrani "
"will pay dearly for their greed. Vudra knows how to protect its treasures, "
"and it is best not to seek them, o worthy one.\""
msgstr ""
"\"믿어보세요, 한 번은 어린 여신께서 제게 말씀하신 적이 있어요. 그날 제가 당신과 만날 운명이란 예언을 들었죠! 부드라인들은 여신의 "
"보호를 믿었지만, 악령이 좇는 것은 바로 그 상자였어요. 악령은 이제 악마의 배로 변신해서, 밤마다 항구에 나타난답니다. 악어처럼 생긴 "
"선원이 마을을 습격하고, 여명이 밝아 오면 배를 타고 사라지죠. 언젠가 그 배가 카에르 마가의 항구를 발견하면, 부드라인들은 욕심을 부린 "
"대가를 치를 거예요. 그래도 부드라인은 보물 지키는 법을 알고 있으니, 거기 상자를 내버려 두는 게 최선이랍니다, 존경받는 분이시여.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0047_Text
msgctxt "aa56d9c6-ae9a-4119-8e4f-3660f2ea7595"
msgid ""
"\"... To ensure that he never again falls victim of his ill nature, he "
"carries with him the skull of his mortal enemy, and consults it on all "
"occasions. Trust me, for I myself have heard the words of the skull's "
"wisdom! Once, this wise man Ulvantha was heading north. However, his path "
"was blocked by the local rajah's army, who was waging war against his "
"neighbor. The soldiers were ordered not to let anyone pass. This infuriated "
"Ulvantha.\""
msgstr ""
"\"... 다시는 자신의 사악한 본성에 희생되지 않기 위해, 그는 자신의 필멸자 적의 해골을 들고다니며 어떤 상황이든 그것에게 조언을 "
"받는답니다. 믿어보세요, 저 또한 그 해골의 지혜로운 말을 들은 적이 있답니다! 한 때, 현자 울벤타는 북쪽으로 이동하고 있었죠. "
"하지만, 그가 가던 길이 이웃 나라와 전쟁을 벌이던 지역 라자의 군대에 의해 막혀있었었어요. 군인들은 누구도 통과시키지 말라는 명령을 "
"받았습니다. 이에 울벤타는 대노했죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0048_Text
msgctxt "a49c2909-e7e0-453b-8425-81b8aaf1d9e3"
msgid ""
"\"But, following the skull's advice, he did not kill them on the spot – "
"after all, the soldiers acted honorably, neither buckling to his wrath nor "
"flinching in their duty. Instead, the wise man took some rice from his bag "
"and boiled it, making an army of rice soldiers. The rice soldiers then tore "
"the rajah's men apart, while Ulvantha visited the rajah's capital. He then "
"overthrew the rajah and placed a dead whore on the throne, as a reminder "
"that power is as fleeting as life. So do not hurry to think that your "
"position of power might give you a strength that I do not posses. Only noble "
"behavior and enlightenment truly matter.\""
msgstr ""
"\"하지만, 해골의 조언에 따라, 그는 그곳에서 아무도 죽이지 않았어요 – 아무튼, 군인들은 그의 분노에 대해 무력을 쓰지도, 그들의 "
"의무를 저버리지도 않고, 명예를 따라 행동했으니까요. 대신, 현자는 가방에서 쌀 한 줌을 꺼내고 끓이더니 쌀 병정의 군대를 만들었어요. "
"쌀 병정들은 라자의 군대가 막은 길을 텄고, 그 동안 울벤타는 라자의 수도에 방문할 수 있었죠. 그 뒤 그는 권력은 삶처럼 흐르는거라는 "
"각인으로써, 라자를 끌어내리고 왕좌에 죽은 매춘부를 앉혔답니다. 그러니 당신의 권력이 제가 가질 수 없는 힘을 준다고 속단하지 마세요. "
"오직 고귀한 행위와 깨달음만이 진정한 본질이랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0049_Text
msgctxt "979c5285-fa09-420c-a42e-04e72e377cbd"
msgid ""
"\"Once the Monastery of the Unblinking Flame became jealous that the "
"Monastery of the Unfolding Wind was known as the house of the greatest "
"masters. Many turned down the invitations of the Unblinking Flame in order "
"to join their white-robed rivals. The Monastery of the Unblinking Flame "
"swore to make them pay for the insult. In the streets, the markets, and the "
"palaces, the red-clad monks would insult the white ones, provoking them to "
"bloody duels.\""
msgstr ""
"\"한 때, 꺼지지 않는 불꽃의 사원은 멈추지 않는 바람의 사원이 가장 위대한 스승들의 문파라고 알려진데 질투심을 느꼈죠. 많은 이들이 "
"경쟁자의 하얀 수도복을 입기 위해 꺼지지 않는 불꽃의 수도원의 초대를 거절했고요. 꺼지지 않는 불꽃의 사원은 그 모욕을 갚아주리라고 "
"맹세했습니다. 길거리, 시장, 그리고 궁궐에서, 붉은 복장의 수도승들은 하얀 복장을 한 이들에게 피의 결투를 신청하며 모욕했답니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0050_Text
msgctxt "40cfda39-dc2c-4332-9282-95e6d2fbfa2b"
msgid ""
"\"Niswan shook as if from an earthquake. Trust me, for I witnessed it "
"myself. In that life I was an arrogant master of the Unblinking Flame and my "
"pride demanded war. I knew that my days were numbered, and desired nothing "
"but to see the Unblinking Flame triumph. In my arrogance, I could not see "
"how much suffering I brought to the people. Those who were struck by a "
"monk's fist fell and did not rise again, and those who were touched by a "
"priest's finger were permanently crippled in body and mind. We fought with "
"honor, seeking to demonstrate our mastery, not murder our enemy – while the "
"townsfolk died by the thousands. And we did not care.\""
msgstr ""
"\"니스완은 지진이 일어난 것처럼 흔들렸어요. 믿어보세요, 제가 그 장면을 직접 목격했으니까요. 그 시절에 저는 꺼지지 않는 화염의 "
"스승이었고, 제 자존심 또한 전쟁을 요구했죠. 저는 저의 삶이 곧 끝날 것을 알고 있었고, 꺼지지 않는 불꽃의 승리를 보는 것 이외엔 "
"아무 것도 원하지 않았었죠. 저의 오만함으로 인해, 제가 사람들에게 얼마나 많은 고통을 주었는지 깨달을 수 없었어요. 한 수도승의 주먹에 "
"맞은 자들은 쓰러져서 다시는 일어나지 못했고, 한 사제의 손가락에 닿는 이들은 죽을 때까지 몸과 정신에 장애가 남았습니다. 저희는 저희 "
"문파를 떨쳐보이고자, 우리의 적들을 살해하는게 목적이 아닌 명예를 걸고 싸웠습니다 – 그동안 수천 명의 민간인들이 죽었죠. 그래도 저희는 "
"신경쓰지 않았습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0051_Text
msgctxt "b407ec11-0ac6-4f52-9606-40d58e0c5291"
msgid ""
"\"Our students, however, secretly arranged the Tournament of Unseen Mercy, "
"which took place on a bridge over an abyss. They fought, and it was agreed "
"that the losers would be shown no mercy, and their bodies would be thrown "
"down, into the abyss. By dawn the bridge was completely empty. It was then "
"that we, the masters, saw how arrogance had weakened our Houses and deprived "
"us of our future. The ambitions of the past were all that remained. It was a "
"bitter lesson, and it was then that I swore in all of my incarnations to be "
"always humble and straightforward. I have since kept my promise, no matter "
"how strongly I may wish to embellish my story!\""
msgstr ""
"\"하지만, 저희 제자들은 비밀스럽게 보이지 않는 자비의 대회를 준비했어요. 그 대회는 끝없는 심연이 펼쳐진 다리 위에서 개최됩니다. "
"그들은 싸웠고, 또한 패자에게 보여질 자비는 없을 것이며, 모두 절벽 아래로 던져질거라는 동의를 받았죠. 해가 뜰 무렵 다리에 남아있는 "
"사람은 없었어요. 저희들, 즉 사부들은 우리의 오만함이 어찌 우리 문파를 약화하고 미래를 앗아가버렸는지를 보았죠. 과거에 가졌던 야망은 "
"실현되지 못했어요. 씁쓸한 교훈이었습니다. 그리고 그 뒤, 저는 남은 생을 항상 솔직하고 겸손하게 살겠다고 맹새했고요. 제 이야기를 "
"얼마나 과장했는지 상관없이, 저는 계속 그 맹세를 지키고 있답니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0052_Text
msgctxt "893e4cb7-74a8-46f5-b462-f310a0524094"
msgid ""
"\"As I have recently discovered, one of them lives nearby. The noble Hassuf "
"trades in your capital. I confess, I am too nervous to meet him. I fear that "
"my anxiety will cause me to behave inappropriately, and I may disgrace "
"myself for it. Would you assist me in fulfilling my duty and deliver him "
"this letter? I do not believe that my heart can be at peace until this "
"letter is delivered! One cannot be a master when beset by such distraction.\""
msgstr ""
"\"최근에 저는 그들 중 하나가 주변에 살아있는 것을 발견했어요. 고귀한 하수프가 당신의 수도에서 장사를 하더군요. 솔직히, 그를 만나는 "
"것이 불안해요. 제 불안감 때문에 그에게 부적절하게 행동할것 같고, 그 때문에 수치스러워질 수도 있겠죠. 그에게 저 대신 편지를 "
"전해주실수 있을까요? 이 편지를 전하지 않으면 제 마음이 편치 않을 것 같아요! 그런 산만함 때문에 괴로워하는 사람은 장인이 될 수 "
"없을테니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0053_Text
msgctxt "59396011-126c-4178-919a-cb6daf90b6e7"
msgid ""
"\"It is the land of genie, monks, wondrous beasts – and gods, of course. "
"Vudra is home to thousands of gods, while in other lands they worship mere "
"dozens! The Perfect Human is the head of the pantheon. He is called Irori, "
"the Master of Masters. Among the gods he is as a maharajah, ruling Vudra and "
"all of its Mahajanapadas, or kingdoms as you call them. Each kingdom has its "
"own rajah. The wealth and glory of even the feeblest among them is such that "
"would make even the wealthiest of your rulers rage in envy. Trust me, for I "
"was once a rani myself.\""
msgstr ""
"\"지니와 수도승, 놀라운 짐승들 – 그리고 신들이 있는 땅이죠. 부드라에는 수천 명의 신이 있습니다. 완벽한 인간은 그 만신전의 "
"수장이고요. 그는 스승들의 스승, 이로리라고 불린답니다. 마하라자로서 신들 사이에 있고, 부드라와 모든 마하자나판다, 이쪽 말로 왕국을 "
"다스려요. 모든 국가는 라자가 다스립니다. 가장 약한 자가 쌓은 부와 명예조차 당신의 나라에서 가장 부유한 자들의 질투를 받을 만해요. "
"믿어보세요, 저 또한 한 때는 그곳의 여왕이었으니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0054_Text
msgctxt "c6c20307-a9d1-47f0-b728-bd21129b45a6"
msgid "\"Of course, we would need many a week to discuss all of her wonders!\""
msgstr "\"물론이죠. 이야기를 다 하려면 일주일은 족히 걸릴 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0055_Text
msgctxt "2444efa6-c4b3-48d0-8fb6-6bf26fdc34e3"
msgid ""
"\"The walls of my palace steadily absorbed their attack, but in the end they "
"turned to dust. I was preparing to die, but the red wind suddenly fled in "
"terror, banished by a strange traveler. He was a vanara, half-man and half-"
"monkey, and he wore the orange robe of a priest. I wished to thank him but "
"he had little interest in my treasures. He offered me to play the wise-men's "
"game of BARME, and if he won then I would have to give him my throne.\""
msgstr ""
"\"제 궁전의 벽이 적들의 공격을 끈질기게 막았지만, 결국 그조차도 무너지고 말았죠. 저는 죽음을 준비했으나, 붉은 바람은 갑자기 공포와 "
"함께 달아났어요, 이상한 여행자에 의해 쫓겨난거죠. 그는 반은 인간이고 반은 원숭이인 바나라였습니다, 그리고 사제의 주황색 로브를 입고 "
"있었고요. 저는 그에게 보답을 하고 싶었지만 그는 제 보물에는 관심이 없었습니다. 그는 저에게 바르메라는 현자의 놀이를 제안했고, 그가 "
"이긴다면 제 왕좌를 달라고 했죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0056_Text
msgctxt "b0aa617a-1bb9-48f4-acc2-4411d05c02ff"
msgid ""
"\"I agreed, for how could I say 'no' to my savior? He easily outwitted me, "
"hiding four pieces up his sleeve, while I only managed to brush one off the "
"table and stash another one in my pocket. I ordered my guards to seize the "
"vanara and put him in chains, as I had no wish to give up my throne. But by "
"dawn the monk had fled his prison. — He'd used his tongue to lick a hole in "
"his manacles. I knew then that the monk was Ragdya, the monkey god, a sage, "
"a petty thief, and the lover of a hundred brides. Trust me, for I have met "
"many gods, and know of what I speak. I gave Ragdya my throne along with my "
"apologies, and set out to wander.\""
msgstr ""
"\"저는 동의했습니다, 어떻게 제 구원자에게 '아니오'라고 말할 수 있겠습니까? 그는 손쉽게 저를 앞질렀어요, 제가 판 위의 말 하나를 "
"없애고 또 하나를 제 주머니에 넣는 동안, 그는 소매에는 네 개의 말이 숨어있었죠. 제 왕좌를 포기할 생각이 없었기에, 저는 경비병에게 "
"바나라를 붙잡아 사슬로 묶으라고 명령했습니다. 하지만 새벽 즈음에 수도승은 감옥에 없었어요 — 그는 자기 혀를 사용해 족쇄 구멍들을 핥아 "
"빠져나간거죠. 그 뒤 저는 수도승이 현자이자, 옹졸한 도둑이면서, 수백명의 신부를 들인 원숭이 신 라그쟈라는 사실을 깨달았답니다. "
"믿어보세요, 저는 수 많은 신들을 만나봤고, 제가 뭘 말하는지 잘 알고있으니까요. 저는 라그쟈에게 사과와 함께 제 왕좌를 넘겼고, 떠돌이 "
"생활에 접어들게 되었어요. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0057_Text
msgctxt "d6b81b2c-5ffc-486b-abb8-502dfc6630ec"
msgid ""
"\"A massive ant hive grew around him, but this did not concern Rudrakavala. "
"A thousand years passed, and Diomazul, the god of war, came to visit him and "
"offered Rudrakavala any reward, for he'd shown great merit. The rakshasa "
"demanded all eight of the god's swords. Upon receiving them, he chased "
"Diomazul into a dungeon and, content with himself, sat down to rest. Soon "
"the other gods realized that war has left them, for it was much more "
"difficult to resolve conflict and maintain order. And so they began to seek "
"the missing god. To be precise, they found a young hero and tasked him with "
"finding and rescuing Diomazul.\""
msgstr ""
"\"그의 주변에는 거대한 개미집이 자랐지만, 루드라카발라에겐 걱정거리가 아니었죠. 천 년이 흘렀고, 전쟁의 신 디오마줄은 그를 찾아와서 "
"위대한 가치를 보여준 루드라카발라에게 어떤 보상이라도 주겠다고 했어요. 락샤사는 신들의 검 여덟 개를 모두 요구했어요. 모든 보상을 "
"받자, 그는 디오마줄을 던전으로 몰아넣었고, 만족한 채로 앉아서 쉬었죠. 곧 다른 신들은 자신들에게서 전쟁이 사라졌다는걸 깨달았죠, "
"갈등을 해결하고 질서를 유지하는게 훨씬 더 어려워졌으니까요. 그래서 그들은 실종된 신을 찾기 시작했답니다. 정확히 말하자면, 디오마줄을 "
"찾아 구출하는 임무를 맡길 젊은 영웅을 찾아다녔어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0058_Text
msgctxt "d7795916-e38f-4988-84fe-e357c1262236"
msgid ""
"\"But he was terrified by the sight of the mighty three-headed rakshasa. "
"While one head was reading Mizravrit Brahmodiya, the second was puffing on a "
"hookah while the third was sipping wine. The hero didn't stand a chance in "
"battle. But the rakshasa's bride fell in love with the hero. It is she that "
"stands before you today. I put Rudrakavala to sleep with fragrant incense, "
"while my prince took one of his swords and severed all three of the "
"rakshasa's heads. I hid the heads in secret places were my groom could not "
"find them.\""
msgstr ""
"\"하지만 그 영웅은 머리가 셋 달린 락샤샤를 보고는 겁에 질려버렸죠. 머리 하나는 미즈라브리트 브라모디야를 읽고 있었고, 두번째 머리는 "
"후카를 피고 있었고, 세번째는 와인을 홀짝 거리고 있었어요. 영웅은 싸울 시도조차 못했어요. 하지만 락샤사의 신부는 영웅에게 반해버리고 "
"말았죠. 오늘날 그녀는 바로 당신의 앞에 서있어요. 저는 루드라카발라를 향긋한 향기로 재웠고, 저의 왕자님은 그가 지닌 검 중 하나를 "
"뽑아 락샤샤의 머리 세 개를 모두 잘라버렸죠. 저는 남편이 찾을 수 없는 비밀의 장소에 그 머리들을 숨겨놨지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0059_Text
msgctxt "13c671c6-15be-4209-8359-6f54309ecdc5"
msgid ""
"The memory of my treachery remains in one of his heads. I hope that it will "
"never find its way back to his shoulders. But I'd best stay as far away as "
"possible, in case that ever happens. So I prayed to the gods, and trusting "
"in them, I jumped over the ocean landing in Varisia. From there my feet "
"carried me here.\""
msgstr ""
"\"제 배반의 기억은 아직도 그의 머리 중 하나에 남아 있어요. 그가 다시는 그 머리를 어깨 위에 붙일 방법을 찾지 못하길 바랄 "
"뿐입니다. 하지만 만약의 경우를 대비해서, 그에게서 가능한 멀리 떨어져 있는게 좋겠다고 생각했죠. 그래서 저는 신들께 기도했고, 그리고 "
"그들을 믿으며 바다를 건너 바리시아에 도달했습니다. 그리고 제 발걸음이 절 여기까지 이끌었답니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0060_Text
msgctxt "526f4505-4d3c-46c0-aab1-ca7e394c1a9b"
msgid ""
"\"But they did not know that the wise man had taught his servants his "
"techniques. While he slept, his servants captured the assassins. The pasha "
"of the shaitans, also known as the earth genies, sent his finest warrior, "
"Turmir, the destroyer of palaces. By his command, Khiben-Sald's palace fell "
"and turned to rubble. The cunning wizard foresaw this, however, and fled to "
"the island of Jalmeray.\""
msgstr ""
"\"하지만 그들은 그 현명한 자가 부하들에게 기술을 가르쳤다는 것을 몰랐어요. 그가 자는 동안 그의 종들이 암살자들을 붙잡았죠. 땅의 "
"지니라고도 알려진 샤이탄의 파샤는 그의 가장 뛰어난 전사였던 궁전의 파괴자 투르미르를 보냈어요. 그의 명령으로 크히벤-살드의 궁전은 "
"가루가 되었죠. 하지만 교활한 마법사는 이렇게 될 것을 예견하곤 잘메레이의 섬으로 도망을 쳤답니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0061_Text
msgctxt "8fc030aa-3f6a-4147-a03a-b6ed6bc9d1b8"
msgid ""
"\"One of the royal marids, the genies of water, came to free his brethren "
"from captivity. Of all the genies, he was the wisest. For three days, Khiben-"
"Sald competed with the genie in the art of poetry. At the end of the third "
"night, Khiben-Sald was so exhausted that he was about to take a ceremonial "
"dagger to open his own veins... The genie, however, was first to admit "
"defeat, and entered a copper vessel which the wizard then sealed. It was "
"thus that history came to know the maharajah as the great conqueror of the "
"genies.\""
msgstr ""
"\"물의 지니인 마리드의 왕족 하나가 그의 동포들을 풀어주기 위해 왔어요. 그는 모든 지니 중에서도 가장 현명한 지니였죠. 3일 동안 "
"크히벤-살드는 그 지니와 시짓기 대결을 펼쳤습니다. 사흘째 되는 밤 크히벤-살드는 너무 지쳐서 제례용 단검으로 거의 자신의 정맥을 쨀 "
"지경이었죠... 그러나, 그전에 지니가 먼저 패배를 인정하며 황동 주전자 안으로 들어갔고, 그 뒤 마법사가 그를 봉인했어요. 그래서 "
"역사는 마하라자를 위대한 지니 정복자로써 알게 되었답니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0062_Text
msgctxt "775ce288-94b8-4cf5-b6b4-49cb0462f0db"
msgid ""
"\"Kothogaz walked across the ocean, and the water reached only up to his "
"waist. He was covered by a mighty shell like a beetle, and the slime from "
"his body covered the waters like fat, calming the waves around him, and his "
"many mouths dripped with spittle. Kothogaz cried out, and the putridity of "
"its breath made creatures faint, bleeding from their eyes, their nose and "
"their ears – while the monster's saliva burned through everything it "
"touched. Trust me, for I have seen stones that were touched by this poison. "
"Vu Balak, however, called forth the priests and they cast their magic. The "
"ocean boiled and Kothogaz began to boil in it. The whales came surfacing all "
"around him as he screamed, and his chitin hardened, becoming more and more "
"fragile – until finally it cracked and crumbled.\""
msgstr ""
"\"코소가즈는 걸어서 대양을 건넜고, 물은 단지 그의 허리춤까지만 잠겼죠. 그는 딱정벌레같은 강한 껌데기로 덮혔데, 그의 몸에서 흘러나온 "
"지방같은 점액질이 물을 뒤덮어 그의 주위에서 파도를 잠재웠고, 그의 수많은 입에선 침이 줄줄 샜습니다. 코소가즈가 울부짖으면, 그의 "
"숨결로 인한 부패가 생명체들을 기절시키고, 눈과, 코와 귀에서 피가 흐르도록 만듭니다 – 그 동안 괴물의 타액은 닿는 모든것을 "
"녹여버렸죠. 믿어보세요, 저는 이 독액에 닿았던 돌을 실제로 본 적이 있으니까요. 하지만, 부 발락은 사제를 불러서 마법을 외우게 "
"했어요. 바다가 끓어올랐고, 그 안에 있던 코소가즈 또한 끓기 시작했어요. 그가 소리를 지르면 고래들이 그의 주변 표면으로 등장했고, "
"그의 껍질은 딱딱해져 더더욱 깨지기 쉬워졌습니다 – 끝내 금이가서 부서질 때까지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0063_Text
msgctxt "afc7ee71-ed24-43a1-adc6-d98eab704550"
msgid ""
"\"Finally, Vu Balak saw the heart of the Dance of Disharmony. He jumped so "
"high that his mighty body blocked the sun, and the stars shone in the day. "
"He then threw his spear and shattered Kothgaz's heart into a hundred and one "
"pieces. We have managed to gather some of the pieces, but not all. Perhaps "
"if the Storyteller were to read the spear's memories, he would be able to "
"tell were the other pieces went. Then I might collect them to honor my "
"mighty ancestor. That would be a truly heroic deed. Perhaps the path of a "
"hero is what fate truly has in store for me.\""
msgstr ""
"\"마침내 부 발락은 불협화음의 춤의 심장을 보았습니다. 그는 자신의 강대한 육신이 태양을 가려서, 한 낮에 별이 보일 만큼 높이 "
"뛰어올랐죠. 그리고 그는 자신의 창을 던져 코소가즈의 심장을 일백하고도 한 개의 조각으로 산산조각냈습니다. 우리는 그 중 몇 개를 "
"모았지만, 전부 모으지는 못했죠. 아마도 이야기꾼이 창의 기억을 읽는다면, 다른 조각이 어디로 갔는지 말해줄 수 있겠죠. 그러면 저는 제 "
"강력한 조상을 기리기 위해 그 조각들을 모을 수 있을거에요. 진정으로 영웅적인 업적이죠. 아마도 영웅으로써의 길이 저에게 주어진 진짜 "
"운명인지도 모르겠네요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0064_Text
msgctxt "4e1f7513-4757-48e4-bca3-1bf35b8c0b01"
msgid ""
"\"One day, Khorkhor defeated the poisonous dragon Sruvara, who turned rice "
"fields into nauseating marshes. But Khorkhor did not notice that Sruvara had "
"scraped his white skin with its talon. Infection entered the hero's body, "
"and he grew weak. He lied down to rest and remained there for a thousand "
"years. Nothing could awaken him, even all the strife brought on by the fight "
"with Kothogaz, the Dance of Disharmony. Once he finally awoke from his "
"slumber, Khorkhor discovered that his homeland had been ravaged by this "
"terrible attack, and he'd slept through the battle! Disgraced, he moaned and "
"set off for a faraway gorge, where he would deliver his body to the "
"scorpions, that they might eat his flesh and hide him from his shame.\""
msgstr ""
"\"어느 날, 코르코르는 논밭을 메스꺼운 습지로 만든, 독을 가진 드래곤 스루바라를 물리쳤습니다. 그러나 코르코르는 스루바라가 그의 하얀 "
"피부를 발톱으로 할퀸 것을 알아차리지 못했죠. 영웅의 몸은 감염되었고, 이내 쇠약해졌습니다. 그는 그곳에 누워서 천 년 동안을 "
"쉬었습니다. 그 무엇도 그를 깨울 수 없었죠, 심지어, 불협화음의 춤 코소가즈와의 싸움으로 야기된 모든 분쟁에서도 깨어나지 못했습니다. "
"그가 마침내 잠에서 깨어났을 때, 코르코르는 자기 고향이 끔찍한 공격을 당해 파괴되었다는 것을 발견했습니다, 그가 잠자는 동안 일어난 "
"모든 전투로 인해서요! 수치심을 느낀 그는 신음하며 먼 협곡을 향해 출발했습니다, 자신의 육체를 먹어치워 그의 수치심을 숨겨줄 전갈들에게 "
"먹이기 위해서였죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0065_Text
msgctxt "83ddf2df-6824-43a3-8594-ce073c0999aa"
msgid ""
"\"For three months, the scorpions ate his white skin and ruby flesh, but "
"still the warrior endured. Even when he was eaten, Khorkhor did not die, for "
"he was truly great. It was then that Bundha the Singing Butcher came to him. "
"The immortal rakshasa told him that great was Khorkhor's shame, but more "
"shameful still would be to run from it like a coward, rather than atone for "
"it. Khorkhor's spirits were rekindled. He arose and, through sheer force of "
"will, forged himself a new body out of iron. He accomplished many great "
"deeds thereafter, and in the end he regained his position of honor and "
"nobility.\""
msgstr ""
"\"세 달 동안, 전갈들이 그의 하얀 살갖과 붉은 살을 먹었지만, 전사는 끈질기게 견뎌냈어요. 그가 그렇게 먹히던 중에도, 코르코르는 "
"죽지 않았죠, 그것이 그가 진실로 위대한 이유입니다. 그러다가 노래하는 도살자 분다가 그에게로 찾아왔어요. 불멸의 락샤샤가 말하기를, "
"물론 코르코르의 수치심은 크겠지만, 그보다 더 수치스러운 일은 이를 속죄하지 않고 겁쟁이처럼 도망치는 것이라 했죠. 코르코르의 정신이 "
"다시 불타올랐습니다. 그는 일어났고, 순수한 의지의 힘을 통해, 스스로 새로운 강철의 육체를 제련해냈습니다. 그 뒤로 많은 위대한 "
"업적들을 이루었으며, 결국 명예와 고귀함을 되찾게 되었답니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0073_Text
msgctxt "02b7dba6-79b4-4b43-9c79-927d482cfd82"
msgid ""
"{n}Surprised, the Vudrani falls silent, shrugs and gives you a slightly "
"displeased look.{/n} \"Impatience is the mother of all sins, o worthy one. "
"Be careful on this path. Return when you have the time to listen. Until "
"then, I shall wait for you.\""
msgstr ""
"{n}놀랍게도, 부드라인은 침묵하며, 어깨를 움츠리고는 살짝 불쾌한 표정을 당신에게 지었습니다.{/n} \"조급함은 모든 죄의 "
"어머니지요, 가치있는 분이시여. 이 길을 조심하십시오. 당신께서 듣고자 하실 때에 다시 오십시오. 그때까지, 전 당신을 기다리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0077_Text
msgctxt "e9c26603-2b27-489e-879f-5a27ffd70c39"
msgid ""
"{n}The Vudrani purses her lips in disappointment and mumbles something under "
"her breath, but soon she is smiling at you again.{/n} \"I shall await your "
"return.\""
msgstr ""
"{n}부드라인 실망감과 함께 입술을 오므렸고 날숨과 함께 뭔가를 웅얼거렸지만, 이내 당신을 바라보며 다시 웃음지었다.{/n}\"당신께서 "
"돌아오시길 기다릴게요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0081_Text
msgctxt "2f329bf0-d69e-4055-9a46-326cdc292a9f"
msgid ""
"{n}The Vudrani freezes with her mouth open. Obviously, she was just getting "
"to the best part. She snorts disapprovingly.{/n}"
msgstr ""
"{n}부드라인은 그녀의 입을 벌린채로 꼼짝도 하지 않았습니다. 명백히, 그녀의 이야기가 절정에 도달했던 것입니다. 그녀는 못마땅한 듯이 "
"코웃음을 칩니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0085_Text
msgctxt "e545e607-065c-4b35-b146-96ace15cbc17"
msgid ""
"\"Turmir chased after him, forgetting that the waters of the ocean could not "
"hold his heavy flesh. As he began to drown, Khiben-Sald sent ships to save "
"him, but only after Turmir swore to serve him. As compensation for the "
"palace he destroyed, the genie was commanded to build the Pure Temple of the "
"Maharajah, which was a hundred times more beautiful than the one he "
"destroyed. Trust me – for I have seen this temple with my very eyes!\""
msgstr ""
"\"투르미르는 그를 쫓아갔지만, 바닷물이 자신의 무거운 육체를 지탱할 수 없다는 것을 깜빡해버렸죠. 그가 물에 빠지기 시작할 무렵, "
"크히벤-살드는 그를 구하기 위해 배를 보냈습니다, 단, 투르미르가 자신을 섬기겠다고 맹세한 다음에 말이에요. 자신이 부순 궁전에 대한 "
"보상으로써, 지니는 그가 부순 것의 100배는 더 아름다울, 마하라자의 순수한 사원을 짓도록 명받았답니다. 믿어보세요 – 저는 두 눈으로 "
"똑똑히 그 신전을 봤으니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0091_Text
msgctxt "86f28e3b-583b-4033-9045-1a558942414c"
msgid "\"You are wise, o most worthy one. But not patient.\""
msgstr "\"당신은 지혜로우십니다, 오 가장 존귀하신 분이시여. 그러나 참을성은 없으시군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0096_Text
msgctxt "3dfaf872-d17a-4dae-9aed-b4eede2553c7"
msgid "\"What would you like to hear?\""
msgstr "\"무슨 말이 듣고 싶은 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0099_Text
msgctxt "69612f38-dcf0-4af5-9e26-1d0c07da2fbf"
msgid ""
"\"A great evil returned with me to my kingdom. The macaques of Sikari, "
"diseased and rabid, swarmed the land. They rolled like an enormous wave, "
"engulfing and destroying everything in their path. They called this horror "
"'the crimson wind'. My warriors went forth boldly, but were overrun.\""
msgstr ""
"\"거대한 악이 저와 함께 제 왕국으로 되돌아왔습니다. 병들고 폭력적인, 시카리의 마카크들이 온 지역을 휩쓸었어요. 그들은 마치 "
"어마어마한 해일처럼 몰려와, 그들 앞의 모든 것들을 휩쓸고 파괴했죠. 사람들을 이 무시무시한 광경을 '진홍색 바람'이라 불렀습니다. 저의 "
"전사들이 용감하게 전진했지만, 압도되고 말았어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Cue_0100_Text
msgctxt "308692f9-4e09-4815-93b7-a2c2a8cb83d0"
msgid "\"O, how fleeting is your attention!\""
msgstr "\"오, 당신의 관심이 얼마나 순식간인지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Shared_ListenQuietly_String
msgctxt "c9f6156d-99b0-4c0a-b218-cf6a28e39c56"
msgid "[Keep listening in silence]"
msgstr "[잠자코 계속 듣습니다]"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/HumanFemaleExoticSmithArtisan/Shared_ShaiShutUp_String
msgctxt "a3c3aa3f-c7b2-46a8-bbd8-9c731d3547ae"
msgid "{n}With a barely audible sigh, Shaynih'a bows her head.{/n}"
msgstr "{n}거의 들을 수 없는 한숨과 함께, 샤이니아는 고개를 떨구었다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/Items/LetterForGassufDescription_String
msgctxt "51a4b65c-fbac-4de6-aa99-d6ad7852a20b"
msgid ""
"A letter from the Shaynih'a family, addressed to the family of the merchant "
"Hassuf."
msgstr "상인 하수프의 가족들 앞으로 보내어진 샤이니아 가족들로부터의 편지."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/Items/LetterForGassuf_String
msgctxt "ca7f7160-ece8-40ef-9d2b-e8043b68638c"
msgid "Letter to Hassuf"
msgstr "하수프에게 보낸 편지"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/Items/PieceOfMetallDescription_String
msgctxt "6e99adc6-3a76-4ba6-8743-e750ea832fe5"
msgid ""
"A fragment of the spear that belonged to Vu Balak, an ancestor of Shaynih'a."
msgstr "샤이니아의 조상, 부 발락이 소유했던 창의 파편."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/Items/PieceOfMetall_String
msgctxt "32d5db7d-0ca4-43ad-ac80-db78026bc405"
msgid "Spear Fragment"
msgstr "스피어의 파편"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/Items/VudranWeaponDescription_String
msgctxt "46300021-3877-48d8-8904-5b26e5a3b1e9"
msgid ""
"A magnificent weapon, borne of the mastery of the Vudrani smiths, and the "
"refinement of their philosophy."
msgstr "부드라인의 정제된 철학으로, 부드라인 대장장이 장인의 손을 거쳐 탄생한 훌륭한 무기."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/Items/VudranWeapon_String
msgctxt "4af5ced3-582a-4654-bc70-6cb06655f8ef"
msgid "The Pride of Vudra"
msgstr "부드라의 자부심"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_EE_StatGift_Shainiha/Cue_0001_Text
msgctxt "6bf8d3a1-cc62-4e48-b90f-8a946bd9d64b"
msgid ""
"\"O most worthy one! I spend day and night listening to the stories that "
"guests of my workshop bring to share. I decided to sort those stories and "
"put them in two baskets – one for stories from local peasants and hunters, "
"and another for stories of travelers from far-away lands. Surprised I was to "
"see that the first basket stays empty all the time, while the other is "
"almost full. While I was thinking about it, I took a walk in the forest. And "
"I meant to jump over the forest stream, but being as how my mind was all "
"distracted by my great basket mystery, I accidentally jumped too high, and "
"into the upper branches of a tall oak. And there they were. – The stories "
"that had been stolen from the first basket, all hidden in a magpie nest!\""
msgstr ""
"\"오, 가장 자격있는 분이시여! 저는 밤낮을 가리지 않고 제 작업장에 오는 손님들이 공유하고 싶어하시는 이야기들을 들으며 보냈어요. "
"그리고나서 이 이야기들을 정리해다가 두칸짜리 서재에 꽂아두기로 결정했죠 – 하나는 지역 주민들과 사냥꾼들에게 들은 이야기, 다른 하나는 "
"멀리서 온 여행객들의 이야기들로 채우려고요. 첫번째 서재는 거의 비어있지만 다른 쪽은 거의 꽉 차는 걸 보고 놀랐답니다. 제가 그에 대해 "
"생각하는 동안, 저는 숲 속을 거닐고 있었죠. 다음 순간 저는 숲 속의 개울에 살짝 뛰어들려고 했는데, 제 생각이 어찌나 그 서재의 "
"미스터리에 쏠려있었는지, 그만 너무 높이 뛰어버려서 키 큰 떡갈나무의 가장 높은 가지에 걸려버리고 말았죠. 그리고 거기에는 – 첫번째 "
"서재에서 도둑맞은 모든 이야기들이 숨어있었어요. 까치 둥지 안에 말이죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_EE_StatGift_Shainiha/Cue_0002_Text
msgctxt "d0e419ae-59e0-4c6a-ab2a-053ceeaea3a6"
msgid ""
"\"Sitting on the oak branches, I asked the magpies why they stole from the "
"basket of local stories, and never touch the other. And the magpies told me "
"that they love everything that's shiny and bright. And what could be shinier "
"and brighter than your fellow neighbors discussing how they went to the "
"stream to wash their clothes, or repaired their fence three years ago? "
"Surely not the dusty stories of weary travelers!\""
msgstr ""
"\"떡갈나무 가지에 걸터 앉아서, 저는 까치들에게 왜 서재에서 지역 이야기들을 훔쳤느냐고, 왜 반대편은 건드리지도 않았느냐고 물었어요. "
"까치들이 저에게 답하기를, 물론 우리가 반짝이는 모든것을 좋아하지만, 가까운 이웃들이 세탁하러 개울에는 어떻게 갔느냐거나, 삼 년 전에 "
"울타리를 고쳤다던가 하는 이야기들보다 반짝이는 물건이 어딨겠어? 지친 여행자들의 먼지묻은 이야기들은 당연히 아닐거야! 라고 답하는거 있죠!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_EE_StatGift_Shainiha/Cue_0003_Text
msgctxt "2f54ba1c-bdc8-4447-95c5-b490afa62e9c"
msgid ""
"\"O worthy one! I come to tell you of the magnificent spectacle I was lucky "
"to witness. I saw a great caravan traveling across your lands. The travelers "
"spat their words onto the road, and covered it with memories of the far-away "
"lands. Sparrows pecked the words and memories like millet, and their "
"feathers turned green, and blue, and red, and all the colors you can "
"imagine, and they started singing in the languages of the countries that the "
"caravan passed along its way.\""
msgstr ""
"\"오, 자격있는 분이시여! 제가 우연히 본 위대한 광경을 들려드리기 위해 왔습니다. 저는 당신의 영토를 가로지르는 대상단을 본 적이 "
"있어요. 그 여행객들이 자기들의 언어로 도로를 향해 욕지거리를 하고 타지에서의 추억들로 그 흔적을 덮는것도 봤죠. 참새들은 그 말과 "
"기억들을 곡식 낱알처럼 쪼아먹었고, 그들의 깃털은 초록으로, 파랑으로, 빨강으로, 또한 당신이 생각할 수 있는 모든 색으로 물들었고 "
"이윽고 상단이 지나온 나라들의 언어를 따라 노래하기 시작했어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_EE_StatGift_Shainiha/Cue_0004_Text
msgctxt "e586f74b-5c16-4b7b-aa66-da470ae5cdac"
msgid ""
"\"When the caravan returned, its travelers saw these birds, and shouted in "
"delight: \"What a miracle! Bright-feathered sparrows, singing so many "
"languages! Have you ever seen anything like it, in any of the lands we've "
"visited in the past?\""
msgstr ""
"\"그 상단이 돌아왔을 때 그들은 참새들을 볼 수 있었고, 기뻐서 소리쳤죠: \"기적이로군! 밝은색 깃털을 가진 참새들이 수많은 언어로 "
"노래한다니! 우리가 지나온 다른 곳에서 이런 광경을 본 적이 있던가?\"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_EE_StatGift_Shainiha/Cue_0005_Text
msgctxt "56bce27b-32e4-40e4-ac1a-948bf6b7956c"
msgid ""
"\"Ask yourself, O worthy one, why I told you this story. And this is your "
"answer. – I have reforged this story into the gift which I present to you "
"now!\""
msgstr ""
"\"왜 제가 이런 이야기를 말씀드렸는가 스스로에게 질문해보시죠, 자격있는 분이시여. 아마도 이렇게 대답하시겠죠 – 제가 이 이야기를 "
"선물로 만들었고, 지금 당신에게 드리기 위함이라고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Answer_0008_Text
msgctxt "8d0f4134-5982-4f95-966e-8c8f009e34e2"
msgid "\"Begin making your great weapon.\""
msgstr "\"네 위대한 무기의 제작을 시작하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Answer_0009_Text
msgctxt "c8a9d3a7-47a3-478e-9038-eb84a3b9e119"
msgid "\"I thank you, Shaynih'a the Tulip.\""
msgstr "\"고마워, 튤립꽃 샤이니아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Answer_0010_Text
msgctxt "4deb1232-bd1c-4731-8232-f3958a2b4a86"
msgid "\"I want you to make something specific for me.\""
msgstr "\"나를 위해 무언가 특별한 것을 만들어주었으면 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Answer_0011_Text
msgctxt "8ccef488-6927-4f39-ac1c-351fc01a1393"
msgid "\"Go home and never come back here again.\""
msgstr "\"네 고향으로 돌아가 다시는 돌아 오지 마라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Answer_0016_Text
msgctxt "2e40a9da-b3ca-49a3-aae8-645bf82ba0b7"
msgid ""
"\"You've finally found your true calling. Tell me now… Why did you tell me "
"all of those stories?!\""
msgstr "\"너는 마침내 네 진정한 소명을 찾아내었다. 이제 말해보거라. 왜 나에게 이 모든 이야기를 해준 거지?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Answer_0019_Text
msgctxt "1df3fef2-16f3-4cbf-88d7-6f46326f8b3b"
msgid "\"Remind me, who are you and what are you working on?\""
msgstr "\"다시 알려줘, 네가 누구고 무슨 일을 했었지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Cue_0001_Text
msgctxt "9fd11d72-feed-4928-8b66-ed70ae69d244"
msgid ""
"\"I greet you, o most worthy one! As decided, {d|Shainiha}I{/d} have stepped "
"upon the path of the master smith, as fated by the Perfect Human. Since a "
"rare few in these lands appreciate the aesthetics of the Vudrani, I have "
"decided that my gifts will be made for you. However, even though my feet may "
"carry me swiftly to the top of the mountain of perfection, on this path I "
"shall need the help of someone tactful and dependable — someone such as you, "
"o worthy one. If you are ready to aid me, come see me at my workshop, and I "
"shall tell you of my need.\""
msgstr ""
"\"오 가장 존귀하신 분이시여, 당신께 문안드립니다! 결정한 대로 {d|Shaynih'a}저는{/d} 장인 대장장이으로의 길을 "
"내딛었습니다, 완벽한 인간께서 결정하신 운명이죠. 이 땅엔 아주 소수만이 부드라인의 미학을 존중하고 있었기에, 저는 저의 재능을 당신을 "
"위해 사용하기로 결정했습니다. 그러나, 제 발이 완벽함의 산 정상까지 저를 재빠르게 데려갈 수 있다고 하더라도, 이 길에서 저에겐 "
"재치있고 의지할 수 있는 사람의 도움을 받아야만 합니다 — 마치 당신같이 말이죠, 오 존귀하신 분이시여. 만약 당신이 저를 도우실 준비가 "
"되었다면, 제 공방에 오셔서 저를 찾아주십시오, 그러면 저에게 필요한 것을 말씀드리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Cue_0002_Text
msgctxt "188011cf-b77c-420a-b753-3c89c268c848"
msgid ""
"\"{d|Shainiha}I{/d} am happy to see you, o most worthy one. A new gift and "
"new stories await you!\""
msgstr ""
"\"{d|Shainiha}저는{/d} 당신을 뵙게 되어 너무나 기쁩니다,  오 존귀하신 분이시여. 새로운 선물과 새로운 이야기가 당신을 "
"기다리고 있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Cue_0003_Text
msgctxt "96a0d52b-50a0-4166-b954-a4e429474499"
msgid ""
"{n}The Vudrani ceremoniously extends a magnificent weapon.{/n} \"I swear, "
"nowhere in Avistan shall you find a weapon such as this. I have named it "
"'Mastery'. The master of masters himself taught me how to make this weapon – "
"a material symbol of the harmony of destruction. Someday I shall tell you "
"the story of how I was blessed by Irori himself... someday...\""
msgstr ""
"{n}부드라 인이 예의를 갖추고 훌륭한 무기를 진상했습니다.{/n}\"맹세컨데, 아비스탄 어디에서도 이 같은 무기를 찾으실수는 "
"없을겁니다. 저는 이것을 '통달'이라 이름 지었어요. 스승들의 스승께서 직접 이 무기 – 조화로운 파괴의 물질적 상징을 만드는 방법을 "
"가르쳐 주셨죠. 언젠가, 어떻게 이로리께서 직접 저를 축복해주셨는지를 말씀드리겠습니다... 언젠가는 말이죠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Cue_0004_Text
msgctxt "182cc8c8-08b1-4526-8245-9e9cf9f42f44"
msgid ""
"\"I am very grateful for your help. The path to one's purpose is difficult, "
"and I am glad to have found a companion such as you. Now that I know which "
"road shall lead me to perfection, an urge has grown in my soul — to create a "
"great weapon for you. In it, I shall be able to embody that confidence in my "
"future that you yourself have helped me to gain.\""
msgstr ""
"\"당신의 도움에 감사합니다. 한 사람의 목적을 향한 길은 힘겹고, 그렇기에 당신과 같은 동료를 구할 수 있게 된 것을 정말 감사합니다. "
"이제 어느 길이 저를 완벽함으로 이끌지를 알기에, 제 영혼에 욕망이 깃들었습니다 — 당신을 위해 위대한 무기를 만들기 위해서지요. "
"거기에, 당신께서 저를 도와주셔서 얻게 된 제 미래에 대한 확신을 구현할 수 있을 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Cue_0005_Text
msgctxt "b210ea47-a32f-42a7-8658-8b52b19977ef"
msgid ""
"\"Still, I urge you to visit me at my workshop. I wish to share with you a "
"rumor that may lead me to quit your realm, to suddenly embark on an "
"adventure. Please, do not take long!\""
msgstr ""
"\"여전히 저는 당신이 제 공방에 와주시길 부탁합니다. 저는 당신의 왕국을 떠나 갑작스런 모험으로 저를 이끌 그런 풍문을 당신과 이야기 "
"하고 싶습니다. 부디, 오래 걸리지 않길 바랍니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Cue_0006_Text
msgctxt "dc040321-a751-4138-9b4a-4a7de4705a14"
msgid ""
"\"Please, accept this fine item. It has been crafted according to the "
"traditions of Vudrani craftsmanship. Even in the Impossible Kingdoms, "
"possessing something so precious would inspire awe and envy.\""
msgstr ""
"\"부디 이 상품을 받아주십시오. 부드라인들의 전통적인 제작 방법을 따라 만들었습니다. 불가능의 왕국들에서조차, 특히 귀한 물건을 얻게 "
"되면 경외감과 질투심을 부른답니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Cue_0012_Text
msgctxt "70d1b8b0-1973-4c53-8b1c-ce8aaaa3f2d8"
msgid ""
"{n}Shaynih'a snorts and pouts her lips, clearly insulted.{/n} \"Our "
"friendship has been ordained by the gods, and this is how you treat it? In "
"that case, as you wish! You shall never see me again, but you will most "
"definitely hear about me and my adventures! Time and time again!\""
msgstr ""
"{n}샤이니아는 모욕적으로 코웃음을 치며 입술을 삐죽거렸다.{/n} \"우리 우정은 신께서 정하셨어요. 그런데 저를 이리 대하시나요? "
"그럼 당신이 원하는 대로 합시다! 저를 다시는 볼 수 없을 거예요. 온 세상이 제 모험 얘기로 즐거운 시간을 보내겠지만요! 아마 듣기 "
"싫어도 계속 듣게 될 걸요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Cue_0013_Text
msgctxt "05e13b53-a2db-4097-ae69-098588e4cab0"
msgid ""
"{n}The Vudrani throws back her head in laughter.{/n} \"You wish to ask me "
"for something specific? But please, how can I foresee which thoughts the "
"Perfect Human will send into my mind? Of course, I can promise to fulfill "
"your order, but if the Perfect Human wishes it, I will go against my word, "
"and then everyone will say again: 'don't believe the Vudrani — their words "
"are nothing but lies'. And why would we want that?\""
msgstr ""
"{n}부드라인은 고개를 뒤로 젖히며 깔깔댔습니다.{/n} \"제게 특별 주문을 하고 싶으신가요? 죄송하지만, 이해해주세요. 완벽한 "
"인간께서 머릿속에 어떤 영감을 불어넣어 주실지는 저도 잘 몰라요. 물론 제작을 명령하시면 저는 따르겠지요. 하지만 완벽한 인간께서 "
"부르시면, 제작은 뒷전으로 밀려날 거예요. 그럼 사람들은 또 이렇게 말하겠지요: '부드라 사람은 믿지 마라 — 거짓말밖에 할 줄 "
"모른다'라고요. 누가 그런 소리를 듣고 싶어 할까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Cue_0014_Text
msgctxt "b17f1e2c-aee6-4ab6-925c-81fc9983dfe2"
msgid ""
"\"It will truly be magnificent. Believe me, for I have been to a hundred "
"lands, and with my eyes I have witnessed the most perfect creations of a "
"thousand masters.\""
msgstr ""
"\"정말 대단할 것입니다. 저를 믿어주세요, 저는 수많은 곳을 다녀왔고, 또 수많은 장인들이 그들의 완벽한 창조물을 만드는 것을 "
"목격했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Cue_0015_Text
msgctxt "a6fe3a66-f5a7-4b55-9f53-03f16fcdcdd1"
msgid ""
"\"I would gladly relate a story from my homeland that inspired me to create "
"this. But alas… due to another pressing matter I must take my leave sooner "
"than I would like!\""
msgstr ""
"\"저는 이것을 만들 수 있게 영감을 불어넣어준 제 고향의 이야기를 즐겁게 할 수 있습니다. 그러나, 아아... 다른 바쁜 문제 때문에 "
"서둘러 떠나야만 합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Cue_0017_Text
msgctxt "a69b5d8a-afee-48d0-8f3d-92d8e2b64c22"
msgid ""
"{n} Shaynih'a sighs heavily, almost defeated, and suddenly starts to speak "
"in plain and clear words.{/n} \"A good story is like an island. You sail to "
"it in your boat, get off on the shore and start walking. North or south. "
"Into the mountains or along the shore. Or perhaps you start digging a hole, "
"wishing to know what lies underneath. Depending on what side of the story "
"you choose to look into, you will always find something different.\""
msgstr ""
"{n}샤이니아는 좌절감에 젖어 깊은 한숨을 내쉽니다, 그러다 갑자기 본래 목소리로 또박또박 말하기 시작합니다.{/n} \"좋은 이야기는 "
"섬과 같습니다. 당신은 배를 몰아 섬에 다다르지요. 북쪽, 남쪽, 산과 바닷가. 어느 한 곳을 골라 걷기 시작해요. 저 아래 뭔가 묻혀 "
"있는 듯한 느낌이 들면 땅을 팔 수도 있겠죠. 어떤 관점에서 이야기를 감상하는지에 따라 색다른 무언가를 발견할 수 있답니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Cue_0018_Text
msgctxt "288a355a-a433-4b64-920d-6769f0978b3c"
msgid ""
"\"Good friends or vicious monsters, great treasures or pesky mosquitoes... "
"Do you see? The same story may become the story of a villain or a hero, it "
"all depends on how you tell it. It may become a comedy or a tragedy... And "
"you can make of it what you wish. You may arrive at any conclusion you "
"desire. So, ultimately, does it really matter what happened? And does it "
"matter whether or not it actually did? Or perhaps, the only thing that "
"matters is the story itself – and you, the listener, deciding on your own "
"what to make of it...\""
msgstr ""
"\"좋은 친구던 무자비한 괴물이던, 엄청난 보물이던 귀찮은 모기떼건... 보셨나요? 같은 이야기일지라도 영웅의 것이 될 수도 악당의 것이 "
"될 수도 있습니다, 당신께서 어떻게 말하는지에 따라서요. 그것은 희극이 될 수도, 비극이 될 수도 있고... 또한 당신이 원하는 바와 "
"같이 만들 수 있지요. 당신은 당신이 바라는 어떠한 결과에도 다다를 수 있어요. 그래서, 궁극적으로, 정확히 무슨일이 일어났는지가 정말 "
"중요할까요? 그리고 실화인지가 아닌지가 중요할까요? 어쩌면, 진짜 중요한 것은 이야기 그 자체일수도 있겠죠 – 그리고, 청자인 당신께서 "
"그것을 어떻게 받아들일지 스스로 결정하고요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Cue_0020_Text
msgctxt "797758bf-f535-4c37-ae6d-cf24007ee80a"
msgid ""
"\"I am Shainih'a the Tulip. O worthy one, I walking the path of master "
"smith, with the Perfect Human as my guide. My creations are as bright and "
"varied as the flowers at Efreet Emperor's Palace Garden, gathered from all "
"of the planes of the universe, and delivered by the peri, who desperately "
"love the beautiful Emperor. Oh poor Emperor, he cannot enjoy the beauty of "
"his garden, for the heat of his breath incinerates everything around him. "
"Whenever he sneezes, whole trees burn to ash.\""
msgstr ""
"\"저는 튤립 꽃 샤이니아입니다. 가치있는 분이시여, 저는 완벽한 인간을 지침삼아 장인으로서의 길을 따라가고 있어요. 제 작품들은 황제와 "
"절망적인 사랑에 빠진 요정이 모든 우주의 별들에서 모아다가 이프리트 황제의 정원에 선물한 꽃처럼 같이 밝고 다양해요. 오, 가엾은 "
"황제시여, 그의 숨이 주변의 모든것을 불태우기에 정원의 아름다움을 만끽할 수가 없어요. 그가 훌쩍일 때마다, 모든 나무들이 불타서 재가 "
"되겠죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanFemaleExoticSmith/KTC_HumanFemaleExoticSmith/Cue_0021_Text
msgctxt "69e72122-fe45-42cf-b65a-3f0a5e769730"
msgid ""
"\"But you, O worthy one – nothing stands between you and the beauty of my "
"creations. I can make for you a striking sai, fauchard or kama, filled with "
"the laughter of lightning, or a sling staff imbued with the song of frost, "
"or dozens of other ingenious weapons that the Master of Masters leads me to. "
"But my greatest desire is to create a true masterpiece for you. I know not "
"what it may be, but one day we will both find out, O worthy one!\""
msgstr ""
"\"하지만 가장 자격있는 당신 – 제 작품과 당신 사이에는 어떤 장애물도 없어요. 저는 당신께 벼락의 웃음소리로 가득찬 매력적인 필가차, "
"포샤르, 카마를, 또는 얼음의 노래를 가득 담은 슬링 스태프, 그도 아니면 스승들의 스승께서 저를 이끄시는 대로 수많은 독창적인 무기들을 "
"만들어 드릴 수 있죠. 하지만 저의 가장 큰 열망은 당신께 진짜 걸작을 만들어드리는 거예요. 지금으로선 어떤 물건이 될지 모르겠지만, "
"그때가 되면 우리 모두 알 수 있겠지요, 자격있는 분이시여!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/Barks/BokkenAttack_String
msgctxt "23dfab79-f512-4744-bb13-2b6cf82e5e21"
msgid "\"Aaaaa!\""
msgstr "\"아아아아아!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/Barks/PlayerAttack_String
msgctxt "12c2519d-e520-41cf-98cf-f20c23399269"
msgid "\"Aaaaa!\""
msgstr "\"아아아아아!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/Barks/WereratFight_String
msgctxt "2954c13c-7c7a-4428-b8cb-65a722aeada8"
msgid "\"Die, scum!\""
msgstr "\"죽어라, 쓰레기!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0004_Text
msgctxt "433ad927-adf7-40dd-9211-35549e5e388d"
msgid "\"Tests? What tests?\""
msgstr "\"시험? 무슨 시험?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0010_Text
msgctxt "676aecdd-27c6-4150-bb1e-ca2363558557"
msgid "\"I should go now.\""
msgstr "\"그럼 가봐야겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0015_Text
msgctxt "eac9b748-eeee-4264-b099-3d7f16c25417"
msgid "\"The wererat died from taking the potion.\""
msgstr "\"쥐인간은 포션을 마신 후 죽어버렸어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0016_AlignmentShift.Description
msgctxt "16237a65-ba46-4d9f-8330-6e803ec3c0d4"
msgid "Lied to Bokken about the results of the potion trials."
msgstr "보큰에게 포션 시험의 결과를 거짓으로 말하였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0016_Text
msgctxt "6a466bb4-5028-4f1a-ab9f-03c84ce865eb"
msgid ""
"[Lie] \"As soon as I fed your potion to the dog... spots appeared on it from "
"head to tail! And then it had orange saliva dripping from its mouth!\""
msgstr ""
"[거짓]\"그 개에게 영감님한테 받은 포션을 먹이자마자...머리부터 꼬리까지 반점이 나타났어! 그리고는 입에서 주황색 침이 뚝뚝 "
"떨어지더라구요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0026_Text
msgctxt "43811427-c3a5-4d15-b6f7-ed5b4dfa8631"
msgid "\"I need to buy something from you.\""
msgstr "\"물건을 구매할까 하는데..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0028_Text
msgctxt "cb3699f9-7c77-49a2-b12a-f78d9f0e0087"
msgid "\"What formula?\""
msgstr "\"무슨 공식?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0029_Text
msgctxt "2ff531ba-3be1-4365-bcce-57f6a8f0b412"
msgid "\"I bet a gold piece that you're not even listening to what I say…\""
msgstr "\"내가 말하는걸 전혀 들리지 않고 있다에 돈을 걸겠어...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0030_Text
msgctxt "28e4d317-8fa4-4707-825f-d98938e60f40"
msgid "\"Speak clearly, old man. What on earth are you blathering about?\""
msgstr "\"똑바로 말해봐요. 영감님. 도대체 뭣 때문에 허둥대고 있는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0042_Text
msgctxt "54366e64-4007-407f-ae86-e92f689ef3fe"
msgid "\"The potion clouded your mind. You attacked me.\""
msgstr "\"물약이 너를 미치게 했어. 네가 나를 공격했지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0044_AlignmentShift.Description
msgctxt "6b238e5a-8da0-40e9-bd6d-9bc85810f08c"
msgid "Made Bokken plea for his life after his new potion drove him berserk."
msgstr "포션이 그를 미치게 만들었기에 그에게 목숨을 구걸하라고 합니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0044_Text
msgctxt "34d27563-234b-476d-84cb-82ac6065425b"
msgid ""
"\"You've dared to raise your hand against your ruler. Beg now for your life."
"\""
msgstr "\"통치자에게 감히 대들다니. 목숨을 빌어라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0046_AlignmentShift.Description
msgctxt "11f3785c-860c-4efe-b093-2a804a51e170"
msgid "Killed Bokken for going berserk after drinking the potion."
msgstr "모션을 마치고 미친 보큰을 죽입니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0046_Text
msgctxt "26e00078-200c-448c-8a5c-ffcf63b8714e"
msgid "\"Not bad. But I'm going to kill you anyway.\""
msgstr "\"나쁘지 않아. 어쨌든 너를 죽일 거니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0047_Text
msgctxt "8325ea0a-ae5a-457e-9678-810c9243cc0d"
msgid "\"That's more like it.\""
msgstr "\"그거 괜찮군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0054_Text
msgctxt "6afb2305-896a-43bf-b635-338373a848be"
msgid ""
"\"No, Bokken. Svetlana is worried about you – and I can see she's right to "
"be. You are obsessed with this idea. It won't lead anywhere good.\""
msgstr ""
"\"아니요. 보큰. 스베틀라나가 영감님을 걱정하고 있어. 아무래도 그녀가 옳은 것 같아. 지금 그 생각에 너무 몰두해있어. 이런건 "
"어디에도 좋은 결과를 가져오지 못할 꺼야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0055_Text
msgctxt "5a5cb419-a99a-4517-b97e-d2668606b7cd"
msgid "\"All right, I'll do it.\""
msgstr "\"좋아. 그렇게 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0073_Text
msgctxt "0d2a6f32-73c7-4b5c-81b2-203b76913936"
msgid ""
"\"Shut up, you nitwit… and next time think before you take any more potions."
"\""
msgstr "\"닥쳐...이 멍청한 영감. 다음엔 물약을 들이키기 전에, 생각 좀 하라구.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0075_Text
msgctxt "78080f23-0f14-49db-8505-e9f875720250"
msgid "\"I'm not tormenting living creatures for the sake of your ambition!\""
msgstr "\"나는 영감님 야망을 위해서 살아있는 생명을 고문하는 사람이 아니야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0078_Text
msgctxt "fe4d075e-9819-44ba-8187-ed47c97fba20"
msgid "\"Your potion made the dog go mad and attack me!\""
msgstr "\"네 포션이 개를 미치게 했고 나를 공격했어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Answer_0081_Text
msgctxt "f128d9cb-d289-4d93-8aef-ccbc924cc581"
msgid "\"I didn't get to torment the wererat with your toxic potion.\""
msgstr "\"난 당신의 독약으로 웨어랫들을 고문하지 않았어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0001_Text
msgctxt "6c6b107f-7a38-47cb-9a4d-a235fb51723a"
msgid ""
"{n}{d|Bokken}Bokken{/d} looks tired and haggard. His face is grey, his brow "
"furrowed, and his eyes shine with a feverish glow.{/n} \"Who's there? What "
"is it?\""
msgstr ""
"{n}{d|Bokken}보큰{/d}은 피곤하고 지쳐 보입니다. 얼굴은 회색빛이었고 이마는 깊이 주름졌습니다. 눈은 광기로 빛납니다.{/n}"
" \"거기 누구요? 무슨일이오?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0002_Text
msgctxt "b1f809c6-9faf-4c3d-b8f3-ab929f79f0f0"
msgid ""
"\"Oh, it's you! How convenient! I need your help – we have to run some tests…"
"\""
msgstr "\"오, 오셨군요! 때마침 잘 왔소이다! 여러분들의 도움이 필요합니다. 몇 가지 시험을 해야하거든요.\"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0007_Text
msgctxt "35125975-846d-4e91-ad84-22ba5733ed1a"
msgid ""
"\"I've found the formula! All on my own! These damned books didn't have it – "
"nothing but hints and half-truths there. But you can't fool old Bokken that "
"easily, he he heh…\""
msgstr ""
"\"내가 공식을 찾았어요. 내 스스로 말이지! 이 망할 책들에는 없었어요. 그저 작은 힌트들과 반쪽짜리 진실만 있었을 뿐. 하지만 이 "
"늙은 보큰님은 똑똑하다고. 헤헤헤...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0020_AlignmentShift.Description
msgctxt "a91c80d0-db53-4264-9ea2-02c717c143c6"
msgid "Lied to Bokken about the experiment."
msgstr "실험에 관해 보큰에게 거짓말을 했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0020_Text
msgctxt "ee59493b-14af-4492-828b-fde4fcbc06bd"
msgid ""
"\"Is that so? Hmm… The wererat simply died, and the mutt gone rabid… You "
"see, my potion wasn't meant to do anything with the mind. Only the body!\""
msgstr ""
"\"그런가요? 흠... 쥐인간은 그냥 죽어버렸고, 개는 광견병에 걸렸다라... 자 보시다시피, 내 물약은 정신에는 어떤 영향도 미치지 "
"않았어요. 신체에만 영향을 미치지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0022_Text
msgctxt "ad6bb7d5-d592-4e78-98ed-debbdead1eba"
msgid ""
"{n}Bokken squints his eyes, looking at you with barely hidden irritation.{/n}"
" \"You lie... I can smell a lie when I hear one!\""
msgstr "{n}보큰이 눈을 찌푸리고는 화를 감추며 당신을 봅니다.{/n} \"거짓말을 했군... 거짓말이 느껴져!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0023_Text
msgctxt "29195abf-635e-424b-b4bf-bdb298d23458"
msgid ""
"{n}Bokken blinks at you, clearly surprised.{/n} \"Orange saliva? But wait… "
"what's that, then? This potion wasn't meant to make such changes to the "
"body...\""
msgstr ""
"{n}보큰은 놀라서 눈을 깜빡입니다.{/n} \"주황색 타액? 하지만... 잠깐만...그게 뭐지? 이 포션은 신체에 그런 영향을 끼치지 "
"않을텐데...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0025_Text
msgctxt "f7716d3a-6c6f-4a32-ab85-9a67f2b30b49"
msgid "\"Well?\""
msgstr "\"음?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0031_Text
msgctxt "22005d21-3102-40ee-b900-98a85e6bd43c"
msgid ""
"{n}The old man's eyes are beginning to clear. It seems that he's coming back "
"to his senses.{/n}"
msgstr "{n}노인의 눈빛이 깨끗해집니다. 제정신이 드는 것 같습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0037_Text
msgctxt "7120b5e6-a725-43d6-940e-12395711c41f"
msgid ""
"\"We'll need to go for one final test, it seems. We must try the potion on a "
"human. An elf would do just fine as well. Or a dwarf... or…\""
msgstr ""
"\"이제 마지막 시험을 해봐야 할 것 같군요. 우리는 사람에게 물약을 먹여야 합니다. 엘프도 괜찮습니다. 아니면 드워프나... 아니면…\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0038_Text
msgctxt "04658513-6026-4fb7-8a02-88bb39323df4"
msgid ""
"\"Why would I? Though I can hear you clear as day… Now, what was I saying, "
"then? Oh, right – the formula!\""
msgstr "\"내가 왜 그랬겠어요? 말하는게 똑똑히 들리긴 하지만요... 자, 무슨 말을 하고 있었더라? 오, 그래. 공식!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0039_Text
msgctxt "e3a39385-e6fe-4cfe-b63b-d283dad65fd1"
msgid ""
"\"The elixir of eternal youth! A most wondrous brew – restores the strength "
"in one's hands and the swiftness in one's feet. I first heard of it when I "
"was still just a lad, and I didn't believe in it. But now I've lived a long "
"life, and I've seen even stranger things. So I thought: why not give it a "
"try?\""
msgstr ""
"\"영원한 젊음의 엘릭서! 손에는 힘이 들게 하고 발은 빨라지게 하죠. 젊었을 때 이 이야기를 첨 들었을땐 믿지 않았어요. 하지만 이제 "
"난 오랜 삶을 살았고 별별 이상한 것들도 많이 보았죠. 그래서 이런 생각이 들더군요 '한번 도전이라도 해볼까?'\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0040_Text
msgctxt "4c7fa8d1-c9b1-4cc7-b58d-35174478f651"
msgid "\"What… what happened?\""
msgstr "\"무슨 일이 일어난거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0045_Text
msgctxt "6c2af4f2-a8e8-418c-903f-972b3a4aface"
msgid ""
"\"Oh, please, forgive me, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}! How the devil… It's all that damned potion's fault, I swear! It "
"stole my mind, that wasn't me, I swear…\""
msgstr "\"오. {mf|영주님|영주님|전하|전하} 나를 용서해 주시오. 모두 포션 때문이라오. 정말이오! 정신이 나갔었소. 정말이오...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0049_Text
msgctxt "39c4b853-49af-4ceb-9c65-444a3ad71910"
msgid "\"Gods… Forgive an old man. I didn't know what I was doing…\""
msgstr "\"세상에... 이 늙은 영감을 용서하십시오. 내가 무슨 짓을 하는지도 몰랐습니다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0050_Text
msgctxt "adbf1826-38d4-45a8-b5f8-4aeebeb9db00"
msgid ""
"{n}Bokken wipes the sweat off his brow.{/n} \"I never thought that potion "
"could work in such a way… but still, it does seem to make one stronger! "
"Thank you for all your help! Now I know how to iron out the wrinkles – I "
"think…\""
msgstr ""
"{n}보큰은 이마의 땀을 닦습니다.{/n} \"물약이 그렇게 작동할 줄은 전혀 몰랐소... 그래도 물약이 힘을 강화해 주는 것 같아요! "
"도와줘서 고맙소! 이제 주름을 펴는 법을 좀 알것같아요..아마도..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0051_Text
msgctxt "0de1fe9b-4047-4569-92cf-e8832fa007aa"
msgid ""
"\"So I asked you to find these books for me. – I'd heard that one of the "
"volumes contains a formula. Well, it turns out they don't. All they do is "
"make things clear as mud. Still, I was able to find something useful in "
"there… I can't remember how many nights I stayed up working on the solution, "
"but here it is!\" {n}Bokken proudly shows you a few vials filled with "
"silvery liquid.{/n}"
msgstr ""
"\"그래서 이 책들을 찾아달라고 부탁했던거죠. 이 책들 중에 공식이 적혀있다고 들었거든. 뭐 결국 사실이 아닌 걸로 드러났지만. 책들에 "
"적혀있는건 오히려 일을 더 복잡하게 만들뿐이었소. 그래도 거기서 뭔가 쓸만한 것을 찾을 수 있었지요.. 해결책을 찾기 위해 며칠 밤을 "
"새웠는지 기억도 안나지만.. 자, 여기를 보십시오!\" {n}보큰은 은색 액체가 담긴 유리병 몇개를 자랑스럽게 보여줍니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0052_Text
msgctxt "ae418447-3cb3-4cd0-bf28-c7ec8e2ecb28"
msgid ""
"\"Can't drink it yet, though. Must test it first… Can't be too careful with "
"these things.\" {n}Bokken gives you an expectant look.{/n} \"So will you "
"help me?\""
msgstr ""
"\"그래도 아직 마실 수는 없어요. 먼저 시험해봐야 합니다. 이런 것들을 아무리 주의해도 지나치지 않는 법이죠.\" {n}보큰은 기대되는 "
"표정으로 당신을 봅니다.{/n} \"그럼 도와주실 건가요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0056_Text
msgctxt "045c5b05-b628-42ee-a8e3-8e05fefed675"
msgid ""
"{n}Bokken is almost shaking with indignation.{/n} \"So that's how it is, is "
"it?! That mischievous schemer… Fine. I'll just make it on my own. It won't "
"be the first time!\""
msgstr ""
"{n}보켄은 분개하여 거의 떨고 있습니다.{/n} \"그렇단 말이지?! 그 못된 방해꾼같은 여자가… 좋아. 그냥 나 혼자 힘으로 "
"만들겠소. 앞으로도 그럴꺼고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0057_Text
msgctxt "e0ec53a0-70f3-414e-b2e2-57cfaff5f18e"
msgid ""
"\"Wonderful! Thanks for that! Let's try it on a dog first. There's a mutt on "
"a leash around the corner… you can test the stuff on it. I won't feel bad "
"for it if something goes wrong! That'll teach it to stop barking at me every "
"time I pass by! I could do it myself, but what if it's off the leash? It "
"won't harm you as it would harm me!\""
msgstr ""
"\"완벽해! 고맙소. 우선 개에게 실험해보지. 구석에 줄에 묶인 개가 있소... 우선 개에게 실험해보시오. 일이 잘못되어도 괜찮소! "
"앞으로는 내 앞을 지날 때 내게 짖지 않겠지! 내가 직접 할 수도 있지만 줄이 풀리면 어떻게 하오? 최소한 내가 다치는만큼 당신들도 "
"다치진 않을꺼 아니오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0062_Text
msgctxt "cb58a796-8016-47df-961d-f268b26148cf"
msgid ""
"{n}Bokken takes a small glass vial from his pocket. He exhales sharply, "
"takes a few gulps – and the vial is empty!{/n}"
msgstr ""
"{n}보큰은 주머니에서 작은 유리병 하나를 꺼냅니다. 그는 날카롭게 숨을 내쉬고는 몇 번 꿀꺽꿀꺽 들이켭니다. 병은 비었습니다!{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0074_Text
msgctxt "ebb31103-fd01-4c26-8a79-5699c74b883e"
msgid ""
"{n}Backing away in terror, Bokken whispers, his voice barely audible.{/n} "
"\"Thank you for your help! Now I know what's wrong with the formula. I can "
"take it from here…\""
msgstr ""
"{n}공포에 질려 물러난 보큰은 작은 목소리로 속삭입니다.{/n} \"도와주셔서 감사합니다! 이제 공식이 뭐가 잘못됐는지 알겠네요.. "
"어디 보자...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0076_Text
msgctxt "fe2f73f5-146b-4377-918f-72e7bc31f03e"
msgid ""
"{n}Bokken is practically shaking with indignation.{/n} \"So that's how it "
"is, is it?! Fine. I'll just make it on my own. Won't be the first time!\""
msgstr ""
"{n}보켄은 분개하여 거의 떨고 있습니다.{/n} \"그렇단 말이지?! 좋아. 그냥 나 혼자 힘으로 만들겠소. 앞으로도 그럴꺼고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0079_Text
msgctxt "b7e9bd39-48eb-4e08-80a4-7d9aae94f708"
msgid ""
"\"To the demons with the dog. We need someone more human to experiment on. "
"Know what? My neighbor, a hunter, once told me he saw wererats in a forest "
"not far from here. They'd make better test subjects. After all, they're "
"closer to humans than a dog. We should find them and try again... but take "
"this vial. This potion has a different, improved formula.\""
msgstr ""
"\"개는 때려치웁시다. 좀더 인간에 가까운 실험체가 필요해요. 내 이웃 중에 사냥꾼이 있는데 여기서 멀지않은 숲에서 쥐인간을 봤다고 "
"하더군요. 더 좋은 실험체가 될 게요. 개보다는 인간에 가까우니깐요. 그들을 찾아 다시 실험해봅시다..그리고 이 병을 받아요. 이건 "
"개선된 공식을 적용한 포션이거든요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/BokkenAngry/Cue_0080_Text
msgctxt "f2d1cbc8-dfb8-4e45-9aef-638d1b08b597"
msgid "\"A mad dog? Sounds wrong, very wrong... I must have made a mistake.\""
msgstr "\"개가 미쳤다고? 이런... 실수한 게 틀림 없군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/Items/Book1_Description_String
msgctxt "072fbf2d-b1e2-40ae-a167-042e2cf21fa4"
msgid ""
"\"Alchemy is the triune science of: primes, or basic elements, of which all "
"things are composed; forces, by which those things are set in motion; and "
"families of all such things which a studious mind can perceive in our world. "
"An art most formidable, it grants its practitioner power over nature, and "
"even over that which beyond nature lies; he who has mastered it fully shall "
"become like the gods, yet woe be unto he who sets about its study without "
"diligence and zeal, for his days are numbered. The path ahead is perilous "
"and arduous in equal measure, and he who sets his foot upon it heedlessly "
"shall not find wisdom, but only a quick and grisly end.\""
msgstr ""
"\"연금술은 복잡한 학문이다. 원리와 기본 원소 같은 것들과 움직임 속에 들어있는 힘 같은 것들은 지각있는 자들이 이해할 수 있는 "
"것들이다. 연금술은 자연을 뛰어넘는 힘을 주고 자연 그 자체를 초월할 수도 있다. 연금술을 완벽하게 익힌 자는 신과 같이 된다. 하지만 "
"그런 경지에 이르면 열정을 잃고 만다. 연금술의 길은 힘든 것이지만 섣부르게 행동하는 자는 지혜를 찾지 못하고 결국 실패한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/Items/Book1_Name_String
msgctxt "b52e462d-c2ed-43b8-a5f9-088870d67e9c"
msgid "\"Of Transmutations and Bodily Poisons\", Part I"
msgstr "\"변형과 신체에 치명적인 독에 관해\", 1부"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/Items/Book2_Description_String
msgctxt "688d5dc2-5932-4796-b537-4258954ce51a"
msgid ""
"\"Truly blessed and enlightened is that learned man or wise woman whose gaze "
"has pierced the mysteries of alchemy. This path fortifies the spirit, "
"sharpens the mind and teaches temperance in all things. Even the petty and "
"the shallow have, through ardor in their pursuit of alchemical knowledge, "
"achieved virtue. Yet nevertheless, this art is not without its dangers. An "
"alchemist who turns to imbibing his own concoctions, as is custom among the "
"young and impatient, may wreck havoc upon his very nature. For a potion is "
"not merely a concoction, but a mixture of primes, which the naked eye cannot "
"see. These basic elements of spirit, once they take root within, may "
"intermingle and converge, and through their union poison the soul, compel "
"deeds most disgraceful, or excite with the temper of a demon...\""
msgstr ""
"\"진정으로 축복 받고 계몽된 자들은 연금술의 신비에 관심을 가지는 자들이다. 이 길은 영혼을 단련하고 정신을 날카롭게 하며 모든 일에 "
"인내심을 갖게 한다. 아무리 무식한 자라도 연금술 지식을 추구하는 열정만 있다면 덕을 얻었다. 하지만 이 학문은 위험이 따른다. 자신이 "
"만든 약물을 섭취하는 연금술사들은 대개 어리고 인내심 없는 자들이며 자신을 파괴하기에 이른다. 포션은 단순한 약물이 아니며 원리들을 "
"바탕으로 한 혼합물이고 겉으로 봐서는 그것을 구별할 수 없다. 연금술의 기본 요소들은 얽히고 섞여서 독을 만들 수 있고 그것은 불명예를 "
"일으키는 원인이 되거나 데몬의 물건이 된다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/Items/Book2_Name_String
msgctxt "cb9c3bf1-4cae-4f3c-ae1a-89f2bea7340b"
msgid "\"Of Transmutations and Bodily Poisons\", Part II"
msgstr "\"변형과 신체에 치명적인 독에 관해\", 2부"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/Items/Book3_Description_String
msgctxt "14cc2786-9c5d-4f81-9a0c-f9f385a39e85"
msgid ""
"\"All matter is, in itself, both poison and cure – like water, which lies at "
"the foundation of every process. All living things perish without water; all "
"living things shall drown if in water submerged, for even a fish leaps from "
"its lake each day to breathe in the air. All other matter succumbs to this "
"universal law. That which the unlearned call poison is only the measure of a "
"substance that the body which imbibes it cannot overcome. However, if "
"diluted threefold, fivefold, even tenfold, that same substance may affect "
"the body much differently, strengthening or cleansing it. Therefore, not "
"every poison-maker is a villain, as is often believe among the common herd. "
"The art of handling poison is neither dark nor evil in itself...\""
msgstr ""
"\"가장 중요한 것은 독과 해독제이다. 마치 모든 생명 활동의 근본이 물인 것처럼. 살아있는 모든 것들은 물이 없다면 죽는다. 모든 "
"살아있는 것은 심지어 물고기라도 물 속에 들어가면 숨을 쉬기 위해 표면으로 올라온다. 다른 모든 것은 이 기본적인 법칙이 깔려잇다. "
"알려지지 않은 독은 그것을 흡입한 신체가 극복하지 못한 물질일 뿐이다. 하지만 세배, 다섯배, 열배 희석하면 같은 물질도 신체에 다르게 "
"반응하여 해독을 하거나 독의 작용을 강화할 수 있다. 그러므로 일반적으로 받아들여지듯 독을 만드는 모든 사람이 악당인 것은 아니다. 독을 "
"다루는 학문은 그 자체로 악도 암흑도 아니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/Items/Book3_Name_String
msgctxt "befcb0ca-57d3-47d3-bf83-b67531a5e898"
msgid "\"Of Transmutations and Bodily Poisons\", Part III"
msgstr "\"변형과 신체에 치명적인 독에 관해\", 3부"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/Items/SvetlanasLetter_Description_String
msgctxt "bc8bb5d4-f0ea-4960-b0ba-4541fa3714e1"
msgid ""
"\"Your {mf|Grace|Grace|Highness|Highness}, I hope that matters of state in "
"this land of ours are indeed all fine and well – and what troubles there are "
"don't weigh too heavily upon your mind! I write to ask you to check our "
"local herb doctor, Bokken. The poor old man is losing his mind. – He spends "
"all day and night stooped over his cauldron! He looks about to lash out at "
"anyone, especially those he doesn't know. He even snarls at me and Oleg, "
"which he'd never have let himself do before... Please come and see him "
"before the old codger loses his mind completely, may Erastil save him. We've "
"no one to turn to but you!\n"
"Hoping you come as soon as possible, I remain,\n"
"Very truly yours,\n"
"Svetlana Leveton\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 당신의 통치가 순조롭기를 바랍니다. 문제가 발생하더라도 당신께 큰 짐을 지우지 않길 바랍니다. 이 "
"편지를 쓴 이유는 우리 동네 약초 의사 보큰을 살펴봐 달라고 부탁드리기 위해서입니다. 그 불쌍한 노인은 정신을 일고 있어요... 밤낮으로 "
"솥단지에 몸을 기댄 채 지내고 있습니다! 특히 모르는 이가 지나갈 때면 너무나도 공격적으로 반응합니다. 심지어 저와 올렉에게까지 화를 "
"냈습니다... 이 노인이 완전히 미쳐버리기 전에 그를 살펴주세요... 에라스틸께서 그를 보살피시기를... 당신 말고 의지할 사람이 "
"없습니다!\n"
"가능한 빨리 와주시길 바라며 기다리겠습니다.\n"
"진정한 당신의 백성,\n"
"스베틀라나 레베튼\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/Items/SvetlanasLetter_Name_String
msgctxt "417bcb2f-d370-461f-8593-11d4824ad057"
msgid "A Letter from Svetlana Leveton"
msgstr "스베틀라나 레베튼이 보낸 편지"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Answer_0004_Text
msgctxt "1b814f1d-6b06-40da-915c-ac5a3dc46124"
msgid "\"Thank you. This will prove useful. You may go now.\""
msgstr "\"고마워. 유용할 거야. 이제 가도 좋아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Answer_0005_Text
msgctxt "d75b66c3-b246-439f-b93d-5ea64b14cbe0"
msgid "\"I no longer require your services, Bokken.\""
msgstr "\"나는 네가 더 이상 필요 없어. 보큰.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Answer_0006_Text
msgctxt "f9f31a6f-6c5e-4e80-8f4f-6dfa21d15f7b"
msgid "\"I would like you to craft something specific.\""
msgstr "\"특별한 것을 만들어줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Answer_0011_Text
msgctxt "8c8a547b-e3fd-4125-b899-7ca609b4dbd1"
msgid "\"I'm running low on potions.\""
msgstr "\"포션이 바닥났어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Answer_0012_Text
msgctxt "a1cac896-e232-4ae2-8f0b-3bd6218e4529"
msgid "\"I need more of your oils and ointments.\""
msgstr "\"더 많은 기름과 연고가 필요해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Answer_0013_Text
msgctxt "265fc802-146a-48b1-8b21-fd03763498c2"
msgid "\"I could use another one of your alchemical items.\""
msgstr "\"너의 다른 연금술 물품을 사용하고 싶어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Answer_0014_Text
msgctxt "757f7f47-9b5f-4895-a842-2bf4429e5eed"
msgid ""
"\"On second thought, I've changed my mind. Just make whatever you think will "
"turn out best.\""
msgstr "\"잘 생각해보니, 마음이 바뀌었다. 당신의 생각이 무엇이든 최선이 되게끔 하자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Answer_0031_Text
msgctxt "d21019f9-c410-4fa3-90a6-a634cc8104f8"
msgid "\"Remind me, who you are and what are you working on?\""
msgstr "\"누구였더라..그리고 무슨 일을 하는지 다시 알려주겠어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0001_Text
msgctxt "883b00ae-1abe-4d38-bee5-0ab101d98643"
msgid ""
"{n}Unfazed by the awkward silence, {d|Bokken}Bokken{/d} searches through his "
"bag for quite a while. Finally, he pulls out a sizeable brown paper "
"package.{/n} \"There you go. A little something from old Bokken.\""
msgstr ""
"{n}어색한 침묵에 주눅들지 않고, {d|Bokken}보큰{/d}은 잠시 동안 그의 가방 안을 뒤졌습니다. 마침내 그는 갈색 포장지로 "
"싸인 제법 크기가 있는 상자를 꺼냈습니다. {/d} \"여기 있소. 늙은 보큰이 주는 작은 선물이오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0002_Text
msgctxt "091659c0-7ecc-4c77-bba5-b75f62923781"
msgid ""
"\"If you ever need anything in particular, just let me know. If you're not "
"sure, I'll go home and think of something myself. My bones ache.\""
msgstr "\"특별히 필요한 것이 있다면, 알려주시오. 뭐 잘 모르겠다면 집에 가서 알아서 생각해보리다. 내 뼈가 시리거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0007_Text
msgctxt "83f81df8-949f-474b-8531-ed71732f6c78"
msgid ""
"\"My pleasure.\" {n}Bokken gives you a sideways look, then turns his eyes to "
"the ceiling.{/n} \"I only hope that no one throws it away or leaves it to "
"rot in some old chest. Oh well…\""
msgstr ""
"\"천만의 말씀이오.\"{n}보큰은 당신을 곁눈질하더니, 이내 그의 눈은 천장을 향합니다.{/n} \"단지 그것을 버리거나, 오래된 상자 "
"속에 쌓아두지 않길 바랄 뿐이오. 후우...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0008_Text
msgctxt "c26776ad-7573-4a0a-8b8b-0c554321ea74"
msgid ""
"{n}Bokken nods and pulls a piece of coal and a scrap of paper from his "
"sleeve. He takes his time smoothing it out before giving another solemn "
"nod.{/n}"
msgstr ""
"{n}보큰은 고개를 끄덕이며, 그의 소매에서 한 덩이의 숯과 종이 뭉치를 꺼냈습니다. 그는 또 한 번 엄숙하게 고개를 끄덕이기 전에 "
"시간을 들였습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0009_Text
msgctxt "e53d6db1-a50e-407e-8e45-122a3589bdff"
msgid ""
"{n}Bokken frowns and sticks out his lower lip.{/n} \"What, one of your "
"lackeys spit in your porridge this morning? What did the old man do this "
"time? I bring you a present, and you send me away. You city-folk are a bad "
"lot, I tell you...\""
msgstr ""
"{n}보큰은 얼굴을 찌푸리며 아랫입술을 내밀었습니다.{/n} \"이런, 당신은 종자 가운데 하나가 오늘 아침에 당신의 죽 그릇에 침을 "
"뱉었나 보오? 그 시간에 늙은이는 뭐 했습니까? 저는 당신에게 선물을 가져다 주고, 당신은 나를 보내겠지요. 당신같은 도시민들은 아주 "
"나쁘다니까, 제가 당신에게 말한...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0016_Text
msgctxt "ab6d9fe7-ed81-471e-9608-30a4d7a15c91"
msgid ""
"{n}Bokken carefully writes something down on his scrap of paper.{/n} \"Very "
"good. And if you want to buy anything else – just come around.\""
msgstr ""
"{n}보큰은 심혈을 기울여 그의 한 뭉치의 종이 위에 무언가를 적어내려갔다.{/n} \"아주 좋소. 더 사고 싶은 것이 있다면 오시구려."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0018_Text
msgctxt "abec31a5-d84b-427c-92f1-6f4c8d944720"
msgid ""
"{n}Bokken picks his ear with the piece of coal, and hides it and the paper "
"back in his sleeve.{/n} \"My choice, then? Fine.\""
msgstr ""
"{n}보큰은 숯 조각을 그의 귀에 끼우고선, 종이 다발을 다시금 그의 소매에 집어넣었습니다.{/n} \"내 선택이군, 그렇지 않소? 좋아."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0019_Text
msgctxt "9b35424a-9e4a-4094-9b98-fd982f476c64"
msgid ""
"{n}{d|Bokken}Bokken{/d} looks different today. His pace is slow and solemn, "
"his back proudly straight… It seems that he's even put on a different robe – "
"though it doesn't look any newer or cleaner than his normal one.{/n}"
msgstr ""
"{n}{d|Bokken}보큰{/d}은 오늘 조금 달라 보입니다. 그의 걸음걸이는 느리고 근엄하며, 그의 등은 꼿꼿이 서 있습니다... "
"심지어 그가 입은 로브는 그가 평소에 입는 것보다 새것이거나 깨끗한 것이 아닌 것 같아 보임에도, 무언가 다른 것을 입은 것 같아 "
"보입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0020_Text
msgctxt "21e4cc03-3191-4f90-8335-a23d38abcf21"
msgid "\"Perfect! You won't regret this!\""
msgstr "\"완벽해! 후회하지 않을 것이오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0022_Text
msgctxt "73f273fb-f590-4ec6-b60a-599d27fe29b1"
msgid ""
"\"Oh, and while I'm here… There's a book that I've always wanted to read. "
"'Of Transmutations and Bodily Poisons'. In three volumes. If you were to "
"find it for me, I could produce something… most remarkable for you. "
"Something that might even…\" {n}Bokken cuts himself short.{/n} \"Oh well, "
"there's no use in empty words. But they say there's an ancient formula "
"hidden in one of these books. Bring me the books, and I'll brew the potion "
"for you.\""
msgstr ""
"\"오, 내가 여기 있는 동안... 내가 언제나 읽고 싶었던 책이 있소. '변형과 신체에 치명적인 독에 관해'라는 세 권짜리 책이라오. 내게 "
"그것을 찾아다 준다면, 무언가 당신이 가장 놀라워할만한 것을 만들어주겠소... 그것은 정말...\" {n}보큰은 그 말을 잘랐다.{/n} "
"\"그래, 빈말에는 아무 소용이 없지. 그러나 사람들은 그 책들 가운데 고대의 숨겨진 조합식이 있다고들 말하오. 내게 책을 가져다주시오, "
"그러면 당신을 위해 포션을 만들어 드리지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0024_Text
msgctxt "e20326e5-df33-4c4e-a956-f257a9db57b1"
msgid ""
"\"I know that the Old Beldame – the old witch who lives in the swamp – had "
"one of these volumes in her hut, gathering dust. She must still have it for "
"sale, I imagine. As for the other two volumes, I have no idea. You might "
"look in a magic shop. Or in the bookcases and locked drawers of other "
"alchemists, if you happen to across their possessions in your adventures.\" "
"{n}Bokken grins, bows to you and leaves the throne room with a shuffling "
"walk.{/n}"
msgstr ""
"\"그 중 한 권은 늪에 사는 늙은 마녀인 마귀 할멈의 오두막에 놓여 먼지를 먹고 있는 걸로 알고 있소. 아마 돈을 준다면 살 수 있을 "
"거요. 다른 두 권에 대해서는 나는 전혀 아는 바가 없소. 어쩌면 마법 상점에서 팔 수도 있겠지. 아니면 다른 알케미스트의 책장이나 "
"잠겨진 옷장 속을 뒤져봐야 할지도. 만약 모험 중에 그런 곳을 털 일이 있다면 말이오.\" {n}보큰은 슬쩍 웃으며, 당신에게 고개를 "
"숙이고는 왕좌의 방에서 발을 질질 끌며 떠나갔다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0025_Text
msgctxt "81fcf459-d389-49da-998a-897ed718287c"
msgid ""
"\"Here it is, the potion! The things I had to go through to get this made… "
"Sure, it doesn't bring back one's youth, but it does strengthen the body, "
"sharpen the mind and embolden the spirit! And doesn't affect one's temper "
"any longer, ha ha.\""
msgstr ""
"\"이게 바로, 그 물약이오! 이것을 만들기 위해 내가 했던 모든 것들은... 그렇지, 이것은 젊음을 다시 가져다주지는 않지만, 신체를 "
"강하게 하고, 정신을 날카롭게 만들며 영혼을 대담하게 한다오! 아, 그리고 더 이상 성격에 영향을 미치지는 않소, 하하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0027_Text
msgctxt "7a602b88-daf1-4dec-a594-8b6d523736f0"
msgid ""
"\"And one more thing… You remember that potion you helped me test?\" {n}"
"Bokken gives you a conspiratorial wink.{/n} \"Well, it's almost ready! I got "
"rid of all the rot that was spoiling the formula, and now it works just "
"fine. I just need to brew a large enough dose, and that takes time. Unless "
"you have another assignment for me, you'll have the elixir the next time we "
"meet!\""
msgstr ""
"\"그리고 한 가지 더... 내 물약 실험을 도와줬던 게 기억나시오?\" {n}보큰은 당신에게 무언가 모의하는 듯 윙크를 했습니다.{/n}"
" \"그게, 이제 거의 준비되었소! 부작용을 일으키는 모든 재료들을 조합식에서 제거했고, 이제는 아주 잘 작용하오. 단지 복용에 충분할 "
"만큼을 증류시키면 되는데, 시간이 걸린다오. 당신이 내게 또 다른 일을 시키지 않는다면, 다음에 뵐 때쯤엔 그 묘약을 만들 수 있을 "
"것이오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0029_Text
msgctxt "8e69464d-a64b-4ef6-be68-e701f51eab01"
msgid "\"I do hope this helps.\" {n}Bokken smiles and bows to you.{/n}"
msgstr "\"이것이 도움이 되었으면 하오.\" {n}보큰은 웃으며 당신에게 고개를 숙였다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0030_Text
msgctxt "27e35def-f0e4-49c4-a212-fb2b672a3c28"
msgid ""
"\"Try the potion, won't you? It's the best I've ever brewed! My life's work, "
"one could say.\" {n}Bokken smiles and bows to you.{/n}"
msgstr ""
"\"물약을 복용해 보시지 않으시겠소? 내가 만든 것 중 최고라오! 내 일생의 역작이라 할 수 있소.\" {n}보큰은 웃으며 당신에게 "
"고개를 숙였다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_ArtisanGift/Cue_0032_Text
msgctxt "604831e5-b00a-4b25-9ac2-a12b7bd2a570"
msgid ""
"\"It's me, good old Bokken. And they say old men get poor memories, hah! I'm "
"your humble alchemist. I brew potions and oils, and study ancient formulas "
"for transmutation. I'm going to make a very special elixir once my studies "
"are complete. One that'll refine your spirit, and mind, and body alike!\""
msgstr ""
"\"나요. 착한 늙은이 보큰. 나이가 들면 기억력이 안좋다고들 합디다. 하! 난 당신의 보잘것없는 연금술사요. 물약과 기름을 만들고, "
"고대의 변이 공식을 연구하지. 연구가 완성되면 아주 특별한 영약를 만들어 볼 생각이오. 당신의 정신과 마음 그리고 육체를 골고루 개선시켜 "
"줄꺼요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_EE_StatGift_Bokken/Cue_0001_Text
msgctxt "b7aa470c-678c-4840-8814-852c184110bb"
msgid ""
"\"Good day! I came to tell you that I'm doing fine in my little shop. Our "
"folk love their ruler, and if their beloved {mf|baron|baroness|King|Queen} "
"buys old Bokken's potions, he's certainly a worthy alchemist!\""
msgstr ""
"\"안녕하시오! 나는 내 작은 가게에서 잘 지내고 있다고 말씀드리러 왔소. 우리 백성들이 사랑하는 {mf|남작|여남작|왕|여왕}께서 "
"보큰의 물약을 사주시니, 이 늙은이가 쓸모 없는 연금술사는 아닌가 보오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_EE_StatGift_Bokken/Cue_0002_Text
msgctxt "0ac4fa04-0855-4c2e-a3f3-e5a2d7054490"
msgid ""
"\"Ha, greetings, {mf|baron|baroness|my King|my Queen}! I'm drowning in "
"orders these days, and barely have time to do them all. My regular clients "
"have mostly been peasants and hunters, but arcanists are showing up from "
"time to time. Not only do they pay me for potions, but they also help me "
"create some of them.\""
msgstr ""
"\"하, 안녕하시오, {mf|남작|여남작|왕|여왕}! 나는 최근 들어 주문 용지에 파묻히는 바람에, 그걸 처리하느라 눈코 뜰 새가 없소. "
"보통 농민들과 사냥꾼들이 주 고객이지만, 때때로 비전학자들이 찾아오기도 한다오. 내게 포션을 사갈 뿐만 아니라, 만드는 걸 도와주기도 "
"하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_EE_StatGift_Bokken/Cue_0003_Text
msgctxt "f95db065-3c4e-4570-8072-be6bf6571c0d"
msgid "\"Here's the gift for you on this occasion.\""
msgstr "\"여기, 이번에 드릴 선물이오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_JhodGetArtisan/Cue_0001_Text
msgctxt "7607a210-5574-435c-90c8-673e81a7f9f3"
msgid ""
"\"Your grace, I was at Oleg's trading post recently, and I noticed old "
"{d|Bokken}Bokken{/d} just standing there, bored to death with nothing to do. "
"This is most unfortunate – after all, the old grumbler is a very "
"knowledgeable alchemist! However, he has no use for his skills, since the "
"locals need nothing more than the simplest of healing potions.\""
msgstr ""
"\"영주님, 저는 최근에 올렉의 교역소에 있었고, 거기서 가만히 서서 할 일이 없어 지겨워하는 늙은 {d|Bokken}보큰{/d}을 "
"목격했습니다. 이것은 정말 불행한 일입니다. 그 늙은 불평꾼은 아주 박식한 알케미스트이니 말입니다! 하지만 주민들은 간단한 치료 물약 "
"정도만 필요로 하기 때문에, 그의 기술이 낭비되고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_JhodGetArtisan/Cue_0002_Text
msgctxt "facf300a-0a00-416f-8ece-0d1b20332cd0"
msgid ""
"\"And then it struck me – why don't you hire him as your court alchemist? "
"His decoctions and tinctures would certainly prove most useful to you. Also, "
"it might be cheaper than simply buying from him or some other merchant.\""
msgstr ""
"\"그러다 문득 생각이 났습니다 - 당신께선 왜 그를 궁정 알케미스트로 기용치 않으시는지요? 그의 조제약과 탕약들은 확실하게 당신에게 "
"도움이 될 것입니다. 또한, 단순히 그런 것들을 그나 다른 상인에게서 구매하는 것보다 저렴할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/KTC_LinziBringsLetter/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "9b222b4b-166b-46e3-aaf9-7e4cb90976c8"
msgid ""
"\"Why, would you look at that! Svetlana sent you a letter! It seems she's "
"worried about old {d|Bokken}Bokken{/d}. – The letter is very emotional!\""
msgstr ""
"\"저것 좀 봐주세요! 스베틀라나가 편지를 보내왔어요! 늙은 {d|Bokken}보큰{/d}에 대해서 걱정하는 것 같아 보이네요... "
"편지의 내용이 너무 감정적이에요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestDog/Answer_0003_AlignmentShift.Description
msgctxt "42ef8207-cecb-4856-8d5b-0a757d1144e0"
msgid "Experimented on the dog with Bokken's potion."
msgstr "보큰의 물약을 개에게 실험하였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestDog/Answer_0003_Text
msgctxt "4046c942-e72a-4854-8218-c72fede845e7"
msgid "[Pour the potion into the dog's mouth]"
msgstr "[개의 입에 포션을 쏟아 넣는다]"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestDog/Answer_0004_Text
msgctxt "9da8bb51-f735-4039-8eeb-c5c401ed7ca6"
msgid "[Leave]"
msgstr "[떠난다]"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestDog/Answer_0005_AlignmentShift.Description
msgctxt "89ee20c5-a862-427f-848e-e0201923b2fe"
msgid "Let the dog run away instead of testing the strange potion on him."
msgstr "개에게 이상한 물약을 실험하는 대신, 풀어 달아나게 했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestDog/Answer_0005_Text
msgctxt "c63e1c06-1220-4e74-b566-dd39ba36a1b0"
msgid "[Untie the dog and let him go]"
msgstr "[개를 풀어줘서 도망치게 한다]"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestDog/Cue_0001_Text
msgctxt "b54b0d90-d165-4a00-bad7-1b7c4a5b8d0d"
msgid ""
"{n}It's a typical street dog on a leash with a dirty yellow coat. Its watery "
"eyes regard you without particular interest.{/n}"
msgstr "{n}더러운 노란색 털의 길거리 어디서나 흔히 볼 수 있는 개입니다. 그 촉촉한 눈망울로 무심하게 당신을 바라봅니다. {/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Answer_0004_Text
msgctxt "2a53cfdc-e291-4777-b4f7-60709bf87dc5"
msgid "\"Wait! I come in peace!\""
msgstr "\"기다려! 난 싸우려 온게 아냐!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Answer_0005_Text
msgctxt "474a9d4d-43a0-44ab-b8a8-531b855849e1"
msgid "\"Easy, easy. We can always fight later. Let's talk first.\""
msgstr "\"진정해, 진정. 우린 나중에 얼마든지 싸울 수 있어. 먼저 이야기부터 하자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Answer_0006_Text
msgctxt "64184de5-ed48-4f8a-9cc9-056e62e33cd2"
msgid "[Attack] \"There's too many of you here. And I only need one…\""
msgstr "[공격] \"숫자가 꽤 많군. 난 한 놈만 필요한데 말야...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Answer_0010_AlignmentShift.Description
msgctxt "6e53af76-91fc-47ba-8eab-abf01236de51"
msgid ""
"Asked the wererats whether anyone would volunteer to take part in Bokken's "
"tests."
msgstr "쥐인간들에게 누가 보큰의 시험에 참여할 것인지 물었습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Answer_0010_Text
msgctxt "fe47b5fa-9b2e-431e-aea3-dddfdee55bd7"
msgid ""
"\"An alchemist I know is working on a new potion, and the decoction has to "
"be tested. Does any of you wish to risk your life in the name of science?\""
msgstr ""
"\"내가 아는 연금술사가 새로운 물약을 만들고 있는데, 물약의 약효를 시험해 봐야해. 너희들 중에 과학이라는 이름아래, 목숨을 걸고자 "
"하는 이는 없나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Answer_0011_Text
msgctxt "817c4083-408d-49ca-b9fd-18de5dd2e2aa"
msgid ""
"\"The ruler of these lands wishes to show that all who inhabit them are like "
"children to {mf|him|her}! In {mf|his|her} grace, {mf|he|she} gifts you with "
"this rare, noble drink!\""
msgstr ""
"\"이 땅의 통치자는 이 땅의 사는 자들을 {mf|그의|그녀의} 자식과 같이 여긴다는 것을 보여주고자 한다! {mf|그의|그녀의} 영광 "
"아래, 너에게 {mf|그의|그녀의} 이 귀하고, 숭고한 포션을 내리노라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Answer_0012_Text
msgctxt "3e752286-7fa8-47aa-980d-9d8f38a09d40"
msgid "\"As a matter of fact, nothing. I guess I should get going.\""
msgstr "\"사실대로 말하자면, 아무것도 아니야. 난 가봐야 겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Answer_0016_AlignmentShift.Description
msgctxt "5188a6cc-11e2-46b7-888b-c2efbb1eeb77"
msgid ""
"Asked a group of wererats whether any of them were willing to volunteer "
"themselves as test rats."
msgstr "웨어랫 무리들에게 그들 중 누군가가 실험용 쥐로써 자원할지 물어보았다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Answer_0016_Text
msgctxt "e471a8a9-5fd8-4913-be2f-c4a4713c0447"
msgid ""
"\"What do you know. I was just looking for a couple of lab rats. Do I have a "
"volunteer?\""
msgstr "\"이게 누구야. 마침 실험 쥐 한두 마리를 찾고 있었다. 자원하지 않겠나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Answer_0026_Text
msgctxt "10b105b4-ad9f-45d1-91af-567d76c172d0"
msgid ""
"[Pour the potion into the wererat's mouth] \"Here, take a sip of this first…"
"\""
msgstr "[쥐인간의 입에 포션을 부어 넣는다] \"자, 먼저 한 모금을 하고...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Answer_0027_Text
msgctxt "368f4339-154f-4466-ad68-fb7242695ced"
msgid "[Kill the wererat]"
msgstr "[쥐인간을 죽인다]"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Cue_0001_Text
msgctxt "927ddc97-e884-41f6-84fd-f08fc970699c"
msgid ""
"{n}Hunched, gray figures turn to face you as you approach. Yellow fangs show "
"from grinning muzzles, and clawed paws reach for weapons.{/n}"
msgstr ""
"{n}당신이 다가갈수록, 등을 구부린 회색의 형상이 당신을 향해 고개를 돌렸습니다. 쭉 찢어진 주둥아리에는 노란 송곳니가 보이고, 손톱이 "
"난 앞발은 무기를 향해 뻗습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Cue_0002_Text
msgctxt "2252fdaa-b2c5-4e76-9c2c-72efdc571d3d"
msgid ""
"{n}The wererats freeze in intense anticipation, ready to pounce on you at "
"any moment. Finally, you hear a hoarse, cracked voice.{/n}"
msgstr ""
"{n}웨어렛들은 강렬한 긴장감에 꼼짝 않고, 언제든지 당신을 향해 덮칠 준비를 하고 있습니다. 마침내, 당신은 갈라진 쉰 목소리를 "
"들었습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Cue_0007_Text
msgctxt "b832f219-1aab-414d-9dc6-ee356d5d669b"
msgid ""
"{n}The raspy laughter of half a dozen throats resounds over the small "
"clearing.{/n}"
msgstr "{n}대여섯의 쉰듯한 목소리의 웃음소리가 작은 공터에 울려 퍼졌습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Cue_0008_Text
msgctxt "a3c27314-78ff-4b8d-bd00-724a03026c5b"
msgid ""
"\"Move one finger – an' we'll cut your bald hide to scraps. Whatcha need?\""
msgstr "\"손가락 하나 까딱여봐, 우리가 즉시 네 놈의 털 없는 가죽을 발라 줄 테니까. 무슨 일이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Cue_0013_Text
msgctxt "2395860a-b48d-41fc-99ef-6e9c13a51bee"
msgid "\"Whatcha… lookin' at… Finish me… off…\""
msgstr "\"뭘 보고... 있... 날... 죽여... 라....\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Cue_0015_Text
msgctxt "09eebfe4-1e74-4e3f-9b37-a4ffc3da7e6d"
msgid ""
"\"What, you lookin' to test this stuff on us? Of course – why try it out on "
"people when you've got monsters! Not like anyone's going to miss 'em, right?"
"\" {n}Tiny rat eyes glisten with an evil glow.{/n} \"Arrogant bastards… Tear "
"'em apart, boys!\""
msgstr ""
"\"뭐, 이걸 우리한테 시험해 보고 싶다고? 그래, 괴물이 있는데 왜 사람에게 실험해 보고 싶겠어! 누구든 그렇게하겠지, 그렇지?\"{n}"
"작은 쥐의 눈이 사악한 빛으로 반짝입니다.{/n}\"오만한 놈들...저들을 찢어 버려라, 얘들아!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Cue_0017_Text
msgctxt "089fda90-d6d1-480c-89c2-85aba348bb54"
msgid "\"Wet-tail. Take the bottle off {mf|him|her}.\""
msgstr "\"젖은 꼬리. 저 녀석의 병을 뺏어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Cue_0019_Text
msgctxt "7cf3b4c7-44ae-49c2-8d6f-f6ed37bbcf1e"
msgid "{n}The pack leader's snout twists with hatred.{/n} \"Die, baldskin!\""
msgstr "{n}무리의 두목의 코가 증오로 찌푸려졌습니다.{/n} \"죽어라, 털없는 놈!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Cue_0022_Text
msgctxt "29b1afa5-29e5-428c-be4a-727b0b653182"
msgid ""
"{n}The wererats exchange glances, clearly surprised. One of them approaches "
"you and takes the potion. However, as soon as his clawed fist clenches the "
"bottle's neck, he rips out the cork and greedily raises it to his mouth! A "
"gulp, another one, and another... and the wererat falls to the ground, "
"shaking with violent convulsions!{/n}"
msgstr ""
"{n}웨어랫들은 놀란 눈빛을 서로 교환했습니다. 그 중 하나가 당신에게 다가와서는 포션을 쥐었습니다. 그의 손톱달린 발이 병을 꽉 "
"쥐자마자, 그는 코르크 마개를 벗기고는 개걸스럽게 내용물을 그의 입안에 붓기 시작했습니다! 한 모금, 또 한모금, 또...그리고는 "
"웨어랫은 바닥에 쓰러져서는, 격렬한 경련으로 떠는 것이었습니다!{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Cue_0023_Text
msgctxt "f53f3f00-2bbc-4aeb-aaac-1d0869a8812f"
msgid ""
"{n}The pack leader bares his teeth in a sinister grim.{/n} \"Not so fast, "
"you pup…\""
msgstr "{n}무리의 두목은 그의 이빨을 불길한 미소를 띄우며 내 보였습니다.{/n} \"서두르지마, 이 개...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/HumanMaleAlchiemistCN/TestWererat/Cue_0024_Text
msgctxt "f1fa4dbb-bc0f-4978-9f62-a567b5a22088"
msgid ""
"\"That idiot. How predictable.\" {n}The leader shifts his animal eyes "
"towards you.{/n} \"They've killed one of ours. Get 'em, boys.\""
msgstr ""
"\"멍청이. 식상하군.\" {n}두목은 당신에게로 그 야수의 눈을 돌렸다.{/n} \"저들이 우리 중 하나를 죽였다. 쳐라, 예들아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Bokken_Masterpiece_Description_String
msgctxt "bfc81487-6edd-469b-bf98-a5556b371da4"
msgid ""
"The pinnacle of Bokken's alchemical mastery, the result of years he's spent "
"striving to uncover the secrets of life."
msgstr "보큰의 연금술 작업의 정수, 수년간 그가 삶의 비밀을 밝히기 위해 노력한 결과."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Bokken_Masterpiece_Name_String
msgctxt "170f7961-1098-4878-9710-f193bc20f047"
msgid "Elixir of Inconceivable Transmutations of Body, and Soul, and Also Mind"
msgstr "상상 이상의 신체와 영혼과 정신 변형의 비약"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Dragn_Masterpiece_Description_String
msgctxt "f9f9829b-b464-43f8-a62d-71f8d4371299"
msgid ""
"This armor belonged to a great warrior, and ancestor of Dragn Woradash. He "
"restored his family honor and made this armor shine again."
msgstr ""
"이 갑옷은 드래근 월다쉬(Dragn Woradash)의 선조였던 위대한 전사의 소유물이었습니다. 그는 그의 가문의 명예를 회복하고 이 "
"갑옷을 다시 빛내었습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Dragn_Masterpiece_Name_String
msgctxt "8b529285-2b06-4fae-b38f-469f7ea363dd"
msgid "Onslaught"
msgstr "맹격"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Irlene_Masterpiece_Description_String
msgctxt "7d725e28-0935-4fa2-878a-cb0134ae3a29"
msgid ""
"Adventurous Irlene Greyridge obtained this rare artifact at the "
"{mf|baron's|baroness'|King's|Queen's} special request."
msgstr ""
"모험심 강한 이를렌 그레이릿지(얼린 그레이리지)는 {mf|남작의|여남작의|왕의|여왕의} 특별한 부탁으로 이 희귀한 유물을 구했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Irlene_Masterpiece_Name_String
msgctxt "d2498d9e-133c-4a38-84af-b4ae6d33d667"
msgid "Grandmaster's Rod"
msgstr "그랜드마스터의 로드"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Kimiel_Masterpiece_Description_String
msgctxt "5e008642-d5b4-4943-b8ce-1f5f8f6b493e"
msgid ""
"Renowned woodworking master Chimiel crafted a bow whose mere shadow is a "
"deadly weapon, on special consignment for the {mf|baron|baroness|King|Queen}."
msgstr ""
"유명한 목공 장인인 치미엘(Chimiel)은 한낱 그림자조차 치명적인 활을 {mf|남작의|여남작의|왕의|여왕의} 특별한 부탁으로 "
"만들었습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Kimiel_Masterpiece_Name_String
msgctxt "77fdba06-11c3-45c5-98bf-835a8645d387"
msgid "Heartrender"
msgstr "하트랜더"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Mim_Masterpiece_Description_String
msgctxt "1b226247-d184-4b8f-abe5-3e40ef5f1651"
msgid ""
"This stunningly beautiful magical adornment is the handiwork of Mim "
"Wobblegander. The jeweler put her heart into it."
msgstr "이 놀랄 만큼 아름다운 마법 장신품은 밈 워블갠더의 수공예품입니다. 보석공예가는 여기에 그녀의 마음을 담았습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Mim_Masterpiece_Name_String
msgctxt "2bbcf240-11a7-404b-b2ff-efffec5465d7"
msgid "Heart's Desire"
msgstr "염원"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Nazrielle_Masterpiece_Description_String
msgctxt "8432cf9f-578c-4479-90a6-a7cd9d31b36d"
msgid ""
"This razor-sharp blade bears the mark of Nazrielle, the honored court master "
"of the Stolen Lands' {mf|baron|baroness|King|Queen}."
msgstr ""
"이 날카로운 칼날에는 영광스런 도둑맞은 땅의 {mf|남작의|여남작의|왕의|여왕의} 궁중 장인인 나즈리엘의 표식이 새겨져 있습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Nazrielle_Masterpiece_Name_String
msgctxt "e052a3f1-9066-422e-a327-6e94278c09ba"
msgid "Enforcer"
msgstr "집행자"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Shainih'a_Masterpiece_Description_String
msgctxt "7fab32fa-5b8c-4b0a-ad51-33c9df5765d1"
msgid ""
"This magnificent weapon is the creation of master Shaynih'a, the follower of "
"the Perfect Human, who finally discovered her purpose."
msgstr "이 위대한 무기는 마침내 그녀의 목표를 찾아낸 완벽한 인간의 추종자인 장인 샤이니아가 만든 작품입니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Shainih'a_Masterpiece_Name_String
msgctxt "5e48f53f-df61-43e7-915b-12cda8205b10"
msgid "The Pride of Vudra"
msgstr "부드라의 자부심"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Sharel_Masterpiece_Description_String
msgctxt "1e4d1bbe-dfcc-4a15-ae00-c9836afe7bd3"
msgid ""
"A glorious robe of amazing fabric made by the brave and noble artisan Sharel."
msgstr "용감하고 고귀한 장인 샤렐에 의해 만들어진 놀라운 직물로 짜여진 영광의 로브."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Sharel_Masterpiece_Name_String
msgctxt "7fdbb427-7de9-477b-bc63-d57162f0eae8"
msgid "Robe of the Pure Heart"
msgstr "순수한 마음의 로브"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Tirval_Masterpiece_Description_String
msgctxt "fd89f7df-b4e7-45fe-a33b-48bfb6367661"
msgid ""
"A magnificent set of leather armor, crafted from the hide of an unknown "
"predator, shot by leatherworker Tirval, the head of Varnhold's militia."
msgstr "반홀드 민병대의 지휘자인, 가죽장인 터발이 쏘아 맞힌, 알 수 없는 포식자의 가죽으로 만들어진, 위대한 한 벌의 가죽갑옷."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Tirval_Masterpiece_Name_String
msgctxt "9b94467c-37d0-4e87-b1ee-57369b85e824"
msgid "Varnhold's Gratitude"
msgstr "반홀드의 감사함"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Varrask_Masterpiece_Description_String
msgctxt "b22c9617-79c5-4751-a12f-71b6a2579c73"
msgid ""
"A family relic of Varrask, the {mf|baron|baroness|King|Queen}'s court "
"blacksmith. This frightening-looking weapon possesses a great might."
msgstr ""
"{mf|남작|여남작|왕|여왕}의 궁정 대장장이인, 바라스크의 집안의 유물. 이 무시무시한 생김새의 무기는 엄청난 힘을 소유하고 있다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Artisans/MASTERPIECES_STRINGS/Varrask_Masterpiece_Name_String
msgctxt "9f155a07-e401-4f86-945e-d87d78febc4f"
msgid "Obliteration"
msgstr "말살"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Merc/Cue_0001_Text
msgctxt "0fb5c1fa-c7f7-4fda-8511-8919b5c22495"
msgid ""
"{n}Your advisor has arrived to report about the recent Arcane developments "
"in your {mf|barony|barony|kingdom|kingdom}.{/n}"
msgstr "{n}당신의 보좌관이 최근의 {mf|남작령|남작령|왕국|왕국}의 비전 발전에 대해 논의하기 위해 방문했습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Answer_0008_Text
msgctxt "acd076db-a8ab-432b-9857-d482e4931e26"
msgid ""
"{g|Arcane10_1}[Choice effects]{/g} \"Diplomacy above all. We shall exchange "
"our arcane knowledge with other states.\""
msgstr ""
"{g|Arcane10_1}[선택 시 효과]{/g} \"무엇보다도 외교지요. 우리는 다른 국가들과 우리의 비전 마법 지식을 교류할 것입니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Answer_0009_Text
msgctxt "46d105d9-2fad-45e5-a911-8fd2555b6b6b"
msgid ""
"{g|Arcane10_2}[Choice effects]{/g} \"I wish to improve the education and "
"training of our priests.\""
msgstr "{g|Arcane10_2}[선택 시 효과]{/g} \"우리 사제들의 훈련과 교육을 향상시키고 싶다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Answer_0010_Text
msgctxt "722cac73-4dce-473d-a4c3-2b4666858487"
msgid ""
"{g|Arcane10_3}[Choice effects]{/g} \"I command the construction of a great "
"workshop, so we may begin manufacturing magical equipment for our army.\""
msgstr ""
"{g|Arcane10_3}[선택 시 효과]{/g} \"거대한 공방의 건설을 명령한다, 우리는 우리의 군대를 위한 마법 장비들의 생산을 "
"시작할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "2df050c2-1a8a-4a6c-a761-cad7dd1d43bf"
msgid ""
"\"It's been a while since I came to you like this, {name}! You must be "
"wondering if I'm here to talk about troubles again, eh? Well, believe it or "
"not, this time I just wanted to tell you about all the successes we've been "
"enjoying recently.\""
msgstr ""
"\"{name}, 너를 만난지 꽤 되었네! 내가 또 다시 뭔가 문제들에 대해 이야기하려는 것이 아닌지 궁금하겠지, 응? 음, 믿거나 "
"말거나, 이번엔 최근에 누리고 있는 우리의 성공들에 대해서 이야기하려고 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "31b98927-fca5-4d83-a864-0a26f072da95"
msgid ""
"\"Greetings, Your Highness. I would like to advise you on the current state "
"of magic affairs in the kingdom. But you can rest easy — it's only good news."
"\""
msgstr ""
"\"안녕하십니까, 전하. 저는 최근의 왕국의 마법 문제의 근황에 대해 조언하고자 합니다. 편히 들으셔도 괜찮습니다- 좋은 소식뿐이니까요."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0003_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "98a5f30b-4a6e-4f7d-ad86-597d2b256c83"
msgid ""
"{n}\"Maegar\" looks somber and triumphant.{/n} \"I greet you, Your Highness. "
"And I've something to tell you.\""
msgstr "{n}\"메이가르\"는 수수하지만 위풍당당해 보입니다.{/n} \"환영합니다, 전하. 그리고 말씀드릴 것이 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0004_Text
#. Speaker : Octavia_Companion
msgctxt "234e6465-3aee-4905-bb7a-7469b426ef73"
msgid ""
"\"The common folk have grown to trust our magic users – in great part, I "
"think, thanks to the ban on the... errrm, exotic magical ingredients.\""
msgstr ""
"\"일반인들의 마법 사용자에 대한 믿음이 꺼지고 있습니다 - 대개는, 제가 생각컨데, 으으으으음, 이국적인 마법 재료의 금지를...한 "
"덕입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "5779ba95-8d91-4406-a703-9af3b7582808"
msgid ""
"\"Despite my expectations, maintaining the ban on exotic magical ingredients "
"proved highly beneficial. Your subjects have developed more trust towards "
"magic users, and are buying more goods and services from them.\""
msgstr ""
"\"제 기대에도 불구하고, 이국의 마법 재료를 금지하는 것은 매우 유익했습니다. 당신의 백성들은 마법 사용자에 대한 신뢰를 더욱 "
"발전시키고 있고, 그들로부터 더 많은 상품과 서비스들을 구매합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0006_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "422b7b6e-ba25-43a4-888f-85f142287e35"
msgid ""
"\"Somehow, maintaining the ban on exotic magical ingredients did not hamper "
"the rapid growth of magical potential in these lands. Perhaps not least "
"because it quieted the ever watchful and ever grumbling peasants...\""
msgstr ""
"\"어찌되었건, 이국의 마법 재료들을 금지하는 거은 이 땅의 마법적 잠재력의 급속한 성장을 저해하지 않았습니다. 아마도 언제나 주시하면서 "
"언제나 불만을 토해내는 농민들을 조용히 하게 만들었기 때문이겠지요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0011_Text
#. Speaker : Octavia_Companion
msgctxt "e758c380-f600-4bb9-a2f6-fd531f834860"
msgid "\"Wonderful! I can't wait to see what we gain in return!\""
msgstr "\"훌륭합니다! 저는 어떤 대가를 받게 될지 못 기다릴 것 같습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0012_Text
#. Speaker : Capital_Collector
msgctxt "326987ea-d9d1-4dc6-9fd5-5e25a20dd654"
msgid "\"Certainly, Your Highness.\""
msgstr "\"물론입니다, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0013_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "f1bc03fe-7737-4686-b1a5-947aae2ba512"
msgid "\"As you wish.\""
msgstr "\"당신이 원하시는데로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0014_Text
#. Speaker : Octavia_Companion
msgctxt "e2ac66a2-8eed-4259-96f0-d031d3424106"
msgid "\"Perfect. That's exactly what we'll do!\""
msgstr "\"완벽합니다. 그게 우리가 할 수 있는 일입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0015_Text
#. Speaker : Capital_Collector
msgctxt "e2b8e8c5-dcd7-4272-954f-5ca03975ae45"
msgid "\"It shall be done, Your Highness.\""
msgstr "\"그렇게 될 것입니다, 전하!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0016_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "57ebaf77-815b-4347-b121-db3e7f2e593e"
msgid "\"Very well, Your Highness.\""
msgstr "\"아주 좋습니다, 전하!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0017_Text
#. Speaker : Octavia_Companion
msgctxt "b16e4fee-190a-48eb-b0f3-a5ab70cd9224"
msgid "\"That wouldn't be my personal choice... but it will be quite useful.\""
msgstr "\"제 개인적인 선택은 아닙니다만...그것은 아주 유용할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0018_Text
#. Speaker : Capital_Collector
msgctxt "723cee40-41ae-49cb-80cb-2b45a9d98d66"
msgid "\"It shall be as you say, Your Highness.\""
msgstr "\"당신이 말씀하신 대로, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0019_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "848bcf1e-26e5-4356-8570-62e8cf013543"
msgid "\"Splendid.\""
msgstr "\"멋지군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0020_Text
#. Speaker : Octavia_Companion
msgctxt "830c7df0-0260-46e4-abde-ac32e2fe03c2"
msgid ""
"\"It seems appraiser was right after all. By permitting the unfettered trade "
"of all magic ingredients, we've attracted even more commerce to our lands — "
"and more rare specialists.\""
msgstr ""
"감찰원이 전적으로 옳았던 것으로 보입니다. 모든 마법 시료들의 제한없는 무역을 허용함으로써, 우리는 보다 많은 통상을 우리 지역에 가져올 "
"수 있었으며 - 더 많은 희소한 특화종들도 함께 가져올 수 있었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0021_Text
#. Speaker : Octavia_Companion
msgctxt "75eeb096-f811-4157-8f28-b50c9bca07f7"
msgid ""
"\"We've come a long way over the years. Our kingdom now employs magic of the "
"highest order, and does so confidently and responsibly. Unlike many other "
"states, we've done everything in our power to constantly maintain control "
"over the situation, and ensure that the development of magic serves the "
"people, and not the other way around.\""
msgstr ""
"\"우리는 여러 해 동안 먼 길을 걸어 왔습니다. 우리의 왕국은 이제 초일류의 마법을 구가하고 있고, 이는 당당하며 책임감 있게 사용되고 "
"있습니다. 다른 많은 타국들과는 다르게, 우리는 상황에 대한 통제력을 꾸준하게 유지하기 위한 우리의 힘을 전면으로 기울이고 있으며, "
"마법의 발전이 사람들에게 봉사하고 그 외의 방향으로는 흐르지 않도록 보장하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0022_Text
#. Speaker : Octavia_Companion
msgctxt "3e7c082d-d28a-46e3-bdfc-de179e341973"
msgid ""
"\"We've come a long way over the years. Our kingdom has become an arcane "
"power unto itself. Knowing that they can't find better conditions anywhere "
"else, all manner of inventors, researchers and experimenters have flocked to "
"us.\""
msgstr ""
"\"우리는 지난 몇 년 동안 많은 발전을 했습니다. 우리의 왕국은 비전 그 자체가 되었습니다. 그들이 다른 어떤 곳에서도 더 나은 조건을 "
"찾을 수 없다는 것을 알고, 모든 분야의 발명가, 연구원, 그리고 실험가들이 우리에게 몰려들었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0023_Text
#. Speaker : Octavia_Companion
msgctxt "538bc68f-4cd7-4075-b84a-45bef470a28e"
msgid ""
"\"Despite my fears, the magic community took the new regulations we "
"introduced quite well. Many simply moved their laboratories out of town, and "
"continued working like nothing ever happened. Hardly anyone even thinks to "
"speak of it nowadays. — They've gotten used to it, it seems.\""
msgstr ""
"\"제 우려에도 불구하고, 마법 커뮤니티는 우리가 도입한 새로운 규정을 꽤 잘 받아들였습니다. 많은 사람들이 그저 실험실을 마을 밖으로 "
"옮기고, 아무 일도 없었던 것처럼 일을 계속했습니다. 요즘은 거의 아무도 그것에 대해 말하고 싶어하지 않아요. - 그들은 익숙해진 것 "
"같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0024_Text
#. Speaker : Octavia_Companion
msgctxt "9fb554b3-a064-4a7a-842f-6d486ea9949b"
msgid ""
"\"We refused to place new restrictions on the use of magic — and, as "
"expected, the people made peace with the decision. Recently, our mages have "
"even started enjoying a bit more understanding and tolerance...\""
msgstr ""
"\"우리는 새로운 마법 사용의 제한을 거부해 왔으며, 예상했던데로, 사람들은 이 결정과 화합했습니다. 최근에는, 우리의 마법사들이 조금 "
"더의 이해와 관용을 즐기기 시작했습니다만...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0025_Text
#. Speaker : Octavia_Companion
msgctxt "2155f7ec-7eaa-4358-b7b6-abe159336ab5"
msgid ""
"\"And the time has now come to enjoy the fruits of our labor! There are "
"three projects I can suggest. First off, my personal favorite – we could "
"exchange our arcane knowledge with our neighbors. Second – we could use the "
"experience and know-how of our magic schools to help educate our priests "
"more quickly and thoroughly. Lastly – we could start producing magical "
"weapons and armor for our army. So... what do you think we should we focus "
"on?\""
msgstr ""
"\"그리고 이제 우리의 노력의 결실을 즐길 때입니다! 제가 제안할 세 가지 계획이 있습니다. 첫번째로, 제가 개인적으로 가장 좋아하는 "
"것입니다만 - 우리의 이웃국가들과 이 비전 지식을 상호 교환하는 것입니다. 두번째로 - 우리는 우리의 마법 학교에서의 경험과 비결을 "
"우리의 사제들을 보다 빠르고 철저하게 교육시키는 데에 사용할 수 있습니다. 마지막으로 - 우리는 우리 군대를 위해 마법 무기와 갑옷의 "
"생산을 시작할 수 있습니다. 자...당신은 어떠한 것에 우리가 집중해야 한다고 생각하는지요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0026_Text
#. Speaker : Capital_Collector
msgctxt "3c53f710-6245-4126-ae04-f8aefb2a3ea1"
msgid ""
"\"Lifting the ban on exotic magical ingredients proved highly beneficial to "
"commerce, and the development of the magical arts in these lands.\""
msgstr ""
"\"이국의 마법 재료에 대한 금지령을 해제하는 것은 상업에 매우 득이 된다는 것과, 이 땅의 마법 기술의 발전이 된다는 것이 증명되었다. "
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0027_Text
#. Speaker : Capital_Collector
msgctxt "8fc19d51-6724-4fd1-a46f-312cbb3f0a0d"
msgid ""
"\"The magic community understood the need for the new regulations which "
"restricted the use of magic in densely populated areas. There's every reason "
"to believe that the reforms were a resounding success.\""
msgstr ""
"\"마법 사용자 집단은 인구가 밀집된 곳에서의 마법 사용을 금지하는 새로운 규제가 필요하다는 사실을 이해하였습니다. 개혁이 대성공했다는 "
"것을 믿을만한 충분한 이유가 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0028_Text
#. Speaker : Capital_Collector
msgctxt "0d87bc0c-dea3-4280-bd5f-77517efc4ef2"
msgid ""
"\"The masses still look upon mages with distrust. However, it's worth "
"tolerating a little social tension, considering the rapid development of the "
"magical arts in our lands.\""
msgstr ""
"\"대중들은 여전히 불신을 가지고 마법사들을 바라봅니다. 그러나, 우리 땅에서의 마법 기술의 급속한 발전을 고려하면, 약간의 사회적 "
"긴장을 감내할 가치가 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0029_Text
#. Speaker : Capital_Collector
msgctxt "3dc64348-25e8-4e9a-b3ec-1b4e6210159e"
msgid ""
"\"All in all, we've become one of the leading arcane powers in the River "
"Kingdoms. Among our subjects, there's a disproportionate number of scholars "
"and inventors, theorists and experimenters. It seems they are drawn here by "
"the freedoms our society offers, and the opportunity to undertake "
"unfettered, even extravagant research in our domain.\""
msgstr ""
"\"전체적으로, 우리는 이제 리버 킹덤(River Kingdoms) 가운데 비전 마법 기술을 선도하는 국가 중 하나가 되었습니다. 우리의 "
"백성들 중, 학자와 발명가, 이론가와 실험자 간 수의 불균형이 있습니다. 그들은 우리 사회가 제공하는 자유와, 제한없이 제공되는 기회와, "
"더불어 우리 영지에서 행하는 과감한 연구 등에 이곳으로 이끌리는 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0030_Text
#. Speaker : Capital_Collector
msgctxt "96d35729-97d8-4f78-9ba3-95b036c76d7a"
msgid ""
"\"All things considered, we've become one of the leading arcane powers in "
"the River Kingdoms. We have further distinguished ourselves in the way we "
"treat magic responsibly, ensuring that we maintain control over its "
"development. Magic always remains an instrument in our kingdom, and never an "
"end in itself.\""
msgstr ""
"\"모든 것을 고려해볼 때, 우리는 이제 강의 왕국들 가운데 비전 마법 기술을 선도하는 국가 중 하나가 되었습니다. 우리는 보다 우리 "
"스스로를 차별화 하기 위해 마법을 책임감있게 다루고, 그 발전에 대한 통제를 유지해야 합니다. 마법은 언제나 우리 왕국의 수단으로 "
"남아야만 하지, 그 자체가 목적이 되어서는 안 됩니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0031_Text
#. Speaker : Capital_Collector
msgctxt "1372f636-5edb-4c7a-8c15-ae525a13d2ab"
msgid ""
"\"Our successes have opened the way for us to pursue an ambitious project. I "
"have three ideas. We might employ the knowledge that our magic schools have "
"gathered to train our priests more quickly and thoroughly. I believe that "
"would ultimately be of the most use to our kingdom. We could instead "
"disseminate our arcane knowledge to our neighbors, for whatever knowledge "
"they might offer in return. Finally, we could start producing magical "
"weapons for our troops.\""
msgstr ""
"\"우리의 성공들은 더 야심찬 계획들로의 길을 열었습니다. 제게 세 가지 계획이 있습니다. 우리는 우리 마법 학교가 모아온 지식들을 "
"우리의 사제들을 보다 빠르고 철저하게 훈련시키는 데에 유용할 수 있습니다. 제가 생각하기에는 그것이 우리 왕국에 궁극적으로 도움이 되는 "
"것입니다. 우리는 우리 이웃국가에게 우리의 비전 마법 지식을 그들이 댓가로 어떤 지식을 제공하던 간에 보급하는 걸로 대신할 수도 "
"있습니다. 마지막으로, 우리는 마법 무기를 우리 군대를 위해 생산할 수도 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0032_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "57337325-e335-4d93-b93b-c1c49ebc97e6"
msgid ""
"\"However, this is not what I have come to discuss. I have weighed the magic "
"potential of our domain against that of our neighbors, and concluded that we "
"surpass them several times over. We do not lecture our mages on morality, "
"and place no obstacles to their research. Your subjects have reached a level "
"of mastery far higher than I expected. I must say, I am impressed.\""
msgstr ""
"\"그렇지만, 이것은 제가 논의하려던 것이 아니었습니다. 저는 우리의 이웃국가들에 대항해 우리 영지의 마법 가능성에 비중을 두고, 그들의 "
"우리가 그들을 몇 배나 뛰어넘었다고 결론내렸습니다. 우리는 우리의 마법사들에게 도덕을 교육시키지 않고, 그들의 연구에는 어떠한 장벽을 "
"두지도 않았습니다. 당신의 백성들은 제가 기대했던 것보다 더 높은 경지의 도달해있습니다. 이건 꼭 말씀드리겠습니다, 저는 감명받았습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0033_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "7be73cef-d24d-4b67-a41e-9c8103f1ec84"
msgid ""
"\"We are now in a position to pursue something on a grander scale. I suggest "
"to you three projects. The first: exchanging our arcane knowledge for that "
"of our neighbors. The second: make use of our magic schools to better train "
"our priests. Finally: create a workshop that would produce enchanted "
"weaponry for the army. Need I even mention that the final option is by far "
"the most useful?\""
msgstr ""
"\"우리는 이제 더욱 장엄한 규모로 무언가를 추구할 수 있는 위치가 되었습니다. 저는 세 가지 기획을 제안합니다. 먼저: 우리의 "
"이웃국가들과 우리의 비전 마법 지식을 교류합니다. 둘째: 우리의 마법 학교를 이용하여 우리의 사제들을 보다 좋게 훈련시킵니다. 마지막: "
"공방을 건설하여 군대를 위한 마법 부여된 무기 제작을 합니다. 제가 굳이 마지막 기획이 가장 유용하다는 것을 언급할 필요가 있겠습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0034_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "a35ac52a-67d6-43eb-8750-c7f3f3b31b11"
msgid ""
"\"It was wise to lift the ban on exotic magical ingredients. This greatly "
"benefitted our mages and sorcerers. Now they can spend less time procuring "
"material components, and more time in their studies... and they've still so "
"much to learn.\""
msgstr ""
"\"이국의 마법 재료 금지를 해제하는 것은 현명한 일입니다. 이것은 우리의 마법사들과 소서러들에게 굉장한 이득입니다. 이제 그들은 재료를 "
"조달하는데 덜 시간을 들여도 되고, 연구에 보다 많은 시간을 쓸 수 있을 겁니다...그들이 배워야 할 것은 여전히 많지만요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0035_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "68d64a7b-090c-4522-bfa1-1e285e1f05af"
msgid ""
"\"Strangely, restricting the use of magic in the towns and villages only "
"strengthened our hand. Once their self-importance was placated, they grew "
"quiet — and stopped meddling our affairs.\""
msgstr ""
"\"이상하게도 마을과 마을에서 마술의 사용을 제한하는 것은 우리의 손을 더 강하게 만들었을 뿐입니다. 일단 그들의 자만심이 달래지자, "
"그들은 조용해졌고 우리의 일에 간섭하는 것을 중단했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0036_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "e6a3d288-1f9e-4668-91f1-e663bff42e4e"
msgid ""
"\"Just as I expected, we lost nothing in refusing to bow your commoners. We "
"could not restrict the use of magic to soothe their fears. They grumbled for "
"a time, just for show. But soon they accepted their fates — as befits "
"chattel...\""
msgstr ""
"\"예상대로, 우리는 당신의 벡성들에게 인사하는 것을 거부하는 것에서 아무것도 잃지 않았습니다. 우리는 그들의 두려움을 달래기 위해 마법 "
"사용을 제한할 수 없었습니다. 그들은 그저 보란듯이 잠깐 툴툴댔지만, 곧 그들은 그들의 운명을 받아들였습니다. 분수에 걸맞게 말이죠..."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank10/Cue_0037_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "2ba4e9f7-368d-41a8-afe9-31a787e8d152"
msgid ""
"\"However, this is not what I have come to discuss. I have weighed the magic "
"potential of our domain against that of our neighbors, and concluded that we "
"surpass them several times over. I have not always agreed with your "
"decisions — in my view, you are too cautious. Still, your successes speak "
"for themselves. Your subjects have reached a level of mastery much higher "
"than I expected of them. I must say, I am impressed.\""
msgstr ""
"\"그렇지만, 이것은 제가 논의하려던 것이 아니었습니다. 저는 우리의 이웃국가들에 대항해 우리 영지의 마법 가능성에 비중을 두고, 그들의 "
"우리가 그들을 몇 배나 뛰어넘었다고 결론내렸습니다. 저는 당신의 의견에 동의하지는 않았습니다. 제 판단으로는, 당신은 너무 신중합니다. "
"그러나, 당신의 성공이 그들을 대변합니다. 당신의 백성들은 제가 기대했던 것보다 더 높은 경지의 도달해있습니다. 이건 꼭 "
"말씀드리겠습니다, 저는 감명받았습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank2/Answer_0011_Text
msgctxt "231fdc8a-ac03-4f47-93e3-780d0999a8fd"
msgid ""
"{g|Arcane2_1}[Choice effects]{/g} \"I wish to control weather and luck.\""
msgstr "{g|Arcane2_1}[선택 시 효과]{/g} \"나는 날씨와 행운을 통제하고 싶다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank2/Answer_0012_Text
msgctxt "7ae7664b-4da6-4fbd-acee-801459538a33"
msgid "{g|Arcane2_2}[Choice effects]{/g} \"I wish to dominate animals.\""
msgstr "{g|Arcane2_2}[선택 시 효과]{/g} \"나는 동물들을 지배하고 싶다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank2/Answer_0013_Text
msgctxt "12d5b931-7fe6-40d3-805a-ce5acfeb716c"
msgid ""
"{g|Arcane2_3}[Choice effects]{/g} \"I wish to influence the minds of my "
"subjects.\""
msgstr "{g|Arcane2_3}[선택 시 효과]{/g} \"저는 제 백성들의 마음에 영향을 주고 싶습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank2/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "d82af45a-24fa-491d-b199-da230e913260"
msgid ""
"{n}Octavia grins from ear to ear.{/n} \"Your "
"{mf|barony|barony|kingdom|kingdom} attracts the most unusual and interesting "
"characters! They must have heard the rumors that your country is a place "
"where one can live without chains and restrictions! Not long ago, I was "
"visited by an appraiser of magical items – a rare and sought-after "
"profession in many countries!\""
msgstr ""
"{n}옥타비아는 입이 귀에 걸릴 정도로 웃었습니다.{/n} \"당신의 {mf|남작령|남작령|왕국|왕국}은(는) 가장 유별나고 흥미로운 "
"이들에게 끌리나봐요! 그들은 당신의 나라가 쇠사슬과 제한 없이 살 수 있는 곳이라는 소문을 들었을 거예요! 얼마 전에, 저는 많은 "
"나라에서 드물고 인기 있는 직업인 마법 물품 감정가의 방문을 받았어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank2/Cue_0002_Text
#. Speaker : Octavia_Companion
msgctxt "e606c6cb-cb69-4254-a4c8-6935289e2632"
msgid ""
"\"This man proposed that he settle in our lands and open his own store. I "
"agreed then and there – why can't we be as good as {g|Absalom}Absalom{/g}, "
"right? In tribute, he offered his new ruler a valuable gift! But he didn't "
"dare select a specific item for you. Instead he simply invites you to choose "
"from all the finest things he keeps in his best store-rooms!\" {n}Octavia "
"hands you a small list, written on a piece of parchment in ornate "
"handwriting.{/n} \"We'd best not be greedy, and choose just one item.\""
msgstr ""
"\"이 사람은 우리 땅에 정착해서 자기 가게를 열자고 제안했습니다. 그때 저는 동의했죠. 우리가 {g|Absalom}압살롬{/g}보다 "
"못하리란 법은 없잖아요? 공물로, 그는 그의 새 통치자께 값진 선물을 제안했습니다! 하지만 그는 감히 당신을 위해 특정 물품을 고르지 "
"못했어요. 대신, 그의 가장 좋은 창고에서 보관하는 모든 가장 좋은 것 중에서 당신이 선택하도록 자기 집에 초대하겠다네요!\" {n}"
"옥타비아는 화려한 필체로 양피지에 쓰여진 작은 목록을 당신에게 건넵니다.{/n} \"욕심 부리지 말고 하나만 선택하는 게 좋겠어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank2/Cue_0004_Text
#. Speaker : Capital_Collector
msgctxt "0171c2e8-2817-4f75-81e3-ebe424b085c4"
msgid ""
"{n}The Storyteller bows and hands you a piece of parchment, on which is "
"printed a short list, written in ornate handwriting.{/n} \"My respects, {mf|"
"Your Grace|Your Grace|Your Highness|Your Highness}. I hasten to hand you "
"this paper, that I have received from your new subject.\""
msgstr ""
"{n}이야기꾼이 인사하며 양피지 한 장을 건네는데, 그 위에 화려한 필체로 쓰여진 짧은 목록이 인쇄되어 있습니다.{/n} \"존경하는 "
"{mf|영주님|영주님|전하|전하}, 당신께서 새로 내리신 문제에 대한 문서를 서둘러 올리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank2/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "7422a6b3-8551-44ff-a8d4-025e203d7665"
msgid ""
"\"An appraiser of magical items has settled in the capital. We are nearly "
"colleagues, and this news fills my heart with joy.\" {n}The Storyteller "
"smiles.{/n} \"Grateful for his new home, the appraiser asks {mf|Your Grace|"
"Your Grace|Your Highness|Your Highness} to choose as a gift one of the "
"artifacts from his store-rooms. See for yourself...\""
msgstr ""
"\"마법 물품 감정사가 수도에 정착했습니다. 저희는 가까운 동료이고, 이 소식은 제 마음을 기쁨으로 가득 채웁니다.\" {n}이야기꾼이 "
"웃습니다.{/n} \"그 감정사가 새 집에 대한 감사로 {mf|영주님|영주님|전하|전하}께 그의 창고 안의 아티펙트 중 하나를 선물할 "
"것이라며 당신의 선택을 여쭈었습니다. 살펴보시지요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank2/Cue_0006_Text
msgctxt "46df1baf-51ed-4640-876f-296691c002bf"
msgid ""
"{n}You look through the list. The appraiser offers you a choice of three "
"magical items: one of them attracts good weather and good luck, the second "
"one allows you to dominate animals, and the third one – to influence the "
"emotions of sentient creatures.{/n}"
msgstr ""
"{n}당신은 목록을 훑어봅니다. 감정사는 선택에 앞서 세가지 물품을 제시했습니다. 하나는 좋은 날씨와 행운을 부르고, 두 번째는 동물을 "
"지배할 수 있게 하며, 세 번째는 지각이 있는 생물들의 감정에 영향을 줍니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank2/Cue_0007_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "7dd5c142-8cfc-42b3-ae50-2816d0d56ba3"
msgid ""
"{n}\"Maegar\" waves a piece of parchment in the air.{/n} \"An appraiser of "
"magical items has come to the castle, hat in hand – a pathetic toady, trying "
"to win over the {mf|baron|baroness|King|Queen} with trivial gifts. What can "
"be more amusing than the groveling of a miserable worm? I would have laughed "
"at the fool and thrown him out, were it not for one of the items he offers.\""
msgstr ""
"{n}\"메이가르\"는 양피지 조각을 허공에 흔듭니다.{/n} \"마법 물품 감정가가 굽신대며 성에 와서는 하찮은 선물로 "
"{mf|남작|여남작|왕|여왕}을 구슬리려 하고 있습니다. 한심한 아첨꾼 같으니. 이 한심한 벌레가 굽신거리는 소리보다 더 재미있는 게 "
"있을까요? 그의 물건 중 하나가 아니었다면, 저는 그를 비웃고 내쫓아버렸을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank2/Cue_0014_Text
#. Speaker : Octavia_Companion
msgctxt "25544c9a-1127-4160-8dae-51f7902b63f9"
msgid "\"Great! I will express your gratitude to the appraiser!\""
msgstr "\"훌륭하군요! 감정가에게 감사의 뜻을 전하겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank2/Cue_0015_Text
#. Speaker : Capital_Collector
msgctxt "c2a15fa9-6590-43a6-9394-6c252a61128a"
msgid "\"As you wish.\""
msgstr "\"당신이 바라시는 대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank2/Cue_0016_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "addff202-7884-4547-89a9-22ea1deee9de"
msgid "{n}\"Maegar\" just hums in response.{/n}"
msgstr "{n}\"메이가르\"는 콧노래로 대답합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank2/Cue_0017_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "059a458a-94d3-4c16-be45-14b76c8aabdb"
msgid ""
"\"This paper lists everything you can choose from. Among other things "
"there's an artifact that allows its owner some measure of control over the "
"minds of mortals.\" {n}The eyes of \"Maegar\" flash.{/n} \"If I were you... "
"{mf|Your Grace|Your Grace|Your Highness|Your Highness}... that is exactly "
"what I would choose. Never underestimate the intersection of magic and power."
"\""
msgstr ""
"\"이 문서에는 당신이 선택할 수 있는 모든 것이 나열되어 있습니다. 그 중에서도, 주인에게 인간의 마음을 통제할 수 있는 능력을 "
"부여하는 유물이 있습니다.\" {n}\"메이가르\"의 눈이 반짝입니다.{/n} \"제가 당신이라면...{mf|영주님|영주님|전하|전하}"
"... 분명 이 물건을 골랐을 겁니다. 마법과 힘의 교차점을 절대 과소평가하지 마십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank2/Cue_0018_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "ba8ed966-d43f-4001-b16f-aaa4679c4a99"
msgid "\"A wise choice, {name}.\""
msgstr "\"현명한 선택입니다, {name}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Answer_0011_Text
msgctxt "5ef381d1-87d5-4686-bc1a-fd9e0d9aad46"
msgid ""
"{g|Arcane3_1}[Choice effects]{/g} \"Leave the charm to the one who found it."
"\""
msgstr "{g|Arcane3_1}[선택 시 효과]{/g} \"그 부적을 발견한 자에게 그것을 주어라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Answer_0012_Text
msgctxt "1122f508-6b11-4cf3-9a84-f3e53d66a570"
msgid ""
"{g|Arcane3_2}[Choice effects]{/g} [Pay 500 gold] \"Buy the charm and give it "
"to the appraiser.\""
msgstr "{g|Arcane3_2}[선택 시 효과]{/g} [500골드 지불] \"그 부적을 사서 감정사에게 전해주시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Answer_0013_Text
msgctxt "2450de17-a0e8-4b34-a27c-052bab580e53"
msgid ""
"{g|Arcane3_3}[Choice effects]{/g} \"Seize the charm by force and give it to "
"the appraiser.\""
msgstr "{g|Arcane3_3}[선택 시 효과]{/g} \"그 부적을 강탈해서 감정사에게 전해주시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Answer_0023_Text
msgctxt "47d5fb50-3225-4f6c-abd9-d528bde7e5ef"
msgid "\"You are quite capable of making this decision without me.\""
msgstr "\"당신은 나 없이도 결정을 내릴 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "f280d3d3-db4d-4bbf-ac36-f11fce5d33ac"
msgid ""
"\"A messenger from a distant village has arrived. Something strange is "
"happening there – it would appear that some wizard is fooling around! The "
"locals have never met any wizards, but one of them found a strange charm "
"from the swamps not long ago. He showed it to the whole village and bragged "
"of his luck!\""
msgstr ""
"\"먼 마을에서 온 전령이 도착했습니다. 그곳에서 이상한 일이 일어나고 있다는군요. 그냥 어떤 마법사가 장난치는 것처럼 보이기도 "
"합니다만, 마을 사람들은 그 어떤 마법사도 만나지 못했다고 합니다. 하지만 얼마 전 주민 중 한 사람이 늪에서 기묘한 부적을 발견하곤 "
"그것을 온 마을에 보여주고 다니며 행운을 자랑했다고 합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0002_Text
#. Speaker : Octavia_Companion
msgctxt "43ae02c7-8651-442e-b7d5-eb84f76135fd"
msgid ""
"\"The lucky fellow now completely refuses to allow anyone to examine the "
"charm, so no one has been able to discover if it is the reason behind the "
"disorder in the village. He is within his rights: he found it, and it's his "
"property! Besides, the magical interference so far has been harmless – no "
"one has yet been hurt.\""
msgstr ""
"\"그 행운의 친구는 이제 그 부적을 아무에게도 보여주지 않기 때문에, 그것이 마을에 생긴 문제의 원인인지 아무도 알아낼 수 없었습니다. "
"그 부적은 그가 찾아냈고, 그의 재산이기 때문에 그에게 권리가 있습니다. 게다가 마법의 간섭은 해롭지 않습니다. 지금까지 그로 인해 "
"누군가 다친 일은 없기 때문이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0003_Text
#. Speaker : Octavia_Companion
msgctxt "1f522e47-772e-4eb7-90a5-14150d464ce4"
msgid ""
"{n}Octavia taps on her chin thoughtfully.{/n} \"I think the locals are "
"simply scared, and nothing more. Let's not make something out of nothing, "
"and leave the charm to the person who found it. Otherwise we'll set an "
"example for other squealers – and be buried under an avalanche of anonymous "
"letters! It's only one little trinket – what's the worst that could happen?\""
msgstr ""
"{n}옥타비아는 생각에 잠긴 듯 턱을 두드립니다.{/n} \"제 생각에는 그냥 마을 주민들이 괜히 겁을 집어먹은 것 같아요. 헛수고하지 "
"말고, 부적은 내버려 두죠. 안 그럼 온갖 꽥꽥거리는 편지에 파묻혀 버릴 걸요! 작은 장신구 하나잖아요. 아무 일도 없을 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0004_Text
#. Speaker : Capital_Collector
msgctxt "105d449b-a495-4a04-8c17-f3e115d62f33"
msgid ""
"\"A complicated situation, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. Dwellers in one of the distant villages have asked that we deal "
"with their neighbor – one way or another. They can't talk sense into him, "
"which is why they've turned to you.\""
msgstr ""
"\"복잡한 상황입니다, {mf|영주님|영주님|전하|전하}. 먼 마을 중 하나의 거주자들이 우리가 그들의 이웃을 어떻게든 상대해달라고 "
"요청했습니다. 거주자들은 왜 당신 편을 들었는지에 대해 그가 말귀를 알아듣게 할 수가 없답니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "6c314139-c3c8-4bb2-8942-82a36ddd43b3"
msgid ""
"\"Their troublesome neighbor discovered a magical charm in the swamps – "
"among some ancient ruins, he claimed. Afterwards, strange things began to "
"happen in the village. One day a dead silence fell upon the whole area. "
"Another day, the sun seemed to stop shining. Everyone blames the charm, and "
"they beg its owner to give it up – but he refuses. He found it, and by his "
"thinking, he'll be the one to decide what to do with it.\""
msgstr ""
"\"그들의 성가신 이웃이 늪지에서 마법 부적을 발견했습니다. 그자가 주장하기론 고대 유적에서요. 그러고나서 이상한 일들이 마을에서 "
"일어나기 시작했습니다. 어느 날은 죽은 듯 고요한 침묵이 온 동네에 드리웠습니다. 다른 날엔 태양이 빛나는 걸 멈춘 듯이 보였습니다. "
"모든 이가 그 부적 탓이라고 생각했고 주인에게 부적을 포기하라고 애원했습니다. 하지만 그자는 거부했죠. 그걸 찾은건 자신이고, 부적으로 "
"무얼 할지는 자기 마음이라는 게 그의 생각입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0006_Text
#. Speaker : Capital_Collector
msgctxt "8eecb707-dbc0-43f2-88bc-8757b65accc0"
msgid ""
"\"It's dangerous to leave an unidentified magical item in hands of an "
"ignoramus. – All the more so when it seems to be causing such disturbing "
"events. But it won't be fair just to take it from him. I suggest we buy it "
"from him, and then give it to our appraiser for examination.\""
msgstr ""
"\"무지한 사람에게 불확실한 마법 물품을 맡기는 것은 위험합니다. – 불안한 사건을 일으킬 거 같을 때는 더욱 그렇습니다. 하지만 무작정 "
"그에게서 빼앗는건 옳지 않습니다. 우리가 물품을 사서 우리의 감정인에게 검사를 의뢰합시다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0007_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "c4a61e2d-e065-4275-90fe-540d8421a0c0"
msgid ""
"{n}\"Maegar\" looks annoyed.{/n} \"The vices and self-confidence of the "
"lower races never ceases to amaze me. A messenger from a distant village "
"arrived to the castle, requesting an investigation. It would appear that one "
"of the villagers has discovered a powerful artifact, which is releasing "
"bursts of magical energy and scaring the other peasants.\""
msgstr ""
"{n}\"메이가르\" 는 짜증나보인다.{/n} \"하층민들의 악행과 자신감은 끊임없이 나를 놀라게 한다. 먼 마을 전령은 조사를 요청하며 "
"성으로 도착했다. 마을 주민들 중 한명이 마법 에너지를 분출하고 다른 농민들을 겁주는 강력한 유물을 발견한 것으로 보인다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0008_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "f27b093d-f052-4aad-b9e2-77e9336aaa08"
msgid ""
"\"This worm refuses to part with his newfound possession, so the stubborn "
"man's neighbors seek protection from you, their ruler. If I were you, I "
"would set an example, and tear the charm from the insolent fool's hands. – "
"His dead hands, if need be.\""
msgstr ""
"\"이 벌레는 새로 찾은 소유물을 내주길 거부하고 있습니다. 그래서 그 완고한 남자의 이웃은 그들의 통치자인 당신의 보호를 구하러 온 "
"거죠. 제가 당신이라면, 본보기를 보여 버릇없는 멍청이의 손에서 부적을 찢어낼 겁니다. 필요하다면, 죽여서라도 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0014_Text
#. Speaker : Octavia_Companion
msgctxt "048e7ee3-68a8-4c42-ba52-74092202cc7b"
msgid "\"Hooray! A fine decision!\""
msgstr "\"만세! 훌룡한 결정이야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0015_Text
#. Speaker : Capital_Collector
msgctxt "e29e7585-0a83-4084-a8f9-d5cc71240ec7"
msgid ""
"{n}A shade passes over the Storyteller's face.{/n} \"Are you certain? I "
"cannot predict where such carelessness on your part might lead.\""
msgstr ""
"{n}이야기꾼의 얼굴에 그림자가 스쳐 지나간다.{/n} \"정말 확신하십니까?  당신의 그런 부주의함이 어디로 이끌지 예측할 수가 없군요."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0016_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "66c782b6-4b87-4285-9c46-f9699a2374b4"
msgid ""
"{n}\"Maegar\" sniffs disdainfully.{/n} \"Slaves can hardly be blamed for "
"intemperance, when their master indulges their ridiculous whims!\""
msgstr ""
"{n}\"매가르\"가 경멸하며 콧방귀를 뀌었다.{/n} \"노예들이 그 방종에 책임지기는 힘들지. 주인들이 우스꽝스러운 변덕에 빠져있다면 "
"말야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0017_Text
#. Speaker : Octavia_Companion
msgctxt "ab00a3d1-afb8-40cf-92f4-030e1af70dee"
msgid ""
"\"Well… I suppose that's a reasonable solution. He would probably sell the "
"charm anyway, so this will be a win-win solution.\""
msgstr ""
"\"음... 전 그게 합리적인 해결책이라고 생각되네요. 어쨌든 그자는 그 부적을 팔게 될거고, 그러면 이게 바로 윈-윈 해결책이 될겁니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0018_Text
#. Speaker : Capital_Collector
msgctxt "da8eb2fe-a642-4090-b4b1-bad633a8f50d"
msgid ""
"\"As you wish, {mf|Your Grace|Your Grace|Your Highness|Your Highness}.\""
msgstr "\"당신이 바라시는 대로, {mf|전하|전하|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0019_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "6e8aa493-ffd1-40c1-9878-b67cf041c92d"
msgid "\"A waste of money. But I will obey.\""
msgstr "\"돈 낭비로군. 하지만 따르지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0020_Text
#. Speaker : Octavia_Companion
msgctxt "d9c59a8a-5a50-4add-a1a6-705325e1228e"
msgid ""
"\"Hey! You can't behave like that! Especially with the poor – life is "
"difficult for them as it is!\" {n}Octavia pouts.{/n}"
msgstr ""
"\"이봐요! 그렇게 행동하면 안돼요! 특히 가난한 사람에겐 삶은 그 자체로 힘든 거라고요!\" {n}옥타비아는 입술을 삐죽였다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0021_Text
#. Speaker : Capital_Collector
msgctxt "eeb2b3e6-8dc9-4614-9ea9-84463ba170a1"
msgid ""
"\"Hmm... indeed, that would solve our problem as well. I will do as you say, "
"{mf|Your Grace|Your Grace|Your Highness|Your Highness}.\""
msgstr "\"흠... 사실, 그게 우리 문제도 해결해줄 겁니다. 당신이 말씀한 대로 하지요, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0022_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "89216719-de78-4524-a4d3-af3c3d046547"
msgid ""
"\"I shall leave the castle at once and attend to the matter personally.\""
msgstr "\"난 당장 성을 떠나서 개인적으로 이 문제를 처리하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0024_Text
#. Speaker : Octavia_Companion
msgctxt "76fbdc75-a1af-400d-b221-95a65538fdbd"
msgid ""
"\"Fine! I will leave the charm with the fisherman. – The poor man deserves "
"for fortune to smile on him at last!\""
msgstr "\"좋아요! 그 어부에게 부적을 넘길게요. 그 가난한 사람은 마침내 행운의 여신에게 미소를 받을 자격이 있겠죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0025_Text
#. Speaker : Capital_Collector
msgctxt "a11550ca-77b2-4b42-be25-78c41eef0189"
msgid ""
"\"I shall allocate the required sum, immediately purchase the charm and "
"convey it to the appraiser.\""
msgstr "\"필요한 금액을 할당하겠다. 즉시 부적을 구입해서 감정인에게 전달하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank3/Cue_0026_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "3f52749e-d91e-4421-a654-fef0fd11b24c"
msgid ""
"\"I shan't hold back the guards if the peasant proves obstinate. I shall use "
"whatever force is required to procure the charm for the appraiser.\""
msgstr ""
"\"그 농민이 자신의 완강함을 증명해보인다면 전 경비대를 제지하지 않을 겁니다. 감정인에게 부적을 가져다주기 위해서라면 무력 사용도 "
"불사하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Answer_0008_Text
msgctxt "6c765912-14b6-4970-9aaf-40bcdb57ee2f"
msgid ""
"{g|Arcane4_1}[Choice effects]{/g} \"I forbid this necromancer from "
"practicing his dark arts in my realm.\""
msgstr "{g|Arcane4_1}[선택 시 효과]{/g} \"난 이 사령술사가 내 왕국에서 그의 흑마술을 시험하는 걸 금하노라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Answer_0009_Text
msgctxt "c06355e7-85d0-44a7-ad85-dbdaa70faab0"
msgid ""
"{g|Arcane4_2}[Choice effects]{/g} \"His offer sounds promising. The "
"necromancer shall receive his license.\""
msgstr "{g|Arcane4_2}[선택 시 효과]{/g} \"그 자의 제안은 괜찮게 들리는데. 그 사령술사는 면허를 발급받을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Answer_0010_Text
msgctxt "a6084274-67cf-4fce-b188-59cc18ffc8b3"
msgid "\"I'll rely upon your advice in this matter.\""
msgstr "\"이 문제에서 저는 당신의 조언에 의지하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "70b71eed-6f4c-43c4-a9d3-b8e4d93bd394"
msgid ""
"\"I have news. More and more mages come to our capital every day – and it "
"seems a small mage quarter is forming around the artifact appraiser. There's "
"new bookshops, new alchemy labs, and now we even have an illusionist's "
"parlor! That woman can conjure up more dresses and make-up and hairstyles "
"than you could imagine! Perfect for an evening out – just remember to get "
"back home before the spell wears off!\""
msgstr ""
"\"새 소식이 있어요. 점점 더 많은 마법사가 우리 수도로 매일 찾아오고 있죠. 그리고 작은 마법사 구역이 그 유물 감정사 주변에 생기는 "
"거 같아요. 거기 새 서점에, 새 연금술 연구실에 이제는 환영술점까지 생겼지 뭐에요! 그 여자 마술을 부려서 네가 상상하는 그대로 옷도 "
"입혀주고 화장에 머리 스타일까지 바꿔준다고요! 밤나들이에 아주 딱이죠. 주문이 풀리기 전에 집으로 돌아가야 한다는 것만 꼭 기억하면 되요!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "83c68394-a43c-4a38-abe6-2f26322356e5"
msgid ""
"\"I am pleased to inform Your {mf|Grace|Grace|Highness|Highness} that the "
"magical arts have blossomed in our lands, and each day more and more magic "
"users flock to our capital. A mage quarter of sorts has begun to form around "
"the artifact appraiser – bookshops, alchemy labs, and even an illusionist's "
"parlor. However, such rapid growth also attracts more... dubious "
"practitioners.\""
msgstr ""
"\"마술이 우리 땅에서 꽃 피우고, 매일 점점 더 많은 마법 사용자가 우리 도시로 몰려들고 있다는 점을 알려드리게 되어 정말 기쁩니다, "
"{mf|영주님|영주님|전하|전하}. 변변찮은 마법사 구역이 유물 감정사 근처에 생기기 시작했습니다. 서점, 연금술 연구실, 거기에 "
"환영술점까지요. 하지만, 그런 빠른 성장은 더 많은... 수상쩍은 종자도 끌어들이는 법이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0003_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "eaf6f88b-6307-43c5-aae5-8f2c0b5a3801"
msgid ""
"\"The mystic arts are gradually taking root in your capital… as much as can "
"be expected in such a primitive era. Like ants swarming a mound, more and "
"more gather around that artifact appraiser. How proudly they present him "
"with their poorly-drawn scrolls and dandelion tinctures! But one of them "
"proves even more amusing...\""
msgstr ""
"\"신비술이 당신네 수도에서 점점 뿌리를 뻗고 있습니다... 꼭 선사시대 만큼이나 말입니다. 개밋둑에 들끓는 개미처럼 더 많은 사람들이 "
"그 유물 감정사 근처에 모이고 있어요. 그자들이 얼마나 자랑스럽게 조잡하게 그려진 두루마리나 민들레즙따위를 바쳐대는지! 하지만 그들 중 "
"하나는 훨씬 더 우스운 꼴을 보이기도 했죠... \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0004_Text
#. Speaker : Octavia_Companion
msgctxt "b0c5f5a3-c5ea-4f84-8f7b-5fac59218b75"
msgid ""
"\"However… there's a darker side to this expansion. A necromancer from Geb "
"is looking to set up shop in your domain. – He wishes to raise undead "
"servants and rent them out as cheap labor! In his homeland, skeletons till "
"the fields, cut down trees and mine ore... while elsewhere, around the world "
"necromancy is strictly forbidden, for in order to animate a dead body, one "
"must snip off a small fragment of the soul that once resided within it! Our "
"guest asks you for a license. In return, he promised to supply us with a "
"fresh batch of 'workers'...\""
msgstr ""
"\"그렇지만... 이런 팽창엔 더 어두운 면도 있어요. 게브에서 온 한 사령술사는 영지에서 가게를 내려고 하고 있죠. 그 자는 언데드 "
"하수인을 일으켜서 값싼 노동력으로 임대하고 싶어해요! 그의 고향에선 스켈레톤들이 밭을 갈고, 나무를 베거나 광물을 캔답니다... 반면에 "
"다른 세계 곳곳에서는 사령술이 엄격하게 금지되어 있어요. 시체를 움직이기 위해선 누군가 그 안에 있던 영혼의 작은 조각을 잘라내야 "
"하니까요! 그 손님은 당신에게 허가를 요청하고 있고 그 보답으로 그 사람은 우리에게 신선한 '일꾼' 한 무리를 제공해줄 것을 약속했어요."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "82d18acf-6607-42d5-9b6e-b4507477d759"
msgid ""
"\"I have been approached by a master necromancer from Geb. Considering that "
"his craft is outlawed and vilified across the world, he suggests a deal. We "
"supply him a license, allowing him to provide 'non-living workforce rental "
"services' – Which means we'll allow him to raise undead laborers and rent "
"them out to farms, sawmills and warehouses. In gratitude, he will deliver us "
"his first batch of 'workers'.\""
msgstr ""
"\"겝에서 온 사령술사 대가 하나가 저에게 접근 해왔습니다. 그의 제작품이 위법한데다 세계에서 비난받고 있다는 걸 고려해서, 그가 제안을 "
"하나 해왔습니다. 우리가 '비생물 노동력 제공 서비스'를 제공할 수 있는 면허를 발급해주는 겁니다. 즉, 그자가 언데드 노동자를 일으켜서 "
"농장이나 제재소, 물류창고 등에 임대하도록 허가한다는 말이죠. 그 감사의 표시로 그 사람이 우리에게 첫 '일꾼' 한 무리를 보내줄 겁니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0006_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "5f5971ea-7c84-47d8-8964-5a37f8a0fe80"
msgid ""
"\"A puny peddler, who dares to call himself a necromancer, sought an "
"audience with me. He begged us to give him a license which would allow him "
"to create undead slaves which he could then rent out to farms, sawmills and "
"mines. Power over death itself, and the spirits of the dead, even the secret "
"of life eternal – all right under his nose! And his only thought is to rent "
"out farm labor!\""
msgstr ""
"\"감히 자신을 사령술사라고 칭하는 별볼일 없는 행상인 하나가 저에게 알현을 청했습니다. 그자는 우리에게 언데드 노예를 만들 수 있는 "
"면허를 구걸하더군요. 농장이나 제재소, 광산에 임대할 수 있는 노예 말입니다. 죽음 자체를 넘어선 힘, 사자의 영혼, 심지어 영생의 "
"비밀까지... 모든 게 그의 코 앞에 있습니다! 그리고 그자는 농장 노동자를 임대해줄 생각 뿐이군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0011_Text
#. Speaker : Octavia_Companion
msgctxt "e0fe3f4f-7b83-4e66-ad09-f312aa82a8f1"
msgid ""
"\"Wonderful! I hope this vulture will leave the capital for good, as soon as "
"I deliver him the news.\""
msgstr "\"좋아요! 내가 그자에게 소식을 전하는 대로 이 사기꾼을 수도에서 내보낼게요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0012_Text
#. Speaker : Capital_Collector
msgctxt "5e1cab9a-ce8d-4ddf-9ac7-b6885c729d75"
msgid ""
"\"I support this decision wholeheartedly, Your "
"{mf|Grace|Grace|Highness|Highness}.\""
msgstr "\"이 결정을 진심으로 지지합니다, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0013_Text_String
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "046a68dd-86a7-43f5-b3aa-8d85bfed6471"
msgid ""
"\"An… interesting… decision. Especially in light of other decisions Your "
"{mf|Grace|Grace|Highness|Highness} has made earlier.\" {n}\"Maegar\" grins "
"at you knowingly.{/n} \"But as you wish.\""
msgstr ""
"\"정말... 흥미로운... 선택이군. 여태까지 내린 결정에 비추어보면 말이야.\" {n}\"메이가르\"는 다 알고 있다는 듯 씩 "
"웃습니다.{/n} \"하지만 원하시는 대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0014_Text_String
#. Speaker : Octavia_Companion
msgctxt "9cb00789-6bc2-4274-92b7-2685d51b4007"
msgid ""
"\"What?! You're going to let that vulture…\" {n}Octavia catches herself and, "
"after a moment, exhales loudly.{/n} \"As you wish. But this will be on your "
"conscience – not mine.\""
msgstr ""
"\"뭐?! vulture를 보내준다고... \" {n}옥타비아는 말을 멈추더니 잠시 후 크게 한숨 쉬었다.{/n} \"바라는 대로. "
"하지만 이건 네 양심에 걸릴 일이야. 내가 아니라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0015_Text_String
#. Speaker : Capital_Collector
msgctxt "940f58d9-400c-4372-b18d-719cd9e0d830"
msgid ""
"{n}A deep shadow falls across the Storyteller's face.{/n} \"A most… "
"unfortunate decision.\""
msgstr "{n}짙은 그림자가 이야기꾼의 얼굴에 드리운다.{/n} \"아주... 불운한 결정이군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0016_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "ee7c0326-e6a9-4103-8146-ed078224a569"
msgid ""
"{n}\"Maegar\" bows to you with grim satisfaction.{/n} \"I will tell the "
"necromancer of your decision. The might and power of our lands shall grow "
"manifold.\""
msgstr ""
"{n}\"매가르\"는 음침한 만족감과 함께 당신에게 절했다.{/n} \"당신의 결정을 사령술사에게 전하겠습니다. 우리 땅의 힘과 권세가 "
"다양성을 불러오는군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0018_Text
#. Speaker : Capital_Collector
msgctxt "103b9d5f-13d0-4c08-bdde-be791c405893"
msgid ""
"\"I shall inform the necromancer that his dark arts have no place in these "
"lands.\""
msgstr "\"이 땅 위에 그 강령술사가 흑마술을 펼칠 자리가 없다는 걸 가르쳐줘야겠군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0020_Text
#. Speaker : Capital_Collector
msgctxt "0ead3a34-b1d5-4f75-ae14-00d9a1b6839c"
msgid ""
"\"He assured me that he only works with 'willingly donated materials' – "
"bodies of peasants who signed a contract prior to death. Nevertheless, I "
"advise you to decline his offer. It must be remembered that the necromancer "
"must cut off a small piece of the departed soul, in order to animate a body. "
"Also bear in mind that our living workers cannot compete with undead slaves. "
"Thus our good people will grow even poorer – and be forced to sell their own "
"labor for even less. This would result in a vicious cycle gradually making "
"our state completely dependent on the services of necromancers.\""
msgstr ""
"\"그 자는 저에게 자기는 '기꺼이 기부받은 물건'으로만 일한다고 장담하더군요. 죽기 전에 계약에 서명한 농민의 시체 말입니다. 하지만, "
"저는 당신에게 그자의 제안을 거부하라고 충고드리지요. 사령술사는 시체를 움직이기 위해 고인의 영혼에서 작은 조각을 떼어내야만 한다는 걸 "
"반드시 기억해야 합니다. 또한 우리의 살아있는 일꾼은 언데드 노예들과 경쟁할 수 없다는 사실도 명심하십시오. 따라서 우리의 선한 민중은 "
"더욱 빈곤해질 것이고, 더 적은 돈으로 일하도록 강요받을 겁니다. 이건 우리의 남작령이 점점 사령술사의 서비스에 완전히 종속되는 악랄한 "
"순환에 갇히는 결과로 이어진다는 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0021_Text
#. Speaker : Octavia_Companion
msgctxt "a1b515ee-0983-4b30-8cd1-cd552f5d8a27"
msgid ""
"\"Just thinking about it makes me sick. He vows only to use those who sign a "
"contract while they're still alive, selling their own bodies away for a few "
"gold coins. However, I have little doubt that this will lead to all sorts of "
"trouble. First, enterprising citizens will buy shovels and develop the habit "
"of paying nightly visits to the graveyard. Then beggars and orphans will "
"start disappearing from the streets... No, {name}, we cannot allow this to "
"happen!\""
msgstr ""
"\"그 일에 대해 생각하는 것 만으로도 마음이 아파요. 그자는 생전 동전 몇 푼에 몸을 팔아 계약에 서명한 사람만을 사용한다고 맹세했죠. "
"그렇지만 전 이 일이 온갖 문제로 이어질 거라고 조금 의심하고 있어요. 우선 진취적인 시민들은 삽을 사서 밤마다 무덤에 방문하는 습관을 "
"기르겠죠. 그리고 거지와 고아들은 거리에서 사라지기 시작할 거고요... 안 돼요, {name}, 우린 이런 일이 일어나게 두어선 안 돼요!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/Cue_0022_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "5e917e4c-057e-4fdd-8ea1-54b842cde177"
msgid ""
"\"Nevertheless, in return for his license he promises to supply us with his "
"first batch of 'workers'. Of course, we should agree to his offer. No matter "
"how pitiful his creations might be, an undead slave is always worth more "
"than a living one. The undead never tire, and never fall sick. They obey "
"orders without question. They require no pay, no food, no rest – nor even "
"light.\""
msgstr ""
"\"그런데, 면허증 발급에 대한 대가로 그자가 우리에게 첫 '일꾼' 한무리를 제공해주기로 했지요. 물론, 우리는 그 요청에 동의했고요. "
"그자의 창조물이 얼마나 가엾든 간에, 언데드 노예는 항상 산 자보다 가치있습니다. 언데드는 결코 지치지도, 병에 걸리지도 않지요. "
"그것들은 아무 의문도 없이 명령에 복종합니다. 임금도, 음식도, 휴식도, 심지어 빛조차도 필요 없죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank4/MagisterVordakaiLeaves_Text_String
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "55fd0dd3-d6b4-4a3b-a11e-2fe4778da1ca"
msgid ""
"{n}Giving you a sharp look, \"Maegar\" continues in an irritated voice:{/n} "
"\"I should inform you that this will be the last order I shall take in this "
"position. I've had enough of this nonsense – and I've better things to do "
"with my time than squabble over petty complaints and run trifling errands.\""
msgstr ""
"{n}당신을 날카롭게 바라본 \"매가르\"는 신경질나는 목소리로 말을 이었다:{/n} \"내가 이 위치에서 당신의 명령을 듣는 건 이번이 "
"마지막이라는 걸 알려드려야겠어. 이런 허튼 짓거리는 이제 충분해. 그리고 내 삶에서 이딴 쓸데없는 불평과 하찮은 심부름에 대해 말다툼 "
"하는 것보다 더 나은 일들이 많을 테지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Answer_0008_Text
msgctxt "d26e483a-ba30-4d25-a4bf-647218c94008"
msgid ""
"{g|Arcane5_1}[Choice effects]{/g} \"From now on there will be no more "
"magical experiments within the city walls. It's far too dangerous.\""
msgstr "{g|Arcane5_1}[선택 시 효과]{/g} \"이 시각부로 도시 내에 모든 마법 실험 행위를 금지하겠다. 너무 위험해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Answer_0009_Text
msgctxt "9da06c1a-9339-48f4-bd6c-25f877510f2e"
msgid ""
"{g|Arcane5_2}[Choice effects]{/g} \"The experiments must continue. The "
"townspeople will just have to put up with it.\""
msgstr "{g|Arcane5_2}[선택 시 효과]{/g} \"실험을 계속 진행시켜라. 시민들은 내 결정을 받아들여야만 할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Answer_0010_Text
msgctxt "71632d2a-550c-4712-b6fb-42d97bcf011e"
msgid "\"I leave this decision to you.\""
msgstr "\"이 결정을 당신께 넘기겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Conf_MagisterCollectorLeaves_Text_String
#. Speaker : Capital_Collector
msgctxt "745d4364-6223-47a3-a7a5-8976e8c1b1e0"
msgid ""
"{n}After a short silence, the Storyteller decides to continue:{/n} \"Forgive "
"me, Your {mf|Grace|Grace|Highness|Highness}, but I can no longer occupy the "
"position of Magister. My advice is of no use to you, for we see life so "
"differently. To follow your orders means going against my conscience. I hope "
"whoever replaces me will be able to serve Your "
"{mf|Grace|Grace|Highness|Highness} better than I could.\""
msgstr ""
"{n}짧은 침묵 후에, 이야기꾼은 계속 말하기로 결심했다:{/n} \"용서하십시오, {mf|영주님|영주님|전하|전하}, 하지만 저는 더 "
"이상 마법대신으로 있을 수 없겠군요. 우리는 서로 삶을 너무나 다르게 바라보고 있고, 때문에 제 충고는 당신에게 쓸모가 없습니다. 당신의 "
"명령을 따르는 건 제 양심에 반한다는 뜻입니다. 누가 되었든 제 자리를 대신할 사람이 {mf|영주님을|영주님을|전하를|전하를} 저보다 더 "
"잘 섬기길 바라겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Conf_MagisterOctaviaLeaves_Text_String
#. Speaker : Octavia_Companion
msgctxt "8297a6cf-a5b7-487e-8355-c7147bab87d6"
msgid ""
"\"{name}, I… I just can't go on like this. We're just too different! All the "
"things that I'd pursue, you just say they're useless. Whenever I come up "
"with an idea, you reject it. Worst of all, your sense of right and wrong is "
"completely different from mine! {n}Octavia exhales decisively.{/n} \"I'll "
"just have to give up my position as Magister... no matter how difficult that "
"is for me. But don't worry, I'll still be glad to join you on your "
"adventures and follow you into battle.\""
msgstr ""
"\"{name}, 나... 난 이런 식으로는 못하겠어. 우린 그냥 너무 달라! 내가 추구하는 모든 것들, 그런걸 넌 그냥 쓸모없다고만 "
"해. 내가 아이디어를 들고갈 때마다 항상 넌 그걸 퇴짜놓잖아. 최악은, 너의 선악에 대한 판단이 나와는 완전히 다르다는 거야! {n}"
"옥타비아는 단호하게 숨을 내쉬었다.{/n} \"난 그냥 마법대신으로서 내 지위를 포기하겠어... 그게 나에게 아무리 어려운 일이라 해도 "
"말야. 하지만 걱정하지마. 난 여전히 네 모험에 기꺼이 동참하고 전투에도 따를테니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "7782055a-aaf8-4ed8-848b-659c30c70753"
msgid ""
"\"{name}, the townsfolk have launched a complaint against the inhabitants of "
"the mages' quarter. They speak of 'dubious characters prowling the streets', "
"while their sleep is disrupted by 'terrifying noises' and 'flashes of "
"color'. So no big deal, right? But the people became fed up when a young "
"alchemist's mistake lead to a... uhhh... contained explosion.\""
msgstr ""
"\"{name}, 마법사 구역의 주민들이 불평을 제기했어. '끔찍한 소음'과 '현란한 섬광' 때문에 잠을 방해받는 동안 '거리를 배회하는 "
"수상한 인물들'에 대해 떠들어댄다고. 그러니까 대수로운 일은 아니야, 그렇지? 하지만 어린 연금술사들의 실수가... 어음... 억제된 "
"폭발로 이어질 땐 진저리가 났어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "3b1c97ac-3ad2-4a44-b20a-8cdb67c151aa"
msgid ""
"\"There's a matter that demands your personal attention, Your "
"{mf|Grace|Grace|Highness|Highness}. The people of the capital have lodged a "
"complaint against the inhabitants of the mages' quarter. Not only do "
"unnatural sounds and strange lights disturb the peace, especially within the "
"quarter itself – but also, the ongoing experiments have simply become too "
"dangerous.\""
msgstr ""
"\"당신이 면밀히 보셔야 할 문제가 있습니다, {mf|영주님|영주님|전하|전하}. 수도 시민들이 마법사 거주구역에 대한 불만 사항을 "
"제기했습니다. 평화를 깨는 부자연스러운 소음과 빛 뿐만이 아니라, 거주구 내에서 행하는 실험들이 그 자체로 너무 위험해졌습니다. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0003_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "96362b0a-086e-4c43-aaac-b3fab638e7b7"
msgid ""
"\"The rabble once more forgets its place, {name}! A madding crowd of "
"concerned idiots has lodged a complaint against the inhabitants of the "
"mages' quarter. The brainless vermin tremble in terror at the sight of "
"anything that exceeds their narrow frame.\""
msgstr ""
"\"잡놈들이 여기가 어디인지 또 잊었나보군요, {name}! 걱정거리로 미쳐버린 멍청이들이 마법사 구역의 주민들에 대해 불만을 "
"제기했습니다. 그 뇌 없는 벌레같은 놈들은 자신의 좁은 기준에 조금이라도 어긋나면 무서워서 몸서리치죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0004_Text
#. Speaker : Octavia_Companion
msgctxt "9c74d52c-6bb1-41f6-86b7-f25b3b493c41"
msgid ""
"\"I understand just how… difficult it can be to live alongside mages and "
"alchemists. But if we forbid their experiments, the magical potential of our "
"{mf|barony|barony|kingdom|kingdom} will surely dwindle! If we limit their "
"freedom to research, we'll clip our mages' wings, and they won't be able to "
"help us expand. Therefore, I think we should refuse the citizens' complaint."
"\""
msgstr ""
"\"옆집에 마법사나 연금술사가 살면 힘들죠. 하지만 비전 실험을 금지하면 {mf|남작령|남작령|왕국|왕국}의 마법 잠재력이 점점 줄어들 "
"거예요! 연구할 자유를 억압하면, 마법사와 연금술사의 날개를 꺾어버리는 거예요. 영토 확장에 도움을 줄 수도 없게요. 저는 시민들의 "
"항의를 무시해야 한다고 생각해요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "102f6611-19eb-4173-8d34-e97fbbbab774"
msgid ""
"\"I've no doubt that some of these reports might be exaggerated. However, I "
"also have no doubt that on the whole, the concerns of our citizens are well-"
"founded. Magical experiments have no place in a densely populated city. "
"Thus, I suggest that performing magical experiments inside the city walls "
"should be outlawed.\""
msgstr ""
"\"이 보고서가 과장된 것일 수도 있다는 사실은 의심의 여지가 없습니다. 그러나, 또한 우리 시민들의 우려가 충분히 근거가 있다는 사실을 "
"믿어 의심치 않습니다. 마법 실험은 인구가 많은 도시에서는 설 자리가 없죠. 그러므로, 저는 도시의 성벽 안에서의 마법 실험을 금지할 "
"것을 제안드립니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0006_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "e176e07c-26d2-4cdf-8f73-311001163b38"
msgid ""
"\"The answer is clear. If one wishes for magic to continue growing and "
"developing in their {mf|barony|barony|kingdom|kingdom}, one should accept "
"that many experiments end in explosions, whirlwinds and clouds of acid. It "
"is vain to hope for any better in these backwards lands. Those who complain "
"may go to hell – they're even more useless than our dimwitted mages.\""
msgstr ""
"\"답은 명료합니다. 누군가 그들의 {mf|남작령|남작령|왕국|왕국}에서 마법이 자라고 발전하길 바란다면 많은 실험이 폭발과 회오리바람, "
"그리고 산성비로 끝난다는 사실을 용납해야 해야 합니다. 이 뒤떨어진 땅에서 더 나은 걸 기대하는 건 헛된 일입니다. 불평하는 것들은 "
"지옥에나 가라지요. 그것들은 우리 얼빠진 마법사들보다 훨씬 더 쓸모없는 것들이니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0011_Text_String
#. Speaker : Octavia_Companion
msgctxt "ca10b926-af24-428d-9c20-d7a731da9cf7"
msgid ""
"{n}Octavia's shoulders sink.{/n} \"Perhaps… perhaps you're right. But how "
"crushing it will be to deliver this news to my friends…\""
msgstr ""
"{n}옥타비아의 어깨가 축 늘어졌다.{/n} \"아마... 아마도 네가 맞을지 몰라. 하지만 이 소식을 내 친구들에게 전하는 게 얼마나 "
"참담할까...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0012_Text
#. Speaker : Capital_Collector
msgctxt "c8b8304a-9957-4b1f-b596-7b9b881a72ee"
msgid ""
"{n}The Storyteller nods.{/n} \"I shall speak with the inhabitants of the "
"mages' quarter.\""
msgstr "{n}이야기꾼이 고개를 끄덕였다.{/n} \"마법사 구역의 주민들과 이야기를 해보겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0014_Text
#. Speaker : Octavia_Companion
msgctxt "2e544f6d-4b1e-4384-88a6-2df9acf8a014"
msgid ""
"\"I knew you'd understand! Don't worry, I'll find a way to calm down the "
"neighbors. We'll put on a fireworks show or something…\""
msgstr "\"네가 이해해줄줄 알았어! 걱정마, 사람들을 진정시킬 방법을 찾아볼게. 불꽃놀이나 뭐 다른걸 하면...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0015_Text_String
#. Speaker : Capital_Collector
msgctxt "703057c0-5b7e-4d1a-828e-d551f49e1f6d"
msgid ""
"{n}The Storyteller frowns.{/n} \"A risky decision, Your "
"{mf|Grace|Grace|Highness|Highness}. But so be it.\""
msgstr "{n}이야기꾼은 눈살을 찌푸렸다.{/n} \"위험한 결정입니다, {mf|영주님|영주님|전하|전하}. 하지만 그리 하십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0016_Text_String
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "f77d34db-2bb7-4ab6-8e82-8111ee3ef9bf"
msgid ""
"\"You put the interests of peasants and serfs above your own. Do you hope to "
"buy their loyalty with a show of weakness? How naïve.\""
msgstr ""
"\"당신은 농민과 농노의 이익을 자신의 것보다 우선했군요. 약점을 보여주어 그들의 충성심을 사려고 하는 겁니까? 참 순진하군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0017_Text
#. Speaker : Octavia_Companion
msgctxt "54c35beb-2b72-4d96-ade5-fb9bfef8fc2e"
msgid ""
"\"Wonderful! I shall tell everyone at the mages' quarter that they may carry "
"on with their experiments.\""
msgstr "\"훌룡합니다! 마법사 구역의 모두에게 그들의 실험을 가져와도 된다고 전하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0021_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "5dd6994b-0f6f-4cf0-a530-2b64cc9e618e"
msgid ""
"\"Splendid. I won't even bother replying to the whiners. It sickens me even "
"to look at them.\""
msgstr "\"멋지군요. 저 징징이들에게 하는 대답은 신경쓰기도 싫습니다. 그 사람들을 보는 것만으로도 역겹습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0024_Text_String
msgctxt "982c4388-1eb0-48a8-ba3a-76bdff1e5d55"
msgid ""
"{n}Giving you a sharp look, \"Maegar\" continues in an irritated voice:{/n} "
"\"I should inform you that this will be the last order I shall take in this "
"position. I've had enough of this nonsense – and I've better things to do "
"with my time than squabble over petty complaints and run trifling errands.\""
msgstr ""
"{n}당신을 날카롭게 바라본 \"매가르\"는 신경질나는 목소리로 말을 이었다:{/n} \"내가 이 위치에서 당신의 명령을 듣는 건 이번이 "
"마지막이라는 걸 알려드려야겠어. 이런 허튼 짓거리는 이제 충분해. 그리고 내 삶에서 이딴 쓸데없는 불평과 하찮은 심부름에 대해 말다툼 "
"하는 것보다 더 나은 일들이 많을 테지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0025_Text
#. Speaker : Octavia_Companion
msgctxt "f5deed33-e5cc-46af-b43c-ca7ad428e2c7"
msgid ""
"\"Windows all along the street started shaking, and then some sticky purple "
"substance rained down on the town. Children started playing with it "
"immediately. Well, that was messy! Allegedly, it made the streets smell like "
"a 'wet goblin's hide' for a whole week!\" {n}Octavia tuts.{/n} \"They're "
"amazingly well versed, these accusers. They must have plenty of time to go "
"out smelling wet goblins!\""
msgstr ""
"\"온 거리의 창문이 흔들리기 시작하고 끈적이는 보라색 물체가 마을로 떨어져 내렸어. 아이들은 곧바로 그걸 가지고 놀기 시작했지. 뭐, "
"아주 엉망진창이었다고! 전해진 바에 따르면, 그게 한 주 내내 길거리에서 '젖은 고블린 가죽' 냄새가 나게 했다더라고! {n}옥타비아는 "
"혀를 찼다.{/n} \"이 고발자들 완전 전문가가 다 됐지. 밖에서 엄청나게 오래 젖은 고블린 냄새를 맡아야 했으니까 말야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0026_Text
msgctxt "5aeba8e0-3b96-4684-841d-19bed1e4c6e3"
msgid ""
"\"A young alchemist's experiments have lead to an explosion so powerful that "
"his neighbors up and down the street felt their window panes tremble. Later "
"that day, an unidentified purple substance fell from the sky – all over the "
"city. Our people complained that it made the capital reek of 'wet goblin "
"hide'.\" {n}The Storyteller raises a concerned eyebrow.{/n}"
msgstr ""
"\"한 젊은 연금술사의 실험이 거리에 위아래 이웃들의 유리창이 떨리는 걸 느낄 만큼 강력한 폭발을 일으켰습니다. 그날 늦게, 정체불명의 "
"보라색 물질이 하늘에서 떨어져내렸습니다. 도시 전체에 말입니다. 우리 주민들은 그게 수도에서 '젖은 고블린 가죽' 냄새가 풍기게 한다고 "
"불평했습니다.\" {n}이야기꾼은 눈썹을 걱정스럽게 치켜떴다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank5/Cue_0027_Text
msgctxt "25c1e6e1-945b-417c-b3b1-93563e72567d"
msgid ""
"\"As you can imagine, this list includes practically everything: lights, "
"noises, and smells… The complaint was renewed today after an explosion at an "
"alchemy lab which made the whole city 'reek of wet goblin hide'! Ha!\""
msgstr ""
"\"네가 상상하는 대로, 이 목록엔 사실상 거의 모든 게 들어 있어. 빛, 소음, 냄새... 온 도시에서 '젖은 고블린 가죽 냄새'가 "
"풍기게 만든 연금술 실험실 폭발 이후에 오늘 민원이 경신됐다고! 하!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Answer_0008_Text
msgctxt "85d31aa1-3010-4b62-97fd-66e1a06a3f88"
msgid ""
"{g|Arcane6_1}[Choice effects]{/g} \"From this day forth, the creation of "
"undead, no matter the intent, is forbidden, and shall be punished by law.\""
msgstr ""
"{g|Arcane6_1}[선택 시 효과]{/g} \"오늘 이후로, 언데드의 작성은 의도를 불문하고 금지되며 법에 의해 처벌 받는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Answer_0009_Text
msgctxt "e2b78062-5a8d-4f4e-8bf8-9642281541cb"
msgid ""
"{g|Arcane6_2}[Choice effects]{/g} \"My decision stands. Any subject who has "
"received a necromancer's license may carry on with their work as before.\""
msgstr ""
"{g|Arcane6_2}[선택 시 효과]{/g} \"제 결정은 유효합니다. 네크로맨서 자격증을 취득한 모든 백성들은 전과 같이 일을 "
"계속할 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Answer_0010_Text
msgctxt "5cb00e2f-a31a-40d3-bc5b-d6d902f152e8"
msgid "\"I trust in your vision. Act as you deem fit.\""
msgstr "\"전 당신의 비전을 믿습니다. 당신이 옳다고 생각하는 대로 행동하십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Answer_0025_Text
msgctxt "b18df751-cdac-4452-8214-6268c80d1a6e"
msgid ""
"{g|Arcane6_3}[Choice effects]{/g} \"He has my permission. Let's see if his "
"golems are as good as he claims.\""
msgstr "{g|Arcane6_3}[선택 시 효과]{/g} \"허락하마. 그자의 골렘들이 주장하는 것 만큼 괜찮은지 보도록 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Answer_0026_Text
msgctxt "9b84d1ba-622a-4438-843b-ad5c0709180e"
msgid "{g|Arcane6_4}[Choice effects]{/g} \"We shall not employ his services.\""
msgstr "{g|Arcane6_4}[선택 시 효과]{/g} \"우리는 그의 서비스를 이용하지 않을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Answer_0027_Text
msgctxt "4f36abe5-2533-4512-9f22-43a442635da7"
msgid "\"You may resolve this issue as you see fit.\""
msgstr "\"이 사안은 당신이 적절히 해결할 수 있을겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "498fe3d6-d6b3-4148-8a25-fc22de82bb39"
msgid ""
"{n}Octavia looks worried.{/n} \"Our dalliances with necromancy have not gone "
"unnoticed, {name}. The priesthood of {g|Pharasma}Pharasma{/g}, the goddess "
"of fate and death, has sent a delegation to our capital. The goddess abhors "
"the undead, and her followers demand that we 'put an end to the blasphemy' – "
"that is, stop creating undead laborers.\""
msgstr ""
"{n}옥타비아가 걱정스럽게 바라봅니다.{/n} \"사령술에 대한 헛수고는 끝나지 않았어요, {name}. 우리 수도로 운명과 죽음의 "
"여신, {g|Pharasma}파라스마{/g}의 사제들이 사절단을 파견했다고 해요. 그 여신은 언데드를 혐오하며, 그녀의 추종자들은 "
"'모욕에 종지부를 찍으라'며 요구하고 있어요. 그 말인 즉슨, 언데드 노동자들을 그만 만들라는 뜻이겠죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "4e39b90a-12fa-4491-a7dc-ce5a585ebf26"
msgid ""
"\"A delegation of pharasmites has entered the capital, Your "
"{mf|Grace|Grace|Highness|Highness}. Necromancy disrupts the natural cycle of "
"life and death, and for that reason {g|Pharasma}the Lady of Graves{/g} "
"forbids the practice of this foul craft. Her priests and her faithful demand "
"that we ban necromancy across your lands and put an end to this blasphemy.\""
msgstr ""
"\"파라즈마의 사절단이 수도에 도착했습니다, {mf|영주님|영주님|전하|전하}. 사령술은 삶과 죽음의 순환을 어지럽히며, 그렇기 때문에 "
"{g|Pharasma}무덤의 여인{/g}께서는 그 더러운 술수를 금지하십니다. 그녀의 사제들과 신도들은 당신의 땅에서 사령술을 철전하고 "
"신성모독을 멈출 것을 요구합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0003_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "fbd03dae-be8d-44c8-80c7-ce1629fee9fc"
msgid ""
"{n}Today, as always, \"Maegar\" is clearly not in high spirits...{/n} \"This "
"world is replete with meddlesome idiots. I am plagued by pharasmites. Their "
"goddess hates the undead, so they're constantly demanding that we surrender "
"our undead slaves and ban the creation of new ones.\""
msgstr ""
"{n}언제나 그렇듯 오늘도, \"메이가르\"는 기분이 별로 좋아보이지 않습니다...{/n} \"세상엔 오지랖 넓은 바보들이 어찌 이렇게 "
"많은지. 파라즈마의 벌레들이 나를 귀찮게 하는군. 그네들 여신은 언데드를 싫어하는지라, 계속해서 우리 언데드들을 처분하고 새로 만들지도 "
"말라 요구하고 있다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0004_Text
#. Speaker : Octavia_Companion
msgctxt "514b3ba8-cd1b-4a44-b285-635bc2bf9540"
msgid ""
"\"I think we should listen to the priests. Raising undead is an evil, "
"violent act. It cuts away and corrupts a fragment of the departed soul. We "
"never should have allowed this dark craft in our lands… and it is high time "
"we put things right!\""
msgstr ""
"\"사제들에게 이야기를 들어봐야 할 것 같습니다. 언데드를 일으키는 건 사악하고, 끔찍한 행동입니다. 세상을 떠난 영혼의 조각을 잘라내서 "
"타락시킨단 말입니다. 우리 땅에서 이 사악한 행동을 허락해선 안 됩니다... 그리고 지금이 우리가 일을 바로잡기 딱 좋은 때군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "6bdb30d1-81ac-4ecf-8eb3-9233589723e7"
msgid ""
"\"I believe that we should agree to their request. This is only because the "
"availability of cheap undead slaves has led to the impoverishment of living "
"laborers. But worse, in order to create an undead minion, a mage must cut "
"away a miniscule fragment of from the departed soul, and corrupt it with "
"negative energy. They then plant this seed back into the dead body. Nothing "
"can justify such depravity.\""
msgstr ""
"\"저는 그들의 요청을 들어주야 한다고 생각합니다. 저렴한 언데드 노예 때문에 살아있는 노동자들이 빈곤해졌기 때문이죠. 더 나쁜 사실은, "
"언데드 하수인들을 만들기 위해 마법사들이 죽은 영혼을 조각내어 음에너지로 타락시켜야만 한다는 점입니다. 그 뒤 죽은 시체에 타락한 영혼을 "
"심어놓죠. 이런 타락적인 행동은 그 어떤 이유로도 정당화 할 수 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0006_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "b275c7f5-a0c4-4483-91cf-f8f82a50a60b"
msgid ""
"\"Their incessant wailing makes my teeth hurt. The imbeciles must learn "
"their place – and we must put an end to their complaints once and for all. "
"Need I remind you that necromancy is the only path that leads to true power?"
"\""
msgstr ""
"\"그들의 끊임없는 통곡이 내 이를 갈게 만든다. 얼간이들은 그들의 분수를 알아야만 한다. 그리고 우리는 그들의 불평을 완전히 끝내야만 "
"한다. 내가 너에게 네크로맨시가 진정한 힘으로 통하는 유일한 길이라는 사실을 상기시켜줘야 하나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0011_Text
#. Speaker : Octavia_Companion
msgctxt "c81b5d75-c009-4d8f-a48c-d34c96affffc"
msgid ""
"{n}Octavia gives a sigh of relief.{/n} \"A decision that should have been "
"made long ago!\""
msgstr "{n}옥타비아는 안도의 한숨을 내쉰다{/n} \"진작에 그랬어야 했는데!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0015_Text_String
#. Speaker : Capital_Collector
msgctxt "78c7a496-ce6b-4ea8-95c7-eb398821206a"
msgid "\"And, just as before, it shall remain a cruel thing to do.\""
msgstr "\"그리고, 전과 마찬가지로, 이는 잔인한 일로 남을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0016_Text_String
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "4535d008-0311-412f-a6c5-88dcb1a695ee"
msgid ""
"{n}\"Maegar\" snorts in derision.{/n} \"For some reason, I knew that you "
"wouldn't have the resolve to just send them away. Mage only hamper their own "
"growth when they bow to the will of clueless laymen.\""
msgstr ""
"{n}\"메이가르\"가 코웃음 칩니다{/n} \"역시나. 그들을 빈 손으로 돌려보내지 않을거라 생각했지. 마법사가 무논리한 비전문가들의 "
"의사를 일일이 들어준다면 자신의 성취를 방해받을 뿐이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0017_Text
#. Speaker : Octavia_Companion
msgctxt "5b9bd582-43e1-44e0-89f1-5cfdb9710c84"
msgid "\"Very good. In that case, raising the undead shall become illegal.\""
msgstr "\"좋아요. 그러면, 이제부턴 강령술을 불법으로 지정할게요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0018_Text
#. Speaker : Capital_Collector
msgctxt "65968046-6d63-4527-af19-86f1d276aa46"
msgid ""
"{n}The Storyteller nods.{/n} \"I shall inform {g|Pharasma}Pharasma's{/g} "
"faithful that they may rest easy.\""
msgstr "{n}이야기꾼은 고개를 끄덕입니다.{/n} \"{g|Pharasma}파라즈마{/g} 신도들에게 편히 쉬라 일러두겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0019_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "7387283c-a188-43f4-8bd9-0b8d05004609"
msgid ""
"\"Splendid. I shall decline the pharasmites' complaint, may they find "
"themselves in their goddess' cold embrace as swiftly as possible.\""
msgstr "\"훌륭하군. 나는 파라즈마 벌레들의 불평을 거절하고, 가능한 빨리 놈들을 그 여신의 차가운 품속에 안겨 주겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0020_Text
#. Speaker : Octavia_Companion
msgctxt "c4a2fe7a-31f6-44f4-8744-640e0df7733c"
msgid ""
"\"An amazingly impudent fellow, {name}! I have been approached by a wizard "
"from Nex, who has learned to create golems from piles of literal junk: "
"splinters of wood, rusty nails, broken furniture… He asks your permission to "
"set up shop in the capital and start selling these junk golems. In return, "
"he promises to provide us with a few of his finer creations. Now, you may "
"find this surprising... but I am convinced that we must reject his proposal."
"\""
msgstr ""
"\"{name}, 놀랍도록 뻔뻔한 사람이 있어요! 넥스에서 온 위저드가 다가왔는데, 그 자는 말 그대로 쓰레기로 골렘을 만들 수 있는 "
"자였죠. 나무 조각, 녹슨 못, 부서진 가구... 그 자는 수도에 상점을 차려서 그 쓰레기 골렘들을 팔 수 있게 해달라고 요청했어요. "
"답례로 우리에게 더 훌륭한 작품 몇 가지를 제공하겠다고 약속했죠. 뜻밖이겠지만... 난 우리가 이 제안을 거절해야 한다고 확신해요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0021_Text
#. Speaker : Capital_Collector
msgctxt "479eda8f-bd2b-429a-b07d-12777665bf2e"
msgid ""
"\"A most interesting proposition, Your {mf|Grace|Grace|Highness|Highness}. A "
"wizard from Nex has offered to create a number of golems for us, using only "
"the rubbish that litters the capital's streets.\""
msgstr ""
"\"매우 흥미로운 제안입니다, {mf|영주님|영주님|전하|전하}. 넥스에서 온 마법사가 수도 길거리에 있는 쓰레기만으로 골렘을 만들어 "
"제공하겠다 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0022_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "b4fe1d97-070f-40ea-83a6-9cf06926a6dc"
msgid ""
"\"We've received a curious offer. Some upstart from Nex has mastered the art "
"of creating golems. Even more, he assembles their bodies out of whatever "
"junk he can find. – A simple rubbish heap is typically enough. He is willing "
"to grant us a few specimens in exchange for permission to open a shop and "
"sell his golems in the capital. There's no reason to refuse. We could use a "
"few workers who don't ask any questions.\""
msgstr ""
"\"흥미로운 제안을 받았다. 넥스에서 온 어떤 건방진 녀석이 본인을 골렘 제조 기술에 통달했다고 소개했다. 심지어, 자신은 길에 "
"굴러다니는 쓰레기들로도 그것을 조립할 수 있다고 했지. 단순한 쓰레기 더미로도 충분하다고 말하더군. 수도에 그의 골렘을 팔만한 상점을 "
"차리도록 허가를 내어주면, 그 대가로 기꺼이 견본 몇 개를 바칠거다. 거절할 이유가 전혀 없지. 우리는 그 어떤 질문도 하지 않는 "
"일꾼들을 부리게 될 테니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0023_Text
#. Speaker : Capital_Collector
msgctxt "7dbb13b9-aaee-4d0e-9a6f-5c949734c41e"
msgid ""
"\"I believe we should take him up on his offer. Golems are perfectly well "
"suited for guard duty, as well as hard physical labor. Usually, creating "
"them can be rather costly. However, the mage will take care of all the "
"expenses – in exchange for your permission to set up shop in the capital.\""
msgstr ""
"\"저는 이 제안을 받아들여야 한다고 생각합니다. 골렘들은 고된 육체 노동뿐만 아니라 경비 임무에도 완벽히 적합합니다. 보통 이런 골렘을 "
"만드는 일은 다소 많은 비용이 소요되지만, 그 마법사가 모든 비용을 감당할 것입니다. 수도에 그에게 입점 허가를 내어주는 대가로 말이죠."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0028_Text_String
#. Speaker : Octavia_Companion
msgctxt "ff08c640-763d-45d6-a57f-5d609461015d"
msgid ""
"{n}Octavia's eyes narrow.{/n} \"So what, as long as they're different from "
"us, enslaving sentient beings is fine?\""
msgstr ""
"{n}옥타비아의 눈이 가늘어진다.{/n} \"그래서 뭐야, 그들이 우리랑 다르니까, 지각이 있는 존재를 노예로 만드는 것이 괜찮다는 거야?"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0029_Text
#. Speaker : Capital_Collector
msgctxt "de4dc303-5bf2-4f14-af3e-68b4cebd1e2d"
msgid "\"I shall instruct the mage to begin.\""
msgstr "\"그 마법사를 처음부터 가르쳐야겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0030_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "b89be95d-b2f2-414b-9f7e-f1dceefa89d1"
msgid "{n}\"Maegar\" nods impatiently.{/n} \"Wonderful.\""
msgstr "{n}\"메이가르\"는 곧바로 고개를 끄덕입니다.{/n} \"훌륭하군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0031_Text
#. Speaker : Octavia_Companion
msgctxt "86d9cb9f-2ae2-44c6-aa85-c1cb44820872"
msgid "\"Perfect. It will be my pleasure to get rid of this crook.\""
msgstr "\"완벽해요. 이 악당을 제거하는 건 아주 기쁠 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0035_Text_String
#. Speaker : Capital_Collector
msgctxt "399cba91-71d4-4ca4-b760-75b170528f5f"
msgid "{n}The Storyteller nods coldly.{/n} \"As you wish.\""
msgstr "{n}이야기꾼은 차갑게 고개를 끄덕였다.{/n} \"당신이 바라시는 대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0036_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "70462223-e45b-4407-a766-c0de914fff50"
msgid "\"In that case the mage shall begin immediately.\""
msgstr "\"그러면 마법사는 즉시 시작할 거다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0037_Text_String
#. Speaker : Octavia_Companion
msgctxt "6ddb110d-a682-4571-beed-952634624df4"
msgid ""
"{n}Octavia shakes her head.{/n} \"What do I have to do to make you see just "
"how terrible necromancy really is?\""
msgstr "{n}옥타비아는 고개를 흔들었다.{/n} \"사령술이 정말로 얼마나 끔찍한지 네가 알게 하려면 내가 뭘 해야할까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0040_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "07e458ae-8d65-4736-b9f8-ed448710aeea"
msgid ""
"\"Moreover, the bumbling fool somehow stumbled upon a way to eradicate the "
"main flaw of many types of golems – the chance that the construct might go "
"berserk. Golems are animated by enslaving an elemental spirit and binding it "
"to an artificial body. Sometimes these spirits can go out of control. "
"However, this Nexian shyster has found a way to strengthen the magical "
"restraints that hold them captive.\""
msgstr ""
"\"게다가, 그 덜떨어진 멍청이가 무슨 수를 썼는지 많은 종류의 골렘이 가진 주요한 결함을 근절할 방법을 우연히 찾아냈다. 그 "
"돌덩어리들을 미쳐 날뛰게 만들 수 있는 결함 말이지. 골렘은 원소 정령을 종으로 삼아 인공 신체에 결속시켜 움직인다. 가끔은 이 정령들이 "
"완전히 통제불능이 될 수도 있고. 그렇지만, 이 넥스 사기꾼은 그것들을 사로잡아두도록 마법적인 안전 장치를 강화하는 방법을 찾아냈다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0041_Text
#. Speaker : Octavia_Companion
msgctxt "1ba34dfd-cd02-4b51-ab49-70526f57528a"
msgid ""
"\"Do you know how golems are created? A mage must ensnare a living spirit "
"from one of the elemental planes – most typically, an earth elemental – and "
"bind it to the construct. This means that golems are no better than slaves – "
"after all, elemental spirits are living, sentient beings. The mage even "
"brags that his golems 'never go out of control' – as if total domination of "
"a spirit makes the whole thing any less cruel!\""
msgstr ""
"\"어떻게 골렘을 만드는지 아시나요? 마법사는 원소계에서 살아있는 정령 하나를 포획해야 해요. 대개는 대지 정령이지요. 그리고 물체에 "
"결속시킵니다. 그러니까 골렘들이 노예보다 나은 처지는 아니란 소리죠. 어쨌든 원소 정령들은 지각이 있는 존재에요. 그 마법사는 심지어 "
"자기 골렘이 '절대 통제를 벗어나지 않는다'고 떠벌리고 다니지요. 정령에 대한 완전한 지배가 이 모든 걸 어쨌든 덜 잔혹하게 만든다는 "
"것처럼요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0044_Text_String
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "9290e726-90f4-4548-b83d-d9585a9aefac"
msgid ""
"\"An absolutely incomprehensible decision. Then again, that's nothing new..."
"\""
msgstr "\"정말 완벽하게 이해할 수 없는 결정이다. 하긴, 새로울 것도 없군...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank6/Cue_0047_Text
#. Speaker : Capital_Collector
msgctxt "2d044726-5d7d-43fb-a90f-76a4f2025e3f"
msgid ""
"\"After assembling the body out of various junk, he binds to it an elemental "
"spirit, which lends the construct a semblance of life. In some golems, this "
"enslaved spirit may go out of control and become berserk. However, the mage "
"assured me that he has been able to completely eradicate this flaw. All he "
"needs now is your permission – and access to our rubbish heaps.\""
msgstr ""
"\"온갖 잡동사니로 몸체를 조립하고 나서 그자는 그걸 원소 정령과 결속시켰습니다. 그 물체에 생명의 껍데기를 부여한 겁니다. 어떤 "
"골렘들에게서는 이 종속된 영혼들이 통제불능에 미쳐 날뛸 수도 있습니다. 그렇지만, 그 마법사는 제게 이런 결함을 완벽하게 제거했다고 "
"장담했습니다. 그에게 필요한 건 당신의 허가 뿐입니다. 우리의 쓰레기 더미에 대한 접근권도요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Answer_0008_Text
msgctxt "d65384fc-8ce3-4df5-a9db-fd0ad353344d"
msgid ""
"{g|Arcane7_1}[Choice effects]{/g} \"I won't be their new 'chief'. The "
"shamans have ten days to leave my realm.\""
msgstr ""
"{g|Arcane7_1}[선택 시 효과]{/g} \"그자들의 '추장'이 되고 싶진 않군. 그 주술사들은 열흘 내에 내 왕국에서 떠나라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Answer_0009_Text
msgctxt "a0c46aa9-83ec-4fc3-9ab7-a85b14d45dcb"
msgid ""
"{g|Arcane7_2}[Choice effects]{/g} \"They may remain in my lands — for as "
"long as they serve me faithfully and loyally.\""
msgstr ""
"{g|Arcane7_2}[선택 시 효과]{/g} \"그들은 나를 충실하고 충성스럽게 나를 섬기는 동안 내 영지에 머무를 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Answer_0010_AlignmentShift.Description
msgctxt "18290bb0-3695-411c-8481-8957751186ef"
msgid "Ordered that the wayward shamans executed."
msgstr "다루기 힘든 샤먼들을 처형하라 명령하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Answer_0010_Text
msgctxt "faff5629-a0d6-4714-adf0-271201c53176"
msgid ""
"{g|Arcane7_3}[Choice effects]{/g} \"Once a traitor, always a traitor. Arrest "
"and execute every one of them.\""
msgstr ""
"{g|Arcane7_3}[선택 시 효과]{/g} \"한 번 배신한 자는, 영원한 배신자다. 그들 하나하나 전부 잡아들여 처형하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Answer_0030_Text
msgctxt "0c6071dd-98a9-4bce-ad71-83bae53fc82a"
msgid "\"Do as you see fit.\""
msgstr "\"당신이 적절하다고 생각하는 대로 하시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "48300fa7-a046-4694-99b3-3061497a81f6"
msgid ""
"\"{name}, I've just spoken with a Kellid shaman, who came in voluntarily and "
"surrendered himself to the guards. He and his brethren have fled their "
"tribes. — They know that they'll never win, and that you're 'the best "
"chief', as he puts it. Now they wish to serve you, and are even willing to "
"share their knowledge with us.\""
msgstr ""
"\"{name}, 방금 자발적으로 경비대에 항복한 켈리드 주술사와 이야기를 해봤어요. 그자와 그의 부족원들은 부족에서 도망쳐왔어요. "
"자기들이 절대 이길 수 없다는 걸 알 뿐만 아니라, 그 사람 말로는 네가 '최고의 추장'이라고 하더군요. 이제 그들은 당신을 섬기길 "
"원하고, 나아가 자기들의 지식을 우리와 기꺼이 공유하겠다고 해요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "d44c3a13-034f-4062-ab59-6644ba7e5c86"
msgid ""
"\"Your Highness, today the guards brought before me a barbarian shaman. He "
"had surrendered himself to them of his own free will. He and his… colleagues…"
" have fled their people, leaving their tribe behind. The way he puts it, "
"they've seen who's 'the best chief around here', and now they wish to serve "
"you.\""
msgstr ""
"\"전하, 오늘 경비대가 야만인 주술사 하나를 제게 데려왔습니다. 그자는 본인의 자유로운 의지로 항복했습니다. 그와 그의... "
"동료들...은 부족을 남겨두고 도망쳤습니다. 그자의 말로는 자기들이 '근방 최고의 추장'을 보았고, 이제 당신을 섬기고 싶어한다고 합니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0003_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "6171e3f4-32e6-4a18-9e6e-4f955be6cf10"
msgid ""
"{n}\"Maegar\" sounds tired and impatient.{/n} \"Just now the guard have "
"brought before me a barbarian shaman who willingly surrendered himself. The "
"savage is so dim and mush-mouthed that I could barely understood what he "
"said.\""
msgstr ""
"{n}\"메이가르\"는 답답하고 지겨운듯한 모습입니다.{/n} \"좀전에 경비병이 제 앞에 투항한 야만인 주술사를 데리고 왔습니다. 그 "
"야만인이 하는 말이 심하게 어눌해서 겨우 알아들을 수 있었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0004_Text
#. Speaker : Octavia_Companion
msgctxt "4d8850e0-021d-4902-b67c-a705acb5171e"
msgid ""
"\"But I don't think we should take them up on their offer. It's not that "
"their word can't be trusted… but our security is more valuable than any "
"assistance they could offer. Plus, the people are scared to death of them. — "
"They can summon ferocious beasts, and not long ago, they were doing terrible "
"things in the service of our enemy. I believe it would be best to simply "
"command them to leave and never return.\""
msgstr ""
"\"저들의 제안을 채택해야 한다고 생각하진 않습니다. 저들의 말을 믿을 수 없다는 말은 아니지만... 저들이 제공해줄 수 있는 그 어떤 "
"도움보다도 현재는 보안이 중요한 것으로 사료됩니다. 추가로, 사람들이 저들을 두려워하고 있습니다.— 저들은 사나운 짐승들을 소환하지요. "
"게다가 얼마 전 까지만 해도 우리 적들을 위해 행동하지 않았습니까. 그냥 저들에게 떠나서 돌아오지 말라고 하심이 좋을 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "b0597a1f-0906-4d61-b044-d5941829f0c5"
msgid ""
"\"This turn of events is most fortunate. Don't let their background "
"discourage you – their magical traditions are centuries old, and we've much "
"to learn from them. Of course, our people fear them at the moment, but I "
"believe in time that we can disperse these fears.\""
msgstr ""
"\"사건의 전환이 참으로 다행스럽습니다. 저들이 가진 뒷배경에 주눅들지 마십시오. 저들의 마법적 전통은 몇 세기는 되었고, 아직 "
"저들로부터 배울 것이 많습니다. 물론, 현재는 우리 백성들이 저들을 두려워할지 모르지만 차차 공포심은 누그러질 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0006_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "86c331b3-8d1e-4631-a144-8d9622a77aa9"
msgid ""
"\"I've no use for them. — There's enough useless idiots around here as it "
"stands. I suggest we simply rid ourselves of this burden.\""
msgstr "\"필요 없다. - 지금만 해도 쓸모없는 바보들이 넘쳐나는데, 그냥 이 짐덩어리를 없어버리자고 하고 싶군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0011_Text
#. Speaker : Octavia_Companion
msgctxt "ac927b76-8c12-4a6f-836d-c7d268eb8f8f"
msgid "\"Wonderful, {name}! I'll tell them as much!\""
msgstr "\"멋집니다, {name}! 그대로 저들에게 말해주겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0012_Text_String
#. Speaker : Capital_Collector
msgctxt "8bdae760-2cdc-4bad-96e9-be062891115d"
msgid ""
"\"Most disheartening. A new ally stretches out his hand to share his "
"knowledge in friendship, and we push him away. Why?\""
msgstr "\"참으로 안타깝군요. 새로운 아군이 지식을 나눠주고자 손을 뻗어오는데, 그 손을 뿌리쳐버리다니. 왜 입니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0013_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "3c26284e-a032-44e5-9403-fc8011a68815"
msgid ""
"\"Better we were slaughtering them to the one. Oh well, at least it's less "
"fuss this way.\""
msgstr "\"그냥 모조리 죽여버렸으면 좋았을텐데. 뭐, 그러면 이런 난리를 피울 필요도 없을테고 말이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0014_Text_String
#. Speaker : Octavia_Companion
msgctxt "f238416b-8c0f-4709-abe1-d8e1f522b3c3"
msgid ""
"\"This is not the best decision. Your subjects will surely not approve of "
"this — and I can't blame them!\" {n}Octavia falls silent, contemplating "
"something.{/n}"
msgstr ""
"\"좋은 해결책은 아니네요. 주민들도 받아들이기 어려울 거예요. 당연한 반응이죠!\" {n}옥타비아는 상념에 빠져 조용해집니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0015_Text
#. Speaker : Capital_Collector
msgctxt "b12c43e6-ced6-4333-9609-5eb349140ca4"
msgid "\"I see, Your Highness. I shall inform them of their new duties.\""
msgstr "\"받들겠습니다, 전하. 저들에게 새 임무를 알리도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0016_Text_String
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "dc5a236b-9c88-4fdb-8b99-92a87fe376e9"
msgid "\"Damnation! You wish to burden me with these primitive louts?!\""
msgstr "\"망할! 이 원시인들을 내가 맡아야 한다는 말이오?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0019_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "b2c13096-7690-4c1d-8900-a58f55573701"
msgid "\"Perfect. I don't wish to spend another moment on them.\""
msgstr "\"좋아. 저 것에 시간을 허비하고 싶지는 않았어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0021_Text_String
#. Speaker : Octavia_Companion
msgctxt "c2a05f00-acf8-419b-a057-5632b5297297"
msgid ""
"{n}Octavia gasps, and her face loses all color.{/n} \"By the gods! Why such "
"cruelty?!\""
msgstr "{n}옥타비아는 숨을 헉 들이쉰다. 그녀의 얼굴이 창백해진다. {/n} \"신이시여! 왜 그렇게 잔인해?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0022_Text_String
#. Speaker : Capital_Collector
msgctxt "b3b6a37d-9670-46e4-a51b-d3c8ece14bb6"
msgid "{n}The Storyteller's face darkens.{/n} \"A severe punishment.\""
msgstr "{n}이야기꾼의 표정이 어두워진다.{/n} \"끔찍한 처벌이군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0029_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "5c31f773-2173-41b2-9355-2a0b356402d3"
msgid ""
"\"It seems he and the other shamans have fled their unwashed cousins to come "
"serve us. Who would have thought! And their leader even generously promised "
"to share the 'ancient secrets' of their primitive magics! Pfft!\""
msgstr ""
"\"저 주술사와 다른 주술사들이 더러운 자신들의 사촌을 이곳으로 도피시켜서 우리를 섬기라고 한 모양이군요. 일이 이렇게 될 줄 누가 "
"알았겠습니까! 그리고 저들의 수장이 관대하게도 우리에게 자신들의 원시적인 마법에 대한 '고대의 비밀'을 가르쳐주겠다고 하는군요! 풋!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank7/Cue_0031_Text
#. Speaker : Octavia_Companion
msgctxt "428b596d-976e-48fd-a4e8-965370b2961a"
msgid ""
"\"Then I'll send them away. We'll do without their troublesome services.\""
msgstr "\"그렇다면 내가 그들을 내보내겠네. 그들의 번거로운 용역 없이 진행하자고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "515581f5-9200-40fe-9c63-1db3169c0474"
msgid ""
"\"There's trouble, {name}! A powerful magical anomaly has afflicted one of "
"our regions! According to the local mages, spells either simply don't work, "
"or lead to completely unexpected results. While trying to repair his "
"carriage, an experienced mage unwittingly levitated a bystander. Elsewhere, "
"a famous illusionist was setting off fireworks, but instead turned the "
"ground under his audience's feet into deep and slippery mud.\""
msgstr ""
"\"문제가 생겼어요, {name}! 강력한 마법적 이상 현상이 특정 지역에서 몰아치고 있어요! 지역 마법사들에 따르먼, 주문들이 아예 "
"작동하지 않거나, 완전히 예상치 못한 결과를 발생시킨다 하더군요. 노련한 마법사가 자신의 마차를 수리하려다 자신도 모르게 행인을 "
"띄웠어요. 다른 곳에서는, 유명한 환영술사가 불꽃 놀이를 준비하려다, 그 대신 청중들의 발 밑의 땅을 깊고 미끄러운 진흙으로 바꾸어 "
"놓았죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "7c27d279-9ca3-4c9e-a99f-40bca4f1bdc3"
msgid ""
"\"Troubling news, Your Highness. Magic has turned wild in one of the "
"regions. Spells are not working as intended. The incidents are numerous and "
"varied. While trying to repair his carriage, an experienced mage unwittingly "
"levitated a bystander. Elsewhere, a famous illusionist was setting off "
"fireworks, but instead turned the ground under his audience's feet into deep "
"and slippery mud.\""
msgstr ""
"\"괴로운 소식입니다, 전하. 어떤 지역에서 마법이 통제를 벗어났습니다. 주문들이 의도한 대로 동작하지 않고 있습니다. 그런 사건들이 "
"수두룩하고 다양하게 벌어지고 있습니다. 어떤 곳에서는 노련한 마법사가 자신의 마차를 수리하려다 자신도 모르게 구경꾼을 띄웠습니다. 다른 "
"곳에서는 유명한 환상가가 불꽃놀이를 하면서 청중들의 발 밑의 땅을 깊고 미끄러운 진흙으로 바꾸어 놓았습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0003_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "327c5721-8a25-4f9c-a942-fbb4ffe01adf"
msgid ""
"\"Your subjects are cowering at shadows again. Somewhere off in the "
"provinces, spells have stopped working as intended. One 'mage' tried to "
"repair his wagon, and instead levitated one of the onlookers. Another wanted "
"to captivate and amaze the idiots gathered around him by means of simple "
"fireworks — and ended up turning the ground under their feet into deep, "
"loose mood. There's no end to the complaints: magical fires, acid storms, "
"ferocious attacks of animated furniture...\""
msgstr ""
"\"또다시 너의 백성들이 몸을 웅크리고 그림자에 숨었다. 어떤 지방에서, 주문들이 제대로 작동하지 않는다는군. '마법사' 한 명이 자신의 "
"수레를 수리하려고 주문을 외웠는데, 대신 구경꾼 중 한 명을 공중에 띄우고 말았다. 다른 마법사는 자기 주변에 모인 바보들의 주의를 "
"끌려고 간단한 불꽃놀이를 하려다가, 그만 구경꾼들의 발 밑을 묽은 진흙탕으로 바꿔버렸지. 불평불만이 끊이질 않는다: 마법 화재, 산성 "
"폭풍우, 움직이는 가구들의 흉폭한 공격...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0004_Text
#. Speaker : Octavia_Companion
msgctxt "e025c736-7aa8-4caf-87d7-548a3b536428"
msgid ""
"\"New reports pour in by the day — magical fires sweep the settlements, "
"storms of acid form from nothing. Furniture comes to life and attacks its "
"owners! The worst part is that we have no clue as to the nature or cause of "
"this. There are simply no scholars with sufficient knowledge remaining in "
"the kingdom. — We put too many restrictions on the inhabitants of the mages' "
"quarter... All that remains is to deal with the consequences.\""
msgstr ""
"\"새로운 보고가 매일같이 들어와요 — 마법의 불꽃이 거주지를 휩쓸고 있고, 원인 모를 산성 방울의 폭풍이 몰아치죠. 가구들이 살아나더니 "
"주인을 공격해대고요! 최악인 사실은 이 일의 원인을 알 수가 없다는 점이죠. 왕국 내에 이에 대해 충분히 알고 있는 학자들이 아무도 "
"없어요 — 우리는 마법사 거주구의 주민들에게 너무 많은 제약을 걸었으니까요... 이제 남은 일은 이 결과를 해결하는 일뿐이에요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "8d53a93b-4a1a-4599-aa54-7fcde57183b6"
msgid ""
"\"The High {mf_HighPriest|Priest|Priestess} may be able to help those who "
"are suffering. — For now, divine magic remains unaffected by the anomaly. "
"Still, who can say how long it will stay that way? If you want my advice, "
"support our governors with gold from the treasury. That way they'll be able "
"to solve any crises in a timely manner, as the situation dictates.\""
msgstr ""
"\"{mf_HighPriest|대사제|여사제}가 고통받고 있는 사람들을 도울 수 있을 것입니다. — 현재로선, 신성 마법은 변칙성에 "
"영향을 받지 않습니다. 하지만, 그 법칙이 언제 바뀔지 누가 알겠습니까? 제 조언을 물으신다면, 우리 영주들에게 국고를 보내 "
"지원하십시오. 그러면, 그들이 어떤 위기라도 적절한 때에 적합한 방법으로 해결할 수 있을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0006_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "8619760e-db95-4423-9f32-081a6b5cd593"
msgid ""
"\"Of course, no one had any idea what was happening until I intervened and "
"determined that we're dealing with a magic anomaly. Perhaps I would even be "
"willing to study it a bit more closely… However, since you've put all these "
"restrictions on mages, there's no one left in the "
"{mf|barony|barony|kingdom|kingdom} with enough intelligence to assist me. "
"And naturally, I have no wish to pursue such research alone.\""
msgstr ""
"\"당연하게도, 내가 개입해서 어떤 변칙성을 처리해야 할지 확인하기 전까지는 아무도 무슨 일이 일어나는지 알지 못했다. 아마도 내게 그 "
"현상을 더 자세히 조사할 의향이 있을 수도 있지. 하지만, 당신이 마법사들에게그 모든 제한들을 가했기 때문에, 나를 도울 만큼 충분한 "
"지식을 가진 자가 {mf|남작령|여남작령|왕국|왕국}에 아무도 남아있지 않았다. 그리고 내 성향상, 나 홀로 그런 연구를 하고 싶은 "
"생각은 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0020_Text
#. Speaker : Octavia_Companion
msgctxt "42fbf8cd-8e39-4661-83b5-cb3bf7d3b85c"
msgid ""
"{n}Octavia is as pale as ash.{/n} \"{name}… There was a poisonous gas leak "
"tonight, during another experiment in the magic quarter. It's... it's "
"horrendous. People died in their homes, unable to crawl to their door… Many "
"simply tucked in for the night, never to awaken... It wasn't until early "
"morning that someone heard some weak moans coming from one of the streets "
"that run alongside the quarter...\""
msgstr ""
"{n}옥타비아의 얼굴이 새하얗게 질렸습니다.{/n} \"{name}… 오늘 밤 마법 지구의 실험에서 독성 가스 유출이 있었어. 이건... "
"이건 정말이지 충격이야. 사람들은 집 안에서 문 밖으로 기어나오다가 죽어갔어... 잠을 자던 사람들은 다시 깨어나지 못했지... 아침이 "
"되어서야 겨우 누군가가 마법 지구 옆의 거리에서 새어나오는 미약한 신음소리를 들었다고 해...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0021_Text
#. Speaker : Capital_Collector
msgctxt "e32d66cf-8c2f-4a9e-afbc-385f9f035bc6"
msgid ""
"{n}The Storyteller looks concerned.{/n} \"Tragedy has struck the magic "
"quarter, Your Highness. Another one of their experiments ended in a "
"poisonous gas leak. However, because the experiment was held in the dead of "
"night, the alarm came too late. People died silently in their own homes. — "
"Too weak to get away, too weak to call for help...\""
msgstr ""
"{n}이야기꾼은 얼굴에 수심이 가득해보인다.{/n} \"비극이 마법 지구를 덮쳤습니다, 전하. 마법사들의 실험 중 하나가 독성 가스 누출 "
"사고로 이어졌습니다. 실험이 한 밤중에 이루어졌는지라 경보가 너무 늦게 울리고 말았습니다. 사람들이 집 안에서 조용히 죽어갔다고 합니다. "
"— 도망가거나 도움을 청하기엔 너무 늦은 채로...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0022_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "020d8c26-fb25-402e-af16-e5613a778db1"
msgid ""
"\"Ha! The lower races are so entirely ill-suited for magic! Last night's "
"experiments in the mages' quarter ended in a poisonous gas leak that went "
"unnoticed for hours. As one would expect, it was morning by the time our dim-"
"witted townsfolk realized what was happening. — Once they started stumbling "
"over their neighbors' corpses.\""
msgstr ""
"\"하! 저등한 종족은 정말이지 마법에 어울리지 않군! 어젯밤 마법 지구에서 벌어진 실험이 몇 시간 동안 아무도 알아채지 못한 독성 가스 "
"누출 사고로 이어졌다. 예상할 수 있는 대로, 얼빠진 마을 주민놈들은 아침이 되어서야 깨닫더군. — 이웃들의 시체에 걸려 넘어질 뻔하다가 "
"말이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0027_Text
#. Speaker : Capital_Collector
msgctxt "12b3da69-8b31-4915-8412-e4faac37a01e"
msgid ""
"\"New reports pour in every day — magical fires, acid storms, attacks of "
"animated furniture… The reason behind this magic anomaly is beyond our "
"understanding, for not a single one of our subjects is knowledgeable enough "
"about magic. Our greatest scholars left the kingdom a long time ago, citing "
"'infringement on their freedom to research'. Now we can only battle the "
"consequences.\""
msgstr ""
"\"새로운 보고가 매일같이 들어옵니다. — 마법 화재, 산성 폭풍우, 움직이는 가구들의 습격... 우리가 이 마법적 이상 현상에 대해 "
"이해할 수 없는 이유는, 백성들 중 아무도 마법에 대해 잘 아는 이가 없기 때문입니다. 국내 최고의 학자들은 오래 전에 '연구할 자유를 "
"침해했다'고 주절거리며 왕국을 떠났습니다. 이제 남은 것은 이 결과와 씨름하는 것뿐입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0038_Text
#. Speaker : Octavia_Companion
msgctxt "3a4be593-6490-4100-8fb9-3ad1f2cda4f6"
msgid ""
"\"The Treasurer could simply send some money to the poor souls, and hope "
"they can deal with their problems themselves. However, the more reliable "
"course would be to enlist the aid of the High Priest. Divine magic is "
"powerful, and unlike arcane magic, it remains untouched by the anomaly. — It "
"still works as it's supposed to.\""
msgstr ""
"\"재무관은 돈만 조금 보태고 불쌍한 사람들더러 본인 앞가림은 본인이 하라고 말하겠죠. 더 확실한 방법은 대사제의 도움을 요청하는 "
"거예요. 신성 마법은 강력하고, 비전 마법과는 다르게 아무런 이상 현상을 남기지 않아요. — 의도한 대로 작동하기도 하고요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0039_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "9c03f7c8-9694-4941-8b26-c33335dd432d"
msgid ""
"\"As always, the knaves expect that you… Your Highness… shall come to their "
"rescue. Perhaps the Treasurer can buy their silence for a few coins. Or you "
"could order the High {mf_HighPriest|Priest|Priestess} to intervene. In any "
"case, it is pointless for me to help you reach a decision. The suffering of "
"the rabble are no concern of mine. Therefore, I shall leave it up to you to "
"deal with this most fascinating dilemma.\""
msgstr ""
"\"언제나 그렇듯, 바보들은 네가… 전하가… 나서서 자기들을 구해주길 바란다. 재무관이 돈 몇 푼을 쥐어주면 그들의 입을 막을 수 있다. "
"아니면 {mf_HighPriest|대사제|여사제}가 개입하도록 명령할 수도 있고. 어떤 방식이던, 너의 결정을 돕는 것은 나에게 아무 "
"의미가 없다. 폭도들이 어떤 고통을 박던 내 알 바 아니니. 그러므로, 이 최고의 딜레마를 처리하는 것은 너에게 맡기겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0047_Text
#. Speaker : Octavia_Companion
msgctxt "5d942d0b-1b0e-4ad1-9193-c32ad8979d0a"
msgid ""
"\"The poisonous cloud is no more — the wind dissipated it. But everywhere "
"there are people wounded and disfigured by the gas. There's no two ways "
"about it — we must help them! I suggest sending our best healers and priests "
"in immediately. What use is a monetary compensation if you've become a "
"cripple!\""
msgstr ""
"\"독구름은 사라졌어요. 바람이 그것을 소멸시켰죠. 하지만 가스 때문에 상처받고 망가진 사람들이 어디에나 있어요. 다른 방법은 없어요. "
"그들을 도와야 해요! 즉시 최고의 치료사들과 사제들을 파견하길 추천해요. 불구자가 되었다면 금전적 보상이 무슨 소용이 있겠어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0048_Text
#. Speaker : Capital_Collector
msgctxt "868d7380-875c-4dbf-b200-6fd7e5eb8343"
msgid ""
"\"The poisonous cloud has dispersed, but its victims are many. We could ask "
"the High {mf_HighPriest|Priest|Priestess} to send healers into the quarter, "
"in hopes of saving some of those who are dying — but they have little hope "
"of success. However, it would be best if the treasurer provides those "
"afflicted with a monetary compensation. Some will be wish to hire healers "
"for their loved ones, and others — gravediggers.\""
msgstr ""
"\"유독성 기체는, 사라졌지만 희생자가 너무 많습니다. 고위 {mf_HighPriest|사제|여사제}에게 해당 지역으로 치유사 파견을 "
"요청하고 죽어가는 이들 중 일부라도 구하기를 바랄 수도 있습니다만, 성공할 가능성은 희박해 보입니다. 재무관이 피해자들에게 금전적 보상을 "
"제공하는 것이 최선입니다. 본인들이 직접 치료사들을 고용할 수도 있고, 아니면 장의사라도 사겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank8/Cue_0049_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "d80c8f38-7dbe-47ef-b8e1-353864ce692b"
msgid ""
"\"The High {mf_HighPriest|Priest|Priestess} could deal with the wounded. The "
"Treasurer could open the {mf|barony|barony|kingdom|kingdom}'s coffers and "
"give out gifts to all who suffered. I see no point in either, so do whatever "
"you see fit. Frankly, I simply cannot care…\""
msgstr ""
"\"{mf_HighPriest|대사제|여사제}는 상처를 치유할 수 있다. 재무관은 {mf|남작령|남작령|왕국|왕국}의 금고를 열어 "
"피해자들을 지원할 수 있지. 나는 양쪽 모두 별로 마음에 들지 않으니, 네가 원하는 대로 해라. 솔직히, 나는 관심조차 가질 않는군..."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Answer_0008_Text
msgctxt "ea0d6edf-562c-498f-a8bb-0a0cd877e02b"
msgid "{g|Arcane9_1}[Choice effects]{/g} \"The limitations stand.\""
msgstr "{g|Arcane9_1}[선택 시 효과]{/g} \"한계가 있다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Answer_0009_Text
msgctxt "f03385a1-0ecf-4463-a2c1-83a0e3bb022b"
msgid ""
"{g|Arcane9_2}[Choice effects]{/g} \"Amend the law as needed. Henceforth, any "
"and all magical components may be traded in my domain.\""
msgstr ""
"{g|Arcane9_2}[선택 시 효과]{/g} \"필요에 따라 법을 개정하라. 그렇게 한다면, 어떤 마법의 요소도 내 영역에서 거래될 "
"수 있다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Answer_0027_Text
msgctxt "998a54a8-1739-4628-8c66-7a477795e429"
msgid ""
"{g|Arcane9_3}[Choice effects]{/g} \"We cannot allow baseless fears to "
"dictate our actions. We shall set not needless limits on the freedoms of "
"spellcasters.\""
msgstr ""
"{g|Arcane9_3}[선택 시 효과]{/g} \"우리는 근거 없는 두려움이 우리의 행동에 영향을 주는 것을 용납할 수 없다. 우리는 "
"마술사들의 자유에 불필요한 제한을 두지 않을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Answer_0028_Text
msgctxt "2f3784f1-a3c5-4db9-b889-9996d3054acf"
msgid ""
"{g|Arcane9_4}[Choice effects]{/g} \"The delegation's demands are well "
"founded. I order you to issue a decree, and set out to regulate the use of "
"magic in the settlements.\""
msgstr ""
"{g|Arcane9_4}[선택 시 효과]{/g} \"대표단의 요구는 근거가 충분하다. 나는 법령을 제정하고, 정착지에서의 마법의 사용을 "
"규제하기로 했다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Answer_0042_Text
msgctxt "4203eb67-7a80-4077-bf8c-530e8b511a98"
msgid "\"I'll trust you with this decision.\""
msgstr "\"당신의 결정을 믿습니다..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "db3341ee-6249-407c-a56c-eb2d2a1dd2cf"
msgid ""
"\"{name}, the artifact appraiser approached me — do you remember him? Our "
"friend has become quite an influential figure in the mages' quarter. Perhaps "
"even its unofficial leader, in a sense. And this… worries me somewhat.\""
msgstr ""
"\"{name}, 유물 감정사가 찾아왔어요. 그 사람 기억해요? 우리 친구가 마법 지구에서 꽤나 유명인사가 된 모양이에요. 어떻게 보면 "
"비공식적인 지도자 위치에 서 있는 거 같아요. 그런데... 좀 걱정이 돼요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "089ea1e9-58b5-4362-b408-964a34441adb"
msgid ""
"\"Our acquaintance, the artifact appraiser, has sought my audience once "
"more. The mages' quarter has grown — and with it, the influence of its "
"unofficial leader. However, the appraiser feels that this growth is still "
"far from its limits… This time he wanted to speak of trade – in particular, "
"alchemical ingredients and the material components of spells.\""
msgstr ""
"\"우리가 알던 유물 감정사가 다시 제게 알현을 청했습니다. 마법 지구가 성장했고, 그 비공식적인 지도자의 영향력도 커졌습니다. 하지만 "
"감정사는 이 성장으로도 부족한 모양입니다... 그가 이번에는 연금술 약재와 주문 시전을 위한 재료를 거래하려고 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0003_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "80c4207b-7eaf-4580-a241-b2ff81a8646d"
msgid ""
"\"The artifact appraiser from the mages' quarter has once more sought my "
"audience. It seems he's become something of a leader for the rabble who "
"dwell there. Somehow, this time he's thought up something useful — to permit "
"the trade of any and all rare ingredients and magical components.\""
msgstr ""
"\"마법 지구의 아티팩트 감정사가 다시 한 번 알현을 청했다. 그곳에 사는 백성들의 지도자쯤의 위치에 선 모양이다. 어떻게 생각했는진 "
"몰라도 이번에 그는 유용한 것을 생각해냈다. 희귀 재료 및 마법 약재에 대해 거래를 승인해달라는군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0004_Text
#. Speaker : Octavia_Companion
msgctxt "b30776bc-792a-4f4a-a88a-341b6ec4011a"
msgid ""
"\"Why, you ask? Well, he's urging us to lift all trade restrictions on "
"alchemical ingredients and other material components for spellcasting. – "
"Even such things as black onyx, devil blood… and human hearts. Do I have to "
"explain why I'm against the buying and selling of body parts? — Or any other "
"ingredients that empower the darkest and vilest of spells?\""
msgstr ""
"\"왜냐고 물어보셨어요? 그 감정사는 연금술 재료 및 다른 주문시전에 필요한 시약들에 대한 모든 거래 제한을 풀어달라고 하고 있어요. – "
"검은 오닉스, 데블의 피나... 사람 심장까지요. 사람 장기를 사고파는 것에 대해 제가 왜 반대하는지까지 얘기 해드려야 하나요? 아니면 "
"사악하고 어두운 주문에 힘을 불어넣는 재료들에 대한 거래를 왜 반대하는 지도요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "448b177b-f70e-4989-a120-a92a9f1a8c31"
msgid ""
"\"He complains of the difficulty in acquiring the materials necessary for "
"the more… exotic types of spells. In the capital, at least, such materials "
"as black onyx, devil blood, or even the hearts of the deceased – these are "
"only available on the black market. Most merchants are afraid to stock them, "
"assuming that they are banned by law, just as they are in the lands of our "
"neighbors. However, our laws are in fact silent on the issue.\""
msgstr ""
"\"그 사람은 그... 더 많은... 이국적인 주문에 필요한 재료를 얻는 게 얼마나 힘든지 불평하고 있습니다. 적어도, 수도에서는 검은 "
"오닉스나 데블의 피, 망자의 심장같은 재료들을 암시장에서 밖에 구할 수가 없다고요. 대다수의 상인들이 우리 주변 땅에서처럼 법으로 금지된 "
"줄 알고 그런 물건들을 가지고 있는 걸 두려워합니다. 그렇지만, 우리 법은 사실 그 문제에 대해 침묵하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0006_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "3a54823d-d0f6-4ac9-8983-c27dc0b18db5"
msgid ""
"\"Today, black onyx, devil's blood and human hearts can only be found on the "
"black market. Such a deplorable state of affairs should indeed be remedied "
"at once – there's no doubt of that. Such a decision would greatly hasten the "
"growth of the magical arts in these lands.\""
msgstr ""
"\"오늘날, 검은 오닉스, 데블의 피와 인간 심장은 암시장에서만 찾을 수 있다. 이런 개탄스러운 상황은 즉시 타개해야 한다. – 거기에 "
"대한 의심은 없다. 이 결정은 국가 내 마법 기술의 성장을 크게 가속화시킬 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0011_Text
#. Speaker : Octavia_Companion
msgctxt "a181cf1b-d219-40dc-9cd9-518a4f5c925b"
msgid ""
"{n}A tired smile crosses Octavia's lips.{/n} \"I never thought I'd be "
"pushing for any sort of restrictions or limitations… but my time at this "
"post has shown me that sometimes you can't do without them.\""
msgstr ""
"{n}옥타비아의 입술에 지친 미소가 스친다.{/n} \"어떤 종류의 제한이나 한계를 강요할 줄은 생각도 못했는데... 하지만 이 "
"직책에서의 내 경험들은 때때로 그런 것들이 필요하다고 하더군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0012_Text
#. Speaker : Capital_Collector
msgctxt "1f0352ce-b59d-4ce4-88f0-93e2a23162c9"
msgid "\"As Your Highness wishes.\""
msgstr "\"전하께서 원하시는 대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0013_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "e34f75a0-a3eb-4a4e-9014-aed1c82bd7d7"
msgid "{n}\"Maegar\" shrugs.{/n} \"Your domain — your loss.\""
msgstr "{n}\"메이가르\"가 으쓱인다.{/n} \"자네의 영토이므로 — 자네 손해로군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0014_Text
#. Speaker : Octavia_Companion
msgctxt "b3c2cc14-9256-427a-aea5-b094c68ec072"
msgid ""
"{n}Octavia looks away.{/n} \"I just don't know, {name}… It sounds dangerous. "
"Still, you're the {mf|King|Queen} — you know best.\""
msgstr ""
"{n}옥타비아가 눈길을 돌린다.{/n} \"모르겠어, {name}… 위험해 보이는데. 그래도, 아직 너는 {mf|왕|여왕} 이야. - "
"네가 가장 잘 알겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0015_Text
#. Speaker : Capital_Collector
msgctxt "e341b1fa-16f3-42e0-ae06-8372b4043236"
msgid "\"I shall look to it immediately, Your Highness.\""
msgstr "\"즉시 살펴보겠습나이다, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0016_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "89a7f94a-97aa-4913-ab39-2146ebfa4cd2"
msgid "\"A wise choice.\""
msgstr "\"현명한 선택입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0020_Text
#. Speaker : Octavia_Companion
msgctxt "b67cec6d-d576-4959-b00b-7b38857c184f"
msgid ""
"\"I do not envy you, {name}. It's a tough decision. We're at an impasse — "
"the simple folk can no longer 'suffer the threats' of our mages and "
"sorcerers. A wave of protests has rolled across the capital and the "
"surrounding regions. I've just spoken to a delegation that represents the "
"people. Their demands are quite clear.\""
msgstr ""
"\"당신이 부럽지 않군요, {name}. 어려운 결정입니다. 우리는 교착 상태에 있습니다. 사람들은 더 이상 우리의 마법사들의 '위협'을 "
"견딜 수 없습니다. 수도와 주변 지역에 시위의 물결이 번지고 있습니다. 저는 방금 그들의 대표자와 이야기 했습니다. 그들의 요구는 꽤 "
"분명합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0021_Text
#. Speaker : Capital_Collector
msgctxt "9e5c20a9-d6cb-40e1-98d7-b047143bbd11"
msgid ""
"{n}The Storyteller looks tired and sullen.{/n} \"Your Highness, the people "
"are unhappy. Your subjects feel certain that mages and sorcerers who "
"practice their craft in the settlements are a source of constant danger — "
"and they shall suffer it no more. I've just spoken with a whole delegation, "
"assembled from representatives from every corner of the land. They are "
"petitioning a change. I must admit, I do take their points.\""
msgstr ""
"{n}이야기꾼은 힘들고 시무룩해보인다.{/n} \"전하, 사람들의 기분이 좋지 않습니다. 전하의 종복들은 국토 내에서 기예를 수련하는 "
"메이지나 소서러들이 계속되는 위험의 원인이라고 생각합니다. - 백성들이 더 고통받아선 안 됩니다. 국토 내의 온 지방에서 올라온 대표들과 "
"막 이야기를 마쳤습니다. 이들은 개정을 요구하고 있습니다. 저도 이들의 주장을 이해한다고 말씀드려야겠군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0022_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "bfbb77f1-e8f7-493a-bfff-d0d172fbd5c5"
msgid ""
"\"What a farce! Frightened, wriggling worms, trying to manipulate forces "
"they cannot possibly comprehend! All across the kingdom, peasants are "
"demanding the restriction of magic use in the settlements. A wailing "
"delegation of fools from every region of the kingdom entertained me for an "
"eternity today, gnashing their teeth and beating their chests.\""
msgstr ""
"\"참으로 우습군! 겁에 질린 벌레들이 꿈틀거리며, 자신들이 이해할 수 없는 힘을 조종하려 하려는 꼴이라니! 온 왕국의 백성들이 거주지 "
"내에서 마법 사용을 제한해달라 요청한다. 왕국 곳곳에서 올라온 머저리들의 대표단이 오늘 하루 종일을 이를 갈고 가슴을 치는 소리로 날 "
"즐겁게 해줬지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0023_Text
#. Speaker : Octavia_Companion
msgctxt "082a57b2-f5b2-47fc-b713-15f403c31e8e"
msgid ""
"\"They want us to restrict the use of magic in places where people live. "
"This will mean that casting spells and brewing potions will require a "
"permit. Even then, it would only be allowed on the outskirts of settlements –"
" and during the day. Can you imagine the outrage that such measures would "
"spark in every member of the magic community? And is a false feeling of "
"safety worth limiting people's freedoms? I don't think so!\""
msgstr ""
"\"그들은 우리가 사람들이 사는 곳에서 마법을 사용하는 것을 제한하기를 원합니다. 이것은 주문을 외우거나 포션을 만드는 것을 허가 받아야 "
"한다는 것을 의미합니다. 허가를 받는다해도, 마법 사용은 정착지의 변두리에서, 그리고 낮에만 허용될 것입니다. 당신은 그러한 조치가 "
"일으킬 마법 커뮤니티의 모든 구성원들의 분노를 상상할 수 있나요? 그리고 사람들의 자유를 억압할정도로 안전에 대해 잘못된 것일까요? 전 "
"아닌 것 같아요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0024_Text
#. Speaker : Capital_Collector
msgctxt "15a90309-a459-4533-8ef0-424c709decd9"
msgid ""
"\"I've anticipated this development, and I believe that the petitioners are "
"in the right. Justice demands that the safety of the majority be placed "
"above the freedoms of the minority.\""
msgstr ""
"\"나는 이러한 발전을 예상했고, 청원자들이 옳다고 믿고 있다. 정의는 다수의 안전을 소수자의 자유보다 우선할 것을 요구한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0025_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "84d2262f-abd5-4209-8390-8f97c54cec3a"
msgid ""
"\"They wish to limit the practice of magic to those who possess permits! "
"Moreover, they also demand that all existing magic schools and laboratories "
"be transferred from the center of civilization to its outskirts! It's more "
"than clear that these oafs should be put in their place.\""
msgstr ""
"\"허가받은 마법사만이 마법 실험을 할 수 있도록 제재하겠다고 했지! 한 술 더 떠서, 도심에 위치한 마법 학교와 실험실을 모조리 "
"외곽으로 옮기라고 요구했네! 저런 머저리에겐 자기 분수를 알려줘야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0030_Text
#. Speaker : Octavia_Companion
msgctxt "cdf2dfaf-866a-40fb-a6a9-0a8998d97b6a"
msgid "\"Well said. So be it!\""
msgstr "\"옳다. 그렇게 하라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0031_Text
#. Speaker : Capital_Collector
msgctxt "37295bea-89c8-4880-b4f8-583d66d6010d"
msgid ""
"{n}The Storyteller nods in contemplation.{/n} \"I understand. I shall inform "
"the delegation of your decision.\""
msgstr "{n}이야기꾼은 사색에 잠긴 채 끄덕인다.{/n} \"알겠습니다. 대표단에게 전하의 결정을 알리지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0032_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "5a38649a-3c7e-491d-abcd-eb1fa630dc29"
msgid "\"The only correct decision.\""
msgstr "\"이게 유일하게 올바른 길일지니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0033_Text
#. Speaker : Octavia_Companion
msgctxt "6946f1c5-ec3a-4eed-b0b4-3c5325083cf8"
msgid ""
"\"I'll never understand why you're doing this. Nevertheless, I will carry "
"out your order.\""
msgstr "\"난 네가 왜 이 짓을 하는지 절대 이해 못할 거야. 그래도 명령한 대로 따르겠어 .\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0034_Text
#. Speaker : Capital_Collector
msgctxt "0daa71dd-7a3a-4a7d-84e4-9774679df66c"
msgid ""
"{n}The creased Storyteller's brow slowly unfurrows.{/n} \"We'll get to "
"working straight away, Your Highness.\""
msgstr "{n}이야기꾼의 주름진 미간이 천천히 풀어집니다.{/n} \"바로 착수하겠습니다, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0035_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "5b9dd0a9-dab4-4618-a301-ab8056f749b6"
msgid ""
"{n}Gritting his teeth and piercing you with his gaze, \"Maegar\" squeezes "
"out a cold smile.{/n} \"As you wish… Your Highness.\""
msgstr ""
"{n}그는 이를 꽉 악물었고 그의 눈빛은 당신을 꿰뚫을 것 같았습니다, \"메이가르\"는 짜내듯이 차갑게 미소를 짓습니다.{/n} "
"\"당신이 바라시는 대로....전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0040_Text
#. Speaker : Capital_Collector
msgctxt "f074d326-6006-4d23-9222-da7381b3f134"
msgid ""
"\"Thus, the appraiser has asked us to permit the trade of such materials. "
"You may find this unexpected, but I believe we should grant his request. "
"It's the only measure that would allow us any control over how these foul "
"substances are procured and used. And in the case of such ingredients as "
"human organs – well, oversight is crucially important.\""
msgstr ""
"\"게다가, 감정사가 부탁해오길 이런 재료들에 대한 거래를 허락해달라고 하고있습니다. 이런 말씀 드리라고는 생각 못 하셨겠지만, 이 "
"부탁을 들어주셔야 한다고 사료됩니다. 이 부정한 재료들을 어떻게 구하고 사용되는지에 대해 우리가 알 수 있는 유일한 방법입니다. 인간의 "
"장기를 거래하는 것에 대한 건 - 뭐, 엄격하게 감독해야겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0041_Text
#. Speaker : Capital_Collector
msgctxt "849edeb6-8577-48a9-93d0-7fc9649b5c5f"
msgid ""
"\"Their principle demand is the introduction of restrictions on the use of "
"magic in densely inhabited places. Firstly, spellcasting and potion brewing "
"within settlements should only be allowed for those who have received a "
"proper permit from the town hall or village elder. Secondly, all magic "
"schools and laboratories should be moved to the outskirts of settlements.\""
msgstr ""
"\"저들은 사람이 밀집된 곳에서의 마법 사용을 제한하자고 하고 있습니다. 우선, 거주지 내에서 주문 시전과 포션 제조는 마을 회관이나 "
"마을 장로의 허락을 맡게 하자고 합니다. 두 번째로, 모든 마법 학교와 실험실들을 거주지 외곽으로 이주시켜달라고 하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0043_Text
#. Speaker : Capital_Collector
msgctxt "1db08a23-e0ba-480b-a554-e75ab952d0c8"
msgid ""
"\"Then I'll lift the prohibition altogether. Trust me, you'll see the "
"benefits of this decision after a couple of years.\""
msgstr "\"그럼 금지법을 모두 철회하겠습니다. 믿어주십시오. 이 결정에 대한 이익을 몇 년 후에 보실 수 있을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/Cue_0045_Text
#. Speaker : MaegarVarnVordakai_Capital
msgctxt "94611366-9b11-4e3f-b4c6-189b9f5cdbe4"
msgid ""
"\"I see no use in such cowardly laws. I'll see to its removal for the sake "
"of all respectable spellcasters who desperately need their components — "
"whether the commoners like it or not.\""
msgstr ""
"\"이런 겁쟁이같은 법은 쓸모가 없도다. 재료를 필요로하는 우리의 주문시전자들을 위해, 평민들이 싫어하든 말든 법을 없애버리겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Arcane/Rank9/RecentRankUp_ReasonString_String
msgctxt "5c13c45f-0a53-4686-85d7-62ceb78e26a3"
msgid "Decisions while governing the country"
msgstr "국정 중의 결정들"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Merc/Cue_0001_Text
msgctxt "bd8955ff-1c92-4e2b-8232-de68e4eebab8"
msgid ""
"{n}Your advisor has arrived to report about the recent Culture developments "
"in your {mf|barony|barony|kingdom|kingdom}.{/n}"
msgstr "{n}당신의 보좌관이 최근의 {mf|남작령|남작령|왕국|왕국}의 문화 발전에 대해 논의하기 위해 방문했습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "d714cd00-052d-41f5-ba02-dfe1aba75898"
msgid ""
"\"Oh, {name}, if only I could put into words those heavenly sounds! An "
"orchestra is but soft clay in Larzio's hands. One moment the singing of "
"angels descends upon you from the stage — and the next you are overtaken by "
"the roar of Hell itself! Of course, there are always critics. — Where's the "
"deep message? What are the existential questions? — But can you ever please "
"them?! Anyway, I'm exalted! The audience is going out of their minds! Larzio "
"is triumphant! Anything anyone can talk about is what the world would have "
"lost were it not for your keen taste and unrivalled generosity! And the "
"scale of production! And the decorations! And... And...\" {n}Exhausted and "
"completely out of breath, Linzi pauses to collect herself.{/n}"
msgstr ""
"\"아, {name}, 그 아름다운 소리를 말로 표현할 방법이 있다면 좋을 텐데! 라지오의 손이 만들어내는 오케스트라의 선율은 부드러운 "
"점토같아. 한 순간 천사의 목소리가 무대로 내려오고, 다음엔 지옥으로부터의 울부짖음에 압도되어버리지! 물론, 언제나 비평은 있긴 하지. -"
" 심오한 메시지가 없느니, 실존적 질문이 무엇이니 하면서. - 좀 좋은 말은 해줄 수 없는 거야?! 어쨌든, 난 너무나도 기뻐! 청중들이 "
"넋을 빼고 있잖아! 라지오는 최고야! 네 그 섬세한 취향과 비할데 없는 관대함이 없었더라면 세상은 많은 것을 잃었을 거야! 그 거대했던 "
"규모! 그리고 그 장식! 그리고... 그리고...\" {n}넋이 나가고 지쳐버린 린지는 숨을 고르기 위해 멈췄다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "cd6b12fc-d20e-4f03-be0e-6779c79814ee"
msgid ""
"\"The premiere of maestro Messus' opera was a success. His name thunders "
"across all the kingdom. Tickets are already sold out for the next two "
"months, and the audience sings praises of the composer's talent – and his "
"patron's generosity. However, the critics noted the somewhat... shallow... "
"plot. And of the overabundance of battle scenes, and costumes and "
"decorations. And to be honest, I cannot argue with them.\""
msgstr ""
"\"최고의 마에스트로 메수스의 오페라는 성공적이었다. 그의 이름이 온 왕국 내에 울려퍼졌다. 표는 다음 두 달 뒤 공연까지 전부 "
"매진되었고, 청중들은 작곡자의 재능과, 후원자의 관대함에 대해 칭송하고 있다. 하지만, 비평가들은 왠지 몰라도... 부족한 플롯과 전투 "
"장면, 의상과 장식에 대해 비판했다. 솔직히 말하자면, 비평가들에게 동의할 수가 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "adc31db5-677d-450e-8844-69e70b4fe9ae"
msgid ""
"\"The premiere was a howling success! The tickets are selling faster than "
"they can be printed, and the audiences are raving. The ever-disappointed "
"critics complain of the \"shallow plot\" and \"flag-waving patriotism\", but "
"their words find no purchase in the vacant minds of the audience. Larzio "
"Messus held a speech to express his gratitude, and dedicated the opera to "
"you. You are praised in the streets and eulogized in toasts. I congratulate "
"you, {name} — you've etched your name in history as a most generous patron "
"of the arts... and an even shrewder politician.\""
msgstr ""
"\"공연은 엄청난 성공이었어! 표는 찍어내는 속도보다 팔려나가는 속도가 더 빨랐고, 청중들이 불평을 해대고 있어. 실망한 비평가들은 "
"\"부족한 플롯\" 과 \"애국심 강요\"에 대해 불평했지만, 이들의 비평은 청중에게 있어 그리 큰 영향을 주지 못했지. 라지오 메수스는 "
"감사를 표하는 연설을 했고, 네게 오페라를 헌정했어. 너에 대한 칭송이 온 거리에 울려퍼지고, 모두가 네 이름으로 축배를 들었어. "
"축하해, {name} - 넌 예술에 있어 최고의 후원자로 역사에 길이길이 남을 거야... 그리고 영리한 정치인으로서도 말이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0004_Text
#. Speaker : Linzi_Companion
msgctxt "c1537362-2bba-40b0-a63c-7096a1c0389a"
msgid ""
"\"You know, {name}… no matter what obstacles have risen before us, and what "
"troubles we've faced, we've always reached new heights. Just think — just a "
"few short years ago, there wasn't even anyone here to talk to around these "
"parts, aside from the Stag Lord's thugs and the miserable, frightened "
"peasants. Today you can't throw a shoe without hitting a bard! Every day "
"there's more exhibitions, plays, and concerts...\""
msgstr ""
"\"너도 알겠지만, {name}… 우리 앞을 그 어떤 장애물이 가로막더라도, 혹은 그 어떤 어려움이 우리 앞에 닥치더라도, 우린 언제나 "
"이겨냈지. 몇 년 전만 해도 생각해봐, 숫사슴 군주의 도적들과 비참하고 겁에 질린 사람들에 대한 이야기 말고는 할 게 없었지. 이젠 "
"길거리에 채이는 게 음유시인이야! 매일 새로운 전시회, 연극, 연주회가 가득해...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "ddbd378e-6c75-4267-a543-4aab1589947d"
msgid ""
"\"Your Highness, there's something else I wish to mention. Every day I "
"receive new supplicants — painters, bards, and sculptors — and no matter how "
"hard I labor, the next day there's only more. But I suppose it's a good "
"sign. It means that the seeds we've planted here have come to bear fruit.\""
msgstr ""
"\"전하, 드릴 말씀이 있습니다. 매일같이 탄원자들이 탄원을 해오고 있습니다. 화가, 음유시인, 조각가... 아무리 열심히 일해도 다음 "
"날이면 더 많이 올 뿐입니다. 그래도 이는 좋은 징조입니다. 우리가 뿌린 씨앗이 결실을 맺는다는 뜻이니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0006_Text
#. Speaker : Jaethal_Companion
msgctxt "f9cb9497-7f30-4d4f-a4d1-19d9ec4518ad"
msgid ""
"\"Your success speaks for itself. Before you arrived here, none but mindless "
"cut-throats and cowering peasants lived here. After winning the rule of this "
"backwater, you've managed to turn it into the cultural metropole of the "
"River Kingdoms. I've watched this struggle with interest — and I am "
"impressed. Few are capable of such deeds.\""
msgstr ""
"\"넌 성공했어. 네가 오기 전 까지만 해도, 무정한 도적떼나 겁에 질린 백성들만 여기 살고 있었지. 이 오지의 지배권을 얻은 후로 넌 "
"이곳을 강의 왕국들 연맹의 문화중심지로 바꾸는 데 성공했어. 네 노력을 흥미롭게 지켜봤지. 그리고 깊은 인상을 받았어. 이런 위업을 해낼 수 "
"있는 이는 거의 없거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0007_Text
#. Speaker : Linzi_Companion
msgctxt "b1a81c73-f253-4f7f-8511-158840087cd3"
msgid ""
"\"{name}… Larzio is dead. He never lived to see his opera reach the stage. "
"However, someone in Galt did stage his tragicomedy... and the audiences are "
"raving! The critics have declared him the most talented composer of his "
"generation — and the most underappreciated. His music mesmerized me as well. "
"As for the satire and the plot... it's a bit too bitter for my taste, even "
"vitriolic. His admirers are already organizing trips to our kingdom — to see "
"the sights their favorite genius lived by...\" {n}Linzi sighs.{/n} \"And "
"still... still, life goes on.\""
msgstr ""
"\"{name}… 라지오가 죽었어. 자신의 오페라가 무대 위로 오르는 모습을 보지 못한 거야. 그래도, 갈트의 누군가가 그의 희비극을 "
"공연했어... 청중들은 극찬했고 말이지! 비평가들은 그를 동세대 최고의 재능을 가진 작곡가라고 선언했어. 가장 과소평가 받는 사람으로 "
"말이야. 그 풍자와 플롯은... 내 취향엔 조금 안 맞았었던 거 같아. 심지어 독설적이기도 했고. 라지오를 흠모하는 사람들이 우리 "
"왕국으로의 여정을 계획하고 있어. 자신들이 가장 좋아했던 천재가 살았던 곳을 두 눈으로 보기 위해....\" {n}린지는 한숨 "
"쉬었다.{/n} \"그래도... 그래도, 삶은 계속되는 법이니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0008_Text
#. Speaker : Capital_Collector
msgctxt "cc832225-279e-4f0d-b090-b779d2c31eac"
msgid ""
"\"We have news from Galt. The posthumous production of Larzio Messus' opera "
"has been a great success with the audience. The critics praise his poignant "
"satire, his 'merciless keen eye and sharp tongue'. Many visit our kingdom to "
"take in the sights that inspired their favorite author.\" {n}For a long "
"time, the Storyteller remains silent.{/n} \"I must say, I haven't heard such "
"music as his in many decades. It is hard to believe that a mind so young "
"could have produced such flawless harmony...\""
msgstr ""
"\"갈트에서 들어온 소식이 있습니다. 라지오 메수스의 사후 만들어진 오페라가 대단한 성공을 이루었다고 합니다. 비평가들도 라지오의 통렬한 "
"풍자인 '자비없는 날카로운 눈과 날카로운 혀'를 칭찬했습니다. 많은 이들이 이 작곡가에게 영감을 준 우리 왕국을 방문하고 있습니다.\" "
"{n}오랜 시간 동안, 이야기꾼은 침묵했다.{/n} \"라지오의 작품 같은 음악은 수십년 만에 처음 들어봅니다. 그토록 젊은이가 이렇게 "
"흠 없는 조화를 만들어낼 줄이야...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0009_Text
#. Speaker : Jaethal_Companion
msgctxt "e1161731-9df0-437a-9177-576d219eff57"
msgid ""
"\"Larzio Messus' opera was staged after all… after his death, in Galt. The "
"premiere of the tragicomedy was sensational, and the critics have declared "
"him a genius. His insolent and slanderous attacks against you and your "
"authority are the season's 'precise and poignant satire'... But there's a "
"silver lining: his admirers flock to our land, wishing to see for themselves "
"where the events of the opera took place. No doubt, the result could have "
"been far better had we supported the composer. But yet...\""
msgstr ""
"\"라지오 메수스의 사후 그의 오페라가 갈트에서 결국 무대 위에 올랐다고 해... 최고의 희비극인 이 오페라는 선풍적인 인기를 끌었대. "
"그리고 비평가들도 그를 천재라고 칭송하더군. 너와 네 권위에 대한 그의 신랄하고도 걸쭉한 비방은 참으로 '정확하고도 통렬한 "
"풍자'였어... 하지만 비판만 있었던 건 아니야. 그의 추종자들이 오페라가 열렸던 우리의 땅을 직접 보고싶어하고 있어. 확실한 건 우리가 "
"라지오에게 후원을 해줬더라면 결과는 더 나아졌을지도 모르지만...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0010_Text
#. Speaker : Linzi_Companion
msgctxt "8e36af87-d056-46c2-9692-4d779f4fff3c"
msgid ""
"\"The opera's premiere was a complete disaster!\" {n}Linzi hesitates in "
"silence.{/n} \"I've no idea how it came to pass… but one thing is certain — "
"Larzio's talent did not shine through. The audience was indifferent for the "
"most part. But the critics tore Larzio to pieces. – For his \"utter lack of "
"taste\" as well as \"groveling before the powers that be\"... Oh well. You "
"can't win them all. We've pretty much failed on this one, but it won't be "
"our last chance to do something wonderful.\""
msgstr ""
"\"오페라 개봉은 완전히 재앙이었어!\" {n}린지는 침묵 속에서 주저했다.{/n} \"어떻게 이런 일이 발생한 거지... 그래도 한 "
"가지는 확실해. 라지오의 재능이 빛을 받지 못했다는 것 말이야. 대부분의 파트에서 청중들의 반응도 그저 그래. 그런데 비평가들이 라지오를 "
"완전 조각내놨어. – \"감각적 능력의 부재\" 라는 말 외에도 \"권력 앞에 굽실거리는 그 모습은\"... 이런. 모두를 만족시킬 수는 "
"없지. 이번엔 실패한 거 같아. 그래도 멋진 걸 해보기엔 아직 기회가 많이 남아있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0012_Text
#. Speaker : Jaethal_Companion
msgctxt "7554e244-c79d-4a93-b52d-dcf223caf146"
msgid ""
"\"The opera's premiere was a disgrace. As expected, without strict oversight "
"and daily support, Larzio was unable to come up with anything of worth. Even "
"the low peasants wouldn't choke down the detestable tunes… Still, his "
"failure only serves as a foil for the overall prosperity that the kingdom "
"has achieved in these last few years.\""
msgstr ""
"\"오페라 개봉은 참으로 불명예스러웠어. 예상한 대로, 엄격한 감독과 매일같은 지원이 없었기에 라지오는 아무런 가치있는 것도 만들어내지 "
"못한 모양이야. 천민들마저도 그 끔찍한 곡조는 못 참아하는 것 같더라고... 그래도, 라지오의 실패는 지난 몇 년간 우리 왕국이 일궈낸 "
"번영을 돋보이게 해주는 역할은 될 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0013_Text
#. Speaker : Linzi_Companion
msgctxt "2e991747-f2df-41b6-9287-cf197b5543a7"
msgid ""
"\"There's something more to people's lives now than back-breaking labor all "
"day, and a jug of moonshine before sleep. They've somewhere to go, something "
"new to see, something to talk about – and think about! I guess I just wanted "
"to say that I'm proud. — I'm proud of how daily life has changed in your "
"lands, and I'm proud that you let me be a part of that change.\""
msgstr ""
"\"요즘 사람들은 하루의 고된 노동을 마치고 자기 전에 밀주 한 잔 들이키는 것 외에도 즐길 거리가 많아. 놀러갈 곳도 있고, 볼 것도 "
"많고, 이야기할 것도 많아. 그리고 생각할 것도 많지! 네가 장하다는 말을 하고 싶어. 사람들의 일상이 네 손에 의해 바뀌었다는 사실이 "
"자랑스럽고, 내가 그 변화에 있어 한 역할을 맡게 되었다는 사실도 자랑스러워.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0019_Text
#. Speaker : Capital_Collector
msgctxt "d5bdfbe6-faff-455f-a712-463ec836f842"
msgid ""
"\"Your Highness, yesterday was the premiere of maestro Larzio's opera. The "
"event was… not everything we might have hoped. Much of the audience left "
"after the first act. The critics lambasted the author — both for 'ill taste' "
"and 'subservience before the powers that be'.\" {n}The Storyteller falls "
"silent, his bony fingers fumbling with his sleeve.{/n} \"However...\""
msgstr ""
"\"전하, 어제 라이조의 오페라가 개봉했습니다. 그건... 우리가 예상했던 대로가 아닙니다. 많은 관객들이 첫 번째 공연 이후로 "
"떠나버렸습니다. 비평가들은 작가를 맹공격했습니다. '비루한 감각' 과 '현 권력에 아첨하는 모습' 을 주제로 말입니다.\" {n}"
"이야기꾼은 침묵에 빠졌다. 그의 앙상한 손가락으로 자신의 소매를 더듬거리며.{/n} \"하지만...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0020_Text
#. Speaker : Capital_Collector
msgctxt "d54c6faf-9860-4cda-9628-a8a55f561f88"
msgid ""
"\"Once, only bandits and peasants lived here — but now a beautiful city has "
"sprung up, full of energy and the sound of music. I have not always agreed "
"with the decisions you make, but I am happy that I was able to take part in "
"the rebirth of the Stolen Lands.\""
msgstr ""
"\"한때 이곳에는 도적과 농민만이 살았지만 지금은 활력과 음악 소리로 가득 찬 아름다운 도시가 생겨났습니다. 제가 당신이 내리는 결정에 "
"항상 동의한 것은 아니지만, 도둑맞은 땅의 부활에 참여할 수 있었다는 것이 행복하군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0021_Text
#. Speaker : Linzi_Companion
msgctxt "7be85755-000b-4c79-9505-29a3b2e25509"
msgid ""
"\"Larzio Messus' opera premiered yesterday! His work was met with great "
"excitement by the townsfolk, and even the critics are mostly satisfied. I "
"loved the music, but he needs to work on his writing a bit more… But all in "
"all it was a great result for a budding composer!\""
msgstr ""
"\"라지오 메수스의 오페라가 어제 첫 공연을 마쳤습니다! 마을 사람들에게 굉장한 흥미를 끌었고, 평론가도 대부분 만족하고 있어요. 저는 "
"라지오의 작품에서 음악이 좋았어요. 글 실력은 좀 더 노력해야겠던데요... 어쨌든 신진 작곡가로서는 훌륭한 성과죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0022_Text
#. Speaker : Capital_Collector
msgctxt "beff42e9-ccdb-4c63-ba25-8bbeebc4776b"
msgid ""
"\"Maestro Messus' opera has finally been staged, Your Highness. The premiere "
"was a success: both the audience and the critics were quite satisfied. Some "
"noted that the production might have been a bit more... grandiose. But I do "
"not think the work would have benefitted from that. I would say that the "
"young composer has a long and illustrious career ahead of him...\""
msgstr ""
"\"마에스트로 메수스의 오페라가 마침내 무대에 올랐습니다, 전하. 초연은 매우 성공적이었습니다: 청중들과 비평가 모두 만족했습니다. "
"몇몇은 그 작품이 좀 더 웅장해야 한다고 말했습니다만... 저는 웅장함이 그 작품을 더 훌륭하게 만드리라곤 생각하지 않습니다. 이번 "
"작품의 젊은 작곡가는 앞으로 길고 빛나는 경력을 가지게 될 것입니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0023_Text
#. Speaker : Jaethal_Companion
msgctxt "b920df3b-ad0a-4d7d-b005-e0af8fed75b2"
msgid ""
"\"Larzio's opera has just premiered, and to much fanfare! The audience is "
"thrilled, and overflowing with patriotic feelings. The critics are mixed, "
"but the people are too vacant to listen anyway. Of course, the production "
"could have been more grandiose… but we'll surely correct that flaw in "
"Larzio's future work.\""
msgstr ""
"\"라지오의 오페라가 첫 공연을 마쳤으며, 엄청난 환호를 받았다고 합니다! 청중들은 감동했고, 애국심이 고양되었습니다. 비평가들의 반응은 "
"갈렸지만, 청중들이 반응을 듣기엔 멍한 상태였습니다. 물론, 공연이 더 웅장했을 수도 있지만... 라지오의 다음 작업이 아쉬운 점들을 "
"고치리라 확신합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0024_Text
#. Speaker : Linzi_Companion
msgctxt "253522a8-0a95-445c-a00f-2976271d3b8b"
msgid ""
"\"People completely ignored any sort of art until just recently. But look at "
"them now! Every new exhibition, every staged play, every foreign bard makes "
"them so happy! And creators are also happy to see their ruler's favor and "
"fortune. On the downside, there's talk that our cultural life is a little "
"too close to that of Irovetti... but you can't please everyone, am I right?\""
msgstr ""
"\"얼마 전 까지만 해도 사람들은 예술이라면 완전히 무시해댔어요. 하지만 지금 보세요! 매일 새로운 전시회, 연극, 음유시인들이 찾아와 "
"사람들을 행복하게 만들어주고 있죠! 그리고 창작자들도 지도자의 호의와 돈을 받으며 기뻐하고 있고요. 다만 아쉬운건 건, 우리 문화가 "
"이로베티쪽과 너무 비슷하다는 얘기가 나오고 있어요... 뭐, 모두를 만족시킬 순 없는 거니까요. 그쵸?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0025_Text
#. Speaker : Capital_Collector
msgctxt "4e651fc7-990c-4a44-b75f-0260dc0ac19e"
msgid ""
"\"{name}, I wish to commend you for the great fulfilment we're witnessing "
"under your rule. I speak of art, that most fanciful and gentle flower only a "
"ruler can truly grow. Perhaps not all of your subjects' creations flatter "
"you, but this is merely an indication that the artists enjoy as much freedom "
"in your lands as they like.\""
msgstr ""
"\"{name}님이 다스리는 치세에 우리가 행복하다는 것을 말해주고 싶습니다. 특히 예술 분야에서 말입니다. 이런 섬세하고 아름다운 "
"예술의 부흥은 군주만이 키워낼 수 있는 것이죠. 우리 신하들이 만들어낸 모든 창작품이 맘에 들 수는 없겠지만, 그건 우리 땅에서 "
"예술가들이 원하는 만큼 자유를 즐기며 살아간다는 것을 뜻합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank10/Cue_0026_Text
#. Speaker : Jaethal_Companion
msgctxt "287a5995-e110-40a1-a2f5-0d5c7990e27a"
msgid ""
"\"Freedom of thought runs rampant in your domain. This phenomenon is a "
"danger to any ruler. Nonetheless, you remain on your throne, which is "
"clearly an indication of your subjects' affection. Despite what I might "
"think about the path you've chosen, I must admit, the Stolen Lands have "
"become the cultural center of the River Kingdoms under your governance. Few "
"rulers are in a position to carry out such work.\""
msgstr ""
"\"사상의 자유가 걷잡을 수 없이 네 영토에서 퍼져나가고 있다. 이런 현상은 어떤 군주에게든지 위험해. 그래도, 넌 지금 자리 보전을 잘 "
"하고있어. 이 말인 즉슨 네가 신하들의 지지를 받는다는 뜻이지. 네가 어떤 길을 선택했든 간에 한 가지는 인정해야겠어. 도둑맞은 땅은 네 "
"지배 하에서 리버 킹덤의 문화적 중심지가 되었다는 것을. 네 위업을 따라올만한 군주는 거의 없을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Answer_0011_Text
msgctxt "df5081f3-5e54-4127-8a8f-2d9d97fa8a8e"
msgid ""
"{g|Culture2_1}[Choice effects]{/g} [Pay 100 BP] \"We will open schools. I "
"don't want my lands to be inhabited by uneducated bumpkins.\""
msgstr ""
"{g|Culture2_1}[선택 시 효과]{/g} [100 BP 지불] \"나는 학교를 열겠다. 내 땅에 멍청이들이 사는 꼴을 더는 볼 "
"수 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Answer_0012_Text
msgctxt "5de10ff6-39c0-4fe5-8111-4067059be7ed"
msgid "\"Forget about schools. There are already enough ways to spend money.\""
msgstr "\"학교는 잊어버려. 거기 말고도 돈 쓸 방법은 충분히 많으니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Answer_0013_Text
msgctxt "5ebc6580-1f5c-400f-91b2-9e5319797fbb"
msgid "\"Make your own decision.\""
msgstr "\"네가 결정해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Answer_0023_Text
msgctxt "1e1e05f3-b1eb-43d7-9449-2cfdcfd65c8e"
msgid ""
"{g|Culture2_2}[Choice effects]{/g} [Pay 100 BP] \"I would follow your "
"advice. Spend the money on opening new pubs and inns.\""
msgstr ""
"{g|Culture2_2}[선택 시 효과]{/g} [100 BP 지불] \"당신의 조언을 수용하겠다. 이 돈을 새로운 주점과 여관을 "
"여는데 쓰도록 해라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "77467524-d8a8-4872-ad0b-b55a98322f1e"
msgid ""
"{n}Linzi waves her hands in excitement.{/n} \"Finally, finally you have your "
"own advisor for cultural affairs! I am so happy you entrusted this to me!\""
msgstr ""
"{n}린지는 흥분해서 손을 흔들었다.{/n} \"드디어, 드디어 문화 관련 일에 자문가가 생겼네요! 나에게 이걸 맡기셔서 너무 기쁩니다!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0002_Text
#. Speaker : Linzi_Companion
msgctxt "0f7071d1-40fe-4a46-96f4-fe1fb3dffdd0"
msgid ""
"\"First of all – art in our {mf|barony|barony|kingdom|kingdom} is not doing "
"so well. People care more about the soil and what it can give them, and not "
"about affairs of the spirit or the life of the mind. But we can fix this! "
"Your subjects just need a gentle nudge in this direction...\""
msgstr ""
"\"우선 – 우리 {mf|남작령|남작령|왕국|왕국} 에서 예술은 잘 나가고 있지는 않아요. 사람들은 더 토양이나 수확물에 대해서 "
"신경쓰죠. 영혼의 문제나 마음의 삶에 대해서는 상관하지 않아요. 하지만 우리가 이걸 고칠 수 있어요! 백성들은 그 방향으로 슬쩍 유도만 "
"필요한 거예요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0003_Text
#. Speaker : Linzi_Companion
msgctxt "5e6ca1d8-2ccd-4ffb-8d74-4eaabf367ef7"
msgid ""
"\"You just have to spend a little money and time on education! Open private "
"schools, offer classes at temples, or even invite foreign teachers to the "
"capital – anything will be better than what we have now! What do you say?\""
msgstr ""
"\"당신은 교육에 너무도 적은 시간과 돈을 쓰고 있습니다! 학교를 열거나 사원에서 수업을 하거나 수도에 외국인 교사를 초대해야 합니다. "
"무엇이든 지금보단 나을겁니다! 어떻게 생각하십니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0004_Text
#. Speaker : Capital_Collector
msgctxt "025fff4b-50f1-4174-b476-668fe21812c1"
msgid ""
"\"My respects, {mf|Your Grace|Your Grace|Your Highness|Your Highness}.\" {n}"
"The storyteller bows.{/n} \"I'm sorry to disturb you, but there is an "
"important issue concerning my responsibilities.\""
msgstr ""
"\"존경하는, {mf|영주님|영주님|전하|전하}.\" {n}이야기꾼이 고개를 숙입니다.{/n} \"방해해서 죄송하오나, 제 책임과 관계된 중요한 "
"일이 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "3c07206e-0aa9-4295-8cbd-a678fe6634e0"
msgid ""
"\"As a curator I could not help but notice that the level of education in "
"your {mf|barony|barony|kingdom|kingdom} is abysmal. Many citizens don't know "
"how to read, and they send their children out not to study, but to work from "
"dawn to dusk. We must break this vicious circle.\""
msgstr ""
"\"학예사로서 말씀드리자면 현 {mf|남작령|남작령|왕국|왕국} 내 교육 수준은 최악입니다. 백성들의 문맹률이 너무 높고 아이들을 "
"공부하러 보내는 대신 새벽부터 저녁까지 일터로 내보내고 있어요. 이 잔혹한 순환을 끊어버려야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0006_Text
#. Speaker : Capital_Collector
msgctxt "e8b20429-5841-4551-9865-e4e6042eb12a"
msgid ""
"\"Make the first step. Order the opening of village schools – or at least "
"contact the priests who are educated enough to teach their congregation "
"reading, writing and natural science. Of course, this will require no little "
"investment, but the result will justify any expense.\""
msgstr ""
"\"첫 걸음을 내딛으십시오. 마을 학교의 개교를 명령하시거나 신도들에게 독서, 글쓰기, 자연과학을 가르칠 만큼 교육을 받은 사제들에게 "
"연락을 취하십시오. 물론, 적지 않은 투자가 필요하겠지만, 비용 이상의 결과를 가져다 줄 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0007_Text
#. Speaker : Jaethal_Companion
msgctxt "a79f1384-7493-4843-ac6a-b9b175fb0d7f"
msgid ""
"{n}Jaethal raises her eyes.{/n} \"I have become the curator in your "
"{mf|barony|barony|kingdom|kingdom} according to your wishes. So please "
"listen to what I will say as your advisor.\""
msgstr ""
"{n}제이탈이 고개를 들어올렸다.{/n} \"네가 바라는 대로 내가 {mf|남작령|남작령|왕국|왕국}의 학예사가 되었으니, 내가 하는 "
"조언을 따라주길 바라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0008_Text
#. Speaker : Jaethal_Companion
msgctxt "a41e3e2a-e07d-49f1-962e-43e7c2dff285"
msgid ""
"\"Among my responsibilities is ensuring that your subjects are educated and "
"knowledgeable. But instead I offer a warning: a peasant who knows much is a "
"peasant who riots much. Give them no reason to reason, and you'll keep them "
"eating out of your hand.\""
msgstr ""
"\"제 책무 중 하나는 당신의 백성들을 교육적이고 박학다식하게 만드는 것입니다. 그러나 주의하십시오: 똑똑한 농민은 곧 폭동을 많이 "
"일으키는 농민입니다. 그들에게 판단할 여지를 주지 않는다면, 당신은 그들을 손바닥 안에 둘 수 있을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0009_Text
#. Speaker : Jaethal_Companion
msgctxt "f0d2387a-faf9-4c8b-848c-f05c609c190a"
msgid ""
"\"There are no schools in your lands – and that's a beautiful start. Rather "
"than building schools, I suggest the construction of more pubs and "
"alehouses, where the peasantry can drown their days in oblivion. There is no "
"more obedient servant, than one who sees only the bottom of his beer mug. I "
"strongly suggest you continue this state of affairs.\""
msgstr ""
"\"당신의 영토에 학교가 없다는 것은 좋은 출발입니다. 학교를 짓기보다는 농민들이 망각 속에서 나날을 보낼 수 있는 더 많은 펍과 "
"선술집의 건설을 제안합니다. 맥주잔 밑부분만 보는 사람보다 더 순종적인 하인은 없습니다. 현 상태의 유지를 강력히 건의드립니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0014_Text
#. Speaker : Linzi_Companion
msgctxt "001ada70-47ee-47ad-ba9b-a23f7d1f2b8e"
msgid "\"Yes! We'll do just that!\""
msgstr "\"예, 그렇게 하겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0015_Text
#. Speaker : Capital_Collector
msgctxt "a6b8d7d8-d940-407a-87fd-6c36f8ad4a83"
msgid ""
"{n}The Storyteller nods.{/n} \"A wise decision, {mf|Your Grace|Your Grace|"
"Your Highness|Your Highness}.\""
msgstr "{n}그 이야기꾼은 고개를 끄떡인다.{/n} \"현명한 결정입니다., {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0016_Text
#. Speaker : Jaethal_Companion
msgctxt "a37e5684-ed02-4a0a-b955-27565a9b504b"
msgid "\"A pity. I'm sorry you can't see past your own nose.\""
msgstr "\"불쌍해라. 주위에 관심이 없다니 딱하기도 하구나.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0017_Text
#. Speaker : Linzi_Companion
msgctxt "8a14c3c3-2d1a-4b7d-a471-21923fd191e8"
msgid ""
"{n}Linzi looks like she is about to cry.{/n} \"But... what about the future "
"of the {mf|barony|barony|kingdom|kingdom}? You can't be stingy about such "
"things! You just can't!\""
msgstr ""
"{n}린지는 금방이라도 울음을 터뜨릴 것만 같다.{/n} \"하지만... {mf|남작령|여남작령|왕국|왕국}의 미래는 어떡하고요? 그렇게 "
"인색해선 안돼요! 그럴순 없다고요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0018_Text
#. Speaker : Capital_Collector
msgctxt "da149b54-ad92-4dc9-9db5-28390238d280"
msgid ""
"{n}A wrinkle appears on the Storyteller's forehead.{/n} \"This is none too "
"provident on your part. This investment would pay dividends far into the "
"future, when today's children become tomorrow's scientists and wizards.\""
msgstr ""
"{n}이야기꾼의 이마에 주름이 나타났다.{/n} \"이건 헛돈 쓰는 게 아닙니다. 먼 미래를 위한 투자이고, 오늘날의 어린이를 내일의 "
"과학자나 마법사로 만들기 위함입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0020_Text
#. Speaker : Linzi_Companion
msgctxt "c938cd74-76f5-4345-b9c1-a1557592ae1a"
msgid ""
"\"What is there to decide? Of course we'll open schools! I'll handle "
"everything, don't you worry!\""
msgstr "\"무엇을 선택해야 하느냐고? 물론 우리는 학교를 열 것이다! 내가 모두 처리할테니, 걱정하지 마라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0021_Text
#. Speaker : Capital_Collector
msgctxt "493e4528-e8bd-46ee-bce8-952fb49de4a9"
msgid ""
"\"Thank you for your trust. I will order the opening of reading and writing "
"classes at our temples.\""
msgstr "\"신뢰에 감사드립니다. 사원에서 읽기와 쓰기 수업의 개설하는 것을 지시하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0022_Text
#. Speaker : Jaethal_Companion
msgctxt "75d95170-d70b-4bd7-b861-d1aa297f1720"
msgid ""
"\"There aren't enough places in your capital where the citizens can sit and "
"think about nothing. I will remedy this immediately.\""
msgstr "\"당신의 수도에는 시민들이 편하게 앉을 장소가 충분하지 않습니다. 저는 이를 즉시 개선할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank2/Cue_0024_Text
#. Speaker : Jaethal_Companion
msgctxt "f179f46e-e627-4192-b52b-e7f86bc84a21"
msgid "{n}The elf smiles delicately.{/n} \"With pleasure.\""
msgstr "{n}엘프가 미묘하게 미소짓는다.{/n} \"기꺼이.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Answer_0011_Text
msgctxt "42355beb-02d4-47fe-b926-5db14ef49d8b"
msgid ""
"{g|Culture3_1}[Choice effects]{/g} [Pay 75 BP] \"I wish to support this art "
"society financially.\""
msgstr "{g|Culture3_1}[선택 시 효과]{/g} [75 BP 지불] \"나는 이 예술 단체를 재정적으로 지원하고 싶다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Answer_0012_Text
msgctxt "aef8b106-220d-4926-91e5-4ba15506fae5"
msgid ""
"{g|Culture3_2}[Choice effects]{/g} [Pay 50 BP] \"We shall help them found "
"and promote this society.\""
msgstr ""
"{g|Culture3_2}[선택 시 효과]{/g} [50 BP 지불] \"우리는 그들이 이 단체를 발견하고 홍보할 수 있도록 도울 것이다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Answer_0013_Text
msgctxt "c2aab1c6-95ed-4bc3-b7ee-b49683764a9c"
msgid "\"We will not be participating.\""
msgstr "\"우리는 참가하지 않을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Answer_0014_Text
msgctxt "85360aee-0cfe-4bab-9fef-2493d97dc77d"
msgid "\"Do as you deem right.\""
msgstr "\"네가 옳다고 생각하는 대로 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "b7a50890-5ead-44c1-ab50-d10fc480e939"
msgid ""
"\"I need a moment of your time! I have here someone who is sure to help us "
"turn this city into the cultural capital of the {g|River Kingdoms}River "
"Kingdoms{/g}!\""
msgstr ""
"\"잠깐 시간 좀 내주세요! 이 도시를 {g|River Kingdoms}강의 왕국들{/g}의 문화 수도로 바꾸는 것을 확실하게 도와줄 "
"분을 데려왔습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "aacdd2c4-2b6d-4df6-9502-86591a25a312"
msgid ""
"{n}The Storyteller raises his hand to get your attention.{/n} \"{mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}, please spare me a few "
"moments. As your curator, I request you listen to this kind lady, who wishes "
"to discuss with you something of great importance.\""
msgstr ""
"{n}이야기꾼은 손을 들어 당신의 주의를 끌었다.{/n} \"{mf|영주님|영주님|전하|전하}, 잠시만 시간을 내주십시오. "
"학예사로서, 중요한 사안을 논의하러 온 이 친절한 여인의 말씀을 들어보시라 간청하고 싶습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "f969636c-5a84-4671-8fb9-e44503b81df4"
msgid ""
"{n}Jaethal waves carelessly in the direction of an aasimar.{/n} \"A "
"petitioner. She insisted on a personal meeting.\""
msgstr "{n}제이탈이 아시마르 쪽으로 부주의하게 손을 흔든다.{/n} \"청원인이 개인 면담을 요청했다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0004_Text
msgctxt "bd16451f-acad-4aed-a74d-032565216c94"
msgid ""
"{n}The aasimar bows. The young woman is wearing simple clothes, but carries "
"herself with dignity.{/n} \"My greatest respect, {mf|baron|baroness|my King|"
"my Queen}! My name is Rikri Sharvan, and I am the leader of a small group of "
"enthusiasts, who wish to enrich life in the city. I come to you for two "
"reasons: to tell you about our cause, and to ask for your support.\""
msgstr ""
"{n}아시마르는 몸을 숙인다. 이 젊은 여성은 간단하게 차려입었지만, 몸에서 품위가 묻어져나온다.{/n} \"존경하는, "
"{mf|남작님|남작님|대왕님|여왕님}! 제 이름은 리크리 샤르반, 귀공의 열렬한 지지자이자, 도시의 풍요를 기원하는 자입니다. 두 가지 "
"이유 때문에 찾아뵙습니다. 저희의 존재 의의를 말씀드리고, 지원을 얻고자 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0005_Text
#. Speaker : RankUp_RikriSharvan
msgctxt "c86c1bfe-5358-4c00-a1f2-35e0d195e1e5"
msgid ""
"\"A while ago an idea emerged in our ranks. Even though there are many ways "
"to entertain oneself in the capital, there are still not enough cultural "
"events taking place, even as artists are starved for money and audience. "
"Thus we have decided to form a society for the appreciation of fine arts! "
"Each member pays a modest monthly fee, and in return gets to vote which "
"event the society should fund each month. Just imagine: the community will "
"finally be able to organize exhibitions, performances, philosophical "
"debates, concerts – and do this all on its own! We will inspire our friends "
"and neighbors – but in order to provide an adequate reward for our most "
"distinguished artists, we shall need to attract more members, and increase "
"our funds.\""
msgstr ""
"\"얼마 전 저희 사이에서 한 가지 발상이 떠올랐습니다. 수도에서 유흥을 즐기는 방법은 많지만, 아직 문화적 행사같은 것이 일어나지 "
"않고 있습니다. 예술가들은 돈과 청중에 목말라 죽어가고 있지요. 그렇기에 저희는 미술 감상을 위한 단체를 만들어 냈습니다! 모든 회원은 "
"달마다 돈을 조금씩 내고, 그 대가로 달마다 어디서 행사를 벌일지 투표할 권리를 얻게 됩니다. 상상해 보십시오. 지역 사회는 이제 "
"전시회, 공연, 철학 토론, 연주회를 열 수 있게 된 겁니다. 자기 손으로요! 저흰 사람들의 마음을 사로잡을 준비가 되었습니다. 하지만 "
"우리의 선별된 예술가들에게 보상을 주려면, 기금을 더 모아야 하고 더 많은 회원이 필요한 상황입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0006_Text
#. Speaker : RankUp_RikriSharvan
msgctxt "90b80f86-2a9f-4120-9587-42906999f704"
msgid ""
"{n}Rikri folds her hands.{/n} \"All we ask of you is a little support. Any "
"funds you can spare will be most welcome, of course, but we especially need "
"your help in founding and promoting the society and organizing the events. "
"It will require a great effort to make this dream come true!\" {n}The "
"aasimar bows.{/n} \"Thank you for your time. Please, if you decide to "
"support us, send us a message through your curator. And whatever your "
"decision, I hope your esteemed advisor will honor us by taking part in the "
"opening ceremony!\""
msgstr ""
"{n}리크리는 손을 깍지 꼈다.{/n} \"저희가 바라는 것은 얼마 안 되는 지원뿐입니다. 물론 어떤 기금이라도 환영하지만, "
"특히 학회를 설립하고 홍보하고 행사를 조직하는 데 도움이 필요합니다. 이 꿈을 이루기 위해서는 큰 노력이 필요합니다!\" {n}"
"아시마르는 몸을 숙였다.{/n} \"시간 내주셔서 감사합니다. 저희를 지원해주시기로 하셨다면 학예사를 통해 저희에게 "
"알려주십시오. 어떤 결정을 내리시든, 개회식에 보좌관을 보내셔서 자리를 빛내주셨으면 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0007_Text
#. Speaker : Linzi_Companion
msgctxt "c7f4ca28-b4d9-4918-b6f1-fae8e32a3cdb"
msgid ""
"{n}Linzi's eyes shine with excitement.{/n} \"Well? What do you say? I say "
"it's a very worthy cause – and I wouldn't be stingy about it!\""
msgstr ""
"{n}린지의 눈은 흥분으로 빛난다.{/n} \"글쎄요? 어떻게 생각하나요? 난 합당하다고 생각해요! 그리고 거기에 인색하지 않았음 해요."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0008_Text
#. Speaker : Capital_Collector
msgctxt "5abe699d-ac58-4ed3-b5ce-909a2636357b"
msgid ""
"{n}The Storyteller cocks his head.{/n} \"So? What shall I tell Lady Sharvan? "
"To my mind, these people need our guidance and attention more than they need "
"our money. We could inform all the city of this newly-founded society, and "
"assist in the collection of membership fees.\""
msgstr ""
"{n}이야기꾼은 고개를 바로세웠다.{/n} \"자, 그럼 샤르반 부인에겐 뭐라고 전해드려야 할까요? 사견을 내자면 이 사람들은 우리의 돈 "
"보다 안내와 주의를 필요로하는 것 같습니다. 새로 만들어진 이 단체를 온 도시에 홍보해서, 이들이 회원비를 걷는 걸 도와줄 수 있습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0009_Text
#. Speaker : Jaethal_Companion
msgctxt "e551a49c-de6a-4b58-bced-9246f41940c6"
msgid ""
"{n}Jaethal thinks for a moment.{/n} \"Yes. Support them. Give them money. "
"Make them feel they owe you. Moving forward, the resulting mixture of "
"obligation and guilt will allow you to control everything that goes on in "
"this 'society'."
msgstr ""
"{n}제이탈은 잠시 생각에 빠졌다.{/n} \"그래. 저들을 돕자. 돈을 주자. 저들이 네게 빚졌다고 생각하게 만들자고. 추후에 의무와 "
"죄책감을 얹어줘서 저들의 '단체'를 조종하자고."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0015_Text
#. Speaker : Linzi_Companion
msgctxt "2607b05c-23ca-4a1d-9afe-09853475df2f"
msgid ""
"\"Wonderful! I will immediately give orders to draw money from the treasury!"
"\""
msgstr "\"멋져요! 즉시 재무부에 돈을 인출하라는 명령을 내리도록 할게요! \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0016_Text
#. Speaker : Capital_Collector
msgctxt "433cd488-c0fa-4304-96fd-974d39806b49"
msgid ""
"\"A most reasonable proposal, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}\"."
msgstr "\"합리적인 제안입니다, {mf|영주님|영주님|전하|전하} \"."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0017_Text
#. Speaker : Jaethal_Companion
msgctxt "ee56904b-6858-481f-bc4a-8c8cdf8d76f3"
msgid ""
"\"A good step, {name}. I will write to the aasimar in the most refined and "
"sincere terms.\""
msgstr "\"좋은 진전이야, {name}. 아시마르에게 가장 정제되고 신실한 용어들로 편지를 쓰겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0018_Text
#. Speaker : Linzi_Companion
msgctxt "8c41ea49-5fe5-49fa-893d-a828ebfd9bab"
msgid "\"Great! No one in such a situation would reject that kind of help!\""
msgstr "\"좋습니다! 이런 상황에서는 아무도 그런 도움을 거절하지 않을 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0019_Text
#. Speaker : Capital_Collector
msgctxt "65b47d06-83b4-4d9d-8fad-fda088fda343"
msgid "\"A most wise decision.\""
msgstr "\"가장 현명한 선택입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0020_Text
#. Speaker : Jaethal_Companion
msgctxt "2b8b9f8e-2f61-42bb-b76f-40bd970b931e"
msgid "\"Not a great deal of leverage, but better than nothing.\""
msgstr "\"엄청난 이득은 아니지만 아무것도 아닌 것보다야 낫겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0021_Text
#. Speaker : Linzi_Companion
msgctxt "70c6c989-7a02-4626-acd4-531cec0a7639"
msgid ""
"\"You have no idea how sad I am to hear this. You probably have your "
"reasons, but still... fine, let's just forget about it. I hope Rikri and her "
"friends can handle everything on their own.\""
msgstr ""
"\"슬픈 소식이네요. 그럴 만한 이유가 있겠지만... 좋아요, 그냥 잊어버릴게요. 부디 리크리와 그녀의 친구들이 감당할 수 있기를 바라요."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0022_Text
#. Speaker : Capital_Collector
msgctxt "d6b31d3b-4d52-48af-b133-32358b7ab966"
msgid ""
"\"I am sorry to hear you would choose to neglect subjects in need of your "
"help. Still, I feel certain that Lady Sharvan will find a way to handle this "
"project on her own.\""
msgstr "\"도움을 필요로하는 자들을 무시하기로 하셨다니 안타깝군요. 그래도, 샤르반 부인은 혼자서 잘 해 나갈겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0023_Text
#. Speaker : Jaethal_Companion
msgctxt "2bd02943-bd0c-4b1e-9fd6-4331eb32be5c"
msgid ""
"\"Letting the matter run its course? I assure you, once their little society "
"grows, its members will not be drinking to your health.\""
msgstr "\"그냥 내버려두겠다고? 내 장담하지, 저 작은 단체가 커지면, 결코 네 안녕을 위해 축배를 들지 않을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0024_Text
#. Speaker : Linzi_Companion
msgctxt "1c7603f4-c7ee-43f3-b643-48df02634dee"
msgid ""
"\"Then I will go to the Treasurer immediately, and order the necessary sum "
"be sent immediately to Rikri and her associates!\""
msgstr "\"당장 재무관에게 가서 리크리와 동료들에게 필요한 금액을 보내라고 하겠소!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0025_Text
#. Speaker : Capital_Collector
msgctxt "1632587a-2729-4640-b159-aede2fe00bab"
msgid ""
"\"Very well. Lady Sharvan will receive all the help she needs in founding "
"and running this society.\""
msgstr "\"알겠습니다. 샤르반 부인이 사회의 기반을 다지고 운영하는 데에 지원하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank3/Cue_0026_Text
#. Speaker : Jaethal_Companion
msgctxt "a7e69e80-8db6-4151-8a04-f5e5ee570c7b"
msgid "\"Very good. The Treasurer will have to dip into his coffers.\""
msgstr "\"아주 좋아. 재무관이 금고에서 돈에 빠져 수영을 하겠군\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Answer_0008_Text
msgctxt "4c2fcb05-212d-4ba2-8460-2e467576ffdd"
msgid "\"Tell me more about each candidate.\""
msgstr "\"각 후보자에 대해서 더 말해 주세요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Answer_0009_Text
msgctxt "d83b11b5-3895-470f-922e-b9a15081e911"
msgid ""
"{g|Culture4_3}[Choice effects]{/g} \"My soldiers risk their lives every day "
"for these lands. Let them enjoy some well-deserved glory. Let's order the "
"series of etchings from the artist.\""
msgstr ""
"{g|Culture4_3}[선택 시 효과]{/g} \"우리 병사들은 우리의 땅에서 매일같이 목숨을 위협받는다. 그들이 응당히 받아야 할 "
"영광을 취하게 내버려두라. 예술가로부터 판화를 그려달라고 주문하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Answer_0010_Text
msgctxt "d8a53926-24b5-412b-8d1f-65ba171794ff"
msgid ""
"{g|Culture4_1}[Choice effects]{/g} \"Let our neighbors learn all about the "
"talented people of our lands. We'll help the musician.\""
msgstr ""
"{g|Culture4_1}[선택 시 효과]{/g} \"우리 이웃들이 재능있는 사람들에 대해 알게 하라. 우리는 음악가들을 지원할 것이다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Answer_0011_Text
msgctxt "336d026d-ed8a-4fa5-8181-d785d56ea4cd"
msgid ""
"{g|Culture4_2}[Choice effects]{/g} \"It is our duty to preserve the culture "
"and traditions of the Stolen Lands. We'll support the provincial teacher.\""
msgstr ""
"{g|Culture4_2}[선택 시 효과]{/g} \"도둑맞은 땅의 문화와 전통을 지키는게 우리 의무요. 영지의 선생들을 지원할 것이오."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Answer_0035_Text
msgctxt "b17fd411-2127-4717-b9bf-642d78e47ba2"
msgid "\"Make your own decision.\""
msgstr "\"자네가 결정하게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Conf_JaethalWitRefusal_Text_String
#. Speaker : Jaethal_Companion
msgctxt "d7e8c3b7-d6fc-4e98-b763-8a6802c773dd"
msgid ""
"\"In any case, you should find yourself another curator, {name}. It doesn't "
"make sense to me to continue as your advisor. Apparently, you already know "
"how to spend money, what to do in every situation, and how to solve every "
"problem. You know where to find me when you want to talk.\""
msgstr ""
"\"어쨌든 간에, 다른 학예사를 찾아보도록 해, {name}. 내가 계속 네 보좌관 역할을 한다는 건 말이 안 돼. 결정적으로, 넌 돈 "
"쓰는 법을 알잖아. 어떤 상황이든 뭘 해야할지 알고, 문제를 해결하는 법도 알지. 내가 필요하면 날 다시 찾으라고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Conf_WitCollectorRefusal_Text_String
#. Speaker : Capital_Collector
msgctxt "bc10a3ae-00ca-431a-a20b-b1508d029c3a"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, I've been thinking "
"about this a lot lately, and I'd like to resign as your curator. You and I "
"regard life very differently. Our values seem to be in opposition. I hope "
"you will understand my decision.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 최근에 많이 생각해 봤는데, 학예사 직에서 사임할까 합니다. 우린 서로 지향하는 삶의 방식이 "
"다릅니다. 서로 충돌하고 있어요. 제 결정을 이해해주시길 바랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Conf_WitLinziRefusal_Text_String
#. Speaker : Linzi_Companion
msgctxt "e27ebff8-4a12-4a31-bf65-cd80a0406465"
msgid ""
"\"You know, {name}... I think it's time I resigned as your advisor. I'm "
"sorry, but what's going on here makes me feel really bad. I will gladly set "
"out on campaigns with you, and I'm not giving up on my book, but public "
"service... Well, it's just not for me. I'm sorry. I hope you understand.\""
msgstr ""
"\"{name}... 이제 보좌관직에서 그만 내려와야 할 거 같아요. 미안해요. 하지만 여기서 일어나는 일 때문에 기운이 나질 않아요. "
"모험 떠나는 일이라면 기꺼이 나설거예요. 책 쓰는 일도 포기 안 할거고요. 하지만 이 직책은... 음, 그냥 제게 안 맞는 거 같아요. "
"미안해요. 이해해주길 바라요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "70f843c8-738b-48e6-985b-617b7975bfb5"
msgid ""
"\"{name}, our Treasurer informs me that we've managed to save up some money "
"allocated for culture – a substantial amount, in fact! I talked to my "
"friends in the artistic communities, and I've found three projects worthy of "
"support!\""
msgstr ""
"\"{name}, 우리 재무관이 말해줬는데, 문화를 위해 충분히 많은 돈을 저축했다고 하더군! 예술가 단체의 내 친구와 대화해봤는데, "
"지원할만한 계획이 세 가지 정도 있는 거 같아!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "11ce1155-874f-49d5-bb26-15f3441f911e"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, my calculations "
"show that we haven't spent all the money we've allocated for cultural "
"development. I have three projects on one of which we could spend the "
"surplus.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 제 계산에 따르면 문화 발전을 위한 기금을 전부 쓰지 않은 것 같군요. 남은 돈을 투자할만한 세 "
"가지 계획을 준비해봤습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "82293338-a5ad-43fe-8e7e-c39ec1035816"
msgid ""
"\"The Treasurer reports that we've allocated more money than we've actually "
"spent on culture. A considerable sum of money remains. Money must be put to "
"work, so I suggest you invest it in one of three projects.\""
msgstr ""
"\"재무관이 지출한 돈보다 더 많은 예산을 배정했다고 보고했습니다. 아직 상당한 액수의 예산이 남아 있습니다. 남아있는 예산을 제대로 "
"쓰기 위해 세 가지 사업 중 하나에 투자할 것을 건의합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0004_Text
#. Speaker : Capital_Collector
msgctxt "295542c2-1ebc-4e3f-bd39-5fda51d97e7d"
msgid ""
"\"It's an easy guess, {mf|Your Grace|Your Grace|Your Highness|Your Highness}"
", that I suggest you pay attention to the folk wisdom collector. I myself am "
"working on preserving tales from the ancient times. He's working hard on "
"preserving modern-day tales for our descendants. The one can't do without "
"the other, and both complement each other nicely!\""
msgstr ""
"\"척 보면 척입니다, {mf|영주님|영주님|전하|전하}, 민간의 전승지식 수집가를 찾아가시지요. 전 지금 고대의 이야기들을 모으고 "
"있고, 그 사람은 지금 후손들을 위한 현대의 이야기를 모으고 있습니다. 상호 보완해주니, 서로 아귀가 잘 맞지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0005_Text
#. Speaker : Linzi_Companion
msgctxt "7ff7beef-dfb1-4c08-82a3-293b8a77855e"
msgid ""
"\"At first I thought of a local violin player I know. He's always dreamed of "
"traveling around the neighboring lands, playing his music. I also talked to "
"a provincial teacher who is assembling a book of local legends and "
"traditions. And finally, I kept receiving letters from an artist local to "
"the capital – I have no idea why. When we met, she offered me a series of "
"etchings depicting your 'brilliant officers' and the 'great feats' of your "
"army.\""
msgstr ""
"\"처음엔 제가 알고있는 지방의 바이올리니스트를 떠올렸어요. 언제나 이웃 땅을 여행하며, 음악을 연주하길 꿈꾸던 사람이었지요. 또 지방의 "
"전설과 전통에 대한 책을 모으고 있는 어느 선생도 만나봤어요. 그리고 마지막으로, 수도 한 구석에 살고있는 예술가랑 편지를 주고받고 "
"있어요. 저도 왜 거기 사는지는 몰라요. 우리가 만날 때면, '훌륭한 장군'이나 군대의 '뛰어난 재주'를 묘사하는 판화를 여러개 보여주곤 "
"했어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0006_Text
#. Speaker : Jaethal_Companion
msgctxt "56e37bc7-0710-4f66-8eff-4b44c39e7fe4"
msgid ""
"\"The first is a famous local violin player, who wishes to tour our "
"neighbors' lands. The second is a book of local legends and traditions "
"assembled by a provincial teacher. But the most promising is a series of "
"etchings depicting your military campaigns. This artist's love of her "
"motherland... it's most impressive!\""
msgstr ""
"\"첫 번째는 지방의 유명한 바이올리니스트로, 이웃 나라를 여행하고 싶었던 사람이었다. 두 번째는 선생으로, 지방의 전통과 전설담을 "
"수집하고 있었다. 하지만 그 중 가장 유망한 자는 당신의 군사 작전을 묘사한 판화가로, 모국에 대한 그 충성심이 그야말로... "
"인상적이었다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0012_Text
#. Speaker : Linzi_Companion
msgctxt "723a442e-b34f-49cf-bb18-946d809bfe0a"
msgid ""
"\"The violin player I told you about is an old friend. Even the most callous "
"listener is touched by his music! Besides, he has plenty of friends in the "
"{g|River Kingdoms}River Kingdoms{/g}. His concerts will be of the highest "
"standards. They will attract crowds of fans, and every one of them will be "
"grateful to you for giving them the gift of such lovely music.\""
msgstr ""
"\"제가 말씀드린 바이올리니스트는 제 오랜 친구입니다. 음악의 음자도 모르는 사람도 그 친구의 연주를 들으면 감동받지요! 게다가 그 "
"친구는 {g|River Kingdoms}강의 왕국들{/g}내에서도 친구가 많더군요. 그 친구의 공연은 예술적 가치가 높을 것으로 "
"사료됩니다. 팬들도 많이 생길 거고, 모두들 이렇게 아름다운 음악을 선물해준 것에 대해 감사를 표할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0013_Text
#. Speaker : Capital_Collector
msgctxt "70cd1dc1-28cb-47b5-b0ff-c3f2685a66c3"
msgid ""
"\"The violin player's endeavor is commendable. Besides, when people hear his "
"music and learn that you, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}, are the one who made his concerts possible, then they will "
"certainly grant you their favor and respect.\""
msgstr ""
"\"바이올리니스트의 노력은 칭친할만 합니다. 게다가, 그의 음악을 듣고 {mf|영주님|영주님|전하|전하}께서 공연을 열게 해주셨다는 것을 "
"알게 되면, 사람들은 분명 존경과 호의를 보내올 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0014_Text
#. Speaker : Jaethal_Companion
msgctxt "c94fb643-fe3f-46de-9bb1-b8aae9be76af"
msgid ""
"\"A musician wishes to tour around the {g|River Kingdoms}River Kingdoms{/g}. "
"It's not our best option, but it could enhance your image among our more "
"sensitive citizens. The provincial teacher's proposal is the least "
"promising. A book of peasants' superstitions and stories will lead nowhere "
"of interest.\""
msgstr ""
"\"음악가 하나가 {g|River Kingdoms}강의 왕국들{/g}을 여행하고 싶어합니다. 최선의 방법은 아니오나, 감정적인 시민들로부터 "
"좋은 인상을 남길 수 있지 않을가 합니다. 지방 교육자의 제안은 들을 가치가 없습니다. 미신과 동화따위가 담긴 농민의 책은 그 누구도 "
"거들떠보지 않을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0015_Text_String
#. Speaker : Linzi_Companion
msgctxt "bcef325c-b8a6-4b5a-9e72-875fcbae32a2"
msgid ""
"\"What?! Are you saying no to honest artists, and instead giving money to "
"that slippery, cunning weasel? What am I going to tell the others?\""
msgstr ""
"\"뭐?! 정직한 예술가들에게는 아니라는 말 대신 그 약삭빠르고 교활한 족제비같은 놈에게 돈을 주는 거야? 이걸 다른 이들에게 당당히 "
"말할 수 있겠어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0016_Text_String
#. Speaker : Capital_Collector
msgctxt "97326dee-99bd-4585-905e-cc641a72898d"
msgid ""
"\"Soldiers risk their lives every day. That's the reason that art should "
"reflect the true hardships and deprivations of military life. They deserve "
"to know the truth. Our young people might buy their ruler's promises of "
"glory and wealth, but they'll abandon their camps on the eve of battle.\""
msgstr ""
"\"병사들은 매일같이 목숨을 바치며 일합니다. 그렇기에 예술은 군대 생활의 진정한 고난과 필요한 것들을 묘사해야 합니다. 군인들은 진실을 "
"알 권리가 있습니다. 우리 젊은이들은 군주가 약속하는 부와 명예를 믿지만, 전투 직전엔 도망쳐버릴테니 말이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0017_Text
#. Speaker : Jaethal_Companion
msgctxt "aeb055ee-9556-42e6-a8ab-5f21a146eaff"
msgid "\"A fine choice.\""
msgstr "\"좋은 선택입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0018_Text
#. Speaker : Linzi_Companion
msgctxt "e7515794-40dc-4269-a649-b24a4535b739"
msgid "\"Excellent! Let me tell him! He'll be so happy!\""
msgstr "\"훌륭합니다! 그한테 전하겠습니다! 행복해 할 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0019_Text
#. Speaker : Capital_Collector
msgctxt "82e8b877-232e-4b25-be56-bea2038f5387"
msgid ""
"\"I'll discuss with him the details of his tour, {mf|Your Grace|Your Grace|"
"Your Highness|Your Highness}.\""
msgstr "\"순회공연에 대해 그와 상의 해보겠습니다, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0020_Text
#. Speaker : Jaethal_Companion
msgctxt "020a322a-03ed-4d30-beba-8117f7185c50"
msgid "\"Yes, well, that's a fine use of our money...\""
msgstr "\"네, 뭐, 괜찮은 투자입니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0021_Text
#. Speaker : Linzi_Companion
msgctxt "c1e9fe07-ba56-4a6d-9128-8b2d79cf7791"
msgid "\"Hm... I'll hate to upset my friend... But I'm glad for the teacher!\""
msgstr "\"흠... 친구 기분 상하게하긴 싫은데... 그래도 선생은 괜찮죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0022_Text
#. Speaker : Capital_Collector
msgctxt "3134a180-fe01-4265-8ec7-c10f2c3f4fdb"
msgid "\"Very wise, {mf|Your Grace|Your Grace|Your Highness|Your Highness}.\""
msgstr "\"매우 현명하십니다, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0023_Text_String
#. Speaker : Jaethal_Companion
msgctxt "3fa9f45c-e72b-4d33-a018-2caf5a0d32ec"
msgid "\"Wasted money. But I guess it's not up to me.\""
msgstr "\"돈 낭비였군요. 그래도 제 일은 아니니 뭐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0024_Text
#. Speaker : Linzi_Companion
msgctxt "7bc64f35-492e-4768-99bf-58d34ca09fe1"
msgid ""
"\"I'm sure we should support the musician. Your patronage of the arts will "
"make you famous across the {g|River Kingdoms}River Kingdoms{/g}!\""
msgstr ""
"\"우리는 예술가들을 후원해야 합니다. 예술 부분의 후원으로 {g|River Kingdoms}강의 왕국들{/g} 전역에 명성을 퍼뜨릴 수 "
"있을 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0025_Text
#. Speaker : Capital_Collector
msgctxt "508f00c6-b7a6-4360-966a-72fd67feedaf"
msgid ""
"\"First of all, we can send forth our outstanding violin player who wishes "
"to tour the {g|River Kingdoms}River Kingdoms{/g}. Second, there is the "
"provincial teacher collecting the legends, beliefs and traditions of your "
"subjects. As a third option, we can order a series of etchings depicting "
"your army's feats and campaigns.\""
msgstr ""
"\"우선, {g|River Kingdoms}강의 왕국들{/g}을 여행하고자 하는 이 뛰어난 바이올리니스트를 파견할 수 있습니다. 두 "
"번째로, 백성들의 신앙이나 전통, 전설을 수집해대는 지방 교사가 있습니다. 세 번째로, 우리 군대의 재주나 작전에 대해 묘사하는 판화를 "
"주문할 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0026_Text
#. Speaker : Jaethal_Companion
msgctxt "a181cc16-9ce0-4a2a-bd15-9360aa02f88f"
msgid ""
"\"Considering our position, I believe that supporting the artist and her "
"workshop would be most useful. You might print many copies of these "
"etchings, and thus elevate the prestige of military service! Besides, she "
"herself wishes to paint your 'glorious army' and 'remarkable warriors' as "
"faithfully as possible. She said she would not fall victim to the "
"provocations of whiners and cowards.\""
msgstr ""
"\"현 우리의 위치를 보아할 때, 그 예술가와 공방을 지원하는 게 가장 쓸모있어 보입니다. 이 판화를 많이 복제해서 군의 위신을 높일 수 "
"있으니까요! 게다가 이 예술가도 우리의 '영광스러운 군대' 나 '뛰어난 용사' 들을 그리고싶어 합니다. 자기 말로는 겁쟁이나 징징대는 "
"놈들의 도발엔 눈길도 안 줄 거라더군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0027_Text
#. Speaker : Capital_Collector
msgctxt "8837220f-2707-4ca3-8c96-80f31ca2e884"
msgid ""
"\"As to the series of etchings... I may be blind, but even I can see this "
"artist's true, self-serving motives. And I can't say I agree with her desire "
"to glorify the army and the officers' life. Art must reflect life, not "
"distort the truth.\""
msgstr ""
"\"그 판화 말입니다만... 제가 눈이 멀었는지는 몰라도 제 눈엔 이 화가의 진정한, 이기적인 동기를 느껴지더군요. 군인들과 장군들의 "
"삶을 미화하는 그 욕망에 제가 동의할 수는 없을 거 같습니다. 예술은 인생을 투영해야지요. 현실을 왜곡시키는 게 아니라요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0028_Text
#. Speaker : Capital_Collector
msgctxt "5ec890e3-7bec-4708-ba20-379983d04bab"
msgid ""
"\"The legend-gatherer's work seems the most useful, and not only for our "
"descendants. Your subjects, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}, will be proud for their culture. Thus they might dedicate more "
"time and money to its development...\""
msgstr ""
"\"전설 수집가의 작업은 유용해 보입니다. 비단 우리 후손들뿐에게만이 아니라, {mf|영주님의|영주님의|전하의|전하의} 백성들도 자신의 "
"문화를 자랑스레 여길 것입니다. 그렇게 문화를 발전시켜 나가는 것이겠지요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0029_Text
#. Speaker : Linzi_Companion
msgctxt "1b6f4964-9dcb-4e9e-a354-9182142fb848"
msgid ""
"\"The provincial teacher is very naive and sweet, but his innocence only "
"deepens his vision. You should hear him speak of the folk culture of the {g|"
"Stolen Lands}Stolen Lands{/g}! Your subjects will be very proud of their "
"origin and culture after they've read his book.\""
msgstr ""
"\"지역 교사는 무척이나 순진하고 다정하지만, 그 순수함 덕택에 오히려 심려깊군요 . 그 교사가 {g|Stolen Lands}도둑맞은 "
"땅{/g}의 민간 문화에 대해 이야기하는 걸 한 번 들어보시죠 ! 백성들이 그의 책을 읽으면 자신들의 기원과 문화에 대해 자부심을 느낄 "
"것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0030_Text
#. Speaker : Linzi_Companion
msgctxt "adc49019-7d2c-479a-bece-4c1a07468092"
msgid ""
"\"The artist seemed an awful back-scratcher to me. I'm sure she only came up "
"with the military theme to get herself a big order. I hate flatterers and "
"apple-polishers. Especially when it comes to art!\""
msgstr ""
"\"이 예술가는 끔찍한 아첨꾼 같습니다. 확신컨대 비싼 주문을 받으려고 군대 테마를 잡은 것일 겁니다. 저는 아첨꾼과 알랑쇠를 "
"경멸합니다. 특히 예술에서라면 더더욱이요! \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0036_Text
#. Speaker : Linzi_Companion
msgctxt "c8469c27-181b-4248-b1b1-2a50908fb377"
msgid ""
"\"I'll tell the violin player that we'll help him! Oh, he'll be so happy!\""
msgstr "\"우리가 돕겠다고 바이올린 연주자에게 말하겠습니다! 오, 정말 기뻐할 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0037_Text
#. Speaker : Capital_Collector
msgctxt "c1b09c45-f9a4-4ddc-b5fb-c1d694b5a3e9"
msgid "\"Then I'll inform the teacher he can count on our support.\""
msgstr "\"그럼 그 교사에게 우리의 지원을 받을 수 있을 것이라 전하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank4/Cue_0038_Text
#. Speaker : Jaethal_Companion
msgctxt "eb8007e6-995a-4fbf-97ef-c2187a15014c"
msgid ""
"\"I'll order the series of etchings... and see that it's done to our "
"specifications.\""
msgstr "\"판화를 주문하도록 하겠습니다... 효과적일지는 한 번 지켜봐야 할 것 같습니다만.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Answer_0004_Text
msgctxt "c37f1a20-ef86-4bb0-bfdf-9e077fcad06b"
msgid ""
"{g|Culture5_2}[Choice effects]{/g} \"We shall grant this young composer what "
"he asks.\""
msgstr "{g|Culture5_2}[선택 시 효과]{/g} \"이 젊은 작곡가가 바라는 것을 줄 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Answer_0009_Text
msgctxt "9919cda2-1044-41d9-9920-beb6213589cc"
msgid ""
"\"We mustn't interfere with the creative process. Not even if the composer "
"begs us to. Larzio won't live in my castle.\""
msgstr "\"창의성을 발휘하는 일에는 간섭하지 말아야 한다. 작곡가가 해달라고 빌어도 말이다. 라지오는 내 성에 살 수 없을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Answer_0010_Text
msgctxt "410b69eb-9388-439a-831f-e27389156550"
msgid "\"Make your own decision.\""
msgstr "\"알아서 결정하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Answer_0021_Text
msgctxt "3b4a2077-3377-4691-85ce-9bd6cac3f694"
msgid ""
"{g|Culture5_1}[Choice effects]{/g} \"I'm fine with your plan, Jaethal. "
"Assist the composer and see how he's progressing!\""
msgstr ""
"{g|Culture5_1}[선택 시 효과]{/g} \"계획에 찬성한다, 제이탈. 작곡가를 도와 어떻게 해 내는지 한 번 보지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "bcecfd9d-bd09-48f9-bebf-8d053608e066"
msgid ""
"\"It's incredible, {name}! I wish you could see him! How his eyes burn! His "
"soul is so pure! And his mind is so elevated! We should – no, we must help "
"him!"
msgstr ""
"\"믿을수가 없네요, {name}! 당신이 만났으면 하는 사람이 있어요! 그 눈이 어떻게 불타는지! 그 영혼이 얼마나 맑은지! 그 정신이 "
"얼마나 높은 수준인지! 우리가 그를 돕는게 어떨까요? 아니, 도와야만 해요!"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "cc995d2d-3c39-4ec1-a8dd-30089ec133d7"
msgid ""
"\"Greetings, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. "
"Something curious happened yesterday. During my evening promenade, I met a "
"young man. His name is Larzio Messus – a young composer from "
"{g|Absalom}Absalom{/g}. He told me that he left his hometown in the search "
"of inspiration. He's astonished by the story of your ascension to the "
"throne, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. – So "
"impressed, in fact, that he's determined to compose an opera about it.\""
msgstr ""
"\"안녕하십니까, {mf|영주님|영주님|전하|전하}. 어제 뭔가 이상한 일이 있었습니다. 밤 산책 중에, 젊은 사내를 만났습니다. "
"{g|Absalom}압살롬{/g}에서 온 라지오 메수스라고 하는 젊은 작곡가입니다. 그가 말하길 자신은 영감을 찾아 고향을 떠났다고 "
"합니다. 그는 당신이 왕좌에 오른 이야기에 충격받았다고 합니다, {mf|영주님|영주님|전하|전하}. 정확히는 매우 감명받은 것이죠, "
"그래서 그에 대한 오페라를 작곡하기로 마음먹었다고 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "a8ef51ca-d688-43a7-a062-775d38854dc3"
msgid ""
"\"A passionate young composer arrived to the capital quite recently. He's "
"seeking my audience. I am told he's known in {g|Absalom}Absalom{/g} as a "
"bringer of hope. His first pieces were warmly greeted by the critics – "
"especially the dames. He's said to be quite handsome.\""
msgstr ""
"\"최근 수도에 열정에 가득찬 작곡가 하나가 찾아왔습니다. {g|Absalom}압살롬{/g}에서는 희망의 전달자로 잘 알려져 있다고 "
"들었습니다. 그의 초기 작품들은 비평가들에게 따뜻한 환영을 받았습니다. 특히 귀부인들에게 말이죠. 꽤 잘생겼다고 하더라고요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0005_Text
#. Speaker : Linzi_Companion
msgctxt "a26a264e-4e1b-4dd8-aa7c-b6de8af04bf3"
msgid ""
"\"Last night I met a wonderful, glorious young composer from "
"{g|Absalom}Absalom{/g}! His name is Larzio Messus, and he hasn't yet "
"obtained the glory worthy of his talent. I swear on {g|Shelyn}Shelyn's{/g} "
"good graces, he will be famous! He left his home in search of material, and "
"as he traveled in our lands he was astonished by the story of your success.\""
msgstr ""
"\"어젯 밤에 {g|Absalom}압살롬{/g}에서 온 훌륭하고 매력적인 젊은 작곡가를 만났어요! 그 이름은 라지오 메수스로, 자신의 "
"재능에 걸맞는 영예를 아직 얻지 못했죠. {g|Shelyn}셸린{/g}의 자비에 대고 맹세하건데 그는 유명해질 거예요! 영감을 찾아 집을 "
"떠났는데, 우리 땅을 여행하던 중 당신의 성공담에 큰 감명을 받았다고 하더군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0006_Text
#. Speaker : Capital_Collector
msgctxt "2dc630c5-9f23-4d14-9b68-a09e04c58c76"
msgid ""
"\"He's asked for permission to live and work in the palace, so he might draw "
"your character from real life. Nevertheless, I think we should say no. Art "
"must be free!\""
msgstr ""
"\"라지오는 궁에서 살며 작업을 하게 해달라고 요청했습니다. 실생활에서 당신의 모습을 그릴 수 있게 말입니다. 하지만 전 거절해야 한다고 "
"생각합니다. 예술은 자유로워야 하거든요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0007_Text
#. Speaker : Jaethal_Companion
msgctxt "591f09b3-e8ab-43f2-ae5a-0ae096c92eb0"
msgid ""
"\"His name is Larzio Messus, and he needs your protection. He's been looking "
"for fresh material, and he came across the story of your ascension to the "
"throne. He's so impressed that he's dreaming of composing an opera about it. "
"He's young, inexperienced and naive, which makes him even more useful. We "
"should settle him in the palace and give him patronage. I'll answer to all "
"his questions. It won't be difficult to arrange his thoughts in the right "
"order.\""
msgstr ""
"\"그의 이름은 라지오 메수스, 우리의 보호를 필요로 하는 자 입니다. 신선한 소재를 찾다가 권좌에 오른 당신의 이야기를 들었다고 "
"합니다. 어찌나 감명깊었는지 그에 대한 오페라를 작곡한다고 합니다. 그는 젊습니다. 경험 없고 순진하지요. 그래서 더욱 쓸모있습니다. 궁 "
"안에 그를 두고 후원해야 합니다. 그의 질문엔 제가 모두 대답하겠습니다. 그 생각을 바르게 가다듬는 건 그리 어려운 일이 아니니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0011_Text
#. Speaker : Linzi_Companion
msgctxt "f080dcbf-5672-4172-b3f6-e04e955739dc"
msgid ""
"{n}Linzi smiles and claps her hands.{/n} \"I promise, {name}, you won't be "
"sorry for your generosity!\""
msgstr "{n}린지가 웃으며 박수친다.{/n} \"약속할게요, {name}, 그 관대함에 후회하는 일은 없을 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0012_Text_String
#. Speaker : Capital_Collector
msgctxt "55a5301d-70c1-44ca-83ed-f01e67e780ea"
msgid ""
"\"I can't approve of such a decision, but the word of {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness} is the law.\""
msgstr "\"그런 결정은 승인할 수 없지만, {mf|영주님|영주님|전하|전하} 의 말씀은 지엄하시니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0013_Text
#. Speaker : Jaethal_Companion
msgctxt "0fe68296-552f-4661-8748-bc902a752357"
msgid "{n}The elf nods with a hint of a smile on her face.{/n} \"Wonderful.\""
msgstr "{n}엘프는 얼굴에 미소를 머금고 고개를 끄덕인다.{/n} \"훌륭해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0014_Text_String
#. Speaker : Linzi_Companion
msgctxt "6be12770-81db-4746-a2c0-2913b32418eb"
msgid ""
"{n}Linzi's face turns red. She watches you reproachfully.{/n} \"I knew it! "
"Why are you so stubborn...\""
msgstr "{n}린지의 얼굴이 붉어진다. 그녀는 당신을 비난하듯이 쳐다본다.{/n} \"고집불통 같으니...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0015_Text
#. Speaker : Capital_Collector
msgctxt "90d95c48-c2f2-42f4-9d59-697a2bfe8d1f"
msgid ""
"\"Thank you for your trust, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. In due time, we'll see the positive effects that freedom may have "
"on the artist and on his creations.\""
msgstr ""
"\"믿어주셔서 감사합니다, {mf|영주님|영주님|전하|전하}. 곧 자유로움이 예술가와 그 창작물에 끼친 긍정적인 효과를 볼 수 있을 "
"것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0016_Text_String
#. Speaker : Jaethal_Companion
msgctxt "dc5f9376-9fd3-4a8f-8818-e7beaebe62aa"
msgid "{n}Jaethal shrugs indifferently.{/n} \"Another lost opportunity...\""
msgstr "{n}제이탈이 무관심하게 어깨를 으쓱한다.{/n} \"또 기회를 놓쳤군...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0017_Text
#. Speaker : Linzi_Companion
msgctxt "b0c7d303-93a4-4ae5-bc87-f756ec75f293"
msgid ""
"\"There's no two ways about it! Larzio is going to live with us! Oh my, it's "
"going to make him so happy!\""
msgstr "\"방법은 하나뿐이야! 라지오와 함께 살 거야! 아주 기뻐할거라고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0022_Text
#. Speaker : Linzi_Companion
msgctxt "289f1ab7-6c76-4e8f-a70d-b1fa2778c475"
msgid ""
"\"He says he's been dreaming of writing an opera about your adventures! He "
"only wants to live in your palace and compose music, so he can be as close "
"as possible to you and to everyone in your party! I'm sure it's destiny that "
"brought him to our gates. – And destiny will never forgive us if we fail to "
"support this young genius!\""
msgstr ""
"\"라지오가 말하길 당신의 모험에 대한 오페라를 작곡하고 싶다고 합니다! 그가 바라는 것은 오직 궁성에서 머무르며 작곡을 하는 것 "
"뿐입니다. 그래야 당신과 일행의 모든 사람들을 최대한 가까이서 볼 수 있으니까요! 운명이 그를 이곳으로 인도한 것 같습니다. 그리고 이 "
"젊은 천재를 지원하지 않으면 운명은 우릴 결코 용서치도 않을 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0023_Text
#. Speaker : Capital_Collector
msgctxt "85160274-9a62-4bc8-9abd-693b42c6da77"
msgid ""
"\"Living here will make him feel obligated to us. Seeing you every day, "
"he'll lose the dispassionate distance that every artist needs to see his "
"subject clearly! He will hardly understand the virtue of your decision now, "
"but this freedom will do him much good. A flower grown in a greenhouse will "
"wither and perish at the first sign of cold! A weed on the roadside will "
"stand firm through drought and the storm, whatever trial it faces.\""
msgstr ""
"\"여기서 살게 하면 우리에게 종속된 것 처럼 느껴질 뿐입니다. 매일 당신을 바라보게 되면 무릇 모든 예술가가 가져야 할 사물에 대한 "
"중립성을 잃어버리게 되고 말겁니다! 지금 우리의 결정을 그는 이해할 수 없을테지만, 자유로운 몸이 더 좋을 것입니다. 온실에서 자라난 "
"꽃은 추위가 막 다가오면 시들어버리기 마련이지요! 길가의 이삭은 가뭄과 폭풍, 그 외의 모든 시련에도 꿋꿋히 버텨내는 법입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank5/Cue_0024_Text
#. Speaker : Jaethal_Companion
msgctxt "c407182f-32f5-4046-8fb2-a74586e2b223"
msgid ""
"\"His opera will not only preserve your name through the centuries, but also "
"send a message to the peasants of today. They will learn how grateful they "
"must be for your constant efforts, and will have no other thought but to "
"serve their powerful and enlightened ruler. As for me, I won't mind spending "
"time in the young man's company. You know I love to admire all manner of "
"fancy trinkets: flowers, gems, naive and sublime young men...\""
msgstr ""
"\"라지오의 오페라는 당신의 이름을 몇 세기 동안 후세에게 전달할 뿐만 아니라, 오늘날의 백성들에게도 메시지를 전달할 것입니다. 백성들은 "
"당신의 지속적인 노력에 감사해야 한다는 사실을 깨닫고, 이 강력하고 계몽적인 군주 앞에 충성만을 다하겠지요. 저라면 그 젊은이가 함께 "
"사는 걸 개의치 않겠습니다. 전 장신구라면 온갖 종류를 다 좋아하니까요. 꽃, 보석, 순진하고 아름다운 젊은이...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Answer_0008_Text
msgctxt "e80431b9-b197-4c04-ba67-f05902fe9454"
msgid ""
"{g|Culture6_3}[Choice effects]{/g} \"We can't allow unknown agitators "
"undermine the people's respect for authority. I demand this newspaper be "
"shut down, and all political media banned!\""
msgstr ""
"{g|Culture6_3}[선택 시 효과]{/g} \"정부에 대한 사람들의 신뢰를 낮추는 이 이름 모를 선동가를 내버려둬선 안 된다. 이 "
"신문을 없애버리고, 나머지 정치 언론도 모두 없애버려라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Answer_0009_Text
msgctxt "599cd1ea-88f8-492d-b5eb-f9edb4eebfe7"
msgid ""
"{g|Culture6_2}[Choice effects]{/g} \"The River Freedoms guarantee their "
"freedom of speech. We will not interfere.\""
msgstr "{g|Culture6_2}[선택 시 효과]{/g} \"강의 자유는 언론의 자유를 보장한다. 간섭하지 않을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Answer_0010_Text
msgctxt "3dd3d3d0-027e-4b48-bff8-f1018861002a"
msgid "\"You're my advisor. It's up to you to decide how to act.\""
msgstr "\"그대는 나의 보좌관이다. 내가 어떻게 행동할 지는 그대에게 달려있다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Answer_0021_Text
msgctxt "71fdf21f-7fb7-4a28-80bf-fa6266e5c1f9"
msgid ""
"{g|Culture6_1}[Choice effects]{/g} [Pay 2 BP each week] \"We'll meet all "
"their accusations by issuing our own newspaper. It's a good thing we already "
"have a printing press.\""
msgstr ""
"{g|Culture6_1}[선택 시 효과]{/g} [매주 2 BP 지불] \"우리의 신문을 따로 발간해 비난과 맞설 것이다. 이미 "
"인쇄기가 있어서 다행이군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Answer_0031_AlignmentShift.Description
msgctxt "65f9536f-0319-4c48-bfbb-fe5ec07df7f4"
msgid "Ordered the execution of the newspaper publishers."
msgstr "신문 발행인의 사형 집행을 명령했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Answer_0031_Text
msgctxt "861661c0-e60e-4eec-9c8f-fefe71c0f36d"
msgid ""
"{g|Culture6_4}[Choice effects]{/g} \"What is there to explain? Execute the "
"slanderers! Now!\""
msgstr "{g|Culture6_4}[선택 시 효과]{/g} \"뭘 더 설명할 것이 있는가? 저 중상모략자를 처형하라! 어서!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "1640f2a2-7686-4c28-9c43-8979b8ba31b1"
msgid ""
"{n}Linzi's cheeks are burning, and she's raised her voice to nearly "
"yelling.{/n} \"They've gone too far! Just listen! 'Two-handed swords of gold "
"and dragon-skin robes – is this where our taxes go?' What blatant lies! "
"Plus, they're talking about money that isn't even theirs!\""
msgstr ""
"{n}린지의 뺨은 타오르듯 빨갛고, 그녀는 거의 소리지르듯 목소리를 높이고 있다.{/n} \"이건 너무 나갔어요! 들어봐요! '황금 투-"
"핸디드 소드에 드래곤 가죽 로브라니 - 우리 세금은 여기에 다 쓰이는가?' 정말 노골적인 거짓말이네요! 게다가 자기들 돈도 아닌데 이런 "
"얘기를 해대고 있어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "a1c06561-e69c-4153-b0d1-8e717ba58db8"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, I was informed "
"that various political newspapers and leaflets have become very popular "
"amongst your subjects. Many criticize the authorities, and some publish "
"gossip and rumors that might be unpleasant to you personally. However, the "
"very appearance of these things, and their popularity among the people, are "
"signs of the great success we've managed to achieve in education!\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 백성들 사이에서 정치 신문과 전단이 유행하고 있습니다. 국가를 비판하는 이들이 많습니다. 그리고 "
"어떤 이들은 들으면 불쾌할 정도의 낭설을 자아내고 있습니다. 하지만 이런 언론이 생겨나고 사람들에게 유행하기 시작했다는 것은 우리가 "
"교육한 것이 성공적인 결실을 이뤘다는 뜻이기도 합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "4386bd08-eedc-4722-acbe-4687b845b5ae"
msgid ""
"\"Another day, another problem. Political newspapers and leaflets are "
"becoming very popular among your subjects. They're nothing more than nasty "
"rumors and criticism of the authorities.\""
msgstr ""
"\"매일매일, 문제가 새로 생겨납니다. 백성들 사이에서 정치 신문과 전단이 유행하고 있습니다. 그 내용은 국가에 대한 역겨운 소문과 비판 "
"뿐입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0004_Text
#. Speaker : Linzi_Companion
msgctxt "37d5f9b1-cead-449e-a75b-4fe480c4fc52"
msgid ""
"{n}Linzi calms herself and addresses you more formally.{/n} \"Phew. Hello, "
"{name}. I was out shopping for feathers and ink, and I saw a boy "
"distributing newspapers in the market. I read a headline and almost burst "
"with outrage! I even thought of buying one to show you, but I wouldn't want "
"to spend a single coin on the cheeky scriveners!\""
msgstr ""
"{n}린지는 숨을 가다듬고 보다 정중하게 당신에게 이야기한다.{/n} \"휴. 안녕하세요, {name}. 깃털과 잉크를 사러 쇼핑을 "
"나갔는데, 시장에서 신문을 나눠주던 남자아이를 봤어요. 그 머릿기사를 읽었을 땐 거의 분노로 폭발할 뻔 했어요! 하나 더 사서 보여드릴 "
"생각까지 했지 뭐예요. 그래도 그 건방진 작가에겐 돈 한 푼 더 주고싶지 않아서 참았죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "f5ef689d-a62d-40ef-9426-c5ef3641809e"
msgid ""
"\"I don't think we should act. If we try to stop the spread of such "
"newspapers, we'll only be adding fuel to the fire. Leave everything as it is:"
" we'll let them have their discussion, and allow their readers to make up "
"their own minds. My experience shows that only a free society is capable of "
"criticizing and eliminating absurd ideas – more effectively than a thousand "
"censors ever could.\""
msgstr ""
"\"행동해야 한다고 생각하진 않습니다. 그런 신문들의 발간을 막으면, 불에 기름만 붓는 꼴이 될겁니다. 그냥 이대로 내버려둬야 합니다. "
"저들이 논의하게 내버려두고, 독자들이 자기 마음대로 생각하라고 내버려두죠. 경험상 자유로운 사회가 그렇지 않은 곳 보다 몇 천배는 더 "
"그런 헛소리를 묵살시키는 데 효과적이었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0006_Text
#. Speaker : Jaethal_Companion
msgctxt "a0c79ebe-63da-42e3-98f8-bc29fb05c94c"
msgid ""
"{n}The elf is as calm as an iceberg.{/n} \"Your reaction must be swift and "
"severe. As your curator, I advise that you shut down these newspapers, "
"confiscate their printing presses, and arrest everyone involved.\""
msgstr ""
"{n}그 엘프는 얼음장처럼 차갑다.{/n} \"빠르게 결정하되 신중하셔야 합니다. 당신의 학예사로서, 이 신문사들을 발간 금지시키고 "
"인쇄기를 몰수한 다음 관련자들을 모조리 체포하기를 추천합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0011_Text_String
#. Speaker : Linzi_Companion
msgctxt "0acc444c-fc2e-4ff5-9ad4-037eece51455"
msgid ""
"{n}Linzi opens her eyes widely, and then scrunches them up.{/n} \"So that's "
"how it is.\""
msgstr "{n}린지는 눈을 크게 뜨고는, 그 다음 찡그린다.{/n} \"그렇게 된 거였네요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0012_Text_String
#. Speaker : Capital_Collector
msgctxt "77c3eccc-845b-4e06-8ed9-439596acd89f"
msgid ""
"{n}Storyteller's voice is distant and cold.{/n} \"This move may bring a "
"moment's satisfaction, but it may cost you the whole game tomorrow.\""
msgstr "{n}이야기꾼의 목소리는 차갑고 냉정하다.{/n} \"이러면 잠깐은 만족스러울진 몰라도, 후폭풍이 크게 밀려올 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0014_Text
#. Speaker : Linzi_Companion
msgctxt "9b4e145e-11b7-475c-b2eb-946f1bbfb78f"
msgid ""
"\"You might be right. After all, no one can make me read those filthy "
"stories!\""
msgstr "\"당신이 옳은 것 같아요. 여튼, 이런 더러운 소설을 읽을 수는 없어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0015_Text
#. Speaker : Capital_Collector
msgctxt "3c02022e-4583-4695-8a7a-d7edeae1a4ad"
msgid "\"The words of a wise and confident ruler.\""
msgstr "\"현군의 결정이옵니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0016_Text_String
#. Speaker : Jaethal_Companion
msgctxt "39cf98fd-990c-404f-9171-918c54a3ddef"
msgid "\"A very reckless decision. Very well, as you please.\""
msgstr "\"신중하지 못한 결정입니다만. 뭐, 바라신다면.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0017_Text
#. Speaker : Linzi_Companion
msgctxt "56a0562f-e2cc-45c7-82c1-f3cf41005d0b"
msgid ""
"\"We'll... we'll let them publish their idle gossip! We're beyond reacting "
"to it!\""
msgstr "\"이... 쓸모없는 소문을 계속 발간하게 내버려두라! 일일히 신경쓸 필요 없다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0018_Text
#. Speaker : Capital_Collector
msgctxt "566aeea2-742a-45be-9d9f-661b8cda8100"
msgid "\"In this case, we won't respond.\" {n}The blind man smiles gently.{/n}"
msgstr "\"우리는 대응하지 않을 것이오.\" {n}눈먼 사내가 부드럽운 미소를 짓습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0019_Text
#. Speaker : Jaethal_Companion
msgctxt "98f905a6-aa43-41c8-b242-dce9cf05102f"
msgid ""
"\"I'll inform your Warden and bring a squad of guards. All individuals "
"responsible will suffer the consequences.\""
msgstr "\"경비대장에게 알리고 경비대원들을 불러오겠소. 모든 관련자들은 이 일에 책임을 져야할거요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0020_Text
#. Speaker : Linzi_Companion
msgctxt "dbbf97f3-2135-42a9-9a51-90c6bcd60a92"
msgid ""
"{n}Linzi stands for a while, tapping on her chin. She then continues:{/n} "
"\"We shouldn't follow the example of the monarch who would close the "
"newspaper, fire the editorial staff, and burn all the issues... That's "
"exactly the sort of response that would prove to your subjects that all the "
"gossip in those papers is true!\""
msgstr ""
"{n}린지가 턱을 만지면서 잠시 서있습니다.그리고 린지는 말을 잇습니다.:{/n} \" 편집 인원을 자르던가, 모든 주제를 불태우던가 "
"하는 군주의 예시를 따라서는 안돼요. 그 반응이야말로 언론이 말하는 것이 모두 진실이라는 것을 사람들에게 증명할거라구요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0023_Text
#. Speaker : Linzi_Companion
msgctxt "f479a497-4417-41f2-a6a8-25d5f0d100a7"
msgid ""
"{n}Linzi slaps herself on the forehead.{/n} \"Of course, how could I forget! "
"That's the perfect solution, {name}! We'll fight their nasty and distasteful "
"stories with our own truth and beauty! I even know a decent editor...\""
msgstr ""
"{n}린지가 자기 이마를 칩니다.{/n} \"맞아, 어떻게 이걸 잊을 수 있는지! 완벽한 해법이네요, {name}! 우린 역겹고 불쾌한 "
"이야기에 진실과 아름다움으로 맞설 거예요! 괜찮은 편집자도 알고 있다구요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0024_Text_String
#. Speaker : Capital_Collector
msgctxt "76a2751b-faee-4c87-bc44-83378e1fecef"
msgid ""
"\"What would we call it? \"The Royal Times\"? \"The Loyal Herald\"? This "
"will lead nowhere good...\""
msgstr "\"뭐라고 부르죠? \" 로얄 타임스?\"? \"로얄 헤럴드\"? 이건 아닌것 같은데...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0025_Text
#. Speaker : Jaethal_Companion
msgctxt "04f30e6c-9d77-4735-9752-1eb2a0f7120b"
msgid ""
"\"It's not the simplest solution, but it might work. I'll find an editor and "
"start printing our responses. Our circulation will be twice as high as the "
"opposition's.\""
msgstr ""
"\"가장 간단한 해결책은 아니지만 효과가 있을지도 모릅니다. 편집자를 찾아서 회신을 인쇄하겠습니다. 반대파의 두 배에 달하는 부수를 "
"발행할 수 있을겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0032_Text_String
#. Speaker : Linzi_Companion
msgctxt "03f2f431-b62d-489f-884e-d10c4ab44e4a"
msgid ""
"{n}Linzi covers her mouth with her palm and gasps.{/n} \"How... how could "
"you be so cruel?\""
msgstr "{n}린지는 손바닥으로 입을 가리고 숨을 헐떡인다.{/n} \"어떻게... 어떻게 그렇게 잔인할 수가 있나요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0033_Text_String
#. Speaker : Capital_Collector
msgctxt "39fa229a-979c-45c3-974a-b09cac7e97ed"
msgid ""
"{n}The Storyteller sighs.{/n} \"A sad fate awaits those who solve problems "
"with violence. A sad fate for their subjects as well...\""
msgstr ""
"{n}이야기꾼은 한숨을 쉽니다.{/n} \"문제를 폭력으로 해결하려고 하는 자는 슬픈 운명을 맞이합니다. 그 대상 또한 슬픈 운명을 "
"맞이하지요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank6/Cue_0034_Text
#. Speaker : Jaethal_Companion
msgctxt "8a96bd57-7de3-466c-8176-6c838df61f0a"
msgid ""
"{n}Jaethal raises an eyebrow, but immediately nods.{/n} \"It will be done.\""
msgstr "{n}제이탈은 눈썹을 치켜올렸으나, 곧바로 고개를 끄덕였습니다.{/n} \"끝났다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Answer_0008_Text
msgctxt "7c62af5e-0207-443c-ab76-ca1776f312fd"
msgid ""
"{g|Culture7_1}[Choice effects]{/g} \"Art demands sacrifice. By my decree, "
"Larzio Messus shall receive a monthly stipend.\""
msgstr ""
"{g|Culture7_1}[선택 시 효과]{/g} \"예술은 희생을 요구한다. 내 법령에 따라, 라지오 메수스는 매달 봉급을 받을 것이다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Answer_0009_Text
msgctxt "d01ad077-fd2c-4ba0-9e4f-c7aa400631ad"
msgid "\"We shall not sponsor Larzio.\""
msgstr "\"라지오를 후원하지 않을거요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Answer_0010_Text
msgctxt "13a6fdf1-e924-4b92-bebb-efce5b73e66c"
msgid ""
"{g|Culture7_2}[Choice effects]{/g} \"Very well, Jaethal. The Treasurer shall "
"provide you with whatever you require.\""
msgstr "{g|Culture7_2}[선택 시 효과]{/g} \"아주 좋아, 제이탈. 재무관이 필요한 것들을 제공할거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Answer_0021_Text
msgctxt "5e7db199-e111-434c-a04d-57d6bcf26543"
msgid "\"You are my Curator. This choice is up to you.\""
msgstr "\"당신은 내 학예사야. 이 선택은 너에게 맡기지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Answer_0026_Text_String
msgctxt "3913deea-0fa7-4218-b94e-ce317a05fc78"
msgid "\"Larzio should write of commitment to duty. Of loyalty and honor.\""
msgstr "\"라지오는 충성과 명예를 위해 서약서를 써야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Answer_0027_Text_String
msgctxt "dd28d386-7168-4a4d-b787-8f9d59608615"
msgid ""
"\"His opera should show that each of us is the architect of our own fate. "
"Hard work and perseverance lead to success and prosperity.\""
msgstr "\"우리 운명은 우리 스스로가 만든다는 것을 오페라가 보여 줄 겁니다. 성실함과 근면이 성공과 번영으로 이끕니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Answer_0028_Text_String
msgctxt "5e23c35a-618e-4489-8e9e-65cc2a824508"
msgid ""
"\"His work should tackle the all-important question of faith and piety.\""
msgstr "\"그의 작품은 신앙과 신앙이라는 가장 중요한 문제를 다루어야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "44e1ad84-1a98-4372-82b8-66dd65789deb"
msgid ""
"\"{name}, once again I've come to speak about Larzio. He's still writing his "
"opera, and now he's asking us for financial support. Progress goes slower "
"than he hoped, and his funds are running low. But he's shown me some of his "
"manuscripts, and the work is definitely very exciting!\""
msgstr ""
"\"{name}, 다시 한번 라지오에 대해 이야기하러 왔습니다. 여전히 오페라를 쓰는 중이고, 이젠 우리에게 재정 지원을 요구하고 "
"있습니다. 작업 진행상황이 생각보다 늦고, 자금이 바닥을 치고 있어요. 하지만 그가 작업물을 좀 보여줬습니다만, 확실히 흥미롭더군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "735e54d3-61e3-4f09-9ae9-f11868e7b6eb"
msgid ""
"\"I've been approached once more by the young maestro Messus, Your Highness. "
"Despite certain difficulties, he's still hard at work on his opera about "
"your adventures in the Stolen lands. This time he's asked us for financial "
"support. It seems the scant funds he brought from Absalom are running dry. "
"If we don't help him, he'll have to start taking commissions again.\""
msgstr ""
"\"젊은 마에스트로 메수스에게 다시 한번 연락했습니다, 전하. 여러 어려움속에서도, 그는 여전히 당신의 도둑맞은 땅에서의 모험에 대한 "
"오페라를 열심히 쓰고 있습니다. 지금 그는 재정 지원을 요구했습니다. 압살롬에서 가져온 얼마없는 자금이 바닥난 모양입니다. 우리가 돕지 "
"않는다면, 그는 다시 한번 의뢰를 받아야 할 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "b98cdc15-74ce-41cb-b537-84405dbe05b2"
msgid ""
"\"Larzio Messus, the young composer from Absalom, has sought my audience "
"once again. Just as I expected, he's still working on that opera – the tale "
"of your ascension to the throne. He hasn't a single coin to his name, for he "
"has declined all other commissions, to devote himself entirely to his magnum "
"opus.\""
msgstr ""
"\"압살롬에서 온 젊은 작곡가 라지오 메수스가 저를 다시 찾아 왔습니다. 제가 예상했던대로, 오페라 작업을 계속 하는 중이더군요. 당신이 "
"왕좌에 오르는 이야기 말입니다. 그는 빈털터리입니다. 오페라 작업에 온 힘을 쏟기 위해, 그 어떤 의뢰도 받지 않았기 때문이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0004_Text
#. Speaker : Linzi_Companion
msgctxt "13be3879-448c-4e45-8ecb-a25135812b58"
msgid ""
"\"I think we should help him out. He's spent everything he had, and I know "
"he's done his best to support the endeavor on his own. He's still wearing "
"that same holey old shirt he wore on his journey from Absalom, and he's had "
"nothing but bread and water for weeks. Trust me, supporting him means "
"supporting true art at its finest, and you stand to gain a hundred times "
"more than you will lose!\""
msgstr ""
"\"우리가 그를 도와야 한다고 생각합니다. 그는 빈털터리예요, 그가 작업을 위해 최선을 다했다는 걸 알 수 있습니다. 그는 여전히 "
"압살롬에서부터 입고 온 구멍 난 낡은 셔츠를 입고 있어요. 그리고 일주일 동안 빵과 물만 먹고 있고요. 절 믿어주세요, 그를 지원하는건 "
"진정한 예술을 후원하는 겁니다. 지금 잃은 것 보다 수백 배는 더 벌어들일 수 있을 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "dd2f7635-2f0b-4ce7-a58b-feab80300288"
msgid ""
"\"My advice stands — we mustn't interfere with the creative process. A good "
"artist must be able to work on multiple pieces at the same time.\""
msgstr "\"제 조언은 - 창조적인 과정에 간섭해서는 안 되며 훌륭한 예술가는 동시에 여러 작품을 작업할 수 있어야 한다는 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0006_Text
#. Speaker : Jaethal_Companion
msgctxt "249f4e46-d62b-4563-a358-3ccbf951346e"
msgid ""
"\"This gives us the perfect opportunity to gain a decisive influence over "
"him. We should help Larzio — and once he's taken the bait, explain to him "
"that honor demands he listen to his patron's opinion, and make certain… "
"refinements to the opera. The grateful, naive child will be unable to refuse."
"\""
msgstr ""
"\"이로 인해 그가 결정을 내릴 때 우리가 개입할 수도 있을 겁니다. 라지오를 도와야 합니다. 그가 미끼를 물면, 명예를 위해서 후원자의 "
"의견을 들어야한다고 설명해주십시오. 그리고 한 가지는 확실히 해야 합니다... 오페라에 우리가 개입할 수 있다는 사실을. 순진하고 은혜를 "
"입은 그 아이라면 거절하지 못하겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0011_Text
#. Speaker : Linzi_Companion
msgctxt "d89c4e68-db85-46b7-a4f5-4ce538c76d61"
msgid ""
"\"Oh, right, and one more thing… He wanted me to ask you: what should he pay "
"the most attention to as he writes? What message should he convey to the "
"listener?\""
msgstr ""
"\"아 그리고, 한가지 더 질문할 게 있습니다: 글을 쓸 때 가장 관심을 기울여야 할 것은 무엇입니까? 청중에게 어떤 메시지를 전해야 "
"합니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0017_Text_String
#. Speaker : Linzi_Companion
msgctxt "3a7ecac0-53dc-4b98-abf8-93e72cbd7444"
msgid ""
"\"Dreadful. Just… dreadful. Why's it always me who has to deliver the bad "
"news?\""
msgstr "\"정말... 끔찍하군. 왜 항상 나쁜 소식을 전하는 건 나지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0018_Text_String
#. Speaker : Capital_Collector
msgctxt "fa2da18d-00fa-4477-a1b8-f2ba5dcb07ef"
msgid ""
"\"How unfortunate.\" {n}After a short silence, the old man continues in a "
"melancholic tone:{/n} \"Well, since this can no longer be considered "
"independent art, I shall pass on another of the young maestro's requests: he "
"wishes to know what themes you would like to see addressed. Do you have a "
"specific lesson you'd like to share with the audience?\""
msgstr ""
"\"안타깝습니다.\" {n}잠시 정적이 흐르고, 노인은 우울한 말투로 이어갔다.:{/n} \"이미 이건 독립적인 예술이라고 간주 될 수 "
"없기 때문에, 나는 다른 젋은 마에스트로의 요구를 넘길 것입니다..: 그는 어떤 주제를 당신이 다루길 원하는 가를 알고 싶어합니다. "
"관객들과 함께 나누고 싶은 특별한 교훈이 있습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0019_Text_String
#. Speaker : Jaethal_Companion
msgctxt "8890ff77-6cb4-4d84-a203-ac5ae5c4d8ea"
msgid ""
"\"As you wish. Do not be surprised, however, when this opera casts you in a "
"much different light than you'd prefer.\""
msgstr "\"당신이 바라는 대로. 하지만 오페라가 당신이 원하는 것과 다른 것을 비추게 되더라도, 놀라지 마십시요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0020_Text
#. Speaker : Jaethal_Companion
msgctxt "0be7aa8e-441f-4c31-9541-27f83650fa2f"
msgid ""
"\"Tell me, {name}, what should I turn our young friend's attention to? What "
"should he always keep in mind while he is writing?\""
msgstr ""
"\"제게 말해 주십시요, {name}, 젋은 우리 친구의 생각을 어떻게 해야 할까요? 그가 글을 쓸 때 무엇을 항상 염두하도록 해야 "
"할까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0022_Text
#. Speaker : Linzi_Companion
msgctxt "a146bf66-4ba3-47fb-8cb6-6afea3b644b9"
msgid ""
"\"Thank you, {name}, thank you so much! I shall go at once to tell Larzio "
"that all his troubles are behind him!\""
msgstr "\"고맙습니다, {name}, 정말 고맙습니다! 당장 라지오에게 가서 모든 문제가 해결 됐다고 말하겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0023_Text
#. Speaker : Capital_Collector
msgctxt "4bb18731-2b8b-44a5-8872-155020e0443e"
msgid ""
"{n}The Storyteller nods.{/n} \"I shall inform the young man that he'll have "
"to rely on himself to overcome these obstacles.\""
msgstr "{n}이야기꾼은 고개를 끄덕인다.{/n} \"모든 문제는 자기 스스로 극복해야 한다고 젊은이에게 전하도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0024_Text
#. Speaker : Jaethal_Companion
msgctxt "9f587a03-c2a1-40ab-bfd7-e4f25ba1f266"
msgid ""
"\"Larzio shall have everything his heart desires… and only later will he "
"have to pay for it.\""
msgstr "\"라지오는 원하는 바룰 이룰 것입니다... 그리고 나중에 그 대가를 치르겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0031_Text
#. Speaker : Capital_Collector
msgctxt "f5949202-9318-4874-99b9-3440112d3917"
msgid "\"It shall be as you say, Your Highness.\""
msgstr "\"명하신 대로 하겠습니다, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank7/Cue_0037_Text
#. Speaker : Jaethal_Companion
msgctxt "35a14444-dedf-4de7-b298-6b668cd15515"
msgid ""
"\"I bring amusing news of Larzio Messus, the young composer from Absalom "
"that I've been watching over. He met me yesterday, and by turns he informed "
"me that he's up to his neck in debt. His friends lead a most lavish "
"lifestyle, and at first he was simply too sapless to let himself fall back — "
"and now he simply cannot imagine living any differently. Of course, it was "
"none other than I who introduced him to these rakes...\""
msgstr ""
"\"제가 쭉 지켜봤던 압살롬에서 온 젋은 작곡가, 라지오 메수스에 대한 놀라운 소식이 있습니다. 저랑 어제 만났고, 뒤이어 그가 빚에 "
"허덕인다고 말하더군요. 친구들이 호화롭게 사는데, 그에 발맞춰 살아가지 않을 수 없었다고 합니다. 그리고 이제 다른 삶을 사는 것을 "
"상상조차 할 수 없다더군요. 물론, 이 난봉꾼들에게 그를 소개한 사람은 다름아닌 저입니다만...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Answer_0008_Text
msgctxt "6747ac4c-fbb5-4e7e-8040-c1df0e46cc84"
msgid ""
"{g|Culture8_1}[Choice effects]{/g} [Pay 200 BP] \"We cannot stop progress, "
"so we must champion it. I order the treasury to release the necessary funds "
"for the foundation of the Crown's University.\""
msgstr ""
"{g|Culture8_1}[선택 시 효과]{/g} [200 BP 지불] \"진보는 막을 수 없고, 이를 받아들여야 한다. 재무부에 왕실 "
"대학 설립 자금 확보를 명한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Answer_0009_Text
msgctxt "2dae9514-6a33-4ddd-bcd6-9e8daf94a187"
msgid "\"The kingdom cannot afford it. We won't be opening a university.\""
msgstr "\"왕국은 그럴 여유가 없소. 대학을 열지 않을 거요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Answer_0027_Text
msgctxt "52c4bf93-d3c5-4aa0-b12f-ae0974070d85"
msgid ""
"{g|Culture8_4}[Choice effects]{/g} [Pay 2 BP each week] \"I order the "
"Treasurer to provide everything necessary for the development of a school of "
"enlightenment.\""
msgstr ""
"{g|Culture8_4}[선택 시 효과]{/g} [매주 2 BP 손실] \"재무관에게 학교 발전에 필요한 모든 것을 지원하도록 명하겠소."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Answer_0028_Text
msgctxt "79fa872c-69f2-4a41-b18a-2c55c6da5c0b"
msgid ""
"{g|Culture8_5}[Choice effects]{/g} \"We cannot allow troublemakers to "
"disrupt the peace. The school will be closed on my authority.\""
msgstr ""
"{g|Culture8_5}[선택 시 효과]{/g} \"분란을 일으키는 자들이 평화를 어지럽히는 것을 용납할 수 없소. 내 권한으로 학교를 "
"폐쇄할거요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Answer_0029_AlignmentShift.Description
msgctxt "e8549d44-3196-4dda-ac67-5e677ff9be63"
msgid "Ordered the school closed, and its organizers executed."
msgstr "학교는 문을 닫았으며, 주최자들은 처형되었습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Answer_0029_Text
msgctxt "34004a81-5fe2-4e8f-ac23-126f610e4e00"
msgid ""
"{g|Culture8_6}[Choice effects]{/g} \"Shut down the school immediately. – And "
"execute the organizers.\""
msgstr "{g|Culture8_6}[선택 시 효과]{/g} \"학교를 당장 멈추시오. – 그리고 설립자들을 모두 처형하시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Answer_0048_Text
msgctxt "7cc8ea22-8be6-4287-93c0-87621fc757ce"
msgid "{g|Culture8_3}[Choice effects]{/g} \"I will heed your advice.\""
msgstr "{g|Culture8_3}[선택 시 효과]{/g} \"당신의 충고에 유의하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Answer_0049_Text
msgctxt "c83ce6c2-f51a-4c21-a46c-1570079f6eba"
msgid "\"Make your own decision.\""
msgstr "\"스스로 결정하십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "89b550fa-918a-4270-b5af-2a9e9a28d4e1"
msgid ""
"\"I don't know if you've noticed, {name}, but the kingdom's people have "
"become much more educated. The schools we helped found are now full of "
"children, and there are plenty of young people that thirst for knowledge and "
"wish to dedicate themselves to science. So, here's what I thought: why not "
"found a university?\""
msgstr ""
"\"알고 계신지 모르겠습니다만, {name}, 왕국 사람들은 굉장히 교육받았습니다. 우리가 설립을 도왔던 학교는 어린이들로 가득찼습니다, "
"또한 지식을 갈구하고 과학에 헌신하고자 하는 젊은이들이 넘쳐납니다. 그래서 제가 생각했습니다. 대학을 설립하는 것은 어떨까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "df921ff8-1666-40d1-826e-60ca1de5b2e6"
msgid ""
"\"Greetings, Your Highness. I wanted to inform you that our efforts to open "
"schools have paid off immensely. The literacy level of your people is "
"growing throughout the kingdom, and there's hardly any family whose children "
"aren't learning to read, write and count. Thus I wanted to propose a next "
"step – to open a university in the capital.\""
msgstr ""
"\"안녕하십니까, 전하. 학교 설립을 위한 우리의 노력이 매우 큰 성과를 거뒀음을 알리고 싶습니다. 왕국 백성들의 읽기 쓰기 수준이 "
"계속해서 올라가고 있습니다. 그리고 읽고, 쓰고, 셈할 줄 모르는 어린이들이 매우 적습니다. 따라서 다음 단계를 제안하고 싶습니다. 바로 "
"수도에 대학을 여는 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "21952e74-625b-4059-a845-51eae062d38c"
msgid ""
"\"The ill-advised whim to open schools for the riff-raff has finally borne "
"its fruit. Yesterday we received a petition: the teachers of the capital ask "
"that we found a university.\""
msgstr ""
"\"무분별한 변덕으로 천민들을 위해 학교를 열었던 것이 결실을 이뤘군요. 어제 청원을 하나 받았습니다. 수도의 교사들이 대학을 "
"설립해달라더군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0004_Text
#. Speaker : Linzi_Companion
msgctxt "2f79a8fc-2c27-4cbd-9312-66a308ef84a1"
msgid ""
"\"Just imagine, learned men and women from all around the world shall flock "
"to our {mf|barony|barony|kingdom|kingdom}! And they'll bring books! And "
"magic scrolls, and recipes for new potions… And maybe someday they'll open a "
"school of philosophy, or maybe we'll have great alchemists! — And your "
"neighbors would be green with envy...\""
msgstr ""
"\"상상해보세요. 전 세계 지식인이 우리 {mf|남작령|남작령|왕국|왕국}을 찾을 거예요! 자기 책도 가져오겠죠! 마법 스크롤이나 새로운 "
"포션 제조법도 가져올 거고요... 자기 이름을 내건 교습소를 열고, 그러면... 연금술사 위인이 탄생할지도 모르겠네요! 다른 나라에서 "
"엄청 질투하겠다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "fc71604d-4f60-49e2-9c2c-238aab49381c"
msgid ""
"\"The influx of learned men and women from all around Avistan will surely be "
"a boon for trade. Our scientists will require books, magic scrolls, "
"alchemical reagents and potions. Our kingdom's prestige will rise in the "
"eyes of our neighbors. I believe this endeavor will bring nothing but good "
"fortune to our lands. Although many rulers fear the free thinking that "
"breeds in universities, it is well to remember that free thought is only "
"ever a threat to tyrants.\""
msgstr ""
"\"온 아비스탄에서 몰려온 지식인이라. 분명 교역 호재로 작용하겠지요. 연구가는 책과 마법 스크롤, 연금술 시약, 포션을 입수할 수 있을 "
"테고요. 많은 이들이 우리 왕국을 선망할 겁니다. 왕국도 부강해지겠지요. 좋지 않은 결과를 상상하기가 어렵군요. 하지만 폭군의 유일한 "
"적은 자유 의지라는 점을 기억해두십시오. 지식인 대학을 설립하면 그곳은 자유사상의 온상이 될 테니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0006_Text
#. Speaker : Jaethal_Companion
msgctxt "a7e93f71-6174-401b-a646-875bcc8e129f"
msgid ""
"\"As if the extraordinary cost weren't enough, this endeavor would work "
"directly against our own interests. Universities are a hotbed of dangerous "
"free thought, and naturally breed mistrust of any powers that be. From "
"there, this plague spreads to all of society. No economic or diplomatic "
"benefits could ever justify this. Clearly, we must refuse this petition.\""
msgstr ""
"\"이례적인 비용은 차지하더라도, 대학은 우리에게 전혀 득이 되지 않아. 대학에는 자유사상이라는 위험이 도사리고 있지. 소위 지식인이라는 "
"자들은 권력을 우습게 봐. 그런 사상이 왕국에 질병처럼 퍼질 텐데 거기에 무슨 경제적, 외교적 이득이 있을까. 이 청원은 반드시 기각해야 "
"해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0011_Text
#. Speaker : Linzi_Companion
msgctxt "5a98b4ae-cd6e-45cf-b4cb-076ae7a19533"
msgid ""
"\"Well said! I will get to work immediately. Ha! If only the crosspatches "
"that threw me out of the Academy could see me now!\""
msgstr "\"말 잘 하셨습니다! 즉시 착수하도록 하지요. 하! 절 쫓아냈던 까탈스러운 학술원 놈들이 지금 이 장면을 봤어야 했는데!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0012_Text
#. Speaker : Capital_Collector
msgctxt "1030c774-3ebb-4fc5-bc9a-8790c81dadf8"
msgid ""
"\"This is an investment in spirit itself. It will pay off much sooner than "
"you think, and will continue to bear fruit long after we've all returned to "
"dust.\""
msgstr ""
"\"이는 정신 그 자체를 위한 투자입니다. 생각한 것 보다 더 빨리 성과가 있을 것이며, 우리가 죽고 난 뒤에도 그 결실은 거둘 수 있을 "
"것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0013_Text_String
#. Speaker : Jaethal_Companion
msgctxt "2e1def63-f575-405a-80c7-0f8d0ec2078f"
msgid ""
"{n}The Inquisitor raises an eyebrow.{/n} \"Do you actually imagine that you "
"are doing the kingdom a favor? You are simply pushing it closer to anarchy "
"and lawlessness. Consider Galt, and you will see what I mean.\""
msgstr ""
"{n}이단심문관은 눈썹 한 쪽을 들어올렸다.{/n} \"이게 뭐 하는 짓입니까? 이건 그냥 난장판과 무법에 가까워지는 것일 뿐입니다. "
"갈트를 생각하십시오. 제 말이 무슨 뜻인 지 아실 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0015_Text_String
#. Speaker : Capital_Collector
msgctxt "54c187bf-c110-40a3-96d3-f7c99c08d40b"
msgid ""
"{n}The Storyteller's face is serene, but a note of sadness can be heard in "
"his voice.{/n} \"Unwise.\""
msgstr "{n}이야기꾼의 얼굴은 평온하지만, 그의 목소리에선 비통함을 감출 수 없었다.{/n} \"현명하지 못한 일입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0016_Text
#. Speaker : Jaethal_Companion
msgctxt "54a59c42-336d-441d-86f7-6fa2c1d44b67"
msgid "\"You've made the right choice.\""
msgstr "\"옳은 선택을 하시는 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0017_Text_String
#. Speaker : Linzi_Companion
msgctxt "54762606-6f47-45e2-8895-7bd5a90231a4"
msgid ""
"\"What a shame! Oh, what a shame… We're missing out on a truly wonderful "
"opportunity.\""
msgstr "\"이럴 수가! 아, 이럴 수가... 진정으로 멋진 기회를 날려버렸군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0020_Text
#. Speaker : Linzi_Companion
msgctxt "92aedbcd-78ad-4283-a975-af5c4c185395"
msgid ""
"\"Oh, {name}! We should have founded schools while we could! Now, others are "
"doing it for us. Followers of Irori have opened one of their schools of "
"enlightenment in the capital, and they're holding open debates. Today's "
"topic of discussion — the successfulness of the {mf|King|Queen} and "
"{mf|his|her} government!\""
msgstr ""
"\"아, {name}! 학교를 열 수 있을 때 열어야 했어! 이젠 다른 사람들이 열고 있어. 이로리의 신자들이 수도에서 교육을 위한 "
"학교를 열었어. 지금 열린 토론을 하고 있지. 오늘의 논의 주제는 '{mf|왕|여왕} 과 {mf|그|그} 내각은 성공했는가?' 라더군!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0021_Text
#. Speaker : Capital_Collector
msgctxt "651dbfab-5be0-487e-99a3-da7202024e29"
msgid ""
"\"An opportunity that passed us by has been taken up by another. The "
"followers of Irori have opened the first school in the capital — a school of "
"enlightenment. They are now holding open debates. Participants are "
"discussing whether or not the rulers of this land are a success.\""
msgstr ""
"\"우리가 놓친 기회를 다른 사람이 채갔군요. 이로리의 신자들이 수도에 첫 번째 학교를 열었습니다. 계몽을 위한 학교를요. 지금 열린 "
"토론을 하고 있더군요. 참가자들은 이 땅의 군주가 성공적으로 통치했는지 아닌지를 토론하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0022_Text
#. Speaker : Jaethal_Companion
msgctxt "c904e4be-ca25-4c1b-b10e-88cccebef128"
msgid ""
"\"Not long ago, we maintained peace in the kingdom by keeping the peasants "
"ignorant and content. Now a school has been founded in the capital, a school "
"of enlightenment. It was founded by the followers of Irori, and even now, "
"open debates on the failure of your government are being held there.\""
msgstr ""
"\"얼마 전 까지만 해도, 백성들이 무지하고 자족하는 것으로 평화를 유지할 수 있었는데. 이제 수도에 계몽을 위한 학교가 세워졌어. "
"이로리의 신자들에 의해 세워졌고, 지금도 정부의 성공을 논하는 토론이 이루어지고 있지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0023_Text
#. Speaker : Jaethal_Companion
msgctxt "6c905935-4a81-48ac-a539-9385f80f9b2f"
msgid ""
"\"Every day, disloyal citizens corrupt your nation like a rotting limb. We "
"must strike now, and without remorse. The participants in these debates must "
"be dispersed. And as for their initiators… The organizers of the debates "
"should pay with their lives. Let it be known across the kingdom that those "
"who challenge the throne do not have long to live.\""
msgstr ""
"\"매일마다, 불충한 시민들이 썩어가는 가지처럼 국가를 좀먹고 있습니다. 자비 없이 이들을 제거해야 합니다. 이 토론자들을 해산시켜야 "
"합니다. 그리고 발의자들은... 이 토론을 조직한 토론자들은 목숨을 거둬야 합니다. 옥좌에 도전하는 자는 오래 살지 못할 것임을 "
"일깨워주시지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0024_Text
#. Speaker : Capital_Collector
msgctxt "d1e31997-81f9-44ff-aeba-8273c6df0b3a"
msgid ""
"\"In my opinion, we should neither shut down the school nor sponsor it, as "
"the townsfolk might simply consider sponsorship another form of bribery – "
"and would they be so wrong? Instead, with your permission, I would like to "
"take part in the debates. Not as a contender, but rather perhaps as an "
"observer and commentator. Our subjects will get an opportunity to voice "
"their worries and fears, while we will be able to explain our positions.\""
msgstr ""
"\"제 소견으로는, 학교를 닫지도, 지원하지도 말아야 한다고 생각합니다. 시민들이 지원금을 일종의 뇌물이라고 생각할지도 모르니까요. 그리 "
"틀린 말도 아니지 않습니까? 대신, 허락 해주신다면 토론에 참여하고 싶습니다. 직접적으로 토의를 한다기 보다는 관전자 및 논평가로서요. "
"현 상황에 대해 충분히 설명해줄 수 있는 상황이지만 신하들도 자신들의 걱정이나 두려움에 대해 이야기할 수는 있어야 하니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0025_Text
#. Speaker : Linzi_Companion
msgctxt "bae017ab-9419-4da7-84c6-e0f3025335db"
msgid ""
"\"Doubtless, a more pleasant topic could have been chosen... But we mustn't "
"respond with arrests and repression of free speech! Let the people speak "
"their minds. It could even be in our best interests to support these "
"debates, and the school itself. It would certainly help our reputation!\""
msgstr ""
"\"더 나은 주제를 선택할 수도 있었을 텐데... 하지만 그렇다고 이 자유 연설을 체포와 억압으로 대해선 안 됩니다. 사람들이 자기 마음 "
"속에 있던 말들을 꺼내게 내버려둡시다. 이런 토론과 학교 자체는 분명 이득이 될 겁니다. 우리의 평판을 높여줄 테니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0030_Text
#. Speaker : Linzi_Companion
msgctxt "a6b0acf5-6c47-47a9-b8f6-69eaffb147b0"
msgid "\"That's right! We have nothing to fear.\""
msgstr "\"바로 그렇다! 우린 두려울 것이 없지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0031_Text
#. Speaker : Capital_Collector
msgctxt "6ffe2f4b-04ae-4638-a534-0187a0281314"
msgid ""
"{n} The Storyteller smiles at you.{/n} \"Long ago, I spoke with much passion "
"about politics and matters of rule. Many of the youth thought quite highly "
"of my speeches — perhaps, too highly… Let us see if there's anything left of "
"that youthful zeal in me.\""
msgstr ""
"{n}이야기꾼이 당신에게 미소짓는다.{/n} \"옛날엔 저도 정치나 통치학에 대한 것이라면 보다 열정적으로 임했었지요. 많은 젊은이들도 "
"제 연설을 높이 평가했고요. 좀 지나치게 높게 평가한 감이 있긴 하지만... 그런 청년기의 열정이 아직 제 안에 남아있는지 한 번 "
"확인해보고 싶습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0032_Text_String
#. Speaker : Jaethal_Companion
msgctxt "a4ffecfd-cd62-4aa2-bbbb-37912b2e29eb"
msgid ""
"{n}Jaethal shakes her head.{/n} \"First they think, then they talk, and then "
"they begin to act. Foolish.\""
msgstr ""
"{n}제이탈은 머리를 흔들었다.{/n} \"처음엔 생각만 하지만, 다음으로는 말 할 것이며, 결국엔 행동에 착수할 것이다. 바보같긴.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0033_Text_String
#. Speaker : Linzi_Companion
msgctxt "8d8bf11f-4ddf-4ef3-8da6-5d1ef2502262"
msgid ""
"{n}Linzi's shoulders sink. She speaks quietly, without addressing anyone in "
"particular:{/n} \"Sometimes I feel like I never left Pitax…\""
msgstr "{n}린지의 어깨가 축 쳐졌다. 그녀는 조용히, 혼자 되뇌였다.{/n} \"가끔은 피탁스를 떠나지 말 걸 그랬어요…\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0034_Text
#. Speaker : Capital_Collector
msgctxt "4cffebb6-1e69-47a9-b906-9223f4093e70"
msgid "\"I see… Such is your right, Your Highness.\""
msgstr "\"알겠습니다… 전하가 그러시겠다면.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0035_Text
#. Speaker : Jaethal_Companion
msgctxt "32543a99-1c4d-4826-ad1b-31d08fbebc09"
msgid "\"It won't be enough. Still, it's better than nothing.\""
msgstr "\"충분하지 않을 겁니다. 그래도, 아예 없는 것 보단 낫겠죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0036_Text_String
#. Speaker : Linzi_Companion
msgctxt "62d65f04-b137-469f-a4e4-35c7a341ae97"
msgid "{n}Linzi turns pale as a sheet.{/n}\"Such… cruelty. Why…\""
msgstr "{n}린지는 백지처럼 새하얕게 질렸다.{/n}\"그렇게… 잔혹하다니. 어째서…\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0037_Text_String
#. Speaker : Capital_Collector
msgctxt "55eadf1f-9e59-4ad7-ad54-ead4ea9fd460"
msgid ""
"{n} At length, the Storyteller falls silent, and his hands hang loose at his "
"side. The elderly figure looks particularly fragile in the failing light of "
"the throne room.{/n}"
msgstr ""
"{n} 한참 후, 이야기꾼은 침묵을 고수하며 손을 떨어뜨렸다. 꺼져가는 옥좌의 불빛 앞에 그 노인의 모습은 너무나도 연약해보였다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0038_Text
#. Speaker : Jaethal_Companion
msgctxt "1ff9fa9f-1946-41bb-b33c-c40e3c2fd0b5"
msgid "\"Excellent. They shall be dealt with.\""
msgstr "\"멋집니다. 그렇게 하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank8/Cue_0050_Text
#. Speaker : Linzi_Companion
msgctxt "c956defb-8899-469f-aa92-29f6ba459594"
msgid ""
"\"We'll support the school. Let's show our critics how generous and open-"
"minded we are!\""
msgstr "\"학교를 지원하겠습니다. 우리 비평가들에게 우리가 얼마나 관대하고 열려있는지 보여주도록 하지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Answer_0008_Text
msgctxt "23967804-53b3-4f76-905c-3aae5473c74c"
msgid ""
"{g|Culture9_1}[Choice effects]{/g} [Pay 200 BP] \"There's no time to waste, "
"Jaethal. Give Larzio a sense of just how much he owes us.\""
msgstr ""
"{g|Culture9_1}[선택 시 효과]{/g} [200 BP 지불] \"낭비할 시간이 없다, 제이탈. 라지오가 미안해 할 정도로 "
"지원해주도록 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Answer_0009_Text
msgctxt "c2745c65-695f-4f49-8c8c-f96b3b1b0a03"
msgid ""
"{g|Culture9_2}[Choice effects]{/g} [Pay 100 BP] \"Larzio may build his stage "
"upon the main square. And his production shall be funded as well.\""
msgstr ""
"{g|Culture9_2}[선택 시 효과]{/g} [100 BP 지불] \"라지오가 광장에서 무대를 짓게 허락하라. 제작비도 지원될 "
"것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Answer_0010_Text
msgctxt "a34cb810-31d0-4f20-b550-9e88a93455c2"
msgid ""
"{g|Culture9_3}[Choice effects]{/g} [Pay 50 BP] \"The composer is free to use "
"the main square as he pleases. Nothing more, nothing less.\""
msgstr ""
"{g|Culture9_3}[선택 시 효과]{/g} [50 BP 지불] \"원한다면 광장을 마음대로 사용하도록 허락하겠다. 딱 그 만큼만 "
"지원할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Answer_0023_Text
msgctxt "c11b2c74-670e-4a96-afa5-6536b7957ee4"
msgid "\"Larzio will have to find his own stage. We shall not help him.\""
msgstr "\"라지오더러 무대는 알아서 찾으라고 하라. 도움은 없을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Answer_0027_Text
msgctxt "e41a33cf-025b-4290-9008-651312852e34"
msgid "\"Make your own decision.\""
msgstr "\"알아서 결정하도록 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "fa6795e4-7aea-4339-9f60-11d277eb1669"
msgid ""
"\"{name}, I bring wonderful news: Larzio Messus has finally finished his "
"opera! All that's left is to direct and stage it!\""
msgstr ""
"\"{name}, 멋진 소식을 들고왔어요. 라지오 메수스가 오페라 작곡을 끝마쳤다고 해요! 이제 남은 건 바로 공연하는 것 뿐이에요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0002_Text
#. Speaker : Linzi_Companion
msgctxt "419b7f88-6838-4f21-b3f1-4a8ea45127e9"
msgid ""
"\"We could help him find a venue — for example, we could let him use the "
"main square! That alone would already solve a lot of his problems. But it "
"would be even better if we funded the production! He's already found all the "
"singers and has an orchestra ready to perform, but he cannot afford any "
"spectacle. — The colors, the costumes, the decorations...\""
msgstr ""
"\"적당한 장소를 찾도록 도와줘야 해요. 예를 들면 주 광장을 사용하게 하든가 말이죠! 그것만으로도 라지오가 가진 문제 대부분이 해결될 "
"거예요. 우리가 제작비를 지원해준다면 더 좋겠지만 말이죠! 라지오는 이미 가수를 초청해서 오페라를 열 준비를 마쳤지만, 그 외에는 돈이 "
"없다고 하더라고요. 깃발이라던가, 옷이라던가, 장식이라던가...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0003_Text
#. Speaker : Capital_Collector
msgctxt "9ea3261e-b1bf-4215-99fe-3cc087564f30"
msgid ""
"\"I bring news from Larzio Messus, Your Highness. Despite all his "
"difficulties, he was able to finish his opera. He has already found singers "
"and an orchestra — all he lacks now is a stage. I am, however, sad to inform "
"you that he's also been taken ill. He's suffering from consumption, and this "
"may well be his final request...\""
msgstr ""
"\"라지오 메수스의 소식을 들고왔습니다, 전하. 어려움이 많았지만 오페라 작곡을 마칠 수 있었다고 합니다. 이미 가수와 합주자들은 "
"구해놨지만, 무대가 없다고 하더군요. 이런 말씀 드리기 황송하오나, 라지오가 병에도 걸렸다고 합니다. 폐결핵으로 고통받고 있다고 하는데, "
"이번이 그의 마지막 요청이 되지 않을까 싶습니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0004_Text
#. Speaker : Capital_Collector
msgctxt "cc925132-828e-4a88-8b8b-78c729d2210b"
msgid ""
"\"I believe we should help him this time. — Not in everything, of course. By "
"if we allow him to set up his stage on the main square, we would allow his "
"opera to gather the audience it deserves, without influencing its substance "
"in any way. However, I would advise against funding the production, Your "
"Highness. Theatrics only distract the viewer from the true meaning of what "
"is happening on the stage.\""
msgstr ""
"\"이번에는 라지오를 도와야하지 싶습니다. 물론 전부 다 돕지는 말아야지요. 주 광장에서 무대를 세우는 걸 허락하면, 그에 맞는 관객들이 "
"모일 것입니다. 이른바 격이 맞는 사람들이 올 것이라 이 말이지요. 하지만 제작비는 지원하지 말아야 한다고 생각합니다, 전하. 쓸모없는 "
"치레만 가득하면 무대가 보여주는 진정한 의미가 오도될 수 있기 때문이지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0005_Text
#. Speaker : Jaethal_Companion
msgctxt "c8d07208-6ebc-476e-8c8a-6e00a7a58b69"
msgid ""
"\"Astounding. Despite everything he's endured, Larzio Messus has finished "
"his opera! He's even found the singers and an orchestra, but is now confined "
"to his bed, suffering from consumption. He has asked that you find him a "
"stage. His condition grows worse by the day. — It may well be that this is "
"his last request... and our last opportunity to influence the result of his "
"work.\""
msgstr ""
"\"경악스럽군요. 그 엄청난 감내 끝에 라지오 메수스가 마침내 오페라 작곡을 마쳤다고 합니다! 게다가 합주자와 가수까지 초청했다고는 "
"하는데, 안타까운 사실은 그가 폐결핵으로 고통받고 있다는 겁니다. 우리더러 무대를 마련해달라고 하더군요. 매일 상태가 나빠지고 있습니다. "
"아마 이게 마지막 부탁이 되지 않을까 합니다... 그리고 그의 작품에 영향을 줄 수 있는 마지막 기회겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0006_Text
#. Speaker : Jaethal_Companion
msgctxt "35276508-d18b-46af-949a-c814477a275c"
msgid ""
"\"We should allow him use of the main square, and even take it upon "
"ourselves to build a stage for his premiere. Moreover, we might fund the "
"production and ensure his troupe receives all the best decorations and "
"costumes. The more he owes us, the easier it will be to convince him to "
"censor any part we find disagreeable – and add as much fanfare and eulogies "
"as we like.\""
msgstr ""
"\"주 광장을 사용토록 허락해야 합니다. 거기에 초연을 위한 무대도 만들어줘야겠지요. 또, 제작비도 지원해 그 공연단에게 최고의 장식과 "
"옷을 약속해야 합니다. 라지오가 더 우리에게 빚을 질 수록, 우리가 마음에 안 드는 부분을 검열하기 쉬워지니까요. 거기다 우리가 원하는 "
"찬사나 팡파르를 넣을 수도 있고요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0013_Text
#. Speaker : Jaethal_Companion
msgctxt "0bff27f7-e91f-464c-beb2-58fc364ced90"
msgid "{n}Jaethal takes a graceful bow.{/n} \"It shall be done.\""
msgstr "{n}제이탈은 우아하게 몸을 숙였다.{/n} \"말씀대로 될 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0014_Text
#. Speaker : Linzi_Companion
msgctxt "1a01936c-c5e3-4f8b-820a-1bbd4d586a11"
msgid ""
"\"Oh, how wonderful! You'll see – this will be nothing short of magical!\""
msgstr "\"오, 아주 좋아요! 두고 보세요, 거의 마법이나 다름 없는 공연이 될 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0015_Text
#. Speaker : Capital_Collector
msgctxt "7bcd9d7b-87d3-4b9b-be00-e7fbf40df37e"
msgid "\"It is not the decision I would make… but it is not up to me.\""
msgstr "\"저라면 그런 결정을 내리지 않겠지만… 분부에 따르겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0017_Text
#. Speaker : Linzi_Companion
msgctxt "64da8615-70b2-4bf0-856b-92d3526e5acf"
msgid "\"Thank you, {name} — Larzio will be very grateful!\""
msgstr "\"고마워요, {name}. 라지오가 정말 감사할 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0018_Text
#. Speaker : Capital_Collector
msgctxt "b70e00bc-f025-4ca4-abc8-bdb8fd7ed65c"
msgid "{n}The Storyteller bows.{/n} \"I shall make the arrangements.\""
msgstr "{n}이야기꾼은 몸을 숙였다.{/n} \"준비 해두겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0019_Text
#. Speaker : Jaethal_Companion
msgctxt "71cb5600-c20b-4907-aa8e-344f4f088650"
msgid "\"I see. Well, that should be just enough.\""
msgstr "\"알겠습니다. 그러면 되겠군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0020_Text
#. Speaker : Linzi_Companion
msgctxt "8c359289-463b-4629-a1da-a67ada2dda44"
msgid ""
"\"You might not believe this, {name}… but Larzio Messus, the composer, has "
"approached me once again! The poor fellow has finally finished his opera, "
"and now he's been taken ill by consumption. He needs to find a stage to "
"present his work to the public, but he's been bedridden for a week now. This "
"may well be his final request...\""
msgstr ""
"\"믿을 수 없을 거예요, {name}… 작곡가 라지오 메수스가 제게 다시 연락해 왔어요! 그 불쌍한 사람은 막 오페라 작곡을 "
"끝마쳤는데, 폐결핵에 걸렸다고 하네요. 대중들에게 자신의 오페라를 선보이기 위한 무대가 필요한데, 침대에서 한 주 넘게 골골대는게 "
"고작이라고 해요. 이번이 그의 마지막 요청이지 싶어요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0021_Text
#. Speaker : Capital_Collector
msgctxt "36832d87-a556-4f46-afb6-a1d86cccbcb7"
msgid ""
"\"Good news, Your Highness! — The composer Larzio Messus has finished work "
"on his opera. Now all he lacks is a venue suitable for a premiere of such "
"consequence.\""
msgstr ""
"\"좋은 소식입니다, 전하! 작곡가 라지오 메수스가 오페라 작곡을 마쳤다고 합니다. 하지만 이제 자기 작품을 개봉할만한 장소가 없다고 "
"하는군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0022_Text
#. Speaker : Jaethal_Companion
msgctxt "e648fe11-bfbb-4874-a975-36c65b5a4db5"
msgid ""
"\"My young and precious friend, Larzio Messus, has finally finished his "
"opera. He spends all his days dreaming of the premiere, but he still lacks a "
"few key resources: a worthy stage and the funding necessary for a "
"magnificent, colorful production.\""
msgstr ""
"\"제 젊고 소중한 친구인 라지오 메수스가, 마침내 오페라 작곡을 끝마쳤더군요. 개봉을 꿈꾸며 매일을 보내고 있지만, 몇 가지 중요한 게 "
"부족하다고 합니다. 적당한 장소와 웅장하고, 다채로운 제작을 위한 기금입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0024_Text
#. Speaker : Linzi_Companion
msgctxt "5550474e-0d58-46b7-b52d-9668db10030c"
msgid ""
"\"I can't say that I understand you thinking… but you're the {mf|King|Queen} "
"— you make the rules.\""
msgstr "\"무슨 생각이신지는 잘 모르겠습니다만… 그래도 제 {mf|왕|여왕}이시니, 그대의 결정을 따르지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0025_Text
#. Speaker : Capital_Collector
msgctxt "cc09ded9-d050-4861-8ff4-49cec1d265b0"
msgid ""
"\"I understand your thinking, though I would have made a different decision. "
"It will be done, Your Highness.\""
msgstr "\"이해는 합니다만, 저라면 다른 선택을 했을 거 같군요. 원하시는 대로 착수하겠습니다, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0026_Text
#. Speaker : Jaethal_Companion
msgctxt "ee493c5d-e961-436f-b204-57ba2cb4bf4a"
msgid "\"A shame. One should never miss an opportunity like this.\""
msgstr "\"안타깝군요. 이렇게 기회를 놓쳐버리고 말다니요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0028_Text
#. Speaker : Linzi_Companion
msgctxt "3a42df88-e906-4082-863d-206f8db85c07"
msgid ""
"\"I'll tell Larzio he can use the main square! And that we'll fund the whole "
"spectacle as well! Oh, this is so exciting!\""
msgstr "\"라지오에게 주 광장을 사용할 수 있을 거라 이야기하겠습니다! 제작비 지원에 대한 이야기도요! 아, 이거 정말 신나는군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Culture/Rank9/Cue_0029_Text
#. Speaker : Capital_Collector
msgctxt "9e12be97-800f-48c3-951c-bc4f22451862"
msgid ""
"\"I shall make the arrangements for building a stage in the main square.\""
msgstr "\"주 광장에 무대를 건설하도록 시키겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Merc/Cue_0001_Text
msgctxt "4ab092c6-701f-4042-8bc7-fd4502abe19f"
msgid ""
"{n}Your advisor has arrived to report about the recent Divine developments "
"in your {mf|barony|barony|kingdom|kingdom}.{/n}"
msgstr "{n}당신의 보좌관이 최근의 {mf|남작령|남작령|왕국|왕국}의 신성 발전에 대해 논의하기 위해 방문했습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Answer_0022_Text
msgctxt "c0e8edd0-fab3-4ce5-95df-d4654de250e0"
msgid ""
"\"I agree. Lamashtu shall take her place among the kingdom's patron gods.\""
msgstr "\"동의합니다. 라마슈투께서 왕국의 수호신을 대신하실 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Answer_0023_Text
msgctxt "08b0ce28-b1cf-4f19-be55-f04a25db1df6"
msgid "\"It's not the right time.\""
msgstr "\"때가 좋지 않다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "b040d2e0-43e6-4b2b-8552-48852ae935a3"
msgid ""
"\"I'd like to congratulate you, Your Highness. These lands were once a "
"gloomy, godforsaken place. Its people were shackled by ignorance. But now "
"the sky shines with the light of the gods! Now the temples are full of "
"followers, and godly blessings protect the kingdom against calamity.\""
msgstr ""
"\"경하드리옵니다, 전하. 이 땅은 본디 우울하고, 신에게 버림받은 곳이었습니다. 사람들은 무식했지요. 하지만 이제 하늘이 신들의 빛으로 "
"가득합니다! 사원은 신자들로 가득하고, 신들의 축복이 왕국을 재앙으로부터 보호해주고 계십니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0002_Text
#. Speaker : Harrim_Companion
msgctxt "9e6cc5db-38be-457b-9332-bba43b790138"
msgid ""
"\"Oh, what have you done, {name}... These lands were dying until you came. "
"This was a dark, godless place. It's your fault that my god has turned away "
"from this kingdom! It's your fault that it blossoms again! The people "
"rejoice! They've forgotten what is coming for them! This makes me very sad. "
"They were nearly prepared for the truth. Now they hide once more behind "
"their delusive happiness.\""
msgstr ""
"\"아, 무슨 짓을 한 겐가, {name}...\" 이 땅은 자네가 오기 전까지 죽어가고 있었어. 어둡고, 신도 없는 곳이었지. 나의 "
"신께서 이 왕국을 저버리신 건 전적으로 자네 탓일세! 이곳이 다시 꽃피우기 시작한 건 자네 책임이라고! 사람들이 기뻐하고 있어! 무엇이 "
"다가오고 있는지 모르는 채 말이야! 정말 슬프지 아니할 수 없구만. 진실을 받아들일 준비가 거의 다 되었는데. 이제 사람들은 이 기만적인 "
"행복 뒤에 다시금 숨게 되었군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0003_Text
#. Speaker : Capital_Tsanna
msgctxt "cafb519d-97e9-44f2-8aa8-a8a30d1195e7"
msgid ""
"\"You've surprised me, {name}. I always thought that not a single god, not "
"even {g|Lamashtu}Lamashtu{/g}, ever cared about what was happening here, or "
"who might rule the {g|Stolen Lands}Stolen Lands{/g}. This place was quiet "
"and mournful. But you filled the temples with followers, and the gods have "
"turned their eyes upon you. I imagine they have big plans for you.\""
msgstr ""
"\"정말 놀라워, {name}. 항상 그 어떤 신도, 심지어 {g|Lamashtu}라마슈투{/g} 조차도, {g|Stolen Lands}"
"도둑맞은 땅{/g} 의 그 어떤 군주들조차도 이곳을 져버렸다고 생각했는데. 이곳은 조용하고 슬픈 곳이었지. 하지만 네가 사원과 신자들을로 "
"이 땅을 채웠고, 신들이 너를 바라보고 계셔. 너를 위한 큰 계획이 있으신 거 같아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0004_Text
#. Speaker : Capital_Jhod
msgctxt "917050df-2f99-4682-96f1-b5a367cf974f"
msgid ""
"\"You relentlessly pursued the small cults of dark and vile gods, and "
"cleared the lands of blight and abomination. The priests appreciate your "
"effort. A sacred guard gathers – priests of the gods we honor here, to "
"protect law and order in these lands.\""
msgstr ""
"\"당신은 사악한 신들을 섬기는 이도교들을 끈질기게 쫓았고, 병해와 혐오로 가득한 땅을 정화했다. 사제들은 당신의 노력에 감사했다. "
"신성한 수호자들이 모였다. 우리가 이곳에서 찬양하는 신의 사제들이, 질서와 법을 지키기 위해 찾아온 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0005_Text
#. Speaker : Harrim_Companion
msgctxt "c0325437-46a8-410a-a075-c04e8e5b857e"
msgid ""
"\"You have resolutely cleared these lands of minor cults, but the {g|Stolen "
"Lands}Stolen Lands{/g} has served as a graveyard for the obsolete for too "
"long. The old religions clung to life and didn't want to fade away. You gave "
"them peace. Your subjects wish to continue what you've started. The priests "
"of all the kingdom's recognized gods gather in a sacred guard, to protect "
"your domain against crime and intrigue.\""
msgstr ""
"\"당신은 이 사교도들의 땅을 단호하게 정화했다. 하지만 {g|Stolen Lands}도둑맞은 땅{/g} 은 잊혀진 자들을 위한 묘지가 "
"된 지 오래였다. 낡은 종교들은 끈질기게 사라지려 하지 않았다. 당신은 그들에게 평화를 가져다주었다. 당신의 신하들은 당신이 시작한 일을 "
"계속하고 싶어한다. 온 왕국에 알려진 신의 사제들이 신성한 수호를 위해, 당신의 땅을 범죄와 모략으로부터 지키기 위해 모였다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0006_Text
#. Speaker : Capital_Tsanna
msgctxt "14323037-f044-4f34-be27-9b2a7d824384"
msgid ""
"\"I approve of how you've treated the small cults that settled here. It was "
"time for them to go, and now this place is cleared. The priests of your "
"kingdom's faithful gods have no intention of retreat. They are setting up a "
"sacred guard, to deal with any crimes against the gods and their followers. "
"My pack is safe, in any case. A couple of my brothers occupy high positions "
"in the guard. But the other cults will have to make themselves small, or be "
"taken over by {g|Lamashtu}Lamashtu{/g} in order to survive.\""
msgstr ""
"\"여기 잔존해있던 소규모 이도교들을 처리한 방식이 마음에 드는군. 저들은 사라지고, 이제 이곳은 정화되었어. 네 왕국에 있던 신실한 "
"사제들은 물러서려 하지 않더군. 이 사제들은 모여 이교의 신과 그 추종자들, 그리고 범죄에 대항하기 위해 신성 경비대를 만들고 있어. "
"우리 무리는 안전하지만 말이야. 우리 형제들이 이 경비대의 고위직을 맡고 있어. 다른 종교에 사제들은 조심하는 게 좋을 거야. 아니면 "
"살아남기 위해 {g|Lamashtu}라마슈투{/g} 를 믿거나.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0007_Text
#. Speaker : Capital_Jhod
msgctxt "1eef8ddf-ac31-4bc0-9a6f-43b8925d797b"
msgid ""
"\"{g|Cayden Cailean}Cayden{/g} had a wonderful influence on your kingdom. "
"One fair goes on after another, and people treat each other with kindness "
"and light in their hearts. They laugh more, and bear their misfortunes "
"bravely. Bards love our lands. Once they arrive, many decide to stay. We "
"have a good reputation, and you are known as a dear and understanding leader."
"\""
msgstr ""
"\"{g|Cayden Cailean}케이든{/g} 이 네 왕국에 큰 영향을 끼치는 것 같아. 매일같이 축제가 이어지고 있고, 사람들은 "
"서로에게 친절과 다정함으로 대하고 있지. 사람들은 더 많이 웃고, 불행을 용감하게 참고있어. 음유시인들이 우리 나라를 좋아해. 한 번 "
"도착하면, 아예 정착하려 하거든. 우리 평판이 꽤 좋아. 그리고 너도 꽤나 이해심 많은 군주로 알려지고 있고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0008_Text
#. Speaker : Capital_Jhod
msgctxt "38476705-f886-443f-9b7b-364a0913cd15"
msgid ""
"\"{g|Gorum}Gorum's{/g} priests are generous with their blessings for our "
"warriors. Our fighters are strong, daring in battle, and confident in "
"victory! Many of the kingdom's children dream of becoming your knights when "
"they grow up. You are considered the ultimate power in the realm – a true "
"leader!\""
msgstr ""
"\"{g|Gorum}고룸{/g} 의 사제들이 우리 전사들에게 축복을 내려주고 있습니다. 우리 전사들은 전투에 임할 때 강하고 대담하며, "
"승리에 대한 자신감도 넘치고 있지요! 수많은 왕국의 아이들이 자라서 왕국의 기사가 되고싶어 합니다. 당신은 이 땅의 절대권력으로 "
"추앙받습니다. 진정한 지도자로요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0009_Text
#. Speaker : Capital_Jhod
msgctxt "a96982e1-cafb-4e55-81a1-9b3e2743d8e4"
msgid ""
"\"{g|Asmodeus}Asmodeus{/g}' followers have brought order to your domain. "
"Laws are executed consistently, and punishments are now accepted as part of "
"the normal course of life. {g|Cheliax}Cheliax{/g} sends its messengers to "
"sign lucrative contracts with us. Alas, our immediate neighbors are worried "
"and enraged. And yet the comprehensible of Asmodeus is far better than the "
"incomprehensible chaos that plagues other lands. The "
"{g|Hellknights}Hellknights{/g} arriving to our domain intend to bring order "
"to the neighboring lands – with fire and sword. Meanwhile you maintain the "
"image of a just and fair {mf|king|queen}.\""
msgstr ""
"\"{g|Asmodeus}아스모데우스{/g} 의 신자들이 당신의 영토에 명령을 내려왔다. 법의 집행이 끊임없이 이루어지고 있으며, 형벌은 "
"이제 일상으로 받아들여지고 있다. {g|Cheliax}첼리악스{/g} 에서 전갈을 보내 이윤이 될만한 협정을 맺자고 해오고 있다. 하지만 "
"우리 바로 옆 이웃들은 걱정하며 분개해하고 있다. 그렇지만 다른 나라에 퍼지는 무질서한 혼돈보다는 질서있는 아스모데우스를 믿는 편이 훨씬 "
"더 합리적이다. 당신의 땅에 도착하는 {g|Hellknights}헬나이트{/g} 들이 이웃 땅에 질서를 가져다 줄 것이다. 불과 칼로써. "
"당신은 한편 공평하고 공정한 {mf|왕|여왕} 인상을 유지하고 있다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0010_Text
#. Speaker : Harrim_Companion
msgctxt "e2e7afc4-2ac8-4465-8ff9-edda63d24cab"
msgid ""
"\"Where {g|Groetus}Groetus{/g} might grant your subjects understanding, {g|"
"Cayden Cailean}Cayden{/g} gives them solace and oblivion in a jar of wine. "
"They drink and rave, just to escape their fate and the burdens of their "
"lives. They go to fairs, give birth to children, and enjoy the simple things "
"in life, certain that it shall forever be, just like this. They open their "
"thoughts to adventure, as if they were immortal, and call you their beloved "
"{mf|King|Queen}, in the merry land with no woe.\""
msgstr ""
"\"{g|Groetus}그로투스{/g}는 너의 백성들을 이해시키고, {g|Cayden Cailean}케이든{/g}은 한 잔의 술로 망각의 "
"위안을 내려준다. 사람들은 마시고 소리지른다. 운명과 삶의 무게로부터 도망치기 위해. 사람들은 시장에 가고, 아이를 낳으며, 삶의 단순한 "
"것들로부터 즐거움을 얻는다네. 이런 모습은 영원히 반복되지. 사람들은 마치 불멸자라도 되는 마냥 모험을 떠나고, 아무런 고통 없는 땅에서 "
"당신을 경애하는 {mf|왕|여왕}이라 부른다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0011_Text
#. Speaker : Harrim_Companion
msgctxt "9237ad55-5c88-49a8-8768-7f1b7b3a6ed2"
msgid ""
"\"{g|Gorum}Gorum{/g} ensures that your warriors are ruthless and "
"devastating. They are lost to {g|Groetus}Groetus{/g}, for they do not stop "
"to consider death – it's as if the end doesn't exist! The game of war is as "
"child's play, with many children looking to join your army, to kill and maim "
"at your command. People say you've taken your throne by right. After all, "
"everyone who has challenged your right is dead!\""
msgstr ""
"\"{g|Gorum}고룸{/g} 은 당신의 전사들이 강력하며 잔혹하리라 약속한다. 그들은 {g|Groetus}그로투스{/g} 에겐 "
"잊혀졌다. 죽음에 집착하기를 멈추지 않았기 때문이다. 마치 종말이 오지 않을 것 처럼 말이다. 전략은 아이들의 놀이와 같다. 수많은 "
"아이들이 당신의 군대에 가담하고 싶어하고, 명령을 받고 죽이고 학살하고 싶어하기 때문이다. 사람들은 당신이 옥좌를 정당하게 얻었다고 "
"말한다. 누구든 당신에게 도전한 자는 모두 죽었으니!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0012_Text
#. Speaker : Harrim_Companion
msgctxt "a928ff5f-52f8-47e5-ae1e-86f3c4f5ceab"
msgid ""
"\"Faith in {g|Asmodeus}Asmodeus{/g} has led many to accept law as the only "
"way of life. People obediently bow their heads, so obedient they've trained "
"themselves to be, as if obedience and diligence could protect against the "
"inevitable end. Your neighbors were outraged by the new church nearby, and "
"seriously considered warring with you. But ambassadors from "
"{g|Cheliax}Cheliax{/g} have expressed their appreciation for our loyalty to "
"their patron. The {g|Hellknights}Hellknights{/g}, who arrive on our lands "
"this very moment, regard our territory as the key to restoring order in the "
"{g|River Kingdoms}River Kingdoms{/g}. It was a dangerous bargain, but it "
"promises a substantial reward.\""
msgstr ""
"\"{g|Asmodeus}아스모데우스{/g} 를 믿음으로써 많은 이들이 규칙을 삶의 유일한 방식으로 받아들이기 시작했다. 사람들은 "
"훈련받은 대로 공손히 머리를 숙였다. 이런 복종과 근면이 피할 수 없는 종말로부터 자신들을 보호해주는 것 마냥. 당신의 이웃들은 근처에 "
"새로 세워진 교회에 분개했고, 진지하게 당신과의 전쟁을 고려했다. 허나 {g|Cheliax}첼리악스{/g} 의 사절들은 자신들의 "
"수호신에게 충성을 다하는 것에 감사를 표했다. 현재 우리 땅에 찾아온 {g|Hellknights}헬나이트{/g} 들은 우리 영토를 {g|"
"River Kingdoms}강의 왕국들{/g}에 질서를 가져다주기 위한 요충지로 여기고 있다. 위험할 거지만, 그 보상은 클 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0013_Text
#. Speaker : Capital_Tsanna
msgctxt "6737f9ed-979b-4822-a952-8e23fe7aab13"
msgid ""
"\"{g|Cayden Cailean}Cayden's{/g} bliss pleases your pack. It sates and "
"cheers them. They celebrate, sing songs and frolic at their fairs. And, of "
"course, they multiply. {g|Lamashtu}Lamashtu{/g} likes this – except for "
"their free thinking. Their tongues are loosened by their cups, and they grow "
"too daring. They cannot be easy to rule – I don't understand how you make "
"them obey your commands, and even honor you with songs of praise, their "
"merry and generous {mf|King|Queen}.\""
msgstr ""
"\"{g|Cayden Cailean}케이든{/g} 의 축복이 네 무리에게 내렸어. 놈들은 만족하며 기뻐하고 있지. 축하하며, 축제에서 "
"노래를 부르고 춤을 추고 있어. 그리고 물론, 번식도 하고. {g|Lamashtu}라마슈투{/g} 가 이에 기뻐하시고 있다. 자유 사상에 "
"대한 것만 제외하고. 술이 이들의 입을 가볍게 만들고, 이 놈들은 점점 대담해지고 있어. 이렇게 쉽게 다스릴 수 있는 존재가 아닌데. "
"어떻게 이 놈들이 네 명령을 따르고 네가 관대하고 위대한 {mf|왕|여왕} 이라고 노래를 불러대는지 이해가 가지 않는군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0014_Text
#. Speaker : Capital_Tsanna
msgctxt "25d1cfa1-0ca0-40cf-b45e-61473acc5e97"
msgid ""
"\"Your armies are blessed by {g|Gorum}Gorum{/g}. Our warriors are cold-"
"blooded, mighty, and fearless. Children dream of shedding blood on your "
"orders, when they grow up – for the glory of Gorum. This could come in handy "
"sooner than you think. As the rumor spreads that you're the strongest "
"{mf|king|queen} in the world, many will come to challenge you.\""
msgstr ""
"\"우리 군대는 {g|Gorum}고룸{/g} 의 축복을 받았어. 우리 전사들은 냉정하고, 강력하며 두려움이 없지. 아이들은 장차 고룸의 "
"영광을 위해 네 명령에 죽고살고자 해. 네 생각보다 빠르게 쓸모를 보일거야. 네가 세상에서 가장 강력한 {mf|왕|여왕} 이라는 소문이 "
"퍼지면서, 많은 이들이 네게 도전할 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0015_Text
#. Speaker : Capital_Tsanna
msgctxt "9a8b339d-cfc2-4db2-80c3-ddca6a03ff87"
msgid ""
"\"{g|Asmodeus}Asmodeus{/g}' servants have taught your pack to obey the "
"leader and submit to your will. Your neighbors are furious with you, while "
"{g|Cheliax}Cheliax{/g} has sent its ambassadors to your capital. You've "
"strengthened your position, taking the advantage of your alliance with the "
"church of Asmodeus. This was clever – a bold decision with a great reward!\""
msgstr ""
"\"{g|Asmodeus}아스모데우스{/g} 의 하수인들이 당신의 무리에게 지도자를 따르고 뜻에 굴복하는 법을 가르쳐주었다. 주변국들은 "
"당신에게 분노한다. {g|Cheliax}첼리악스{/g} 는 수도에 대사를 파견해왔지만. 당신은 자리를 굳건히 보전하고, 아스모데우스 "
"교단과의 동맹에서 가져오는 이점을 용하고 있다. 이는 현명한 선택이자, 큰 보상이 뒤따를만한 대담한 선택이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0016_Text
#. Speaker : Capital_Jhod
msgctxt "1424cf52-dde2-450c-b5c4-50cca0b7f5d3"
msgid ""
"\"Thanks to your tolerance of the small cults, rumors are spreading that "
"every minor religion will be welcomed in your kingdom. And so every odd rag-"
"tailed priest and congregant of the minor deities is flocking to your "
"kingdom in search of shelter. Many of them are good but misled people. "
"There's a bad element as well, but we're watching them day and night. The "
"wide variety of worship may confuse some decent folks, but most of them are "
"committed to the true faith.\""
msgstr ""
"\"소규모 사교도들에 대한 당신의 관용 덕택에, 온갖 잡다한 종교들이 당신의 왕국에선 환영받는다는 소문이 퍼지고 있어. 그래서인지 "
"누더기를 입은 사제들과 소신격의 사제들이 은신처를 찾고자 당신의 왕국에 모여들고 있지. 대부분 선한 사람들이지만, 오도된 사람들일 "
"뿐이야. 그 중 나쁜 부류도 있긴 하지만, 밤낮으로 감시중이지. 다양한 종교 때문에 사람들이 좀 혼란스러워 하고 있지만, 대부분은 진정한 "
"믿음을 가진 신자들이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0017_Text
#. Speaker : Harrim_Companion
msgctxt "f55f78a7-dbc0-431e-8cba-a88d6292749e"
msgid ""
"\"I accept that you avoid imposing your faith on others, allow the "
"worshipping of idols, and give shelter to the weak. But look where this has "
"led you! Dozens of smaller cults, more worthy of oblivion, are flooding your "
"lands, seeking protection! They survive in your kingdom rather than face the "
"inevitable. Their teachings and obsolete magical knowledge, so welcomed by "
"your wizards, were meant to be forgotten!\""
msgstr ""
"\"어느 한 가지 종교만 강요하지 않고, 우상 숭배를 허락하며 약자들을 위한 은신처를 제공해주는 건 인정하지. 하지만 지금 이 꼴을 "
"보시게! 차라리 잊혀지는 게 더 나을만한 작은 사교도들이, 이 땅에 넘쳐서 함께 보호를 요청해오고 있지 않나! 저들은 사라져 잊혀지는 "
"대신 이곳에서 살기로 한 것 뿐이라네. 지금 우리 마법사들이 환영해대는 저들의 가르침과 낡아빠진 마법 지식들은, 원래 잊혀졌어야 하는 "
"것이란 말일세!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0018_Text
#. Speaker : Capital_Tsanna
msgctxt "d85fda58-e9db-4d27-9b2d-1d25c0ac64a4"
msgid ""
"\"You were right not to stamp out the smaller cults hiding here. Whispers "
"spread that minor religions are safe in your domain, and cults scurry to "
"hide themselves {mf|behind your shield|under your skirts}. Some possess "
"curious knowledge of ancient magics. All their priests are willing to share "
"it with you!\""
msgstr ""
"\"여기 있던 소규모 사교도들을 없애버리지 않은 것은 옳은 선택이었습니다. 작은 교단들이 이 땅에선 안전하다는 소문이 들리고 있고, "
"교단들이 서둘러 {mf|당신의 뒤에|당신의 치마 아래로} 숨으려 하고 있습니다. 어떤 자들은 고대의 마법에 대한 지식을 가지고 있습니다. "
"그 사제들이 그 지식을 함께 공유하고자 하는 군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0019_Text
#. Speaker : Capital_Jhod
msgctxt "59542fc2-0f67-4e83-b28a-165c81d6164b"
msgid ""
"{n}Jhod clears his throat and continues muttering in a friendly manner.{/n} "
"\"The outsiders are a source of much good as well, of course. They bring "
"pieces of valuable magical knowledge, and they're sought after by "
"researchers and wizards, who seek rare and forsaken magics.\""
msgstr ""
"{n}조드는 목청을 가다듬은 뒤 계속해서 친절하게 중얼거렸다.{/n} \"외지인들은 다양한 상품도 가져오지요. 갑진 마법 지식도 "
"가져오며, 희귀하고 잊혀진 마법을 찾아다니는 연구자와 마법사들에게 인기가 많습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0020_Text
#. Speaker : Capital_Tsanna
msgctxt "d9262be2-75cf-48b0-ab9d-3b89bca98b37"
msgid ""
"\"And one more thing. {g|Lamashtu}Lamashtu{/g} gave me a sign. She approves "
"of the way you lead your kingdom and your pack. Now that we've found common "
"ground... and got along so well... why don't you praise my goddess as well? "
"You could introduce her cult to the world, and claim boldly that we in the "
"kingdom of {kingdomname} worship none other than Lamashtu! Our neighbors "
"will surely turn against us, but my pack has grown strong under your care. "
"We are capable of protecting the country.\""
msgstr ""
"\"그리고 한 가지 더. {g|Lamashtu}라마슈투{/g}께서 내게 메시지를 보내셨다. 네가 왕국을 경영하고, 부하를 다루는 방법에 "
"동의하셨지. 공통분모가 생긴데다, 마음도 잘 맞으니... 이번 기회에 우리 여신님을 섬기는 게 어떤가? 세상에 그분의 교단을 소개하고, "
"우리 {kingdomname} 왕국은 라마슈투만을 섬긴다고 대담하게 공포하는 거야! 이웃 국가는 등을 돌리겠지만, 내게 도움을 주면 "
"교단을 제대로 키울 요량이 있어. 적의 침입으로부터 이 땅을 지키기에 충분하겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0024_Text
#. Speaker : Capital_Tsanna
msgctxt "c5b66161-d45b-4719-952f-977597ec944c"
msgid ""
"\"I understand... We must hide to protect our faith. But the day will come..."
"\""
msgstr "\"이해한다... 신앙을 위해선 숨겨야 하지. 하지만 언젠가 때가 올 거야...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0025_Text
#. Speaker : Capital_Tsanna
msgctxt "9ecde4af-5311-4a99-b07a-176ddadfae26"
msgid ""
"{n}Tsanna's rat starts squeaking triumphantly, and Tsanna bursts out "
"laughing.{/n} \"Thank {g|Lamashtu}Lamashtu{/g}! I've been waiting for so "
"long! Let everybody know that we renounce this disgraceful silence! We will "
"openly pray to the Mother of Monsters – we will praise and worship Lamashtu! "
"We shall live, kill, die, and multiply in your honor!\""
msgstr ""
"{n}산나의 쥐가 의기양양하게 찍찍거리며, 산나는 웃음을 터뜨린다.{/n} \"{g|Lamashtu}라마슈투{/g}여 감사하나이다! "
"얼마나 오랫동안 기다렸던가! 이 불명예스런 침묵을 벗어던졌다는 사실을 모두가 알도록 합시다! 이제 공개적으로 괴물들의 어머니를 섬길 "
"것입니다. 라마슈투를 섬길 것이라 이 말입니다! 우리는 그대의 영광 아래 살고 죽으며, 죽이고 번식할 것입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0026_Text
#. Speaker : Capital_Jhod
msgctxt "ec49a7be-15c6-428e-89e4-9cb45b2206d9"
msgid ""
"\"{g|Abadar}Abadar{/g} and his followers have brought law and order to your "
"kingdom. Little by little, the {g|Stolen Lands}Stolen Lands{/g} are shifting "
"away from the dark times of the past... thank the gods! Your subjects "
"appreciate this newfound peace and order. Trade flourishes, lining the "
"people's pockets with gold. Your choice of patron for the kingdom was very "
"wise indeed!\""
msgstr ""
"\"{g|Abadar}아바다르{/g} 와 그 신자들은 당신의 왕국에 질서와 법을 가져왔습니다. 조금씩, {g|Stolen Lands}"
"도둑맞은 땅{/g} 은 과거 어두웠던 시대로부터 변화하고 있지요... 이 모든 것이 신 덕분입니다! 당신의 백성들도 이 새로운 평화와 "
"질서에 감사하고 있습니다. 교역이 번영하고, 사람들의 주머니를 황금으로 채우고 있습니다. 왕국을 위해 당신은 현명하게 수호신을 선택한 "
"셈이지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0027_Text
#. Speaker : Harrim_Companion
msgctxt "f9c0782a-8f1e-4900-a098-958ee0b04e3a"
msgid ""
"\"{g|Abadar}Abadar{/g} is a fool. Even in the face of inevitable oblivion, "
"he continues to fret over his doomed life's work, day and night. But he is "
"not without his admirers, even in the {g|Stolen Lands}Stolen Lands{/g}. Our "
"merchants and traders rely on Abadar's support in their affairs, and our "
"artisans seek his protection against bandits, which are still numerous in "
"the area. You are praised as a wise and caring {mf|king|queen}.\""
msgstr ""
"\"{g|Abadar}아바다르{/g} 는 어리석다. 피할 수 없는 종말 앞에서도 필멸자들의 생을 매일같이 걱정하니까. 그렇기에 {g|"
"Stolen Lands}도둑맞은 땅{/g} 에는 그를 따르는 이들이 많다. 우리의 상인들만 해도 아바다르의 축복을 기원하며, 우리 "
"장인들도 아바다르에게 도적으로부터의 보호를 기원하고 있다. 그런 풍조가 아직도 꽤나 널리 퍼져있다. 그대는 현명하며 사려깊은 "
"{mf|왕|여왕} 으로 추앙받는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank10/Cue_0028_Text
#. Speaker : Capital_Tsanna
msgctxt "facacefa-dcd5-444c-a60d-4f2e7f9eff38"
msgid ""
"\"Speaking of {g|Abadar}Abadar{/g}, who you invited to your lands so "
"carelessly... I cannot say that his followers are entirely useless. They've "
"spread the idea that obeying your laws is good, and that submission is "
"virtuous. But I still dislike these narrow-minded penny pinchers – and so "
"does my mistress.\""
msgstr ""
"\"당신이 이 땅에 별 생각 없이 데려온 이 {g|Abadar}아바다르{/g} 말입니다... 이 추종자들이 전혀 쓸모없지는 않은 것 "
"같군요. 이 자들이 당신의 법에 따르며 사는 것이 옳은 길이라는 사상을 퍼뜨리고 있습니다. 굴종이 곧 미덕이라고 말입니다. 허나 이 속 "
"좁은 구두쇠들은 아직도 마음에 들지가 않는군요. 제 부인도 똑같이 생각합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Answer_0008_Text
msgctxt "374e7673-21cf-4ecf-923f-b25f47c9252c"
msgid ""
"{g|Divine2_1}[Choice effects]{/g} \"Grind these strange idols to dust. I've "
"no wish to see strange shrines in the area.\""
msgstr ""
"{g|Divine2_1}[선택 시 효과]{/g}\"이 이상한 우상을 먼지가 될 때 까지 갈아버려라. 여기서 이런 것들은 더는 보고싶지 "
"않아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Answer_0009_Text
msgctxt "f16147e4-498c-42a9-9b87-5fe6cd7fcfe5"
msgid ""
"{g|Divine2_2}[Choice effects]{/g} \"Leave the idols where they stand. "
"Someone worships them, and we've no right to interfere.\""
msgstr ""
"{g|Divine2_2}[선택 시 효과]{/g}\"우상을 제자리에 두라. 누군가 섬기는 것에 우리가 마음대로 관여할 권리는 없지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Answer_0010_Text
msgctxt "c838b767-a2bb-48e8-9e80-13f03d80ed06"
msgid "\"Do whatever you wish.\""
msgstr "\"원하는 대로 하세요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "45d92f22-35f6-4549-80ea-942fc2524cef"
msgid ""
"\"I bear bad news, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. A "
"number of foul idols have been seen around your new capital! They don't "
"belong to any god known to me, and strange loners seem drawn to them – which "
"only gives me greater concern.\""
msgstr ""
"\"나쁜 소식입니다, {mf|영주님|영주님|전하|전하}. 사악한 우상 여럿이 우리 새로운 수도에 모습을 보이고 있습니다! 제가 아는 한 "
"그 어떤 신도 그런 모습을 하진 않습니다. 그리고 수상한 사람들이 자꾸 꼬이고 있습니다. 걱정이 커져만 가는 군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0002_Text
#. Speaker : Capital_Jhod
msgctxt "52ecc344-b7f0-4903-b7ca-2aa681e2f790"
msgid ""
"\"I suggest we tear them down and be done with it. Who know what evil still "
"lingers in the {g|Stolen Lands}Stolen Lands{/g} from the old times. In any "
"case, they certainly don't belong here!\""
msgstr ""
"\"전부 파괴하고 없애버려야 합니다. {g|Stolen Lands}도둑맞은 땅{/g}에 잠들어 있던 어떤 악마의 소행일지 누가 압니까. "
"어쨌든, 이곳에 두면 안 됩니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0003_Text
#. Speaker : Harrim_Companion
msgctxt "1fc42a22-35e4-4853-bfb8-5420e17838f4"
msgid ""
"{n}Harrim mumbles to himself, pulling on his beard. Finally he notices "
"you.{/n} \"{name}! Allow me to speak for those who cannot protect themselves "
"and their faith! The priests of {g|Erastil}Erastil{/g}, and the priests of "
"the other gods – they've all turned against the ancient faiths that once "
"flourished in the {g|Stolen Lands}Stolen Lands{/g}, now long since passed "
"into eternity. Their final traces are the ancient shrines and idols, which "
"lay hid among the swamps and woods, symbols of transience and decay...\""
msgstr ""
"{n}하림은 수염을 잡아당기며 중얼거리다 결국 당신을 부른다.{/n} \"{name}! 스스로와 그 신앙을 지키지 못한 자들을 대변하게 "
"해주게! {g|Erastil}에라스틸{/g}, 그리고 다른 신의 사제들은 모두 한 때 {g|Stolen Lands}도둑맞은 땅{/g}에서 "
"번영했던, 영원과 하나가 되어버린 고대의 신들로부터 등을 돌린 자들일세. 남아있는 이 옛 신들의 마지막 흔적은 고대의 성지와 우상 "
"뿐이야. 모두 늪과 나무에 숨겨져, 무상함과 쇠락의 상징이 되어버리고 말았지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0004_Text
#. Speaker : Harrim_Companion
msgctxt "8c36910c-12be-4110-a71f-6d0deb6b616f"
msgid ""
"\"They wish to demolish these idols! They seek to destroy, with fire and "
"chisel, all that would remind them that all things must come to an end.\" {n}"
"Harrim strokes his beard broodingly.{/n} \"Whoever it was that once to "
"worshipped these idols, their faith deserves our respect. It is your "
"decision, but I would not destroy these ritual places just because the god "
"they are devoted to isn't well known. I myself serve such a god, often "
"decried by ignorant tongues.\""
msgstr ""
"\"그 사제들은 모든 것은 필연적으로 사멸한다는 것을 알려주는 이 우상들을 파괴하려고 해! 불과 끌로써 말이지.\" {n}하림은 우울해진 "
"채로 자신의 수염을 쓰다듬었다.{/n} \"이 숭배받는 우상이 그 누구였든 간에 그 신앙은 보존되고 존중받아야 하네. 결정은 자네의 "
"몫이긴 하지만, 나라면 이런 신들이 별로 유명하지 않다는 이유로 의식장을 파괴하는 일은 없을 걸세. 나 또한 그런 신을 섬기고 있고, "
"무지한 자들에게 그런 모멸을 받아왔으니 말일세.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0005_Text
#. Speaker : Capital_Tsanna
msgctxt "1c6b564b-c58e-4cd8-8283-5c95660deabf"
msgid ""
"\"{name}, your pack trembles in fear. Foul idols circle around your capital. "
"Rumor has it they've been here forever, but the smell of blood upon them is "
"still hot and sweet. Strange looking lights have been seen around one such "
"idol. These remnants of ancient cults frighten your people, who clamor to "
"demolish and burn them down.\""
msgstr ""
"\"{name}, 네 무리가 두려움에 떨고있어. 사악한 우상이 수도를 둘러싸고 있다. 오래 전부터 이런 우상이 존재했었다는 소문이 있긴 "
"하지만, 그 위에서 맡을 수 있는 피냄새는 아직도 뜨겁고 향기롭지. 이런 우상 중 하나의 주변에서 수상한 기운이 멤돌고 있어. 고대 "
"이교의 잔당이 네 백성들을 겁주고있다. 이런 우상을 파괴하고 불태워야 한다는 네 백성들을 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0006_Text
#. Speaker : Capital_Tsanna
msgctxt "a33d6303-6719-4f75-b022-f1bb7955f012"
msgid ""
"\"But I would not, if I were you. Believe me, dead gods know how to leave "
"nasty gifts for those who would destroying their last vestiges.\""
msgstr ""
"\"하지만 내가 너라면 하지 않을 것 같네. 나를 믿어 봐. 죽은 신은 그들의 남은 흔적을 파괴하려는 사람들에게 불쾌한 선물을 남기는 "
"법을 알고 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0011_Text
#. Speaker : Capital_Jhod
msgctxt "ff21c7e2-8ec5-468f-b432-36585adc4952"
msgid ""
"\"Very well! I shall ensure that nothing remains of them, rest assured!\""
msgstr "\"잘 알겠습니다! 먼지 한톨 조차 안 남기겠습니다. 보증해드리죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0012_Text
#. Speaker : Harrim_Companion
msgctxt "2976b70f-addf-4e38-801c-1ad4323a4114"
msgid ""
"{n}Harrim sighs hopelessly.{/n} \"Another shadow of the past, to dissolve "
"before its proper time. It is a pity.\""
msgstr ""
"{n}하림은 절망적으로 한숨을 쉰다.{/n} \"때가 되기 전이건만, 과거의 또 다른 그림자가 사라지는구나. 애석한 일이로다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0013_Text
#. Speaker : Capital_Tsanna
msgctxt "f08c0091-1fc1-4fef-a796-63f53b75bc11"
msgid ""
"\"They do seem dangerous, yet my throat chokes when I hear you order them "
"demolished. As does yours, I'm sure. Do you truly prefer to ignore their "
"power, even as your every instinct cries out – 'Run!' Are you sure that this "
"is wise?\""
msgstr ""
"\"그들은 위험해 보이지만, 그것들을 파괴하라고 명령하는 것을 들으니 목이 메이네. 너도 마찬가지야, 난 확신해. 너의 모든 본능이 "
"'달려라!' 라고 외치더라도 진정 무시할거야? 이것이 현명하다고 확신해?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0014_Text
#. Speaker : Capital_Jhod
msgctxt "cf1f4143-8ee9-47a8-876a-cb91217faa42"
msgid ""
"{n}Jhod sniffs.{/n} \"You're making a mistake! What if something hideous "
"crawls out from under them? Some daemon or worse... You are simply too kind, "
"{mf|Your Grace|Your Grace|Your Highness|Your Highness}. Too kind, and not "
"firm enough!\""
msgstr ""
"{n}조드가 코를 킁킁거린다.{/n} \"실수하는 겁니다! 밑에서 뭔가 흉측한 것이 기어 나온다면 어쩔껍니까? 다이몬이나 더 위험한... "
"당신은 친절함이 지나칩니다, {mf|영주님|영주님|전하|전하}. 너무 친절하고, 결단력이 없어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0015_Text
#. Speaker : Harrim_Companion
msgctxt "5e2d12ee-0bfa-42a5-85d8-70eaa5c6b362"
msgid "{n}Harrim nods gravely.{/n} \"That is the right decision, {name}.\""
msgstr "{n}하림이 무겁게 고개를 끄덕인다.{/n} \"올바른 결정일세, {name}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0016_Text
#. Speaker : Capital_Tsanna
msgctxt "249d9936-ecf9-4107-ad71-8e30a6b29cfb"
msgid ""
"\"Most reasonable. You should not seek to awaken whatever lies there, sound "
"asleep. It may have teeth sharper than yours.\""
msgstr "\"합리적이군. 거기에 무엇이 있든지 깨워서는 안돼. 아마 너보다 더 날카로운 이빨을 가지고 있을 테니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0017_Text
#. Speaker : Capital_Jhod
msgctxt "a0981828-740d-4868-b421-df8533e85082"
msgid ""
"\"Then it's time to send for our workers, and remove every trace of this "
"heresy.\""
msgstr "\"그러면 우리 일꾼들을 보내서 이단의 흔적을 없애겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0018_Text
#. Speaker : Harrim_Companion
msgctxt "9ddea267-e8d5-4239-a920-16a13689a7ee"
msgid ""
"\"I will preserve the shrines. May your subjects remember that this is the "
"future of every faith.\""
msgstr "\"나는 그 신전을 보존할 것이다. 이것이 모든 신앙의 미래라는 것을 당신의 백성들이 기억하기를.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank2/Cue_0019_Text
#. Speaker : Capital_Tsanna
msgctxt "b2af59c9-2c9e-41eb-9e69-fd0331fb4829"
msgid ""
"\"I shall forbid anyone to engage with these idols. Who knows what strange "
"darkness sleeps beneath them.\""
msgstr "\"누구든 이 우상과 관여되는 것을 금하겠다. 그 아래 어떤 수상한 어둠이 잠들어있는지 누가 알겠는가.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Answer_0008_Text
msgctxt "f30f76c6-ab6b-4f10-9231-8c3ae548e96f"
msgid ""
"{g|Divine3_1}[Choice effects]{/g} \"I allow this preacher to profess his "
"faith in my lands.\""
msgstr "{g|Divine3_1}[선택 시 효과]{/g} \"이 설교자가 내 땅에서 자신의 신앙을 설파할 수 있도록 허락하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Answer_0009_Text
msgctxt "64536815-4d78-4376-b25f-ffdb62d98857"
msgid ""
"{g|Divine3_2}[Choice effects]{/g} \"I forbid this preacher to fill my "
"subjects' heads with his rubbish. Throw him out!\""
msgstr ""
"{g|Divine3_2}[선택 시 효과]{/g} \"이 설교자가 내 백성들의 머리를 쓰레기로 채우는 것을 금한다. 그를 내쫓아라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Answer_0010_AlignmentShift.Description
msgctxt "b2ac97b7-1e95-4994-9dee-ee85f1954f7a"
msgid "Executed the innocent preacher."
msgstr "무고한 설교자를 처형했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Answer_0010_Text
msgctxt "0aa01e67-c30e-495a-9f8a-9b15986c017c"
msgid ""
"{g|Divine3_3}[Choice effects]{/g} \"I demand the preacher be executed. Make "
"him an example for the others!\""
msgstr ""
"{g|Divine3_3}[선택 시 효과]{/g} \"나는 설교자를 처형할 것을 요구한다. 그를 다른 사람들의 본보기로 삼아라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Answer_0017_Text
msgctxt "61f5efd6-7b9f-492a-be85-b2fb90e5b096"
msgid "\"Make your own decision.\""
msgstr "\"알아서 결정하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Answer_0024_Text
msgctxt "840cafb0-d871-4089-a440-c713c5c891f0"
msgid "\"I have never heard of these Speakers of the Depths. Who are they?\""
msgstr "\"심부의 대변인(the Speakers of the Depths)은 처음 들어보는군. 그들은 누구인가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "07f6a5cb-560f-4ebc-b4a9-b3ac4b76cbb7"
msgid ""
"{n}Jhod nibbles his mustache, annoyed.{/n} \"Oh, these {g|Stolen Lands}"
"Stolen Lands{/g}... They're a breeding ground for filth! No sooner have I "
"dealt with one crisis, but another is on its way! This time, a preacher of a "
"religion that no one's ever heard has ventured onto your lands.\""
msgstr ""
"{n}조드는 짜증이 나서 콧수염을 물어 뜯는다.{/n} \"아, {g|Stolen Lands}도둑맞은 땅{/g}은 정말이지... 더러움의 "
"온상이로군요! 한 가지 위기를 처리하니까, 또 다른 위기가 오다니! 이번에는 듣도 보도 못한 종교의 선교자가 찾아왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0002_Text
#. Speaker : Capital_Jhod
msgctxt "56dd8e8a-aea1-4ca2-a754-a6388374cf2e"
msgid ""
"\"The people say that this priest speaks of some Speakers of the Depths. "
"It's the first time I'm hearing any of this, but the name alone says you "
"shouldn't expect anything good from them! But alas, not all our people are "
"as reasonable as you and I: the preacher has already gathered his first "
"followers! {mf|Your Grace|Your Grace|Your Highness|Your Highness}, I beg you:"
" please decide what we are to do with him! If you ask me, I say we should "
"run him off with a pitchfork!\""
msgstr ""
"\"사람들이 말하길 이 사제가 심부의 대변자들(Speakers of the Depths)에 대해 이야기한다고 하더군요. 이런 말을 듣는 "
"건 처음이지만 그 이름만 들어도 좋은 자들은 아닌 것 같습니다! 하지만 안타깝게도, 모든 사람들이 우리처럼 합리적이진 않지요. 선교자가 "
"이미 추종자를 모았다고 합니다! {mf|영주님|영주님|전하|전하}, 간청하건데 어떻게 해야할지 결정해주십시요! 저라면 쇠스랑으로 "
"쫓아버려야 한다고 생각합니다만!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0003_Text
#. Speaker : Harrim_Companion
msgctxt "dff580de-bb95-439b-bccb-acc5993fa1b3"
msgid ""
"{n}Harrim looks at you attentively from under his bushy brows.{/n} \"A god's "
"crier has come onto your lands. But he is not another one of {g|Cayden "
"Cailean}Cayden's{/g} barker or {g|Erastil}Erastil's{/g} preachers, oh no... "
"He is a priest of the Speakers of the Depths – ancient gods, whose names are "
"forgotten in these lands. \""
msgstr ""
"{n}하림은 잔뜩 찌푸린 이마 밑으로 당신을 조심스레 바라본다.{/n} \"신의 목소리를 전하는 자가 자네 땅에 왔네. 하지만 {g|"
"Cayden Cailean}케이든{/g}의 헛소리를 내뱉는 자거나 {g|Erastil}에라스틸{/g}의 설교자가 아닐세. 아, 이런... "
"그는 심부의 대변인(the Speakers of the Depths), 이 땅에서 잊혀진 고대 신들의 사제로군. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0004_Text
#. Speaker : Harrim_Companion
msgctxt "1a26e442-2801-4ccb-b35d-14507c025595"
msgid ""
"\"He bears the message of the Speakers to your subjects – and he has already "
"gathered his first worshipers! I see no reason to interfere: let the people "
"choose whatever faith they wish. But people are displeased – mainly the "
"followers of {g|Erastil}Erastil{/g}, and among our citizens there are many. "
"They say that evil hides under the cover of this strange religion. But this "
"is folly. Still, you must decide what to do about this new faith in your "
"lands.\""
msgstr ""
"\"자네 백성들을 위한 선교자들의 전갈을 가져왔군. 거기다 이미 첫 번째 숭배자도 모은 상태야! 더 이상 관여할 이유를 찾지 못하겠군. "
"사람들이 무얼 믿든 마음대로 하게 내버려두게. 물론 기분 나빠하는 사람들도 있네. 주로 {g|Erastil}에라스틸{/g} 쪽 사람들, "
"그리고 우리 백성들 중에도 많이 있고. 그네들 말로는 이 종교는 사악하다고 하지. 하지만 그건 헛소리야. 뭐, 이 땅에 새로 들어온 "
"신앙에 대해 어떻게 해야할 지는 자네가 선택할 일이지만.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0005_Text
#. Speaker : Capital_Tsanna
msgctxt "75b2c97f-5a0c-4721-af96-e1e213b11d6e"
msgid ""
"\"The guards have captured a suspicious traveler. A preacher of a strange "
"religion, who was traveling about your lands, spreading stories of strange "
"gods. He called them the Speakers of the Depths, or something of the sort. "
"He's even recruited a few followers.\""
msgstr ""
"\"경비대가 수상쩍은 여행자를 붙잡았습니다. 수상한 종교의 선교자인데, 우리 땅을 지나가면서 수상한 신들에 대한 이야기를 퍼뜨리고 "
"있었습니다. 자기네들 말로는 심부의 대변자들(Speakers of the Depths)인지 뭔지라고 하더라고요. 신자들도 몇 명 모은 "
"상태인 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0006_Text
#. Speaker : Capital_Tsanna
msgctxt "a9c6cd3b-cf9d-4f5a-8c51-328de320a43e"
msgid ""
"\"It is only natural that his pathetic cult soon comes to an end – losing "
"its followers to other, more powerful deities. However, if you allow him to "
"preach freely without fear, this would send a message to adepts of other... "
"neglected cults. They too might emerge from the shadows and flock to you for "
"protection. You might make use of the stronger ones. As for the weak and "
"futile... I shall deliver upon them the wisdom of Mother "
"{g|Lamashtu}Lamashtu{/g}, and take them under my wing.\""
msgstr ""
"\"그 비참한 사교는 분명 곧 끝날 게 분명하다. 신자들을 다른 더 강한 종교에 빼앗기면서 말이지. 하지만 이렇게 우리 땅에서 자유롭게 "
"선교하게 내버려둔다면... 무시받던 다른 사교들도 가세할 거다. 그들도 똑같이 어둠 속에서 일어나 당신에게 보호를 요청하겠지. 보다 "
"강력한 신을 무기삼아라. 약하고 무력한 자들에겐... 내가 어머니 {g|Lamashtu}라마슈투{/g} 의 지혜를 가르쳐주고 우리 편으로 "
"삼겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0011_Text
#. Speaker : Capital_Jhod
msgctxt "5394cc97-7850-4cc6-812b-304d27084a20"
msgid ""
"{n}Jhod is annoyed and mumbles something, but then waves his hand with a "
"sigh.{/n} \"As you wish.\""
msgstr "{n}조드는 짜증과 함께 무언가를 중얼거렸지만, 이내 손사래를치며 한숨을 쉬었다.{/n} \"원하시는 대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0012_Text
#. Speaker : Harrim_Companion
msgctxt "dbd0fd45-da30-4fa0-aeb7-d9247278a647"
msgid ""
"\"Your decision is merciful. I shall inform him that he has your permission."
"\""
msgstr "\"자비로운 결정이십니다. 허락을 받았다고 알리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0013_Text
#. Speaker : Capital_Tsanna
msgctxt "5820bdba-2773-4baf-b23d-6858b89e3627"
msgid ""
"{n}Tsanna sighs.{/n} \"Very well. {g|Lamashtu}Lamashtu{/g} respects those "
"who appreciate... diversity.\""
msgstr ""
"{n}산나는 한숨 쉬었다.{/n} \"좋아. {g|Lamashtu}라마슈투{/g} 께서는... 다양성을 인정하는 사람을 존중하시니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0014_Text
#. Speaker : Capital_Jhod
msgctxt "a349514f-972e-45c1-b300-56030e8e9691"
msgid ""
"{n}Jhod nods in content.{/n} \"Well said! There are simply too many of "
"those... ugh!\""
msgstr "{n}조드는 만족감에 끄덕였다.{/n} \"잘 말씀하셨습니다! 놈들은 분명 너무 많지요... 으으!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0015_Text
#. Speaker : Harrim_Companion
msgctxt "88b66c08-9f97-4af7-8012-36c23769e6b6"
msgid ""
"\"A pity, truly a pity. I shall inform him of your decision and send him on "
"his way.\""
msgstr "\"안타깝고도 안타깝도다. 그에게 당신의 결정을 전하고 보내버리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0016_Text
#. Speaker : Capital_Tsanna
msgctxt "0fc7f76a-a3eb-47b3-9a26-c300b9567d99"
msgid ""
"{n}Tsanna sighs.{/n} \"As you desire. Perhaps your pack is not disciplined "
"enough to accept what they cannot understand. You should resort to the whip "
"more often.\""
msgstr ""
"{n}산나는 한숨쉰다.{/n} \"원한다면. 어쩌면 네 무리는 이해할 수 없는 것을 받아들이기엔 교육이 덜 되었는지도 모르지. 채찍을 좀 "
"더 들길 바라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0018_Text
#. Speaker : Capital_Jhod
msgctxt "38cf5af2-0bdb-4913-bda4-d5d1873f40a3"
msgid ""
"{n}Jhod freezes, astonished.{/n} \"{mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}, I am not glad to suffer such guests myself – but an "
"execution? As you wish, of course, but...\" {n}Rather than finishing his "
"thought, Jhod just silently shakes his head.{/n}"
msgstr ""
"{n}조드는 놀라서 그 자리에 얼어붙었다.{/n}\"{mf|영주님|영주님|전하|전하}, 저도 저런 손님이 달가운건 아닙니다만, "
"사형이라뇨? 몰론 분부대로 하겠습니다만...\"{n}생각을 정리하지 못하고, 조드는 그저 조용히 고개를 저을 뿐이다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0019_Text
#. Speaker : Harrim_Companion
msgctxt "2861a41f-a112-456c-b25b-ba2549b866d9"
msgid ""
"{n}Harrim lowers his head in grief.{/n} \"There is an end to all things, but "
"to bring death upon someone just because of their faith? This is hasty and "
"unwise.\""
msgstr ""
"{n}하림은 비통해하며 고개를 떨굽니다.{/n} \"모든 것에는 끝이 있는 법이네만, 누군가를 그의 신앙 때문에 사형에 처한다니? 이건 "
"경솔하고 현명하지 못하네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0020_Text
#. Speaker : Capital_Tsanna
msgctxt "aacc561a-126c-4bd4-85a6-ec6c1fdf82ef"
msgid ""
"{n}Tsanna flexes her fingers.{/n} \"As you wish. But beware. Should your "
"people show such unkindness to my pack, their warm blood shall water the "
"ground. And we shall feast on their tasty fat... Their sweet, ivory fat.\""
msgstr ""
"{n}산나가 손가락을 굽히며 말했다.{/n} \"분부대로 하죠. 하지만 조심하시길. 만일 당신이 우리에게 무례한 태도를 보인다면, 그 "
"속에 든 따끈한 피가 땅을 적실 거라 일러두고 싶군요. 우리는 여남은 살코기로 포식하겠죠. 달착지근한 우윳빛 지방이 붙어있길 바라요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0021_Text
#. Speaker : Capital_Jhod
msgctxt "5a0617f7-61ea-4161-884d-99e66eafb472"
msgid ""
"\"Really? Very well. Then let him leave the "
"{mf|barony|barony|kingdom|kingdom} forthwith – we've enough trouble without "
"these Speakers!\""
msgstr ""
"\"정말인가요? 좋습니다. 그가 {mf|남작령|남작령|왕국|왕국}을 떠나게 만들죠 - 그 선교자들 때문에 문제가 이만저만이 아니었으니까요!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0022_Text
#. Speaker : Harrim_Companion
msgctxt "e75a2bf0-7fe6-41ec-a37c-9e3d96ddc0b8"
msgid ""
"\"Then he shall receive the High Priest's permission. Let him bring his word "
"to those who have yet to find solace in the face of the inevitable.\""
msgstr "\"그에게 대사제의 허가를 내리도록 하겠네. 아직 종말에서 위안을 받지 못한 자들을 위해 선교를 하게 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0023_Text
#. Speaker : Capital_Tsanna
msgctxt "a5d72ccd-44d2-4e79-901a-aa01f440aaaa"
msgid ""
"\"I agree. The preacher will continue his travels. My pack will keep an eye "
"on him – and his flock. In the end, they may come to prefer "
"{g|Lamashtu}Lamashtu{/g} to their strange idols.\""
msgstr ""
"\"알겠다. 선교자는 여정을 계속 할 것이다. 우리 무리가 그와 그 부하들을 지켜볼 것이다. 나중엔 {g|Lamashtu}라마슈투{/g} "
"의 품으로 다가오겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0025_Text
#. Speaker : Capital_Jhod
msgctxt "77a39875-05a5-45e5-a741-2c67847f3487"
msgid ""
"{n}The priest ponders.{/n} \"I know many gods. Some of them show favor to "
"mortals, some show wrath. But some want nothing to do with the peoples of "
"{g|Golarion}Golarion{/g}. The Speakers of the Depths may be of this sort – "
"who knows? All the more reason to prevent your subjects' heads to be filled "
"with this rubbish.\""
msgstr ""
"{n}사제는 끄덕였다.{/n} \"전 수많은 신을 알고있습니다. 어떤 신은 필멸자들에게 호의적이며, 어떤 신들은 분노를 표출하지요. "
"하지만 어떤 신들은 {g|Golarion}골라리온{/g} 의 사람들에 아무런 관심이 없지요. 심부의 대변자들(Speakers of the "
"Depths)도 이런 부류일지 누가 압니까? 그러니 더더욱 백성들의 머릿 속이 이런 쓰레기로 가득차는 것을 막아야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0026_Text
#. Speaker : Harrim_Companion
msgctxt "e1a28893-6f1f-463d-bf89-db84b0b92e4d"
msgid ""
"{n}Harrim shakes his head.{/n} \"The world is full of amazing gods, {name}, "
"but there are some strange things one should never touch. The Speakers of "
"the Depths may be harmless, or they may hold the key to the gate of "
"destruction. Death and oblivion await us all, either way. – So why fear the "
"inevitable and plot against those who are different from you?\""
msgstr ""
"{n}하림은 머리를 흔들었다.{/n} \"세상은 놀라운 신들로 가득하다네, {name}. 하지만 사람이 손대서는 안 될 이상한 것들도 "
"있지. 심부의 대변자들(Speakers of the Depths)는 무해할 수도 있고, 아니면 파멸로 가는 중요한 열쇠를 쥐고있을 지도 "
"모르네. 죽음과 망각, 어느쪽이든 결국엔 우리를 기다리고 있네. 그러니 자네와 관련없는 자들을 향한 피할 수 없는 운명과 음모에 대해서 "
"두려워할 필요는 없지 않은가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank3/Cue_0027_Text
#. Speaker : Capital_Tsanna
msgctxt "f8c1e591-5dbd-4c21-bc54-39863f6e26b4"
msgid ""
"{n}Tsanna considers the question for a few seconds.{/n} \""
"{g|Lamashtu}Lamashtu{/g} has revealed much to me. But I have never heard of "
"the Speakers of the Depths. Perhaps they have been careful to avoid becoming "
"famous. Or perhaps they are too pathetic to capture our attention.\""
msgstr ""
"{n}산나는 질문을 몇 초간 생각했다.{/n} \"{g|Lamashtu}라마슈투{/g} 께선 제게 많은 것을 가르쳐주셨죠. 하지만 심부의 "
"대변자들(Speakers of the Depths)라는 족속들은 들어본 적이 없어요. 인기를 얻기 전에 조심해둬야 할 부류인지도 "
"모르지요. 아니면 우리가 신경쓰기엔 너무 비천한 존재일지도.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Answer_0011_Text
msgctxt "f0131900-d0a8-44aa-92cc-0fb54c508a6b"
msgid ""
"{g|Divine4_1}[Choice effects]{/g} [Pay 100 BP] \"We shall build this library "
"of magic. It will spur the development of mystical arts.\""
msgstr ""
"{g|Divine4_1}[선택 시 효과]{/g} [100 BP 지불] \"마법 도서관을 짓도록 하세. 마법학 발전에 원동력이 되겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Answer_0012_Text
msgctxt "f2752701-702b-43e3-87e8-1783cef244b4"
msgid ""
"\"We can do without a magic library. There are more urgent matters before us."
"\""
msgstr "\"마법 도서관은 없어도 되네. 그보다 더 시급한 문제들이 많아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Answer_0013_Text
msgctxt "14ad9b61-f2c0-48aa-b3ce-56395df2cbdf"
msgid "\"Why don't you decide?\""
msgstr "\"자네가 정하는 건 어떤가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_0001_Text_String
#. Speaker : Capital_Jhod
msgctxt "cb5aebbd-f889-43bf-8934-1210988d2150"
msgid ""
"{n}The priest sighs heavily.{/n} \"As you wish. But with "
"{g|Erastil}Erastil{/g} as my witness, this will not lead to much good.\""
msgstr ""
"{n}사제는 무거운 한숨을 내뱉었다.{/n} \"원하시는 대로. 하지만 제가 보아온 {g|Erastil}에라스틸{/g} 사제들을 보건데, "
"좋은 결과가 있진 않을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_0002_Text
#. Speaker : Capital_Tsanna
msgctxt "b0c69db9-d0c3-4d99-ba72-79038167ee8c"
msgid ""
"{n}Tsanna pats her rat gently. Her rat's grey body is swollen, as if it were "
"carrying a brood of twin-headed beasts.{/n} \"Your pack grows like rabbits, "
"and your mages multiply along with the rest. You should find yourself an "
"advisor, a Magister, to look after these spellcasters and keep them on a "
"tight leash. You might find my methods for establishing order too rough.\""
msgstr ""
"{n}산나는 점잖게 자신의 쥐를 쓰다듬었다. 쥐의 회색 몸은 마치 머리 둘 달린 짐승들을 배고있는 것 마냥 부풀어있었다. {/n} "
"\"그대의 무리는 마치 토끼처럼 번식하는군요. 그리고 마법사들도 나머지를 따라서 늘어나고 있어요. 보좌관인 마법대신(Magister)이 "
"필요할 거예요. 이 마법사들을 돌보고 엄격하게 다뤄줄 사람을 말이죠. 제 방식대로 하면 좀 지나치게 빡빡하지 않을까 싶어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_0003_Text
#. Speaker : Capital_Tsanna
msgctxt "29f321b5-3f22-4cc8-b522-01da45f03bc0"
msgid ""
"\"Speaking of spellcasters. A few worshipers of {g|Nethys}Nethys{/g} have "
"traveled here from {g|Absalom}Absalom{/g}. They await you in the hallway. "
"They seek to construct a library of magic in your capital, to make it a "
"center of sacred knowledge for all the {g|River Kingdoms}River Kingdoms{/g}. "
"Were I in your place, I would say yes. Such power might come in handy in "
"making your subjects more... open-minded about the worshipping of Lamashtu.\""
msgstr ""
"\"주문시전자들에 대해 말인데요. {g|Nethys}네서스{/g} 의 숭배자들 몇몇이 {g|Absalom}압살롬{/g} 에서 찾아왔어요. "
"복도에서 대기하고 있더군요. 수도에 마법 도서관을 지어 우리의 수도를 온 {g|River Kingdoms}강의 왕국들{/g}의 성스러운 "
"지식의 전당으로 만드려 하더라고요. 저 같으면 동의하겠습니다. 만약 그렇게 되면 백성들이 좀 더... 라마슈투를 섬기는 데 있어 열린 "
"마음으로 다가설 수 있을 테니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_0004_Text
#. Speaker : Harrim_Companion
msgctxt "9527c524-5c0d-4d37-aaa5-c7202a2ddbc4"
msgid ""
"{n}Harrim broods and mumbles, then clears his throat.{/n} \"Listen, {name}. "
"I wish to give you some advice: find another advisor who can deal with "
"affairs of magic. The {mf|barony|barony|kingdom|kingdom} will struggle "
"without a Magister. It is dangerous to leave such important issues "
"unattended.\""
msgstr ""
"{n}하림은 혼잣말을 중얼거리며, 목청을 가다듬었다.{/n} \"이보게, {name}. 내 조언 좀 하지. 마법 일을 다룰 수 있는 다른 "
"보좌관을 구하게. {mf|남작령|남작령|왕국|왕국}에 마법대신이 없다면 힘들 걸세. 이런 중요한 문제를 돌보지 않으면 위험하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_0005_Text
#. Speaker : Harrim_Companion
msgctxt "d647b924-e451-4b01-9d88-f1e43b6b7afc"
msgid ""
"\"Before you appoint someone for this position, I will take upon myself this "
"final case, involving wizards and other spellcasters. A group of "
"{g|Nethys}Nethys'{/g} priests have arrived at your court, to propose an "
"amazing thing: founding a library of magic – here, in the capital. Your "
"barony would gain a valuable store of knowledge, that would otherwise fade "
"into darkness. I believe this deed is worthy of you and your "
"{mf|barony|barony|kingdom|kingdom}.\""
msgstr ""
"\"이 자리에 누구든 임명하기 전에는 마법사와 다른 주문시전자들에 대해선 내가 알아서 하도록 하지. {g|Nethys}네서스{/g} 의 "
"사제들이 궁성에 도착애서 멋진 제안을 해왔다네. 마법 도서관을 짓자는 것 말일세. 바로 여기, 수도에 말이야. 자네 영지에 귀중한 마법 "
"지식이 많이 쌓일 걸세. 거절하면 모두 어둠 속으로 잊혀지겠지. 이건 자네와 자네 {mf|남작령|남작령|왕국|왕국} 모두에 좋은 일일 "
"걸세.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_0006_Text
#. Speaker : Capital_Tsanna
msgctxt "ba8e5806-0822-4274-b730-802cec19635c"
msgid ""
"\"I agree. I will convey your message to the priests of {g|Nethys}Nethys{/g}."
"\""
msgstr "\"알겠네. 자네의 말을 {g|Nethys}네서스{/g}의 사제들에게 전하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_0007_Text
#. Speaker : Capital_Jhod
msgctxt "2746884d-dce9-4ede-9347-ca58dbeb63a6"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, I... we need "
"another advisor, who is equipped to deal with issues of magic. In the past I "
"have spent some of my time on these affairs, but now the population of the "
"{mf|barony|barony|kingdom|kingdom} – and my congregation – has grown so much "
"that I simply cannot handle the extra responsibility!\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 보좌관이 더... 필요합니다. 마법에 대해 해박한 보좌관 말입니다. 옛날엔 저도 이런 일을 좀 "
"다뤄봤지만, 지금은 {mf|남작령|남작령|왕국|왕국}의 인구도, 제 신도들도 너무 많아져서 더 이상은 감당할 수 없는 지경에 이르렀습니다!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_0008_Text
#. Speaker : Capital_Jhod
msgctxt "f0d623cd-825b-4106-b48b-585aae316d9d"
msgid ""
"\"Oh, and another thing: a delegation of {g|Nethys}Nethys{/g} worshipers has "
"come to us from {g|Absalom}Absalom{/g}. They've dragged a miniature of some "
"magical library with them. They say they want to build it here, in your "
"capital. If I were you, I'd send them back the way they came. – We've enough "
"on our plate without the crazy projects of a crazy god.\""
msgstr ""
"\"아, 한 가지 더. {g|Nethys}네서스{/g} 신봉자들의 대표가 {g|Absalom}압살롬{/g}에서 찾아왔습니다. 마법 "
"도서관의 소형 견본을 가져왔더군요. 여기, 우리의 수도에 짓는 걸 허락해달라고 합니다. 저라면 그 자들을 돌려보낼 것 같습니다. 정신나간 "
"신을 위한 정신나간 계획은 더 없어도 그만이거든요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_0009_Text
#. Speaker : Harrim_Companion
msgctxt "72ead3ef-0c8f-43fa-ab7a-6dbc984dd351"
msgid ""
"\"I will immediately pass this news to the priests of {g|Nethys}Nethys{/g}.\""
msgstr "\"즉시 {g|Nethys}네서스{/g}의 사제들에게 소식을 전하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_0014_Text
#. Speaker : Capital_Jhod
msgctxt "663b5df4-5373-4cef-960c-24f4e1a63841"
msgid ""
"{n}Jhod nods.{/n} \"Don't worry about what to tell them. I'll find the right "
"words. The priests of {g|Nethys}Nethys{/g} will see their folly and leave in "
"peace.\""
msgstr ""
"{n}조드는 끄덕였다.{/n} \"뭐라 얘기할 지에 대해선 걱정하지 마십시오. 제가 적당히 말을 전할 테니까요. "
"{g|Nethys}네수스{/g} 의 사제들은 자신들의 어리석음을 깨닫고 평화롭게 떠날 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_0017_Text
#. Speaker : Capital_Jhod
msgctxt "e7a41d84-2891-4ad3-b9ce-302aa03c1299"
msgid ""
"\"Well, then there shan't be any {g|Nethys}Nethys{/g} archives in the "
"capital. We can do just fine without them.\""
msgstr ""
"\"음, 그렇다면 {g|Nethys}네서스{/g}의 기록보관소는 수도에 짓지 않게 되겠군요. 저들 없이도 우리는 잘 해낼 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_0018_Text
#. Speaker : Harrim_Companion
msgctxt "167996a1-c144-42bc-9e8a-39d13aafe435"
msgid "\"I will agree to the project.\" {n}Harrim bows slightly.{/n}"
msgstr "\"난 그 계획에 찬성하겠네.\" {n}하림은 가볍게 목례했다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_0019_Text
#. Speaker : Capital_Tsanna
msgctxt "f654205c-ddd8-4bbd-ae6a-eea1b25df781"
msgid ""
"\"I will inform the priests of {g|Nethys}Nethys{/g}s that we accept their "
"offer.\""
msgstr "\"{g|Nethys}네서스{/g}의 사제들에게 제의를 받아들이겠다고 전하겠어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_HarUnh_Text_String
#. Speaker : Harrim_Companion
msgctxt "25957185-b234-44b1-afb0-a810e217cbdb"
msgid ""
"{n}The dwarf shakes his head slowly.{/n} \"Another step towards oblivion. "
"{g|Groetus}Groetus{/g} would be pleased, if he were with us now.\""
msgstr ""
"{n}드워프는 고개를 천천히 저었다.{/n} \"망각으로 가는 또 한 걸음이구나. {g|Groetus}그로투스{/g}께서 함께하신다면 "
"분명 기뻐하실 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Cue_TsannaUnhappy_Text_String
#. Speaker : Capital_Tsanna
msgctxt "8990d90d-3249-4cd4-93ae-9b031772e0d3"
msgid ""
"\"I see no reason to reject this opportunity. This meat is ripe. To let it "
"rot is senseless waste.\""
msgstr ""
"\"이 기회를 거절할 이유가 없어보입니다. 과즙이 뚝뚝 떨어지는 고기나 다름없어요. 이게 썩어가도록 내버려둔다면 어리석은 짓이겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Djodbye_String
#. Speaker : Capital_Jhod
msgctxt "46b739f9-e675-4425-89fc-65d1719aff72"
msgid ""
"\"Let me be frank, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. "
"I've been in this position for too long, and each day I feel more worthless. "
"You should find yourself another High Priest – someone more flexible. As for "
"me, I am too old to argue, or play your tutor now and again.\" {n}The priest "
"bows and turns away.{/n}"
msgstr ""
"\"솔직히 말하겠습니다, {mf|영주님|영주님|전하|전하}. 이 자리에 앉아온지도 너무 오래 되었습니다. 그리고 매일같이 쓸모없어지는 "
"느낌만 들어요. 다른 대사제를 찾아보시길 바랍니다. 보다 유연한 사람을 말이죠. 전... 저는 당신과 토론하거나 가끔씩 교사 노릇을 "
"하기엔 너무 늙어버리고 말았어요.\" {n}사제는 몸을 숙이고는 떠나버렸다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank4/Harrimbye_String
#. Speaker : Harrim_Companion
msgctxt "5434bf32-d5e6-48cb-af9c-3210dc9eb564"
msgid ""
"\"Enough, {name}. I have taken a position I am unfit for, and I cannot be "
"burdened by our arguments any longer. I am your High Priest no more. May you "
"find someone more to your liking.\""
msgstr ""
"\"그만하게, {name}. 난 내 분에 넘치는 자리에 앉아있었어. 더 이상은 이 짐을 지고싶지가 않군. 난 더이상 그대의 대사제가 "
"아니네. 마음에 드시는 다른 사람을 찾아보시게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank5/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "9b0d0b29-13ee-48a8-8415-4bea77c56ac8"
msgid ""
"{n}Jhod blushes, then turns pale, his fingers trembling.{/n} \"{mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}, blasphemy awakens in your "
"domain! I hear rumor of a cult that pretends to worship "
"{g|Erastil}Erastil{/g} – but the faith they practice is nothing I recognize! "
"According to them, my god demands blood sacrifices to make the forest "
"fertile and strong. The cultists walk the forest with bows, shooting any who "
"pass on sight!\""
msgstr ""
"{n}조드는 얼굴이 붉으락 푸르락 해지며, 손가락을 떨고있다.{/n} \"{mf|영주님|영주님|전하|전하}, 영토 내에 신성모독이 "
"벌어지고 있습니다! {g|Erastil}에라스틸{/g} 의 신도인 척 하는 사교도들에 대한 소문을 들었습니다. 그들의 예배는 제가 아는 "
"그 어떤 예배와도 달라요! 그자들 말에 따르면 에라스틸께서 숲을 비옥하고 강하게 만들기 위해 피의 희생을 원하신다고 합니다. 이 "
"사교도들은 활을 들고 숲을 누비며, 눈에 보이는 누구든 쏴 죽여대고 있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank5/Cue_0002_Text
#. Speaker : Harrim_Companion
msgctxt "18aa13d1-adf8-497e-9eeb-0d449b53746a"
msgid ""
"\"{name}, I have curious news. Rumor has it that there is a cult in your "
"lands that twists the teachings of {g|Erastil}Erastil{/g}. They say the "
"forests are depleted, and the god demands blood sacrifices to restore the "
"power of the woods. They paint their faces and kill anyone they come across "
"in the forest. Of course, Erastil's worshipers condemn this new cult, and "
"expect you to deal with it decisively.\""
msgstr ""
"\"{name}, 이상한 소문이 들려오고 있어. {g|Erastil}에라스틸{/g} 의 가르침을 곡해하는 사람들이 이 땅에 있다는 "
"소문이야. 이들은 숲이 줄어들었고, 이를 복구시키기 위해 숲을 위한 피의 희생을 요구한다고 해. 이들은 얼굴에 분칠을 하고 다니며 숲을 "
"지나는 누구든지 죽여대고 있어. 물론, 에라스틸 신도들은 이 사교도들을 비난하고 있고 말이지. 그리고 네가 적절하게 이 상황을 해결해주길 "
"바라고 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank5/Cue_0003_Text
#. Speaker : Capital_Tsanna
msgctxt "5007f73b-e53a-4095-9e88-cf2d3a913a84"
msgid ""
"{n}Tsanna looks pleased and excited. Her rat stirs restlessly on her "
"shoulder.{/n} \"{name}, you should be informed of a cult that sows unrest in "
"the forest. They worship {g|Erastil}Erastil{/g}, but do not follow the "
"common faith. They claim their god demands blood sacrifices to restore "
"strength to the fading forest. The cultists paint their faces and hide "
"amongst the trees, armed with bows. Every passerby is marked for death.\""
msgstr ""
"{n}산나는 기쁘고 흥분한 기색이다. 그녀의 쥐는 쉼없이 그녀의 어깨 위에서 부산을 떨고있다.{/n} \"{name}, 숲에서 불안을 "
"야기하는 사교도들에 대한 소식 들었을 거예요. 이들은 {g|Erastil}에라스틸{/g} 을 따르는 데, 평범한 교리대로 살고있지 "
"않아요. 이들은 자신들의 신이 사라져가는 숲을 되살리기 위해 피의 희생을 요구한다고 말하고 있어요. 이들은 얼굴에 분을 칠하고 다니며 "
"활로 무장해 숲에 숨어있다고 해요. 지나는 모든 사람을 죽여대며 말이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank5/Cue_0025_Text
#. Speaker : Capital_Jhod
msgctxt "7ab4c8f1-1429-4930-938a-2a2027df2545"
msgid ""
"\"These impostors must be stopped! Their bloodlust and blasphemy ill become "
"us! Some would appoint the General and unleash havoc upon them. The "
"Treasurer might bribe them with gold, that they might leave our domain. Heed "
"my advice. Bring this case to the Councilor. Public condemnation on your "
"behalf will turn people away from this vile cult!\""
msgstr ""
"\"이 사기꾼들을 잡아야합니다! 이들이 가진 피의 갈증과 신성모독은 우리에게 독이 될 겁니다! 장군을 파견해 저들을 모조리 척살해야 "
"합니다. 재무관이 뇌물을 줘서 남작령을 떠나게 할 수도 있지요. 제 조언을 들어주십시오. 의회에서 이를 상의해야 합니다. 대중의 비난이 "
"사람들을 사교로부터 지킬 수 있으니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank5/Cue_0026_Text
#. Speaker : Harrim_Companion
msgctxt "bd35ee39-9b69-4978-85a1-1f98f50d1aec"
msgid ""
"\"It is up to you whether you will order your General to send in forces, or "
"condemn this new cult through your Councilor. You may even ask your "
"Treasurer to pay a ransom, in hopes they will leave.\" {n}Harrim clenches "
"his beard in his fist and gives you a sidelong look.{/n} \"It is for you to "
"decide.\""
msgstr ""
"\"장군과 군대를 보내 이들을 처리할지, 아니면 의회를 통해 이들을 비난할 지는 모두 자네에게 달려있다네. 재무관에게 몸값을 줘서 "
"떠나도록 하게 할 수도 있지.\" {n}하림은 수염을 꽉 쥐더니 당신을 곁눈질로 바라본다.{/n} \"자네가 결정할 사안이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank5/Cue_0027_Text
#. Speaker : Capital_Tsanna
msgctxt "7fda78c4-200f-4e75-812e-cd689dfd8a8e"
msgid ""
"\"I'd allow these madmen, but you can hardly afford it. You wouldn't want to "
"engage in this matter personally. Order one of your advisors to deal with "
"it. You might rely on your Councilor's grand rhetoric, or your Treasurer's "
"gold – or even your General's packs... You are ruler here. It is you who "
"must decide.\""
msgstr ""
"\"나라면 이 미치광이들을 허용하겠지만, 자네는 감당하기 어려울테지. 이번 일에 개인적으로 말려들지 말게. 장관 중 하나에게 이를 맡겨 "
"처리하게 하는 거야. 의회의 의사를 물어보거나, 재무관의 돈으로 해결할 수도 있고. 아니면 장군의 부대를 보내거나... 이곳의 지도자는 "
"자네일세. 결정자도 자네인 거지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Answer_0005_Text
msgctxt "0679f8b6-6cd7-41ae-8bd7-ec2a47c014da"
msgid ""
"{g|Divine6_1}[Choice effects]{/g} \"Let these cultists find a new home for "
"themselves beyond our borders.\""
msgstr "{g|Divine6_1}[선택 시 효과]{/g} \"이 사교도들을 우리 국경 바깥으로 내보내버려라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Answer_0006_Text
msgctxt "6da60950-5810-436a-ab3a-27ff6399b8e8"
msgid ""
"{g|Divine6_2}[Choice effects]{/g} \"Those villagers had better settle down. "
"That coven harmed no one. The followers of this strange religion have "
"nothing to fear from me.\""
msgstr ""
"{g|Divine6_2}[선택 시 효과]{/g} \"그 주민들을 정착시키라. 이들의 집회는 아무도 다치게 하지 않았다. 이 수상한 종교의 "
"숭배자들은 내게 두렵지 않다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Answer_0007_AlignmentShift.Description
msgctxt "96b98e73-db44-48ed-a808-72d3c98db981"
msgid "Let Tsanna secretly destroy the peaceful cult."
msgstr "산나가 비밀스레 그 사교를 와해시키도록 허락한다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Answer_0007_Text
msgctxt "80e6d900-12b0-44a1-86d4-999d81fa3930"
msgid "{g|Divine6_3}[Choice effects]{/g} \"You may take them, Tsanna.\""
msgstr "{g|Divine6_3}[선택 시 효과]{/g} \"자네가 맡아주게, 산나.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Answer_0008_Text
msgctxt "b602b118-2dbe-48eb-a2e8-49a21c111c4b"
msgid "\"Work it out on your own.\""
msgstr "\"알아서 해결하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "0d4a7afb-f681-4500-ae9a-1c1cac8f283b"
msgid ""
"\"Sacrifice and murder haunts our forests, and your subjects grow suspicious "
"of the other cults. There was a clash between some villagers and a small "
"coven possessing a couple dozen followers. That coven is perfectly peaceful, "
"though nonetheless strange. Its followers remain silent for their entire "
"lives. They believe that words and conversation invite madness.\""
msgstr ""
"\"희생과 살인이 우리의 숲에 깃들었습니다. 사교에 대한 백성들의 의심이 짙어지고 있습니다. 마을 사람 몇 명과 작은 사교단체 사이에 "
"신자들을 두고 싸움이 벌어졌습니다. 그 사교 단체는 정말이지 평화롭습니다. 그렇지만 수상하기도 합니다. 그 추종자들은 일생동안 말을 하지 "
"않으려 합니다. 대화와 말이 광기를 유발한다고 믿고있기 때문입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Cue_0002_Text
#. Speaker : Harrim_Companion
msgctxt "fd3b1ebd-b7ba-48bb-865f-5659b1810f5f"
msgid ""
"\"A number of innocents require your protection, {name}. After suffering "
"much bloodshed in the name of {g|Erastil}Erastil{/g}, our peasants have "
"begun casting a suspicious eye on followers of other religions as well. The "
"more inscrutable the faith, the more unpredictable and dangerous the cult "
"seems. There have been clashes with a small coven of silentiaries, whose sin "
"is very minor indeed: they believe that speech is dangerous, fearing it "
"leads to madness.\""
msgstr ""
"\"무고한 자들이 보호를 요청하고 있어, {name}. {g|Erastil}에라스틸{/g} 의 이름 하에 벌어진 그 참살극 아래, 우리 "
"백성들이 다른 종교에도 의심스러운 눈초리를 거두지 않고 있어. 그 신앙을 믿기 어려운 만큼, 이 사교들의 행동거지도 예측 불가에 "
"위험해져가고 있어. 말은 사람을 광기로 몰아가기에 위험하다는 사상을 가진 작은 교단 사이에서 싸움이 벌어지기도 했지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Cue_0003_Text
#. Speaker : Capital_Tsanna
msgctxt "e86ea0e1-765e-4c9d-9104-d2f760183f67"
msgid ""
"\"{name}, the murders committed by {g|Erastil}Erastil's{/g} renegades have "
"led the peasants to see as threats anyone who holds strange beliefs. A "
"conflict has erupted around a small coven of silentiaries. These people are "
"savage, but nonetheless helpless. Their core belief is that speech is a "
"dangerous invention, leading to madness. They fear the spoken word, but they "
"never do harm to anyone.\""
msgstr ""
"\"{name}, {g|Erastil}에라스틸{/g} 의 변절자들이 벌인 살인 때문에 백성들이 수상한 종교를 믿는 사람이라면 의심부터 "
"하고있어. 침묵이 교리인 작은 교단과 사람들 간에 싸움도 일어났어. 이들은 미개하지만 무력한 사람들이야. 이들이 중점적으로 믿는 것은 "
"대화라는 게 위험한 발명품이며 사람들을 광기로 이끌어간다는 거야. 이들은 말만 안 할 뿐이지 아무도 다치게 한 적이 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Cue_0010_Text
#. Speaker : Capital_Jhod
msgctxt "2143931a-6749-4d98-b472-9a8fdd0af94e"
msgid ""
"{n}Jhod purses his lips stubbornly.{/n} \"We will ask them to leave – "
"politely, but firmly. I hope they will discover for themselves a better "
"faith along their journey.\""
msgstr ""
"{n}조드는 입술을 꼭 다물었다.{/n} \"떠나라고 하겠습니다. 공손하지만, 단호하게요. 떠나면서 더 나은 신앙을 가지길 빌겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Cue_0011_Text_String
#. Speaker : Harrim_Companion
msgctxt "401e3d56-d74e-4c23-97fb-0ff056af3f40"
msgid ""
"\"How sad. Everyone is always trying to demolish something, expel someone, "
"banish each other to dark oblivion. The world is full of fragile things, you "
"know. Today you're banishing a harmless coven... And no one will remember it "
"tomorrow. Ripped from their home, they will surely perish. Will we mark "
"their passing, or even care? Do you not see now why our whole world deserves "
"its fate?\""
msgstr ""
"\"참으로 슬프군. 모두들 항상 뭔가를 때려부수고, 누구를 내쫓고, 서로를 어두운 망각 속으로 쫓아내지 못해 안달이야. 자네도 알겠지만 "
"세상은 연약한 것들로 가득 차있네. 오늘 죄 없는 집단을 하나 내쫓았더군... 다음 날이면 아무도 그들에 대해서 기억하지 못하겠지. "
"고향에서 쫓겨나고, 분명 박해당할 테지. 과연 우리는 그들을 기억할까? 아니, 신경이라도 쓸지 궁금하군. 이제 왜 이 세계가 멸망해야하는 "
"지 알겠나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Cue_0012_Text_String
#. Speaker : Capital_Tsanna
msgctxt "7e54be60-898a-4031-b1d9-3cf7194dad6a"
msgid ""
"{n}Tsanna rolls her eyes. Her rat stares at you intently, squeaking "
"furiously from both of its throats.{/n} \"Will you truly banish anyone who "
"attracts the suspicion of your peasants? Who is the leader of your pack? You "
"– or they?\""
msgstr ""
"{n}산나는 눈알을 굴린다. 그녀의 쥐는 당신을 뚫어져라 바라보며, 맹렬하게 찍찍대고 있따.{/n} \"백성들을 불안하게 하는 사람이라면 "
"누구든 정말로 추방할 건가요? 이 무리의 우두머리가 누구인 거죠? 당신인가요? 아니면 백성인가요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Cue_0013_Text_String
#. Speaker : Capital_Jhod
msgctxt "f2b1ed43-c978-4f57-9306-ad0cdfbf5128"
msgid ""
"\"This will return to bite you later, Your Grace. You'll see… The moment "
"turn your attention away, they'll be back to make more trouble for you. I do "
"not understand why we should suffer these fools on our lands...\""
msgstr ""
"\"이 결정은 추후 분명 되돌아올 것입니다. 알게 되실 겁니다... 당신의 주의를 돌린 순간, 저들은 더 많은 문제를 일으키겠지요. 우리 "
"땅에서 이 바보들 때문에 왜 우리가 고통받아야하는 지 이해할 수가 없군요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Cue_0014_Text
#. Speaker : Harrim_Companion
msgctxt "3ef4cec3-4a44-4598-a921-050e82d26f2d"
msgid ""
"{n}Harrim runs his fingers through his beard with a smile.{/n} \"Leave the "
"coven be, and let the peasants learn to stop being so arrogant. It is good "
"to have a place in this world where the weak and the few in number can find "
"refuge and live in peace.\""
msgstr ""
"{n}하림은 손가락으로 수염을 쓰다듬으며 미소짓는다.{/n} \"그 집단을 내버려두고, 백성들이 거만하지지 않는 법을 배우도록 하게. "
"약하고 수도 얼마 없는 사람들을 위해 피난처와 평화로운 살 곳 하나쯤은 있어도 좋지 않은가.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Cue_0015_Text
#. Speaker : Capital_Tsanna
msgctxt "30b8c6f1-a571-4908-b389-43c490d1c735"
msgid ""
"{n}Tsanna curls her lips.{/n} \"As you wish. We'll see what happens to the "
"coven when you withdraw your guards. I should have claimed them. My pack "
"could have protected those animals.\""
msgstr ""
"{n}산나는 입을 삐쭉거렸다.{/n} \"원하시는 대로. 경비대를 물리면 어떻게 되는지 한번 보죠. 제가 이끌었으면 좋았을 텐데. 우리 "
"무리는 그 짐승들을 보호했을 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Cue_0018_Text
#. Speaker : Capital_Tsanna
msgctxt "98667643-8544-4ece-be5e-a19090a8efd8"
msgid ""
"{n}Tsanna openly flashes her wicked smile.{/n} \"Perfect. My pack will "
"gladly play... Or I should say... Accept this task.\""
msgstr ""
"{n}산나는 그 짓궂은 미소를 환하게 보였다.{/n} \"완벽해요. 제 무리가 잘 해낼 거예요... 아니, 이 일을 잘 해내겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Cue_0022_Text
#. Speaker : Capital_Jhod
msgctxt "a1a8d64c-76b9-45c9-95b4-652506912c11"
msgid ""
"\"Your people will remain on edge, so long as these fanatics remain. They "
"will not suffer such neighbors. – And to tell the truth, I stand by the "
"people. Should a friend or kin of mine join such a cult, I too would be "
"deeply troubled. I recommend you order this coven to leave from here, and "
"find a place where they are welcome.\""
msgstr ""
"\"이 광신도들이 남아있는 한, 당신의 백성들은 안절부절 할 겁니다. 저런 이웃이 있어선 안 되지요. 그리고 한 가지 말해주자면, 전 "
"백성들 편입니다. 저런 사교에 제 친구나 동족이 가입했더라면 저도 머리 좀 아팠을 거 같군요. 이 단체는 여기서 내보내고, 환영받는 "
"장소를 찾아보라고 하시죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Cue_0023_Text
#. Speaker : Harrim_Companion
msgctxt "ba13e79d-dfc5-4bd9-8413-66974f255493"
msgid ""
"\"They are to be beaten and banished merely for refusing to speak! They "
"surely did nothing wrong! These innocents are breaking no laws or "
"traditions! Tell your subjects to quiet their anger, and leave the peaceful "
"neighbors alone.\""
msgstr ""
"\"저들은 대화를 거절한 이유 하나 때문에 추방받고 박해받는 거야! 저들은 아무것도 나쁜 짓을 한 게 없다고! 이 무고한 사람들은 법이나 "
"전통에 아무런 해가 되지 않았단 말이네! 백성들에게 분노를 삭히고, 이 평화로운 이웃들을 내버려두라고 해주게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank6/Cue_0024_Text
#. Speaker : Capital_Tsanna
msgctxt "1e6e7024-27af-4f29-b0cc-84beeff78bb7"
msgid ""
"\"However, the peasants suspect them of all manner of nasty things, and wish "
"to be rid of them. We could rein them in, whip a few, and send them back to "
"work the earth, but this would in the end lead to massacre. We could expel "
"the coven, but this would send the message that anyone unwanted by the crowd "
"would be subject to the same treatment. But there is an easy way out: give "
"them to me. My pack will take their leaders from them, and rip out the "
"tongues of the others – since they're so fond of silence – and convert them "
"to {g|Lamashtu}Lamashtu{/g}. I shall ensure they don't bother anyone ever "
"again.\""
msgstr ""
"\"하지만, 백성들은 저들이 온갖 추잡스러운 짓의 근원이라고 생각하고 저들을 없애버고 싶어합니다. 사람들을 억제하고, 채찍도 좀 치면서 "
"일터로 보낼 수는 있습니다만, 이러면 결국 대학살로 끝이 나겠죠. 저 단체를 추방할 수도 있습니다. 하지만 이렇게 하면 백성들에 마음에 "
"안 드는 자는 모두 이런 취급을 받을 거란 암시를 주겠지요. 한 가지 쉬운 방법이 있긴 합니다. 저들을 제게 보내주세요. 제 무리가 "
"저들의 우두머리 자리를 빼앗고 다른 자들의 혓바닥을 뽑아버리겠습니다. 침묵을 그렇게나 좋아한다니 침묵하게 만들어줘야지요. 그리고 저들을 "
"{g|Lamashtu}라마슈투{/g} 교로 전향시킬 겁니다. 저들 때문에 더 이상 귀찮으실 일은 없을 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Answer_0003_AlignmentShift.Description
msgctxt "bc43ceba-7fd1-4f4f-819b-47dcf3063aa7"
msgid "Chose Cayden Cailean as one of the godly patrons of the kingdom."
msgstr "케이든 케일리엔을 왕국의 수호신으로 삼는다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Answer_0003_Text
msgctxt "c532d4c7-9368-4c9c-946d-01aa76e6535d"
msgid "{g|Divine7_1}[Choice effects]{/g} \"I prefer Cayden.\""
msgstr "{g|Divine7_1}[선택 시 효과]{/g} \"난 케이든이 더 좋군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Answer_0004_AlignmentShift.Description
msgctxt "35d6cb47-4f73-46ca-94ab-83e0cc763f83"
msgid "Chose Gorum as one of the godly patrons of the kingdom."
msgstr "고룸을 왕국의 수호신으로 삼는다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Answer_0004_Text
msgctxt "ed3747a6-b391-4f09-b37d-d840f5862b86"
msgid "{g|Divine7_2}[Choice effects]{/g} \"Let them build Gorum's temple.\""
msgstr "{g|Divine7_2}[선택 시 효과]{/g} \"고룸의 사원을 지으라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Answer_0005_AlignmentShift.Description
msgctxt "61c4e1de-0e0d-44e0-b0ae-1f791f72b5fa"
msgid "Chose Asmodeus as one of the godly patrons of the kingdom."
msgstr "아스모데우스를 왕국의 수호신으로 삼는다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Answer_0005_Text
msgctxt "a37cdb1c-ac66-4060-8a77-190eb668bd1f"
msgid ""
"{g|Divine7_4}[Choice effects]{/g} \"We shall allow the servants of Asmodeus "
"to set up a temple, regardless of our neighbors' opinion.\""
msgstr ""
"{g|Divine7_4}[선택 시 효과]{/g} \"이웃의 의견 따윈 상관 없다. 아스모데우스의 수하들로 하여금 신전을 짓게 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Answer_0006_Text
msgctxt "664df44e-311a-4caa-a6aa-1b215082acfe"
msgid "\"Why don't you suggest a temple to your own god?\""
msgstr "\"자네가 믿는 신의 신전을 지어달라고 하는 건 어떤가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Answer_0007_Text
msgctxt "0d48c8bd-1328-4d8a-887f-92a9784061c0"
msgid "\"Tell me about the gods.\""
msgstr "\"신들에 대해 이야기 해보라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Answer_0008_Text
msgctxt "df7b7012-3135-4355-b26c-8c23c454bd1f"
msgid "\"I'll trust your judgment.\""
msgstr "\"자네의 판단을 믿겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Answer_0041_AlignmentShift.Description
msgctxt "a8ea7552-1281-465e-aba0-5cdfc5ab98d6"
msgid "Chose Abadar as one of the godly patrons of the kingdom."
msgstr "아바다르를 왕국의 수호신으로 삼는다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Answer_0041_Text
msgctxt "84bd1463-3ac3-4c61-9dbd-7f707308226c"
msgid ""
"{g|Divine7_3}[Choice effects]{/g} \"I will allow Abadar's followers to erect "
"a temple in his honor.\""
msgstr "{g|Divine7_3}[선택 시 효과]{/g} \"아바다르의 사제들이 이 땅에 그의 명예를 세우는 것을 허락하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "8552b9bb-69b5-459a-84c6-f09b12f625a4"
msgid ""
"\"Your Highness! The fame of our domain is increasing. Many priests look to "
"erect their temples in the capital. The competition has stirred up no little "
"tension, and even some arguments!\""
msgstr ""
"\"전하! 우리 땅의 명성이 널리 퍼지고 있습니다. 수많은 사제들이 우리 수도에 자신들의 사원을 세우려고 합니다. 경쟁이 과해져서 "
"논쟁까지 벌어졌습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0009_Text
#. Speaker : Harrim_Companion
msgctxt "805412c4-c92e-4cfc-a3b2-091055025d58"
msgid ""
"\"{name}, the chronicles will remember you as a great {mf|king|queen}, not a "
"mere {mf|baron|baroness}. But even if you were an {mf|Emperor|Empress}, you "
"would still be wise to seek divine support. Four influential priests have "
"arrived at your court to plead for a temple honoring their gods.\""
msgstr ""
"\"{name}, 역사는 자네를 위대한 {mf|왕|여왕} 으로 기억할 테지. 단순한 {mf|영주|영주} 가 아니라.하지만 자네가 "
"{mf|황제|여제} 라 할 지라도, 신들의 도움은 필요하다네. 영향력 있는 네 명의 사제들이 궁성에 모여 각자 자신들의 사원을 세우게 해 "
"달라고 간청하고 있네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0010_Text
#. Speaker : Capital_Tsanna
msgctxt "527dd69c-253a-42da-a7ec-9972e5af484b"
msgid ""
"\"Your kingdom grows more famous by the hour, and many hope to take "
"advantage of this. Four gods are keen to lay their hands upon your domain – "
"or to grant you their patronage, to be precise. Priests of {g|Cayden "
"Cailean}Cayden{/g}, {g|Abadar}Abadar{/g}, {g|Gorum}Gorum{/g}, and "
"{g|Asmodeus}Asmodeus{/g} have each offered to build temples in the capital.\""
msgstr ""
"\"시간이 흐를 수록 당신의 왕국이 유명해지면서 이를 기회삼으려는 자들도 많군요. 네 명의 신들이 당신의 영토에 손을 얹으려 하고 "
"있습니다. 보다 정확히 말 하자면, 후원을 제공해주려고 그러는 것이지요. {g|Cayden Cailean}케이든{/g}, "
"{g|Abadar}아바다르{/g}, {g|Gorum}고룸{/g}, and {g|Asmodeus}아스모데우스{/g} 의 사제들이 각자 "
"찾아와서 수도에 사원을 짓고자 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0011_Text
#. Speaker : Capital_Jhod
msgctxt "6c907604-4922-4e79-9cbd-ac3d21657a25"
msgid "\"A little feasting and fun won't hurt this kingdom and its citizens.\""
msgstr "\"조금 축제 하면서 논다고 왕국과 국민들이 어디 가는 건 아니겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0012_Text
#. Speaker : Harrim_Companion
msgctxt "58cce624-2639-4f2a-855d-fc4079d25191"
msgid ""
"\"The Drunken Hero? The one who hopes to drink himself into oblivion rather "
"than face the inevitable end that comes even for him? I disapprove of your "
"decision, but I will not oppose you on this.\""
msgstr ""
"\"술 취한 영웅 말씀이야? 자기 자신에게조차 찾아올 종말을 망각하기 위해 술을 마셔댄다는 그 신? 결정이 내 마음에 들진 않는다만, "
"반대하지도 않겠네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0013_Text
#. Speaker : Capital_Tsanna
msgctxt "98b84723-26f8-44bf-b9e4-9706d1cf9568"
msgid ""
"\"{g|Cayden Cailean}Cayden{/g} may not be the worst option. Drunk people "
"cast off the shackles of decency and turn into primal beasts.\""
msgstr ""
"\"{g|Cayden Cailean}케이든{/g} 은 최악의 선택지입니다. 취한 사람들은 품위를 집어던지고 원시적인 짐승이 되어버리고 "
"마니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0014_Text
#. Speaker : Capital_Jhod
msgctxt "d0507f97-22bc-493d-9843-ba4e55094b8d"
msgid ""
"\"Are you certain that we need even more war and bloodshed? I'm afraid "
"{g|Gorum}Gorum{/g} does not promise security to our kingdom. On the "
"contrary, he will involve it in ever more battles.\""
msgstr ""
"\"정말로 이 땅에 더 많은 전쟁과 피가 필요하다고 보십니까? {g|Gorum}고룸{/g} 은 왕국의 안전과는 거리가 먼 신입니다. "
"오히려 더 많은 전쟁으로 이끌겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0015_Text
#. Speaker : Harrim_Companion
msgctxt "f208e48c-abd9-46a4-be76-dbe6ed49e469"
msgid ""
"\"I hope you will find satisfaction in his unforgiving patronage. He "
"determines the end that comes for us all... and even for he himself.\""
msgstr "\"그분의 자비없는 지원에 만족하길 바라네. 그분께서는 만물의 끝을 주관하지... 본인의 종말 또한.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0016_Text
#. Speaker : Capital_Tsanna
msgctxt "4cdbabe6-418a-472e-96e7-5327afc94d51"
msgid ""
"\"{g|Gorum}Gorum{/g} is ill-bred and cruel, but he's good in battle. At "
"least our enemies' swords will drink the blood of his followers, and not my "
"pack.\""
msgstr ""
"\"{g|Gorum}고룸{/g} 은 잔혹하고 예의를 모르지만, 전투에서는 뛰어나지요. 적어도 우리 적들의 칼은 고룸 신자들의 피를 "
"마시겠군요. 제 무리가 아니라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0017_Text
#. Speaker : Capital_Jhod
msgctxt "18ace146-14e8-4a6b-a282-5e931b09fc14"
msgid ""
"\"Summoning the god of law and tyranny to lands that have hosted chaos for "
"centuries... This is either very wise or very foolish.\""
msgstr "\"폭정과 법의 신을 몇 세기 동안 혼돈에 빠져있던 땅으로 소환한다라... 매우 현명하면서도 어리석은 결정이로군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0018_Text
#. Speaker : Harrim_Companion
msgctxt "65b53b73-bf41-4313-9dce-9211001b628b"
msgid ""
"\"An ambitious decision. A deal with {g|Asmodeus}Asmodeus{/g} promises "
"profit. But you must read the contract very carefully...\""
msgstr ""
"\"야심 넘치는 선택입니다. {g|Asmodeus}아스모데우스{/g} 와의 계약은 이득을 가져다주지요. 하지만 그 계약 조건을 잘 "
"읽어봐야 할 겁니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0019_Text
#. Speaker : Capital_Tsanna
msgctxt "ce012e55-831b-4fc2-a7a3-a5e1c348edfb"
msgid "\"Hmm... As you wish.\""
msgstr "\"흐음... 바라시는 대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0020_Text
#. Speaker : Capital_Jhod
msgctxt "2a818a42-6bf9-4cf8-a37d-594cf23e29a5"
msgid ""
"\"Why would I? Take a look around. This land is covered in forests. There "
"are plenty of deer in the thickets. Wildlife thrives in healthy lands, and "
"its people are decent and honest. This land is already under "
"{g|Erastil}Erastil's{/g} protection. Why would we need another temple?\""
msgstr ""
"\"내가 왜? 둘러봐. 이 땅은 숲으로 뒤덮여있어. 덤불 속에는 사슴이 뛰어다니고. 야생동물은 비옥한 땅에 번성하고, 하람들은 품위있고 "
"정직해. 이 땅은 이미 {g|Erastil}에라스틸{/g} 의 보호 아래 있어. 왜 사원을 또 지어야 하는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0021_Text
#. Speaker : Harrim_Companion
msgctxt "bf833214-2096-4580-a82e-efbf5d8b48d8"
msgid ""
"\"But why would I? All temples will eventually be destroyed. All of "
"{g|Groetus}Groetus'{/g} priests will turn to dust, like the priests of every "
"other god. There are few who can hear his whispers, and we are satisfied "
"with ruined temples to other gods...\""
msgstr ""
"\"왜 그래야 하지? 모든 사원은 결국 파괴될 터인데. {g|Groetus}그로투스{/g}의 모든 사제들도 결국은 먼지가 되어갈 "
"뿐이라네. 모든 신의 모든 사제들이 그러했듯. 그분의 말씀을 들을 수 있는 사람은 얼마 안 되고, 우리는 다른 사원들이 파괴된 모습만 "
"보면 만족한다네...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0022_Text
#. Speaker : Capital_Tsanna
msgctxt "fa63fabb-6f1d-4066-82a9-63c06189496a"
msgid ""
"\"So I could start looking for another refuge? As soon as "
"{g|Lamashtu}Lamashtu{/g} became patron of these lands, some righteous "
"paladin would be placed on your throne by common consent, while your head "
"would be placed on the tip of his lance. No, the time has not come. Yet.\""
msgstr ""
"\"다른 피난처를 찾아야 한다는 말인가요? {g|Lamashtu}라마슈투{/g} 께서 이 땅의 수호신이 되시면 곧바로 정의로운 성기사 "
"무리가 이구동성으로 당신의 목을 날려버리겠다며 옥좌로 달려올텐데. 아뇨. 아직 그럴 때는 오지 않았어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0023_Text
#. Speaker : Harrim_Companion
msgctxt "b6dac667-3c05-497a-b679-1cc30588507a"
msgid ""
"\"It is no coincidence that {g|Cayden Cailean}Cayden's{/g} nickname is the "
"Accidental God. He was a mortal, a deathly drunk mortal, when he became a "
"god. He doesn't even remember how it happened. Under Cayden, your subjects "
"will live happily but senselessly, spending their time in feasts and fairs.\""
msgstr ""
"\"{g|Cayden Cailean}케이든{/g}의 별명이 우연히 신이 된 자라는 데는 이유가 있어. 그는 필멸자였고, 정말 지랄맞은 "
"술주정뱅이였지, 신이 되었던 그 날조차 말일세. 심지어 어떻게 신이 되었는지도 기억하지 못한다는군. 케이든의 비호 아래, 자네의 백성들은 "
"행복하겠지만 무분별하게 살 것이며, 축제와 잔치를 여는 데 시간을 낭비할 테지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0025_Text
#. Speaker : Capital_Jhod
msgctxt "e05c4fd8-9455-47b7-81dc-0dd780adf3f5"
msgid ""
"\"{g|Cayden Cailean}Cayden{/g} loves freedom and the simple pleasures of "
"life. People feel at ease with him. They drink, have fun, and live an easy "
"life. He promotes feasts, fairs – and brewing!\""
msgstr ""
"\"{g|Cayden Cailean}케이든{/g} 께서는 자유와 단순한 삶의 쾌락을 사랑하십니다. 사람들은 그분과 함께 있을 때 편안함을 "
"느끼지요. 사람들은 마시고, 즐기며, 편한 생활을 삽니다. 그분께서는 축제와 잔치, 그리고 양조를 관장하시지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0026_Text
#. Speaker : Capital_Tsanna
msgctxt "148e93f1-c7cf-4752-a996-f5f36b3908f1"
msgid ""
"\"{g|Cayden Cailean}Cayden{/g} is the Accidental God. He loves everyone "
"having fun, and no one troubling anyone else. It sounds nice, but would you "
"really want your subjects always drunk, like their god?\""
msgstr ""
"\"{g|Cayden Cailean}케이든{/g} 은 우연히 신이 된 자입니다. 그는 모두가 즐거워하고 아무도 괴롭히지 않는 것을 "
"좋아하지요. 듣기엔 좋아보이지만, 그 신 처럼 백성들이 항상 주정이나 하고 다니면 그래도 마음에 들 것 같습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0027_Text
#. Speaker : Capital_Jhod
msgctxt "35551ebd-682b-4666-b5ea-efde9650f703"
msgid ""
"\"Then let {g|Abadar}Abadar{/g} ensure your people are civilized and "
"prosperous.\""
msgstr "\"그러면 {g|Abadar}아바다르{/g} 께서 당신의 백성들이 문명화되고 번영토록 만들게 하시지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0028_Text
#. Speaker : Harrim_Companion
msgctxt "566e3974-7d44-437c-837e-abc04c4675aa"
msgid ""
"\"Let {g|Gorum}Gorum{/g} carve his path of destruction through your city "
"gates, {name}. Why postpone the inevitable?\""
msgstr ""
"\"{g|Gorum}고룸{/g} 께서 가시는 파괴의 길이 당신의 성문을 통하게 하십시오, {name}. 피할 수 없는 것을 왜 미루려 "
"합니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0029_Text
#. Speaker : Capital_Tsanna
msgctxt "09a3442f-e6f3-44c9-a060-1ab245d3bd4f"
msgid ""
"\"I will make arrangements with the priest of {g|Gorum}Gorum{/g}. Let your "
"neighbors learn to accept that these are free lands, where we may worship "
"any god we choose, even one known to be 'violent' and 'dark'.\""
msgstr ""
"\"{g|Gorum}고룸{/g} 의 사제와 약속을 잡겠습니다. 이 땅이 자유로운 땅이며, 그 신이 '폭력적'이고 '어둡다' 할 지라도 "
"믿음의 자유를 보장하는 땅임을 알게 하시길.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0030_Text
#. Speaker : Capital_Tsanna
msgctxt "5bf68c7f-861e-4229-bfad-b16f7440bcc5"
msgid ""
"\"Each of them wants their god to win new followers in a young and strong "
"kingdom. But they won't tolerate any rivals. Gods hate to share. Thus you "
"must select only one god. I'd place my bet on {g|Gorum}Gorum{/g}. {g|Cayden "
"Cailean}Cayden{/g} is an unreliable drunkard. {g|Abadar}Abadar{/g} and "
"{g|Asmodeus}Asmodeus{/g} are alien to me by nature.\""
msgstr ""
"\"이 강력하고 젊은 왕국에서 모두들 자기가 믿는 신의 신자들을 늘리려 하고 있습니다. 하지만 저들은 경쟁자를 용납하지 않을 것입니다. "
"신들은 나누기를 싫어하는 족속들이니까요. 그렇기에 하나의 신만 선택해야 합니다. 저라면 {g|Gorum}고룸{/g} 을 선택해야 합니다. "
"{g|Cayden Cailean}케이든{/g} 은 믿을 수 없는 주정뱅이 입니다. {g|Abadar}아바다르{/g} 와 "
"{g|Asmodeus}아스모데우스{/g} 는 천성적으로 제게 있어 이질적입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0031_Text
#. Speaker : Harrim_Companion
msgctxt "383bef44-82a0-46ad-95e8-c88addb1f3c9"
msgid ""
"\"Each wishes your kingdom to prosper under the blessings of their god. We "
"must choose between {g|Cayden Cailean}Cayden{/g}, {g|Abadar}Abadar{/g}, "
"{g|Gorum}Gorum{/g}, and {g|Asmodeus}Asmodeus{/g}. I advise you to consider "
"Gorum. His road to the end of things is at least simple and direct.\""
msgstr ""
"\"모두들 자기가 믿는 신의 축복 아래 이 왕국이 번영하길 바라고 있네. {g|Cayden Cailean}케이든{/g}, "
"{g|Abadar}아바다르{/g}, {g|Gorum}고룸{/g}, 그리고 {g|Asmodeus}아스모데우스{/g} 사이에서 하나를 "
"선택하게. 나는 고룸을 추천하고 싶군. 만물을 종식시키는 그의 길은 단순하고도 직설적이니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0032_Text
#. Speaker : Capital_Jhod
msgctxt "3755d7ab-df00-4215-9e14-0165f0476a0f"
msgid ""
"\"We must opt for one of the great gods, thus winning the hearts of his many "
"followers. The most influential priests are those of {g|Cayden "
"Cailean}Cayden{/g}, {g|Gorum}Gorum{/g}, {g|Abadar}Abadar{/g}, and "
"{g|Asmodeus}Asmodeus{/g}. My advice is that you take a closer look at Abadar."
"\""
msgstr ""
"\"대신격 중 하나를 반드시 선택해야 합니다. 그들의 수많은 추종자들을 얻을 수 있기 때문입니다. 가장 영향력있는 사제들은 {g|"
"Cayden Cailean}케이든{/g}, {g|Gorum}고룸{/g}, {g|Abadar}아바다르{/g}, "
"{g|Asmodeus}아스모데우스{/g} 의 사제 입니다. 조언하자면 아바다르쪽이 낫지 싶군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0033_Text
#. Speaker : Capital_Jhod
msgctxt "84d5cf4c-95ea-4901-a3ca-6e039a692297"
msgid ""
"\"{g|Gorum}Gorum{/g} is the dark patron of battle, the master of violence, "
"bold and merciless. His followers believe only in power. They are soldiers, "
"barbarians, mercenaries – and murderers.\""
msgstr ""
"\"{g|Gorum}고룸{/g} 은 전투를 후원하는 어둠의 신이자, 폭력, 용기와 무자비함의 화신입니다. 그의 추종자들은 힘만을 믿지요. "
"그들은 군인이며, 야만인이자 용병, 그리고 살인마들입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0034_Text
#. Speaker : Capital_Jhod
msgctxt "a2391469-2f68-4040-b3aa-2be9e467b254"
msgid ""
"\"{g|Asmodeus}Asmodeus{/g} is the strongest of the archdevils. "
"{g|Cheliax}Cheliax{/g}, a powerful kingdom, has long prospered under his "
"patronage. He believes in discipline and obedience, and the right of the "
"strong to rule the weak. I wouldn't advise getting involved with him. Our "
"neighbors will turn against us, and his patronage will bring down a curse on "
"us.\""
msgstr ""
"\"{g|Asmodeus}아스모데우스{/g} 는 아크데블 중 가장 강력한 자입니다. 강력한 왕국인 {g|Cheliax}첼리악스{/g} 가 "
"그의 비호 아래 성장해왔지요. 그는 규율과 복종, 약자에 대한 강자의 지배를 당연시 여기지요. 아스모데우스와 연관되는 것은 추천드리지 "
"못하겠습니다. 우리 이웃들이 우리에게 등을 돌리고 그의 가호는 우리에게 저주가 될 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0035_Text
#. Speaker : Harrim_Companion
msgctxt "aba8fdcd-c469-4989-bbc9-7ccc1ea6a3ed"
msgid ""
"\"{g|Gorum}Gorum{/g} is a cruel and bloodthirsty warrior, as are his "
"followers. He is the god of war. He is worshipped by orcs and barbarians, "
"but he has quite a few followers among the civilized as well.\""
msgstr ""
"\"{g|Gorum}고룸{/g}은 잔인하고 피에 목마른 전사이며, 그 추종자 또한 그러하다네. 그는 전쟁의 신이야. 고룸은 오크나 "
"야만인들에게나 숭배받지, 문명인에게 숭배되는 경우는 별로 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0036_Text
#. Speaker : Harrim_Companion
msgctxt "83efdb84-db40-4560-b39b-d49d54129bf6"
msgid ""
"\"{g|Asmodeus}Asmodeus{/g} is the lord of {g|Hell}Hell{/g}. He's the "
"archdevil worshipped by the powerful state of {g|Cheliax}Cheliax{/g}. "
"Asmodeus believes in power, compacts, order, and the obedience of the "
"inferior. He's crafty but not deceitful. You should read the contract very "
"carefully, if you choose him.\""
msgstr ""
"\"{g|Asmodeus}아스모데우스{/g}는 {g|Hell}지옥{/g}의 군주라네. {g|Cheliax}첼리악스{/g}라는 강력한 "
"국가에서 그를 섬기고 있지. 아스모데우스는 권력, 협정, 질서와 약자의 복종을 요구해. 교활하지만 정직하지. 아스모데우스를 선택하려면 "
"계약서를 매우 세심하게 읽어봐야 할걸세.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0037_Text
#. Speaker : Capital_Tsanna
msgctxt "17c73d62-7a74-46cc-824a-66e3272442a9"
msgid ""
"\"{g|Asmodeus}Asmodeus{/g} is the archdevil, the lord of {g|Hell}Hell{/g}. "
"{g|Cheliax}Cheliax{/g} made a deal with him – and benefitted greatly from "
"it! It is now a great country which no one wants to fight with. For "
"Asmodeus, order and discipline are absolute. He trusts in the right of the "
"strong, the obedience of the weak, the power of compacts, and the impotence "
"of reliance. It would be a profitable deal – which our neighbors would hate."
"\""
msgstr ""
"\"{g|Asmodeus}아스모데우스{/g} 는 아크데블이자 {g|Hell}지옥{/g} 의 군주입니다. {g|Cheliax}첼리악스{/g}"
" 가 그와 계약했지요. 그리고 이득을 많이 봤고요! 이제 첼리악스는 아무도 쉽사리 건들지 못하는 대국입니다. 아스모데우스에게 있어 질서와 "
"복종은 절대적입니다. 그는 약자에 대한 강자의 지배, 계약의 힘, 의지의 무력함을 관장합니다. 우리 이웃들은 싫어할 테지만, 이윤이 많이 "
"남는 장사가 될 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0038_Text
#. Speaker : Capital_Tsanna
msgctxt "f7c23174-122b-4f7f-8f19-d2e1a2533d4d"
msgid ""
"\"{g|Gorum}Gorum{/g} is the god of war, soldiers and assassins. He's "
"arrogant and merciless. His followers are great warriors that would come in "
"handy.\""
msgstr ""
"\"{g|Gorum}고룸{/g} 은 전쟁, 군인과 암살의 신입니다. 거만하며 자비를 모르지요. 그의 추종자들은 뛰어난 전사들이니 잘 "
"이용할 수 있을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0039_Text
#. Speaker : Capital_Jhod
msgctxt "79e9c689-e224-42cc-8873-9dbe0e3215be"
msgid ""
"\"{g|Abadar}Abadar{/g} is the god of cities and laws, merchants and trade. "
"All he cares about is law and order. It wouldn't be an easy life for his "
"followers in the {g|Stolen Lands}Stolen Lands{/g}, but his patronage might "
"make your citizens a bit more obedient!\""
msgstr ""
"\"{g|Abadar}아바다르{/g} 는 도시와 법, 상인과 교역의 신입니다. 아바다르가 관심있는 것은 법과 질서 뿐이지요. {g|"
"Stolen Lands}도둑맞은 땅{/g} 에서 그의 신도로 살아가는 건 쉬운 일이 아닙니다만, 아바다르의 후원이 있으면 시민들이 보다 "
"더 순종적으로 변할 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0040_Text
#. Speaker : Harrim_Companion
msgctxt "995baec0-b184-4a5f-9276-df3b6e3adb41"
msgid ""
"\"{g|Abadar}Abadar{/g} is the patron of cities and trade. He is there, where "
"civilization flourishes, and he detests chaos and destruction. I'm not sure "
"if his followers will survive well here, in these wild and untamed lands.\""
msgstr ""
"\"{g|Abadar}아바다르{/g}는 도시와 교역의 수호신이지. 문명이 번영하는 곳에는 항상 존재하고, 혼돈과 파괴를 혐오하네. 그의 "
"신도들이 이 길들여지지 않은 야생의 땅에서 잘 살아갈지는 모르겠군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0042_Text
#. Speaker : Capital_Tsanna
msgctxt "960689de-3713-4c4a-a9f0-846c1a0e962b"
msgid ""
"\"{g|Abadar}Abadar{/g} is the god of cities and civilization... which I hate "
"by my nature. {g|Asmodeus}Asmodeus{/g} is the archdevil, the lord of "
"{g|Hell}Hell{/g}. He trusts in the right of the strong, obedience of the "
"weak, the power of agreement, and the impotence of reliance. If you decide "
"to turn to one of these two gods, beware! They might strangle your "
"{mf|barony|barony|kingdom|kingdom} and you with the infinite bonds of "
"legislation."
msgstr ""
"\"{g|Abadar}아바다르{/g} 는 도시와 문명의 신인데... 천성적으로 마음에 들진 않네요. "
"{g|Asmodeus}아스모데우스{/g} 는 아크데블이며, {g|Hell}지옥{/g} 의 군주입니다. 그는 강자의 권리, 약자의 복종, "
"협약의 힘, 의지의 무력화를 관장하죠. 이 두 신들에게 의존하려면 주의하시길! 당신의 {mf|남작령|남작령|왕국|왕국} 과 당신을 법으로 "
"옭아매려 할 테니까요."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0043_Text
#. Speaker : Capital_Jhod
msgctxt "e98d1976-5f58-4d57-8e70-50d37c67e089"
msgid ""
"\"This is a wise decision, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. {g|Abadar}Abadar{/g} doesn't have too many enemies. No one will "
"be sorely disappointed with your decision.\""
msgstr ""
"\"현명하신 선택입니다, {mf|영주님|영주님|전하|전하}. {g|Abadar}아바다르{/g} 는 적이 많지 않지요. 이 결졍에 크게 "
"실망하는 사람은 없을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0044_Text
#. Speaker : Harrim_Companion
msgctxt "0ef9afd0-9db5-4857-8163-006ee20b1fcb"
msgid "\"Let it be so, {name}.\""
msgstr "\"그렇게 하지, {name}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank7/Cue_0045_Text
#. Speaker : Capital_Tsanna
msgctxt "cbce660a-c931-4c79-93be-cb3522e7f8b3"
msgid "\"Hm... As you wish.\""
msgstr "\"흐음... 바라시는 대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank8/Divine_Rank8Monsters/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "5dc2dae1-90e3-4f12-ac86-626df8d0b2ef"
msgid ""
"\"{name}! It's all gone! The idols around the capital that we chopped "
"down... They were some kind of security walls, or seals. Now there are weird "
"portals where they stood, and what's coming out of them...\" {n}Jhod "
"shudders and shivers, barely breathing out the last word.{/n} \"... It's an "
"abomination! The monsters are stalking the area, killing people and "
"devastating small villages. Some wizards are demanding that the Magister to "
"return the idols where they belong. They believe the idols can somehow drive "
"away the monsters.\""
msgstr ""
"\"{name}! 모두 사라졌습니다! 수도 주변에 있던 모든 우상들이 파괴되었어요... 그 우상들은 일종의 방어벽이자, 봉인이었습니다. "
"그 우상들이 있던 자리에 이상한 차원문이 열리더니, 안에서 무언가가 튀어나오고 있습니다...\" {n}조드는 사시나무 떨듯 떨더니, "
"간신히 마지막 말을 내뱉는다.{/n} \"... 혐오체입니다! 괴물들이 돌아다니며 사람들을 죽이고 작은 마을을 파괴하고 있습니다. 마법사 "
"몇 명이 마법대신에게 그 우상들을 제자리로 돌려놓으라는 요구를 해오고 있습니다. 이들은 우상이 그 괴물들을 막아줄 거라 생각하는 "
"모양입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank8/Divine_Rank8Monsters/Cue_0002_Text
#. Speaker : Harrim_Companion
msgctxt "ed8dd691-6062-4dd1-8c4e-8990b9f740f3"
msgid ""
"{n}Harrim looks at you, sad and calm, his hands leaving his poor beard alone "
"for once.{/n} \"...Portals opened in the places where you ordered the idols "
"demolished. Monsters are emerging from them – filthy and unnatural "
"creatures. Even I can see they should not be here.\""
msgstr ""
"{n}하림은 슬프지만 침착한 얼굴로 당신을 바라본다. 그는 손으로 수염을 만지지 않고있다.{/n} \"...우상들을 파괴한 곳에서 "
"차원문이 열렸네. 더럽고 비정상적인 괴물들이 거기서 튀어나오고 있어. 나조차도 그 놈들이 여기 있어선 안 될거라는 걸 알겠더군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank8/Divine_Rank8Monsters/Cue_0003_Text
#. Speaker : Capital_Tsanna
msgctxt "980d1f33-ca02-4e1a-97a0-3bc020680dda"
msgid ""
"{n}Tsanna's fingers are constantly moving, as if she's squeezing someone's "
"invisible throat.{/n} \"Sinister portals opened in the places where you "
"ordered the idols removed. The monsters that emerge sicken even me. I know "
"not where they come from, not what they seek, but they must be stopped. They "
"spread through the forests and devour your subjects.\""
msgstr ""
"{n}산나의 손가락은 쉼없이 움직이고, 마치 보이지 않는 누군가의 목을 쥐어짜는 듯 하다.{/n} \"당신이 없애라고 한 우상의 빈 "
"자리에서 차원문이 열렸어요. 거기서 튀어나오는 괴물들 때문에 저까지 골치 아프네요. 어디서 놈들이 왔는 지, 무슨 목적으로 왔는 지는 "
"모르지만 막아야 해요. 놈들은 숲을 통해 퍼지면서 우리 백성들을 죄다 집어삼킬 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank8/Divine_Rank8Monsters/Cue_0026_Text
#. Speaker : Capital_Jhod
msgctxt "b7994dc4-3c66-4caa-b2f6-95419f02d119"
msgid ""
"\"I do not like this solution. We must face this evil steadfast, and never "
"try to defeat one dark magic with another. Our army is powerless against the "
"monsters. Our soldiers are trained to fight in the open, not to track "
"monsters through a thicket. If only Your Highness could appear everywhere at "
"once and repel each attack! But no, we must order the Warden to call upon "
"the people to resist. Gather the hunters, pathfinders, and those who know "
"the thicket. We shall stand united!\""
msgstr ""
"\"이 결정이 마음에 들지 않는군요. 우리는 이 사악과 물러섬 없이 맞서야지, 악으로 악을 물리치려 해서는 안 됩니다. 우리 군대는 "
"괴물에게 약합니다. 우리 병사들은 광야에서 싸우도록 훈련받았지, 덤불 속의 괴물을 상대하라고 훈련받지 않았단 말입니다. 전하께서 동시에 "
"여러 곳에서 나타나 이 놈들을 모두 물리쳐주셨으면 좋았을 텐데요! 하지만 그럴 수는 없는 일이지요. 감시관에게 명령해 사람들을 소집하고 "
"저항하게 해야 합니다. 사냥꾼, 길잡이, 그리고 누구든 덤불에 대한 지식이 있는 자라면 누구든 모으십시오. 우리는 함께 싸울 것입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank8/Divine_Rank8Monsters/Cue_0035_Text
#. Speaker : Harrim_Companion
msgctxt "7e1afe47-6785-42ee-a1da-7b5932376c0d"
msgid ""
"\"We must stop these monsters. I wouldn't rely on weapons, even if the "
"Warden managed to unite the whole kingdom in resistance. Soldiers cannot "
"track the monsters in the forest, and you cannot be everywhere at once. We "
"must bring things back to normal. I made a sketch of the idols, so I can "
"help the Magister seal the portals. The monsters should die if we succeed. "
"Their tether to their native world will be severed.\""
msgstr ""
"\"괴물들을 막아야합니다. 하지만 감시관이 전 왕국 사람들을 모아 저항한다고 하더라도 저라면 칼에 의존하지 않겠습니다. 병사들은 숲에서 "
"괴물들을 추적할 수 없습니다. 그리고 당신이 온 세상에 동시에 존재 할 수도 없는 노릇이지요. 모두 정상으로 돌려놔야 합니다. 우리 "
"마법대신이 차원문을 봉인 할 수 있도록 제가 우상을 그려왔습니다. 성공하면 괴물들은 처리될 겁니다. 놈들이 온 세상과의 연결이 끊어질 "
"테니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank8/Divine_Rank8Monsters/Cue_0036_Text
#. Speaker : Capital_Tsanna
msgctxt "4e63b465-382d-4356-92b3-0dd200608314"
msgid ""
"\"You yourself cannot hunt them all down, and your army will be of little "
"help. They do not possess the skills of the forest hunter. We could order "
"the Warden to drum up the people for a full raid... But don't expect your "
"hunters and wood choppers to overcome their own fears, when facing such "
"beasts. Better to assign this matter to the Magister. Perhaps he would not "
"only be able to seal the portals, but also examine the monsters. I would "
"like to learn more about them.\""
msgstr ""
"\"당신은 저 괴물들을 모두 쓰러뜨릴 수 없습니다. 당신의 군대도 별로 도움 안 될 겁니다. 숲에서 사냥하는 법을 모르니까요. 감시관에게 "
"명령해 사람들을 모아 전체적으로 습격을 가해야 합니다... 하지만 그렇다고 사냥꾼이나 나무꾼들이 저들에 대한 공포를 이겨낼 수는 없겠죠. "
"그런 짐승들을 마주하는 거니까요. 이번 일을 마법대신에게 맡겨둡시다. 차원관문을 닫을 법을 알고있을 뿐만 아니라 괴물들을 조사할 수도 "
"있을 겁니다. 저도 저런 괴물들을 더 연구해보고 싶고요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank8/Divine_Rank8Sacrif/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "bf93530c-4b66-41c4-8704-b0cc1d331024"
msgid ""
"\"I have bad news, Your Highness. The idols you ordered protected have "
"become crime scenes again and again. Bloody traces are often discovered. We "
"found a new grave recently, and I couldn't believe my eyes. It seems that "
"someone's been making sacrifices to the idols!\""
msgstr ""
"\"나쁜 소식입니다, 전하. 지키라고 명령하신 우상들이 계속해서 범죄의 원인이 되고 있습니다. 피묻은 흔적이 간혹 발견되곤 합니다. "
"최근에 새로 무덤을 발견했는데, 제 눈을 믿을 수가 없겠더군요. 누군가가 그 우상들을 위한 번제를 하고 있던 것으로 보였습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank8/Divine_Rank8Sacrif/Cue_0002_Text
#. Speaker : Harrim_Companion
msgctxt "36de6963-4614-43aa-9e3a-905d4e62ae21"
msgid ""
"\"I have bad news, {name}. Someone has been making bloody sacrifices to the "
"idols that you so mercifully granted your protection. We discovered blood "
"and dead bodies. The guards have attempted to root out the cultists, but the "
"people are scared, and all attempts have failed.\""
msgstr ""
"\"나쁜 소식일세, {name}. 자네가 자비롭게 보호하기로 약속한 우상에 누군가가 번제를 드린 것 같아. 피와 시체를 발견했네. "
"경비들이 사교도들을 찾아내려 했지만, 사람들이 겁에 질려서 실패했다네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank8/Divine_Rank8Sacrif/Cue_0003_Text
#. Speaker : Capital_Tsanna
msgctxt "fa6b103c-c35d-401c-bb0e-b4e9d5376c03"
msgid ""
"\"{name}, the idols that you granted your protection have are attracting "
"dangerous cultists once again. We keep discovering blood and dead bodies. "
"The guards have tried to root out the cultists, but the people are afraid to "
"talk.\""
msgstr ""
"\"{name}, 당신이 보호하기로 한 우상들이 다시 한 번 위험한 사교도들의 주의를 끌고 있어요. 계속해서 피와 시체가 발견되고 "
"있어요. 경비들이 사교도들을 찾아내려 했지만, 사람들이 겁에 질려서 말을 하지 않더군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank8/Divine_Rank8Sacrif/Cue_0027_Text
#. Speaker : Capital_Jhod
msgctxt "e71daf00-556b-4176-bf0a-34cfa5978b2a"
msgid ""
"\"We must order the Minister to send assassins after the bloody cultists! "
"No, not assassins... We should invite inquisitors who honor the good gods! "
"They will quickly root out and put an end to the rascals. Let the diplomat "
"write invitations for them. If these idols are so dear to their pagan "
"worshipers, they could have come to me to negotiate. Alas, now that the "
"blood is spilled, the time for words has gone!\""
msgstr ""
"\"첩보대신에게 명령해 이 더러운 사교도들을 암살하라고 해야 합니다! 아니, 암살자는 안 되지요... 신의 교리를 따르는 이단심문관이 "
"좋겠군요! 이들은 빠르게 이 악한들을 찾아내고 없애버릴 겁니다. 외교관에게 이들을 초대하게 하십시오. 이 우상들이 그토록 소중했다면, "
"협상하러 왔어도 되었을텐데 말입니다. 이제 피가 흘렀으니, 대화를 할 때는 끝났습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank8/Divine_Rank8Sacrif/Cue_0028_Text
#. Speaker : Harrim_Companion
msgctxt "17d0c4e1-2aa8-4462-bc3d-e51df73977f2"
msgid ""
"\"We could order the Minister to send our best assassins after them. Our "
"Grand Diplomat could engage inquisitors, who are much like assassins, except "
"that they serve their deity rather than their own purses. But I think I "
"could come to terms with whoever is conducting these rites. Allow them to be "
"performed quietly, without alarming the community. What if they serve a "
"greater purpose?\""
msgstr ""
"\"첩보 대신에게 명령해 최고의 암살자를 파견할 수 있다네. 우리 외교관으로 하여금 이단 심문관을 고용해도 되겠지. 암살자들은 돈을 "
"좇지만 이들은 신앙을 좇는다는 점이 다르다네. 하지만 내 생각엔 이 의식을 수행하는 자와 협상을 시도해봐야 할 것 같아. 저들이 "
"조용하고, 사회에 피해를 주지 않는 선에서 의식을 치르도록 허락해주게. 저들도 나름의 사정이 있을 수도 있는 거 아니겠나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank8/Divine_Rank8Sacrif/Cue_0029_Text
#. Speaker : Capital_Tsanna
msgctxt "f6a86e78-97f9-4fbe-81da-28c819ba6933"
msgid ""
"\"They're doing a fine job, I'll give them that. I don't think we could "
"persuade them to work for us – so why don't you tell the Minister to send "
"killers after them, and seize all their journals and books? Also, I advise "
"against ordering the Grand Diplomat to summon the inquisitors of benevolent "
"gods. Their investigation might bring to light... other ominous cults that "
"operate in your lands. And we wouldn't want that, now would we?\""
msgstr ""
"\"저들은 일을 잘 하더군요. 인정 해야겠습니다. 저들이 우리를 위해 일하도록 설득하지는 못 할 거 같습니다. 그러니 첩보대신에게 명령해 "
"암살자를 보내서 처리하고, 저들의 일지와 책을 모조리 빼앗아오는 건 어떻습니까? 그리고, 이단심문관을 저들에게 보내자는 외교관의 의견엔 "
"반대하고 싶습니다. 이단심문관이 휩쓸고 가면... 이 땅의 다른 불길한 사교도들이 드러날 지도 모릅니다. 설마 그러길 바라시는 건 "
"아니겠지요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Answer_0005_Text
msgctxt "303d14d7-b39d-4e15-b7d8-868da5a5cf13"
msgid ""
"{g|Divine9_2}[Choice effects]{/g} \"Let them speak out, without fear for "
"their lives or their freedom. Leave them be.\""
msgstr "{g|Divine9_2}[선택 시 효과]{/g} \"자유나 생명에 대한 위협을 가하지 말고, 마음대로 떠들게 내버려 두라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Answer_0006_Text
msgctxt "4b5159a3-f0ca-4fbb-86d8-f90c7a86d7d1"
msgid ""
"{g|Divine9_1}[Choice effects]{/g} \"Declare their teachings prohibited, and "
"drive them to the border.\""
msgstr "{g|Divine9_1}[선택 시 효과]{/g} \"저들의 교육을 금지시키고, 국경 바깥으로 내쫓아라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Answer_0008_AlignmentShift.Description
msgctxt "27d05d4b-5f7e-408f-b4c3-6c7aa3cb984f"
msgid "Ordered the atheists from Touvette to be secretly exterminated."
msgstr "토벳에서 온 무신론자들을 비밀리에 처리하라고 명령했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Answer_0008_Text
msgctxt "41ce16eb-1d82-4468-a2af-849c2d0beca9"
msgid "{g|Divine9_3}[Choice effects]{/g} \"Execute them publicly.\""
msgstr "{g|Divine9_3}[선택 시 효과]{/g} \"공개적으로 처형하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Answer_0010_Text
msgctxt "c6593f4a-10f8-47b9-9f58-d80f1d62806f"
msgid "\"I will rely upon you in this matter.\""
msgstr "\"이 안건에 대해선 그대에게 맡기겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Answer_0064_Text
msgctxt "1ae57c71-b936-48c7-8c73-d73b0fc600bc"
msgid "\"Tell me about this Touvette.\""
msgstr "\"이 토벳에 대해 이야기 해보라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "d3f37a98-6c00-4331-98ef-53d50e69a7e5"
msgid ""
"\"We have arrested some agitators from Touvette. They claim themselves "
"harbingers of atheism, and doubt the high status and authority of the gods, "
"whose servants cause only pain and suffering. We should do as Touvette's "
"neighbors have done, and drive these agitators away, while still preventing "
"bloodshed.\""
msgstr ""
"\"토벳에서 온 선동가들을 붙잡았습니다. 저들은 스스로를 무신론을 전파하는 자들이라 하며, 신들의 지고한 위치와 그 권위를 의심하고 "
"있습니다. 신을 따르면 고통만이 있을 뿐이라고 합니다. 토벳의 이웃들이 한 것 처럼 우리도 이 선동가들을 내쫓아야 합니다. 유혈사태가 "
"벌어지기 전에 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0002_Text
#. Speaker : Harrim_Companion
msgctxt "f2b9aa28-2a2d-422a-a842-580ce3233be4"
msgid ""
"\"The guards have arrested some agitators from Touvette. They call "
"themselves preachers of godlessness, also known as atheism. The gods should "
"not be worshipped, they say, and I agree with them. Only "
"{g|Groetus}Groetus{/g} is worthy of our prayers. He alone is honest with us. "
"He doesn't promise any reward. On the contrary, he shows what awaits us, no "
"matter how tempted we may be to reject him in horror. So I would leave "
"these... atheists alone. Their frustration with the gods is justified in "
"many ways. That's why the priests are after them!\""
msgstr ""
"\"토벳에서 온 선동가들을 경비대가 붙잡았네. 이들은 스스로를 불신의 설교자들이라고 하며, 무신론자로도 알려져있어. 이들의 말에 따르면 "
"신을 섬겨서는 안 된다고 하더군. 동의하는 바네. {g|Groetus}그로투스{/g}만이 섬길 가치가 있는 신이지. 그분만이 우리에게 "
"솔직하다네. 그분은 우리에게 아무런 보상도 약속하지 않으시지. 반대로, 그분은 아무리 우리가 공포에 휩싸여 그분을 거절해왔어도 우리를 "
"참고 기다려주시는 분일세. 나라면 이 무신론자들을... 내버려두겠네. 이들이 신으로부터 느낀 실망감은 다양한 방법으로 증명되었네. 그래서 "
"사제들이 저들을 쫓고있는 것이기도 하고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0003_Text
#. Speaker : Capital_Tsanna
msgctxt "fc24460c-c317-4acd-8e8a-b347d6384b67"
msgid ""
"\"We've captured some dangerous rebels. They're agitators from Touvette "
"claiming to be atheists, or simply put, godless people. They may be fools, "
"but they're dangerous nevertheless. Our divine patrons might turn away from "
"the kingdom, depriving us of their protection, and all because of these "
"fools! They must be banished. Or even better – publicly executed, to show "
"the gods that we haven't let them poison our minds.\""
msgstr ""
"\"위험한 반동분자들을 포획했습니다. 이들은 토벳에서 찾아온 무신론자들이라 불리는 선동가인데, 간단히 말하면 신을 믿지 말자는 "
"자들입니다. 저들은 어리석은 게 틀립없습니다. 하지만 위험하기도 하지요. 우리의 수호신들께서 어쩌면 수호를 거두고 우리를 버릴 수도 "
"있습니다. 이 바보들 때문에요! 저들은 추방되어야 합니다. 아니면 더 나은 방법이 있지요. 공개 처형하는 겁니다. 신들께 우리의 마음 "
"속이 어지러워지지 않았다는 것을 증명하기 위해서지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0011_Text_String
#. Speaker : Capital_Jhod
msgctxt "cd3ef15a-8937-4b5c-b86c-ab13c9d5047e"
msgid ""
"{n}Jhod purses his lips and scratches the back of his head vigorously.{/n} "
"\"Hm... I don't like it. They lead otherwise decent people astray, and "
"you're letting them do it.\""
msgstr ""
"{n}조드는 입술을 오므리고는 뒤통수를 세게 긁는다.{/n} \"흐음... 마음에 들지 않는군요. 우리의 백성들을 타락시키고 있는데, "
"그냥 내버려 두시다니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0012_Text
#. Speaker : Harrim_Companion
msgctxt "a8d9a4d6-ee54-4ed4-bba2-ddd3ef2e85a2"
msgid ""
"{n}Harrim's voice is hollow, as if echoing down a deep well.{/n} \"Every "
"voice may sound in the void, but not every voice can fill the void.\""
msgstr ""
"{n}하림의 목소리는 공허하고, 마치 깊은 우물 속에 메아리치는 듯 하다.{/n} \"누구든 공허 속에서 말할 수 있지만, 모두가 자신의 "
"목소리로 공허를 채울 수는 없는 법이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0013_Text_String
#. Speaker : Capital_Tsanna
msgctxt "5f054fcf-964e-4fd6-bf93-a7c72d71025f"
msgid ""
"{n}Tsanna wags her finger.{/n} \"Never disrespect gods, {name}. Never give "
"shelter to those who defy the power of the gods. The divine wrath can be "
"overwhelming.\""
msgstr ""
"{n}산나는 손가락을 흔든다.{/n} \"신들을 모욕하지 마세요, {name}. 신들의 권위에 거역하는 자들에게 자비를 베풀지 마세요. "
"신들의 분노는 무시무시하니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0014_Text
#. Speaker : Capital_Jhod
msgctxt "83b0f19d-0665-4df1-8f5e-749ae30e5178"
msgid "\"I will make sure that they are entirely driven from your lands.\""
msgstr "\"저들을 확실하게 당신의 땅에서 몰아내겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0015_Text
#. Speaker : Harrim_Companion
msgctxt "ef286a7a-ecb1-4b15-a6ff-96b605b04c08"
msgid ""
"{n}Harrim shrugs.{/n} \"Very well, but it's not going to change anything. "
"Their teachings have already been shared. Fate cannot be changed.\""
msgstr ""
"{n}하림이 어깨를 으쓱한다.{/n} \"아주 잘했어 근데 아무것도 변하지 않을 것이다. 그놈들의 가르침은 이미 다 퍼졌어. 이 운명은 "
"바꿀 수 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0016_Text_String
#. Speaker : Capital_Tsanna
msgctxt "b1677932-8221-40a2-938c-68f1b566eb36"
msgid ""
"\"Do you think the people will forget everything just like that? Your ban "
"will be the first topic of gossip, and someone is bound to believe their "
"words. In the end, you'll have to banish fifty, not five! Or even worse, "
"{g|Lamashtu}Lamashtu{/g} will unleash a pestilence herself.\""
msgstr ""
"\"사람들이 그렇게 쉽게 이 모든 것을 잊을 것 같아? 너의 가르침이 사람들 입에 오르락 내리락하는 첫 번째 주제가 될 것이고, 누군가는 "
"반드시 그들의 말을 믿게 된다. 결국 다섯명이 아니라 오십명을 추방해야 할 것이다! 더 나쁜 것은, {g|라마슈투}라마슈투{/g}가 직접 "
"그것들을 일으키겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0020_Text_String
#. Speaker : Capital_Jhod
msgctxt "1a92645b-967c-4262-a5a9-6a6f77da6f3b"
msgid ""
"{n}Jhod's eyes widen.{/n} \"What unprecedented cruelty! They are like "
"confused children, mistreated by their strict parents, who've decided that "
"all grown-ups are bad. Do they truly deserve punishment for their plight?\""
msgstr ""
"{n}죠드의 눈이 휘둥그래졌다.{/n} \"이건...너무 잔인하다! 얘네들은 마치 가정폭력 속에서 자란 아이들 같다. 이들을 보살피지 "
"못한 어른들이 나쁜거야. 얘네들은 정말로 벌을 받아야하는걸까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0021_Text_String
#. Speaker : Harrim_Companion
msgctxt "19d620be-b423-4a1c-a3f1-0e58876b1e15"
msgid ""
"{n}Harrim frowns.{/n} \"If they're lying, why kill them? If they're telling "
"the truth, will death put an end to it? This is nothing but foolishness.\""
msgstr ""
"{n}하림이 눈살을 찌푸린다.{/n} \"거짓말이라면..그들은 왜 죽여야할까? 만약 그들이 진실을 말하고 있다면.. 이건 해결할수 없어? "
"이것은 어리석은 짓일 뿐이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0022_Text
#. Speaker : Capital_Tsanna
msgctxt "7ea84f05-9ad3-459e-b824-708eb568ed58"
msgid ""
"{n}A predatory grin appears on Tsanna's face.{/n} \"It will be done. I'll "
"see that they suffocate properly – slowly and painfully. The gods won't "
"blame us for showing mercy to their enemies.\""
msgstr ""
"{n}차이나의 얼굴은 광기서린 웃음이 나타난다.{/n} \"드디어... 니네가 천천히 고통속에서 처절하게 죽어가는 것을 볼꺼야. 설령 "
"신일지라도 이런 우릴 용서할꺼야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0026_Text
#. Speaker : Capital_Jhod
msgctxt "a5f2c980-4af4-49d9-882a-ec79de57020a"
msgid ""
"{n}Jhod frowns and clenches his fists.{/n} \"I'll make sure they're driven "
"away quietly. Let them preach their false ideas in Touvette. We'll not "
"welcome it here. The gods are gracious, and our ruler is not angling to take "
"their place!\""
msgstr ""
"{n}죠드는 얼굴을 찡그리며 주먹을 불끈 쥐었다.{/n} \"조용히 그들을 쫓아내야해. 안그러면 투베트에는 이 멍청한 생각들이 "
"울려퍼지겠지. 우리는 그렇게 되는 것을 지켜볼수 없어. 신들은 자비로울지몰라도, 우리들은 그들이 기회를 가지는 것을 지켜보면 안돼!! \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0027_Text
#. Speaker : Harrim_Companion
msgctxt "71861c9d-a8f3-42ee-9aaf-8f531a4cb30c"
msgid ""
"{n}Harrim sighs.{/n} \"Let them teach what they will, then. The end may come "
"when we finally give up all religions but {g|Groetus}Groetus'{/g}! This "
"makes their teaching harmless. It only promotes the inevitable.\""
msgstr ""
"{n}하림은 한숨을 쉰다.\"그럼 뭘 가르쳐줄까? 그래, {g|roetus}Groetus'{/g}을 제외한 모든 종교를 포기하게 될 때 "
"종말이 올 수 있어. 이 가르침을 새겨들어야해. 헛소리로 운명을 피할수 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0028_Text
#. Speaker : Capital_Tsanna
msgctxt "ffe3fc73-0ee7-4a4a-bcf8-6be37ba345ed"
msgid ""
"{n}A predatory grin appears on Tsanna's face.{/n} \"I'll ensure that no one "
"ever hears their dangerous teachings. I'll put their heads on display.\""
msgstr "{n}차이나의 얼굴에 짙은 웃음이 나타난다.{/n} \"더이상 이들의 말은 퍼질수 없을거야. 그들의 머리는 잘릴거니깐 .\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0065_Text
#. Speaker : Capital_Jhod
msgctxt "8f351699-2159-4de6-92df-82aa7f97d5f2"
msgid ""
"\"It's a bad place! Wars between rival priests tore Touvette apart. The "
"fighting almost destroyed the country. Neighbors annexed half the territory. "
"The people were starving. – And the priests and the king didn't care at all."
"\n"
"So General Voran gathered the people's full support, overthrew the king, and "
"seized power. Voran put an end to the war, restored order, and recovered the "
"kingdom's lands. I even approve that he seized the priests' treasures to "
"feed the people. It was the priests who led the people to starvation! But "
"Voran isn't the sort of man you would freely give power to.\""
msgstr ""
"\"추악한 곳이네요! 너희 사제들의 전쟁은 투베트를 갈기갈기 찢어놨어요. 그 싸움은 나라를 몰락하게 만들었지. 주변 국가들이 나라 땅의 "
"절반을 가지게 했죠. 백성들은 굶주려가는데 말이죠. – 그리고 백성들을 사제들과 왕은 나 몰라라 했죠....\n"
" 그래서 보란 장군은 백성들의 전폭적인 지지를 받고 왕을 몰아내고 정권을 잡았어요. 보란은 전쟁을 끝내고 질서를 회복하고 왕국의 땅을 "
"되찾았어. 심지어 그가 백성들을 먹이기 위해 사제들의 보물을 압수했지만 나는 그를 지지해. 왜냐고? 백성들을 굶주리게 한 것은 사제들과 "
"제사장들이니깐! 보란 장군은 당신이 마음대로 할 수 있는 사람이 아니에요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0066_Text
#. Speaker : Harrim_Companion
msgctxt "0ea6d4d4-a688-4771-9a59-8b2d688b3b77"
msgid ""
"\"Touvette is a brilliant example for us all. Emptiness and death await "
"everyone. The priests of Touvette fought each other too fiercely, and this "
"brought their country to ruin. But just as Touvette was about to fall, "
"General Voran appeared. He overthrew the king, expelled the priests, and "
"restored order. He spent the temple's treasures to feed the people. You must "
"wonder if this story had a happy ending? No, it didn't. As I said, the "
"inevitable cannot be stopped.\""
msgstr ""
"\"투베트는 아주 좋은 교과서죠. 우리 모두는 충성과 죽음과 함께한다. 투베트의 사제들은 서로 너무 격렬하게 싸웠고, 이것은 그들의 "
"나라를 망하게 만들었어. 그러나 투베트가 쓰러지려고 할 때, 보란 장군이 나타났지. 그는 왕을 몰아내고, 사제들을 추방하고, 질서를 "
"회복했어. 그는 신전의 보물을 백성들에게 나눠 굶주림을 해방시켰어. 이 이야기가 행복한 결말을 맺었는지 궁금하겠지? 안타깝게도..그러지 "
"못했어. 운명은 피할수도 멈출수도 없었거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0067_Text
#. Speaker : Capital_Tsanna
msgctxt "da41f86b-8af1-4a0d-8329-35a0834c6cfb"
msgid ""
"\"It's a bad place! The local priests of the \"good\" gods began to quarrel, "
"and almost ruined the country. General Voran seized power, and became a "
"strong leader. {g|Lamashtu}Lamashtu{/g} could have granted her blessing to "
"him. But Voran attempted to become even more. I think he considers himself "
"almost a deity. He killed or expelled all the priests to eliminate "
"competition, and turned the temples into headquarters for his knights. They "
"are soldiers, judges, and executioners all at the same time.\""
msgstr ""
"\"추악한 곳이야! \"good\"사제들은 다투기 시작했고, 나라를 망국으로 이끌고 있었지. 그 속에서 보란 장군은 권력을 장악했고, "
"강력한 지도자가 되었어. {g|라마슈투}라마슈투{/g}는 그에게 축복을 준 것일지도도 모르지. 그래서인지 보란 장군도 축복받은 마냥 더욱 "
"몰아붙였지. 나는 그가 자신을 신이라 여기고 있다고 생각해. 그는 경쟁을 없애기 위해 모든 사제들을 죽이거나 내쫓았고, 사원을 기사들의 "
"아지트로 만들었지. 군인이면서 법을 심판하였지. 역적들이면서 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0068_Text
#. Speaker : Capital_Jhod
msgctxt "a1367842-efcd-436e-8fa3-ec96d98a331d"
msgid ""
"\"He expelled all the priests from Touvette. Dissenters were dragged behind "
"horses through the streets, and stoned to death. He also turned the temples "
"into 'refuges', a combination of schools, hospitals, and offices.\n"
"Voran instituted strict order and fully subdued Touvette. Its people sing "
"praises to him every morning, as if he were a god – for saving them from "
"religion and laziness. Everything is closely watched. Indeed, Voran himself "
"announced that the country was full of spies. This is how he compels "
"obedience. Like most crimes, speaking out against the general is punished by "
"death at the hands of his Knights. They are warriors, judges, and "
"executioners, all at the same time.\""
msgstr ""
"\"보란 장군은 모든 사제들을 투베트에서 추방했다. 사제들은 말 뒤에 묶어버렸지. 그리곤 질질 끌고 갔어. 추방당하면서 돌에 맞아 "
"죽기도했지. 보란 장군은 그뿐만아니라 사원을 파괴하고 학교, 병원, 집무실로 탈바꿈했어.\n"
" 보란은 엄격한 질서를 세우고 몰락할뻔한 투베트를 다시 이르켜 세웠어. 사제와 탐관오리로부터 백성들을 구했냈어. 백성들은 매일 아침 그를 "
"칭송할수 밖에 없었지. 보란은 자신의 권력을 더욱 견고하게 만들려고했어. 실제로 보란 자신도 이 나라가 첩자로 가득 차 있다고 발표했어. "
"이것은 그의 반대파를 숙청하기 위한 방법이였지. 폭군과 같이.. 보란 장군은 자신에게 불리한 발언을 하는 자들을 기사들을 동원해 사형에 "
"처했지. 그들이 곧 법이였어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0069_Text
#. Speaker : Capital_Jhod
msgctxt "9c6b242f-adb3-400a-8006-3f1abde7effa"
msgid ""
"\"The worst sin in Touvette is believing in anyone or anything other than "
"Voran. The general has declared war on all gods. He combined the ways of "
"{g|Razmiran}Razmiran{/g} and {g|Rahadoum}Rahadoum{/g}, the famous country in "
"{g|Garund}Garund{/g} which denies all the gods. Take my word for it, "
"Touvette will never flourish without the patronage of a mighty god. On the "
"contrary, the country is now isolated, and it has no allies.\""
msgstr ""
"\"투베트에서 가장 큰 죄는 보란 장군 외의 다른 무언가를 믿는 것이야. 장군은 신을 믿는 것을 금지 시켰어. 그는 "
"{g|Razmiran}라즈미란{/g}과 {g|Rahadoum}라하둠{/g}의 말들을 교묘하게 섞어 모든 신들을 부정했지. 내 말을 "
"믿어야해, 투베트는 신의 축복이 없이는 결코 번창하지 않을꺼야. 지금을 봐. 투베트는 고립되었고, 동맹도 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0070_Text
#. Speaker : Capital_Tsanna
msgctxt "bd875727-4f03-45a4-a583-72b8e96ffb0c"
msgid ""
"\"Now there is order in Touvette. Strict order. There's only one punishment "
"for breaking the law. Death. Speaking against Voran or worshipping the gods "
"are chief among crimes. Everyone is watched so closely that no one can hide. "
"I don't have any brothers or sisters there. That country is destined to "
"perish, either by the will of the gods, or by the simple act of its "
"neighbors, who have broken off all ties with Touvette.\""
msgstr ""
"\"이 투베트에선 명심해야 할 것들이 있어. 투베트의 법을 어기면 죽음뿐이야. 특히 보란 장군에게 불리한 말을 하거나 신들을 숭배하는 "
"것은 최악의 죄로 다뤄져. 밀고사회라.. 모든 사람이 지켜보고 있어 숨을 수도 없어. 투베트는 고립되어있어. 그 나라는 신의 분노를 "
"맞거나 주변 나라에 의해 멸망할 운명이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0071_Text
#. Speaker : Harrim_Companion
msgctxt "6187cffe-640b-47dd-a6d6-98edc2e17c2d"
msgid ""
"\"Voran went mad. He forced to people to worship him and utter prayers of "
"gratitude to him every morning. He banned all other gods and killed the "
"priests. His knights watch everyone, and kill all who dare worship a god. "
"This is a country of strict laws, and everyone must submit to the cruel "
"dictator.\n"
"He once crucified a defeated general and carried the cross above his army "
"like a banner, can you imagine it? That's the sort of man he is, the savior "
"of Touvette.\""
msgstr ""
"\"보란 장군은 미쳐버렸어. 그는 사람들에게 아침마다 자신을 숭배하고 감사 기도를 올리도록 강요하고있어. 그리고 신을 숭배하는 것을 "
"금지시키고 신을 모시는 모든 사제들을 죽였다. 그의 기사들은 백성들을 감시하고, 감히 신을 숭배하는 자가 나타나면 모두 죽여버려. "
"투베트는 엄격한 법이 있는 나라로서, 백성이든 여행자든 모든 사람들은 그를 숭배해야해.\n"
"그에게 패배한 장수는 십자가에 못박혀, 깃발처럼 그의 군대가 들고 다녀.. 상상할 수 있겠어? 투베트의 구세주라 불리는 보란 장군은 그런 "
"사람이야\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Divine/Rank9/Cue_0072_Text
#. Speaker : Harrim_Companion
msgctxt "1ad642af-32ec-4751-889a-6c5193dd45ce"
msgid ""
"\"But he's merely postponed the death of his country. Either it will be "
"punished by the enraged and jealous gods, or starved to death by neighbors "
"who've no interest in further dealings with Touvette.\""
msgstr ""
"\"그러나 그는 망해가는 나라와 구세주가 필요한 백성들을 이용했을 뿐이야. 보란은 신들의 심판을 받거나, 쇄국정책으로 고립된 투베트는 "
"굶어 죽게 될 꺼야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Merc/Cue_0001_Text
msgctxt "2577627c-bc47-42bb-964c-aa02adfc94e6"
msgid ""
"{n}Your advisor has arrived to report about the recent Economy developments "
"in your {mf|barony|barony|kingdom|kingdom}.{/n}"
msgstr "{n}당신의 보좌관이 최근의 {mf|남작령|남작령|왕국|왕국}의 경제 발전에 대해 논의하기 위해 방문했습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Answer_0009_Text
msgctxt "0cc70b11-5280-45ec-89fb-3d4b0a076129"
msgid ""
"{g|Economy10_3}[Choice effects]{/g} \"Invest our gold in trade points. I "
"need loyal people abroad.\""
msgstr "{g|Economy10_3}[선택 시 효과]{/g} \"이곳에 투자하십시오. 나는 능력있는 투자자들이 필요합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Answer_0010_Text
msgctxt "0635cf8e-0c64-4ad4-9bd3-9d4aa011c113"
msgid ""
"{g|Economy10_2}[Choice effects]{/g} \"Pay tuition for our young people in "
"foreign lands.\""
msgstr "{g|Economy10_2}[선택 시 효과]{/g} \"타국에 있는 우리 젊은 백성들의 학비를 내라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Answer_0011_Text
msgctxt "fc8320da-8a84-40b6-8c0a-06ba4c768976"
msgid "{g|Economy10_1}[Choice effects]{/g} \"Invite a weather mage.\""
msgstr "{g|Economy10_1}[선택 시 효과]{/g} \"기상 마법사를 소개하겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0001_Text
#. Speaker : MaegarVarn_Capital
msgctxt "4a49556e-2a39-4c3b-8bb3-977b60c1a2d6"
msgid ""
"\"You managed to bring to order the village chiefs and local leaders, and "
"found common ground with the smaller local governors. They considered "
"themselves kings in their own right, but now they faithfully serve you. It's "
"a victory.\""
msgstr ""
"\"마을 촌장들과 근처 귀족들을 동원해서 알아본 결과, 세력이 작은 지도자들과 공통점을 찾았어. 예전에는 자기들 스스로를 왕이라 여겼지만 "
"지금은 충실하게 너에게 충성을 받치고있어. 굉장한 결과야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0002_Text
#. Speaker : MaegarVarn_Capital
msgctxt "a6e1a321-50f6-4a44-8d8e-84c635ef424c"
msgid ""
"\"You managed to reform a hostile country government, once full of "
"corruption and bribery.\""
msgstr "\"한 때 부패와 뇌물로 가득했던 추악한 나라를.. 가까스로 개혁하셨군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0003_Text
#. Speaker : Jubilost_Companion
msgctxt "0a912e08-11b4-4988-b67d-ec1668496a6d"
msgid ""
"{n}Jubilost chuckles contentedly.{/n} \"Oh, I'm only joking. Although I do "
"respect the way you dealt with this mess of a bureaucracy. I couldn't have "
"done it any better. It's a good thing that you put an end to all those "
"bureaucrats mistreating the townsfolk.\""
msgstr ""
"{n}주빌로스트가 만족스럽게 껄껄 웃는다.{/n} \"아, 농담이야. 비록 네가 탐관오리들을 처리한 방식을 과격했지만. 그것보다 나은 "
"방법은 없었어. 마을 사람들을 학대하는 그놈들을 멈추게 한 것은 좋은 일이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0004_Text
#. Speaker : Jubilost_Companion
msgctxt "5ad718d5-6d10-479d-b962-2d11db5be746"
msgid ""
"{n}Jubilost chuckles contentedly.{/n} \"I'm only joking, of course. Although "
"there's much that commands respect. When you came to power, you didn't "
"dismiss all the Stag Lord's larcenous servants and governors, but organized "
"them into a working system. As a result, the country under your governance "
"is now thriving.\""
msgstr ""
"{n}주빌로스트가 만족스럽게 껄껄 웃는다.{/n} \"물론 농담일 뿐이야. 비록 존경할 만한 많은 위인들이 있을수도 있지. 그렇지만 "
"수사슴 군주의 충직한 신하들과 장군들을 모두 해임하지 않고, 그들만의 환경을 만들어 줬잖아? 그 결과, 너의 나라는 더욱 번영하고 있잖아."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0005_Text
#. Speaker : SadisticMage_Capital
msgctxt "b8595642-7cd4-4906-a615-6de7fe3bab0d"
msgid ""
"\"It was your vision not to imprison everyone you captured... so to speak, "
"red-handed. You realized that bending these people to your will would be far "
"more beneficial!\""
msgstr ""
"\"넌 사람을 다룰줄 알지. 말하자면, 별다른 협박없이도 피로 물든 손만 보여줘도 사람들이 굽신거리며 통제할 수 있다는 것을 깨달았지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0006_Text
#. Speaker : SadisticMage_Capital
msgctxt "49248c4a-64ba-46f3-9006-521cd3c5ebfe"
msgid ""
"\"Your celebrated steady hand cleared this swamp of corrupt servants and "
"kleptocrats. Now that there's nobody to plunder your treasury, it's full of "
"gold!\""
msgstr ""
"\"너의 진실된 행동이 부패한 하인들과 신하들의 악몽으로부터 벗어날수 있었어! 이제 네 금고를 약탈할 사람이 없으니, 금으로 가득 "
"차겠구나!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0015_Text
#. Speaker : MaegarVarn_Capital
msgctxt "c2cdc425-c6d2-4e43-99ea-039e3d8c3f94"
msgid ""
"\"You're not as simple as you pretend to be. All right. I will make the "
"necessary arrangements.\""
msgstr "\"네가 생각하는 것보다 단순하지 않아...흠..좋아.해볼게.. 우선 필요한 준비를 해야겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0016_Text
#. Speaker : Jubilost_Companion
msgctxt "90a116b4-9082-4a70-b34a-d561487c0f5d"
msgid "\"That's a promising idea. I will organize everything.\""
msgstr "\"그거 좋은 생각이야. 이제 정리하러 갈볼까나.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0017_Text
#. Speaker : SadisticMage_Capital
msgctxt "02c42aec-1f4f-46dc-b4dd-0a8a25aaf966"
msgid ""
"\"Great idea. Every gold coin we invest in this will multiply tenfold!\""
msgstr "\"진짜 좋은 생각인데?. 낄낄 우리가 투자한 돈들이 10배가 된다고!!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0018_Text
#. Speaker : MaegarVarn_Capital
msgctxt "ab5aea39-2696-406f-961c-878e37c20abb"
msgid ""
"\"Taking care of youth is certainly the way to go. Let them see the world!\""
msgstr "\"젊은 인재를 키우는 것이 확실한 미래야. 그들에게 더 넓은 세상을 경험시켜주자!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0019_Text
#. Speaker : Jubilost_Companion
msgctxt "e1f96e82-7a17-4f73-a05c-a28e52f6a01c"
msgid ""
"\"I'm glad that my example has proven to you how valuable a well-rounded "
"outlook can be.\""
msgstr "\"나의 조언이 너에게 딱 들어 맞았다는 것을 증명해줘서 기뻐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0020_Text
#. Speaker : SadisticMage_Capital
msgctxt "95d3713e-e952-4485-b277-b57ccfa3f321"
msgid "\"Very wise. We shall need some foreign-trained servants.\""
msgstr "\"정말 똑똑한 생각이야. 우린 외국 용병들이 필요해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0021_Text
#. Speaker : MaegarVarn_Capital
msgctxt "9089fd1a-cbcd-4d2e-a82f-7c0cf466a9b3"
msgid ""
"\"Very well. It's wise to protect your fields from an early autumn or a "
"torrid summer. When I was a baron, I also tended first to my subjects' "
"bellies.\""
msgstr "\"아주 좋아. 초가을이나 여름부터 밭을 지키는 것이 현명하지. 나도 남작 시절엔 우선 나의 백성들 배부터 채웠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0022_Text
#. Speaker : Jubilost_Companion
msgctxt "de0d69ed-19b7-47ca-834c-daf463ea5463"
msgid ""
"\"Perfect! Finally I'll have someone to talk to. I mean, academically.\""
msgstr "\"완벽해! 드디어 학문적으로 얘기할 사람이 생겼어!! \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0023_Text
#. Speaker : SadisticMage_Capital
msgctxt "959d0621-93fd-4fcb-a0ab-22e0bbc732a7"
msgid ""
"\"Having a court mage of such skill is very prestigious indeed. And "
"advantageous! I admire your vision!\""
msgstr "\"이 정도로 마법 실력이 뛰어난 마법사라니...좋아..유리해...너 굉장한걸?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0024_Text
#. Speaker : MaegarVarn_Capital
msgctxt "d4ebffd2-33be-49fa-8ff9-c7d3dd25e28c"
msgid ""
"\"Your Highness, I have come to express my boundless respect! I had no idea "
"I would be a part of something this... grand. You were able to build a "
"prosperous and wealthy state, where there was once just a broken, cursed, "
"and godforsaken backwoods.\""
msgstr ""
"\"전하, 무한한 경의를 표하러 왔사옵니다! 내가 이런 위대한 일에 한 보탬이 되다니..! 전하로 인해서 한때는 부서지고 저주받으며 "
"고귀한 등나무밖에 없던 이 나라를 선진국으로 건설할 수 있었사옵니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0025_Text
#. Speaker : MaegarVarn_Capital
msgctxt "4111a309-034c-4ae2-8d4c-1ca642596c22"
msgid ""
"\"Your efforts have brought in too much money. It's strange, I never "
"expected I'd say these words. Anyway, you must decide where to invest it. I "
"suggest you invite an experienced weather mage from {g|Absalom}Absalom{/g} "
"to drive droughts and floods away from our fields. Another option is to send "
"our talented youth abroad for study. Or, for that matter, we could open a "
"couple of trade offices in neighboring countries and use them as cover for "
"our agents.\""
msgstr ""
"\"당신 덕분에 굉장한 큰 돈을 벌었어. 난 전혀 기대도 하지않았는데 말이야. 어쨌든, 이 돈들을 다시 어디에 투자할지 결정해야해. 나는 "
"당신{g|Absalom}압살롬{/g}에서 백성들의 밭에서 가뭄과 홍수로 부터 구원해줄수 있는 기우제나 기청제가 가능한 마법사를 초대했으면 "
"해. 그게 아니면 우리의 젋은 인재들을 유학을 보내는 거야. 아니면 우리 개인적인 이익을 위해 다른 나라에 무역사무소을 세우고 큰 돈을 "
"벌수도 있고.. 물론 부가적으로 우리 젋은 인재들도 감싸주겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0026_Text
#. Speaker : Jubilost_Companion
msgctxt "fee052e4-169a-438c-a734-0ec17354d26c"
msgid ""
"\"I know why you applied such effort, {name} – why you turned this wasteland "
"into an advanced, wealthy, and prosperous state. And today you will hear the "
"words you've been striving for all this time. I'm proud of you.\""
msgstr ""
"\"이 아무것도 없는 이 땅을 부유하고 강력하게 만들기 위해 얼마나 노력을 했는지 알아, {name}-. 앞으로 모두가 널 칭송할꺼야. "
"나부터 말할게. 정말 고맙고 존경합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0027_Text
#. Speaker : SadisticMage_Capital
msgctxt "cc2a7728-d362-4022-85e4-08e61888b062"
msgid ""
"\"Your Highness! As your humble servant, allow me to express my respect. You "
"have turned a gloomy, hopeless land into a region of prosperity and "
"opportunity. I hope you fully appreciate my modest contribution.\""
msgstr ""
"\"전하! 당신의 보잘것없는 신하로서, 존경의 뜻을 표하게 해주시오. 전하께선 이 암울하고 절망적인 땅을 번영과 기회의 나라로 완전히 "
"바꾸어 놓았습니다. 진정한 성군이십니다!.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0028_Text
#. Speaker : Jubilost_Companion
msgctxt "d36c5bc2-7c59-4ce9-83ee-0878d8968094"
msgid ""
"\"We managed to fill the treasury. Overflow it, in fact. Literally. The "
"abundance of gold in the royal treasury has caused our subjects to develop a "
"nasty disease. Greed – causing an acute inflammation of envy. Take my "
"advice. Invite a famous weather mage from {g|Absalom}Absalom{/g} to the "
"capital. I've heard his lectures. He's a true harvest-saving expert. He will "
"protect the crops against flood or drought. Another option is to send our "
"gifted youth abroad for study. On the other hand, if we harbor less-than-"
"noble intentions, we might set up a few trade offices in neighboring "
"countries to serve as cover for your agents.\""
msgstr ""
"\"우리는 이제 매우 풍족해. 그런데 그 풍족함이... 우리 신하들을 탐욕만 밝히는 돼지로 만들고야 말았어. 탐욕은 결국 나라를 망하게 "
"할꺼야. 내 충고를 들어. {g|Absalom}압살롬{/g}의 기우제나 기청제가 가능한 마법사를 수도로 초대해. 나는 그의 강의를 "
"들어봤어. 그는 진정한 농민의 보호자야. 그는 농작물을 홍수나 가뭄으로부터 보호할꺼야. 또 다른 선택은 우리의 재능 있는 젊은이들을 유학 "
"보내는 것이지. 그것도 아니면 더 큰 돈을 벌기 위해 다른 나라에 무역사무소를 설립할수도 있겠지. 물론 부가적으로 우리 젊은 인재들도 "
"감싸주는 효과도 있어. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0029_Text
#. Speaker : SadisticMage_Capital
msgctxt "9cfc1dd2-2d3c-4bfa-8601-20102d8d0dbb"
msgid ""
"\"I wouldn't seal away the kingdom's coffers. You should rather invest the "
"money. Consider inviting a famous weather mage from {g|Absalom}Absalom{/g}. "
"His services are expensive, but he would protect our harvests from droughts "
"and floods. Another promising project would be to send our youth abroad for "
"study. We could also open several trade offices in the neighboring "
"countries. As cover for our agents, of course.\""
msgstr ""
"\"왕국의 금고를 여는 것을 추천해. 너는 차라리 그 돈을 투자해야 한다. {g|Absalom}압살롬{/g}의 기우제나 기청제가 가능한 "
"마법사를 초대하는 것을 고려해봐. 그의 몸 값은 비싸지만 가뭄과 홍수로부터 백성들의 농작물을 보호해줄테니깐. 아니면 또 괜찮은 것 중 "
"하나는 우리의 젊은 인재들을 유학 보내는거야. 마지막으론 다른 나라에 무역 사무소를 몇 개 열어서 돈을 더 챙기는거지. 물론 부가적으로 "
"우리 젋은 인재들도 감싸주겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0030_Text
#. Speaker : Kanerah_Companion
msgctxt "d2ba68e5-a830-4cb5-a5c1-9e1399d00845"
msgid ""
"\"Tell me, how does a gardener feel, when he looks at flowers blooming in a "
"garden that he's grown in an arid desert? How does an alchemist feel when "
"the gray lead in his vial turns into shining gold? You received this land as "
"a wild, uninhabited swamp – and now the richest merchants in the land vie "
"for the right to do business here! I can only be proud of being a humble "
"part of this miracle you've made happen.\""
msgstr ""
"\"말해봐. 식물을 키우는 사람이 사막에서 피어나는 꽃을 보면 어떤 기분일까? 연금술사는 자신의 회색 납이 빛나는 금으로 변했을 때 어떤 "
"기분이 들겠니? 넌 사람이 살지 않는 야생의 늪, 황무지 였던 이 땅을 통치했고, 지금은 전국의 부유한 상인들이 이 땅에서 서로 먼저 "
"사업 독점권을 두고 다투고 있다. 네가 이뤄낸 기적에서 내가 조금이나마 보탬이 되었다는게 너무 자랑스러워.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0031_Text
#. Speaker : Kanerah_Companion
msgctxt "72084fe7-1a16-4e46-8375-b917bc71d525"
msgid ""
"\"Your servants are loyal to you. Each of them remembers how much they owe "
"you, how your generosity raised them up – and how your disfavor could turn "
"them to dust. They didn't suddenly transform into honest people, but you've "
"nevertheless managed to build a sturdy house from gnarled boards!\""
msgstr ""
"\"신하들은 당신에게 충성하고있어. 그들은 각자 당신에게 얼마나 많은 빚을 졌는지, 당신의 관대함이 그들을 어떻게 끌어올렸는지... 뭐 "
"그들이 갑자기 정직한 사람으로 변하지는 않겠지만, 그럼에도 불구하고 당신은 이들을 통해 튼튼한 나라를 이끌순있었잖아!!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0032_Text
#. Speaker : Kanerah_Companion
msgctxt "06640614-31da-4cb4-84f5-60f358455719"
msgid ""
"\"Like a well-trained dog who wouldn't dare to look at the meat in front of "
"it without its master's order, your servants have all but forgotten what "
"bribery and embezzlement are. No longer do they serve their own purses, but "
"only the glory and prosperity of the state.\""
msgstr ""
"\"주인 명령 없이 감히 앞에 있는 고기를 쳐다볼 엄두도 못 내는 잘 훈련된 개처럼, 당신의 신하들은 뇌물과 횡령이라는 것이 무엇인지 "
"거의 잊어버렸어. 그들은 이제 탐욕을 버리고 오직 국가의 영광과 번영만을 섬기고 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0033_Text
#. Speaker : Kanerah_Companion
msgctxt "ad05f237-abc8-46f9-a1a6-9e83c58b71ce"
msgid ""
"\"Of course, there is no such thing as excess of money, but we do have some "
"idle funds. It would be unwise to let them lie fallow in your coffers! We "
"should spend the money to increase the profits and glory of the nation. I "
"suggest we invite a famous wizard from {g|Absalom}Absalom{/g} who could "
"command the weather. Such a learned man would not only adorn your court with "
"his presence, but ease the lives of the peasants who suffer from droughts "
"and floods. We might also invest in the younger generation, and pay the "
"tuition fees of promising young men and women at foreign universities. We "
"could even open trade missions in neighboring countries – which could make "
"an excellent cover for our spies!\""
msgstr ""
"\"물론 넉넉하진 않지만 그래도 여윳돈들은 있어. 너의 금고가 텅텅 비어가는 것을 내버려두는건 멍청한 짓이지만 국가의 이익과 영광을 "
"높이기 위해 그 돈을 써야해. {g|Absalom}압살롬{/g}에서 기우제나 기청제가 가능한 유명한 마법사를 초대할 것을 제안해. 그런 "
"능력 있는 사람들은 궁전안에서 뿐만 아니라 가뭄과 홍수로 고통받는 농민들의 삶을 구원해줄수가 있어. 우리는 또한 유학가있는 유망한 젊은 "
"남녀의 등록금을 지불할 수도 있지. 또한 심지어 다른 나라에 무역 사절단을 열 수도 있다. 이것은 돈도 벌고, 스파이도 심을 수 있지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0034_Text
#. Speaker : Kanerah_Companion
msgctxt "d5af4902-a6aa-43cf-959b-a6ae0eb6f463"
msgid ""
"\"Your decision is wise as usual! What could be more prestigious than "
"masters of arcane arts at court?\""
msgstr "\"역시나 너의 결정은 변함없이 현명하다! 궁정에서 아카데미의 마스터들보다 더 명성이 있는 것이 어디 있겠는가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0035_Text
#. Speaker : Kanerah_Companion
msgctxt "12d65be2-5e34-4532-9122-3b60d93f2d11"
msgid ""
"\"Right, we need to think about the future. The generation that will inherit "
"everything we've created must be ready to expand on our achievements, not "
"waste them.\""
msgstr ""
"\"맞아, 우리는 미래에 대해 생각해야 해. 우리를 물려받을 다음 세대는 더 번영할 준비가 되어 있어야지, 낭비하지 말아야 한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank10/Cue_0036_Text
#. Speaker : Kanerah_Companion
msgctxt "007d81ff-2edf-4aa0-8ed8-85c89270bab2"
msgid ""
"\"This decision will not bring us glory, but its benefit will be great. When "
"our envious neighbors start whispering and plotting against us, we'll know "
"right away – and be ready to dismantle their plots!\""
msgstr ""
"\"이 결정은 우리에게 영광을 가져다 주지는 않겠지만, 금전적인 이득은 클꺼야. 우릴 시기하는 다른 나라들이 우리에게 음모를 꾸미기 "
"시작하면, 우리는 바로 알게 될 것이고, 그들의 음모를 파해할 준비가 될 것이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Answer_0004_Text
msgctxt "a61ed51f-2b45-458a-8d2e-b56d479154fa"
msgid ""
"{g|Economy2_3}[Choice effects]{/g} [Gain 60 BP] \"Take these riches to the "
"treasury.\""
msgstr "{g|Economy2_3}[선택 시 효과]{/g} [60 BP 획득] \"이 물건들은 국고를 채우는데 사용하겠어\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Answer_0005_Text
msgctxt "06e06170-638f-422a-a6b9-a70f091c4af9"
msgid ""
"{g|Economy2_2}[Choice effects]{/g} \"The owners of these things might be "
"dead or on the run. We will use them to revive the villages that suffered "
"the most under the Stag Lord's reign.\""
msgstr ""
"{g|Economy2_2}[선택 시 효과]{/g} \"원래 주인들은 이미 죽었거나 도망 중일꺼야. 이 물건들을 우린 숫사슴 왕의 치하에서 "
"가장 큰 피해를 받았던 마을들을 재건하는데 사용하겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Answer_0006_Text
msgctxt "e044aa04-1008-42d2-ae63-9daf2887df58"
msgid ""
"{g|Economy2_1}[Choice effects]{/g} \"These things don't belong to me any "
"more than they belonged to the Stag Lord. Order them returned to the people."
"\""
msgstr ""
"{g|Economy2_1}[선택 시 효과]{/g} \"이 물건들은 숫사슴 왕이 약탈한 것이지 내 것이 아니야. 다시 백성들에게 돌려주도록 "
"하겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Answer_0007_Text
msgctxt "108a6b5d-7acf-450b-9912-885926022a95"
msgid "\"You may decide what to do with these things.\""
msgstr "\"이 물건들을 어떻게 할 것인가는 네가 결정해도 좋아\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0001_Text
#. Speaker : Jubilost_Companion
msgctxt "4cf04bdf-6a36-4fcb-9bab-7e0f5d5b870e"
msgid ""
"{n}Jubilost cordially greets you with a document.{/n} \""
"{mf|Baron|Baroness|King|Queen}! You will never guess what your Treasurer is "
"holding.\" {n}He waves a paper above his head. The ink on it seems still "
"wet.{/n}"
msgstr ""
"{n}주빌로스트가 손에 든 문서를 보이며 반갑게 인사합니다.{/n} \"{mf|남작|여남작|킹|여왕}! 내가 무엇을 들고 있는지 결코 "
"짐작하지 못할 걸.\" {n}그는 머리 위로 종이를 흔듭니다. 잉크가 아직 마르지 않은것 같습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0002_Text
#. Speaker : Jubilost_Companion
msgctxt "a77870b7-2e1b-4e61-b72d-41c335d94b16"
msgid ""
"\"This is a list of things that tumbled out of the wall of your own "
"basement, as the workers were undertaking repairs.\" {n}Jubilost adjusts his "
"glasses and starts reading.{/n} \"A gilded guard, one, silverware, three, a "
"set of old coins... The list is long and varied, so I'll get straight to the "
"point: it appears that your workers uncovered the Stag Lord's secret cache – "
"items stolen from his own henchmen.\""
msgstr ""
"\"일꾼들이 수리를 하고 있을 때, 지하실 벽에서 떨어져 나온 물건들의 목록이야.\" {n}주빌로스트는 안경을 고쳐 쓰고 목록을 읽기 "
"시작합니다.{/n} \"금 보호대 하나, 은그릇 셋, 오래된 동전 주머니 하나... 목록이 길고 다양하기까 요점만 바로 말하겠어. 너희 "
"일꾼들이 숫사슴 왕의 비밀 은닉처, 즉 자신의 부하들에게서 훔친 물건들을 찾아낸 것 같아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0003_Text
#. Speaker : Jubilost_Companion
msgctxt "279939e2-bc73-4f37-a326-0b0d80b25574"
msgid ""
"\"Finding the true owners of these things would be a hard and thankless job, "
"while taking these trinkets for your own chests is complicity to "
"expropriation. In other words – robbery. As your financial advisor, I "
"recommend a compromise: appraise these 'riches' and spend an equal amount on "
"reviving the villages laid to waste by the bandits. Let these treasures "
"bring some good to those who suffered most under the Stag Lord.\""
msgstr ""
"\"이 물건들의 진짜 주인을 찾는 것은 힘든데다 딱히 보람도 없는 일이 되겠지만, 그렇다고 그냥 챙긴다면 징발로 위장한 공모라 할 수 "
"있지. 쉽게 말해서 강도질이지. 너의 재무관으로서, 절충안을 추천하겠어. 이 '재물들'의 가치를 계산한 후, 도적들에 의해 폐허가 된 "
"마을을 재건하는데 같은 금액을 사용하는 거야. 숫사슴 왕 밑에서 가장 고통받았던 백성들에게 뭔가 보상이 되주도록 하자구.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0008_Text
#. Speaker : MaegarVarn_Capital
msgctxt "3ed252df-69d0-437d-aed9-7d759ea2fd38"
msgid ""
"{n}Maegar's face is lit with a contented smile.{/n} \"My deepest respects, "
"{mf|baron|baroness|King|Queen}! I have wonderful news for you: our workers "
"have unearthed a true treasure!\""
msgstr ""
"{n}메이가르의 얼굴에 만족스러운 미소가 번집니다.{/n} \"친애하는 나의 주군, {mf|남작|여남작|왕|여왕}! 당신에게 멋진 소식이 "
"있소: 우리 하인들이 진정한 보물을 발견했소!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0009_Text
#. Speaker : SadisticMage_Capital
msgctxt "28c04143-c2e3-41c4-b1c5-a6fcadf3b736"
msgid ""
"{n}Bartholomew bows down.{/n} \"{mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}, I am happy to see you well! I would not bother you were it not "
"for some wonderful news that I'm happy to share.\""
msgstr ""
"{n}바톨로뮤는 인사합니다.{/n} \"만나서 좋군, {mf|영주님|영주님|전하|전하}! 좋은 소식을 가져왔어! 이 소식이 좋지 않다면 "
"내게 화를 내도 좋아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0010_Text
#. Speaker : Jubilost_Companion
msgctxt "eed72f67-5c4a-48a7-a84c-c56c36321b70"
msgid ""
"\"Then I shall arrange that the funds be directed to the restoration of the "
"villages.\" {n}A contented smile crosses Jubilost's face.{/n}"
msgstr "\"그러면 난 이 보물들로 정착지를 재건해야겠어.\" {n}만족스러운 미소가 주빌로스트의 얼굴을 스치고 지나갑니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0011_Text
#. Speaker : Jubilost_Companion
msgctxt "9ca5c3d7-7d10-45c8-89c8-4710db84f611"
msgid ""
"{n}Jubilost sniffs, disappointed.{/n} \"A noble gesture, but folly "
"nonetheless. Very well, as you wish.\" {n}The gnome sighs sadly and waves "
"his hand.{/n}"
msgstr ""
"{n}주빌로스트는 실망한 채 코를 훌쩍입니다.{/n} \"고상한 행동이긴한데..어리석군... 좋아, 네가 원하는 대로 할게.\" {n}"
"그는 깊은 한숨을 쉬며 손을 흔듭니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0012_Text
#. Speaker : Jubilost_Companion
msgctxt "0d92d1be-5947-4cc0-b329-4b5f22293196"
msgid "{n}Jubilost nods solemnly.{/n} \"I knew you would follow my advice.\""
msgstr "{n}주빌로스트는 엄숙하게 고개를 끄덕입니다.{/n} \"내 충고를 따를 줄 알았어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0013_Text
#. Speaker : Jubilost_Companion
msgctxt "4815a0d1-4396-40bb-b6e6-20dcfa51bb44"
msgid ""
"{n}Jubilost lets his glasses fall to the tip of his nose as he sizes you up, "
"annoyed.{/n} \"So it's like that, is it? Following the example of your "
"predecessor? If I were you, I would think well about this Stag Lord you're "
"so glad to imitate – and the way he ended up!\""
msgstr ""
"{n}주빌로스트는 코끝까지 안경을 늘린채 당신을 쳐다보며 짜증을 냅니다.{/n} \"결국 이렇게 된단 말이지, 안 그래? 전임자를 그대로 "
"따라하려고? 내가 너라면 그 수사슴 군주에 대해 잘 떠올려보겠어. 그를 따라하는 너에게 찬사를 보낼게. 아참, 그거 알지? 숫사슴 왕이 "
"결국 어떻게 되었는지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0015_Text
#. Speaker : MaegarVarn_Capital
msgctxt "8a63479e-ffaa-402e-af71-78a3671989d8"
msgid ""
"\"Well, not exactly a treasure... more like the secret cache of the Stag "
"Lord. Our workers broke through a wall to expand the basement, and found "
"inside a hidden alcove filled with valuables. Not endless gold, but not "
"rubbish either. I think they are the valuables of locals who thought they'd "
"buy a few days' peace from the Stag Lord and his bandits.\""
msgstr ""
"\"글쎄, 그렇게 엄청난 보물은 아니지만... 숫사슴 왕의 비자금에 가깝지. 하인들은 지하실을 확장하기 위해 벽을 뚫고 들어가 귀중품들로 "
"가득 찬 것들을 발견했어. 막대한 자금은 아니지만, 작은것도 아니야. 나는 그것들이 숫사슴 왕과 그 졸개들이 백성들을 협박해서 약탈한 "
"귀중품이라고 생각해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0016_Text
#. Speaker : MaegarVarn_Capital
msgctxt "117ab91c-2f4d-4467-99c4-cd4a86366e6d"
msgid ""
"\"It's up to you what we should do with these items. Of course, they were "
"found in your castle, so you could keep them in the treasury...\" {n}Maegar "
"cringes.{/n} \"If you wish to consider the opinion of your Treasurer, I say "
"you'd best give them away. It wouldn't amount to a great loss, and a few "
"people might recover their family heirlooms.\""
msgstr ""
"\"우리가 이 보물들을 어떻게 해야 하는지는 영주께 달려있소. 물론 당신의 성에서 발견되었으니, 그걸 금고에 보관할 수 있겠지...{n}"
"메이가르는 움찔합니다.{/n} \"만약 내 생각을 듣고 싶으시다면, 이 보물들을 다시 백성들에게 돌려주는 것이 좋다고 생각하오. 그건 "
"딱히 큰 손해도 아니고, 몇몇 백성들은 소중한 가보를 되찾을지도 모르니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0018_Text
#. Speaker : SadisticMage_Capital
msgctxt "8304c4b7-1a96-4d69-ae62-b11542bd950e"
msgid ""
"\"The workers who are expanding the old fort's basements stumbled upon a "
"cache. It appears that the bandit leader, who previously lived in this "
"fortification, kept a little stash for a rainy day. Luckily, I was able to "
"intervene before the workers stole everything, and now the treasure is at "
"my... I mean at your disposal.\""
msgstr ""
"\"요새를 새로 확장하고있는 중에 하인들이 우연히 보물을 발견했어. 이전에 이 요새에 살았던 숫사슴 왕이 혹시 몰라서 숨겨둔 비자금 "
"같은데... 운 좋게도, 하인들이 우리 몰래 빼돌리기 전에 발견했지. 물론 빼돌리거나 그러진 않았지만 말이야. 이 보물들은 "
"내게도...아니아니 말 실수야. 내 말은 당신 마음대로 하라는거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0019_Text
#. Speaker : SadisticMage_Capital
msgctxt "00539df3-a8db-4785-ade5-8d1ae2015249"
msgid ""
"\"I recommend you claim the cache for your treasury. No matter how these "
"things made their way to the Stag Lord, they are now yours – just like the "
"castle, the surrounding lands, and all who live upon them. As your "
"Treasurer, I assure you – in the future you and your "
"{mf|barony|barony|kingdom|kingdom} will require all the money you can get!\""
msgstr ""
"\"이 보물들을 우리 금고에 넣어두자. 이 보물들을 숫사슴 왕이 어떻게 구했던지간에.. 숫사슴 왕의 땅, 요새, 백설등.. 등 모든것은 "
"당신 거야. 당신의 재무관으로서, 나는 추천하지 – 앞으로 이 보물들을 금고에 넣어두자. 분명 당신과 당신의 "
"{mf|남작령|남작령|왕국|왕국}은 부흥시키는데 도움이 될 테니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0020_Text
#. Speaker : MaegarVarn_Capital
msgctxt "86ee9b33-7e23-49cd-ba08-11c62c6f2c7d"
msgid ""
"{n}Maegar's face grows dark.{/n} \"It's wrong to put claim such stolen "
"things for yourself. I do hope in the future you will be more attentive to "
"those who are less lucky in life than you.\""
msgstr ""
"{n}메이가르의 얼굴이 어두워집니다.{/n} \"훔쳐진 물건들을 당신 것이라고 주장하는건 옳지 않소.. 나는 당신이 좀 더 불운한 "
"백성들을 위해 더 관심을 갖기를 희망하오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0021_Text
#. Speaker : MaegarVarn_Capital
msgctxt "24b47595-7f33-4547-87b6-10ebf4998fd4"
msgid ""
"\"Very wise, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. But "
"still, such a pity these things will never see their proper owners again... "
"but your decision is probably fairer. I will make the necessary arrangements."
"\""
msgstr ""
"\"아주 현명한 결정이오, {mf|영주님|영주님|전하|전하}! 이 재화들이 정당한 주인을 찾지 못하게 되는 것은 안타까우나... 그래도 "
"논란의 여지 없이 현명한 결정이오! 그렇게 처리하러 가보겠소.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0022_Text
#. Speaker : MaegarVarn_Capital
msgctxt "fa6e28ea-e190-4aed-8cfe-e0eec07798c8"
msgid ""
"{n}Maegar nods contentedly.{/n} \"We will do just that, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}, don't you worry. I will do everything in "
"my power to personally track down the proper owners of each little thing – "
"that is, of course, if they're still alive and weren't run off by the "
"bandits.\""
msgstr ""
"{n}메이가르는 만족스럽게 고개를 끄덕입니다.{/n} \"그렇게 하겠소, {mf|영주님|영주님|전하|전하}, 걱정 마시오. 모든 힘을 "
"동원해서라도 올바르게 백성들에게 나눠줄 테니. 물론 떠난 사람에겐 안타깝겠지만 말이오...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0023_Text
#. Speaker : MaegarVarn_Capital
msgctxt "5dd53f2e-f1da-4da9-baa7-f34495c57fde"
msgid ""
"\"Thank you for your trust, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. With your permission, I shall order the discovered riches "
"returned to the people.\""
msgstr ""
"\"믿어줘서 고맙소, {mf|영주님|영주님|전하|전하}. 당신께서 허락하신다면, 즉시 발견된 보물들을 백성들에게 다시 돌려주도록 "
"명령하겠소.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0025_Text
#. Speaker : SadisticMage_Capital
msgctxt "5f6c9d6b-d4d2-4761-bda1-4ad064bf197b"
msgid ""
"\"A wonderful decision, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}! I will do as you ask!\""
msgstr "\"좋은 결정이야, {mf|영주님|영주님|전하|전하}! 당신 뜻대로 하지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0026_Text
#. Speaker : SadisticMage_Capital
msgctxt "c1b786d9-c334-4e8d-910a-c7b0030d3e62"
msgid ""
"{n}Bartholomew strokes his mustache, brooding.{/n} \"You are farsighted, {mf|"
"Your Grace|Your Grace|Your Highness|Your Highness}. I hope the returning "
"village folk appreciate your generosity.\""
msgstr ""
"{n}바솔로뮤는 콧수염을 쓰다듬으며 곱씹습니다.{/n} \"당신은 영명하군, {mf|영주님|영주님|전하|전하}. 돌아온 마을 사람들이 그 "
"관대함에 감사하길.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0027_Text
#. Speaker : SadisticMage_Capital
msgctxt "8bc78c9d-4cf8-442c-ae77-5403261b0f9c"
msgid ""
"{n}Red spots appear on Bartholomew's face, and he repeatedly opens his "
"mouth, as if gasping for air.{/n} \"{mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}! How could you! Such... pointless... expenses! If we keep "
"giving your treasures away at this rate, we'll soon be begging on the "
"streets!\" {n}The Treasurer is silent for a few moments, then sighs and "
"lowers his head.{/n} \"As you wish, {mf|baron|baroness|Your Highness|Your "
"Highness}.\""
msgstr ""
"{n}바솔로뮤가 얼굴에 붉히며 숨을 헐떡이듯 입을 엽니다.{/n} \"{mf|영주님|영주님|전하|전하}! 어떻게 그런 일을! 그런... "
"의미없는 짓을..! 이대로 계속 보물을 나누어 주면 우린 곧 길거리에서 구걸하게 될 거야!\" {n}그는 잠시 침묵하다가 한숨을 쉬며 "
"고개를 숙입니다.{/n} \"분부대로, {mf|남작|여남작|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0028_Text
#. Speaker : SadisticMage_Capital
msgctxt "5dd0964a-3e6d-4ced-9b78-3b437e1bf25d"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, I am glad to be "
"worthy of your trust. I shall ensure that all these riches, to the last "
"coin, find their way into your coffers.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 당신의 진심은 신뢰받을 가치가 있어. 이 모든 재화들은 마지막 한 푼까지, 당신의 금고에 들어갈 "
"수 있도록 조치하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0029_Text
#. Speaker : Kanerah_Companion
msgctxt "7877f373-2834-4c5b-a56c-4ead5252f344"
msgid ""
"\"Look at this.\" {n}Kanerah is fiddling with a fine silver snuffbox.{/n} "
"\"It's just a small part of the treasures that the workers found in the "
"fort's cellars. The treasure's unpleasant history puts both of us – you as "
"the {mf|baron|baroness|King|Queen}, and me as your Treasurer – in an awkward "
"position.\""
msgstr ""
"\"이것 좀 봐.\" {n}카네라는 고운 은색 스너프 박스를 만지작거리고 있습니다.{/n} \"이건 하인들이 요새 지하실에서 발견한 보물 "
"중 하나일 뿐이지. 그 보물의 출처는 우리 모두를..특히나 {mf|남작|여남작|왕|여왕}과(와) 당신의 재무관인 나를 난처하게 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0030_Text
#. Speaker : Kanerah_Companion
msgctxt "2eb304b7-3662-4449-a069-71f15c90cb0b"
msgid ""
"\"To Millar Fulson from his brothers-in-arms.\" {n}Kanerah frowns, reading "
"aloud the text engraved on the lid.{/n} \"And all the other treasures are "
"the same. Goblets, silverware, jewelry... Some still tainted with dried "
"blood. Apparently, the Stag Lord stashed away many of the valuables he'd "
"pillaged. And now we must decide what to do with this dark inheritance.\""
msgstr ""
"\"밀러 풀슨에게 그의 전우가.\" {n}카네라는 뚜껑에 새겨진 텍스트를 소리내어 읽으며 눈살을 찌푸립니다.{/n} \"다른 보물들도 다 "
"똑같아. 고블렛, 은그릇, 보석... 일부는 아직도 말라붙은 피로 얼룩져 있어. 분명히, 숫사슴 왕은 그가 약탈한 많은 귀중품을 "
"숨겨놨어. 그리고 이제 우리는 이 약탈해서 모은 보물을 어떻게 할 것인가를 결정해야해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0031_Text
#. Speaker : Kanerah_Companion
msgctxt "2f47acb5-370f-4e74-83a1-fe248b3080f0"
msgid ""
"\"We can't keep it. If we do, we'll admit we're not a legitimate power, but "
"just another gang of thieves. On the other hand, how are we ever going to "
"find this Fulson and all the other poor victims? How many of them still "
"live? I suggest we use these treasures to restore the villages decimated by "
"the Stag Lord. That will be good for the state, and at the same time will "
"strengthen your reputation as a fair ruler.\""
msgstr ""
"\"우리가 가질 수는 없어. 만약 그렇게 하면, 우리는 정당한 권력이 아니라, 그저 또 다른 산적 무리라는 것을 인정하는 격이야. "
"하지만, 이 풀슨과 다른 불쌍한 희생자들을 어떻게 찾을 수 있을까? 그들 중 몇 명이 아직도 살아 있을까? 나는 이 보물들을 숫사슴 왕에 "
"의해 파괴된 마을들을 복구하는 데 사용할 것을 제안해. 그러면 국가에 도움이 될 거고, 동시에 이 땅의 진정한 주인으로서의 명성을 얻을 "
"수 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0032_Text
#. Speaker : Kanerah_Companion
msgctxt "0b301ed9-5916-4feb-abc8-d74a01c67ed1"
msgid ""
"{n}Kanerah shakes her head.{/n} \"Fair, but impractical. Your subjects will "
"appreciate the gesture, of course, but I'm afraid we'll spend more money "
"looking for the owners of these little treasures than they're even worth. "
"Well, I'll go put together an inventory!\""
msgstr ""
"{n}카네라는 고개를 흔듭니다.{/n} \"공정하지만, 비실용적이야. 물론 너의 백성들이 고마워는 하겠지만, 나는 우리가 이 작은 "
"보물들의 주인들을 찾는데 더 많은 돈을 쓸까 봐 두렵워. 뭐, 그럼 나는 가서 재고 정리를 해볼게!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0033_Text
#. Speaker : Kanerah_Companion
msgctxt "b1fd43b0-0a7b-4e4f-83b7-b41273649aed"
msgid ""
"\"That's the right call. This way you'll be able to present yourself as a "
"fair benefactor to your subjects – and at their own expense!\""
msgstr "\"바로 그거야. 그렇게 하면 너는 신하들 모두의 은인이 되겠지. 돈 한 푼도 안 들이고 말이야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0034_Text
#. Speaker : Kanerah_Companion
msgctxt "e14e8c23-7daa-46dd-b6f7-80630e892668"
msgid ""
"{n}Kanerah shakes her head.{/n} \"I will do as you say, but I must warn you, "
"you're making a mistake. You'll have enough chances to rob these poor folks. "
"But you shouldn't pass up the chance to buy something that's usually not for "
"sale – their good will.\""
msgstr ""
"{n}카네라는 고개를 흔듭니다.{/n} \"네 말대로 하겠지만,이건 분명히 알아둬. 너는 지금 실수하고 있어. 이 불쌍한 사람들을 털 "
"기회는 충분히 있을거야. 하지만 구할 수 없는 것... 다시말해 그들의 선의를 살 기회를 놓쳐서는 안 돼.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank2/Cue_0035_Text
#. Speaker : Kanerah_Companion
msgctxt "400161b0-f163-4e69-9981-7dd232cf00ce"
msgid ""
"\"So we'll spend it on restoring the villages. Most importantly, we need to "
"spread the word about this as quickly as possible. Even villages that won't "
"see a single copper of this treasure will hear all about your generosity and "
"fairness!\""
msgstr ""
"\"그래, 마을 재건에 사용하자! 이제 제일 중요한 건 가능한 한 빨리 이 문제에 대해 소문을 퍼뜨려야 한다는 거야. 그래야 다른 마을 "
"주민들도 그 은혜와 공정함에 대해 모두 듣게 될 테니까!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Answer_0011_Text
msgctxt "86da9a1d-c142-4657-b12b-caeff2bdb1f0"
msgid ""
"{g|Economy3_1}[Choice effects]{/g} [Pay 2 BP each week] \"I have another "
"proposal. We will lower the taxes slightly, allowing the economy to grow in "
"the future. First of all we need to think about the common people.\""
msgstr ""
"{g|Economy3_1}[선택 시 효과]{/g} [매주 2 BP 손실] \"다른 제안이 있어. 세금을 조금 낮춰서, 앞으로 경제가 "
"성장할 수 있도록 하는거야. 우린 우선 평민들을 생각할 필요가 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Answer_0012_Text
msgctxt "4889f408-bb07-4453-82ed-53e661813977"
msgid ""
"{g|Economy3_2}[Choice effects]{/g} \"We will raise the taxes by one third. I "
"think this will be a fair solution.\""
msgstr "{g|Economy3_2}[선택 시 효과]{/g} \"세금을 3분의 1 인상하겠어. 이정도면 공정한 해결책일꺼라 생각해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Answer_0013_Text
msgctxt "397d5680-cb4b-4ccf-b32b-1a44cdc2d0ee"
msgid ""
"{g|Economy3_3}[Choice effects]{/g} [Gain 2 BP each week] \"Let us double the "
"taxes. The barony needs all the money it can get.\""
msgstr ""
"{g|Economy3_3}[선택 시 효과]{/g} [매주 2 BP 획득] \"세금을 두 배로 올리겠어. 영지엔 최대한 많은 자금이 필요해."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Answer_0014_Text
msgctxt "ed518616-a9f7-41bf-b55e-52e0ba6d0090"
msgid "\"I trust you. Do as you deem right.\""
msgstr "\"널 믿겠어. 네가 옳다고 생각하는 대로 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Answer_0030_Text
msgctxt "e2287085-f7a8-43f4-b713-be9e46fca2ac"
msgid ""
"{g|Economy3_4}[Choice effects]{/g} [Pay 3 BP each week] \"I like this idea. "
"Let us announce a mandatory work initiative, and lower the taxes.\""
msgstr ""
"{g|Economy3_4}[선택 시 효과]{/g} [매주 3 BP 손실] \"그 제안이 마음에 드는군. 의무 노역 계획을 발표하고, "
"세금을 낮추도록 하시오. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0001_Text
#. Speaker : MaegarVarn_Capital
msgctxt "3e82573a-2055-4e7b-a2db-b07eb905e5f7"
msgid ""
"\"Greetings, {mf|baron|baroness|King|Queen}! I hope you are in a good mood. "
"We need to discuss a rather unpleasant matter...\""
msgstr ""
"\"안녕하십니까, {mf|영주님| 왕이시여|여왕이시여}! 기분이 좋으시다면 바랍니다. 다소 불쾌한 문제에 대해 논의해야 하니까요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0002_Text
#. Speaker : MaegarVarn_Capital
msgctxt "b6811785-f5fb-4377-b43b-1fcaef5934f8"
msgid ""
"\"Your {mf|barony's|barony's|kingdom's|kingdom's} expenses have increased "
"several times recently. Construction, clearing lands, urban beautification – "
"all of this requires resources. And we don't have the revenue to match. The "
"only thing we can do is raise taxes. Of course, your subjects won't like it, "
"no matter how much money you demand.\""
msgstr ""
"\"{mf|영지의|영지의|왕국의|왕국의} 필요한 예산은 최근 몇 배나 증가했습니다. 건설, 토지 개간, 도시 미화 - 이 모든 것엔 "
"자금이 필요합니다. 그러나 현재 영지엔 그에 걸맞는 수입원이 없습니다. 가능한 방법은 세금을 올리는 것뿐입니다. 물론 세금을 올리면 "
"백성들이 좋아하진 않을겁니다만...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0003_Text
#. Speaker : MaegarVarn_Capital
msgctxt "51e1bf47-ed8f-4551-97a9-967effacd5ba"
msgid ""
"{n}Maegar strokes his beard thoughtfully.{/n} \"Although... there may be "
"another way out. We might avoid any unpleasantness, if instead of money you "
"introduce... let's call it a mandatory work initiative. The people will be "
"required to work for the betterment of their community. They won't be as "
"irate if they see their work is directly for their own benefit.\""
msgstr ""
"{n}메이가르는 생각에 잠긴 듯 수염을 쓰다듬는다.{/n} \"하지만... 다른 방법이 있을지도 몰라. 만약 세금을 늘리는 대신에... "
"의무 노역을 시행하는거지. 백성들은 지역사회의 개선을 위해 일해야 할 거야. 그 부역이 자신들의 이익을 위한 것이라는걸 안다면 그렇게 "
"분노하지 않을거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0004_Text
#. Speaker : Jubilost_Companion
msgctxt "9b09dd4c-ca82-49de-8066-fa6c4559fc7b"
msgid ""
"\"Greetings, {mf|baron|baroness|King|Queen}! Let's not beat around the bush: "
"you and I simply must discuss taxes.\""
msgstr "\"안녕. {mf|영주님|영주님|전하|전하}! 단도직입적으로 말하지. 너와 나는 세금에 대해 논의해야만 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0005_Text
#. Speaker : Jubilost_Companion
msgctxt "6505c456-f5e7-4f05-8eb5-2930ca744199"
msgid ""
"\"I don't know how often you go to the treasury, but I go quite often "
"indeed, as my service requires. Well, there is less and less money in your "
"coffers, while the demands of the {mf|barony|barony|kingdom|kingdom} keep "
"growing. We simply must raise taxes, whether your subjects like it or not.\""
msgstr ""
"\"{mf|남작님|남작님|전하|전하}께서 얼마나 자주 금고에 가보는지는 모르지만, 난 내게 주어진 업무 상 꽤나 자주 가보고는 하지. "
"음, 금고의 돈은 점점 줄어가고 있는 반면, {mf|남작령|남작령|왕국|왕국}의 필요 예산은 점점 증가하고만 있어. 백성들이 좋아하든 "
"싫어하든 세금을 올려야만 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0006_Text
#. Speaker : Jubilost_Companion
msgctxt "3669ff40-3ea5-4a4b-b63d-21a199b3ef4c"
msgid ""
"\"If I were you, I would raise the tax modestly. Of course, the treasury "
"will not be replenished quickly, but the people will curse you significantly "
"less.\" {n}Jubilost grins.{/n} \"Which means you may remain on the throne "
"significantly longer.\""
msgstr ""
"\"내가 만약 너라면 세금을 조금만 올리겠어. 물론 국고는 빨리 채워지진 않겠지만, 그나마 백성들이 {mf|남작을|남작을|전하를|전하를} "
"덜 저주하겠지.\" {n}주빌로스트는 웃음 짓습니다.{/n} \"이 말은 곧, 네가 왕좌에 훨씬 더 오래 남아 있을 수 있다는 걸 "
"의미하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0007_Text
#. Speaker : SadisticMage_Capital
msgctxt "6325daa1-a23a-4a67-92dc-5d9303e6eb1d"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, it is good to see "
"you so well! I come to you with a delicate and urgent matter. Your "
"{mf|barony|barony|kingdom|kingdom} is in dire need of money, and I have come "
"up with the perfect way to raise it: introduce an additional tax.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 이렇게 뵙게 되어 영광입니다만! 난 예민한 문제를 다루고 있습니다. "
"{mf|남작령|남작령|왕국|왕국}의 돈이필요하긴한데, 나는 세금 인상을 위한 완벽한 방법을 생각해냈다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0008_Text
#. Speaker : SadisticMage_Capital
msgctxt "55a29cc2-7737-4264-9aa4-824a0068e604"
msgid ""
"\"Mark well my words: unless you raise taxes, the "
"{mf|barony|barony|kingdom|kingdom} simply will not survive. No matter what "
"you decide, you will have to increase the taxes. We can hardly expect the "
"peasantry to understand this necessity, but their understanding is not "
"required. As for me and your other attendants involved in the country's "
"finances – we will fully support you in your decision.\""
msgstr ""
"\"내 말을 잘 들어봐, 세금을 올리지 않으면 {mf|남작령|남작령|왕국|왕국} 살아남지 못할거야. 어쩔수없이 세금을 올려야해. 우리는 "
"백성들이 이것을 이해하기를 기대할 수 없지만, 그건 딱히 중요하지않아. 나부터 그리고 이 나라의 신하들은 당신의 결정을 전적으로 "
"지지할거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0009_Text
#. Speaker : SadisticMage_Capital
msgctxt "3eb35f5f-0553-4e05-8f06-57c9f672fa11"
msgid ""
"\"If you are interested in my advice, I am in favor of high taxes. Your "
"{mf|barony|barony|kingdom|kingdom} will thrive, and people will keep busy – "
"working hard to gather the required sums by the required dates. But of "
"course, the decision is yours.\""
msgstr ""
"\"내 말에 관심이 있다면,세금을 충분히 높이는 것을 추천한다. {mf|남작령|남작령|왕국|왕국}의 백성들은 번성할 것이며, 사람들은 "
"계속 바쁘게 움직이며, 필요한 날짜까지 필요한 금액을 모으기 위해 열심히 노력할 것이다. 하지만 물론 결정은 네 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0015_Text
#. Speaker : Jubilost_Companion
msgctxt "ac620373-0793-4c98-accd-b9aba4248181"
msgid ""
"\"At least you are not taking the shirts off their backs. Very well, I shall "
"execute your order, {mf|baron|baroness|King|Queen}.\""
msgstr ""
"\"적어도 백성의 등골을 빨아먹지는 않는다는거군. 잘 알겠어. 그대로 명을 실행하겠습니다. {mf|남작님|남작님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0016_Text
#. Speaker : Jubilost_Companion
msgctxt "974d1361-e46d-4ad7-bae9-19635b0a3c0c"
msgid ""
"{n}Jubilost adjusts his glasses.{/n} \"It does my heart good to see how "
"reasonable and patient you can be. Believe me, in such a situation this is "
"the best possible decision.\""
msgstr ""
"{n}주빌로스트가 안경을 고쳐씁니다.{/n} \"{mf|남작|남작|전하|전하}께서 얼마나 합리적이고 인내심을 가질 수 있는지 보는건 "
"나에겐 기쁜 일이지. 날 믿으라구. 이런 상황에서는 이게 최선의 결정이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0017_Text
#. Speaker : Jubilost_Companion
msgctxt "679b858e-7391-4abf-ae7e-5f4e4578fad8"
msgid ""
"{n}Jubilost cringes, removes his glasses and rubs his eyes.{/n} \"Mark my "
"words, {mf|baron|baroness|King|Queen}, your love for easy money will not "
"serve you well in the end. Very well, where was I... ah, right, I must go "
"execute your orders. If you will excuse me...\""
msgstr ""
"{n}주빌로스트는 인상을 찡그리며 안경을 벗고 눈을 비비며 말합니다.{/n} \"내말을 잘 들어둬. {mf|남작님|남작님|전하|전하}, "
"쉽게 버는 돈만 쫓는다면 결국 너에게 아무런 도움이 되지 않을거야. 좋아. 어디까지 했더라... 아, 그렇지, 네 명령을 수행하러 "
"가봐야겠어. 그럼 이만...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0018_Text
#. Speaker : Jubilost_Companion
msgctxt "0ead4527-c0c9-4e61-98de-61f5a53c1c0a"
msgid ""
"\"Right, I'm not here for decoration. I will raise taxes modestly, but not "
"more than the people can bear. – And you will thank me later for my far-"
"sightedness.\""
msgstr ""
"\"맞아, 난 여기 병풍이 될려고 온게 아니야. 나는 조금만 세금을 올리겠지만, 백성들이 받아들이지 못할 정도로 올리진 않을거야 그리고 "
"나중에 내 식견에 대해 감사하게 될 꺼라구.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0020_Text
#. Speaker : MaegarVarn_Capital
msgctxt "448cc102-8698-4d77-a9b5-92cf04ae2296"
msgid ""
"{n}Maegar nods solemnly.{/n} \"A fair decision, {mf|Your Grace|Your Grace|"
"Your Highness|Your Highness}! I shall make all the necessary arrangements.\""
msgstr ""
"{n}메이가르는 엄숙하게 고개를 끄덕인다.{/n} \"옳은 선택이야,{mf|영주|영주|전하|전하}! 나는 필요한 모든 준비를 하러 "
"갈꺼야\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0022_Text
#. Speaker : MaegarVarn_Capital
msgctxt "7c81081f-9fb5-49df-87c1-738df78ce482"
msgid ""
"{n}Maegar shakes his head.{/n} \"I admit, this is not the decision I "
"expected. Do you not fear riots, {mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}? I strongly suggest that in the future you give greater "
"concern to the needs of your subjects.\""
msgstr ""
"{n}메이가르는 고개를 흔든다.{/n} \" 그래..인정해 이건 내가 예상한 결과는 아니야. {mf|영주|영주|전하|전하}, 폭동이 "
"두렵지 않아? 향후 백성들의 요구에 대해 더 관심을 귀기울여줄 것을 강력히 요구할 게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0023_Text
#. Speaker : MaegarVarn_Capital
msgctxt "783df9e3-6eb1-49f6-b5f4-d2187e400a6b"
msgid ""
"\"Thank you, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. I will "
"immediately announce the establishment of your work initiative.\""
msgstr "\"고마워, {mf|영주님|영주님|전하|전하}. 즉시 공표하도록 할 게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0025_Text
#. Speaker : SadisticMage_Capital
msgctxt "cbef6a5c-37eb-4bbe-a6e7-6f0e3663ed4a"
msgid ""
"{n}Bartholomew's face darkens.{/n} \"And who will remain most concerned with "
"the treasury, {mf|Your Grace|Your Grace|Your Highness|Your Highness}? "
"Apparently, I myself am the only one who concerns himself with such trifles, "
"and you seem most dismissive of my apprehensions.\" {n}The Treasurer bows "
"solemnly, abruptly ending the conversation.{/n}"
msgstr ""
"{n}바솔로뮤의 얼굴이 어두워집니다.{/n} \"그렇다면 문제의 국고는 누가 관리한단 말입니까, {mf|영주님|영주님|전하|전하}? "
"확실한 건, 이런 사소한 일에 신경쓰는 건 저 뿐이고 전하께서는 제 고민을 무시하신다는 겁니다. \" {n}재무관은 정중하게 몸을 숙인 "
"뒤, 퉁명스럽게 말을 끝냈다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0026_Text
#. Speaker : SadisticMage_Capital
msgctxt "91d7df71-9f2b-44f7-bdde-37010bff88b5"
msgid ""
"\"Well, it's better than nothing. I shall instruct our tax collectors.\""
msgstr "\"음..아무것도 안 하는 것보다는 낫군. 세금징수원에게 지시하도록 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0027_Text
#. Speaker : SadisticMage_Capital
msgctxt "eef0aebc-1634-46c9-9bd1-4886aedf477f"
msgid ""
"{n}Your words make Bartholomew smile.{/n} \"You have made the right "
"decision, as usual. Rest assured: soon, our coffers will once more overflow "
"with gold!\""
msgstr ""
"{n}당신의 말은 바솔로뮤를 웃음짓게 합니다.{/n} \"평소와 같이, 당신은 바른 결정을 내렸습니다. 안심하십시오. 곧, 우리의 금고는 "
"금화로 다시 한번 넘쳐 흐를 것입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0028_Text
#. Speaker : SadisticMage_Capital
msgctxt "a3594895-032d-4722-9266-120fed262c55"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, I am glad to be "
"worthy of your trust. I shall double the taxes and ensure the treasury wants "
"for nothing.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 당신의 믿음을 살 수 있어 영광입니다. 세금을 두 배로 늘리고 금고를 가득 채워놓겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0031_Text
#. Speaker : MaegarVarn_Capital
msgctxt "f24dbb8f-20cd-4041-b679-befd9adddac7"
msgid ""
"{n}Maegar nods gratefully.{/n} \"I am pleased I can be helpful to you, and "
"take care of your subjects at the same time. As I have your permission, I "
"will proceed to make the necessary arrangements.\""
msgstr ""
"{n}메이가르가 감사해하며 고개를 끄덕입니다.{/n} \",자네에게 도움이 되어서 기쁘네. 자네 실험체를 돌보는 것도 말이지. 자네가 "
"허락했으니, 필요한 준비를 진행하도록 하겠네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0032_Text
#. Speaker : Kanerah_Companion
msgctxt "e41c0adc-d175-4ba2-8e43-6b7479882176"
msgid ""
"{n}A sweet smile plays on the tiefling's lips.{/n} \"I came to discuss "
"something that rulers love more than the sun in the sky – and subjects hate "
"more than plague. That thing that fills a state with strength, that golden "
"honey that diligent bees carry to their master's treasury... Yes, I'm here "
"to discuss taxes.\""
msgstr ""
"{n}티플링의 입가에 달콤한 미소가 새겨집니다.{/n} \"군주들이 하늘에 떠 있는 태양보다 더 좋아하는 것에 대해 상의하러 왔네. "
"백성들은 역병보다 싫어하는 것이지. 나라를 강국으로 만들고, 근면한 꿀벌이 벌집을 채우는 황금색 꿀물에 대하여... 그래 맞아. 세금 "
"문제에 대해 논의하러 왔어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0033_Text
#. Speaker : Kanerah_Companion
msgctxt "2773bb9c-61ec-4ebb-9dd1-dddf56730f25"
msgid ""
"\"Nobody has any more doubts that your power is here to stay. No one has any "
"illusions that your throne will be knocked over by the first gust of the "
"wind, or that these lands will ever be open to gangs again. – And that means "
"your subjects are ready to wear the heavy yoke of taxes.\""
msgstr ""
"\"만인지상인 당신의 권력을 부정할 이는 여기 아무도 없습니다. 아무도 당신이 갑자기 불어온 돌풍에 권좌로부터 날아가버릴까 걱정하지도 "
"않고, 이 땅이 다시금 강도들 소굴이 되리라 생각하지도 않지요. 이 말인 즉슨 백성들이 세금이라는 무거운 멍에를 찰 준비가 되었다는 "
"뜻입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0034_Text
#. Speaker : Kanerah_Companion
msgctxt "e4bb1664-d23e-4637-a632-91a1a5eb838a"
msgid ""
"\"Of course, some will grumble, but that's to be expected. We'll first spend "
"the taxes of the obedient on pacifying the ones who rebel. You've done a "
"fine job seizing power – now it's time to enjoy its fruits! I suggest we "
"double the taxes.\""
msgstr ""
"\"물론, 투덜대는 사람도 있겠지요. 하지만 그것 또한 예상 범위 내에 있습니다. 우선은 순종하는 사람들의 세금을 써서 반항하는 이들과 "
"평화조약을 맺어야 하겠지요. 권력을 아주 잘 휘어잡으셨습니다. 이제 그 결실을 수확할 때가 온 것이지요! 세금을 두 배로 높이길 "
"제안합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0035_Text
#. Speaker : Kanerah_Companion
msgctxt "31be4c7b-7aa1-49dd-9aae-06a01fe99a29"
msgid ""
"{n}The joy on Kanerah's face dissolves into disappointment.{/n} \"I keep "
"thinking about the ordinary people day and night. About what we can afford "
"to take from them, what we should leave them, how to reward the obedient and "
"punish the rebels... While you seem blind to the very nature of power! So be "
"it, I'll abate the taxes, but be warned: excessive kindness ruins rulers far "
"faster than excessive cruelty!\""
msgstr ""
"{n}카네라의 얼굴에 보이던 기쁨은 실망감으로 흩어집니다.{/n} \"난 온종일 평범한 사람들에 대해서만 생각하고 있어. 그들로부터 뭘 "
"앗아가야 할 지, 뭘 돌려줘야 할 지, 어떻게 순종하는 자들을 치하하고 반항하는 자들을 징계할지... 당신이 권력에 심취해 있는 동안에 "
"말이야! 그럼 좋아. 세금을 내리지. 하지만 경고하겠어. 지나친 친절은 폭정보다 더 빠르게 나라를 망칠 수 있음을 말이야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0036_Text
#. Speaker : Kanerah_Companion
msgctxt "ae7ee5de-de44-4c5d-80b3-fe0fed4acd20"
msgid ""
"\"Just a third? Such caution is commendable. Sometimes raising taxes can "
"lead to riots. But believe me, your sheep aren't starving. They have much "
"more wool to give!\""
msgstr ""
"\"3할만 말씀이십니까? 참으로 칭찬 할만한 조심성이로군요. 세금을 올리면 간혹 폭동이 일어납니다. 하지만 절 믿으시죠. 당신의 어린 "
"양들은 배를 곯지 않을 겁니다. 우리에게 줄 수 있는 털이 아직 많이 남아있거든요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank3/Cue_0037_Text_String
#. Speaker : Kanerah_Companion
msgctxt "f744a170-9c2d-405f-9e4f-cdd5e5de3c55"
msgid ""
"{n}Kanerah's smile grows wider.{/n} \"Your words are like a song to my ears. "
"And the clinking of coins pouring into the treasury will be a worthy "
"accompaniment to this song. I think I'll announce we're tripling taxes... "
"And when petitioners pour into court, I'll announce that {mf|His Grace|Her "
"Grace|His Highness|Her Highness} has heeded their words and graciously "
"ordered them only doubled!\""
msgstr ""
"{n}카네라의 미소가 더욱 커졌다.{/n} \"하시는 말씀이 마치 귓가에 들리는 노랫소리 같군요. 그리고 국고에 쌓이는 짤랑이는 동전 "
"소리는 이 노래의 훌륭한 반주가 될 거고요. 세금을 세 배로 올리겠다고 해야겠습니다... 그리고 청원자들이 궁성에 밀려오면, "
"{mf|영주님|영주님|전하|전하} 께서 그 말씀을 귀기울여 듣고 자비롭게도 두 배만 거두도록 허락했다고 말할 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Answer_0005_Text
msgctxt "9b1e39a8-4069-45e2-887e-c2455b4249bd"
msgid ""
"{g|Economy4_1}[Choice effects]{/g} [Pay 100 BP] \"I will take the risk. I "
"shall support Leymar's proposal, and invite him to open a shop in our city.\""
msgstr ""
"{g|Economy4_1}[선택 시 효과]{/g} [100 BP 지불] \"나는 이 위험을 감수하겠다. 레이마르의 제안을 지지하며, 우리 "
"도시에 상점을 열도록 그를 초대 할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Answer_0006_Text
msgctxt "b4e4b641-fb5b-4825-836f-cc9c399bd762"
msgid "\"I don't care for this risk. Tell Leymar that the answer is 'no'.\""
msgstr "\"나는 이 위험에 대해 신경쓰지 않는다. 대답은 '아니오'라고 레이마르에게 답하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Answer_0008_Text
msgctxt "d7251b8c-329b-4bb7-81bc-4221a3ce5168"
msgid "\"You're the Treasurer. Solve this dilemma yourself.\""
msgstr "\"당신은 재무관입니다. 이 문제는 직접 해결하십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0009_Text
#. Speaker : MaegarVarn_Capital
msgctxt "4ec711a4-9fd8-486f-8609-1e7fd5ed6910"
msgid ""
"\"I hope your intuition doesn't fail you, {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}.\""
msgstr "\"당신의 직감이 실패하지 않기를 바랍니다, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0010_Text
#. Speaker : MaegarVarn_Capital
msgctxt "2aba1a24-4d4e-4266-8661-b5ea303af0a2"
msgid ""
"\"I share your opinion, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. I'm afraid we'll have to disappoint our guest.\""
msgstr "\"동감입니다, {mf|영주님|영주님|전하|전하}. 유감이지만 우리 손님에게는 실망스러운 결과겠군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0012_Text
#. Speaker : MaegarVarn_Capital
msgctxt "8eba18b9-923a-440d-ba98-cb4e8249e389"
msgid ""
"\"In this case, {mf|Your Grace|Your Grace|Your Highness|Your Highness}, I "
"shall go immediately to sir Leymar and refuse his request in the most polite "
"way I can.\""
msgstr "\"그렇다면, {mf|영주님|영주님|전하|전하}, 지금 당장 레이마르 경에게 가서 최대한 정중하게 거절하도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0016_Text
#. Speaker : SadisticMage_Capital
msgctxt "1c866361-cf42-4ae8-8c86-1e6768175e46"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, it is my honor to "
"introduce Leymar Tinch, an expert on alcoholic beverages, who has traveled "
"here from distant lands.\" {n}Bartholomew frowns, apparently trying to "
"remember the name of Leymar's native country.{/n} \"This... sir insisted on "
"speaking to you in person, and I decided no one better could explain his "
"request.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 먼 나라에서 이곳으로 여행을 온 주류 전문가 레이마 틴치를 소개하게 되어 영광입니다.\" {n}바솔로뮤는 "
"레이마르의 고향 이름을 기억하려고 애쓰는 듯 눈살을 찌푸립니다.{/n} \"이분... 은 {mf|영주님|영주님|전하|전하}께 직접 "
"말씀드리겠다고 고집을 부렸고, 제 생각에도 직접 들어보셔야 할 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0018_Text
#. Speaker : Jubilost_Companion
msgctxt "d1ff3108-075d-47ee-be26-ea1c9f30d8c3"
msgid ""
"\"I've brought a petitioner with me, Leymar Tinch – a famous expert on "
"everything regarding alcohol and the beverages which feature it. Our "
"impatient guest wanted very much to speak with you in person, and tell you "
"all about his, ahem, 'project'.\""
msgstr ""
"\"청원자가 있어 데려왔지. 레이마르 틴치 - 술이나 비슷한 음료에 대해선 저명한 전문가라네. 이 성질 급한 손님이 자네를 직접 만나 그 "
"'계획' 에 대해 얘기해보겠다고 난리였거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0020_Text
#. Speaker : Jubilost_Companion
msgctxt "61ab15f8-57dd-40fd-b5e7-04bececcb9c2"
msgid ""
"\"Just like that, without considering the risks? Of course, it's entirely up "
"to you, {mf|baron|baroness|King|Queen}, although I'd remind you that the "
"money belongs to the state.\""
msgstr ""
"\"위험은 고려하지 않고 그리 결정을 한다고? 물론 전적으로 {mf|영주님|영주님|왕|여왕}의 권한이지만, 이 돈은 국고에서 지출된다는 "
"사실을 명심해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0021_Text
#. Speaker : Jubilost_Companion
msgctxt "735eda41-6b69-443b-b197-23688704ccbd"
msgid "{n}Jubilost silently nods in response.{/n}"
msgstr "{n}주빌로스트는 대답 대신 고개를 끄덕였다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0023_Text
#. Speaker : Jubilost_Companion
msgctxt "bda490ed-aef0-4be1-bad5-2aa6dbbee2ad"
msgid ""
"\"If you thought you might change my mind by inviting me to decide, I'm "
"afraid you were mistaken. I shall refuse Leymar's request straight away.\""
msgstr "\"만약 내 마음을 바꾸려고 결정권을 준거라면, 그건 실수였어. 나는 레이마르의 요청을 거절할 테니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0025_Text
#. Speaker : SadisticMage_Capital
msgctxt "c859c0f8-68af-46bf-aa20-c6305101d207"
msgid ""
"\"Is that so? Very well. Let's hope the number of halflings in your lands "
"doesn't drop significantly.\""
msgstr "\"그렇습니까? 좋습니다. 이 땅에 있는 하플링들 숫자가 급격히 줄지 않기를 바랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0026_Text
#. Speaker : SadisticMage_Capital
msgctxt "b70d577d-47df-4178-add9-450637e6e4fa"
msgid ""
"\"I'd be happy to, {mf|Your Grace|Your Grace|Your Highness|Your Highness}.\""
msgstr "\"기꺼이 하겠습니다, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0028_Text
#. Speaker : SadisticMage_Capital
msgctxt "88690ad6-6f76-4afe-afe1-677591683f0d"
msgid ""
"\"Thank you for your trust, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. I shall invite sir Leymar to leave – first the castle, and then "
"the city.\""
msgstr ""
"\"믿어주셔서 감사합니다, {mf|영주님|영주님|전하|전하}. 레이마르 경을 일단 성 밖으로, 그 다음엔 도시 밖으로 안내하도록 하죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0030_Text
#. Speaker : MaegarVarn_Capital
msgctxt "f29242b8-6294-472e-8e6c-d12e1fd3c948"
msgid ""
"\"Allow me to introduce Leymar Tinch, a well-known distiller and a renowned "
"potion-maker. Sir Tinch insisted on a personal meeting, to present to you "
"his unusual idea.\""
msgstr ""
"\"레이마르 틴치를 소개합니다, 저명한 증류주 생산자이자 유명한 표선 제조자입니다. 틴치 경은 개인적인 만남을 요청했습니다. 당신에게 "
"자신의 아이디어를 소개하기 위해서요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0031_Text
#. Speaker : RankUp_LeymarTinch
msgctxt "48cca431-bace-458b-840f-34c45a1223c5"
msgid ""
"{n}The halfling before you looks young, but his sharp eyes framed by slight "
"wrinkles gives away the petitioner's considerable age. Leymar nods politely, "
"sweeping the floor with his beret and showing off an emerging bald spot.{/n} "
"\"My respects, {mf|baron|baroness|King|Queen}! I beg your forgiveness for "
"how boldly I sought our meeting, but I could hardly trust anyone with the "
"fate of my beloved new child – which appeared to me in a waking dream, as I "
"walked your lands.\""
msgstr ""
"{n}당신 앞의 하플링은 어려보이지만, 약간의 주름살이 잡힌 날카로운 눈은 청원자의 나이를 짐작하기 어렵게 합니다. 레이마르는 그의 "
"베레모를 내림과 동시에 조금 벗겨진 정수리를 보이며 예절바르게 고개를 숙입니다. {/n} \"친애하는 "
"{mf|영주님|영주님|왕이시여|여왕이시여}! 제가 주제넘게 이 회담을 요청드린것에 대해 용서를 구합니다. 하오나, 당신의 영토를 지나갈 "
"때 꿈을 꾸는 것처럼 떠오른, 저의 사랑하는 새 아이의 운명에 관해서는 다른 누구도 믿을 수 없었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0032_Text
#. Speaker : RankUp_LeymarTinch
msgctxt "aa8da63d-ed51-47ce-b986-eebfea355729"
msgid ""
"\"You see, I was traveling through on my way to {g|Brevoy}Brevoy{/g}, when "
"to my surprise I discovered a most curious detail: it turns out that many "
"spicy and bitter herbs, which I and my colleagues use in our work, grow wild "
"in these lands! Wineberry, goatweed, gentian...\" {n}Leymar bends his "
"fingers, enumerating the plants, then waves his hands.{/n} \"Ah, these names "
"probably tell you nothing, but to me... oh, for me this rich list is like a "
"splendid palette – the foundation upon which a true masterpiece might be "
"built.\""
msgstr ""
"\"보시는 대로, 저는 {g|Brevoy}브레보이{/g}로 가던 중이었습니다, 그러다가 아주 기이한 광경을 발견해서 깜짝 놀랐습니다. "
"저와 제 동료들이 일할때 쓰는 맵고 쓴 허브들이 이 땅에 자생하고 있었습니다! 와인베리, 고트위드, 젠티안...\" {n}레이마르가 그의 "
"손가락들을 구부리며 식물들을 세어갔습니다, 그리고 그의 손을 흔듭니다. {/n} \"아, 이런 이름들은 아마 당신에게는 아무 의미가 "
"없을지도 모릅니다, 그러나 저에게는... 오, 저에겐 이 풍부한 이름들은 마치 훌륭한 팔레트와 같습니다. 진정한 걸작이 세워질 토대처럼 "
"말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0033_Text
#. Speaker : RankUp_LeymarTinch
msgctxt "2d0d4a8d-e11f-48c3-9a7a-0ee6745731fe"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, I once imagined "
"settling in {g|Brevoy}Brevoy{/g}, but your lands have truly inspired me – "
"and now my greatest dream is to open a shop in this very capital. With a "
"bouquet you can easily gather nearby, I can easily create a new beverage – "
"true ambrosia for any halfling! Only one thing is holding me back: lack of "
"financial resources. I hope that now, upon hearing my request, you and your "
"respected Treasurer will not refuse a humble artisan a little assistance... "
"of course, in exchange for a future percentage!\" {n}Leymar bows deeply once "
"again.{/n} \"I shall eagerly await your decision!\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 원래는 {g|Brevoy}브레보이{/g}에 정착하려 했었지만, 당신의 땅이 진정으로 제게 영감을 "
"주는 군요. 이제 제 일생일대의 꿈은 이 수도에서 상점을 여는 게 되었습니다. 아무렇게나 꺾은 꽃다발만 있다면, 새로운 음료인, 하플링을 "
"위한 진짜 암브로시아를 손쉽게 만들어낼 수 있으니까요! 그런데 한 가지가 걸리는 게 있습니다. 재정적 지원이지요. 제 청원을 들어주셔서, "
"당신과 존경하는 재무관께서 이 가엾은 장인에게 작은 지원을 해주십시오... 물론, 향후 있을 수익의 일부를 돌려드림은 당연합니다!\" "
"{n}레이마르는 정중하게 다시 한 번 인사한다.{/n} \"당신의 결정을 손꼽아 기다리고 있겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0034_Text
#. Speaker : MaegarVarn_Capital
msgctxt "900c95c8-ced9-4ffe-845c-e5d0da8a94fe"
msgid ""
"{n}Maegar chews his lip, annoyed.{/n} \"Of course it's up to you to decide, "
"but I personally don't trust such moneymakers. 'Ambrosia', 'bouquet'... if "
"he wanted to open a forge or, say, a pottery – why, that's a different "
"story! But how can we say whether this investment is any good at all? What "
"if he gets the money and simply disappears without a trace?\""
msgstr ""
"{n}메이가르는 화난 듯 입술을 깨물었습니다.{/n} \"물론 결정은 전적으로 당신의 것입니다만, 개인적으로 이런 장사치들은 믿지 "
"못하겠습니다. '암브로시아' 니, '꽃다발' 이니... 그 자가 대장간이나, 아니면 도예 공방을 짓는다면 모를까, 이건 전혀 다른 개념의 "
"이야기 입니다! 하지만 그렇다고 면전에 대고 이 투자가 별로라고 말하기도 그렇잖습니까? 저자가 돈을 들고 흔적도 안 남기고 사라져버리면 "
"어쩌려고요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0035_Text
#. Speaker : Jubilost_Companion
msgctxt "0bde28bb-cb4a-4c43-aa64-874f41f84aeb"
msgid ""
"\"Do you want to hear my opinion? This business will fail. Halfling alcohol "
"is like fruit juice for the other races. It's nothing like your dwarvish "
"stout. You want to take a risk and put your money on halfling drunkards? "
"Well, it's your {mf|barony|barony|kingdom|kingdom} and your business. But "
"remember, if you give this trader the money he asks for, then tomorrow there "
"will be ten more at your gate just like him.\""
msgstr ""
"\"내 의견을 말해볼까? 이 사업은 망할거야. 하플링 술은 다른 종족에겐 주스나 다름없지. 드워프 흑맥주랑은 비교도 안된다고. 네 돈을 "
"하플링 주정뱅이들에게 투자하고 싶다고? 뭐 네{mf|남작령|남작령|왕국|왕국} 이고 네가 결정할 일이지. 하지만 이 사업게에게 돈을 "
"줬다가는, 다음 날 성문 앞에 이런 사람들이 열 명은 있을 거라고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0036_Text
#. Speaker : SadisticMage_Capital
msgctxt "fb2532fa-14dc-4380-8a61-1328183754d5"
msgid ""
"{n}Bartholomew clears his throat.{/n} \"If you ask my advice, I would not "
"encourage our citizens to come ask for loans for their crazy ideas. You will "
"quickly lose money, while this character poisons your subjects with his "
"concoctions... Perhaps three and a half halflings will enjoy his fizzy wine, "
"but that will hardly repay your investment.\""
msgstr ""
"{n}바솔로뮤는 목을 가다듬었습니다.{/n}\"조언 해드리자면, 저라면 우리 백성들의 정신나간 아이디어에 대해 무조건 투자하진 않을 "
"겁니다. 돈을 빠르게 잃을 것은 물론이요, 이 사람이 자기가 만들어 낸 술로 백성들을 중독시킬 겁니다... 하플링들은 이 거품투성이 술을 "
"즐길 지 몰라도, 그래도 투자금을 회수하긴 힘들 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0037_Text
#. Speaker : Kanerah_Companion
msgctxt "33831537-01f9-4256-b90b-36e17f5610a6"
msgid ""
"\"A sure sign of our state's maturity is the long line of entrepreneurs "
"awaiting audience. Each has a project on their minds, and each sincerely "
"believes that the others are rascals and madmen, while their own ideas are "
"magnificent. Congratulations – this is a great moment for your "
"{mf|barony|barony|kingdom|kingdom}! The first petitioner is Leymar Tinch, "
"and he has quite a business proposal for you.\""
msgstr ""
"\"사업가들이 줄을 지어 서있는 것을 보니 우리 영토도 성숙했네. 각자 자신만의 계획을 머릿 속에 가진 채, 자기만 정상이고 다른 "
"사람들을 미친놈이나 사기꾼으로 몰아놓는 꼴을 보니 말이야. 축하해. 이건 당신 {mf|남작령|남작령|왕국|왕국}에 있어 기념비적인 "
"순간이야! 첫 번째 청원자는 레이마르 틴치로, 당신에게 사업 제안을 하러 왔어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0038_Text
#. Speaker : Kanerah_Companion
msgctxt "0a59a148-4a4b-4466-9627-7fe8501fbd9b"
msgid ""
"\"Sounds dubious, doesn't it? Nevertheless, I do recommend allocating some "
"money to this endeavor. True, it's unwise to get too involved in risky "
"business, but it's even less wise to forgo it altogether. Most often such "
"projects end in nothing. But the success of one can more than outweigh a "
"dozen or even a hundred failures!\""
msgstr ""
"\"미심쩍은 소리긴 하지? 그렇지만, 나는 이 사업에 약간의 자금을 투자하는걸 추천한다네. 몰론 위험한 사업에 깊게 관여하는건 현명하지 "
"못하지만, 완전히 무시하는건 더 어리석은 짓이야. 대부분의 경우 그런 계획은 아무런 성과를 내지 못하지. 하지만 한 번만 성공해도 열 "
"번, 아니 백 번의 실패를 만회할 수 있다고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0039_Text
#. Speaker : Kanerah_Companion
msgctxt "d76ee2a7-66d4-464c-a439-448088dadecb"
msgid ""
"\"A wise decision! If our guest's business fails, our losses will be small. "
"If it succeeds, our profits might range from modest to enormous. But most "
"importantly, people like him will continue to come to court. A hundred might "
"have only pebbles in their hands, but the hundred-and-first will bring you a "
"diamond!\""
msgstr ""
"\"현명한 선택이군! 만약 이 사업이 망해도, 우리 손해는 적을 거야. 만약 성공한다면, 이익은 꽤 되거나 엄청나겠지. 가장 중요한 건, "
"이런 사람들이 계속 성으로 찾아올거라는 거지. 백명은 돌덩이를 가져오겠지만, 백한 번째 손님은 다이아몬드를 가져올지도 모르는 거 아닌가!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0040_Text
#. Speaker : Kanerah_Companion
msgctxt "cdc2eded-de6a-4fed-b614-ddc83b1bc192"
msgid ""
"\"I see you don't like playing dice with fate, and prefer to act when the "
"situation is certain. Very well, it's a sensible approach. But I'm afraid it "
"will be painful when the entrepreneur you turn away rains gold upon one of "
"your neighbors!\""
msgstr ""
"\"운명을 가지고 노름하는건 싫어하고, 확실한 상황에서만 움직인다는 것은 잘 알겠네. 좋아, 합리적인 방식이긴 하지. 하지만 네가 보낸 "
"사업가가 주변 국가에서 대박을 터뜨리면 배가 아플걸!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank4/Cue_0041_Text
#. Speaker : Kanerah_Companion
msgctxt "cfa106dc-1fe9-4f86-8101-707112e96e70"
msgid ""
"\"In this case I will lend sir Leymar the money he is asking for. There "
"might be some risk, but it's justified.\n"
"Entrepreneurship is the living blood of the state, and you can't avoid "
"taking chances!\""
msgstr ""
"\"그렇다면 레이마르 경에게 필요한 자금을 대출해주도록 하겠습니다. 약간의 위험은 있겠지만, 감수할 만 하지요. \n"
"사업은 국가의 원동력이기 때문에, 위험을 피하기만 할 수는 없습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Answer_0005_Text
msgctxt "a5c0c1bc-f050-46c0-bef1-b3b6faa7c321"
msgid ""
"{g|Economy5_1}[Choice effects]{/g} \"Order these 'Taxmasters' to stop "
"oppressing our people.\""
msgstr "{g|Economy5_1}[선택 시 효과]{/g} \"이 '택스마스터'들에게 우리 백성들에 대한 탄압을 중단하라고 명령하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Answer_0006_Text
msgctxt "58c07098-8f05-46b5-b07d-80fb8e78f853"
msgid ""
"{g|Economy5_2}[Choice effects]{/g} \"Let these Taxmasters do their job. "
"Command our guards to assist them.\""
msgstr ""
"{g|Economy5_2}[선택 시 효과]{/g} \"이 택스마스터들이 자기 일을 하게 내버려두라. 경비대에게 명령해 이들을 도우라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Answer_0007_Text
msgctxt "f5668be7-bba8-40c4-b0d7-662f537b3edb"
msgid ""
"{g|Economy5_3}[Choice effects]{/g} \"Denounce these Taxmasters... in word, "
"but not in act. But let them keep working. But more quietly in the future.\""
msgstr ""
"{g|Economy5_3}[선택 시 효과]{/g} \"이 택스마스터들을 규탄하라... 말로만 말이다. 하지만 일은 계속 하게 하라. 다만 "
"앞으로는 보다 조용하게 처리하도록.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Answer_0008_Text
msgctxt "674f077d-4b9d-41ba-ad91-c16e12c06cfa"
msgid "\"Act as you see fit.\""
msgstr "\"그대 뜻대로 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0001_Text
#. Speaker : MaegarVarn_Capital
msgctxt "24ee6a6d-3b55-421f-a1c3-ceb291f5e730"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, we have a taxation "
"problem. Or rather, a tax collection problem. The people in these lands are "
"not accustomed to paying taxes. Some try to hide their income from your tax "
"collectors. Others even set their dogs on them!\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 세금 문제가 있습니다. 정확히 말씀드리면, 징세 문제입니다. 이 땅의 사람들이 세금을 내는 데 "
"익숙하지가 않습니다. 어떤 사람들은 징수관에게 수익을 숨기고, 어떤 사람은 심지어 징수관에게 개까지 풀어놓기도 합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0002_Text
#. Speaker : Jubilost_Companion
msgctxt "8489783f-c3cc-488e-952b-c1a610a3fc8a"
msgid ""
"\"{name}, your subjects truly are savages. My, how the peasants hate paying "
"their taxes! As if they preferred the Stag Lord's way! When he ran out of "
"gold, he'd just kill everybody in the nearest village and pick the loot from "
"their corpses. But here you come, with your monthly tax collection. And for "
"them it's nothing less than a nightmare!\""
msgstr ""
"\"{name}, 네 백성들은 정말이지 야만인들이야. 세상에, 어떻게 농민들이 세금을 내는 것을 싫어할 수가 있지! 숫사슴 군주 때가 더 "
"좋다고 말하는 자들도 있어! 놈은 돈이 다 떨어지면 가장 가까운 마을에 있는 모든 사람들을 죽여버리고 시체에서 약탈을 해댔을 거야. "
"하지만 이젠 네가 다스리고, 매 달 세금을 걷지. 사람들에게 징세는 악몽으로 취급받는 거 같아!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0003_Text
#. Speaker : SadisticMage_Capital
msgctxt "a1d801e1-4772-4731-ab50-640146124738"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, it's despicable! "
"It's bad enough that your subjects evade their taxes. But what's worse – "
"they often attack, beat and otherwise abuse your tax collectors! And this on "
"top of the fact that they, in effect, are stealing right from your treasury!"
"\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 참으로 비열합니다! 세금 내는 걸 피하는 백성들이라니요. 하지만 더 나쁜 것은 백성들이 심지어 "
"징수관을 공격하고 때리며 괴롭히기까지 한다는 겁니다! 게다가 이것 외에도 국고에서 돈을 훔쳐가기까지 하고 있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0009_Text
#. Speaker : MaegarVarn_Capital
msgctxt "7c1fa554-17f6-4b5e-8362-a943e0c663fa"
msgid ""
"\"I shall see to it that the Taxmasters stop oppressing your people. Once "
"your subjects see that you're on their side, they'll be more glad to pay "
"their share of taxes. The key to successful governance, after all, is the "
"affection of your subjects!\""
msgstr ""
"\"택스마스터들에게 사람들을 그만 괴롭히라고 말해야 할 거 같습니다. 백성들이 당신이 그들 편이라고 생각하면, 세금을 내는 데 있어 "
"거리낌이 없을 테니까요. 성공적인 통치의 열쇠는 이러나 저러나, 백성들의 호감을 사는 것입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0010_Text
#. Speaker : Jubilost_Companion
msgctxt "4cf9827a-952e-4b19-8052-7fd58afbc3f0"
msgid ""
"\"I see your strategy. You'd rather be broke, so long as you're loved by the "
"crowd. I sincerely hope your soul is warmed by the happy cheers of these "
"pathetic tax evaders.\""
msgstr ""
"\"무슨 생각 하시는 지 알 것 같네. 백성들의 사랑을 받는 대신, 빈털터리가 되겠다는 그 뜻을 말이야. 이 불쌍한 조세범들의 행복에서 "
"우러나오는 갈채가 네 영혼을 따뜻하게 데우길 진심으로 빌지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0011_Text_String
#. Speaker : SadisticMage_Capital
msgctxt "f5acba3d-cf8a-41d4-a6f3-c25dcebf2724"
msgid ""
"\"So, you defending those who steal from you, and condemn those who perform "
"their duties? But who will you blame when your tax collectors fail to bring "
"in the money they're charged with collecting? Them? – Or me, perhaps?\""
msgstr ""
"\"그래, 당신에게서 훔쳐가는 사람들을 비호하고, 의무를 지키는 사람들을 규탄하시렵니까? 그럼 징수관들이 돈을 못 걷어오면 누굴 비난할 "
"건지요? 저 사람들인가요? –  아니면 어쩌면 저인가요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0012_Text_String
#. Speaker : MaegarVarn_Capital
msgctxt "d5fc02af-44a2-427d-be67-456006f77cad"
msgid ""
"\"How sad it is to see you whipping your own subjects to rebellion. They "
"will only rise more steadfast against your authority, and soon we'll be "
"sending our military forces to collect your taxes.\""
msgstr ""
"\"백성들을 반란으로 이끄는 채찍질을 보자니 마음이 아파옵니다. 우리가 세금을 거두려고 군대를 보내면 백성들은 오히려 꿋꿋하게 당신의 "
"권력에 반대할 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0013_Text
#. Speaker : Jubilost_Companion
msgctxt "7ee268b3-e93e-4e7d-98eb-c840ae0ce94e"
msgid ""
"\"I understand. The firm-handed approach, the iron rule. Don't be offended, "
"but Razmir is still more hated and feared than you in the {g|River Kingdoms}"
"River Kingdoms{/g}. But you're certainly going in the right direction.\""
msgstr ""
"\"알겠군. 단호한 접근, 철권통치라. 기분 나쁘게 듣지는 마. 그래도 {g|River Kingdoms}강의 왕국들{/g} 내에선 "
"라즈미르가 너보다 더 미움받는 공포의 대상이니까. 넌 분명 바른 방향으로 가고 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0014_Text
#. Speaker : SadisticMage_Capital
msgctxt "f043dfd7-e019-439f-8b26-2c5bf90d7531"
msgid ""
"\"Perfect. I will appoint guards to escort and assist these Taxmasters. It "
"is good to see how you appreciate your servants' effort. I do hope you will "
"continue to appreciate my own service, as well.\""
msgstr ""
"\"완벽하군요. 택스마스터들을 보호하기 위해 경비대에게 명령하겠습니다. 신하들의 노력을 신경 써주시는 모습이 참으로 보기 좋군요. 제 "
"일에 대한 진가도 계속 알아봐주시길 빌겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0016_Text
#. Speaker : Jubilost_Companion
msgctxt "f614f102-80ad-402c-8f18-c4248ef19261"
msgid ""
"\"I hope you won't be troubled by a touch of hypocrisy. The peasants will "
"hear you denounce Taxmasters, and that message will comfort them. In the "
"meantime, the tax evaders will still be attended to... during the night-"
"time. Quietly. Covertly.\""
msgstr ""
"\"위선적이라는 오명을 뒤집어쓰지 않길 바라. 백성들은 당신이 택스마스터들을 비판했다는 소식을 듣게 될 거야. 그리고 이 소식으로 "
"백성들은 안심하겠지. 하지만, 조세범들은 아직도 밤마다 다녀가고 있어... 조용하고, 은밀하게 말이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0018_Text
#. Speaker : MaegarVarn_Capital
msgctxt "4853fa0f-7ff9-43f1-afd5-4fa6c478249f"
msgid ""
"\"This is the reason why more and more people join the Taxmasters. They are "
"followers of {g|Abadar}Abadar{/g}, who hold to the idea that everyone must "
"pay their debt to society. And they do not shy from the use of force, "
"threats – and even blackmail – to collect what debts fall due. They hide "
"their faces behind golden masks, for people detest and fear them.\""
msgstr ""
"\"이래서 점점 많은 사람들이 택스마스터에 들어가려 하는 걸세. 이들은 {g|Abadar}아바다르{/g}의 신자고, 모두들 사회에 자기가 "
"진 빚을 갚아야 한다고 주장하고 다니지. 그리고 위협이나 무력을 사용하는 데도 전혀 거리낌이 없다네. 세금을 걷으려면 심지어 협박까지 "
"하고 다닌다네. 이들은 자기 얼굴을 황금색 가면으로 가리고 다니네. 사람들이 그들을 혐오하고 무서워하기 때문일세.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0019_Text
#. Speaker : MaegarVarn_Capital
msgctxt "7be5ccb5-7129-449a-8526-b54bc3290f3f"
msgid ""
"\"The money flow has increased, but the people have started to grumble. It's "
"certainly no good that some of them are evading taxation. But beating the "
"money out of your citizens will lead them to openly despise you. You must "
"order these Taxmasters to stop oppressing your people.\""
msgstr ""
"\"세수가 증가했지만, 사람들이 불평을 시작하고 있습니다. 어떤 사람들은 탈세를 하기까지 할 정도인지라 좋은 현상은 아닙니다. 하지만 "
"사람들을 때려서 돈을 걷으면 공개적으로 불신만 쌓을 뿐입니다. 택스마스터들에게 사람들을 그만 억압하라 명령해야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0020_Text
#. Speaker : Jubilost_Companion
msgctxt "0d9d5cce-1591-4aa4-b8b7-991af68a885e"
msgid ""
"\"However, your people won't get off so easily. Numbers of them join the "
"Taxmasters, followers of {g|Abadar}Abadar{/g} – they regard avoidance of "
"taxes as a major personal offense. These Taxmasters wear golden masks, and "
"go from door to door to beat the gold out of your people... along with their "
"teeth. It is indeed the civilized approach!\""
msgstr ""
"\"그렇지만 내 백성들은 그렇게 쉽게 피해가질 못할 거야. 다수의 사람들이 택스마스터, 즉 {g|Abadar}아바다르{/g}의 추종자 "
"집단에 가입했어. 이들은 탈세를 중대한 사적 범죄행위로 받아들이는 모양이더군. 이  택스마스터들은 황금색 가면을 쓰고, 사람들로부터 돈을 "
"빼앗아와... 금니까지 탈탈 털어서 말이지. 정말 문명화 된 방법이구만!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0021_Text
#. Speaker : Jubilost_Companion
msgctxt "ea04a9b4-c165-4e60-9872-9d6e735114af"
msgid ""
"\"It may be the only way to bring some sort of civilization to this forsaken "
"corner of the world. However, if you allow this to continue, you will surely "
"be called a tyrant! I urge you to act carefully. Address these Taxmasters, "
"and let them know that they have gone too far – but don't disband them "
"altogether. Someone has to collect your taxes, and there aren't many people "
"willing to take this thankless job...\""
msgstr ""
"\"그건 이 버려진 세상의 구석에 문명을 가져올 유일한 방법일 지도 몰라. 하지만, 자네가 이게 계속 되도록 놔두면 필히 폭군으로 불리게 "
"될거야! 조심스럽게 행동하시길 추천해. 이 택스마스터들에게 이야기해. 그리고 그들이 너무 멀리 나갔다는 사실을 알게 해주는 거야. 하지만 "
"그렇다고 그들을 해산시키지 마. 누군가는 세금을 걷어야 하고, 생색 안 나는 이 직업에 자원하는 사람은 많지 않을 테니까...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0022_Text
#. Speaker : SadisticMage_Capital
msgctxt "a692c779-ef95-4ec8-9bce-45230ba95bfa"
msgid ""
"\"They're so bold as to complain about being caught in the act, and forced "
"to do their duty! Some of your tax collectors have joined the Taxmasters – "
"{g|Abadar}Abadar's{/g} cult, who worship the law and have great respect for "
"the due of all. They regard the payment of taxes as the sacred duty of every "
"citizen. Any violator is forced to pay to the last coin, under threat of "
"force.\""
msgstr ""
"\"현장에서 붙잡히고 의무를 강제당한 것에 대해 불평하다니, 참으로 대담한 자들이로군요! 징수관 몇 명이 택스마스터에 합류했습니다. "
"이들은 {g|Abadar}아바다르{/g}의 신도로, 법을 신봉하고 모든 것의 납기일을 지키는 자들입니다. 이들은 납세를 모든 시민들의 "
"신성한 의무로 생각합니다. 거부하는 자들은 무력의 힘으로 돈을 빼앗기게 되지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0023_Text
#. Speaker : SadisticMage_Capital
msgctxt "75cafa53-4904-4898-bfdf-04e796e73b11"
msgid ""
"\"The people are outraged about being robbed. They want us to put a stop to "
"these Taxmasters! If you ask me, though, they're the ones who need your "
"support. The work of the Taxmasters is difficult and dangerous, yet vital to "
"the country!\""
msgstr ""
"\"사람들이 강탈당한 것으로 분노하고 있습니다. 우리에게 이 택스마스터를 멈춰달라고 하고 있습니다! 제가 조언해드리자면, 우리는 "
"택스마스터를 도와야 합니다. 이들의 일은 어렵고 위험하지만 국가에 꼭 필요한 일이니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0028_Text
#. Speaker : Kanerah_Companion
msgctxt "0ed6d398-d162-4b8d-a9ac-327e0e898e70"
msgid ""
"\"You know I'm no fan of religious orders, but I must admit that sometimes "
"they can be quite useful. As your state grows, more and more of your "
"subjects follow {g|Abadar}Abadar{/g}, the god of cities, laws and trade. "
"There is now a very useful society among his followers.\""
msgstr ""
"\"전 원래 종교적인 일에는 관심 없지만, 때때로 이 자들이 쓸만하다는 건 인정해야겠군요. 나라가 성장하면서, "
"{g|Abadar}아바다르{/g}, 도시, 법과 무역의 신의 신자들이 늘어나고 있습니다. 이 신자들 사이에서 굉장히 유용한 단체가 "
"있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0029_Text
#. Speaker : Kanerah_Companion
msgctxt "5822e725-245a-4d15-9094-3e606dbc98f2"
msgid ""
"\"They call themselves the Taxmasters. They're a fraternity of tax "
"collectors who are tired of the crowd vilifying them and sometimes even "
"laying their hands on them – all for honestly carrying out their duties, "
"while demanding the same from others! They hide their faces behind golden "
"masks, and teach lessons of obedience to those who attempt to evade taxes.\""
msgstr ""
"\"그 자들은 스스로를 택스마스터라고 부릅니다. 이들은 징수관들이 모여 만들어진 단체로 사람들이 자신들을 나쁜 놈으로 만들고 심지어 "
"폭행까지 하는 일에 지쳐버린 사람들 입니다. 모두 정직하게 자기 의무를 지키려 했을 뿐이고, 모두에게 동등하게 요구했는 데 말입니다! "
"이들은 황금 가면을 뒤집어쓰고, 탈세하려는 자들에게 복종하는 법을 가르치고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0030_Text
#. Speaker : Kanerah_Companion
msgctxt "f108996c-85b1-487d-a35a-63acd430c418"
msgid ""
"\"The common people complain of their cruelty – as if your servants are to "
"blame for the crowd failing to appreciate your kindness! These people are "
"true patriots and your most loyal subjects. You should reward them, or at "
"least honor them in words. Or better yet – assign your guards to assist them!"
"\""
msgstr ""
"\"평민들이 택스마스터들의 잔혹함에 대해 불평하고 있습니다. 당신의 자비를 몰라보는 대중들이 신하들에게 불평하듯 말입니다! 택스마스터들은 "
"진정한 애국자이며 가장 충성스런 백성들입니다. 이들에게 보상을 주거나, 아니면 최소한 말로써 격려를 해야 합니다. 아니면 더 나은 방법이 "
"있습니다. 경비대를 동원해 이들을 돕게 하는 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0031_Text_String
#. Speaker : Kanerah_Companion
msgctxt "0c2bc086-a177-4d4c-8be6-229517c66643"
msgid ""
"\"I can't believe my ears! You want to insult people who endure curses and "
"spitting every day, at risk to their health and even their lives, that your "
"treasury may remain full? And for who? Ungrateful parasites who despise you "
"and your power, who enjoy your patronage but try to evade their own "
"responsibilities? This is madness. You're digging a hole under your own "
"throne with your very hands!\""
msgstr ""
"\"제 귀를 믿을 수가 없군요! 국고를 채워주고, 매일같이 날아오는 욕설과 침사레를 감내하면서, 건강과 심지어 목숨까지 위협받는 이 "
"사람들을 모욕하겠다고요? 누구를 위한 모욕입니까? 당신과 당신의 권력을 경멸하면서, 당신이 내려준 은혜를 누리기만 할 뿐 의무는 "
"피하려하는 이 감사할 줄 모르는 기생충들을 위해서요? 이건 미친 짓입니다. 제 손으로 무덤을 파고 있는 것이란 말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0033_Text_String
#. Speaker : Kanerah_Companion
msgctxt "3a4ea8cc-d5fc-4dea-816f-c3be8c815052"
msgid ""
"\"I admit, when you offered me the treasurer's position, this was not how I "
"imagined this job. I knew that it's ungrateful work, that I would have to "
"endure the hatred of the crowd who clutch their purses tightly... But I "
"didn't expect that I'd be stonewalled at every step of the way by my own "
"{mf|baron|baroness|King|Queen}! Are you trying to ruin your country? Well, "
"it's your right, but don't expect me to help you. This is the end. I resign!"
"\""
msgstr ""
"\"한 가지 인정해야 할 것이, 제가 재무관의 직책을 제안 받았을 때, 이런 일이 일어나리라고는 생각하지 못 했습니다. 저도 지갑 입구를 "
"꽉 죄여매는 백성들로부터 증오를 감내해야 하는 불쾌한 일인 줄은 알았지만... 제가 하는 일 사사건건에 제가 모시는 "
"{mf|영주님|영주님|왕|여왕}의 방해가 있을 줄은 몰랐단 말입니다! 이 땅을 망치시려고 하는 겁니까? 뭐, 당신의 권리이긴 합니다만, "
"제가 도와드리라고는 생각하지 마십시오. 이제 끝입니다. 사임하지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank5/Cue_0034_Text_String
#. Speaker : Kanerah_Companion
msgctxt "f26de21d-c456-46c2-a92d-35bdc099c364"
msgid ""
"\"Very well. It is good that we value such people. They are the backbone of "
"the country, after all! They may be surrounded by weaklings who only care "
"about their own interests, but they voluntarily offer you their shoulders, "
"because they know that rock-solid governance is good for everyone. I will "
"prepare a letter of commendation on your behalf, and allocate some guards to "
"assist them.\""
msgstr ""
"\"좋습니다. 이런 사람들을 존중할 수 있다니 참으로 좋군요. 이들은 어쨌든 간에 이 땅을 지탱하는 중심입니다! 자기 이익만을 챙길 줄 "
"아는 약자들에게 둘러싸일지 몰라도, 이들은 자기 어깨를 기꺼이 우리에게 빌려주고 있습니다. 이는 돌처럼 굳건한 왕권이 만인을 위한 것임을 "
"알기 때문입니다. 당신을 대신해 이들을 찬사하는 편지를 쓰고, 경비들을 시켜 이들을 돕게 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Answer_0005_Text
msgctxt "f16537e4-7d99-4962-8f1b-06541d7335f1"
msgid ""
"{g|Economy6_1}[Choice effects]{/g} \"The shadow trade must be put to an end. "
"I command the establishment of proper customs.\""
msgstr "{g|Economy6_1}[선택 시 효과]{/g} \"밀수는 멈춰야 한다. 적절한 세관을 세우라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Answer_0006_Text
msgctxt "d43f4662-5eb9-41ad-ac23-8d1ca191ae0d"
msgid ""
"{g|Economy6_2}[Choice effects]{/g} \"Let's leave things as they are. Order "
"our guards to stay away from captains carrying suspicious cargo.\""
msgstr ""
"{g|Economy6_2}[선택 시 효과]{/g} \"그냥 내버려두라. 우리 경비들에게 수상한 짐을 싣고다니는 선장들로부터 떨어져있으라고 "
"명령하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Answer_0008_Text
msgctxt "7daaefb6-4af4-423e-b088-3848620ea51d"
msgid "\"It is up to you to decide.\""
msgstr "\"그대의 뜻대로 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/BartBYE_String
#. Speaker : SadisticMage_Capital
msgctxt "2f81bb9a-63fa-4087-bb05-b17996f6f78b"
msgid ""
"\"When you offered me this position, {name}, I truly believed that you "
"appreciated my financial skills. Alas, now I see you only seek to argue, and "
"act as you see fit! I shall fulfill this order at your command, but then, "
"with regret, I must quit my position and take up some other occupation.\""
msgstr ""
"\"처음 이 자리를 제안해 줬을 때, {name}, 저는 진심으로 당신이 저의 재무실력을 인정했다고 생각했습니다. 하지만 이제 당신은 "
"논쟁만 하려 하고, 당신 마음대로만 하려 하는 군요! 당신이 말한 대로 명을 따르겠습니다. 하지만 후회할겁니다. 그리고 저는 이 자리에서 "
"물러나서 다른 일을 알아보겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0001_Text
#. Speaker : MaegarVarn_Capital
msgctxt "89c3aec9-08b7-46b0-b6e5-484ebdedbbbb"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, I beg your advice. "
"I too was a baron once, so I know full well how difficult it is to rule the "
"{g|Stolen Lands}Stolen Lands{/g}. This is a land of pirates and bandits, "
"where shadowy sorts deal in stolen and smuggled goods. Now that you've "
"brought order to these lands, this trade has surely decreased... but not as "
"much as we should like.\""
msgstr ""
"\"{mf|영주|영주|전하|전하}, 조언 하나 해드리지. 나도 한 때 영주였다네. 그래서 이 {g|Stolen Lands}도둑맞은 "
"땅{/g}을 다스리는 게 얼마나 어려운 지 알아. 이곳은 해적과 도적들의 땅이며, 장물과 밀수품이 몰래 드나드는 곳일세. 이제 당신이 이 "
"땅에 질서를 가져다 줘서, 이런 교역도 확실히 감소했지만... 우리가 바라는 만큼은 줄어들지 않았다네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0002_Text
#. Speaker : Jubilost_Companion
msgctxt "7c805a34-6751-4094-8a86-8d179bee5afa"
msgid ""
"\"{name}, it's time we discuss one of the gravest problems of the {g|River "
"Kingdoms}River Kingdoms{/g}: piracy and all the crimes which accompany it. "
"You see, for decades the illegal trade of stolen goods flowed among the "
"criminals and corrupt merchants of these lands. Now that we have guards in "
"the harbors and along the roads, this illegal traffic has slowed... but only "
"somewhat.\""
msgstr ""
"\"{name}, 이제 {g|River Kingdoms}강의 왕국들{/g}에서 가장 중대한 문제를 다뤄야 할 시간이야. 해적질과 그에 "
"수반하는 모든 범죄에 대한 것이지. 너도 알겠지만, 수십년 동안 이 땅은 범죄자들과 타락한 상인들의 불법적인 장물들이 오가는 곳이었어. "
"하지만 이제 항구와 길거리에 경비대들이 돌아다니지. 이 불법 교역도 기세가 줄었어... 조금 뿐이지만.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0003_Text
#. Speaker : SadisticMage_Capital
msgctxt "48a0090b-6bf7-468c-883d-4a96c1b5da92"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, I'd ask you to "
"address an important issue. You see, the harbors of the {g|River Kingdoms}"
"River Kingdoms{/g} are traditional locations for trafficking goods that "
"are... not entirely legal – which is to say, stolen or smuggled. Even now we "
"still see much of this, though less than before your rule.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 중대한 문제에 대한 해명을 부탁드립니다. 아시다시피, {g|River Kingdoms}강의 "
"왕국들{/g}의 항구는 전통적으로 불법적인... 물건의 본거지였지요. 소위 말하면, 장물이나 밀수품 말입니다. 심지어 지금도 이런 "
"물건들이 보이고 있습니다. 다만 당신의 통치 아래 기세가 줄었긴 하지만요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0009_Text
#. Speaker : MaegarVarn_Capital
msgctxt "69983992-6618-467d-9d00-960c88cb7854"
msgid ""
"\"Once we expel those traffickers, our domain will no longer be seen as a "
"safe haven for pirates. Were I ruler, I should do the same.\""
msgstr "\"저 밀수꾼들을 내쫓으면, 우리 영토는 더 이상 해적들의 천국이 아니게 될 겁니다. 제가 군주였다면, 그렇게 하겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0010_Text
#. Speaker : Jubilost_Companion
msgctxt "268f7ed5-c62f-4afa-8397-265961ef2921"
msgid ""
"\"So, we shall put an end to the illegal trade of stolen goods in these "
"lands. What music to my ears! You heed my advice, proving that my labors to "
"elevate this territory have not been wasted! I shall endeavor in my next "
"book to explain how important it is for every wise advisor to work with a "
"leader who knows better than to interfere.\""
msgstr ""
"\"자, 이 땅의 불법 장물 거래에 끝을 고하는 군. 참으로 듣기 좋은 말이 아닌가! 내 조언을 들어주고, 이 땅을 위한 내 노력이 "
"허사가 아니었다는 것을 증명해주니까! 내 다음 책에 현명한 보좌관이라면 자신의 일을 방해하지 않는 주군을 만나는 게 중요하다는 내용을 "
"적어야겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0011_Text_String
#. Speaker : SadisticMage_Capital
msgctxt "481038e3-deb5-4cf2-9f0a-64f848da3bed"
msgid ""
"{n}Bartholomew speaks softly, choosing his words carefully.{/n} \"I expected "
"more... pragmatism of you. There was no suggestion that you become a pirate "
"yourself! These goods have already been... taken. They're bound to be sold "
"somewhere or other. There's nothing dishonorable in that. We simply want "
"this business to proceed on our land, not on our neighbors' – that's our "
"only concern. Oh well... I only wish there was some way to profit by your "
"honesty...\""
msgstr ""
"{n}바솔로뮤는 부드럽게, 자신의 언사를 조심하며 말한다.{/n} \"제가 기대한 것은 보다... 실용적인 것이었습니다만. 당신이 직접 "
"해적이 되라는 말씀은 아니었습니다! 이 상품들은 이미... 노획되었군요. 어디 다른 곳에서 팔아치워야겠습니다. 거기에 부끄러워 할 필요는 "
"없습니다. 우리는 단순히 이 사업을 이웃 땅에서가 아니고,  우리 땅에서 진행하길 원합니다. 그게 우리의 유일한 관심거리네요. 이런... "
"당신의 정직함으로 이윤을 낼 몇몇 방법이 있기를 바랍니다....\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0012_Text_String
#. Speaker : MaegarVarn_Capital
msgctxt "ca613bd1-0adb-4659-bd01-bcfb42cb465d"
msgid ""
"\"Hm... I see. I can't say I approve. The bandits will pay handsomely for "
"the right to sell their goods in your harbors – of that I'm quite sure. But "
"soon enough, those who they plundered will come seeking revenge. They'll "
"find your harbor crawling with robbers – any may simply burn the lot to the "
"ground, along with the river pirates too.\""
msgstr ""
"\"흠... 알겠습니다. 찬성한다고는 말 못하겠습니다. 도적들이 항구에 있는 물건들에 대해선 가격을 잘 쳐줄겁니다. 그건 확실합니다. "
"하지만 약탈당한 사람은 얼마 지나지 않아 복수를 다짐할 겁니다. 강도들과 함께 항구를 찾아오겠지요. 수적들과 함께 그냥 이 땅을 "
"불태워오면서 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0013_Text_String
#. Speaker : Jubilost_Companion
msgctxt "ba8b834c-758f-4edc-bd24-05100d063504"
msgid ""
"\"I see. {kingdomname}, a charming remote province, peaceful and serene. No "
"one knows much about it, or cares for that matter. What need do we even have "
"of reputation, relations with major merchants, or interstate trade? That "
"would ruin your whole image of a tranquil picturesque backwater where "
"robbers freely sell each other's stolen livestock!\""
msgstr ""
"\"알겠어. {kingdomname}, 참으로 매력적이고 외딴 땅이야. 평화롭고 고요한 곳이기도 하지. 이 땅에 대해 제대로 아는 이는 "
"없어. 이 일에 신경쓰는 사람도 거의 없고. 대상단이나 국가 간 교역을 하면서 명성을 쌓을 이유가 뭐가 있어? 그러면 서로 훔친 물건을 "
"팔아재껴대는 훈훈한 도적들의 벽지라는 인상이 완전히 벗겨져나가 버릴테니!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0014_Text
#. Speaker : SadisticMage_Capital
msgctxt "5c95c64a-70eb-43c8-af6c-3141804477e9"
msgid ""
"\"A fine solution. Of course, we shan't tarnish our reputation. The sale of "
"stolen and smuggled goods is far beneath us. Only 'legal' goods will be "
"allowed in our harbors. But we won't be too querulous about it. So long as "
"the proper fees are paid, the goods are considered legitimate, whatever "
"their original source might have been.\""
msgstr ""
"\"좋은 해결방안입니다. 물론, 우리 명성을 더럽히진 말아야겠지요. 우리 몰래 벌어지는 장물과 밀수품 판매 말입니다. '적법한' 물건만이 "
"우리 항구에서 판매될 것입니다. 이에 대해서 불평하거나 하면 안 됩니다. 번영하는 만큼의 세금이 들어오는 한, 이 물건들은 그 본 출처가 "
"어디든 간에 적법한 것으로 인정될 것이니 말이지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0015_Text
#. Speaker : MaegarVarn_Capital
msgctxt "29f6d0ee-2b7b-40c7-84ff-698d94399198"
msgid ""
"\"One might call it a boon – lawless captains bringing their fortunes here. "
"But it's worth remembering that their money is covered in blood. Should we "
"become their partners in crime? Or should we instead establish proper "
"customs and expel these traffickers from our harbors?\""
msgstr ""
"\"어떤 사람은 보물이라 하겠지요. 법 모르는 선장들이 여기에 돈을 집어넣어 놓으니까요. 하지만 이건 피묻은 돈이라는 것을 기억해야 "
"합니다. 우리가 이런 범죄자들과 한 배에 타야하는 걸까요? 아니면 적절한 세관을 만들어서 이런 밀수업자들을 우리 항구에서 쫓아내야 할까요?"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0016_Text
#. Speaker : Jubilost_Companion
msgctxt "ee9789a1-185a-4432-9e9f-545a6ba9d82a"
msgid ""
"\"Someone else might suggest you take advantage of the situation: simply "
"collect your fees and don't ask too many questions about the blood these "
"goods are soaked in. But as a traveler far and wide, experience has taught "
"me that real wealth only gathers where there's no robbery or smuggling. The "
"major trade unions won't want to deal with one who promotes piracy. I warn "
"against tolerating things as they now stand. Establish proper customs in "
"your harbor, and hunt down these lawless captains.\""
msgstr ""
"\"어떤 자는 이 상황을 기회삼으라 할 거야. 챙길 것을 챙기고 여기 스며든 피에 대해선 함구하고. 하지만 멀리, 넓은 곳을 탐험 해본 "
"입장에서 경험 상 진정한 부는 도둑질이나 밀수로 벌 수 없어. 주 교역 협회들은 해적질을 용납하는 자와 거래하려 들지 않을 거야. 지금 "
"이 상황을 용인하지 말라고 경고할게. 적절한 세관을 항구에 짓고, 이 법 모르는 선장들을 추적해 없어버려야해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0017_Text
#. Speaker : SadisticMage_Capital
msgctxt "1b8d00bd-c49d-4b76-bd2a-754c2c65c6bb"
msgid ""
"\"The merchants fear that you might yet put an end to their shady dealings, "
"that the customs authorities and guards might grow increasingly stricter and "
"less forgiving. But if we stay faithful to the unwritten laws of the land, "
"this would go far in dispelling their fears. You wouldn't want to make "
"matters difficult or meddle in their established routines, would you? What "
"does it matter where the goods come from, so long as we receive our fees? "
"They're not making things difficult for us, so let's not make things more "
"complicated for them.\""
msgstr ""
"\"당신이 아직 범죄를 종식시키지 못했을 거라면서 상인들이 두려워하고 있습니다. 세관과 경비들이 더욱 엄격해질 거라고 말입니다. 하지만 "
"계속해서 이 땅의 관습을 믿고 있기만 한다면, 상인들의 두려움을 잠재울 수 있을 것입니다. 일을 복잡하게 만들거나 범죄자들에게 참견하고 "
"싶지는 않지 않습니까? 세금을 거둘 수 있는데, 물건이 어디서 오는 지가 뭐가 중요하단 말입니까? 범죄자들은 일을 복잡하게 만들 지 않을 "
"터이니, 우리도 복잡하게 가진 맙시다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0024_Text
#. Speaker : Kanerah_Companion
msgctxt "c0aa8fb1-fb86-4954-89b6-6b0e4664affc"
msgid ""
"\"I've put off this conversation for a long time, but I can't do it any "
"more. It's time we discuss a vice that's tormented your country from the "
"moment of its creation. – A vice as beneficial as it is devastating. I'm "
"referring to the black market which thrives in your lands.\""
msgstr ""
"\"이 대화를 너무 오랫동안 미뤄왔군요. 하지만 더 이상 미루진 못 할 거 같습니다. 이 땅이 생겨날 때 부터 이곳을 괴롭혀왔던 악에 "
"대해서 논의해야 합니다. 이득이 되는 만큼 손해도 끼치는 악 말입니다. 제가 말하는 것은 이 땅에 번성하고 있는 암시장에 대한 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0025_Text
#. Speaker : Kanerah_Companion
msgctxt "2c122a69-0f95-4916-96e6-a632aa6b2f45"
msgid ""
"\"Since I took the position of Treasurer, I've dedicated myself to "
"strengthening the legitimacy of your power. I've worked day and night so "
"that no one would dare say that you're just another in the long line of "
"bandit lords that have tormented these lands. But what legitimacy are we "
"talking about, if our trading ports are open to pirates, fences, and "
"smugglers?\""
msgstr ""
"\"제가 재무관의 직책을 맡아온 이래로, 당신의 권력에 대한 정통성을 강화하는 데 온 몸을 바쳐왔습니다. 밤낮으로 일한 결과 그 누구도 "
"당신이 이 땅을 오랫동안 괴롭혀온 도적떼와는 다르다는 사실을 알게되었지요. 하지만 우리 무역소가 해적, 장물아비, 밀수꾼들에게 열려있다면 "
"그 정통성이 어떻게 되겠습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0026_Text
#. Speaker : Kanerah_Companion
msgctxt "0f530901-8b11-423e-b729-738bd5a8f206"
msgid ""
"\"Yes, clandestine trade does bring a lot of gold into the treasury. "
"However, your good name is easily sold – but impossible to buy back! If you "
"allow pigs and vultures at your table, how can you expect people of honor to "
"sit next to them? For the future of your country, I urge you to place "
"customs houses in the ports – and put an end to the black market once and "
"for all!\""
msgstr ""
"\"그렇습니다. 암거래는 국고에 도움이 많이 되지요. 하지만 그 선한 위명에 오점이 붙을 겁니다. 이는 되돌릴 수 없어요! 식탁 옆에 "
"돼지와 독수리가 앉아있는 데, 어떻게 명예로운 사람을 그 옆에 앉히겠습니까? 이 땅의 미래를 위해, 항구에 세관을 건설해주십시오. 그리고 "
"이 암시장을 완전히 끝내버리는 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0027_Text
#. Speaker : Kanerah_Companion
msgctxt "5961914b-a995-4aac-b620-7456dfe8a837"
msgid ""
"\"I will go immediately to organize customs. That's the decision of a true "
"sovereign, whose country will stand not for days and weeks, but for years "
"and ages! Don't give any thought to your lost profits. – Whatever we lose by "
"chasing away thieves and bandits, we'll regain a hundredfold from deals made "
"with worthy partners.\""
msgstr ""
"\"바로 가서 세관을 건설하겠습니다. 수 세대는 이어갈 땅의 참된 군주에 맞는 결정이옵니다! 손해에 대해서는 아무런 생각을 하지 "
"마십시오. 도적이나 강도들을 내쫓으면서 잃은 돈은 가치 있는 파트너와의 거래로 백 배로 되벌 수 있으니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/Cue_0028_Text_String
#. Speaker : Kanerah_Companion
msgctxt "111043b2-396f-43c1-89ab-7852cb5cb242"
msgid ""
"\"You're wrong if you think gold has no odor. Believe me, by accepting dirty "
"money today, you take on the reek of sewage for years to come. Don't be "
"surprised if no one wishes to shake hands with you tomorrow!\""
msgstr ""
"\"돈에 냄새가 배지 않을 거라 생각하셨다면 틀렸습니다. 절 믿으십시오. 오늘 이 더러운 돈을 받으면 앞으로 몇 년은 이 땅에서 "
"하수구냄새가 풍길 겁니다. 내일부터 아무도 당신과 손잡으려 하지 않는다고 하더라도 놀라지 마시길 바랍니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/JhubilostBYE_String
#. Speaker : Jubilost_Companion
msgctxt "b1f64e3a-e64e-4043-b1c1-3b3af01daf0f"
msgid ""
"\"You know, {name}... As much as I struggle to keep your domain from "
"economic collapse, you – you make every effort to stymie me at every turn! "
"This might seem all in good fun to you. Indeed, it's not like a provincial "
"ruler has anything better to do than make a fool of a famous traveler. In "
"fact, I've got an idea for a new book, and I can't presently afford the "
"luxury of wasting my time on useless debates and unheeded advice. I'm sure "
"you can easily find a more flexible Treasurer once I am gone.\""
msgstr ""
"\"{name}... 제가 아무리 이 영토가 경제적으로 무너지려 하는 걸 막으려 해도, 당신, 당신이 내 모든 노력을 허사로 만들고 "
"있어요! 이 모든 게 장난질 처럼 보일지도 모르죠. 그래요, 유명한 모험가를 엿먹이는 것 만큼 군주 입장에서 재밌는 일이 더 있을까요. "
"사실, 새 책을 쓸만한 아이디어를 생각해내긴 했어요. 그리고 지금 제 귀중한 시간을 이 쓸모없는 토론과 말해도 들어먹지를 않는 조언을 "
"하느라 할애할 수가 없다는 게 문제죠. 제가 떠나면 저보다 더 유연한 재무관을 찾을 수 있을 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank6/MaegarBYE_String
#. Speaker : MaegarVarn_Capital
msgctxt "ad74c77f-2c99-4390-9e87-3f1151c36d18"
msgid ""
"\"I fear it's time I bring my service to an end. There is simply no way for "
"me to continue my work as your Treasurer. Our views on the future of the "
"country are far too divergent. I cannot stand silently by and observe what "
"it's to become.\""
msgstr ""
"\"이제 제 직위에서 물러날 때가 온 거 같네요. 더 이상 당신의 재무관을 계속할 이유가 없어요. 국가의 미래에 대한 우리의 바라보는 "
"시각이 너무 달라요. 앞으로 다가올 일에 대해 그냥 조용히 지켜보고만 있지는 못할 거 같아요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Answer_0005_Text
msgctxt "4df90be5-3778-4f46-8fb6-be771880a382"
msgid ""
"{g|Economy7_2}[Choice effects]{/g} \"Let the merchants pay fees only when "
"importing luxury goods.\""
msgstr "{g|Economy7_2}[선택 시 효과]{/g} \"상인들에게 귀중품 수입에 대한 관세만 지불하게 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Answer_0006_Text
msgctxt "2bcc376e-2ca4-4e05-bb39-c827cb665147"
msgid ""
"{g|Economy7_3}[Choice effects]{/g} \"Let the merchants pay fees on luxury "
"goods and materials for craftsmen.\""
msgstr "{g|Economy7_3}[선택 시 효과]{/g} \"상인들에게 사치품과 장인들이 쓸 재료에 관세를 지불하게 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Answer_0007_AlignmentShift.Description
msgctxt "50752019-6653-4ff9-a48b-9f7d8dbfc108"
msgid "Assigned taxes on all kinds of goods."
msgstr "모든 물품에 세금을 매겼다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Answer_0007_Text
msgctxt "ff9d041a-5488-4530-b1ea-bd05c57168ff"
msgid ""
"{g|Economy7_4}[Choice effects]{/g} \"Everything, every single item to the "
"last apple, will be taxed.\""
msgstr "{g|Economy7_4}[선택 시 효과]{/g} \"전부, 사과 한 알까지도 세금을 매길 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Answer_0008_AlignmentShift.Description
msgctxt "505f7adb-823e-4bca-a061-ed8095ff6f42"
msgid "Abolished taxes according to the River Freedoms."
msgstr "강의 자유에 따라 모든 세금을 면제시켰다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Answer_0008_Text
msgctxt "d8a3cbcf-d030-4d9e-9b4c-05a2e6cd2b27"
msgid ""
"{g|Economy7_5}[Choice effects]{/g} \"There will be no taxes. I honor the "
"River Freedoms.\""
msgstr "{g|Economy7_5}[선택 시 효과]{/g} \"세금은 없을 것이다. 강의 자유를 존중하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Answer_0021_Text
msgctxt "367cb5f3-a39a-4cd1-85f8-09f16487fc48"
msgid "\"How should I decide? I will leave this to your capable judgment.\""
msgstr "\"내가 결정할 사안이 아니다. 그대의 유능한 판단에 맡기겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Answer_0041_Text
msgctxt "b82ddfb6-fd30-48d2-92ce-68265ae73807"
msgid ""
"{g|Economy7_1}[Choice effects]{/g} \"A trade guild is a great idea! If you "
"manage to create one, everyone will honor you.\""
msgstr ""
"{g|Economy7_1}[선택 시 효과]{/g} \"무역 길드라니 참으로 훌륭한 생각입니다! 하나 만드시면 모두가 당신을 존경할 겁니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0001_Text
#. Speaker : MaegarVarn_Capital
msgctxt "0f068145-866e-4e71-a094-c0db419c6e5a"
msgid ""
"\"Your Highness, before this country became a kingdom, {g|Brevoy}Brevoy{/g} "
"used to collect taxes from all merchants entering our lands. But now this "
"gold is rightfully yours. When I was a baron, I didn't oppress the merchants "
"too much. My advice is that you only tax those who sell luxurious things, "
"and leave the craftsmen and townsfolk alone.\""
msgstr ""
"\"전하, 이 땅이 왕국이 되기 전, {g|Brevoy}브레보이{/g} 쪽에서 우리 땅에 들어오는 상인 모두로부터 세금을 걷곤 했습니다. "
"하지만 이제 이 돈은 전하의 것입니다. 제가 영주였을 땐, 상인들을 너무 억압하지 않았지요. 제가 드리는 조언은 사치품 매매에만 세금을 "
"매기되, 장인과 마을 사람들은 내버려두자는 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0002_Text
#. Speaker : Jubilost_Companion
msgctxt "adb9ee32-6b1d-4cef-a69d-49f0d8f152bd"
msgid ""
"\"{name}, the movement of goods through our lands continues to grow. It's "
"time we exercised your right to charge fees and taxes on merchants who enter "
"your borders.\""
msgstr "\"{name}, 우리 땅에서 물류 이동이 증가하고 있어. 우리 국경에 드나드는 상인들에게 요금과 관세를 걷어야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0003_Text
#. Speaker : SadisticMage_Capital
msgctxt "7e9e857f-8bd5-4efd-9be2-2c8fb8638472"
msgid ""
"\"Your Highness! The movement of goods through our lands is growing! – And "
"our independence from {g|Brevoy}Brevoy{/g} means that we may now collect "
"taxes from the merchants who enter these lands.\""
msgstr ""
"\"전하! 우리 땅에서 물류 이동이 증가하고 있습니다! {g|Brevoy}브레보이{/g} 로 부터 독립했으니 이제 이 땅에 들어오는 "
"상인들에게 세금을 거둬야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0009_Text
#. Speaker : MaegarVarn_Capital
msgctxt "1140cae1-0c88-4a3b-a299-ac252125cb64"
msgid ""
"\"Merchants will be happy to visit us, and our subjects will be able to buy "
"goods cheaply easily. They will grow wealthier, and at the same time, your "
"tax base will grow. This is how we make up for the taxes we didn't charge "
"the merchants! It is a wise solution. I would do the same.\""
msgstr ""
"\"상인들이 기꺼이 우리에게 찾아오고 우리 백성들도 싼 물건을 쉽게 살 수 있을 겁니다. 백성들은 점점 부유해져가고, 동시에 세수도 "
"늘어날 겁니다. 이렇게 하면 상인들에게 과세하지 않고도 세금을 걷을 수 있지요! 현명한 해결책입니다. 저라도 이렇게 했을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0010_Text
#. Speaker : Jubilost_Companion
msgctxt "ea37582e-cafe-4b7e-8ead-344ac15f2a12"
msgid ""
"\"So that's how you want it. All right then. At least it will make the "
"people happy. Perhaps that's even more important than a few extra coins.\""
msgstr ""
"\"그래서, 그게 바로 당신이 원하는 방식이군요. 좋습니다. 그건 적어도 사람들을 행복하게 만들긴 할겁니다. 어쩌면 그게 동전 몇개 버는 "
"것 보다 중요 할수도 있겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0011_Text_String
#. Speaker : SadisticMage_Capital
msgctxt "0b874a7d-7a22-4f49-84a5-033392285f9b"
msgid ""
"{n}Bartholomew purses his lips.{/n} \"As if only wealthy people have money! "
"What's the point of my efforts to save every penny, if you just cast "
"hundreds of coins out the window?\""
msgstr ""
"{n}바솔로뮤는 입술을 오무린다.{/n} \"마치 부자들만 돈을 가지고 있는 것 같군요. 당신이 매번 창밖으로 동전 수백닢을 던져 "
"버린다면, 내가 몇푼 아끼려고 이렇게 노력하는것에 무슨 의미가 있습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0012_Text
#. Speaker : MaegarVarn_Capital
msgctxt "4b16c212-2dba-4189-b24d-20d9458d9289"
msgid ""
"\"Well, perhaps that's the best solution, indeed. The taxes we'd collect on "
"materials are too great to pass up. The treasury will always be empty "
"without this money. At least it won't harm the interests of the ordinary "
"people. I like this decision.\""
msgstr ""
"\"좋습니다, 이게 정말로 최선의 방법일지도 모르겠군요. 우리가 자재들에 부과해서 거둔 세금은 포기해버리기엔 너무 많은 양입니다. 그 "
"돈이 없으면 재무부의 금고는 항상 비어있을겁니다. 적어도 이건 평범한 사람들의 이익에는 해를 끼치지 않겠지요. 나는 이 결정이 좋습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0013_Text
#. Speaker : Jubilost_Companion
msgctxt "42258ade-100e-4c59-b600-9dbd7ca830d3"
msgid ""
"{n}Jubilost nods approvingly.{/n} \"I can see you like reasonable solutions, "
"and do not stray to the extremes. This is commendable.\""
msgstr ""
"{n}주빌로스트는 동의하며 고개를 끄덕입니다.{/n} \"나는 당신이 합리적인 해결책을 좋아하고, 극단적인 길로는 빠지지 않는다는걸 "
"알겠어. 이건 인정할만 하군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0014_Text
#. Speaker : SadisticMage_Capital
msgctxt "6d7de18f-d27b-4289-8d2b-91ca480430b0"
msgid ""
"{n}Bartholomew calculates something pensively, then smiles lightly.{/n} "
"\"That might be even better. The merchants will pass through our territory "
"just to avoid our neighbors. We'll collect less gold, it's true. But our "
"neighbors won't get a penny! That is the essence of being wealthy! – If you "
"have more than your neighbors, you are feared and respected. This is a very "
"sensible decision.\""
msgstr ""
"{n}바솔로뮤는 골똘히 무언가를 계산했다. 그리고 가볍게 웃었다.{/n} \"그게 더 낫겠습니다. 상인들은 단지 우리 이웃들을 피하기 "
"위해서 우리 영토를 지나갈것입니다. 우리가 걷는 돈은 줄어들겠죠. 그건 사실입니다. 하지만 우리의 이웃들은 동전 한푼도 얻지 못할 "
"겁니다. 이게 바로 부자가 되는 방법의 본질이죠. 당신의 이웃보다 많이 가지고 있으면, 두려움과 존경을 받는겁니다. 이건 아주 이성적인 "
"결정입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0015_Text_String
#. Speaker : MaegarVarn_Capital
msgctxt "996de7dd-1b81-46ad-8a17-f5268e5151c5"
msgid ""
"\"You can't treat the rich and the poor the same! You just can't! This is "
"how you devastate your people!\""
msgstr ""
"\"부자와 가난한자를 똑같이 대할 순 없습니다! 그래서는 안되는 겁니다! 그게 바로 당신이 당신의 백성들을 망치는 방법입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0016_Text
#. Speaker : Jubilost_Companion
msgctxt "4c05a4a8-5054-43eb-94ef-a1b9f0009af6"
msgid ""
"\"You think that's the way to get more money, but that's not how it works. "
"You will reduce the volume of goods imported into your lands. On the other "
"hand, the coffers will fill more...\""
msgstr ""
"\"그게 더 많은 돈을 버는 방법이라 생각 하셨겠죠. 하지만 세상이 그렇게 돌아가는게 아닙니다. 당신의 지역으로 수입되는 상품의 양을 "
"줄인다면, 반대로 금고가 더 많이 채워지게 될것입니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0017_Text
#. Speaker : SadisticMage_Capital
msgctxt "e139c874-20fe-4b5b-9202-2ad052e7ca9d"
msgid ""
"\"This is an excellent solution! I swear we will have to expand the treasury "
"to fit all the riches we'll soon have in our coffers!\""
msgstr "\"이건 아주 훌륭한 해결책입니다! 나는 우리가 버는 돈을 채워넣기 위해 우리 금고를 늘려야 할거라고 맹세할 수 있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0018_Text
#. Speaker : MaegarVarn_Capital
msgctxt "7be6cceb-c082-4630-b5b5-48331cc45365"
msgid ""
"\"We'll tax only luxury goods, and leave all else be. Needless greed would "
"undermine trade in our lands.\""
msgstr "\"우리는 사치품에만 세금을 매기고, 나머지는 내버려 둘것입니다. 불필요한 탐욕은 우리땅의 무역을 약화시킬겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0019_Text
#. Speaker : Jubilost_Companion
msgctxt "d1b4378f-63fc-4edb-b1a0-5c334542b207"
msgid ""
"\"We will levy taxes on goods for the rich and for artisans, thus ensuring "
"that everyone takes a reasonable stake.\""
msgstr "\"우리는 부자들과 장인들을 위한 상품에 세금을 물릴겁니다. 이러면 모든 사람들이 자기의 합리적인 지분을 받을겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0020_Text
#. Speaker : SadisticMage_Capital
msgctxt "037030e5-ccb1-42db-925d-b27064b9669f"
msgid ""
"\"We won't let a penny slip by. Everything that the merchants bring to our "
"territory will be taxed.\""
msgstr "\"우리는 동전 한닢도 놓치지 않을겁니다. 상인들이 우리땅으로 가져오는 모든것에는 세금이 붙을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0022_Text
#. Speaker : MaegarVarn_Capital
msgctxt "03ac5884-7788-4d31-a5a6-45478ab002ca"
msgid ""
"{n}Maegar scratches his chin.{/n} \"You've made a very generous and noble "
"decision. The people will appreciate it. But I hope you have some idea how "
"you'll fill the treasury.\""
msgstr ""
"{n}메이가르는 그의 턱을 긁는다.{/n} \"아주 고귀하고 관대한 결정을 내리셨습니다. 사람들이 감사할겁니다. 하지만 저는 당신이 "
"금고를 채울 방법도 생각해두셨으면 좋겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0023_Text_String
#. Speaker : Jubilost_Companion
msgctxt "22be1948-bb30-4330-a7e6-101d1cb5ef03"
msgid ""
"{n}Jubilost smiles slightly.{/n} \"You think you're that crafty? Building "
"your first kingdom without duties or taxes? You know, these are bold "
"fantasies, best stored as far away from your head as possible. I've got a "
"special notebook for them. You should have one, too.\""
msgstr ""
"{n}주빌로스트는 가볍게 웃는다.{/n} \"너는 니가 그렇게 똑똑하다고 생각해? 의무나 세금 없이 너의 첫 왕국을 세울 만큼? 너도 "
"알겠지만 그런건 뻔뻔한 환상들이야. 그런건 니 머리에서 가능한 먼곳에 보관하는게 좋다고. 나는 그런 환상들을 위한 특별한 노트를 가지고 "
"있지. 너도 하나 있어야겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0024_Text_String
#. Speaker : SadisticMage_Capital
msgctxt "952a62df-ee26-4141-bdb0-99a3b1dca07b"
msgid ""
"{n}Bartholomew's eyes widen. He moves his lips, as if trying to utter a "
"sound.{/n} \"But how... Why... You're stealing from your own pocket! From "
"your own treasury! Don't you need gold? Why do you even need a Treasurer "
"then?!\""
msgstr ""
"{n}바솔로뮤의 눈이 화등잔만해진다. 그는 소리를 내려는 듯 입술을 달싹거린다.{/n} \"어떻게... 왜... 자기 주머니에서 돈을 "
"훔치는 격 아닙니까! 자기 나라 국고에서 말입니다! 돈이 필요하잖습니까? 이럴 거면 당최 왜 재무관이 있어야 하는 겁니까?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0025_Text
#. Speaker : Jubilost_Companion
msgctxt "47df4349-900b-4a5b-8461-57400d913fb8"
msgid ""
"\"In the past, {g|Brevoy}Brevoy{/g} has exercised this right, but now it's "
"in your hands. You only have to decide what to levy taxes on. I recommend "
"you to steer to the middle course. Do not oppress the merchants too greatly. "
"Do not believe their complaints and claims of poverty either."
msgstr ""
"\"옛날엔 {g|Brevoy}브레보이{/g}가 이 권리를 행사했지. 하지만 이제 이 권리는 너에게 있어. 그냥 어떤 물품에 세금을 더 "
"부과할 지만 결정하면 돼. 중도를 지키길 권하지. 상인들을 너무 가혹하게 몰아붙이면 안돼. 저들이 스스로 가난하다고 주장하거나 불평하는 "
"것도 믿어서도 안되고."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0026_Text
#. Speaker : Jubilost_Companion
msgctxt "5ddd3b1a-b00f-4ca3-8c92-d2e4a82280b6"
msgid ""
"\"You should place a tax on goods for the rich, and on craft materials for "
"artisans. They both have enough income to survive these taxes without going "
"bankrupt. Certainly you're free to dismiss my advice. After all, what's the "
"word of a famous traveler who's seen so many countries and watched how they "
"prosper...\""
msgstr ""
"\"부자들을 위한 물건과 장인들을 위한 재료에 세금을 매기자. 둘 다 파산할 일 없을 정도로 많은 돈을 긁어모으니까. 물론 내 조언을 "
"무시하는건 자유지. 어쨌든, 수많은 국가들이 어떻게 번영했는지 지켜본 유명한 여행자의 의견일 뿐이니...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0027_Text
#. Speaker : SadisticMage_Capital
msgctxt "f846d416-637b-4bb8-ae26-573bc3e85419"
msgid ""
"\"There's a fortune flowing through our lands into other countries. I "
"recommend we don't miss this opportunity, and fill the treasury as quickly "
"as we can. And I suggest we don't quibble over details, and simply levy "
"taxes on everything.\""
msgstr ""
"\"돈이 우리 땅을 통해 다른 나라로 흘러들어가고 있습니다. 이 기회를 놓치지 말고 최대한 빠르게 국고를 채워야 합니다. 자세한 내용 "
"가지고 옥신각신 하지 말고, 그냥 모든 것에 세금을 부과하십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0033_Text
#. Speaker : MaegarVarn_Capital
msgctxt "6da3a2b6-6159-418a-b520-8a1a8b30133b"
msgid ""
"\"Any gold that an artisan saves will enter circulation anyway. It will be "
"used as material to produce goods. Any hold saved by the townsfolk will go "
"into circulation too. – They'll use it to buy goods. Whereas the money of a "
"wealthy person will be invested in useless trinkets, which will sit in their "
"mansion collecting dust. – Not doing any good to anyone!\""
msgstr ""
"\"장인이 얼마나 저금했든 간에 어쨌든 그 돈은 순환할 것입니다. 상품을 만들기 위한 재료값으로 나가게 되어있거든요. 마을 사람들이 번 "
"돈도 결국엔 순환할 것입니다. 장인이 만드는 상품을 사게 될 거거든요. 하지만 부자들의 돈은 쓸모없는 장신구나 사는 데 쓰이게 될 "
"겁니다. 그네들 저택에 고이 모셔져 먼지나 듬뿍 쌓이면서 말이지요. 누구에게도 도움 되는 일 없이 말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0038_Text
#. Speaker : Kanerah_Companion
msgctxt "693f314d-0850-45b0-a5da-d200f4e61b86"
msgid ""
"\"A kingdom...\" {n}The tiefling savors this word like candy melting on her "
"tongue.{/n} \"Yes, you now have a real kingdom. Your entire capital was once "
"worth less than the goods now flowing through your ports! It's about time to "
"reform the tax system, before we start looking like hapless guests at a "
"feast, hungrily eying the most delicious dishes as they're carried past!\""
msgstr ""
"\"왕국이라...\" {n}티플링은 마치 혀 안에서 사탕을 녹이는 것 처럼 말을 아꼈다.{/n} \"그래, 이제 진짜 왕국이 있는 "
"셈이지. 예전엔 수도 전체의 가치가 지금 항구로 흘러들어오는 상품보다 가치가 떨어졌으니 말이지! 이제 세금 체계를 다시 손 볼 차례야. "
"축제에서 이미 지나가버린 가장 맛있는 요리나 쳐다보며 찌질하게 찌그러져있는 손님처럼 보이기 전에 말이지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0039_Text
#. Speaker : Kanerah_Companion
msgctxt "03b4096c-b576-4273-98b9-c274eeab0181"
msgid ""
"\"Although one mustn't give way to greed either. Luxurious items for the "
"wealthy, materials and tools for craftsmen, and simple goods for the common "
"folk – all of these are different things, and it would be unwise to tax them "
"equally. I'll prepare a detailed draft of the reform... But first, listen to "
"my proposal.\""
msgstr ""
"\"탐욕에 무너지시면 안 되는 법입니다. 비싼 물건은 부자가, 재료와 도구는 장인이, 단순한 물건은 평민들이. 이렇게 모두 가지는 게 "
"다른 데 모두에게 공평하게 세금을 매기는 것은 현명하지 못합니다. 개혁을 위한 초안을 작성하겠습니다만... 일단은 제 제안을 들어주십시오."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0040_Text
#. Speaker : Kanerah_Companion
msgctxt "1b130b86-698e-44c7-b8dd-f6b4fe157caa"
msgid ""
"\"Allow me to found our own royal trade guild in our lands. Its members will "
"enjoy lower taxes and extended rights... But membership would have to be "
"earned! I will make every merchant go out of their way to ingratiate "
"themselves with us, and demonstrate that doing business with them is highly "
"profitable for the crown. Just think what opportunities this will open!\""
msgstr ""
"\"이 땅에 우리만의 국영 무역 길드를 창설하게 허락 해주십시오. 회원들에겐 세금을 낮추고 더욱 더 많은 권리를 줄 생각입니다... "
"하지만 회원증을 얻어야 하긴 하지요! 모든 상인들이 우리의 환심을 사도록 하고, 이들과 일을 하는 게 국가에 이득이 된다는 것을 "
"증명해보이겠습니다. 그냥 이 길드로 인해 생겨날 기회들을 생각해보십시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0042_Text
#. Speaker : Kanerah_Companion
msgctxt "d6c60dbe-3bed-4010-8cb6-fc01adba1101"
msgid ""
"{n}Kanerah smiles sweetly.{/n} \"Very wise, as usual. I will create a royal "
"trade guild, one that will be the envy of all, from Galt to Numeria.\""
msgstr ""
"{n}카네라는 다정하게 미소짓는다.{/n} \"언제나 그렇듯, 현명하시군요. 국영 무역 길드를 만들겠습니다. 갈트에서 누메리아까지, "
"모두가 부러워 할 만한 길드를요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0043_Text
#. Speaker : Kanerah_Companion
msgctxt "d33b9006-4e5e-4808-a1aa-c6508e509697"
msgid ""
"\"Taxes on luxuries are important, but you shouldn't underestimate the "
"profits that less refined goods can bring to the treasury. There's a lot of "
"meat in a single buffalo, but far more in ten thousand rabbits!\""
msgstr ""
"\"사치품에 매기는 세금은 중요합니다만, 비교적 저가의 물건에서 나오는 세금도 무시하시면 안 됩니다. 소 한 마리에서 나오는 고기 양은 "
"많지만, 토끼 천 마리에서 나오는 고기 양은 더 많으니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0044_Text
#. Speaker : Kanerah_Companion
msgctxt "00903790-badc-458b-a91c-1991d2399778"
msgid ""
"\"Both the wealthy and craftsmen are excellent sources of income, but they "
"are greatly outnumbered by the poor. It's unwise to deprive the treasury of "
"their copper! And don't hope that the common people will thank you for low "
"prices. Most of them are blind as moles. They imagine that they themselves "
"are the ones to thank for securing their well-being, and only thank their "
"{mf|baron|baroness|King|Queen} for their troubles!\""
msgstr ""
"\"부자나 장인이나 둘 다 훌륭한 수익원입니다만, 빈민들이 내는 세금에 비하면 아무것도 아니지요. 빈민들을 너무 쥐어 짜시면 안 됩니다! "
"그렇다고 세금을 낮춰도 평민들이 고마워하리라고는 생각하진 마십시오. 대부분 머저리에 불과하니까요. 이들은 이 땅을 지키는 게 자신들이라고 "
"생각하며 감사받기를 바라고, {mf|영주|영주|왕|여왕} (으)로부터 은혜를 입을 때만 감사해 하니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0045_Text
#. Speaker : Kanerah_Companion
msgctxt "6759bb78-46d4-4267-8d3f-c117a8781b70"
msgid ""
"\"Of course. Well, if my idea for a trade guild doesn't appeal to you, I "
"will work on drafting a new customs code. It will require pinpoint "
"precision. We'll have to shave as much wool from each sheep as it can give – "
"not more, but not less!\""
msgstr ""
"\"물론입니다. 뭐, 제 무역 길드 제안이 그렇게 매력적이지 않으시다면, 세관을 위한 새로운 법의 초안을 작성하러 가보겠습니다. 빈틈없는 "
"정밀함이 요구되는 작업이니까요. 저 양떼와같은 백성들의 털을 가능한 모조리 벗겨야 합니다. 그 이상, 그이하도 아니게요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank7/Cue_0046_Text_String
#. Speaker : Kanerah_Companion
msgctxt "0ea48f37-0a84-4cd3-8592-a6e6d24c9627"
msgid ""
"{n}The smile on Kanerah's face turns into a grimace.{/n} \"This is madness. "
"I'm serving an insane {mf|king|queen}. After this, I won't be surprised if "
"you decide to walk around the streets naked, appoint an owlbear as head of "
"government, or execute anyone who has more than three cats at home.\""
msgstr ""
"{n}카네라의 얼굴에 걸려있던 미소가 찡그림으로 바뀌었다.{/n} \"이건 말도 안 됩니다. 제가 정신 나간 {mf|왕|여왕} 을 섬기고 "
"있었다니요. 이후엔 전하가 나체로 길거리를 돌아다니고, 아울베어를 총리로 임명하거나 집에 고양이가 3마리 이상 있는 사람은 모조리 "
"처형한다고 해도 믿을 거 같군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Answer_0005_Text
msgctxt "49c0ece2-cd97-4d10-af93-a12ae6b993c2"
msgid ""
"{g|Economy8_1}[Choice effects]{/g} \"I'd be happy to enter a trade agreement "
"with the citizens of wealthy Daggermark.\""
msgstr "{g|Economy8_1}[선택 시 효과]{/g} \"기꺼이 대거마크의 부유한 시민들과 교역 협정을 맺도록 하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Answer_0006_Text
msgctxt "32b24945-3e7c-4822-b8fb-0c9d1e9b717d"
msgid ""
"{g|Economy8_2}[Choice effects]{/g} \"Let them go home. We've no interest in "
"their offer.\""
msgstr "{g|Economy8_2}[선택 시 효과]{/g} \"집으로 돌려보내라. 이 제안엔 관심 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Answer_0017_Text
msgctxt "8e1444b7-3cf9-4d80-b3d7-9941a6dd966c"
msgid "\"I trust your advice.\""
msgstr "\"자네의 조언을 믿겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0001_Text
#. Speaker : MaegarVarn_Capital
msgctxt "4b1d3e0e-978e-495c-b1a9-9db9af6d20ae"
msgid ""
"\"A sales representative of several trade houses in Daggermark has arrived "
"at your court. They are interesting in trading in our domain. They offer us "
"fair compensation for a trade agreement, but I wouldn't hurry to trust their "
"siren songs.\""
msgstr ""
"\"대거마크의 몇 무역 가문에서 나온 대표가 궁성에 도착했습니다. 이들은 우리 땅에서 장사를 하려 합니다. 교역 협정으로 적절히 "
"사례하겠다고는 하지만, 이 유혹을 아직 곧이 곧대로 믿진 말아야할 거 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0002_Text
#. Speaker : Jubilost_Companion
msgctxt "a84fbf18-9e7e-4730-916a-ed910bf607f4"
msgid ""
"\"Your Highness, an ambassador of trade union in Daggermark has arrived at "
"your court. The union is asking for permission to trade in our domain. They "
"are willing to pay a generous fee.\""
msgstr ""
"\"대거마크의 무역 연합에서 온 사절이 궁성에 도착했어. 이 연합은 우리 땅에서 장사를 하는걸 허가 받고자 한다는군. 보상을 꽤나 주는 "
"것 같아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0003_Text
#. Speaker : SadisticMage_Capital
msgctxt "6af31095-49ac-4659-b19d-2be87e9ab225"
msgid ""
"\"Your Highness, a sales representative of Daggermark has arrived at your "
"court. They seek to make a trade partnership. But know that Daggermark has "
"its own traditions. Everything can be bought and sold. Perhaps some of the "
"local merchants will have a difficult time alongside such neighbors. But we "
"will profit greatly from Daggermark's offer, and continue collecting a "
"reliable income in the future. I see no reason to say no.\""
msgstr ""
"\"전하, 대거마크의 교역 대표가 우리 궁성에 도착했습니다. 이들은 교역 협정을 맺고자 합니다. 하지만 대거마크에는 독자적인 전통이 "
"있다는 것을 기억하십시오. 저들은 돈 되는 거라면 뭐든지 팔아치웁니다. 지역 상인들이 이 이웃들 옆에서 장사를 하면 꽤나 힘들어할 수도 "
"있습니다. 하지만 대거마크 쪽에서 제시하는 사례금 외에도 추후에 걷을 수 있는 수익이 꽤나 될 것입니다. 거절할 이유가 없지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0008_Text_String
#. Speaker : MaegarVarn_Capital
msgctxt "628b151e-407f-4ec9-9e63-fbc6d542cc71"
msgid ""
"\"It seems like a bad idea. I have little doubt that the first thing these "
"newcomers will do is use threats and blackmail to suppress the local "
"merchants. The very merchants who rely on our support and protection!\""
msgstr ""
"\"나쁜 생각 같습니다. 저들은 분명 우리 지역 상인들에게 공갈과 협박을 칠 게 분명합니다. 우리 지원과 보호를 받고있는 바로 그 "
"상인들에게 말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0009_Text_String
#. Speaker : Jubilost_Companion
msgctxt "65d67a26-6d13-49ef-999d-f681b744cbf9"
msgid ""
"\"It's a brave choice. We'll see what this risky cooperation brings us.\""
msgstr "\"멋진 선택이야. 이 위험한 협력이 어떻게 전개될 지 한 번 지켜보자고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0010_Text
#. Speaker : SadisticMage_Capital
msgctxt "b741c846-5bf8-4552-b1d5-59ad87403ae1"
msgid ""
"\"This trade agreement will connect us to a large and powerful trade "
"network. This means that anyone who menaces us also jeopardizes Daggermark's "
"commercial interests. Believe me, your Highness, Daggermark knows a thing or "
"two about safeguarding their interests!\""
msgstr ""
"\"이 교역 협정으로 우리는 더욱 더 거대하고 강력한 무역망에 연결될 것입니다. 이 말인 즉슨 우리를 위협하는 자는 또한 대거마크의 "
"상업적 수익에 영향을 주게된다는 뜻이지요. 절 믿으십시오, 전하. 대거마크는 이득을 지키는 데에서라면 둘째가라면 서러운 자들이니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0011_Text
#. Speaker : MaegarVarn_Capital
msgctxt "ca415c35-73b4-4868-9ffa-3c34159fdb86"
msgid ""
"\"I will send them away at once. We can do without street gangs, smuggling, "
"bribery, kidnapping, and all the other lovely gifts of these Daggermark "
"'businessmen'. If the tragedy hadn't struck my domain, I'd have loved to "
"neighbor a kingdom led by so wise a ruler as you.\""
msgstr ""
"\"즉시 저들을 쫓아내겠습니다. 우리도 양아치, 밀수, 뇌물, 납치나 이 대거마크의 '사업가'들이 주는 선물 없이도 잘 해내갈 수 "
"있습니다. 제 영토에 닥친 비극만 없었더라도, 전하 같은 현명한 군주를 둔 왕국과 기꺼이 이웃하고 있을텐데 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0012_Text
#. Speaker : Jubilost_Companion
msgctxt "2bb3c5c4-e4a1-4c7d-9219-19938263de0a"
msgid ""
"\"You must remain sober, and never play with someone more skilled in "
"shuffling the deck. You don't want to be taken by a cardsharp, right?\""
msgstr "\"냉철해야 해. 그리고 너보다 더 교활한 자와는 아무런 협상을 하면 안 돼. 사기에 당하고 싶지 않다면 말이야. 알겠어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0013_Text_String
#. Speaker : SadisticMage_Capital
msgctxt "5a6c622e-155a-49c0-a5d9-ceb2ca4308b4"
msgid ""
"\"Why? Do they employ unethical methods? Why should we care? You trusted me "
"with your treasury. I'm trying to make it grow, and you simply won't let me!"
"\""
msgstr ""
"\"어째서입니까? 저들이 비도덕적인 방법을 사용합니까? 우리가 왜 그런 걸 신경써야 하는 겁니까? 당신은 저를 재무관으로서 믿어주고 "
"계시지 않습니까. 국가 재정은 제가 책임지겠습니다. 쉽게 실망시켜드리지 않을 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0021_Text
#. Speaker : MaegarVarn_Capital
msgctxt "12864688-4016-41f8-ae76-bd833c211e1a"
msgid ""
"\"What they truly want is to ruin our merchants – to replace them, and lay "
"down their own rule. The rule of urban bandits with sharp blades and deadly "
"poisons. But they are a strong community. They stand united and support each "
"other. If you make a decision that is not to their liking, they won't "
"hesitate to pressure you, or cause trouble. In any case, I strongly advise "
"against this dangerous offer.\""
msgstr ""
"\"저들이 진정으로 원하는 것은 우리 상인들을 몰락시키는 겁니다. 상인들을 자기 입맛대로 바꾸고, 자기네들 규칙을 적용시키려는 것이지요. "
"날카로운 칼과 치명적인 독을 든 도시 도적들의 규칙 말입니다. 저들은 강력한 단체입니다. 서로를 지지하며 함께 뭉쳐있습니다. 저들의 "
"마음에 들지 않는 결정을 내리게 된다면, 주저하지 않고 압박을 가해올 것입니다. 아니면 문제를 일으키던가요. 어쨌든 이런 위험한 제안에는 "
"강력히 반대하는 바입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0022_Text
#. Speaker : Jubilost_Companion
msgctxt "5b3dc6b7-f1d8-44f7-a797-7c7201cb7ed2"
msgid ""
"\"It's worth considering who we are dealing with. In Daggermark, your power "
"and privilege depend directly upon the weight of your coinpurse. Whereas "
"leaders of other countries often surreptitiously act as profiteers and "
"bandits, it's through profiteering and banditry that rulers in Daggermark "
"rise to power. – And to be clear, the city is thriving.\""
msgstr ""
"\"우리가 상대하는 게 누군지 생각해볼 필요가 있지. 대거마크에서의 권력과 특권은 지갑이 얼마나 무거우냐에 따라 달라져. 다른 나라의 "
"군주들은 은밀하게 모리배질과 도적질을 하는 반면, 대거마크의 통치자들에게 이는 권력을 얻기 위한 수단이야. 그리고 한 가지 명확하게 "
"알려주자면, 대거마크는 번성하고 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0024_Text
#. Speaker : Jubilost_Companion
msgctxt "06687d8e-a850-406d-b431-c047b5e66e1c"
msgid ""
"\"I often hear praise of the intelligence and business acumen of "
"Daggermark's citizens, but never any praise of their honesty or ethical "
"perspective. It's up to you to decide who you make deals with, but I don't "
"mind playing this little business game we've been offered.\""
msgstr ""
"\"가끔 대거마크 시민들의 지성과 사업적 감각에 대한 칭찬이 들려오지만, 정직함과 윤리적 관점에 대한 칭찬은 결코 들어본 적이 없어. "
"누구와 계약할 지는 전적으로 네 손에 달려있지만, 우리가 제안받은 이 사업 놀이를 하는 것도 괜찮아보이는군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0027_Text
#. Speaker : Jubilost_Companion
msgctxt "a8b92521-a82c-4800-8c80-064634d3cae7"
msgid ""
"\"I will grant our consent to Daggermark's representatives. We'll see who's "
"craftier.\""
msgstr "\"대거마크의 대표에게 우리의 허락을 전하겠습니다. 누가 더 교활한 지 한 번 따져보지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0030_Text
#. Speaker : Kanerah_Companion
msgctxt "c1d52a04-6baf-4c75-9269-0db4fc3cf75b"
msgid ""
"\"A messenger from the Daggermark trading houses has arrived at court. "
"They're requesting permission to trade on your lands. His words are sweet, "
"but not like honey. – Rather more like the sickening sweetness of rotting "
"meat.\""
msgstr ""
"\"대거마크의 무역 가문에서 온 전령이 궁성에 도착했습니다. 저들은 우리 땅에서의 무역 허가를 요구하고 있습니다. 하는 말은 달콤하지만, "
"꿀 같진 않군요. 썩어가는 고기의 구역질나는 달콤함에 가깝겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0031_Text
#. Speaker : Kanerah_Companion
msgctxt "534c8d1d-9deb-4673-bb49-aac56c03df19"
msgid ""
"\"Daggermark is an ugly travesty of a state. A den of thieves and thugs, "
"where you can easily buy a life – or lose your own for a handful of gold. "
"Yes, Daggermark does possess money and goods. But they also have a "
"reputation!\""
msgstr ""
"\"대거마크는 흉물스러운 유사국가입니다. 도적과 깡패의 소굴이자, 돈만 있으면 손쉽게 생명을 사고팔 수 있는 곳이지요. 네, 대거마크는 "
"돈과 상품이 많지요. 하지만 악명도 자자합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0032_Text
#. Speaker : Kanerah_Companion
msgctxt "4c426706-5e90-4eaf-8f33-e67fbcb318ea"
msgid ""
"\"If they do come to your dominions, do not hope that they'll conduct their "
"business peacefully – oh no! They'll begin by imposing their own rules. And "
"like plague-stricken rats, they will spread extortion, blackmail, forgery, "
"and a thousand other ailments throughout our country! Is that worth the "
"profits they promise?\""
msgstr ""
"\"저들이 우리 영토에 들어오면 평화로운 사업과는 안녕을 고하십시오. 저들은 자신들의 규칙을 내세울 것입니다. 그리고 병에 걸린 "
"쥐새끼마냥 강탈과 협박, 위조, 그리고 수천가지의 질병을 퍼뜨리겠지요! 저들을 들일만한 가치가 있다고 보십니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0035_Text_String
#. Speaker : Kanerah_Companion
msgctxt "30dd2d99-61ed-4904-8021-41f72fbd5bfd"
msgid ""
"\"Wealth comes in different forms. Sometimes neighbors build it together, "
"enriching each other. Some decimate each other instead. An agreement with "
"Daggermark will definitely bring much profits... But to whom? Think about it!"
"\""
msgstr ""
"\"돈은 다양한 형태로 들어오지요. 이웃들의 힘을 빌어, 서로에게 득이 되는 방향으로 들어올 때가 있습니다. 어떤 사람들은 서로 다투기도 "
"하지요. 대거마크와의 협정은 분명 소득이 많을 겁니다만... 누구를 위하느냐가 문제입니다. 생각해 보시길!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank8/Cue_0036_Text
#. Speaker : Kanerah_Companion
msgctxt "d5519111-07bc-4693-b37b-c2b89d457c2a"
msgid ""
"\"A wise decision. I think I won't insult our dear guests with outright "
"refusal. – We don't want these respected businessmen to bring their "
"assassins' knives into the capital. I'll tell them we're ready to deal, and "
"then propose such terms that they'll have no choice but refuse. They'll soon "
"go back where they came from of their own volition.\""
msgstr ""
"\"현명하신 결정입니다. 노골적인 거절로 우리 손님들을 모욕하지는 않겠습니다. 이 존경받는 사업가들이 우리 수도에 암살자들을 풀어놓길 "
"바라진 않으니까요. 거래 할 준비가 되었다고 말하면서, 거절할 수 밖에 없는 제안을 하겠습니다. 저들은 자기 의지로 대거마크로 돌아갈 "
"것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Answer_0005_Text
msgctxt "57b6bfba-3c8f-4cb6-84f6-1f261d99cb97"
msgid "{g|Economy9_2}[Choice effects]{/g} \"Start producing these coins.\""
msgstr "{g|Economy9_2}[선택 시 효과]{/g} \"동전 주조를 시작하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Answer_0006_Text
msgctxt "b955129c-68c5-4b1d-85b3-e0537dde4b37"
msgid ""
"\"Let's avoid the expense. Besides, seeing my face on every coin would drive "
"me crazy.\""
msgstr "\"지출을 줄이자. 이제는 동전에 새겨진 내 얼굴만 봐도 미쳐버리겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Answer_0008_AlignmentShift.Description
msgctxt "a07e4cfc-0d85-4345-9801-d5db1eaa0936"
msgid "Ordered the minting of deficient coins."
msgstr "결함있는 동전을 주조하도록 명령했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Answer_0008_Text
msgctxt "432cb455-6d9d-44c5-9bab-5e63191aa0ed"
msgid ""
"{g|Economy9_4}[Choice effects]{/g} \"Do what you offered. You know what I "
"mean.\""
msgstr "{g|Economy9_4}[선택 시 효과]{/g} \"제안받은 대로 하라. 무슨 뜻인 지는 알겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Answer_0022_Text
msgctxt "ca2e156c-4f54-4fd0-bbd7-0049854007c9"
msgid "\"Decide it yourself. After all, you're the Treasurer.\""
msgstr "\"알아서 결정하라. 어쨌든 재무관은 그대이니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Answer_0030_Text
msgctxt "198ff968-e766-4e89-8eae-701c607bb23a"
msgid ""
"{g|Economy9_1}[Choice effects]{/g} \"I like your plan. Let's start minting "
"coins, and order that taxes can only be paid using them.\""
msgstr ""
"{g|Economy9_1}[선택 시 효과]{/g} \"계획이 마음에 드는군. 동전을 주조하고 세금을 낼 때엔 이 동전만을 내도록 시키라."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0001_Text
#. Speaker : MaegarVarn_Capital
msgctxt "a8b32631-0b26-48bb-bcee-cd3eb71e4d2e"
msgid ""
"\"Your Highness, a couple of Daggermark swindlers were arrested at the city "
"market. They were paying with coins from their own country. There was "
"significantly less gold in the coins than there was supposed to be. The "
"coins turned out to be cut by nearly a quarter.\""
msgstr ""
"\"전하, 대거마크의 사기꾼들이 도시 시장에서 체포되었습니다. 이들은 자국의 통화로 물건을 계산하고 있었습니다. 그리고 그 돈은 원래 "
"있어야 할 만큼의 황금보다 훨씬 적은 양의 황금이 들어가 있었습니다. 이 동전에 들어간 황금은 원래 들어가야 할 양의 1/4에 가까웠던 "
"것으로 드러났습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0002_Text
#. Speaker : Jubilost_Companion
msgctxt "94349c70-66e5-4c95-93a5-0551f371dfcd"
msgid ""
"\"Your citizens are grateful to you, {name}. Thanks to you, their pockets "
"are filled. Strange that it's not me they're thanking. Now that you're a "
"true {mf|king|queen}, why don't we start producing coins with your face on "
"them?\""
msgstr ""
"\"시민들이 네게 감사하고 있어, {name}. 네 덕택에 자기들 주머니가 가득찼다고 말이야. 이상한 건 저들이 내게는 감사해하지 "
"않는다는 거지. 이제 진정한 {mf|왕|여왕} 으로서, 네 얼굴이 그려진 동전을 주조하는 건 어때?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0003_Text
#. Speaker : SadisticMage_Capital
msgctxt "55438c8b-c314-4635-82e3-08904a725976"
msgid ""
"\"Your Highness, I suppose that your contribution to the history of this "
"once-worthless land is so great that we must perpetuate it. At first, I was "
"thinking about a park, a statue and a couple of fountains, but that's too "
"visionary. Then another idea came into my head. Let's produce coins with "
"your face on them!\""
msgstr ""
"\"전하, 이 쓸모없던 땅의 역사에 기여하신 당신의 노고는 참으로 대단하며 이를 기념해야 합니다. 우선, 공원을 지어서 석상과 분수도 "
"세우려고 했지만 그건 너무 보여주기 식 같더군요. 그러다가 아이디어 하나가 떠올랐습니다. 전하의 얼굴이 새겨진 동전을 주조하는 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0009_Text
#. Speaker : MaegarVarn_Capital
msgctxt "8a0b0bee-72a1-45aa-937c-47ddd3c08ec0"
msgid ""
"\"It will be done. This day marks a new milestone in the history of the "
"kingdom!\""
msgstr "\"처리하겠습니다. 오늘 왕국의 역사에 새로운 장이 쓰여지는군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0010_Text
#. Speaker : Jubilost_Companion
msgctxt "deeda486-17eb-4970-8498-0e77f861199e"
msgid ""
"{n}Jubilost nods approvingly.{/n} \"Everything is already in motion. Your "
"decision was so obvious that it hadn't even occurred to me to delay the "
"preparations.\""
msgstr ""
"{n}주빌로스트는 찬성하며 고개를 끄덕인다.{/n} \"이미 모두 처리 중이야. 워낙 명백해 보이는 결정이어서 준비하느라 지체할 필요가 "
"없었지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0011_Text_String
#. Speaker : SadisticMage_Capital
msgctxt "d8cb7cce-8933-4c96-b87f-5a93bd4ac9eb"
msgid ""
"\"As I proposed?\" {n}Bartholomew catches your eye hopefully, but then loses "
"interest.{/n} \"I see. Simple coining. Without applying my wise and thrifty "
"advice. Not that you've ever paid attention.\""
msgstr ""
"\"제가 제안한 대로 말입니까?\" {n}바솔로뮤는 기대하며 당신과 눈을 마주쳤지만, 이내 흥미를 잃고말았다.{/n} \"알겠습니다. "
"단순한 동전주조군요. 절약을 하자는 제 현명한 조언은 적용하지 않으시는 거군요. 관심도 안 가지셨고요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0012_Text
#. Speaker : MaegarVarn_Capital
msgctxt "fa3860d1-6379-4bca-a655-b9709530b64a"
msgid "{n}Maegar shakes his head.{/n} \"Very well, as you please.\""
msgstr "{n}메이가르는 머리를 흔든다.{/n} \"좋습니다, 바라시는 대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0013_Text
#. Speaker : Jubilost_Companion
msgctxt "ecae5708-0877-4901-8aed-faa3242c1e27"
msgid ""
"{n}Jubilost takes off his glasses in astonishment and starts wiping the "
"lenses.{/n} \"Are you serious? Do you have a phobia or something? A magical "
"disease? I've never heard of anything like it. I'd love to know more, if you "
"don't mind. What about mirrors? Your reflection...\""
msgstr ""
"{n}주빌로스트는 놀라며 안경을 벗더니 안경 알을 닦기 시작한다.{/n} \"진심이야? 뭐 어디 공포증이라도 있어? 아니면 마법적 "
"질병이라든지? 이런 증세는 처음 보는데. 더 알고싶군, 너만 상관 없다면 말이야. 거울은 어때? 네 반사된 모습 말이야...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0014_Text
#. Speaker : SadisticMage_Capital
msgctxt "11c8eb1d-2a7f-4fb9-9068-f8a1a45f59c5"
msgid ""
"\"Indeed, we shouldn't be in such a hurry. There's always a better use for "
"money.\""
msgstr "\"물론 그렇게 서두르지 않아도 돼. 돈 쓰는 데엔 언제나 더 나은 방법이 있거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0016_Text
#. Speaker : Jubilost_Companion
msgctxt "050a7649-2832-4d39-be41-0715ba1215f8"
msgid ""
"\"For the record, this is the way for us to get our own currency at our "
"disposal, which will have a positive impact on the market due to "
"inflation... You're not listening to me, are you? I'll put it simply. "
"Producing coins does have a price, but it will pay off over time.\""
msgstr ""
"\"공식적으로, 우리가 마음대로 쓸 수 있는 돈을 만들어낼 방법이지. 인플레이션으로 통화 가치가 상승한 시장에 긍정적인 영향을 줄 수 "
"있을거야.... 내 말 안 듣고있군? 쉽게 설명하지. 돈을 만들어내는 데는 비용이 들지만, 시간이 지나면 이득을 얻을 수 있다는 말이었어."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0017_Text
#. Speaker : SadisticMage_Capital
msgctxt "b1ae7660-75e0-4cb4-b7ba-92a49d3134f5"
msgid ""
"\"Let every one of your subjects remember who to thank for the money they're "
"holding in their hands! You pulled these lands out of poverty! You deserve a "
"reward, don't you? For instance, one tenth of the gold from every coin, "
"which we will secretly replace with copper. This new currency won't pay off "
"right away, and we'll have a significant up-front cost. But don't worry, "
"nobody will notice our little trick.\""
msgstr ""
"\"자기 손에 들고있는 돈에 대해 누구에게 감사해야 할 지 온 백성이 기억하게 합시다! 당신은 이 땅을 가난으로부터 벗어나게 해줬어요! "
"보상을 받아야 함이 당연하지 않습니까? 예를 들어, 동전마다 1할의 황금을 구리로 채워넣는 식으로 말이죠. 바로 들키지도 않을 뿐더러, "
"엄청난 돈을 미리 얻게 될 겁니다. 하지만 걱정 마세요. 우리가 한 짓은 아무도 모를테니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0018_Text
#. Speaker : MaegarVarn_Capital
msgctxt "450a9581-3aaf-416f-85ac-0c03e979c791"
msgid ""
"\"It makes me wonder why we haven't already produced our own coins. One with "
"your face on it, for instance. It's the only way we can be assured that the "
"money of our subjects is intact. It will also send a message to our "
"neighbors that we're someone to reckon with. It will be some expense to set "
"this up, but it will pay off eventually.\""
msgstr ""
"\"왜 진작 우리만의 주화를 만들지 않았는 지 의문이 가는 군요. 전하의 얼굴이 새겨진 동전 말입니다. 우리 백성들의 돈이 합법적이라는 "
"사실을 확신시키기 위한 유일한 길입니다. 게다가 이웃들에게 우리가 무시못할 존재라는 것을 알리는 계기가 되기도 하겠지요. 이를 위해선 "
"비용이 좀 지출되겠지만, 결국엔 이득으로 돌아올 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0019_Text
#. Speaker : Jubilost_Companion
msgctxt "76508727-481e-4e02-8f9d-139515f22f8b"
msgid ""
"{n}Jubilost puts the glasses back on when he catches your expression, and "
"his mood darkens.{/n} \"Oh, I see. You're joking. Very funny. Ha. Ha. As if "
"you were so modest. All right, enough chit-chat, I've got things to do.\""
msgstr ""
"{n}주빌로스트는 당신의 표정을 보고는 안경을 다시 쓴다. 그리고 얼굴이 어두워진다.{/n} \"아, 알겠어. 농담이었군. 정말로 "
"재밌구만. 하. 하. 겸손도 하셔라. 좋아, 헛소리는 그만하지. 할 일이 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0023_Text
#. Speaker : MaegarVarn_Capital
msgctxt "701fffbd-323f-4694-9282-58b060ca19f6"
msgid ""
"\"It will be done. Congratulations, Your Highness. You have become a part of "
"history.\""
msgstr "\"곧 끝날 것입니다. 경하드리옵니다, 전하. 역사의 일원이 되셨습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0024_Text
#. Speaker : Jubilost_Companion
msgctxt "5e65b7c4-ea00-44cf-a79d-0f6ea8c92af4"
msgid ""
"\"I could abuse your trust and stamp out coins with my own face on them. But "
"why should I? My face already decorates several books which are more "
"valuable than any amount of gold!\""
msgstr ""
"\"네 신뢰를 악용해 내 얼굴이 그려진 동전을 주조할 수도 있지. 하지만 내가 그럴 이유는 없잖아? 내 얼굴은 이미 값으로는 따질 수 "
"없을 정도로 많은 책에 새겨져 있는데 말이지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0025_Text
#. Speaker : SadisticMage_Capital
msgctxt "123de6ff-fabc-4efc-9a16-b98b2ae6de14"
msgid ""
"{n}Bartholomew winks meaningfully.{/n} \"I'm on it, Your Highness. I shall "
"order everything that's required: the coin machine, gold, casts... as well "
"as a grindstone and tin snips.\""
msgstr ""
"{n}바솔로뮤는 의미심장하게 윙크했다.{/n} \"알겠습니다, 전하. 필요한 것을 전부 주문하죠. 주조 기계, 황금, 주형... 숫돌과 "
"주석으로 된 가위도요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0027_Text
#. Speaker : Kanerah_Companion
msgctxt "ca74c9ae-2f21-4e51-8464-9c4b822fb8a8"
msgid ""
"\"Your subjects already celebrate your wisdom and fairness. I think they "
"should also be reminded of your captivating beauty.\" {n}The girl smiles "
"coyly.{/n} \"It's high time to make everyone in your kingdom carry your "
"portrait with them... A profile minted in gold!\""
msgstr ""
"\"백성들은 이미 당신의 지혜와 공평함을 찬양하고 있어요. 제 생각엔 당신의 매혹적인 아름다움도 남겨둬야 할 거 같군요.\" {n}소녀는 "
"부끄러운 듯 미소짓는다.{/n} \"마침 왕국의 모든 사람들이 당신의 초상화를 들고다니기 딱 좋은 시기인 것 같네요... 황금으로 주조된 "
"당신의 얼굴을 말이죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0028_Text
#. Speaker : Kanerah_Companion
msgctxt "dae2938a-797c-4423-ad9a-6e991ba27fee"
msgid ""
"\"Our trade depends too much on the coins of others. Constant rate "
"fluctuations make our money changers rich, at the expense of everyone else. "
"Your country needs its own real currency!\""
msgstr ""
"\"우리 무역은 지나치게 타국의 주화에 의존하고 있습니다. 지속적인 환율 변동 때문에 환전가들을 제외하고 모두들 가난해져만 가고 "
"있습니다. 이 땅만의 돈이 필요한 시점입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0029_Text
#. Speaker : Kanerah_Companion
msgctxt "ddc03cf2-d14a-4be5-bf2d-03455c2130de"
msgid ""
"\"I have a plan that will make coins decorated with your noble profile far "
"more valuable than the gold they are made of. Soon after minting the coins, "
"we will announce that taxes can only be paid with these coins. Our merchants "
"will be falling over each other, snatching these new coins! What do you say?"
"\""
msgstr ""
"\"본디 지닌 황금보다 가치 있도록 당신의 고귀한 얼굴을 동전에 새겨야 합니다. 곧 동전 주조가 끝나면, 이 돈을 사용해야만 세금을 낼 "
"수 있다고 공표하겠습니다. 우리 상인들은 서로 앞다투어 이 새 주화를 가지려 다투겠지요! 어떻습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0031_Text
#. Speaker : Kanerah_Companion
msgctxt "2b0f9621-cef6-4df5-bdfe-2791c0c827c7"
msgid ""
"\"Thank you for your trust.. I will give the order to begin minting coins, "
"and prepare the announcement about new tax collection rules. You'll see – a "
"coin with your profile will soon be worth three times its weight in gold!\""
msgstr ""
"\"믿어주셔서 감사합니다. 동전을 주조하라 명령 내리고, 새로운 징세법에 대해 공표할 준비를 하겠습니다. 기대하십시오. 당신의 얼굴이 "
"그려진 동전은 같은 무게의 황금보다 3배는 더 가치있어질 테니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0032_Text
#. Speaker : Kanerah_Companion
msgctxt "7c17236f-f102-4570-a262-723597f7bbc2"
msgid ""
"{n}Kanerah grows gloomy.{/n} \"Well, what is best is often the enemy of what "
"is good. Even without my tax collection plan, our own coins would have been "
"beneficial for the economy, not to mention international prestige. In any "
"case, know this: in your caution, you're passing up a big profit.\""
msgstr ""
"{n}카네라는 점점 우울해졌다.{/n} \"최선의 적이 차선일 때도 있는 법이죠. 제 징세 계획이 없었더라도 우리가 만든 동전은 경제에 "
"도움이 많이 되었을 거예요. 국제적 명망은 차치하고서라도요. 어쨌든, 이건 알아두세요. 노파심 때문에 당신은 큰 이윤을 놓치고 있으니까요."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Economy/Rank9/Cue_0033_Text_String
#. Speaker : Kanerah_Companion
msgctxt "29e3f62e-4a03-4acb-9767-f04652ea32bc"
msgid ""
"\"You have a strange notion of thrift. I suggested minting our own coins "
"because at present your treasury is taking in much less than it could.\""
msgstr ""
"\"절약에 대해 잘못 이해하시는 거 같군요. 제가 우리 동전을 주조하자고 한 이유는 현재 우리 국고에 들어올 수 있는 돈 보다 훨씬 적은 "
"양의 돈이 들어와서예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Merc/Cue_0001_Text
msgctxt "5ab717d0-dae4-477d-aad9-1f5d1d91d853"
msgid ""
"{n}Your advisor has arrived to report about the recent Espionage "
"developments in your {mf|barony|barony|kingdom|kingdom}.{/n}"
msgstr "{n}당신의 보좌관이 최근의 {mf|남작령|남작령|왕국|왕국}의 첩보 발전에 대해 논의하기 위해 방문했습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Answer_0020_Text
msgctxt "a50b3aef-8926-417a-b30e-5c8db37f8a8c"
msgid ""
"{g|Espionage10_1}[Choice effects]{/g} \"It's not even a question. Spies can "
"do the most good for the army.\""
msgstr "{g|Espionage10_1}[선택 시 효과]{/g} \"이건 질문이 아니다. 첩자는 군에 많은 도움이 될 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Answer_0021_Text
msgctxt "c8e9d1f1-b87b-4c0d-944b-bbabd96ce350"
msgid ""
"{g|Espionage10_2}[Choice effects]{/g} \"Spies in embassies and consulates "
"bring in the most valuable information.\""
msgstr ""
"{g|Espionage10_2}[선택 시 효과]{/g} \"대사관과 영사관에 첩자를 심으라. 값진 정보를 많이 가져올 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Answer_0022_Text
msgctxt "05130b7c-4980-4b7f-bf9e-001074a8b55f"
msgid ""
"{g|Espionage10_3}[Choice effects]{/g} \"I want spies placed in the guilds "
"and magic schools.\""
msgstr "{g|Espionage10_3}[선택 시 효과]{/g} \"길드와 마법 학교에 첩자를 배치하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Answer_0024_Text
msgctxt "f2c4a1ef-6d1b-473a-a9a5-0591b3bb5a89"
msgid "\"You're the spymaster. It's up to you.\""
msgstr "\"그대가 첩보대신이니, 그대가 결정하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "f5c89a19-ccc8-4a9c-ae9d-f69db31f9ac6"
msgid ""
"\"We've done well. We have loyal eyes and ears everywhere. We need not fear "
"spies or conspiracies. Your domain is well protected against all manner of "
"quiet threats.\""
msgstr ""
"\"아주 잘 끝났다. 궁성을 위한 눈과 귀가 온 사방에 깔렸다. 첩자나 음모에 대해서 더 이상 걱정할 필요가 없어. 너의 땅은 온갖 "
"음모로부터 안전할 거다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0002_Text
#. Speaker : Ekun_Companion
msgctxt "7d3bc47d-198c-47f8-938b-8ce5879b6292"
msgid ""
"\"I have recalled our best people to the capital. They will pass on what "
"they've learned about our enemies, and instruct the guards on how to trace "
"conspiracy. Their experience in intimidation and command authority will come "
"in handy.\""
msgstr ""
"\"최고의 첩자들을 수도로 복귀시켰다. 이들이 적으로부터 얻은 정보를 알려줄 것이고, 경비대에게 음모를 추적하는 법을 가르칠 거다. "
"저들의 협박과 지휘 능력은 요긴하게 쓰이겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0003_Text
#. Speaker : Ekun_Companion
msgctxt "d42eb045-8418-41c2-954b-b309923b1d7a"
msgid ""
"\"I have recalled our best people to the capital. They're crafty and sly – "
"slippery as eels – and they've learned much from their dealings with our "
"enemies. Make them your ambassadors now. A good spy makes a good politician."
"\""
msgstr ""
"\"최고의 첩자들을 수도로 복귀시켰다. 이들은 영민하고 미꾸라지처럼 교활하다. 게다가 적을 대하는 방법에도 능통하지. 이들을 너의 사절로 "
"만들어라. 좋은 첩자는 좋은 정치가를 만든다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0004_Text
#. Speaker : Ekun_Companion
msgctxt "57d0f604-3999-4e72-965d-fe49816bf1c7"
msgid ""
"\"Speaking of enemies, our strike hit its target. The Assassins Guild is "
"licking their wounds. Meanwhile, we're seizing their power.\""
msgstr "\"적에게 우리의 공격이 명중했다. 암살자 길드는 상처를 손보고 있다. 그동안, 우리는 놈들의 권력을 탈취했다 .\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0005_Text
#. Speaker : Ekun_Companion
msgctxt "f5b1f236-2345-44d9-b792-d872c6835475"
msgid ""
"\"Speaking of enemies, our strike hit its target. The Poisoners Guild has "
"gone underground, leaving us to seize their riches.\""
msgstr "\"적에게 우리의 공격이 명중했다. 독술사 길드는 지하로 숨었고. 저들의 재산은 우리가 가로챘다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0006_Text
#. Speaker : Ekun_Companion
msgctxt "c6630ad0-42f4-4c55-8969-0606d652a8c3"
msgid ""
"\"The attacked Guild had spies in every corner. They need a new master. We "
"have the chance to become that master. But where do we want our spies?\""
msgstr ""
"\"공격받은 길드는 모든 곳에 첨자를 심어 두었다. 저들에게 새로운 대장이 필요하다. 우리가 그 대장이 될 수 있고. 하지만 첩자들을 "
"어디에 배치하지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0007_Text
#. Speaker : Jubilost_Companion
msgctxt "53bb3283-27b3-4be2-a650-afdc748768b1"
msgid ""
"\"You know, {name}, our spies finally seem to be everywhere. It's a most "
"unusual experience. Sometimes I feel like a new god. I see everyone! I hear "
"everything!\""
msgstr ""
"\"{name}, 우리 첩자들이 방방곡곡에 퍼져있어. 참으로 이례적인 상황이야. 가끔은 신이 된 기분이 든다니까. 모든 것을 들을 수 "
"있고 모든 사람을 볼 수 있다니!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0008_Text
#. Speaker : Jaethal_Companion
msgctxt "7bec10e4-a01f-4e76-a6a9-19d7c8cd7de4"
msgid ""
"\"{name}, we received news from Daggermark. We are victorious. I think "
"congratulations are in order. You have an eye in every corner. All secrets "
"of the living and the dead are ours.\""
msgstr ""
"\"{name}, 대거마크로부터 새로운 소식을 받았어. 우리가 성공했어. 제대로 축하를 해야할 거 같아. 방방곡곡에 우리 첩자들이 "
"깔려있어. 모든 사람들의 살고 죽는 소식이 이제 우리 손아귀에 들어온 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0009_Text
#. Speaker : Jubilost_Companion
msgctxt "fc8e6a4e-ff51-4e66-ab85-f7c2b374e2ff"
msgid ""
"\"I summoned several of our agents back to the capital. They will share with "
"the guards the expertise they gained in the ruthless struggle against the "
"enemy. This will be good for... let's call it 'conspiracy prevention'.\""
msgstr ""
"\"우리 요원들 몇 명을 수도로 다시 소환했습니다. 적들과 있었던 자비없는 혈투로 얻은 경험들을 경비대와 공유할 것입니다. 이거... "
"'모략 방지' 에 좋다고 해둡시다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0010_Text
#. Speaker : Jubilost_Companion
msgctxt "6e343b60-1da5-4c42-bef3-5aa351c165c9"
msgid ""
"\"I summoned several agents back to the capital. They will enlighten our "
"ambassadors in intrigue and the art of deception. This expertise will come "
"in handy in their games of politics.\""
msgstr ""
"\"우리 요원들 몇 명을 수도로 다시 소환했습니다. 우리 대사들에게 기만술과 모략을 가르칠 겁니다. 이 지식은 대사들의 정치 싸움에서 "
"유용하게 쓰일 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0011_Text
#. Speaker : Jubilost_Companion
msgctxt "0bf0e25d-a456-4420-951b-9e62b6b2fc89"
msgid ""
"\"By the way, do you remember the Daggermark Guild that tried to throw sand "
"in our gears? Our response has the weasels running scared. The Assassins "
"Guild still exists, but it's far less powerful now. Indeed, they're "
"struggling to fight for what little they have left.\""
msgstr ""
"\"그건 그렇고, 우릴 방해하려던 대거마크의 길드 기억하십니까? 그 족제비들이 겁에 질린 모양입니다. 암살자 길드는 아직 잔존해있지만, "
"예전보다 훨씬 힘이 떨어진 모양이더군요. 물론 얼마 안 되는 남은 것이나마 건지려고 분투하고 있지만 말이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0012_Text
#. Speaker : Jubilost_Companion
msgctxt "048e2dfb-0644-4de5-a28f-466eec9e1a09"
msgid ""
"\"By the way, do you remember the Daggermark Guild that tried to throw sand "
"in our gears? Our response has the weasels running scared. The Poisoners "
"Guild is acting like everything is fine, but the victors are raking off "
"their belongings.\""
msgstr ""
"\"그건 그렇고, 우릴 방해하려던 대거마크의 길드 기억하십니까? 그 족제비들이 겁에 질린 모양입니다. 독술사 길드는 다 괜찮은 것 처럼 "
"행동하지만 승자들이 저들의 남은 것들을 다 갉아먹고 있는 중입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0013_Text
#. Speaker : Jubilost_Companion
msgctxt "7ed112e8-37c2-43bb-9669-8393c0c94400"
msgid ""
"\"We want our piece of the pie too, of course! I'm looking forward to "
"getting my hands on the agents who are ready to trade masters. But it's up "
"to you to decide where we should send our new infiltrators.\""
msgstr ""
"\"우리도 물론 한 몫 거들어야 합니다! 정말이지 요원들을 보낼 생각에 기대가 되는 군요. 하지만 첩자를 보낼지 말지는 당신이 결정하셔야 "
"합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0014_Text
#. Speaker : Jaethal_Companion
msgctxt "75fba449-437f-4fc0-a8c3-a234de51688b"
msgid ""
"\"I summoned several agents to the capital. The guards could use their "
"experience in their ruthless struggle against the enemy.\""
msgstr "\"수도에 요원들을 몇 명 소환했습니다. 자비없는 적들과의 혈투로 얻은 경험을 경비대가 공유받을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0015_Text
#. Speaker : Jaethal_Companion
msgctxt "83f69426-9b3c-4b04-be55-93496319b90d"
msgid ""
"\"I summoned several of our agents back to the capital. Our diplomats can "
"make good use of their experience in intrigue and deception.\""
msgstr "\"수도에 요원들을 몇 명 불러들였습니다. 우리 외교관들이 이 첩자들의 모략과 기만술을 잘 써먹을 수 있을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0016_Text
#. Speaker : Jaethal_Companion
msgctxt "6418d081-e105-415d-a4a3-13bc83415e72"
msgid ""
"\"If you're wondering about our old enemy's fate, don't worry, they're no "
"longer a threat. The Assassins Guild suffered a severe blow. For now they "
"are preoccupied mainly with their own survival. The vultures have already "
"begun to tear apart their possessions.\""
msgstr ""
"\"옛 적들이 어떻게 되었는 지 궁금하시다면, 걱정하지 마십시오. 놈들은 더 이상 위협거리가 되지 못 하니까요. 암살자 길드는 치명상을 "
"입었습니다. 지금은 살아남는 데 정신이 팔려있어야 할 겁니다. 독수리들이 이미 놈들의 재산을 갈기갈기 찢어먹고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0017_Text
#. Speaker : Jaethal_Companion
msgctxt "34605022-35fc-4481-86c1-c96ebfb77012"
msgid ""
"\"If you're wondering about our old enemy's fate, don't worry, they're no "
"longer a threat. The Poisoners Guild poisoned themselves. They're "
"desperately struggling to stay afloat. Everyone is clawing at their pile of "
"riches, and they can scarcely keep an eye on us.\""
msgstr ""
"\"우리 옛 적들이 어떻게 되었는 지 궁금하시다면, 걱정하지 마십시오. 놈들은 더 이상 위협거리가 되지 못 하니까요. 독술사 길드는 "
"스스로 중독된 꼴이 되었습니다. 절박하게 살아남으려 발버둥 치더군요. 모두들 놈들이 가지고 있던 재산을 뜯어먹느라 정신이 없으며, 우리 "
"쪽으로는 눈길도 거의 주지 않고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0018_Text
#. Speaker : Jaethal_Companion
msgctxt "e456e7c3-b71d-48c4-a68c-3e328daffda5"
msgid ""
"\"We should claim our prize as well. The Guild had many spies with a variety "
"of skills and areas of expertise. Many of them would surely love to trade "
"masters in these stormy times. But where could we put the new people to "
"greatest use?\""
msgstr ""
"\"우리도 한 몫 챙겨야 합니다. 독술사 길드엔 다양한 분야에 경험많은 수많은 첩자들이 포진해있었습니다. 상당수는 이 어려운 때에 분명 "
"자기 주인을 파는 놈들도 있겠지요. 하지만 이렇게 배은망덕한 놈들을 써봤자 어디에 쓰겠습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0025_Text
#. Speaker : Ekun_Companion
msgctxt "a13a8a88-3224-4ef4-a598-ca64918b51e1"
msgid ""
"\"It will be good to have ears in the armies of our enemies. It will be done."
"\""
msgstr "\"적국의 군대에 귀가 있다면 좋을거다. 그렇게 하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0026_Text
#. Speaker : Jubilost_Companion
msgctxt "df546663-f0a4-44b0-958f-a6fb7baf5318"
msgid "\"Hmm. This sounds reasonable. I'll make a few inquiries.\""
msgstr "\"흠. 합리적이군요. 몇 가지 질문이 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0027_Text
#. Speaker : Jaethal_Companion
msgctxt "b33fe62b-2d29-444f-a456-a12ec39581b0"
msgid "\"Knowing about one's enemies makes killing them that much easier.\""
msgstr "\"적을 알면 쉽게 이길 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0028_Text
#. Speaker : Ekun_Companion
msgctxt "20810579-d9b8-4620-b872-8720836e9a04"
msgid ""
"\"All right. We'll learn what is being discussed in our neighbors' palaces.\""
msgstr "\"좋다. 우리 이웃의 궁전에서 무엇을 논의하는지 알 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0029_Text
#. Speaker : Jubilost_Companion
msgctxt "7f5ca6ff-cb07-4949-976d-0cd3e060a57f"
msgid ""
"\"Diplomats are spies with public credentials. The secrets of neighboring "
"monarchs are more valuable than their crowns.\""
msgstr "\"외교관은 공인된 신분을 가진 정보원입니다. 이웃 군주들의 비밀은 왕관보다 더 귀중하죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0030_Text
#. Speaker : Jaethal_Companion
msgctxt "41484f4f-5bf9-4f31-8fa1-5bfb7aa6e84f"
msgid ""
"\"Sometimes I doubt whether the art of diplomacy even exists. Perhaps it's "
"all just lies and daggers.\""
msgstr "\"가끔은 외교술이라는 게 정녕 존재하는 지 궁금하군요. 어쩌면 그냥 전부 거짓말과 칼질뿐인 걸지도요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0031_Text
#. Speaker : Ekun_Companion
msgctxt "e2a46497-d05a-4d7c-a411-505781c897b0"
msgid ""
"{n}Ekun takes a pause to think and then nods.{/n} \"You know that I don't "
"always trust magic. But poisons and daggers cannot be our only tools.\""
msgstr ""
"{n}에쿤다요는 잠시 생각을 하다가 고개를 끄덕인다.{/n} \"나는 마법을 항상 신뢰하지는 않는다. 하지만 독과 단검만이 해결책은 "
"아니지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0032_Text
#. Speaker : Jubilost_Companion
msgctxt "d53d2736-95de-4f6c-aac5-3a724eecdd2f"
msgid ""
"\"I believe that magic is the future of espionage. This is a wise decision.\""
msgstr "\"마법은 첩보의 미래입니다. 현명한 결정이군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0033_Text
#. Speaker : Jaethal_Companion
msgctxt "93ab6b15-dc85-42ec-8c35-07db426e2e37"
msgid ""
"\"Mystical secrets are more valuable than military plans or political "
"intrigue. Mortal life is short. Magic is eternal.\""
msgstr "\"신비한 비밀은 군사 계획이나 정치 공작보다 더 가치있습니다. 필멸자의 삶은 짧지만 마법은 영원합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0034_Text
#. Speaker : Ekun_Companion
msgctxt "c13d1a1e-549b-4fbd-9310-01a434b25d83"
msgid ""
"\"Speaking of enemies... The Daggermark guild accepted our offer of union. "
"The strike on their rival was unexpected and successful. We get to share the "
"prizes with our new ally.\""
msgstr ""
"\"적들 말인데... 대거마크의 길드가 우리의 연합 제안을 받아들였습니다. 저들의 경젱자를 향한 공격은 아무도 예상하지 못했으며 "
"성공적이었습니다. 우리의 새로운 동맹과 보상을 나눠야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0035_Text
#. Speaker : Jubilost_Companion
msgctxt "509284f9-7440-4f30-8a83-0e47115b21c1"
msgid ""
"\"By the way, do you recall when that Daggermark guild tried to throw sand "
"in our gears? Our response encouraged the weasels to change their plans and "
"organize a strike against their rival! Of course, the poor sods didn't "
"expect anything of the sort, so now they're licking their wounds, and their "
"enemies are raking off their belongings.\""
msgstr ""
"\"그건 그렇고, 우리를 훼방놓으려던 대거마크의 길드 기억하십니까? 우리가 보낸 대답이 그 족제비들의 마음을 돌려놓고 계획을 바꿔 "
"경쟁자를 공격하게 만들었다고 합니다! 물론, 그 불쌍한 버러지들은 이런 걸 예상하지도 못 했겟지요. 그래서 지금 상처를 손보고 있습니다. "
"그리고 적들이 놈들을 갈기갈기 물어뜯고 있지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank10/Cue_0036_Text
#. Speaker : Jaethal_Companion
msgctxt "73059cd8-f787-4949-832d-fb473ef4f775"
msgid ""
"\"If you're wondering about our old enemy's fate, then worry not — they're "
"our friends now. After our united strike on their rivals, those old grudges "
"are forgotten — everyone's clawing at the pile of trophies from this "
"unexpected operation while the wounded guild is acting like everything's "
"normal — though it can scarcely stay afloat.\""
msgstr ""
"\"옛 적들이 어떻게 되었는 지 궁금하시다면, 걱정하지 마십시오. 이제 우리의 친구가 되었으니까요. 경쟁자를 향한 우리의 합동 공격으로 "
"서로간의 오랜 앙금도 해결했습니다. 우리들 모두 이 예상치 못 했던 작전에 대한 보상을 갈퀴로 긁어대고 있습니다. 놈들은 정상인 것 처럼 "
"행동하지만 간신히 목숨줄만 붙여놓고 있는 상태입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Answer_0008_Text
msgctxt "16a6f264-6b90-4441-b8ee-dc4985ce425f"
msgid ""
"{g|Espionage2_1}[Choice effects]{/g} \"Let the guards watch those who "
"arrived by the caravan.\""
msgstr "{g|Espionage2_1}[선택 시 효과]{/g} \"경비원들에게 캐러밴과 함께 도착한 사람들을 감시하라고 하십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Answer_0009_Text
msgctxt "042a54cf-b21e-48cc-b177-780e528278ae"
msgid ""
"{g|Espionage2_2}[Choice effects]{/g} \"Tell the merchants that if they fail "
"to hand over the stranger, we'll seize their gold and goods.\""
msgstr ""
"{g|Espionage2_2}[선택 시 효과]{/g} \"상인들에게 이방인을 넘겨주지 않으면 돈과 물품을 압류할 것이라고 전하시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Answer_0010_Text
msgctxt "3b36cda0-015f-4348-9e0b-0c4d5cfa1d4f"
msgid ""
"{g|Espionage2_3}[Choice effects]{/g} \"Put all the merchants on the rack.\""
msgstr "{g|Espionage2_3}[선택 시 효과]{/g} \"모든 상인들을 고문대에 올려라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Answer_0020_Text
msgctxt "33bbe335-fb5a-4d04-b5a5-c9f2fdc9de7c"
msgid "\"Who, in your opinion, sent the spy?\""
msgstr "\"그대 생각엔 누가 첩자를 보냈을 거 같나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Answer_0024_Text
msgctxt "19c1fe68-b31e-4dd9-9dee-2ad6332c11f9"
msgid "\"I trust your opinion.\""
msgstr "\"네 의견을 믿겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "58af3084-25ba-4003-82f1-669afa637c88"
msgid ""
"\"{name}, these lands are like a forest. Everyone is hungry, and all keep "
"constant watch on their predators and their prey. What you need is ears – by "
"which I mean spies. We don't have any yet, but others do. They're planting "
"them among us. I must stay in the shadows, so I can catch them. Don't tell "
"anybody I'm your head of espionage. Simply tell them I'm a minister. Keep it "
"simple.\""
msgstr ""
"\"{name}, 이 땅은 숲과 같아. 모두들 굶주려서 자기들 먹잇감이나 자기를 잡아먹는 존재를 지켜보고있지. 지금 필요한 건 귀야. 좀 "
"더 직설적으로 말하면 첩자 말이지. 지금 우리에겐 첩자가 없지만 다른 나라들은 가지고있어. 우리들에게 세작을 심어두고 있다는 말이야. "
"어둠 속에 있어야 그 놈들을 잡을 수 있어. 내가 네 첩보장이라는 건 아무에게도 말하면 안 돼. 그냥 날 장관이라고 소개하면 될 거야. "
"간단하게 가자고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0002_Text
#. Speaker : Ekun_Companion
msgctxt "f19c08c6-11de-44a4-8ade-881e5d901a2e"
msgid ""
"\"A crowded caravan has arrived, the kind that often carries illegal goods. "
"The guards searched the caravan and found a stash, but it didn't have "
"potions or artifacts. It contained spying equipment. It's unclear who the "
"spy is, but he's clearly experienced. He had fine tools.\""
msgstr ""
"\"불법 상품을 자주 운반하는 혼잡한 캐러밴이 도착했어. 경비원들이 캐러밴을 수색해 재고를 발견했지만 물약이나 아티팩트는 없었지. 대신 "
"첩자용 물품이 있더군. 누가 첩자인 지는 몰라도, 좋은 도구를 가지고 있던 걸 보니 경험이 풍부해보여.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0003_Text
#. Speaker : Jubilost_Companion
msgctxt "6f884afa-53f4-49c1-ae2b-69e8e193fac6"
msgid ""
"\"{name}, surely you realize that once you enter into intrigue, you will "
"attract very close attention. All our neighbors are wondering who we are and "
"how we can be used. And since we're but a quail among hawks, it's essential "
"to be very careful. This is why I'm asking you to keep my doings secret. "
"Introduce me as a minister. Simply a minister.\""
msgstr ""
"\"{name}, 음모의 세계에 발 들이게 된다면, 분명 주의를 끌게 될 거야. 모든 우리 이웃들이 우리가 누구고 우리를 어떻게 "
"이용해야할 지 머리를 굴려대고 있어. 우린 아직 어른 앞의 애 정도야. 굉장히 조심해야 해. 내가 하는 일들을 비밀로 해달라는 이유가 "
"바로 이거야. 날 그냥 장관으로 소개 해줘. 그냥 장관이면 돼.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0004_Text
#. Speaker : Jaethal_Companion
msgctxt "e7dcb3ec-286d-469f-a7da-c6926d064bb8"
msgid ""
"\"{name}, do you know why I find the company of the short-living very "
"annoying? They're in such a hurry to do as many things as they can, that "
"they cause utter chaos. Back in {g|Kyonin}Kyonin{/g}, intrigues are very "
"carefully devised. They're intended to last dozens of years. The plots were "
"elegant and lies exquisite.\""
msgstr ""
"\"{name}, 내가 왜 수명 짧은 놈들을 짜증난다고 생각하는 지 알아? 최대한 많은 일을 하려고 서두르다가 혼돈 속에 빠져버리거든. "
"{g|Kyonin}쿄닌{/g}에선 음모란 굉장히 조심스럽게 이루어지는 일이었어. 몇 십 년을 와신상담하곤 했지. 그곳에서의 음모는 "
"우아하고 거짓말은 정교했었지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0005_Text
#. Speaker : Jubilost_Companion
msgctxt "587c2b77-0300-48eb-83b6-7f042a621b0c"
msgid ""
"\"I wouldn't be surprised to find actual ears on your palace's walls. Ask me "
"what we found in the merchant's caravan if you don't believe me. A guard "
"discovered a stash for smuggled goods – and a spy's gear was inside. It "
"included very curious mathematical ciphers from {g|Ustalav}Ustalav{/g}. I "
"must admit, they are very elegant.\""
msgstr ""
"\"궁성 벽에서 진짜 사람 귀가 튀어나와도 놀라지 않을 자신이 생기는 군. 상인의 상단에서 뭘 찾아냈는 지 봐. 경비대가 숨겨놓은 "
"밀수품을 발견했어. 그 밀수품은 첩자용 물품이었고. 거기엔 {g|Ustalav}우스탈라브{/g} 에서 온 굉장히 독특한 숫자 암호가 "
"있었어. 인정해야 할 거 같네. 저들은 굉장히 우아해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0006_Text
#. Speaker : Jaethal_Companion
msgctxt "ab127faa-a8c3-450a-994a-6ba5218b3a60"
msgid ""
"\"Things are done differently here. For starters, spymasters publicly "
"identify themselves as agents of espionage, all-seeing visionaries... They "
"might as well paint a target on their foreheads. It's not a mistake I would "
"like to make. For your subjects, I shall simply be a minister. You've come "
"to power only recently, and the city is already full of murderers and spies. "
"A guard recently found a stash while inspecting a trade caravan. It didn't "
"contain any smuggled goods except some spying equipment and a few deadly "
"toys. We could identify neither where the package came from, nor to whom it "
"was going. But if you don't want such tools put to use, you must figure out "
"who the spy is.\""
msgstr ""
"\"여기선 일이 좀 색다르게 돌아갔어. 우선 첩보대장들이 스스로를 첩보대신의 요원이라고 밝히더군... 차라리 이마에 날 쏴줍쇼 하고 "
"과녁을 그리라지. 이런 실수는 안 했으면 해. 그리고 백성들에게 있어 난 그냥 단순한 장관이 될 거야. 네가 집권한지 얼마 안 된 "
"상태라, 도시가 이미 살인마와 첩자로 가득하거든. 경비대가 최근에 무역 대상을 수색하던 도중 숨겨놓은 물건을 발견했어. 밀수품은 없었지만 "
"첩자용 장비와 치명적으로 보이는 장난감 몇 개가 보였지. 이 물건이 어디서 왔는지, 그리고 누구에게 전달되는 물건인지 둘 다 알 수 "
"없었어. 이런 도구가 사용되는 일이 없으려면 누가 첩자인 지 밝혀내야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0011_Text
#. Speaker : Ekun_Companion
msgctxt "31b971a0-55dc-4627-9f34-2d89a200ed0e"
msgid ""
"{n}Ekun nods.{/n} \"I'll order the guards to keep an eye on the merchants.\""
msgstr "{n}에쿤은 고개를 끄덕였다.{/n} \"'경비원들에게 상인을 눈여겨보라고 명령하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0012_Text
#. Speaker : Jubilost_Companion
msgctxt "0a70b3d1-a85d-4b88-9670-bf700d22ba71"
msgid ""
"\"Phew!\" {n}Jubilost raises his eyebrow and puts hands on his hips.{/n} "
"\"The solution of someone who loves potboilers! A true spy is a "
"professional! Our people are only amateurs.\""
msgstr ""
"\"휴!\" {n}주빌로스트는 눈에 쌍심지를 켜더니 손을 허리에 가져다댔다.{/n} \"돈에 환장한 놈이 내놓을만한 해결책이로구만! 진짜 "
"첩자에겐 전문성이 있어야지! 우리 첩자들은 아마추어일 뿐이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0013_Text
#. Speaker : Jaethal_Companion
msgctxt "2c13d2f1-0560-41cd-9c16-84f7fdb20a4f"
msgid ""
"{n}Jaethal looks focused, her voice is as quiet as wind's whisper in the "
"night.{/n} \"I hope those fools don't give away the game. It would be safer "
"to arrest everyone involved.\""
msgstr ""
"{n}제이탈은 집중한 듯 보인다. 그녀의 목소리는 조용한 밤바람처럼 고요하다.{/n} \"저 멍청한 놈들이 포기하지 않았으면 좋겠군. "
"관련된 모든 놈들을 체포하는 게 안전할 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0014_Text
#. Speaker : Ekun_Companion
msgctxt "7e8167b2-37f2-4872-925f-30aad137c03c"
msgid ""
"{n}Ekun replies after a pause:{/n} \"I'd rather it was I who was doing the "
"hunting. But it's good to give the merchants a reason to cooperate. They do "
"love their gold.\""
msgstr ""
"{n}에쿤은 잠시 멈춘 후 대답한다.{/n} \"내가 사냥하는 입장이었으면 좋았을 텐데. 하지만 상인들에게도 협력할만한 계기를 만들어주는 "
"것도 좋겠지. 돈을 좋아하니 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0015_Text
#. Speaker : Jubilost_Companion
msgctxt "0b9f9d1b-7f71-45b1-ba68-4d64e1dc00e3"
msgid ""
"\"Perfect. The merchants would rather hand over their own mothers than lose "
"their goods. They traveled a long way here, so they got to know their fellow "
"travelers. They'd recognize a stranger in an instant.\""
msgstr ""
"\"완벽하군요. 상인들은 돈이라면 제 어미도 팔 놈들입니다. 여기까지 먼 길을 왔으니 같이 온 여행자들에 대해서 알고있겠지요. 이방인을 "
"즉시 알아볼 수 있을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0016_Text
#. Speaker : Jaethal_Companion
msgctxt "78380cd7-3ba5-4e6b-b610-ab3ed9bfed59"
msgid ""
"{n}Jaethal loses interest.{/n} \"We've practically caught an enemy spy, and "
"now you entrust the final hunt not to me, but to some smuggler merchants? "
"What a waste of time...\""
msgstr ""
"{n}제이탈은 흥미를 잃는다.{/n} \"적의 첩자를 거의 붙잡았는데, 그 마지막 사냥을 내가 아닌 밀수업자 상인들에게 맡기겠다고? "
"참으로 시간 낭비로군...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0017_Text
#. Speaker : Ekun_Companion
msgctxt "ad5dbae9-b65a-4528-8e57-75fddeddc033"
msgid ""
"{n}Ekun shakes his head.{/n} \"This isn't fair. It's not the others' fault. "
"Tormenting them is wrong.\""
msgstr "{n}에쿤은 머리를 절래절래 흔든다.{/n} \"불공평하다. 이건 그들의 잘못이 아니다. 그들을 괴롭히는 건 잘못된 일이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0018_Text
#. Speaker : Jubilost_Companion
msgctxt "53e4e6f3-7851-4d35-8ad4-558d40d8a1d4"
msgid ""
"{n}Jubilost opens his mouth to object, but then changes his mind, nods, and "
"frowns.{/n} \"Well, it's rough, it's tough, it's something an amateur would "
"do, but it's nevertheless efficient. Like a hammer to the head.\""
msgstr ""
"{n}주빌로스트는 입을 열더니, 이내 마음을 바꾸고는 끄덕이며 얼굴을 찡그렸다.{/n} \"이거, 참으로 거칠군. 참으로 거칠어. "
"아마추어나 할 짓이야. 하지만 어쨌든 효과적이긴 하군. 한 방 먹었구만.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0019_Text
#. Speaker : Jaethal_Companion
msgctxt "22945702-3634-4aa5-a464-cca433c22330"
msgid ""
"\"I'll teach them some new ways to feel pain. Only the truth will ease their "
"bodily suffering.\""
msgstr "\"새로운 고통의 세계를 열어주지. 진실만이 고통에서 벗어나게 할 뿐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0021_Text
#. Speaker : Ekun_Companion
msgctxt "96f3420a-cd63-4667-9c93-4061ab0ec189"
msgid ""
"{n}The ranger shrugs.{/n} \"An enemy. A neighbor. An inquisitive mind. We "
"haven't picked up the trail yet. We must keep looking.\""
msgstr ""
"{n}레인저는 으쓱한다.{/n} \"적이든, 이웃이든, 호기심 많은 사람이든 아직 누구의 흔적도 찾지 못했습니다. 계속 지켜 봐야지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0022_Text
#. Speaker : Jubilost_Companion
msgctxt "d8ef1441-2033-4ed3-848e-d89bf7b9aeba"
msgid ""
"\"I think of it as everyone at once. All countries are tied together by a "
"chain of intrigue. Some would send their agents because they're scared. "
"Others would send them because someone else did. The third one sends spies "
"to watch the other two. Everything is interconnected.\" {n}Jubilost notices "
"your facial expression and sighs.{/n} \"We don't know who sent him yet.\""
msgstr ""
"\"의심되는 곳이 너무 많군. 모든 국가들이 계략의 사슬에 묶여있어. 어떤 이들은 겁에 질려서 첩자를 보내지. 어떤 이들은 남들이 보내서 "
"자기도 보내는 것이고. 세 명이 있으면 한 명이 두 명을 감시하기 위해 첩자를 보내는 법이야. 모든 것은 서로 연관되어 있지.\" {n}"
"주빌로스트는 당신의 표정을 보고는 한숨 쉰다.{/n} \"아직 누가 우리에게 첩자를 보낸 지는 몰라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0023_Text
#. Speaker : Jaethal_Companion
msgctxt "0521b5a3-0a2d-483b-9efc-633b693ff1e4"
msgid ""
"{n}Jaethal's smile is predatory.{/n} \"I wonder, too. The name we receive "
"under torture will be real. The others will be fake, just to trick us. So "
"far, all I can say is that it could be any of our neighbors.\""
msgstr ""
"{n}제이탈은 포식동물처럼 미소짓는다.{/n} \"나도 궁금하군. 고문으로 이름을 알아내야겠지. 다른 대답은 우릴 속이려는 것일 테고. "
"일단 내가 말할 수 있는 건 누구든 될 수 있다는 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0025_Text
#. Speaker : Jaethal_Companion
msgctxt "88dcf305-8263-4f95-aa97-dea48f915022"
msgid ""
"\"I could order the merchants to look for a stranger among their servants. "
"But I don't trust money-bags traders. I'd rather charge my people with "
"watching the merchants. Then again, why look for clues when the best proof "
"is evidence by confession? If you bring me the merchants for a couple of "
"hours, the problem will be solved! The rack will make the spy sing like a "
"bird.\""
msgstr ""
"\"상인들을 시켜서 하인 중에 수상한 자가 있는 지 찾아보게 해줄 수 있어. 하지만 돈에 미친 놈들을 너무 믿지는 말라고. 나라면 내 "
"사람을 고용해서 상인들을 감시할 거야. 그건 그렇고, 고백이라는 최고의 증거물이 있는데 왜 단서를 찾는 거야? 내게 몇 시간만 상인들을 "
"빌려주면 문제가 해결될 텐데 말이지! 고문만 있으면 꾀꼬리처럼 모든 걸 불어댈 거란 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0026_Text
#. Speaker : Jubilost_Companion
msgctxt "0112e59a-bee7-44b4-aeab-23c25cb9bf94"
msgid ""
"\"We failed to identify the owner of the package. But judging from its "
"contents, this specialist is dangerous. Our people are helpless against him. "
"They can't even catch their finger before it finds its way up their noses! "
"Trying to track down a spy is out of the question. But you can't torture all "
"the caravan's members – the merchants wouldn't approve of it. So we must "
"tread lightly. We should threaten to confiscate their goods and kick them "
"out. Trust me, they'll give us their information in no time.\""
msgstr ""
"\"물품의 주인을 알아내는 데 실패했다. 그 내용물을 보건대, 이 첩자는 위험한 놈이야. 우리쪽 사람들은 놈에게 대적하지 못해. 그 "
"정체가 누구인 지도 밝혀내지 못한 상황이니까 말이야! 물론 이 놈을 추적해야하긴 하지만, 그렇다고 대상의 모든 인물들을 고문할 수도 "
"없어. 상인들이 동의하지 않을 거거든. 그러니 조심스럽게 발을 디뎌야 해. 상인들의 물품을 몰수하고 내쫓아버리겠다고 협박하는 거지. 날 "
"믿어. 바로 우리에게 정보를 제공해줄테니까 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank2/Cue_0027_Text
#. Speaker : Ekun_Companion
msgctxt "5754c8eb-c5be-4c73-bd0a-3a821db7cae8"
msgid ""
"\"We must catch the spy to track down his master. This is an animal that "
"must be stalked quietly. We'll need a tail on every member of the caravan. "
"But let them keep back. No threats, no torture. There's only one spy. The "
"others are not at fault.\""
msgstr ""
"\"그 주인을 찾기 위해 첩자를 추적해야 해. 놈은 조용히 활보하는 한 마리 짐승이야. 대상의 모든 인원들에게 미행을 붙여애 해. 하지만 "
"거리는 둬야하지. 협박도, 고문도 하지 말고 말이야. 다른 사람들은 죄가 없으니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Answer_0011_Text
msgctxt "b9645984-4758-49c1-aa00-6a75b55c74a0"
msgid ""
"{g|Espionage3_1}[Choice effects]{/g} \"Take her friends and family hostage.\""
msgstr "{g|Espionage3_1}[선택 시 효과]{/g} \"그녀의 지인과 가족들을 인질로 잡아라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Answer_0012_Text
msgctxt "2a3729ba-fc4f-40fa-8271-165dbe4d393c"
msgid "{g|Espionage3_2}[Choice effects]{/g} \"Spellbind her.\""
msgstr "{g|Espionage3_2}[선택 시 효과]{/g} \"주문을 걸라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Answer_0013_Text
msgctxt "bff1dbc3-6783-438a-aaa1-d0b6be49674e"
msgid ""
"{g|Espionage3_3}[Choice effects]{/g} \"Send her in the wrong direction and "
"follow her.\""
msgstr "{g|Espionage3_3}[선택 시 효과]{/g} \"미끼를 던지고 미행하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Answer_0023_Text
msgctxt "50578337-24ce-4b27-9be5-4b9cc25550e2"
msgid "\"Act as you see fit.\""
msgstr "\"마음대로 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0008_Text
#. Speaker : Ekun_Companion
msgctxt "24f4084c-4acf-43da-ab05-eb80dcd55639"
msgid ""
"\"I don't trust her. She's betrayed one master. She is bound to do it again. "
"We could take her hostage. We could even use magic to probe her mind. But "
"both methods are unreliable, and besides, magic is bad for the brain. I "
"suppose we should set a trap. Let us feed her a lie and see where she takes "
"the bait. Do you understand what I suggest?\""
msgstr ""
"\"난 저 여자 안 믿어. 이미 한 주인을 배신했잖아. 또 다시 그런 짓을 할 거라고. 인질로 협박해야 해. 마법을 사용해서 정신을 "
"조사해봐도 되고. 하지만 둘 다 별로 믿음직한 방법은 아니지. 거기다 마법을 잘못 쓰면 뇌에도 안 좋고. 함정을 깔아야할 거 같아. 저 "
"여자의 거짓말에 맞장구 치다가 미끼를 무는 지 한 번 보자고. 내 말 이해하겠어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0009_Text
#. Speaker : Jubilost_Companion
msgctxt "3f3b95f0-b9bd-4c8d-a25c-676ad3267a74"
msgid ""
"\"I'm not sure she's under orders to insinuate herself as a double-agent. So "
"I don't think it would help to deliberately feed her lies. But what if she "
"decides to sell us out? Simple greed must never be overlooked. We could take "
"a hostage – someone significant to her. But what if she's not sentimental? "
"The safest bet is advanced magical brainwashing. I couldn't guarantee the "
"security for her personally, however.\""
msgstr ""
"\"저 여자가 이중 첩자로 우리 믿음을 사려하는 지 확신이 안 가. 일부러 거짓말에 장단 맞춰주는 건 도움이 안 될 거야. 하지만 우릴 "
"배신하기로 하면 어쩌냐고? 참새가 방앗간 옆을 그냥 지나칠 리가 없지. 인질을 잡아야 해. 저 여자에게 중요한 사람으로 말이지. 그런데 "
"저 여자가 냉혈한이면 어쩌냐고? 그렇다면 가장 안전한 방법은 마법으로 세뇌 하는 거야. 제정신을 유지할 지는 장담 못하지만 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0010_Text
#. Speaker : Jaethal_Companion
msgctxt "5cecf28b-ec93-495d-93d5-e24a04a1b7de"
msgid ""
"\"Should we trust her? I for one am not that stupid. She's only worried "
"about her own skin. Loyalty is out of the question. However, it would be "
"short-sighted not to make use of her knowledge. We could use magic to "
"brainwash her and command her obedience, but that is not the most reliable "
"solution. Besides, a couple years later she'd be useless as a dumb "
"vegetable. The best way to control her is to spill blood if she betrays us. "
"The blood of her friends and family. Her obedience can be ensured if we take "
"the right people hostage.\""
msgstr ""
"\"저 여자를 믿어야 하는 건가? 난 그렇게 바보가 아니야. 저 여자는 자기 안위만 걱정하고 있어. 충성심은 별개의 문제지. 하지만 "
"그렇다고 저 여자의 지식을 이용하지 않는 건 근시안적 생각이야. 마법으로 저 여자를 세뇌해 복종을 얻어야 해. 하지만 믿을 만한 방법은 "
"아니지. 몇 년 뒤면 멍청한 식물 쪼가리처럼 바보가 되어버릴 거고 말이야. 저 여자를 조종할 최고의 방법은 우리를 배신하면 피를 보여주는 "
"거야. 친구와 가족들의 피를 말이지. 사람을 제대로 잡는다면 분명 복종을 얻을 수 있을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0014_Text
#. Speaker : Ekun_Companion
msgctxt "6f1ce1ad-b6da-4ee8-ad92-70e592483333"
msgid ""
"\"That's cruel, but it might work. We're risking the lives of our people. If "
"she betrays us, she'll be risking lives of her own people.\""
msgstr ""
"\"잔인하지만, 먹히긴 할 겁니다. 우린 백성들의 목숨을 걸고 있습니다. 저 여자가 우릴 배신하면, 저치들의 목숨을 걸게 되겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0015_Text
#. Speaker : Jubilost_Companion
msgctxt "d239b5ea-da8f-4095-a0b6-ce2f0a766775"
msgid ""
"\"Trembling in fear for one's family makes for poor spying. You'll make her "
"unpredictable. Irrational. Ultimately, unreliable.\""
msgstr ""
"\"가족을 걱정하는 첩자는 좋은 첩자가 되지 못하지요. 지금 우리는 저 여자를 예측 불가하고, 비이성적이며 결국 믿을 수 없는 사람으로 "
"만들고 있는 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0016_Text
#. Speaker : Jaethal_Companion
msgctxt "01b7f045-4d2b-4ef5-a6a8-318262d06db2"
msgid ""
"\"Perfect! I'll give her a vivid description of her family's future, if she "
"should choose to betray us. It's going to be a long story.\""
msgstr "\"완벽해! 그 여자에게 우릴 배신하면 가족들이 어떻게 될 지에 대해 생생하게 가르쳐주도록 하겠어. 기나긴 이야기가 되겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0017_Text
#. Speaker : Ekun_Companion
msgctxt "e39e6a28-d991-4794-ace0-d11f451c5c16"
msgid ""
"{n}Ekun frowns and makes an unfamiliar gesture as if brushing off a fly.{/n} "
"\"Magic... isn't dependable. Something could go wrong without our even "
"knowing. Our own tool could become the knife that stabs us in the heart.\""
msgstr ""
"{n}에쿤은 찡그리고는 파리를 쫓는 듯한 불편한 행동을 취한다.{/n} \"마법이라... 마법은 믿을만하지 못하지. 뭐가 어떻게 돌아가는 "
"지도 모르게 일이 잘못 되어버리는 수가 있어. 우리가 쥔 칼이 우리의 심장을 위협할 수도 있다는 거지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0018_Text
#. Speaker : Jubilost_Companion
msgctxt "9446598f-d896-4c8c-a6e1-126018f56916"
msgid ""
"\"I will oversee the magical treatment myself. Hopefully it won't affect her "
"mind too much. But I know one thing for sure: after this we won't stand a "
"chance of becoming fellow scholars.\""
msgstr ""
"\"마법에 대한 것은 내가 직접 관리하겠어. 정신에 너무 영향을 많이 끼치지 않길 바라. 그래도 한 가지는 확실히 알 수 있을 거 같군. "
"이 일이 끝나면 더는 착한 놈 행세 못 할 거라는 거.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0019_Text
#. Speaker : Jaethal_Companion
msgctxt "615a1791-704f-45d3-9b55-03e8a1bbdf7b"
msgid ""
"{n}Jaethal studies your face.{/n} \"Aren't you worried about the "
"consequences? Strange visions? The risk of insanity? Well, at least, you "
"don't have any scruples. That much can be said.\""
msgstr ""
"{n}제이탈은 당신의 얼굴을 살펴본다.{/n} \"결과가 걱정되지도 않아? 환영을 볼 지, 미쳐버릴 지 걱정도 안 돼? 뭐, 적어도 네게 "
"양심은 없다는 거 하나만은 알겠네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0020_Text
#. Speaker : Ekun_Companion
msgctxt "80edf63c-84d9-4fdd-9a23-4812ead46993"
msgid ""
"{n}Ekun nods.{/n} \"She's lying to us. We'll have to lie to her. But our "
"lies will be more convincing!\""
msgstr ""
"{n}에쿤은 끄덕인다.{/n} \"그녀는 거짓말 하고 있어. 우리도 거짓말 해야 해. 하지만 우리가 하는 거짓말은 훨씬 믿을만 하겠지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0021_Text
#. Speaker : Jubilost_Companion
msgctxt "d512f8d9-cc40-4f9d-b810-ebd27e33bd99"
msgid ""
"\"As you know, every decent plan must have at least seven layers of lies to "
"cover the truth. Well, maybe this is indeed the best way.\""
msgstr "\"알겠지만, 음모를 꾸미려면 진실을 가리기 위해 몇 겹의 거짓말로 덮어야 하는 법이야. 뭐, 이게 최선인 거 같긴 하네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0022_Text
#. Speaker : Jaethal_Companion
msgctxt "0350b43f-f9e6-4282-989d-33417e25e91d"
msgid ""
"{n}Jaethal juts out her chin in resentment.{/n} \"You're far too cautious. "
"Trust me, your enemies are not sharper or cleverer than I.\""
msgstr "{n}제이탈의 얼굴이 분노로 굳어집니다. {/n} \"쓸데없이 신중하기는. 날 믿어. 적이 나보다 뛰어날 리 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0030_Text
#. Speaker : Ekun_Companion
msgctxt "13c4bd56-9f59-43d4-a76e-5b9ed2a20542"
msgid ""
"\"We arrested a spy – a mercenary from Daggermark. He identified his client "
"for us. But it turns out she wishes to go over to us, and save herself from "
"her old master.\""
msgstr ""
"\"첩자를 붙잡았어. 대거마크에서 온 용병이야. 자길 고용한 게 누군지 말 하더군. 그런데 이 여자가 우리 편으로 전향하려는 모양이야. "
"옛 주인으로부터 목숨을 부지하기 위해서.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0032_Text
#. Speaker : Jubilost_Companion
msgctxt "b996cdc8-7e98-4902-887d-a13094682494"
msgid ""
"\"We've captured a spy. You'd be surprised to learn where he came from. He's "
"from Daggermark, the capital of espionage and intrigue in the {g|River "
"Kingdoms}River Kingdoms{/g}. My agents were seeking his client, but she made "
"hurried contact herself. She wants come over to us. But don't celebrate yet. "
"It may not have occurred to you, but her entire story, which would be so "
"convenient for us, might be a ruse.\""
msgstr ""
"\"첩자를 잡았다. 어디서 왔는지 알게 되면 놀랄 거야. 대거마크에서 왔더군. {g|River Kingdoms}강의 왕국들{/g}의 음모와 "
"모략의 성지 말이야. 우리 요원들이 그 고객을 찾고있었는데, 그 여자가 헐레벌떡 우리에게 뛰어오더군. 우리 편으로 전향하겠다고 말이지. "
"하지만 아직 축하하긴 일러. 넌 아직 잘 모르겠지만, 그 여자가 한 이야기는 들어보면 너무 상세해. 계략일 지도 모른다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank3/Cue_0033_Text
#. Speaker : Jaethal_Companion
msgctxt "cac5d689-5bee-4948-baba-224f89924c24"
msgid ""
"\"We captured a spy, a mercenary from Daggermark. This city is like a spider "
"at the center of a web of intrigue, that entangles all the {g|River Kingdoms}"
"River Kingdoms{/g}. The spy identified his master. Once she realized we were "
"following her, she anticipated the tortures she was facing, and claimed that "
"she wished to come over to us, just as people of weak loyalty do.\""
msgstr ""
"\"첩자를 잡았는데, 대거마크에서 보낸 용병이었어. 이 도시는 온 {g|River Kingdoms}강의 왕국들{/g}을 옭아매는 모략의 "
"거미줄 위의 거미와도 같거든. 첩자가 자신의 주인의 이름을 밝혔어. 그 여자는 우리가 미행하는 걸 알아챘을 때, 고문할 지를 알았던지 "
"우리 편으로 전향하고싶다고 말을 해왔어. 충성심 낮은 놈들의 전형적인 모습 그대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Answer_0005_Text
msgctxt "d6d92523-8f12-4936-b51d-12e40ad030f9"
msgid ""
"{g|Espionage4_1}[Choice effects]{/g} \"Deliver the list of agents to Galt.\""
msgstr "{g|Espionage4_1}[선택 시 효과]{/g} \"요원들의 목록을 갈트로 보내라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Answer_0006_Text
msgctxt "afad2087-9585-43a4-af15-83990a057833"
msgid ""
"{g|Espionage4_2}[Choice effects]{/g} \"Report the treachery to Gralton.\""
msgstr "{g|Espionage4_2}[선택 시 효과]{/g} \"그랄튼에게 배반 행위를 보고하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Answer_0007_Text
msgctxt "2e483ff3-c2e5-4083-9211-01f287da3aa6"
msgid ""
"{g|Espionage4_3}[Choice effects]{/g} [Gain 2000 gold] \"Sell the information "
"in Daggermark.\""
msgstr "{g|Espionage4_3}[선택 시 효과]{/g} [2000골드 획득] \"정보를 대거마크에 팔라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Answer_0017_Text
msgctxt "5ccad7e1-ed42-4f72-b6d6-1b3e67982f31"
msgid "\"I trust your judgment.\""
msgstr "\"나는 네 판단을 믿는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Answer_0021_Text
msgctxt "dcff999f-5928-46c6-9a70-da8f0428352b"
msgid "\"Tell me more about Gralton and Galt.\""
msgstr "\"그랄튼과 갈트에 대해 더 말해보라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "4f386534-bbda-437b-b07e-f5a7c4c3dbf5"
msgid ""
"\"We've found the one who meant to harm us. By day, he's a small fish, a "
"scribe in Gralton. At night, he becomes an important spy from Litran, the "
"Galtan city of Grey Gardeners. We do not know what his interest is in us, "
"but we're following him. He recently sent a message to {g|Galt}Galt{/g}. We "
"managed to intercept the courier on a backwoods path. The message contained "
"a list of all Gralton's spies in Litran.\""
msgstr ""
"\"우리에게 해를 끼치려는 자를 찾아냈어. 낮에는 별로 중요한 일을 하지 않는, 그랄튼의 서기야. 하지만 밤에는, 회색 원예사들이 있는 "
"갈트인들의 도시인 리트란의 첩자가 되지. 왜 우리가 저들의 주의를 끌게 된 지는 모르겠지만, 그 자를 추적하고 있어. 최근에 "
"{g|Galt}갈트{/g}로 전갈을 보냈더군. 외각 길 에서 그 배달부를 붙잡는 데 성공했지. 그 전갈엔 리트란에 있는 모든 그랄튼의 "
"첩자 목록이 적혀있더군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0002_Text
#. Speaker : Jubilost_Companion
msgctxt "bcbb862d-dc84-4d28-8605-fab0cb2691c5"
msgid ""
"\"We're finally on top of the enemy spy we've been tracking. An ordinary "
"scribe from Gralton was plotting against us! It also happens that he's the "
"head of the Grey Gardeners' intelligence operations in this city. I've no "
"idea what interest he has in us, but we followed him and intercepted his "
"correspondence. It contained a list of all Gralton's spies in Litran, in "
"alphabetical order. The letter was on its way to Litran – to the Grey "
"Gardeners' headquarters!\""
msgstr ""
"\"추적하고 있던 적 첩자를 드디어 밝혀냈어. 그랄튼에서 온 평범한 서기가 우리에게 음모를 꾸미고 있었어! 거기다 그 첩자는 이 도시에서 "
"첩보활동을 하던 회색 원예사들의 수장인 것으로 드러났지. 무엇을 캐내려는 지는 알 수 없지만, 그를 추적해 그가 보내려던 편지를 가로챘어. "
"거기엔 리트란에 있는 모든 그랄튼 첩자의 목록이 적혀있더군. 잘 정렬되어서 말이지. 편지는 회색 원예사들의 본진인 리트란으로 가는 중이야!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "473b11b7-0af8-402a-bf26-c4acfd32c33b"
msgid ""
"\"We've learned the name of the one who was plotting against you. It's an "
"ordinary man from Gralton. However, he's a major spy for Litran, the Grey "
"Gardeners' capital in {g|Galt}Galt{/g}. I don't know what attracted him to "
"us, but now we have him on the hook.\""
msgstr ""
"\"우리에게 음모를 꾸미던 자의 이름을 알아냈어. 그랄튼에서 온 평범한 사람이더군. 그런데, 이 자는 회색 원예사들의 본진인 "
"{g|Galt}갈트{/g}의 리트란에서 첩자질을 하던 사람이었어. 왜 우리를 염탐하는 지는 모르겠지만, 놈을 잡았지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0008_Text_String
#. Speaker : Ekun_Companion
msgctxt "b8e9ea1a-33d5-4827-99bd-c1fd71cbb1c0"
msgid ""
"{n}Ekun frowns.{/n} \"Litran is dangerous. They kill people without a second "
"thought. There are too many madmen there. You should not seek their "
"friendship. Especially not if you have to pay for it with other people's "
"lives.\""
msgstr ""
"{n}에쿤은 찡그린다.{/n} \"리트란은 위험해. 놈들은 아무 생각 없이 사람을 죽이고 다니지. 거기엔 미친 놈들이 너무 많아. 놈들과 "
"우정을 쌓으려고 하지 마라. 특히 다른 사람의 생명으로 빚을 갚아야 할 때는 더더욱.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0009_Text
#. Speaker : Jubilost_Companion
msgctxt "476a3693-010e-4faa-a5ea-811c035c90b1"
msgid ""
"\"It's your right to choose which of your neighbors you make friends with. "
"But what of the lives of Gralton's agents? Well, their blood is on your "
"hands now.\""
msgstr ""
"\"어떤 나라를 동맹으로 선택할지는 영주님의 권리이지만 그랄튼에 있는 요원들의 삶은 어떠합니까? 음, 그들의 목숨은 이제 영주님 손에 "
"달렸습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0010_Text
#. Speaker : Jaethal_Companion
msgctxt "d978c756-b110-474b-b8a1-897f4e24bbb1"
msgid ""
"\"I'll be sure the Grey Gardeners know that their operation hung on our "
"discretion. Let them be grateful to us for not punishing them harshly for "
"their carelessness. The lives of the ungrateful are very short and full of "
"suffering.\""
msgstr ""
"\"회색 원예사들도 그네들의 계획의 성공 여부가 우리 재량에 달려있다는 사실을 알고 있을 겁니다. 놈들의 부주의함에 대해 너무 가혹하게 "
"처벌하지는 말고, 놈들이 우리에게 감사하게 만듭시다. 환영받지 못하는 자의 삶은 짧고 고통으로 가득 차있으니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0011_Text
#. Speaker : Ekun_Companion
msgctxt "3a30789b-c36d-4619-a454-a8ef2efa07c7"
msgid ""
"\"Gralton's people will stay alive. The traitor will go to jail. It's a good "
"decision.\""
msgstr "\"그랄튼의 시민들은 죽지 않을거야. 반역자들은 감옥에 가게 되겠지. 이게 옳은 결정이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0012_Text
#. Speaker : Jubilost_Companion
msgctxt "6ef73d47-a199-4ec9-bee9-4f2ae13b6337"
msgid ""
"\"That's your right. But you shouldn't interfere in a squabble between two "
"other countries. It's none of our concern!\""
msgstr "\"그건 당신의 권리입니다. 그러나 다른 두 나라 사이의 분쟁에 개입해서는 안됩니다. 그건 우리 소관이 아닙니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0013_Text_String
#. Speaker : Jaethal_Companion
msgctxt "f50ca282-53da-4d77-8760-0fddb128aac8"
msgid ""
"\"Why? For the naive fairy tales that you call principles? Well, this is all "
"very noble, no doubt, but you put me in charge of the espionage, which means "
"I don't have the luxury of principles.\""
msgstr ""
"\"왜지? 원리원칙이라고 부르는 그 순진해빠진 사상을 위해서? 글세, 이 일도 분명 고귀한 일은 맞지만, 날 첩보대신 위치에 앉혀놨잖아. "
"이 말은 내가 원리원칙같은 사치에 휘말릴 여유가 없다는 뜻이라고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0014_Text_String
#. Speaker : Ekun_Companion
msgctxt "c08c2d70-3065-4e10-9538-5ddd12ec902e"
msgid ""
"{n}Ekun's face grows very dark.{/n} \"We sell human life for gold. It's a "
"bad trade.\""
msgstr "{n}에쿤의 얼굴은 굉장히 어두워진다.{/n} \"인신매매는 나쁜 짓이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0015_Text
#. Speaker : Jubilost_Companion
msgctxt "62f58d34-e913-4c40-8f47-fdd913a272b3"
msgid ""
"\"Selling this paper will bring us profit, and we won't even double-cross "
"anyone. Hopefully...\""
msgstr "\"이 종이를 팔면 돈이 들어오겠지. 누구도 배신하는 일 없이 말이야. 아마도...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0016_Text_String
#. Speaker : Jaethal_Companion
msgctxt "4692e96d-f1f4-41cf-8c9f-6ab40adb2f94"
msgid ""
"\"In the game of espionage, money is dust. Are you that fond of trading "
"dust? You shouldn't be selling something so valuable for gold.\""
msgstr "\"계략의 세계에서 돈은 먼지와 같다. 먼지를 거래하려는 건가? 돈 따위에 이렇게 값진 물건을 팔아선 안 돼.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0022_Text
#. Speaker : Ekun_Companion
msgctxt "bdd6f53e-549e-4f5b-8cd8-5ad5a8df0d38"
msgid ""
"\"A revolution took place in Galt. Many were executed without trial. Others "
"fled and hid in Gralton. They were the merchants and nobles. They dream of "
"reclaiming their homes – and of vengeance. So the Citizen's Directorate of "
"spies against {g|Galt}Galt{/g} was established.\""
msgstr ""
"\"갈트에서 혁명이 일어났어. 수많은 사람들이 재판도 받지 못한 채 처형당했지. 다른 사람들은 도망가서 그랄튼에 숨었어. 숨은 사람들은 "
"상인과 귀족었어. 그들은 고향을 되찾고자 하고 있어, 그리고 복수를 다짐하고 있지. 그래서 시민들이 {g|Galt}갈트{/g} 에 대항해 "
"첩보단체를 만들어냈다더군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0023_Text
#. Speaker : Jubilost_Companion
msgctxt "3280d943-7b02-427e-a55f-05a4b7c91075"
msgid ""
"\"When {g|Galt}Galt{/g} was flooded with the blood of the revolution, many "
"nobles and wealthy merchants sought shelter in Gralton. Now they obsess upon "
"reclaiming their former greatness and regaining what was taken from them. "
"They created the Citizen's Directorate, a quite capable spying network, but "
"still they could not bring Galt to its knees.\""
msgstr ""
"\"{g|Galt}갈트{/g}가 혁명의 피로 물들었을 때, 많은 귀족들과 상인들은 그랄튼의 은신처로 도망갔다. 이제 그들은 빼앗긴 "
"과거의 영광과 재산을 되찾으려 하고 있어. 시민들이 모여 단체를 만들었더군. 꽤나 유능한 첩보망을 말이지. 하지만 아직도 갈트를 손에 "
"넣지는 못하고 있는 상황이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0024_Text
#. Speaker : Jaethal_Companion
msgctxt "13177f3c-a7fb-4633-995b-88eefef65eee"
msgid ""
"\"While mobs of ruffians were burning mansions and chopping the heads off of "
"their nobles, Gralton sheltered those sentenced to death by the revolution. "
"It became their refuge, in a way. Now, of course, they're just a bunch of "
"idle fools, thirsty for revenge and dreaming of the days of yore. They "
"created the Citizen's Directorate, a spy network, which has proven itself "
"toothless and helpless from the very beginning.\""
msgstr ""
"\"깡패들의 폭동이 저택을 불태우고 귀족들의 목을 베자, 그랄튼에서 혁명으로 인해 사형선고 받은 이들을 보호해주고 있어. 어떤 의미로는 "
"피난처가 된 거지. 물론 지금 저들은 복수와 지난 날의 영광에 목마른 게을러빠진 머저리일 뿐이야. 놈들은 시민단체를 만들었더군. 시작부터 "
"아무런 힘도 능력도 없는 걸 증명한 첩보망을 말이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0025_Text
#. Speaker : Jubilost_Companion
msgctxt "e273ac0a-740b-443f-ae4a-a40fa9b1a159"
msgid ""
"\"We could pass this information to Litran, and thus condemn these spies to "
"death. The Grey Gardeners would appreciate it. On the other hand, their "
"appreciation isn't worth so much. Better to deliver the traitor to Gralton "
"in return for their friendship. The fanatics of Gralton are a charming "
"bunch, but of course there's no great difference between them and the "
"Gardeners. Why even get involved in their quarrel? My suggestion is to sell "
"the information on the rumor market, and try to keep out of trouble.\""
msgstr ""
"\"이 정보를 리트란에게 넘겨줘서 이 첩자들을 죽여버릴 수 있어. 회색 원예사들은 감사해 할 거야. 그 감사가 별 의미가 없다는 점이 "
"걸리긴 하지만. 배신자들을 그랄튼으로 보내 그들의 우정을 얻을 수도 있어. 그랄튼의 광신도들은 멋진 놈들이야. 하지만 원예사들이랑 크게 "
"다를 바 없는 놈들이긴 하지. 왜 놈들의 다툼에 발을 디디는 지 이해가 안 가네. 정보 시장에 이 정보를 팔고, 문제로부터 떨어져있기를 "
"제안하는 바야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0026_Text
#. Speaker : Ekun_Companion
msgctxt "34ea5ffb-db7c-4b43-a85c-606a11249234"
msgid ""
"\"Their lives are in our hands. Many would be willing to pay for this list, "
"{g|Galt}Galt{/g} first among them. Selling it would mean a death sentence to "
"everyone on the list. I suggest we report the traitor to Gralton. We don't "
"want these deaths on our conscience.\""
msgstr ""
"\"놈들의 명줄은 우리 손에 있어. 많은 이들이 돈을 주고 이 권리를 사려고 하지. {g|Galt}갈트{/g}도 일단 그 중 하나고. "
"이 정보를 팔게 되면 목록에 있는 모든 사람들의 목이 달아날 거야. 배신자를 그랄튼에 보고하는 게 낫다고 생각해. 이렇게 사람들을 죽여서 "
"양심에 찔리고싶진 않으니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0027_Text
#. Speaker : Jaethal_Companion
msgctxt "cedd8593-0958-42a7-9869-056abcc4c23c"
msgid ""
"\"We intercepted one of his letters. It contains a list of all Gralton's "
"spies in Litran. Oh, these greedy, crafty sorts, entirely oblivious to the "
"fragile barrier that separates them from the scaffold. My good will. Gralton "
"would be happy to learn of this treachery amongst their ranks, but what good "
"would that do us? Would we gain their friendship and goodwill? At least the "
"Daggermark rumor market would pay in gold! It's Gralton's own fault they "
"weren't watching their servants. But I suggest we allow the letter to "
"proceed to its address in Litran. If the Grey Gardeners show themselves to "
"be ungrateful, we'll be able to eliminate them easily.\""
msgstr ""
"\"그 자의 편지 중 하나를 가로챘어. 거기엔 리트란에 있는 그랄튼의 첩자 목록이 적혀있더군. 참으로 교활하고도 탐욕스러운 자들 같으니, "
"조금이라도 삐끗하면 이 세상과 안녕이라는 걸 전혀 모르고 있어. 그랄튼에게 이 배신자들의 정보를 알려주면 고마워 할 거야. 하지만 그래서 "
"우리가 얻을 수 있는 게 뭐지? 놈들의 우정과 선의를 얻는다? 최소한 대거마크의 정보 시장에 팔면 돈이라도 되지! 자기 부하들을 관리 못 "
"한 건 그랄튼 잘못이야. 하지만 이 편지를 리트란에 보내주는 게 좋을 거 같아 보여. 회색 원예사들이 배은망덕하게 행동하면 놈들을 손쉽게 "
"제거할 수 있으니까 말이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0028_Text
#. Speaker : Ekun_Companion
msgctxt "edf24ace-2346-4d6b-83cb-64a1fc726a5d"
msgid ""
"\"The Grey Gardeners have a monastery in Litran, a city in Galt. They are "
"spies and punishers. They keep {g|Galt}Galt{/g} safe from enemies both "
"without and within. Their faces are covered with masks, which means anyone "
"could be one of them. They are quite feared, and known for showing no mercy."
"\""
msgstr ""
"\"회색 원예사들은 갈트의 도시인 리트란에 수도원을 가지고 있어. 놈들은 첩자이자 처형인이지. 놈들은 {g|Galt}갈트{/g} 를 "
"적으로부터 안팎으로 지키는 자들이야. 가면을 쓰고 있고, 이 말은 누구든 놈들 일원이 될 수 있다는 말이지. 꽤나 두려움의 대상이야. "
"무자비한 걸로도 알려져있지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0029_Text
#. Speaker : Jubilost_Companion
msgctxt "6f5477fb-09e1-4384-bfd6-bd1516e3eb1d"
msgid ""
"\"It's no mystery why. It's because of the Grey Gardeners – their monastery "
"is also there, in Litran to be precise. They look fearsome in their masks, "
"so frightening and anonymous. Executioners, investigators, vigilantes, and "
"murderers. They're better suited to slaughterhouse work than anything "
"involving intellect. But people do fear them. And some are fond of them, "
"too. They help protect the country against spies and traitors – and what's "
"important, they keep away from politics.\""
msgstr ""
"\"뭐 신비로운 이유가 있는 건 아니야. 회색 원예사들 때문이지. 그네들의 수도원도 여기있어. 정확히 말하자면 리트란에 말이지. 가면을 "
"쓴 놈들은 무서운 놈들이야. 정체도 모르지. 처형인이자, 수사관이자, 자경단이자 살인마들이야. 좀 똑똑해 보인다기 보단 도살자들 같은 "
"느낌이지. 사람들도 놈들을 두려워하고. 어떤 사람들은 좋아하기까지 하더라고. 놈들은 자기 땅을 첩자와 배신자로부터 지키고 있어. 그런데 "
"중요한 건, 놈들은 정치와는 아무런 연관이 없다는 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/Cue_0030_Text
#. Speaker : Jaethal_Companion
msgctxt "bcae97de-0ad6-4d86-9702-c26942ea6fc8"
msgid ""
"\"I like their enemies, though. The Grey Gardeners, guardians of the "
"revolution. A vivid example of the fanaticism of the short-lived. The first "
"thing they sacrifice in the name of their ideals is the right to life. They "
"behave as though they cannot physically pronounce the word 'mercy'. Their "
"reputation speaks for itself. They built a monastery in Litran; now they're "
"casting terror in the hearts of everyone around. Their enemies don't stand a "
"chance against their covered faces. At least until we demonstrate otherwise."
"\""
msgstr ""
"\"저들의 적이 맘에 드는 거 같아. 회색 원예사들, 혁명의 수호자들 말이야. 짧게 살다가는 자들의 생생한 광신을 느낄 수 있거든. "
"저들이 자신들의 이상을 위해 첫 번째로 희생하는 건 바로 삶의 권리야. 놈들은 마치 '자비' 라는 말을 물리적으로 입에 담을 수 없다는 "
"듯 행동하지. 저들의 명성이 이를 말해주고 있어. 저들은 리트란에 수도원을 지었어. 이제 온 사람들의 가슴 속을 두려움으로 가득 채우고 "
"있지. 저들의 적은 놈들의 가면을 벗기지 못할 거야. 우리가 다른 방식으로 보여주지 않는 이상 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/EkanSpyBye_String
#. Speaker : Ekun_Companion
msgctxt "b6bca1e5-ff3b-4377-aa1e-2bb585d5e9b3"
msgid ""
"{n}After a moment of tense silence, Ekun continues:{/n} \"You need a new "
"head of intelligence, {name}. I'm... not the right person. I hunt alone. I "
"account for my own actions, and make my own decisions. You don't need my "
"help. You never heed my advice. You can hunt as you like. I'll fulfill this "
"order, but then I quit.\""
msgstr ""
"{n}긴장 넘치는 고요가 흐르고, 에쿤은 말을 이어갔다.{/n} \"새로운 첩보장이 필요하다, {name}. 난... 이 자리에 맞지 "
"않아. 난 혼자 사냥하지. 난 혼자 결정하고 혼자 행동해. 넌 내 도움이 필요 없어. 내 조언도 듣지 않고. 네가 원하는 대로 사냥해. "
"이 명령을 따르긴 하겠지만, 이후에 난 사임할 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank4/JaetalSpyBye_String
#. Speaker : Jaethal_Companion
msgctxt "9e14ab99-b909-4c5c-9a64-a054d30afb2d"
msgid ""
"\"I've grown tired of our arguments. You should find a more obedient and "
"less sophisticated master of espionage. I will fulfill the order, but then I "
"will attend to other matters.\""
msgstr ""
"\"너랑 논쟁하는 데 이제 지쳐버렸어. 네게 더 알랑거리면서 멍청한 첩보대신을 찾아보라고. 이 명령은 따르겠지만, 이후엔 다른 일을 하러 "
"가겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Answer_0005_AlignmentShift.Description
msgctxt "c8143aa4-dd9f-4ded-bafd-124c8fbfd76a"
msgid ""
"Openly displayed their relations with the perished spies and acclaimed them "
"as heroes."
msgstr "죽은 첩자들과 저들의 관계를 공개적으로 밝혔고 죽은 첩자들을 영웅으로 추앙했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Answer_0005_Text
msgctxt "748b7d44-7f55-496f-9b47-560d5ca58cd6"
msgid ""
"{g|Espionage5_1}[Choice effects]{/g} \"They died for us and our cause. We "
"shall openly honor the dead.\""
msgstr "{g|Espionage5_1}[선택 시 효과]{/g} \"이 첩자들은 우리를 위해 죽었다. 공식적으로 기념해줘야 한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Answer_0006_Text
msgctxt "a235fee3-3cbb-44bb-ad62-0e8db1fb5c4f"
msgid ""
"{g|Espionage5_2}[Choice effects]{/g} \"Take care of their families without "
"attracting undue attention.\""
msgstr "{g|Espionage5_2}[선택 시 효과]{/g} \"순직한 첩자들 가족으로부터 지나치게 관심을 끌지 말고 잘 돌봐주라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Answer_0007_AlignmentShift.Description
msgctxt "f58ad304-a148-49d5-887b-ae899a59da08"
msgid "Renounced their dead spies."
msgstr "죽은 첩자들과의 관계를 부정했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Answer_0007_Text
msgctxt "3da55f40-2c5d-49ce-9eaf-3202479668aa"
msgid ""
"{g|Espionage5_3}[Choice effects]{/g} \"We have nothing to do with them. "
"That's what everyone must think.\""
msgstr "{g|Espionage5_3}[선택 시 효과]{/g} \"우린 죽은 자들과 아무런 연관이 없다. 모두들 그렇게 생각하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Answer_0008_AlignmentShift.Description
msgctxt "650d066c-e64a-433c-a103-f3956afa338d"
msgid "Turned Galtans in their lands into undead."
msgstr "갈트인들의 땅을 망자의 땅으로 바꿨다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Answer_0008_Text
msgctxt "33a9a256-5100-4fc5-bd4d-e1cad2df062f"
msgid ""
"{g|Espionage5_4}[Choice effects]{/g} \"Let's execute travelers from Galt and "
"then raise them as undead. I'm in need of loyal servants.\""
msgstr ""
"{g|Espionage5_4}[선택 시 효과]{/g} \"갈트에서 온 여행자를 처형하고 언데드로 부활시켜라. 충직한 하인이 필요하다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Answer_0009_AlignmentShift.Description
msgctxt "1f737602-e22e-479c-9b2b-7fe2e0580b6c"
msgid "Started a massacre to avenge the death of the spies."
msgstr "죽은 첩자들의 복수로 대학살을 벌였다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Answer_0009_Text
msgctxt "62a4daab-c2d4-4f75-94a1-1cf8843b6ac7"
msgid ""
"{g|Espionage5_5}[Choice effects]{/g} \"Hang ten citizens of Galt in our "
"territories for every victim among our people.\""
msgstr "{g|Espionage5_5}[선택 시 효과]{/g} \"우리 땅에서 죽은 시민 한 명 당 열 명의 갈트인을 매달아라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Answer_0010_Text
msgctxt "131ab397-530c-49fc-810f-f7e5fb780bb2"
msgid "\"You decide, and it's done.\""
msgstr "\"당신이 결정했으면, 그걸로 끝이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "02755f45-1145-4da0-acd3-df59bc8161ef"
msgid ""
"\"We shouldn't have gotten caught. But we've been caught. I don't understand "
"how. Litran learned who blew their spy's cover. In retaliation, they seized "
"our own agents and executed them. They mean to send us a message. But what "
"troubles me more...\""
msgstr ""
"\"이렇게 잡히면 안 됐어. 하지만 잡혔지. 어떻게 잡혔는 지조차 모르겠네. 리트란에서 누가 자기네 첩자들을 발견했는 지 알게 된 "
"모양이야. 그 보복으로 우리 요원들을 붙잡아 처형했다고 해. 우리에게 메시지를 보내려고 하는 거 같아. 하지만 더 문제되는 건...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0002_Text
#. Speaker : Jubilost_Companion
msgctxt "ce4b00e9-1af7-4931-b591-9ebdbb709cc0"
msgid ""
"{n}Jubilost's gestures are abrupt, his voice betrays uncertainty.{/n} "
"\"Despite all our secrecy, someone in Litran discovered who thwarted them. "
"Accuse me all you like! I can find a dozen better scapegoats for you. But it "
"doesn't matter. Our people were captured by the Grey Gardeners and executed. "
"They've sent us a clear message: 'stay away'.\""
msgstr ""
"{n}주빌로스트의 움직임은 부자연스러웠고, 목소리엔 은연 불안함이 드러났다.{/n} \"비밀스럽게 일을 처리했지만 리트란에서 누가 "
"자기네들을 방해했는 지 알아내고 말았어. 날 고발하려면 하라지! 대신할 희생양은 얼마든 찾아줄테니 말이야. 어쨌든, 우리쪽 사람들이 회색 "
"원예사들에게 붙잡혀서 처형당했어. 명백해 보이는 메시지를 전달했지. '꺼져라' 라고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "9e868bff-93a5-4616-91a1-07c75db4eba8"
msgid ""
"\"{name}, I've done my best to tread lightly, but Litran learned of our "
"interference with their plans nevertheless. I told you we shouldn't play "
"games with them. Our people have been captured and beheaded. Pathetic fools, "
"and their irrational act of defiance! Others would recommend you renounce "
"these executed agents, to protect your reputation. After all, they were "
"nothing but pawns.\""
msgstr ""
"\"{name}, 최대한 조심스럽게 하려고 했는데, 리트란 쪽에서 우리 쪽의 개입을 알아챈 모양이야. 내가 놈들이랑은 어울리지 말자고 "
"했잖아. 우리 사람들이 잡혀서 목이 매달렸어. 불쌍한 머저리들. 비이성적으로 반항하다니! 어떤 자들은 이 처형된 요원들을 버려서 네 "
"평판을 보호하자고 하고 있어. 어쨌건 그 놈들은 우리 장기말이었을 뿐이니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0011_Text
#. Speaker : Ekun_Companion
msgctxt "f1723f09-5b09-4915-8e0a-f5a7ba65747e"
msgid ""
"\"It's dangerous. That's going to irritate our neighbors. But it's noble. "
"Death doesn't seem so frightening when you know you won't be forgotten.\""
msgstr ""
"\"이건 위험해. 이웃들을 화나게 할 거야. 하지만 고귀한 일이기도 하지. 우리가 잊지 않는 한 죽음은 두려운 존재가 아니니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0012_Text_String
#. Speaker : Jubilost_Companion
msgctxt "0a8b2e83-bfb0-44bf-81e1-f14110b68f1c"
msgid ""
"\"Thinking about your conscience? I know, conscience is important for a "
"ruler. It must be kept clear. But we spies have a job to do, and a spy's "
"conscience demands only one thing: to protect our country.\""
msgstr ""
"\"양심에 대해 생각하는 거야? 나도 알아, 양심은 군주에게 있어 중요하지. 가책을 느끼는 일이 있어선 안 돼. 하지만 우리 첩자들에겐 "
"할 일이 있어. 그리고 첩자들에게 있어 양심은 한 가지 뿐이지. 조국수호.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0013_Text
#. Speaker : Jaethal_Companion
msgctxt "5cacbaa2-26ce-4998-9633-8975111d5150"
msgid ""
"\"Hm... That's unwise from a political perspective. However, politics are "
"constantly changing, like the boiling waters of a hot spring.\""
msgstr ""
"\"흠... 정치적 관점에서 볼 땐 현명하지 못한 선택이야. 하지만 정치는 언제나 바뀌는 법이니까. 뜨거운 온천에서 끓어오르는 물처럼 "
"말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0014_Text
#. Speaker : Ekun_Companion
msgctxt "e93144f2-70b2-4376-ade1-563f33a644f1"
msgid ""
"\"They fulfilled their duty. We shall fulfill ours. We will take proper care "
"of their families.\""
msgstr "\"그들은 의무를 다했다. 우리도 다해야 하지. 저들의 가족들을 적절히 보살펴주라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0015_Text_String
#. Speaker : Jubilost_Companion
msgctxt "29a1be40-898f-44b5-bb56-10de3cd388ef"
msgid "\"Very well, so be it.\""
msgstr "\"아주 좋아, 그리 될 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0016_Text_String
#. Speaker : Jaethal_Companion
msgctxt "f039b54d-2307-4c97-9fd2-fcefdb815158"
msgid ""
"\"Do you hope to keep this secret forever? You shouldn't. You're looking "
"after the living, not the dead. The living are not so good at keeping "
"secrets.\""
msgstr ""
"\"이 비밀을 영원히 안고 가고싶어? 그러면 안 돼. 우리는 망자가 아닌 살아있는 사람들을 다스리는 거잖아. 살아있는 자들은 비밀을 "
"지키는 데 능하지 않지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0017_Text_String
#. Speaker : Ekun_Companion
msgctxt "98272dc1-bddc-49a4-9df3-7e9f2b17cd69"
msgid ""
"{n}Ekun shakes his head.{/n} \"This is no good. In the future, our people "
"will choose to betray us, rather than die and leave their families without "
"support.\""
msgstr ""
"{n}에쿤은 머리를 흔든다.{/n} \"좋지 않다. 죽어서 가족들을 보호 없이 내버려두게 된다면 첩자들은 우리를 배신할 거다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0018_Text
#. Speaker : Jubilost_Companion
msgctxt "5f6cbdb3-41d7-4019-9c31-bc5c20149da1"
msgid ""
"\"That's for the best. Only by openly renouncing them can we really take up "
"and finish their job. If we accepted responsibility for their deaths, we'd "
"not only be harming ourselves, but we'd also be making their sacrifice "
"meaningless. – Or whatever you're supposed to say in a situation like this..."
"\""
msgstr ""
"\"현재는 이게 최선이야. 공개적으로 죽은 첩자들과의 관계를 부정해야만 진정으로 계속 나아갈 수 있고 저들의 임무를 끝낼 수 있어. "
"우리가 죽은 첩자들에 대한 책임을 지겠다면, 우리 몸에 칼을 꽂아넣는 행위가 될 뿐만 아니라 저들의 희생을 무의미하게 만드는 게 될 "
"거야. 이런 상황에선 네가 무슨 말을 하든 간에 말이지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0022_Text
#. Speaker : Jaethal_Companion
msgctxt "a612802e-9146-443f-9b53-29b945890e5a"
msgid ""
"\"I will happily demonstrate to the pathetic mortals that death is not the "
"end of their service. I promise, you will appreciate your new servants.\""
msgstr "\"내 기꺼이 가련한 필멸자들에게 죽음이 섬김의 끝이 아님을 알려주지. 약속하지. 새로운 하인들이 마음에 들 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0023_Text_String
#. Speaker : Ekun_Companion
msgctxt "d140b284-9362-4ea0-9939-4cf405dc0154"
msgid ""
"\"You want to teach them a lesson. This I understand. But this is worthy of "
"a wild animal. If you behave like a wild animal today, then be assured, "
"tomorrow you will be treated like one. They will put out traps and hunt you "
"down.\""
msgstr ""
"\"교훈을 가르쳐주려 하는군 그래. 나도 이해한다. 하지만 이런 건 야생 동물들이나 하는 짓이다. 명심해라, 오늘 짐승처럼 행동하면, "
"내일부터 짐승 취급 받는다는 것을. 저들은 함정을 깔고 널 사냥하려 들겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0024_Text_String
#. Speaker : Jubilost_Companion
msgctxt "af37598f-c579-40f6-b2a3-70bab59ebcee"
msgid ""
"\"This is no way to settle scores. What do you hope to accomplish? To "
"instill fear? They were bound to fear us in any case. But after this "
"savagery they'll never deal with us again! And how am I supposed to erase "
"these ugly stains from my reputation? I understand – you enjoy being a "
"tyrant. But I've got better plans for my future.\""
msgstr ""
"\"이건 원한을 해결하는 방식이 아니야. 도대체 뭘 위해 이러는 거야? 공포를 심어주려고? 저들은 어떻게 되었든 간에 우릴 두려워하게 "
"되어있어. 하지만 이 야만적인 행동이 끝나면 우리랑 다시는 거래하지 않을 거란 말이야! 그리고 내 평판에 지는 더러운 얼룩은 어쩌고? "
"나도 이해해. 폭군 놀이가 재밌는 거겠지. 하지만 난 미래를 위한 더 나은 계획이 있거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0025_Text
#. Speaker : Jaethal_Companion
msgctxt "7e726784-d0b3-4443-9b21-f171768aedcf"
msgid ""
"\"You're no stranger to the creative approach. I like that. I will order a "
"general hunt for interlopers from {g|Galt}Galt{/g}.\""
msgstr ""
"\"창의적인 접근 방식에 익숙하군 그래. 마음에 들어. {g|Galt}갈트{/g} 에서 온 침입자를 사냥하라고 장군에게 명령을 내려두지."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0026_Text
#. Speaker : Jubilost_Companion
msgctxt "0ca75dfe-24b2-49e4-8030-d76646247350"
msgid ""
"\"I implore you to embrace this message and refrain from further dealings "
"with them. Do not think of vengeance, or even acknowledge the families of "
"the dead. There can be no monuments to the fallen. We must avoid war. We "
"mustn't allow predictable moves to lead us into a trap. Our agents knew very "
"well what they were getting themselves into. As do we all.\""
msgstr ""
"\"제발 저들과 드잡이질 하지 말아줘. 복수는 꿈도 꾸지 마. 죽은 이들의 가족들에게 알리려고도 하지 마. 죽은 이들을 위한 추모를 할 "
"수는 없어. 전쟁은 피해야 해. 함정 속에 제발로 걸어들어가는 격이 되면 안 돼. 우리 요원들은 자기들이 무슨 일을 하는 지 잘 알고 "
"있어. 우리도 마찬가지고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0027_Text
#. Speaker : Jaethal_Companion
msgctxt "513a763e-cec9-426f-9c2e-748d0dd38e5a"
msgid ""
"\"But this would send a message that you're scared. I've a better plan. "
"We'll capture citizens of {g|Galt}Galt{/g} that are presently in our lands, "
"put them to death, and turn them into the obedient undead slaves. We must "
"demonstrate that we cannot be intimidated or brought to submission.\""
msgstr ""
"\"하지만 이러면 당신이 겁에 질렸다는 것을 알려주는 격이 될 거야. 더 나은 방법이 있어. 지금 우리 영토에 있는 "
"{g|Galt}갈트{/g} 시민들을 붙잡아서, 죽여버리고 언데드 노예로 만들어버릴 거야. 우리가 겁먹지도 않고 항복하지도 않는 존재라는 "
"것을 저들에게 알려줘야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/Cue_0029_Text
#. Speaker : Ekun_Companion
msgctxt "0f755488-27ca-44cd-89f0-54e5be98c6a9"
msgid ""
"{n}Ekun sighs.{/n} \"What shall we tell their families? Do we promise them "
"that we won't disown them? That could be dangerous. Do we renounce them? "
"That would be disgraceful. My advice is to take care of their families, but "
"secretly. The dead would have wanted this.\""
msgstr ""
"{n}에쿤은 한숨 쉬었습니다.{/n} \"저들의 가족들에겐 뭐라고 얘기하지? 그들을 져버리지 않을 거라고 약속이라도 해줘야 하나? 그건 "
"위험하다. 그렇다면 그들을 버릴까? 그건 불명예스럽다. 내가 할 수 있는 조언은, 그들의 가족들을 잘 돌봐주자는 것이야. 비밀리에 "
"말이지. 죽은 이들도 이러기를 원했을 거다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Galt/JubilostSpyBye_String
#. Speaker : Jubilost_Companion
msgctxt "39c79d2a-1159-4e1d-889f-e406919199c6"
msgid ""
"{n}Jubilost becomes sarcastic.{/n} \"There's something I don't quite "
"understand. Why did you offer this position to me in the first place? To "
"reject my advice over and over? Please find yourself a new Minister. "
"Meanwhile I will fulfill this final request and then return to my regular "
"life.\""
msgstr ""
"{n}주빌로스트는 빈정댔습니다.{/n} \"이해가 안 가는 게 있어. 나한테 어째서 이 직위를 제안한 거지? 내 조언을 무시하고 또 "
"무시하려고? 새로운 장관이나 찾아보시지. 이 마지막 요구까지는 들어주고 난 평범한 삶으로 돌아갈 테니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Answer_0005_Text
msgctxt "8cb46496-2412-4e61-a28b-3ef14808188e"
msgid "\"We won't abandon our people. You must plot their escape.\""
msgstr "\"우리 백성들을 져버리지 않을 것이다. 저들의 탈출 방법을 모색하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Answer_0006_Text
msgctxt "bffbaa1a-b732-4a49-9d17-9b4950e288a0"
msgid "[Pay 100 BP] \"Ransom our people.\""
msgstr "[100 BP 지불] \"우리 사람들의 몸값을 지불하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Answer_0007_Text
msgctxt "9837df66-92d6-4457-af37-a37889d2977f"
msgid "[Pay 50 BP] \"Let them be silenced forever.\""
msgstr "[50 BP 지불] \"저들을 영원히 침묵시키라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Answer_0010_Text
msgctxt "50955fe3-21bf-47c2-9097-f6d3e973a408"
msgid "\"They're your people. You must decide.\""
msgstr "\"자네 사람들이다. 자네가 결정하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "402c5157-e2c5-4244-bc19-6f0138a7f395"
msgid ""
"\"Do you remember the spies from Gralton? Their masters learned that it was "
"we who condemned them to death. In revenge, they have kidnapped our people "
"and thrown them into prison. We must rescue them while we have the chance. "
"But an assault on their prison would be far too bold to easily be forgiven. "
"But if you don't wish to start a fight, we could act more cautiously and "
"simply ransom them, although it will be expensive. Finally, we could silence "
"them. Forever. They possess valuable information, of course. But this would "
"be... disgraceful. I wouldn't do it.\""
msgstr ""
"\"그랄튼의 첩자들을 기억하십니까? 그들의 수장이 우리가 그들을 처형했다는 것을 알아낸 모양입니다. 그에대한 복수로, 그들은 우리의 "
"사람들을 납치해서 감옥에 가두었습니다. 우리는 기회가 있는 동안 그들을 구해 내야 합니다. 그러나 그들의 감옥으로 쳐들어가는 것은 쉽게 "
"용서받기 어려운 과감한 처사일겁니다. 하지만 만약 우리가 싸움을 시작하길 원하지 않는다면, 우리는 더 조심스럽게 행동해서 간단히 몸값을 "
"내고 그들을 데려올 수 있습니다. 제법 비싸겠지만요. 마지막으로 우리는 잡힌 사람들을 조용하게 만들 수 있습니다. 영원히 말이죠. 그들은 "
"당연히 귀중한 정보를 가지고 있습니다. 하지만 이건 불명예적인 일이고, 저라면 하지 않을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Cue_0002_Text
#. Speaker : Jubilost_Companion
msgctxt "ff7e2c56-2b1a-4856-91ea-fffd574fcf3d"
msgid ""
"\"Gralton somehow learned that we consigned their spies to death. In "
"retaliation, they arrested our own people and threw them into prison. The "
"information our people know shouldn't fall to Gralton's hands.\""
msgstr ""
"\"그랄튼 쪽에서 어떻게든 우리가 그들의 첩자들을 처리한걸 알아낸 모양입니다. 그에 대한 보복으로, 그들은 우리의 사람들을 체포해서 "
"감옥에 가두었습니다. 우리의 사람들이 가지고 있는 정보가 그랄튼의 손에 넘어가서는 안됩니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "91e3f672-68c4-41d3-b3d8-6cf6b5fd3add"
msgid ""
"\"Gralton found out that we were involved in their spies' deaths. They only "
"had themselves to blame, but they've twisted their anger toward us, grabbed "
"our people, and thrown them in jail. They're looking to torture valuable "
"information out of them. As if we would sit by and watch them succeed!\""
msgstr ""
"\"그랄튼이 그들의 첩자의 죽음에 우리가 관계되어있다는 것을 알아차렸습니다. 그건 분명히 자기들 잘못이지만, 분노의 화살을 우리에게 "
"돌렸고, 우리의 사람들을 잡아다가 감옥에 가두었습니다. 그들은 가치있는 정보를 얻어내기 위해 고문을 할것처럼 보입니다. 만약 우리가 그냥 "
"앉아서 그들이 성공하는걸 지켜본다면 말이죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Cue_0008_Text
#. Speaker : Ekun_Companion
msgctxt "62d8deab-320b-461c-b820-436732266fc8"
msgid ""
"\"I'll gather my best people and plan our raid. We'll extract our people "
"bring them to safety.\""
msgstr "\"저는 제가 가진 가장 훌륭한 사람들을 모으고 습격을 계획하겠습니다. 우리는 우리의 사람들을 안전하게 데려올 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Cue_0009_Text_String
#. Speaker : Jubilost_Companion
msgctxt "8af4e673-be32-45b9-a7ea-033b420812e4"
msgid ""
"\"This is absurd! As if we didn't already have enough problems with Gralton! "
"Let's pile on a little more! They'll make such a lovely burial mound – over "
"our graves!\""
msgstr ""
"\"이건 말도 안됩니다! 우리는 이미 그랄튼과의 문제는 충분하지 않습니까! 몇개 더 쌓아 봅시다! 그들은 사랑스러운 봉분을 만들 "
"것입니다. 우리의 무덤 위에 말이죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Cue_0011_Text
#. Speaker : Jaethal_Companion
msgctxt "01d9358a-fae7-49cf-b57e-bf4de947d8b3"
msgid ""
"\"That's risky, but bold. In any case, it will send a message that there's "
"no use putting pressure on us.\""
msgstr "\"그건 위험하지만, 대담하기도 합니다. 어느쪽이든, 우리에게 압박을 해봐야 소용 없다는 메시지를 전달할 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Cue_0012_Text
#. Speaker : Ekun_Companion
msgctxt "c3ada7a6-27fa-48f7-9afe-54c1319e26dd"
msgid "\"Better to shed gold than blood.\""
msgstr "\"돈을 흘리는게 피를 흘리는 것 보단 낫습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Cue_0013_Text
#. Speaker : Jubilost_Companion
msgctxt "b61a7956-d3d6-44e8-94f9-b59cb310ff3f"
msgid ""
"\"Very wise. A generous payment would... smooth things over. Even the most "
"powerful ruler appreciates a bit of extra gold.\""
msgstr ""
"\"아주 현명하십니다. 관대한 지불은...일을 매끄럽게 만들 겁니다. 가장 강한 군주라도 약간의 추가금에는 감사를 표하는 법입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Cue_0014_Text_String
#. Speaker : Jaethal_Companion
msgctxt "ef3bd0e8-743a-45a7-900a-77a2f30d0597"
msgid ""
"\"Now we look like rich losers. – The perfect victim. Now all our other "
"neighbors will want to sink their teeth into us. You shouldn't make your own "
"weaknesses so obvious to others.\""
msgstr ""
"\"이제 우리는 돈많은 패배자이자 완벽한 희생자로 보이겠군요. 이제 우리의 모든 이웃들은 우릴 물어뜯으려고 할겁니다. 당신은 당신 "
"스스로의 약점을 다른 사람들에게 명확히 드러내지 말았어야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Cue_0015_Text_String
#. Speaker : Ekun_Companion
msgctxt "5ac3165f-e0b0-4249-b93b-533fb01645aa"
msgid ""
"{n}A deep wrinkle crosses Ekun's forehead.{/n} \"Killing your own people is "
"a bad idea. The others will not understand. We're going to lose their trust."
"\""
msgstr ""
"{n} 에쿤의 이마에 깊은 주름이 생겼습니다.{/n} \"우리 사람들을 죽이는건 좋지 않은 생각 입니다. 다른 사람들이 이해하지 못할 "
"것입니다. 우리는 그들의 신뢰를 잃어버릴 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Cue_0016_Text
#. Speaker : Jubilost_Companion
msgctxt "6dd649c2-6e87-4bee-8e82-522cc65eecba"
msgid ""
"\"That is tough but fair. Espionage is a trade for those who are ready to "
"sweep their conscience under the rug.\""
msgstr "\"이건 거칠지만 타당한 방법입니다. 첩보는 양심을 카펫 밑으로 쓸어보낼 수 있는 사람들에게는 거래의 일종입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Cue_0017_Text
#. Speaker : Jaethal_Companion
msgctxt "0373e837-5241-456e-945f-2f04cfd57100"
msgid ""
"\"Their captives will find a peaceful death. Let Gralton consider this: we "
"don't spare our own people, so we're not likely to show greater mercy to "
"them.\""
msgstr ""
"\"포로들은 평화롭게 죽게 될 것이다. 그랄튼에서 한 가지 생각하도록 만들지: 우리는 우리의 사람들을 아끼지 않는다. 따라서 우리는 "
"포로들에게 자비를 베풀지 않을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Cue_0018_Text
#. Speaker : Jubilost_Companion
msgctxt "21d80f1e-380b-42a2-b6e5-7538a5317d0f"
msgid ""
"\"We must ransom them, and if we can't come to an economical compromise, "
"then we should make them fall silent, forever. We mustn't lose our heads and "
"try to free them by force. Such issues are solved differently by the "
"civilized rulers. You do want to appear civilized to your neighbors, don't "
"you?\""
msgstr ""
"\"놈들 몸값을 지불해야 해. 경제적인 타협안을 얻어낼 수 없다면, 영원히 침묵하게 하든가. 감정적으로 생각해서 힘으로 그들을 구출하려고 "
"해선 안 돼. 이런 문제는 문명화된 지배자에 의해 다른 방식으로 해결되어야 하지.이웃들에게 문명화된 것 처럼 보이고 싶지 않아?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank5/Rank_5Gralton/Cue_0019_Text
#. Speaker : Jaethal_Companion
msgctxt "74d873ab-1550-49d7-8d2b-64c7b5ef8561"
msgid ""
"\"These captives must die before they meet the executioner. They were "
"valuable once, but now they're a dangerous liability. Of course, if you felt "
"you had an obligation to these people, you could attempt to release them by "
"force. But I dislike that option. Gralton might accept a ransom, but we'd be "
"showing weakness.\""
msgstr ""
"\"포로들이 사형집행인을 만나기 전에 죽여야 해. 한때 가치가 있었지만, 지금은 위험한 인물들이야. 물론, 놈들에 대한 의무가 있다고 "
"느낀다면, 그들을 무력으로 구하려 시도할 수 있지. 하지만 난 그런 방법이 싫어. 그랄튼은 몸값을 받아들일지도 몰라. 하지만 우리 약점을 "
"보여주는 꼴이 될 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Answer_0005_Text
msgctxt "fd8c9d1b-c079-42f4-af3a-34a171062dde"
msgid ""
"{g|Espionage6_1}[Choice effects]{/g} \"Pass the information about the "
"Gardeners to the leader of the Revolutionary Council of Galt.\""
msgstr "{g|Espionage6_1}[선택 시 효과]{/g} \"갈트에 있는 혁명 의회장에게 원예사들에 대한 정보를 넘겨주라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Answer_0006_Text
msgctxt "76e040ee-8784-468e-8d80-a6fe53c7a04e"
msgid ""
"{g|Espionage6_2}[Choice effects]{/g} \"Help the Order of Vengeance achieve "
"their revenge.\""
msgstr "{g|Espionage6_2}[선택 시 효과]{/g} \"복수의 기사단이 복수하도록 도우라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Answer_0007_Text
msgctxt "e4f73933-5004-4a53-a41d-90b4193f9717"
msgid ""
"{g|Espionage6_3}[Choice effects]{/g} \"Organize peace negotiations with "
"Litran.\""
msgstr "{g|Espionage6_3}[선택 시 효과]{/g} \"리트란과의 평화협상을 준비 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Answer_0008_Text
msgctxt "ef29183e-1f8a-493b-a357-da5a9aa97a5a"
msgid "\"I'll trust in your judgment.\""
msgstr "\"나는 너의 판단을 믿을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "f751c448-14b1-49a6-91e4-968e882f121b"
msgid ""
"\"We're fighting someone else's war. We aren't Gralton. We aren't Litran. We "
"have no stake in this fight. Let us escape it before we're stabbed in the "
"back. Petitioning for peace is an option, though unreliable. Let's distract "
"them first.\""
msgstr ""
"\"우리는 지금 남들의 전쟁에서 싸우고 있다. 우리는 그랄튼이 아니다. 리트란도 아니지. 이 싸움에 우리 지분은 없다. 뒤를 찔리기 전에 "
"도망치게 해줘. 평화 제안도 한 가지 선택이긴 하다. 믿을 수는 없겠지만. 우선은 저들의 시선을 교란시키자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0002_Text
#. Speaker : Jubilost_Companion
msgctxt "4dfda269-101d-45ce-9c1b-bcb17a9f322d"
msgid ""
"\"Look, {name}, we've suddenly stumbled into the middle of a fight between "
"Litran and Gralton. I don't know who might benefit from this, but it's "
"surely not us. It's time to figure out a way to extricate ourselves from the "
"situation. I suggest we negotiate a peace treaty. However, if you're too "
"proud for such a measure, I'll tell you a couple other options.\""
msgstr ""
"\"{name}, 지금 갑작스럽게 리트란과 그랄튼의 전쟁 사이에 낀 상태가 되었어. 이 싸움으로 누가 득을 볼 지는 모르겠지만, 확실한 "
"건 우리는 아닐 거야. 이 상황에서 빠져나갈 방법을 강구해야 해. 평화 조약을 체결하자고 제안하고 싶어. 이 방법이 자존심 상한다면 몇 "
"가지 다른 방안을 말해줄게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "340c47ed-e221-4b71-882e-462e422a9a65"
msgid ""
"\"We are pulled deeper and deeper into Litran and Gralton's fight. This "
"already drains our forces, and cannot end well. It's time we plan our escape "
"from this situation – preferably something that casts us in a positive "
"light. I can see two options.\""
msgstr ""
"\"리트란과 그랄튼의 싸움에 점점 깊이 끌려가고 있어. 이미 우리 군사들이 소모되어서 좋게는 안 끝날 거야. 이 상황에서 벗어날 방법을 "
"계획할 때가 왔어. 가급적이면 긍정적인 방향으로 향하도록 말이야. 두 가지 방안을 제안할게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0009_Text
#. Speaker : Ekun_Companion
msgctxt "727a369e-5b7b-4737-8554-e8c97261110e"
msgid ""
"\"Very well. I'll send Goss all he'll need to know about the grey masks.\""
msgstr "\"좋아, 고스에게 회색 가면들에 대해 알아야 할 모든 것을 전하겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0010_Text_String
#. Speaker : Jubilost_Companion
msgctxt "48f93908-203b-4a36-998a-042f68186335"
msgid ""
"\"Hm... To be honest, this is not the best decision. You've let a wolf into "
"your house to get rid of the rats. The Gardeners are fanatics, true, but "
"Goss is a manipulative weasel. He's the more dangerous of the two.\""
msgstr ""
"\"흐음... 솔직히 말하면, 이게 최선의 방법은 아니야. 이리 쫓으려고 범을 들인 꼴이니까 말이야. 원예사들은 광신도지. 그래. 하지만 "
"고스는 교활한 족제비야. 둘 중 더 위험한 쪽을 고르자면 고스가 더 위험해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0011_Text
#. Speaker : Jaethal_Companion
msgctxt "6b0c98a7-1dca-4ede-a41e-4118040aac27"
msgid ""
"\"He'll be more than happy to bleed the Grey Gardeners a little. And we've "
"all the information we'll need to begin bloodletting. The ignorant fool "
"won't even stop to think why we shared our knowledge with him.\""
msgstr ""
"\"놈은 회색 원예사들의 피를 볼 수 있다면 더할 나위 없이 기뻐할 거야. 그리고 지금 우리에겐 피를 흩뿌릴 수 있는 정보가 있지. 그 "
"어리석은 바보는 왜 우리가 정보를 공유했을 지에 대해 생각도 못 할 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0012_Text_String
#. Speaker : Ekun_Companion
msgctxt "004202c2-1881-46a5-8a64-547ac8eb8002"
msgid ""
"{n}Ekun shakes his head.{/n} \"We have delivered {g|Galt}Galt{/g} into war. "
"I'm afraid it's a gift that Galt will return as soon as they are able.\""
msgstr ""
"{n}에쿤은 머리를 흔들었습니다.{/n} \"{g|Galt}갈트{/g} 를 전쟁으로 이끌었다. 놈들이 안정을 찾으면 우리에게 이 선물에 "
"대한 답례를 해올 거 같군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0013_Text
#. Speaker : Jubilost_Companion
msgctxt "0d19e677-2ff0-4f3f-b03f-0a042f2ec8d7"
msgid ""
"\"This inane war between the two countries was bound to happen eventually. "
"At least we might profit from it. That will have to be good enough for now.\""
msgstr "\"두 국가 간의 이 무의미한 전쟁은 어떻게든 일어나게 되어있었어. 최소한 이득은 챙겨야 해. 지금으로썬 그게 최선이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0014_Text
#. Speaker : Jaethal_Companion
msgctxt "392c9dd4-9a52-44fb-a44a-5e005bf01139"
msgid ""
"\"Litran will forget all about us, once the partisans seize "
"{g|Galt}Galt's{/g} borderlands. The Grey Gardeners should never have crossed "
"us.\""
msgstr ""
"\"게릴라들이 {g|Galt}갈트{/g} 의 국경을 장악하면 리트란은 우리에 대해서 완전히 잊어버릴 거야. 회색 원예사들은 우릴 배신하지 "
"말았어야 했어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0015_Text
#. Speaker : Ekun_Companion
msgctxt "7aba993b-9db8-40ca-be99-e7f4daa30819"
msgid ""
"{n}Ekun stretches shoulder.{/n} \"It might work. Litran is dangerous, but "
"they are no fools. We are not their enemy.\""
msgstr "{n}에쿤은 어깨를 폅니다.{/n} \"잘 될 거다. 리트란은 위험하지만 바보는 아니니. 우린 저들의 적이 아니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0016_Text
#. Speaker : Jubilost_Companion
msgctxt "c4ad9d41-d6e7-4e71-8ac6-14b7782d1d55"
msgid ""
"\"That is most wise. I will send an ambassador to Litran. I do hope they "
"won't decapitate him... No, no, they mustn't.\""
msgstr ""
"\"참으로 현명한 결정이야. 리트란에 사절을 보내겠어. 사절의 목을 자르지 않으면 좋겠는데... 아니, 아니, 자르면 안 되지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0017_Text_String
#. Speaker : Jaethal_Companion
msgctxt "b02f6411-10a7-4d2f-abee-0842033a470e"
msgid ""
"\"You want me to beg them for peace? How revolting! Do you even see the "
"giant gap there is between us?!\""
msgstr "\"나더러 평화를 구걸하라고? 참으로 역겹군! 우리 사이에 있는 커다란 감정의 골이 보이지 않는 거야?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0018_Text
#. Speaker : Jaethal_Companion
msgctxt "95ea2bcd-bfa3-4b44-a528-81da99c3ec9e"
msgid ""
"\"We could convince the Grey Gardeners simply to forget about us. All we "
"need do is deliver their names to Korran Goss, the head of {g|Galt}Galt's{/g}"
" Revolutionary Council. He's afraid of the scaffold that ended the lives of "
"his forerunners, so he will take the chance to undermine the revolution's "
"guardians. The Gardeners will suddenly be fighting for survival, and in any "
"case will have more pressing needs than worrying about us.\""
msgstr ""
"\"회색 원예사들이 그냥 우리에 대해 잊어버리게 할 수도 있어. 우리가 해야 할 일은 코란 고스, 그 {g|Galt}갈트{/g} 의 혁명 "
"의회장에게 원예사들의 이름을 가르쳐주는 것 뿐이야. 놈은 자기 전대 의회장들을 목매단 처형대를 두려워하고 있는 상황인지라 혁명을 막는 "
"자들을의 지지기반을 약화시키고 있지. 원예사들은 생존을 위해 갑자기 싸우게 될 거야. 어쨌든 당장 발등에 떨어진 불부터 꺼야 할 테니 "
"우리한테 신경쓸 여유는 사라지겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0019_Text
#. Speaker : Jaethal_Companion
msgctxt "d037c71c-dede-4bd8-a7e9-02573dfa6e04"
msgid ""
"\"Another enemy, also thirsty for the Gardeners' blood, is a secret society "
"from Gralton – the Order of Vengeance. They've sworn loyalty to "
"{g|Calistria}Calistria{/g}, in the hope that she will help them avenge their "
"losses. We could aid them in forming an alliance with Gralton. They would "
"start harassing {g|Galt}Galt's{/g} borderland, which will occupy the "
"Gardeners' full attention. I will enjoy seeing my enemies bleeding to death "
"in a battle that I caused.\""
msgstr ""
"\"원예사들의 피에 목마른 또 다른 적은 그랄튼의 비밀단체인 복수의 기사단이야. 놈들은 {g|Calistria}칼리스트리아{/g}가 "
"자신들의 복수를 도와줄 것을 바라며 충성을 맹세했지. 저들을 도와서 그랄튼과 동맹을 형성할 수 있어. {g|Galt}갈트{/g} 국경을 "
"괴롭혀줄 거고, 원예사들의 관심을 한 몸에 받겠지. 난 내가 만들어낸 전쟁으로 적들이 피를 흘리는 걸 보는 게 좋다니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0020_Text
#. Speaker : Jubilost_Companion
msgctxt "4403c990-4e8a-421f-ad67-236e8ab8f4d0"
msgid ""
"\"The Grey Gardeners have a more attractive enemy than us – and they're "
"nearer to hand as well! Of course I'm speaking of the Revolutionary Council "
"of {g|Galt}Galt{/g}, headed by Goss. After all, the Gardeners' favorite "
"pastime is to behead members of the council 'for the benefit of the "
"revolution' – so Goss prefers to keep a low profile. He fears that his "
"government could be decapitated, in every meaning of the word. But if we "
"give him something to sink his teeth into, he might decide to go after the "
"Gardeners after all. However, I would avoid this course. If Goss prevails, "
"he could become even worse than the Gardeners.\""
msgstr ""
"\"회색 원예사라는 놈들은 우리보다 매력적인 적을 많이 데리고 다니는군. 게다가 그 적이라는 놈들, 거의 코 앞에 있잖아! 물론 내가 "
"말하는 적이란{g|Galt}갈트{/g} 에서 고스가 이끄는 혁명 의회를 말해. 어쨌든 원예사들이 제일 좋아하는 취미는 '혁명을 위하여' "
"라는 명목 하에 의회단원들의 목을 베는 거야. 그래서 고스는 몸을 사리려고 하지. 놈은 어떤 의미로든 자기네들 목이 달아나는 걸 겁내고 "
"있어. 하지만 이쪽에서 뭔가 계기만 만들어 준다면, 원예사들을 향해 덤벼들겠지. 물론 나는 이런 방향은 반대할 거지만. 고스가 이기면 "
"원예사들보다 더한 놈이 될 게 분명하거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0021_Text
#. Speaker : Jubilost_Companion
msgctxt "8b272da0-34d0-47bc-abad-84eeb35040e0"
msgid ""
"\"Another way to distract Litran's attention is the Order of Vengeance, a "
"secret society in Gralton. They are avengers, who seek to repay injuries "
"suffered during the revolution. If we aid them in forming an alliance with "
"Gralton, the Order could engage in guerrilla warfare on the borderlands. A "
"shame that this mess will be taking place just next door.\""
msgstr ""
"\"리트란의 시선을 분산시킬 다른 방법은 그랄튼의 비밀 조직인 복수의 기사단을 이용하는 거야. 놈들은 혁명에서 받은 고통을 되돌려주려 "
"하는 복수귀들이지. 우리가 놈들을 도와 그랄튼과 동맹을 맺게 되면 기사단이 국경에서 게릴라 전투를 시도할 거야. 바로 옆집에서 이런 일이 "
"벌어지다니 참으로 안타까워.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0022_Text
#. Speaker : Ekun_Companion
msgctxt "61f70cd5-2b6b-4aa8-a29a-8b881b96cdd5"
msgid ""
"\"You cannot deal with the Grey Gardeners, but death already stalks them "
"closely. Korran Goss rules {g|Galt}Galt{/g}, and he is wary of the "
"Gardeners. They decapitated more than one of his predecessors, and he'll "
"strike if we give him a target. He'll find good reason – a betrayal. We can "
"expect to be left alone after that.\""
msgstr ""
"\"우리는 회색 원예사들을 상대할 수 없다. 하지만 이미 놈들에겐 죽음의 기운이 드리우고 있지. 코란 고스가 {g|Galt}갈트{/g} "
"를 다스리고있고, 그자는 지금 원예사들을 경계하고 있다. 목을 벤 사람의 수가 전임자보다 훨씬 많아서 우리가 고스에게 목표를 지정해준다면 "
"공격을 개시할 거다. 명분은 고스가 만들겠지. 배신이라고 말이다. 그 뒤로는 맡겨만 두면 될 거다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Galt/Cue_0023_Text
#. Speaker : Ekun_Companion
msgctxt "8fcfca47-9d05-4bfb-b67b-625b4c49abad"
msgid ""
"\"We have another option, but it leads us down a dangerous path. There is an "
"Order of Vengeance in Gralton, wild avengers with deeply wounded hearts. "
"They look to settle scores, but their numbers are too few. We could draw "
"them into an alliance with Gralton, and their numbers will grow. They would "
"return to {g|Galt}Galt{/g} to exact their vengeance, and the Gardeners would "
"become too busy to bother with us. But blood will flow. And they'll remember "
"what we've done!\""
msgstr ""
"\"다른 방법도 있다. 하지만 좀 위험한 길이지. 그랄튼에는 복수의 기사단이 있다. 상처입은 복수귀들이 그들이지. 놈들은 복수를 원하고 "
"있다. 하지만 수가 너무 적다. 놈들을 끌어와 그랄튼과 동맹을 맺으면 놈들도 수가 늘어날 것이다. 놈들이 {g|Galt}갈트{/g}로 "
"돌아가 복수를 꾀하면 원예사들도 우리에게 눈길을 주기 어려울 것이다. 하지만 피가 흐르겠지. 저들도 우리가 한 짓을 기억할 거고 말이야!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Answer_0005_Text
msgctxt "4ca58670-90d6-494e-87cf-9d5841f37b88"
msgid ""
"{g|Espionage6_4}[Choice effects]{/g} \"Help Casal Tarne face his cousin.\""
msgstr "{g|Espionage6_4}[선택 시 효과]{/g} \"카살 타른과 조카가 만나는 것을 도우라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Answer_0006_Text
msgctxt "a21efb31-c3c4-47f9-ae65-2f7203ac2eb9"
msgid ""
"{g|Espionage6_5}[Choice effects]{/g} \"Dispatch soldiers to the Grey "
"Gardeners.\""
msgstr "{g|Espionage6_5}[선택 시 효과]{/g} \"회색 원예사에게 병사를 보내라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Answer_0007_Text
msgctxt "50717ec9-3e50-4ef5-a164-e7818a6ef048"
msgid ""
"{g|Espionage6_6}[Choice effects]{/g} \"Arrange peaceful negotiations with "
"Gralton.\""
msgstr "{g|Espionage6_6}[선택 시 효과]{/g} \"그랄튼과의 평화 협상을 준비하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Answer_0008_Text
msgctxt "ee0a0175-8797-421e-ae78-53271999536d"
msgid "\"I'll trust your judgment.\""
msgstr "\"나는 너의 판단을 믿을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "e5ea73e6-5a76-4429-ae36-07ad8231bd0f"
msgid ""
"\"We're fighting someone else's war. We aren't Gralton. We aren't Litran. We "
"have no stake in this fight. Let us escape it before we're stabbed in the "
"back. Petitioning for peace is an option, though unreliable. Let's distract "
"them first.\""
msgstr ""
"\"우리는 지금 남들의 전쟁에서 싸우고 있다. 우리는 그랄튼이 아니다. 리트란도 아니지. 이 싸움에 우리 지분은 없다. 뒤를 찔리기 전에 "
"도망치게 해줘. 평화 제안도 한 가지 선택이긴 하다. 믿을 수는 없겠지만. 우선은 저들의 시선을 교란시키자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0002_Text
#. Speaker : Jubilost_Companion
msgctxt "30627b3e-f637-437d-9373-509139384037"
msgid ""
"\"Look, {name}, we've suddenly stumbled into the middle of a fight between "
"Litran and Gralton. I don't know who might benefit from this, but it's "
"surely not us. It's time to figure out a way to extricate ourselves from the "
"situation. I suggest we negotiate a peace treaty. However, if you're too "
"proud for such a measure, I'll tell you a couple other options.\""
msgstr ""
"\"이것봐 {name}, 우린 지금 갑작스럽게 리트란과 그랄튼의 전쟁 사이에 낀 상태가 되었어. 이 싸움으로 누가 득을 볼 지는 "
"모르겠지만, 확실한 건 우리는 아닐 거야. 이 상황에서 빠져나갈 방법을 강구해야 해. 평화 조약을 체결하자고 제안하고 싶어. 이 방법이 "
"자존심 상한다면 몇 가지 다른 방안을 말해줄게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "4b5ff133-0815-4d83-9ed2-ee8e26f4733d"
msgid ""
"\"We are pulled deeper and deeper into Litran and Gralton's fight. This "
"already drains our forces, and cannot end well. It's time we plan our escape "
"from this situation – preferably something that casts us in a positive "
"light. I can see two options.\""
msgstr ""
"\"리트란과 그랄튼의 싸움에 점점 깊이 끌려가고 있어. 이미 우리 군사들이 소모되어서 좋게는 안 끝날 거야. 이 상황에서 벗어날 방법을 "
"계획할 때가 왔어. 가급적이면 긍정적인 방향으로 향하도록 말이야. 두 가지 방안을 제안할게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0009_Text
#. Speaker : Ekun_Companion
msgctxt "4c8c4f7d-710e-4a7c-8fa2-ed50f3683716"
msgid ""
"{n}Ekun nods.{/n} \"While the wolves fight in Gralton for dominance, we can "
"disappear without a trace. And without any further losses.\""
msgstr ""
"{n}에쿤은 고개를 끄덕입니다.{/n} \"늑대가 패권을 놓고 그랄튼에서 싸우는 동안, 우리는 흔적없이 사라질 수 있다. 그리고 더 큰 "
"손실도 없이 말이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0010_Text
#. Speaker : Jubilost_Companion
msgctxt "6a771bb8-4979-449e-9a7c-a1a4c5c41b0d"
msgid ""
"\"Hopefully, once this mob of aristocrats stops fighting, they won't "
"remember what the whole thing started with...\""
msgstr "\"이 귀족들이 싸움을 멈출 수만 있다면 싸움의 원인 따위는 생각하지도 않을 거야...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0011_Text
#. Speaker : Jaethal_Companion
msgctxt "3233af64-a5ee-4123-9887-38f4ee2efdd9"
msgid ""
"\"The short-lived are so easily manipulated. They're always seeking "
"massacres, as if to make their lives even shorter. We'll just give them a "
"little push, and they'll be trapped in bloody conflict!\""
msgstr ""
"\"필멸자들은 항상 쉽게 선동되지. 더 단명하고 싶은 것 마냥 학살을 원해. 조그만 계기만 주어진다면, 필멸자들은 피비린내나는 갈등에 "
"갇히고 말지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0012_Text_String
#. Speaker : Ekun_Companion
msgctxt "0758dd73-3456-48e5-9af8-7c09b51f77fe"
msgid ""
"{n}Ekun winces.{/n} \"We help the Gardeners grow stronger. But do not expect "
"friendship from one who fails to see a friend in anyone.\""
msgstr ""
"{n}에쿤은 찡그립니다.{/n} \"우리는 원예사들이 더 강해지게 도울 것이다. 그러나 사람들 사이에서 단 한 명의 친구도 만들지 못하는 "
"이에게 우정을 기대하지는 마라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0013_Text_String
#. Speaker : Jubilost_Companion
msgctxt "6d4aa46b-14a2-4c4f-af59-80965e77a454"
msgid ""
"\"What a disgusting alliance. Don't think for a moment that I approve of "
"cooperating with them. I always try to stay away from two types of people: "
"rulers who seek to restrict thought, and rulers like you, who associate with "
"bloodthirsty lunatics.\""
msgstr ""
"\"참으로 역겨운 동맹이군. 그들과 함께 일하는 것에 내가 동의할 거라고는 절대 생각하지 마. 나는 언제나 두 종류의 사람을 멀리하지. "
"사상을 억압하는 지배자와, 너처럼 피에 굶주린 광기로 이루어진 지배자를.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0014_Text
#. Speaker : Jaethal_Companion
msgctxt "c135ee88-036a-4903-b522-569b1962ed67"
msgid ""
"\"The Gardeners will strike Gralton with vicious force. The bloodshed will "
"remind Gralton's people that there's a price for challenging us!\""
msgstr ""
"\"원예사들은 포악하게 그랄튼을 공격 할 거야. 거기서 흐르는 피가 그랄튼 사람들한테 우리에게 대적하면 대가가 따른다는 것을 알려주겠지!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0015_Text
#. Speaker : Ekun_Companion
msgctxt "87478d02-e71d-4590-913b-eee391ee0ca9"
msgid "{n}Ekun nods.{/n} \"A peaceful resolution is the best outcome.\""
msgstr "{n}에쿤은 고개를 끄덕입니다.{/n} \"평화로운 해결책이 곧 최선의 결과다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0016_Text
#. Speaker : Jubilost_Companion
msgctxt "9915c378-11b8-4058-91fb-9c0f8e59b081"
msgid ""
"\"This is wise. I'll send ambassadors to Gralton. We must make peace – and "
"then figure out how things could have gone so far! I suppose it would never "
"have gone this far if I had a more flexible and less dignified ruler. But "
"that's just an assumption.\""
msgstr ""
"\"현명하군. 그랄튼에 사절을 파견하겠다. 우리는 반드시 평화를 이루어야 한다. 그리고 상황이 어쩌다 이렇게까지 됐는지 파악해야 한다. "
"내 생각에는 더 융통성있고 덜 근엄한 통치자가 있었다면, 상황이 이렇게 되는 일은 없었을 것이다. 하지만 이건 그냥 하나의 가정일 뿐이지."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0017_Text_String
#. Speaker : Jaethal_Companion
msgctxt "4dde7b96-7ea1-4c3f-b452-bf3bd6a343c4"
msgid ""
"\"You want me to beg them for peace? How revolting! Do you even see the "
"giant gap there is between us?!\""
msgstr "\"나더러 평화를 구걸하라고? 참으로 역겹군! 우리 사이에 있는 커다란 감정의 골이 보이지 않나?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0020_Text
#. Speaker : Jaethal_Companion
msgctxt "33bcd6bc-854e-4563-a318-fd76ff9e4d0f"
msgid ""
"\"Halidan Tarne is the commander of Gralton's army. He's the general that "
"sending his raiders to {g|Galt}Galt{/g}. This commander is as bloodthirsty "
"and narrow-minded as any other military man. His cousin, Casal, envies his "
"relative but he's too cautious to disturb Gralton's fragile balance. But if "
"you help Casal gain a piece of Halidan's power, they'll busy themselves with "
"their own problems and leave us be.\""
msgstr ""
"\"할리단 타른은 그랄튼 군의 지휘관이다. 그는 침입자들을 {g|Galt}갈트{/g}로 보낸 장본인이지. 그는 다른 군인들 만큼이나 피에 "
"굶주렸고 편협하다. 그의 사촌 카살은 자기 친척을 질투하지만 그랄튼의 아슬아슬한 균형을 무너트리기에는 너무 조심스럽지. 하지만 네가 "
"카살을 도와 할리단의 힘 중 일부를 얻을 수 있게 도와준다면, 그들은 자기들 문제만으로도 충분히 바빠질 거고, 우리를 내버려 두겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0021_Text
#. Speaker : Jaethal_Companion
msgctxt "b7eaea19-9da3-4e15-8239-2dfaa635c7a6"
msgid ""
"\"On the other hand, we could involve Gralton in a fight with Litran. The "
"Grey Gardeners' greatest strength is spywork and intelligence, and I respect "
"their consistency and ferocity... But they need more soldiers. Real "
"fighters. If we send them some experienced warriors, Gralton will focus all "
"its time and energy on preventing Litran from crushing them. We ourselves "
"cannot afford to make those arrogant fools from Gralton weep blood, but I'll "
"enjoy watching the Grey Gardeners do it for us.\""
msgstr ""
"\"반면에, 우리는 리트란과의 싸움에 그랄튼을 참여시킬 수 있어. '회색 원예사'의 가장 강한 부분은 바로 첩보력과 정보력이지. 그리고 "
"나는 그들의 일관성과 흉포함을 존중하고... 하지만 그들에겐 더 많은 병사가 필요해. 진정한 전사들 말이야. 만약 우리가 그들에게 경험 "
"많은 전사들을 몇 명 보내준다면, 그랄튼은 그들의 시간과 에너지를 리트란이 그들을 파괴하는것을 막기 위해 집중시킬테지. 우리 스스로는 "
"그랄튼의 오만한 바보들이 피를 흘리게 만들 형편이 못되지만, 회색 원예사들이 우리를 위해 그렇게 해준다면 즐겁게 관람할 수 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0022_Text
#. Speaker : Jubilost_Companion
msgctxt "406ec3bd-fa35-4bc8-9047-3d11c71fcf56"
msgid ""
"\"Officially, I must mention the third option. The Grey Gardeners. Good "
"executioners, but poor soldiers. If we sent them more troops, Gralton would "
"begin to smolder under the Gardeners' pressure. Although I don't think "
"supporting these butchers is a good idea. So let's not discuss it further.\""
msgstr ""
"\"공식적으로, 나는 세번째 선택지를 말해야만 하겠어. 회색 원예사들에 대해서. 좋은 처형자이지만, 병사로는 나쁜 놈들이지. 만약 우리가 "
"그들에게 더 많은 병사들을 보내준다면, 그랄튼은 원예사의 압력에 쪼그라들기 시작할거야. 다만 나는 그 도살자들을 지원하는게 좋은 "
"방법이라고 생각하지는 않아. 그러니 이 방법은 더 논의하지 말았으면 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0023_Text
#. Speaker : Jubilost_Companion
msgctxt "8b58f74e-692c-42fc-ba37-f3584e290a8b"
msgid ""
"\"Gralton has many groups vying for power: the Wise, the Order of Vengeance, "
"the Nameless, the Hand That Takes, the Directorate, and many other fancy "
"names. There are also the people of Halidan Tarne, Casal Tarne... Speaking "
"of which... they're cousins. The former is the army general, and the latter "
"is the leader of the sentry guard. Halidan is a wild daredevil, while Casal "
"is a careful fool. But Casal envies his cousin and his brave soldiers. If "
"you help him take over something that belongs to Halidan, they'll busy "
"themselves with their own problems and leave us be.\""
msgstr ""
"\"그랄튼 내부에는 힘을 겨루고 있는 많은 집단들이 존재해. 현명한 자. 복수의 기사단. 이름없는 자. 가져가는 손. 이사회. 그리고 "
"다른 멋진 이름들도 많지. 또한 할리단 타른, 카살 타른같은 사람들도 있고... 걔들에 대해 말하라면... 사촌들이야. 전자는 군대의 "
"장군이고, 후자는 수비대의 대장이다. 할리단은 본능적이고 무모한 사람인 반면, 카살은 조심성이 많은 바보지. 하지만 카살은 그의 사촌과 "
"그의 용감한 병사들을 부러워하고 있어. 만약 네가 개입해 할리단이 가지고 있는 뭔가를 카살이 접수하도록 도와준다면, 그들은 자기들의 "
"문제를 해결하느라 바빠져서 우리를 내버려 둘거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0024_Text
#. Speaker : Ekun_Companion
msgctxt "a55716dd-64ca-4334-997a-308ab0ca7a7d"
msgid ""
"\"There's a good solution. Gralton is like a serpents' nest. Many squads, "
"many commanders, all of them vying for power. If we aid the weak in taking "
"something that belongs to a strong, the delicate balance will shift. They'll "
"busy themselves with their own problems and leave us be. Casal Tarne, the "
"head of the guards, is weaker than his cousin. Halidan Tarne, the army's "
"commander, is the stronger of the two. Let us pit them against each other.\""
msgstr ""
"\"좋은 해결책이 있다. 그랄튼은 뱀의 소굴과도 같다. 많은 부대와, 많은 사령관들, 그들 모두가 서로의 힘을 팽팽히 겨루고 있다. 만약 "
"우리가 강한 편이 가지고 있는 뭔가를 약한 편이 뺏을 수 있게 돕는다면, 그 미묘한 균형이 깨질거다. 그러면 그들은 자기들 문제를 해결 "
"하느라 바빠져 우리를 내버려 두겠지. 수비대의 대장 카살 타른이 그의 사촌보다 약한 편이다. 군 사령관인 할리단 타른은 둘 중 강한 "
"편이고. 둘이 한 판 붙게 만들어보자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank6/Rank6_Gralton/Cue_0025_Text
#. Speaker : Ekun_Companion
msgctxt "f4c39481-8608-4ad7-96c5-c62e1274af0c"
msgid ""
"\"There's another solution, too, but it leads us down a dangerous path. We "
"could aid the enemy of our enemy, the Grey Gardeners. They have punishers "
"and spies, but few soldiers. If we send them more troops, the Gardeners will "
"engage with Gralton. They'll keep themselves busy with their own problems "
"and leave us be. But I would not advise interfering. They are cruel and know "
"no mercy.\""
msgstr ""
"\"다른 방법이 더 있다. 하지만 이건 좀 위험한 편이다. 우리 적의 적을 지원하는 방법이다. 회색 원예사들. 그들은 집행자와 첩자들을 "
"가지고 있지만, 병사들은 적다. 만약 우리가 그들에게 더 많은 병력을 보내준다면, 원예사들이 그랄튼과 붙게 될 것이다. 그들은 자기 "
"문제를 해결하느라 바빠지고, 우리를 내버려두게 될테지. 하지만 이렇게 간섭하는 것은 권하지 않는다. 그들은 잔인하고 자비가 없으니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Answer_0010_Text
msgctxt "e2fcc447-679b-4a07-a472-c42bda0dd1bf"
msgid "\"Tell me more about each candidate.\""
msgstr "\"각 후보자에 대해 더 말해 보라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Answer_0050_Text
msgctxt "65dc9658-6c28-4687-8011-30347eccaf10"
msgid "\"I see. I will assign an advisor to resolve this issue.\""
msgstr "\"알겠다. 보좌관을 보내 이 문제를 해결하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "96cbd032-2442-4745-a910-2400cc4539b1"
msgid ""
"{n}Ekun seems embarrassed, and his eyes do not rise from the floor.{/n} \"Bad"
" news, {name}. We've been cheated. The double agent, the scribe from "
"Gralton, the whole story... We've been deliberately pulled into someone "
"else's war by an unknown third party.\""
msgstr ""
"{n}에쿤은 당황한 듯 보입니다. 그는 눈을 바닥에서 떼지 못 합니다.{/n} \"나쁜 소식이다, {name}. 한 방 먹었다. 이중 "
"첩자, 그랄튼의 필경사, 모든 이야기가... 알려지지 않은 제삼자의 계략에 놀아나 고의적으로 다른 국가의 전쟁에 휘말린 꼴이 되었다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0002_Text
#. Speaker : Jubilost_Companion
msgctxt "a17d7f9a-e701-42c0-a98a-673c44a9d600"
msgid ""
"\"There's been a mistake, {name}. Someone – I don't yet know exactly who – "
"played us. The double agent that came to us, Daggermark's spy, the scribe... "
"It was all a scheme to pull us into a fight with our neighbors! We've been "
"manipulated and trapped!\""
msgstr ""
"\"실수가 있었어, {name}. 누군지는 정확히 모르겠지만, 우린 농락당했어. 우리에게 찾아온 이중 첩자, 대거마크의 첩자, "
"필경사... 모든 게 다 우리를 이웃과 싸우게 하려는 계책이었어! 함정에 걸렸다고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "0937903a-5d67-4689-a457-459aa97b2721"
msgid ""
"\"{name}, I don't think you're going to like the news I bring. We've been "
"deliberately pulled into the conflict between Gralton and Litran. A third "
"player, thus far unknown, sent us this mercenary and plotted his failure. "
"They arranged for us to discover the Litran spy, and then our actions were "
"disclosed to the enemy.\""
msgstr ""
"\"{name}, 듣기 좋아할만한 소식은 아니야. 누군가 고의적으로 그랄튼과 리트란의 분쟁에 우리를 집어넣었어. 제 삼의 세력이 이 "
"용병을 보내서 놈의 실패를 꾸몄어. 놈들은 우리가 리트란의 첩자를 발견하도록 꾸몄어. 그리고 우리 행동이 적에게 노출된 상태야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0011_Text
#. Speaker : Ekun_Companion
msgctxt "413b939c-3fcc-4135-837f-84441fcc5098"
msgid ""
"\"The Twilight Talons from Andoran are masters of covert war. They are as "
"dangerous as they are loyal. It's just that... they care more for their "
"appearance than their worth.\" {n}Ekun frowns.{/n} \"They serve their own "
"country, but it would be good if the Grand Diplomat persuaded them to help "
"us. The Sleepless Agency are urban hunters. Private detectives. And they "
"aren't cheap. The Treasurer will have to bargain hard for them. But they're "
"worth the money.\""
msgstr ""
"\"안도란의 황혼의 발톱단은 은밀한 전쟁의 달인이다. 충성심이 높은 만큼 위험하지. 다만 자신들의 값어치보다 치장을 더 중요시 여긴다는 "
"단점이 있긴 하지만...\" {n}에쿤은 찡그립니다.{/n} \"황혼의 발톱단은 안도란을 위해 일하지만 우리 수석 외교관이 놈들을 우릴 "
"위해 일할 수 있게 설득한다면 좋겠지. 불침 보안사는 도시의 사냥꾼들이다. 사설 탐정 집단이지. 가격도 꽤나 비싸. 재무관이 돈을 "
"깎으려면 꽤나 힘 좀 써야 할 거다. 하지만 돈 값은 하는 놈들이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0012_Text
#. Speaker : Jubilost_Companion
msgctxt "7ca1f9ca-776e-4970-81f2-f2dbf5ef72d3"
msgid ""
"\"The Twilight Talons are a squad of Andoran's best fighters. The Grand "
"Diplomat will have to make a heroic effort if there's any hope of bringing "
"them here. But their daggers and their capes are as famous as their snobbish "
"attitudes. The Sleepless Agency is a private company that provides security "
"and investigative services. Its staff are experienced and expensive "
"mercenaries. I'm not sure if the Treasurer can persuade them.\""
msgstr ""
"\"황혼의 발톱단은 안도란 최고 전사들로 이루어진 부대야. 놈들을 여기로 데려오려면 수석 외교관이 힘 깨나 써야 할 거야. 그래도 놈들의 "
"단검과 망토는 그 거만한 태도 만큼이나마 유명하지. 불침 보안사는 경비와 조사를 제공하는 사설 집단이야. 그쪽 직원들은 경험 많고 "
"고용하려면 돈도 많이 깨지는 용병들이지. 재무관이 놈들을 설득할 지 잘 확신이 안 서네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0013_Text
#. Speaker : Jaethal_Companion
msgctxt "a06d8832-dcb6-402e-9540-57c71f6f409f"
msgid ""
"\"The Twilight Talons and Sleepless Agency use similar methods. Both are "
"experienced spies and assassins. The former are the spy branch of the Eagle "
"Knights regiment. The Grand Diplomat will have to deal with them. The latter "
"are private detectives from Ustalav. They work for anyone willing to pay. "
"The Treasurer will have to release more funds than we're used to.\""
msgstr ""
"\"황혼의 발톱단과 불침 보안사는 둘 다 비슷한 방법을 사용해. 둘 다 숙련된 첩자임과 동시에 암살자들이지. 전자는 독수리 기사단 연대에 "
"소속된 첩자 집단이야. 놈들을 데려오려면 수석 외교관을 대동해야겠지. 후자는 우스탈라브 출신의 사설 탐정들이이야. 돈만 주면 누구든 "
"가지지 않고 일해. 놈들을 고용하려면 평소에 쓰는 돈 보다 더 많은 돈을 써야 할 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0030_Text
#. Speaker : Ekun_Companion
msgctxt "e186bf2f-571d-4c64-b698-a45f89fc7c1d"
msgid ""
"\"We must clear the ranks. I don't know which of them we can trust, so I'd "
"bring in completely new people. – People who cannot be bribed by the enemy, "
"preferably from distant lands. We could hire the bloodhounds of the "
"Sleepless Agency... or of course we could turn to Irori's oracles. But the "
"Twilight Talons from Andoran are the only ones I would trust with my life. "
"You can rely upon their word.\""
msgstr ""
"\"놈들을 처리해야 한다. 어느 쪽을 믿어야 할 지는 모르겠어서 완전히 새로운 사람들을 데려왔다. 적에게 매수되지 않는, 가급적이면 먼 "
"곳에 있는 사람을 말이다. 불침 보안사의 사냥개를 고용할 수도 있다... 아니면 이로리의 예지자들에 의존하거나. 하지만 안도란의 황혼의 "
"발톱단은 내 인생을 걸고 믿을만한 자들이라 할 수 있다. 놈들은 믿어도 된다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0031_Text
#. Speaker : Jubilost_Companion
msgctxt "c5473347-6b99-4516-aa57-ecb307aa88dc"
msgid ""
"\"We must clear the infestation from our ranks at once! This should be done "
"by someone from the outside, someone uninvolved with the plot. We should "
"contact the Sleepless Agency detectives or the gentlemen of the Twilight "
"Talon. Or we could ask the Irori oracles for help... if we would reach an "
"agreement with them.\""
msgstr ""
"\"우리 땅에서 침략자들을 몰아내야 해. 지금 당장 말이야! 그러려면 외부의 인물을 끌어들여야겠지. 음모와는 관계 없는 사람들로 말이야. "
"불침 보안사의 탐정들이나 황혼의 발톱단의 신사들과 연락해봐도 돼. 아니면 이로리의 예지자에게 물어봐도 되지... 놈들과 협상이 된다면 "
"말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0032_Text
#. Speaker : Jaethal_Companion
msgctxt "e275894c-5af6-48b9-a93d-10298cfcd16d"
msgid ""
"\"It's time to hunt down the rats. We should bring in outsiders, whose hands "
"are clean. I have several candidates to offer. But I wouldn't bother "
"contacting the Twilight Talons, knights from Andoran. They're experienced, "
"but they would never serve us. They serve their own people. However, the "
"detectives of the Sleepless Agency might do. Irori's oracles are good, too.\""
msgstr ""
"\"쥐새끼들을 사냥할 때가 왔어. 우리와는 관계 없는 외부인사들을 끌어들여야 해. 후보자가 몇 있긴 해. 하지만 나라면 안도란의 기사들인 "
"황혼의 발톱단과는 연락 안 할거야. 물론 경험은 많지만, 우릴 진심으로 섬길 리가 없거든. 놈들은 자국민들만을 위해 일해. 반면 불침 "
"보안사의 탐정들은 우릴 잘 섬길 거야. 이로리의 예지자도 도움이 되겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0033_Text
#. Speaker : Ekun_Companion
msgctxt "9b1dd865-8626-4704-bc9e-fbd3383b2548"
msgid ""
"\"Irori's oracles are seers who serve the god of knowledge. They are honest. "
"And rare. But I hear they can be found in the East. If we offer them the "
"knowledge of our priests, they might look into the darkness for us, and find "
"the faces of our enemies.\""
msgstr ""
"\"이로리의 예언자들은 지식의 신을 섬기는 자들이다. 이들은 정직하지만 보기 드물지. 하지만 동쪽에서 발견되었다는 소식을 들었다. 우리 "
"사제들에 대한 지식을 제공하면 우리가 모르는 것들에 대해 알려주고 적들의 정체를 밝힐 수 있을 거다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0035_Text
#. Speaker : Jubilost_Companion
msgctxt "7c5e60bf-2666-488c-a24d-a50d3201262b"
msgid ""
"\"The oracles have been given the gift of divination by their Irori, the god "
"of knowledge and self-perfection. I hear there's an isolated coven of "
"Irori's oracles in Dunsward. We could persuade them to uncover the faces of "
"our enemies – in exchange for generously sharing our priests' knowledge.\""
msgstr ""
"\"예언자들은 지식과 완벽의 신인 이로리로부터 점성술의 재능을 물려받은 사람들이야. 내가 듣기론 던스워드에 이로리 예언자들의 집회가 "
"있다고 하더군. 그들을 설득해 우리 적들의 정체를 밝힐 수 있을 거야. 대가로 우리 사제들의 지식을 제공하면 되겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0037_Text
#. Speaker : Jaethal_Companion
msgctxt "2193649d-d459-437e-9d7c-cf765c142da9"
msgid ""
"\"Oracles are the servants of gods who can see what others keep hidden. I "
"heard that a small group of Irori's oracles live in an isolated community "
"somewhere on the outskirts of Dunsward. They could surely help us if we "
"promised to share with them the knowledge of our priests.\""
msgstr ""
"\"예언자들은 남들이 숨겨놓은 것을 볼 수 있는 신의 하수인이지. 던스워드 외곽의 어딘가에 작은 이로리 예언자들 무리가 실고있다고는 "
"들었어. 우리가 우리쪽 사제들의 지식을 전수해준다면 분명 도와주러 올 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0040_Text
#. Speaker : Jaethal_Companion
msgctxt "da51d87b-a6be-43ff-b907-2e7f55539ea5"
msgid ""
"\"During all this time, while we were wasting energy on a useless war, our "
"intelligence was being infiltrated by the spies of an unknown party! I no "
"longer trust any of my subordinates. I've never trusted them anyway. But "
"perhaps that's what's keeping us alive.\""
msgstr ""
"\"여지껏 내내, 우리가 쓸모없는 전쟁에 시간낭비 하는 동안 정체를 모르는 자들에 의해 우리의 정보국이 침범당하고 있었어! 내 부하들을 "
"더 이상 못 믿겠어. 믿은 적도 없긴 하지만. 그래서 우리 명줄이 유지되는 지도 모르지만 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0041_Text
#. Speaker : Jubilost_Companion
msgctxt "8c528440-f42c-45c1-92f4-5c798b85eff8"
msgid ""
"\"Then, while we were off fighting someone else's war, our real enemy sent "
"in spies to infiltrate our ranks! I conducted an investigation and found "
"proof that our entire intelligence apparatus has been compromised!\""
msgstr ""
"\"우리가 타인의 전쟁에서 싸우는 동안, 진짜 적은 우리들에게 첩자를 보내고 있었어! 조사 해 본 결과 우리 정보 기관 전체가 제대로 "
"돌아가지 않는다는 증거를 찾았거든!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank7/Cue_0042_Text
#. Speaker : Ekun_Companion
msgctxt "a2d601a3-ab07-4cff-8133-09752c5578e9"
msgid ""
"\"While we were busy brawling, they sent in their spies. We were distracted "
"by our neighbors and neglected our own home. Now it's full of rats.\""
msgstr ""
"\"우리가 싸우는 동안, 놈들은 우리에게 첩자를 보냈다. 이웃들에게 한눈 팔고 있어서 우리 고향을 무시하고 있었다. 이제 우리 땅에 "
"쥐새끼들이 가득하다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank8/Answer_0005_Text
msgctxt "f1a658b6-4764-4350-8763-97829055fc21"
msgid "\"We're going to hit them right in their fat purses.\""
msgstr "\"놈들의 두툼한 지갑에 타격을 줄 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank8/Answer_0006_Text
msgctxt "3973540b-0d5b-4180-9d51-82e0fb424088"
msgid ""
"{g|Espionage8_2}[Choice effects]{/g} \"We're going to hunt down Daggermark's "
"agents.\""
msgstr "{g|Espionage8_2}[선택 시 효과]{/g} \"우리는 대거마크의 요원들을 사냥할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank8/Answer_0007_Text
msgctxt "b80c261f-d8f4-419f-bf4c-4370617a87c2"
msgid "\"Act as you see fit.\""
msgstr "\"당신 적합하다 생각되는대로 행동 하시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank8/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "6c3f7cda-034b-4158-9d78-caba09a6e365"
msgid ""
"\"We interrogated the traitors we discovered in our ranks. They were hired "
"by someone in Daggermark. The enemy is dangerous and covers his tracks well. "
"But I'll find him. We don't know which of the Daggermark elders is our "
"enemy. But they do. And they will willingly betray their own, if they can "
"profit in doing so.\""
msgstr ""
"\"우리 첩자들 중 배신자들에 대한 정보를 얻어냈다. 대거마크에게 고용된 자들이더군. 적들은 위험하고 흔적을 잘 숨기고 있다. 하지만 "
"놈을 반드시 붙잡겠다. 대거마크의 원로 중 누가 우리 적인지는 모른다. 하지만 놈끼리는 잘 알고있지. 그리고 자기에게 이익이 된다면, "
"놈들은 기꺼이 자기네 편을 배신할 거다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank8/Cue_0002_Text
#. Speaker : Jubilost_Companion
msgctxt "85fcc1a6-a989-4fd9-8947-455af7bff1f7"
msgid ""
"\"The traitor's trail leads to Daggermark. Our quarry is hiding unseen, but "
"I know how to lure them out. We can give Daggermark's elite some political "
"problems to deal with – wreck their business affairs without spilling a "
"single drop of blood. They'll gladly betray the offender to end the chaos.\""
msgstr ""
"\"배신자의 흔적이 대거마크로 이어졌어. 우리 사냥감은 숨어있지만, 어떻게 놈을 꾀어내는 지는 내가 잘 알지. 대거마크의 엘리트들에게 "
"정치적 문제를 안겨주는 거야. 피 한 방울 흘리지 말고 놈들의 사업장을 파괴하는 거지. 놈들은 혼란을 종식시키기 위해 기꺼이 우리의 적을 "
"배신할 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank8/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "4bd4a947-618a-4c52-94e5-0940abb0549e"
msgid ""
"\"Our enemy's trail leads to Daggermark. The one who infiltrated spies into "
"our ranks is now hiding quiet and still. They don't seem to understand the "
"vanity of the pose. We're no longer looking for a single offender. We will "
"take broader measures instead. Every servant, spy, or tradesman's assistant, "
"whose master hails from Daggermark – he can count himself most wanted.\""
msgstr ""
"\"우리 적의 흔적이 대거마크로 이어지고 있어. 우리 백성들한테 첩자를 보냈던 놈은 잠잠히 지켜만 보고 있는 상태야. 가만히 있다고 "
"안전한 게 아니라는 걸 모르는 것 같아. 더 이상 놈 하나만 찾진 않을 거야. 대신 보다 폭 넓게 방법을 쓸거야. 하인, 첩자, 상인 "
"조수 등 주인이 대거마크 출신인 자는 모조리 지명수배자로 만들 거거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank8/Cue_0008_Text
#. Speaker : Ekun_Companion
msgctxt "942f1577-ed5c-482f-a374-a319e39ee74c"
msgid ""
"{n}Ekun nods happily.{/n} \"There is no honor among such as these. We take "
"away their meat, and they'll turn on each other like jackals.\""
msgstr ""
"{n}에쿤은 기쁜 듯 끄덕인다.{/n} \"이런 놈들에게 명예란 없다. 놈들의 고기를 취하면, 놈들은 자칼처럼 서로를 배신해대겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank8/Cue_0009_Text
#. Speaker : Jubilost_Companion
msgctxt "1ebb0d78-e33e-4e5d-b37d-c0e4db32c9cf"
msgid ""
"\"Ha. The offender will be brought to us before I can say, \"An accidental "
"fire wiped out their depots!\""
msgstr ""
"\"하. 그놈은 내가 , \"우연히 화재가 일어나 놈들의 창고를 쓸어버렸다!\" 라고 말하기 전에 우리 앞으로 불려나올 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank8/Cue_0010_Text_String
#. Speaker : Jaethal_Companion
msgctxt "9cec5869-53f7-4d14-a696-46405bdb7a0f"
msgid ""
"\"This is careless. You'll merely tease them and make them angry. Far better "
"to simply inspire terror. That alone will prevent them from stabbing you in "
"the back.\""
msgstr ""
"\"이건 경솔한 행동이야. 단순히 사람들을 괴롭히고 성내게 만들고 있잖아. 그냥 단순히 공포에 떨게 하는 게 나아. 그것만으로도 놈들이 "
"널 뒤에서 찌르는 걸 막을 수 있다고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank8/Cue_0011_Text_String
#. Speaker : Ekun_Companion
msgctxt "43886a94-aa4b-4aa1-9929-8719921590fc"
msgid ""
"\"Your vision is clouded. You do not seek to pursue a goal, but to avenge an "
"insult.\""
msgstr "\"시야가 흐려졌군. 목표를 추구하는게 아니라 모욕을 되갚아주려고 하고 있다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank8/Cue_0012_Text_String
#. Speaker : Jubilost_Companion
msgctxt "74d54d96-2024-454d-9334-f1b7ea8e6ffe"
msgid ""
"\"Oh. You're overdoing it. If you push too hard, they won't want to meet you "
"at the negotiation table later. They'll come at you with pitchforks and "
"torches instead.\""
msgstr "\"너무 과한데. 그렇게 강하게 밀어붙인다면 당신과 협상하려하지 않을거야. 대신 횃불과 쇠스랑을 들고 오겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank8/Cue_0013_Text
#. Speaker : Jaethal_Companion
msgctxt "ac71c51c-2dbc-46ca-a879-dcc320acc85f"
msgid "\"My harvest will please Urgathoa.\""
msgstr "\"이걸로 우르가쏘아께서도 기뻐하시겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank8/Cue_0016_Text
#. Speaker : Ekun_Companion
msgctxt "4a694afd-6ae0-4bda-87d1-151f14cfc611"
msgid ""
"\"Daggermark's influence stretches far and wide, and its representatives can "
"be found across the kingdom. We can strike them at any time. If we apply "
"enough pressure, the elders of Daggermark will be forced to reveal our "
"enemy's name, if only to stem the loss of blood. Though in truth it is not "
"blood but gold that flows in their veins. Ripping open their purses would be "
"even more effective than ripping open their bellies.\""
msgstr ""
"\"대거마크의 영향력이 멀리 퍼지고 있어 그 대표들을 왕국에서도 찾을 수 있다. 놈들을 언제든 공격할 수 있을 거다. 충분히 압박하면 "
"대거마크의 원로들도 우리 적의 이름을 밝히겠지. 유혈사태를 막고싶다면 말이야. 다만 놈들의 혈관엔 피보다 황금이 흐르고 있다. 놈들의 "
"지갑을 절개해버리면 놈들의 배에 구멍을 내는 것 보다 더 효과적일 거다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank8/Cue_0017_Text
#. Speaker : Jaethal_Companion
msgctxt "1487c937-2b87-4476-9700-3be213f8e15a"
msgid ""
"\"They are expecting us to make an attempt on their purses. It's the only "
"way they think. But we need not trouble ourselves with their enterprises. "
"We'll simply be killing them one by one, sparing no one. The elders of "
"Daggermark will come crawling to us on their knees, begging us to take the "
"traitor and leave the rest of them alone.\""
msgstr ""
"\"놈들은 우리가 자기네들 지갑에 손 대기를 바라고 있어. 그렇게밖에 생각하지 못하겠군. 하지만 놈들의 사업에는 손 대면 안 돼. 자비 "
"없이 그냥 하나씩 잡아 죽어야지. 그럼 대거마크의 원로들도 무릎을 꿇고 빌면서 배신자를 데려오는 대신 나머지를 살려달라고 할 거다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Answer_0014_Text
msgctxt "68ad0eb8-dc3e-4d6b-aaec-7a983fe43e2e"
msgid "\"Destroy her reputation. Let her allies abandon the Guild head.\""
msgstr "\"그녀의 명성을 훼손시켜라. 그녀의 동맹인 길드장이 떠나도록.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Answer_0015_Text
msgctxt "e51c9f0f-4d3a-4025-b6cf-cd5ab1aed922"
msgid ""
"\"Let everyone believe that she was planning to overturn Daggermark's "
"government.\""
msgstr "\"그 여자가 대거마크의 정부를 전복하려고 한다는 것을 모두가 알게 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Answer_0016_Text
msgctxt "a19dc3cf-35ac-4fe1-ab96-2292d93d7349"
msgid ""
"{g|Espionage9_3}[Choice effects]{/g} \"Offer her to make peace, join forces, "
"and attack the other Guild.\""
msgstr ""
"{g|Espionage9_3}[선택 시 효과]{/g} \"그 여자에게 평화, 우리 편으로 전향 및 다른 길드를 공격하자고 제안하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Answer_0017_Text
msgctxt "d48d711c-a04a-45c4-bb29-0763f3794286"
msgid "\"Make your own decision.\""
msgstr "\"네가 결정해라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Answer_0018_Text
msgctxt "3510391e-6dcb-4ce1-998f-ed119de42e96"
msgid "\"Describe the forces in Daggermark for me.\""
msgstr "\"대거마크의 군세에 대해 말해보라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Answer_0031_AlignmentShift.Description
msgctxt "a5ba21fb-fc79-44da-bbde-b06b15665b66"
msgid "Perpetrated a mass murder in Daggermark by collapsing the Guild."
msgstr "길드를 무너뜨리며 대거마크에서 대량 학살을 저질렀다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Answer_0031_Text
msgctxt "301cd752-cdcf-461c-89a1-67c0d6d0d20a"
msgid "\"Blow up her headquarters.\""
msgstr "\"그 본부를 날려 버려라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "054f373e-1eec-4dc4-807a-e559fc254607"
msgid ""
"\"{name}, we've a report from Daggermark. The enemy we seek is the leader of "
"one of the two Guilds that rules the city.\""
msgstr "\"{name}, 대거마크에서 보고가 들어왔다. 우리가 찾는 적은 도시를 다스리는 두 길드 중 하나의 지도자라고 한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0002_Text
#. Speaker : Jubilost_Companion
msgctxt "b4f00ee1-2a77-494e-94ab-22da5853ec05"
msgid ""
"\"Very well, I'll just tell you. It's old Tragshi, that schemer and "
"poisoner. She's wise, like any woman of her age... But to put it simply, "
"she's a cranky old lady who is stuck in the past. I wouldn't share a cup of "
"tea with her. Anyhow, our aggressive politics seem to have startled her.\""
msgstr ""
"\"좋아, 그냥 말해 주지. 늙은 트랙쉬, 책략가이자 독술사야. 그 나이대에 맞게 현명한 여자야... 하지만 단순하게 보면 과거에 "
"안주하는 괴짜일 뿐이지만. 이 여자와 차 한 잔 하고싶군. 어쨌든, 우리의 공격적인 정책이 그 여자를 자극했나 봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0003_Text
#. Speaker : Jubilost_Companion
msgctxt "0dd8a15f-de17-4883-b577-a22f82cc9b80"
msgid ""
"\"All right, don't try to guess. It's lady Janna Smilos, the head of the "
"Assassins Guild. She's fearsome, smart, and crafty. – Smart and crafty "
"enough with her dagger anyway. She prefers to solve her problems with a "
"simple dagger thrust between the ribs. But she's not as smart or crafty as "
"we. She knows this full well, which is why she tried to get rid of us before "
"we reached our full strength.\""
msgstr ""
"\"좋아, 찍어서 맞출 생각 하지 말라고. 잔나 스밀로스 부인, 암살자 길드의 우주머리야. 무시무시하고, 영리하며, 교활하지. 단검 "
"다루는 솜씨도 뛰어난 사람이야. 이 여자는 문제를 해결할 때 단도직입적으로 해결하길 좋아해. 하지만 우리 만큼 영리하거나 교활하진 않지. "
"자기 자신도 이를 잘 알고 있어서 우리가 완전히 성정하기 전에 제거하려는 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0004_Text
#. Speaker : Jubilost_Companion
msgctxt "0f463bd3-7e03-40b0-9b34-09e64a245bab"
msgid ""
"\"We can solve the problem by planting a bomb in the Guild's headquarters or "
"by spreading rumors to slander her. We could even plant evidence of her "
"conspiracy against Livondar, the Lord of Daggermark. Ah but there's one more "
"option. We could defy expectation and extend a hand of friendship to her. We "
"could seal the deal by attacking the other Guild, to cement the unexpected "
"bond.\""
msgstr ""
"\"길드의 본부에 폭탄을 설치해서 문제를 해결 할 수도 있고, 그녀를 모략하는 소문을 퍼트릴 수도 있어. 그녀가 대거마크의 군주인 "
"리본다르에 대항하는 음모를 꾸몄다는 증거를 심어 놓을 수도 있지. 아, 방법이 하나 더 있다. 모두의 예상을 깨고 그녀를 향한 우호의 "
"손길을 건네줄 수 있어. 다른 길드를 공격하여 이 거래를 봉인하고 이 예상치 못한 결속을 공고히 하는 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0005_Text
#. Speaker : Jubilost_Companion
msgctxt "2493094c-3e2e-48e7-a16b-c3cc7527ecdb"
msgid ""
"\"{name}, we know who's been waging a war of spies against us! It's the "
"leader of one of the two major guilds in Daggermark. Guess who it is – the "
"Assassins or Poisoners Guild.\""
msgstr ""
"\"{name}, 누가 우리에 대항해서 이 첩보전을 하고 있는지 알게되었어. 대거마크의 두개의 주요 길드중 하나야. 누군지 맞춰봐. "
"암살자 길드 아니면 독술사 길드입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0006_Text
#. Speaker : Jaethal_Companion
msgctxt "3b667a7e-2dda-4b4c-a6d1-ddbfcaa59334"
msgid ""
"\"{name}, I have a gift for you. The name of the enemy who conspired against "
"us. Have you heard of the two main Guilds in Daggermark, the Assassins Guild "
"and the Poisoners Guild? Our enemy is the woman who runs one of them.\""
msgstr ""
"\"{name}, 선물을 하나 가져왔어. 우리를 향해 음모를 꾸미고 있는 적의 이름이야. 대거마크의 두개의 주요 길드, 암살자 길드와 "
"독술사 길드를 들어봤어? 우리 적은 그 둘중 하나를 운영하고 있는 여자야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0007_Text
#. Speaker : Ekun_Companion
msgctxt "1738cb9e-08ce-4240-8d38-303b9c1eca7a"
msgid ""
"\"A clever woman by the name of Tragshi, leader of the Poisoners Guild. "
"She's known for her wisdom, and values balance, like other druids. She "
"thought we were acting too abruptly. Rocking the boat. She meant to "
"discipline us. It was a mistake.\""
msgstr ""
"\"트랙쉬라는 이름의 영리한 여자가 독살자 길드를 이끌고 있다. 그녀는 다른 드루이드들 처럼 지혜롭고, 균형을 중시한다. 그녀는 우리가 "
"너무 갑작스럽게 행동한다고 생각했나 보더군. 평지풍파를 일으킨다고 말이다. 우리를 훈계하려고 했다. 그건 실수였고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0008_Text
#. Speaker : Ekun_Companion
msgctxt "66764c62-e908-45b0-b6c6-84c3954634f0"
msgid ""
"\"It's Janna Smilos, the head of the Assassins Guild. Bold and dangerous. "
"She recognizes an enemy when she sees one. She saw us as a threat and "
"decided to strike first. And now we have her all but cornered.\""
msgstr ""
"\"암살자 길드의 수장은 잔나 스밀로스다. 대담하고 위험한 그녀는 적을 보면 한번에 알아볼줄 알지. 그녀는 우리를 위협으로 봤고 선수를 "
"치기로 결정했다. 그리고 이제 그녀를 궁지로 몰아넣었다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0009_Text
#. Speaker : Ekun_Companion
msgctxt "07c11094-30b8-4ed7-babb-0b539ff7b61f"
msgid ""
"\"It's time we strike back. It is for you to decide how we should proceed. "
"Deception? Slander? A bomb that turns the whole Guild to ash? We could send "
"a false letter to Livondar, the Lord of Daggermark. We will lead him to "
"believe that the Guild was conspiring against him. Finally, we could turn "
"our enemy into our friend, by striking the other Guild. Their blood would "
"forge a new alliance!\""
msgstr ""
"\"되갚아줄 시간이다. 우리가 어떻게 진행할 지는 네가 결정해야 한다. 기만책? 중상모략? 폭탄으로 길드 전체를 잿더미로 만들기? "
"대거마크의 군주인 리본다르에게 거짓 편지를 보낼 수도 있다. 그자에게 그 길드가 자신을 대상으로 모략을 꾸미고 있다고 믿게 할 수 있다. "
"그리고 마지막으로, 다른 길드를 공격해서 우리의 적을 아군으로 만드는 방법이 있다. 놈들의 피로써 새로운 동맹이 만들어지는 법!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0010_Text
#. Speaker : Jaethal_Companion
msgctxt "1b9551a3-d821-4e69-9f15-6687956dbe60"
msgid ""
"\"Her name is Tragshi. The old wretch runs the Poisoners Guild. Our decisive "
"manner probably scared her. The old coward meant to undermine our kingdom "
"with her schemes, but the snake only poisoned herself. We won't be the ones "
"who fall. She will.\""
msgstr ""
"\"그 여자 이름은 트랙쉬. 독술사 길드를 운영하는 비루한 늙은이지. 우리의 결단력있는 판단 때문에 겁을 먹은 것 같아. 그 늙은 "
"겁쟁이가 우리 왕국을 계략으로 무너뜨리려고 했지만, 제 독에 자기만 중독된 꼴이지. 쓰러지는 건 우리가 아니라, 그 여자가 될 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0011_Text
#. Speaker : Jaethal_Companion
msgctxt "0e769470-bd97-4a37-abe2-226ac7d78f3f"
msgid ""
"\"The name is Janna Smilos, the head of the Assassins Guild. To be chief "
"among ignorant butchers and stranglers is a dubious honor. In any case, "
"Smilos regards us as dangerous and unpredictable foes, and she certainly has "
"a point. But she imagined she could bring down our whole espionage network, "
"and the kingdom with it – and that shows a serious lack in judgment.\""
msgstr ""
"\"이름은 잔나 스밀로스, 암살자 길드의 수장이야. 멍청한 도살자들과 교살자들의 수장이 된다는 건 불명예스러운 일이지. 스밀로스는 우리를 "
"위험 및 예측할 수 없는 적으로 간주하고 있어. 사람 볼 줄은 아네. 하지만 우리 첩보망을 무너뜨리고 왕국까지 집어삼킬 수 있었다고 "
"생각했다면 오산이야. 진지하게 판단력 부족을 증명한 거지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0012_Text
#. Speaker : Jaethal_Companion
msgctxt "99f35433-6056-416c-8aa5-357a961ee041"
msgid ""
"\"We could blow up the Guild headquarters and hope she dies in the rubble. "
"We could slander her and ruin her reputation. Or we could make it look like "
"she's conspiring against Livondar, the Lord of Daggermark – though I dislike "
"the idea of someone else serving justice on my behalf. But there's another, "
"more artful move. Everyone expects us to attack our enemy. Meanwhile, what "
"if we made a deal with her and strike her competition? It's the last thing "
"they'd expect. Then we could share the treasure and part as friends.\""
msgstr ""
"\"길드 본부 채로 날려버려서 잔햇더미에 그 여자가 깔려 죽도록 할 수도 있어. 중상모략을 해서 평판을 무너뜨리는 방법도 있고. 아니면 "
"대거마크의 군주인 리본다르에게 대항하는 것 처럼 꾸미거나. 다만 난 누가 날 대신해서 심판을 내린다는 점이 마음에 안 들어서 이 점은 "
"끌리지 않아. 그 외에도 더, 끔찍한 방법이 있어. 모두들 우리가 적을 공격만 할 거라고 예상하지. 하지만 우리가 적과 손잡고 그 "
"경쟁자를 공격한다면 어떻게 될까? 이런 건 꿈에도 못 꿨을 거야. 그리고 친구와 함께 보상을 나누는 거지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0020_Text
#. Speaker : Jubilost_Companion
msgctxt "ed1ee006-e742-4d98-b2ee-f13ed70ea810"
msgid ""
"\"We'll slander her, then. And if our enemy lacks flaws? We'll make up "
"flaws! Our stories will be so true to life that the truth will pale before "
"the shining lies.\""
msgstr ""
"\"그 여자를 중상모략 하겠어. 결점이 없다면 만들면 되는 거 아니겠어? 최대한 빛나는 거짓말을 만들어 진실을 무색하게 만들어보이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0021_Text
#. Speaker : Jaethal_Companion
msgctxt "6a2132c2-dd35-4522-bf9f-5ceac059cc19"
msgid ""
"\"People always prefer to believe lies. It won't be hard to blame her for "
"every fault and failing since the world began.\""
msgstr ""
"\"사람들은 언제나 거짓말을 믿길 좋아하지. 그 여자가 천지개벽 이래로 저지른 잘못을 모조리 비난하는 것은 어렵지 않을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0022_Text
#. Speaker : Ekun_Companion
msgctxt "46c5d131-eb96-4bda-bbad-15275fea2682"
msgid "\"It will be done.\""
msgstr "\"끝날 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0023_Text
#. Speaker : Jubilost_Companion
msgctxt "c42f5ff3-3785-4a01-b5ff-81011f8a8f0d"
msgid ""
"\"It should be easy to convince Lord Livondar that there was a conspiracy "
"against him. There have been plenty of attempts on his life in the past. "
"Even if he figures out it's a lie, he'll still be happy to pin the crime on "
"her.\""
msgstr ""
"\"리본다르 경에게 자신을 해하려는 무리가 있단 걸 믿게 하는 건 쉬울 거야. 그 양반 과거에도 수없이 비슷한 시도가 있었거든. 거짓말인 "
"게 들통나더라도, 그 여자의 범죄를 알게 된다면 기뻐하겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0024_Text
#. Speaker : Jaethal_Companion
msgctxt "66eec973-c8b4-4cc0-9b65-3e6f3b8c4e39"
msgid ""
"\"Very logical. Let Daggermark's scorpions sting each other to death in "
"their little jar, as we watch from outside.\""
msgstr "\"합리적인 결정이야. 대거마크의 전갈들이 작은 병 안에서 서로를 찔러 죽여대는 꼴을 밖에서 지켜보자고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0025_Text
#. Speaker : Ekun_Companion
msgctxt "7765fe73-dbed-456f-81f0-1ed46b4e46e1"
msgid "\"It's a crafty move. I'll take care of it.\""
msgstr "\"그건 교활한 술책이군. 수행하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0026_Text
#. Speaker : Jubilost_Companion
msgctxt "815a0119-10b6-48f4-b732-bbc550bf9254"
msgid ""
"\"I'll take care of it. But don't ask me how. I'm your minister – I have my "
"own secrets.\""
msgstr "\"잘 해볼게. 그치만 내가 어떻게 할지는 묻지 마. 난 당신의 장관이고, 난 나만의 비밀을 가지고 있거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0027_Text
#. Speaker : Jaethal_Companion
msgctxt "14fb0e73-129d-4902-a409-4ba7fce229df"
msgid ""
"\"We'll seal the deal with her and strike her enemy! Fate presented two "
"options: her or us. Yet we've chosen a third. Very clever.\""
msgstr ""
"\"협상을 타결하고 그녀의 적을 공격하겠어! 그 여자 아니면 우리 둘 중 하나가 없어져야 하는 운명이었는데. 우린 세 번째를 택해버렸군 "
"그래. 아주 똑똑해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0028_Text
#. Speaker : Ekun_Companion
msgctxt "ea515d99-0cea-49dc-a826-9feefeb35532"
msgid ""
"\"The Assassins and Poisoners Guilds are on peaceful terms, but it's a "
"fragile alliance. Both guilds possess strength and power. Both are large, "
"with extensive networks of relations. Martro Livondar ensures they don't "
"wipe each other out. He's rather more of a judge and a general than he is a "
"ruler.\""
msgstr ""
"\"암살자 길드와 독술자 길드 사이에 평화 조약이 맺어졌다. 하지만 굉장히 깨지기 쉬운 조약이지. 두 길드 힘과 권력을 가지고 있다. 둘 "
"다 규모가 크고, 넓은 정보망과 관계망을 가지고 있지. 마트로 리본다르는 놈들이 서로 공격하지 않게 하고있다. 군주라기 보다는 판사나 "
"장군감이로군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0029_Text
#. Speaker : Jubilost_Companion
msgctxt "83182be4-5037-4748-9d6f-5b6a4f6fbbab"
msgid ""
"\"The Assassins Guild and Poisoners Guild are equal in power. Both have "
"plenty of money, spies, and connections. Their alliance is more of a heavily "
"armed stalemate. Martro Livondar, the formal Lord of Daggermark, keeps the "
"balance. But neither Guild would pass up the chance to grab everything that "
"the other one has.\""
msgstr ""
"\"암살자 길드와 독술사 길드의 힘은 동등해. 둘 다 재력도, 첩자도, 연줄도 풍부하지. 이들의 동맹은 중갑을 입고 교착상태에 빠졌다는 "
"편이 더 어울릴 거야. 대거마크의 공식적인 군주인 마트로 리본다르는 중립을 유지하고 있어. 하지만 두 길드 모두 다 상대가 가진 모든 "
"것을 빼앗을 수 있는 기회가 생기면 주저없이 달려들 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0030_Text
#. Speaker : Jaethal_Companion
msgctxt "4aea097c-23f5-440c-8c4f-42689b024be6"
msgid ""
"\"The Assassins and Poisoners Guilds share power, and their strengths are "
"somewhat comparable. They have plenty of gold, relations, and agents. They "
"were once allies, but today each of them looks with deadly envy at the "
"other. Martro Livondar, the Lord of the city, keeps the balance.\""
msgstr ""
"\"암살자 길드와 독술사 길드는 권력을 함께 나누고 있고 이들의 힘은 비할 데가 없는 상태야. 돈, 연줄, 첩자 무엇 하나 부족한 것이 "
"없어. 하지만 한때 동맹인 둘은, 이제 서로를 죽일 듯 질투해대고 있지. 도시의 군주인 마트로 리본다르는 중립을 유지하고 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0032_Text
#. Speaker : Ekun_Companion
msgctxt "bd70a573-0b7a-40ad-9b07-0865249bdc01"
msgid ""
"{n}Ekun is thoughtful, but his voice is resolute.{/n} \"Many will die. "
"They're not bakers and fishermen, though. Their job is to bring death. They "
"chose this fate.\""
msgstr ""
"{n}에쿤은 생각에 잠겨있지만, 목소리는 단호하다.{/n} \"수많은 이들이 죽을 거다. 죽을 이들이 제빵사나 낚시꾼 같은 평범한 "
"사람들은 아니지만. 죽음을 가져오는 것이 그들의 일이다. 이런 운명을 택한 것이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0033_Text
#. Speaker : Jubilost_Companion
msgctxt "acf455b4-0d0e-4a52-90b1-c46f5c6d8aeb"
msgid ""
"\"Normally I wouldn't recommend such a stratagem... But this is precisely "
"the sort of situation where it's appropriate. She's already caused us too "
"much trouble!\""
msgstr ""
"\"보통이라면 이런 책략은 추천하지 않겠어... 하지만 상황이 상황인 만큼 아주 적절한 조치야. 그 여자는 이미 문제를 너무 많이 "
"일으켰지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Espionage/Rank9/Cue_0034_Text
#. Speaker : Jaethal_Companion
msgctxt "9c69e2b5-8a33-4cfe-8a11-26f1a74d11e8"
msgid ""
"\"Many bystanders will die. Servants. Students. Clients. But this is well. "
"She'll find it hard to make friends if everyone is afraid of getting close "
"to her.\""
msgstr ""
"\"많은 구경꾼들이 죽을 거야. 하인, 학생, 고객들까지. 하지만 괜찮아. 아무도 자기 근처에 가까이 오려고 하지 않는다면 그 여자도 "
"친구를 사귀기 어려울 테니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Merc/Cue_0001_Text
msgctxt "0d39d52c-a1ce-4a39-9d59-3bc8f0083ec6"
msgid ""
"{n}Your advisor has arrived to report about the recent Loyalty developments "
"in your {mf|barony|barony|kingdom|kingdom}.{/n}"
msgstr "{n}당신의 보좌관이 최근의 {mf|남작령|남작령|왕국|왕국}의 민심 발전에 대해 논의하기 위해 방문했습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10CommonGift/Answer_0005_Text
msgctxt "1de31e3e-6924-4987-b941-1f29eea5d470"
msgid ""
"\"The merchants became wealthy because they know how to read and write, and "
"they studied history and geography. Let the people send their children to "
"schools, temples, and sages, so they may learn and grow wiser.\""
msgstr ""
"\"상인들은 읽고 쓸 줄 알아서, 그리고 역사와 지리학을 공부해서 부자가 된 것이다. 사람들이 아이들을 학교, 사원, 현자에게 보내도록 "
"허락하라. 더 현명하게 자라도록 말이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10CommonGift/Answer_0006_Text
msgctxt "d80c1b72-7d53-4893-91c9-de1f702bafe7"
msgid ""
"\"I want your people to become the kingdom's ears. Keep an eye on any "
"suspicious foreigners. Never discount a strange rumor. Only united can we "
"stand against our enemy's deceptions.\""
msgstr ""
"\"백성들이 왕국의 귀가 되어줬으면 한다. 수상한 외국인들을 지켜보게 말이다. 수상한 소문을 절대 무시하지 마라. 하나로 뭉쳐야만 적들의 "
"기만에 맞서 싸울 수 있다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10CommonGift/Answer_0007_Text
msgctxt "4b5e2aee-7c4c-46a6-8071-3a543efe4247"
msgid ""
"\"Tell everyone you meet that I'm a just ruler. The log drivers wander all "
"around the River Kingdoms. If our neighbors learn of my people's respect, my "
"fame and power will grow.\""
msgstr ""
"\"만나는 모든 사람들에게 내가 그냥 평범한 통치자라고 말하라. 강의 왕국들을 떠다니는 수많은 통나무 중 하나라고. 백성들이 날 얼마나 "
"존경하는 지 이웃들도 알게된다면, 명성과 권력도 자라날 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10CommonGift/Cue_0001_Text
msgctxt "08ea7963-028b-4790-8885-aef6f99bc4a6"
msgid ""
"{n}It takes the sturdy old man a while to clear his throat. He seems "
"confused but tries to stand tall.{/n} \"Greetings, Your Highness! I am the "
"leader of the log drivers. Everyone in the whole area knows me. We deliver "
"goods, ferry people around. – Basically, we live on the rivers. I've come to "
"thank you, {name}.\""
msgstr ""
"{n}노인은 목청을 가다듬느라 잠시 시간을 끌었습니다. 그는 혼란스러웠지만 당당해 보이려 합니다.{/n} \"반갑습니다, 전하! 저는 "
"뗏목꾼들의 우두머리입니다. 이 지역 사람들은 모두가 저에 대해 알고있지요. 저희는 물건을 나르고, 사람을 실어 나릅니다. 강에서 나고 "
"죽는 놈들이지요. 감사를 표하려 왔습니다, {name} 시여.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10CommonGift/Cue_0002_Text
msgctxt "581c30f1-86d1-45d3-a073-788b50c0de27"
msgid ""
"\"That's a strange thing to say! But it's true, in times like these, all our "
"neighbors envy us. Don't you worry. If any trouble stirs up, your guards "
"will be the first to know!\""
msgstr ""
"\"그거 참 이상한 말이군! 하지만 이런 시기에는 모든 이웃들이 우릴 시기하는 건 사실이야. 걱정하지마. 만약 어떤 문제가 생기면, 너의 "
"근위대가 가장 먼저 알아차릴 테니까!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10CommonGift/Cue_0003_Text
msgctxt "399b0d56-9b43-4fbb-9350-4d7fff9c0161"
msgid ""
"\"We'll do it, {name}. It will take time, of course, but eventually we'll be "
"better for it.\""
msgstr "\"우리는 해낼 거야, {name}. 물론 시간이 걸리겠지, 하지만 결국엔 더 나아질 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10CommonGift/Cue_0008_Text
msgctxt "875dbedd-f1b3-4153-a51a-530ae2f178ce"
msgid ""
"\"It will be done. All your neighbors will hear how your people support you. "
"That will make them respect you!\""
msgstr ""
"\"그건 해결될 겁니다. 모든 이웃들은 백성들이 얼마나 당신을 지지하는지 듣게 될 것입니다. 백성들은 당신을 존경하게 될 것입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10CommonGift/Cue_0009_Text
msgctxt "39722f34-27ef-4bc3-9202-028300c315ce"
msgid ""
"{n}The old man bows.{/n} \"We've seen many things, but a ruler who stands up "
"for the ordinary people against the rich – that's something new. The petty "
"merchants that robbed the people are like the bandits now. They're singing a "
"different tune, and engaged in honest trade. For this I thank you. – And not "
"just with words. Tell me what your people can do for you, and I'll make sure "
"they hear your request.\""
msgstr ""
"{n}노인은 몸을 숙입니다.{/n} \"살면서 많은 것을 봐왔지만, 부자에 대항하여 빈민들 편에 서는 군주라니. 이건 신선하군요. 사람들 "
"주머니를 털고다니던 소상인들은 완전 도적떼 수준이었습니다. 하지만 이젠 태도를 바꿔서 정직하게 거래하겠다고 하더군요. 이에 감사드리고자 "
"합니다. 하지만 말로만 감사를 표하러 온 것이 아닙니다. 저희들이 해드릴 수 있는 게 있다면 말씀해주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Answer_0006_Text
msgctxt "406ba4b1-96c8-488d-884b-445c0b49184e"
msgid ""
"{g|Loyalty10_1}[Choice effects]{/g} \"Our gallows cannot wait to meet them. "
"Let everyone see what fate awaits traitors.\""
msgstr ""
"{g|Loyalty10_1}[선택 시 효과]{/g} \"놈들을 위해 교수대가 기다리고 있다. 모두에게 반역자의 최후가 어떤지 보여주라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Answer_0007_Text
msgctxt "615d7079-0f11-40d1-853e-eaefe1edd77d"
msgid ""
"{g|Loyalty10_2}[Choice effects]{/g} \"Let them go. We've taught them a "
"lesson. It is sufficient.\""
msgstr "{g|Loyalty10_2}[선택 시 효과]{/g} \"놔둬라. 그들에게 교훈이 됐을 것이다. 충분하다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Answer_0008_Text
msgctxt "2b9d4b72-bc8e-4cbf-a208-b4aa2f10c503"
msgid ""
"{g|Loyalty10_3}[Choice effects]{/g} [Gain 10000 gold and 200 BP] \"Free them "
"from their chains. Also free them of their wealth, their estates, their "
"luxurious clothing and any other possessions. It will be seized for the good "
"of the state and its people.\""
msgstr ""
"{g|Loyalty10_3}[선택 시 효과]{/g} [10000 골드 및 200 BP 획득] \"그들을 풀어주라. 재산, 영토와 값비싼 "
"옷 같은 다른 소지품은 빼앗으라. 국가와 백성의 안녕을 위해 쓰겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Answer_0009_Text
msgctxt "425b5d51-cd08-4342-b98b-3105c801f7bc"
msgid "\"You may determine their fate yourself.\""
msgstr "\"저들의 운명은 자네가 결정하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Answer_0024_Text
msgctxt "f7ee9084-418f-4a95-97c0-c113c38e6b30"
msgid ""
"\"The merchants became wealthy because they know how to read and write, and "
"they studied history and geography. Let the people send their children to "
"schools, temples, and sages, so they may learn and grow wiser.\""
msgstr ""
"\"상인들은 읽고 쓸 줄 알아서, 그리고 역사와 지리학을 공부해서 부자가 된 것이다. 사람들이 아이들을 학교, 사원, 현자에게 보내도록 "
"허락하라. 더 현명하게 자라도록 말이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Answer_0025_Text
msgctxt "4d2e1ac8-6350-4b6b-bf34-37dbab275027"
msgid ""
"\"I want the people to become the kingdom's ears. Keep an eye on any "
"suspicious foreigners. Never discount a strange rumor. Only united can we "
"stand against our enemy's deceptions.\""
msgstr ""
"\"백성들이 왕국의 귀가 되어줬으면 한다. 수상한 외국인들을 지켜보게 말이다. 수상한 소문을 절대 무시하지 마. 하나로 뭉쳐야만 적들의 "
"기만에 맞서 싸울 수 있다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Answer_0026_Text
msgctxt "ef6c9a61-8aa6-4fb2-b238-0a675b46b98f"
msgid ""
"\"Tell everyone you meet that I'm a just ruler. If our neighbors learn of my "
"people's respect, my fame and power will grow.\""
msgstr ""
"\"만나는 모든 사람들에게 내가 그냥 평범한 통치자라고 말하라. 백성들이 날 얼마나 존경하는 지 이웃들도 알게된다면, 명성과 권력도 "
"자라날 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0001_Text
#. Speaker : Tristian_Companion
msgctxt "8914c62c-d67d-4154-becd-0ecdf44f76ad"
msgid ""
"\"But now for some less uplifting news. The guards have exposed a conspiracy "
"of merchants. All the plotters have been arrested, and you must decide their "
"fate. The people are concerned that the rich merchants will simply get away "
"with it. I believe your justice will be served rightly and mercifully.\""
msgstr ""
"\"듣기 좋은 소식은 아닙니다. 경비대가 상인들이 꾸미는 모의질을 밝혀냈다고 합니다. 음모를 꾸미던 자는 모두 체포되었고, 결정을 "
"기다리고 있습니다. 사람들은 이 상인들이 그냥 풀려나지 않을까 걱정하고 있습니다. 올바르고 자비롭게 심판 내리시기를 기다리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0003_Text
#. Speaker : Capital_Tsanna
msgctxt "e9f2ef71-f28d-45a0-bfdd-5fc0d04ebc44"
msgid ""
"\"Your citizens gathered in a council today to plan some more new slums. "
"They're naming one of their squares after you. I love how they roll over for "
"you. Not every ruler enjoys such a mixture of fear and love!\""
msgstr ""
"\"시민들이 오늘 의회에 모여 빈민가를 더 만들려고 해. 그 광장 중 한 곳에 당신의 이름을 붙이려고 하더군. 백성들이 이렇게 당신을 "
"물먹이는 꼴이 보기 좋네. 모든 군주가 이렇게 사랑과 공포를 동시에 받지는 않거든!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0010_Text
#. Speaker : Tristian_Companion
msgctxt "db15bd8c-68e2-4c5a-92a6-4e068a1f614a"
msgid ""
"\"I am sad for them. I wish someone had stopped them before their conspiracy "
"went too far. Part of the blame for this is also mine.\""
msgstr ""
"\"참으로 안타깝군요. 그 모의가 너무 나가기 전에 누군가 바로잡았으면 좋았을 텐데 말입니다. 부분적으로는 저도 책임이 있는 몸입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0011_Text
#. Speaker : Capital_Tsanna
msgctxt "edb1a6ea-815e-4cb3-8f65-18021891855f"
msgid ""
"\"This will teach a harsh lesson to all who witness the punishment. The "
"lesson of fear and respect, {name}. They are the two pillars of every true "
"leader's power.\""
msgstr ""
"\"징계를 목격하는 사람들에게 가혹한 교훈을 안겨주게 될 거야. {name} 을(를) 경외하라, 같은 식으로 말이지. 공포와 존경은 "
"지도자에게 있어 진정한 힘이라고 할 수 있을테니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0012_Text
#. Speaker : Tristian_Companion
msgctxt "aa2e1745-6ce6-4020-8d46-0c1825903e92"
msgid ""
"\"I hope they recognize how lucky they are, and use this chance to start a "
"new life.\""
msgstr "\"저들이 얼마나 행운아인지 깨닫고 이 기회에 새 삶을 시작하기 위한 발판으로 삼았으면 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0013_Text
#. Speaker : Capital_Tsanna
msgctxt "7abbc190-9ffc-46e0-b62f-24a9ecfa6d05"
msgid ""
"\"Your softness is sickening. Very well, as you wish. Your pack may consider "
"it a token of generosity.\""
msgstr "\"너의 관대함은 지긋지긋 하군. 좋아, 원하는대로 해. 그 관대함이란 징표가 너의 짐이라고 생각할 수 있겠군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0014_Text
#. Speaker : Tristian_Companion
msgctxt "21fc6376-9b54-498a-ae7f-bd0d729e9a43"
msgid ""
"\"I heard it's only when a man has nothing that he recognizes true virtue. "
"Perhaps they'll become better and purer souls without their riches...\""
msgstr ""
"\"가진 것이 없을 때 진정한 미덕을 깨닫게 된다는 말을 들은 적이 있습니다. 가진 것이 없어진다면 저들의 영혼도 보다 낫고 순수해질지 "
"모르는 일이지요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0015_Text
#. Speaker : Capital_Tsanna
msgctxt "9397a9ed-56d4-4d2e-adec-1ed68ce127a0"
msgid ""
"\"Hm... You might be doing the right thing. Anyway, they'll be helpless "
"without their wealth.\""
msgstr "\"흐음... 제대로 하는 것 같군. 어쨌든, 돈이 없으면 저들도 무력해질테니 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0016_Text
#. Speaker : Tristian_Companion
msgctxt "ea6b45b4-6016-4f9b-b3de-f51c6ce44479"
msgid ""
"\"We shall forgive them, but deprive them of their means of bribing people "
"and plotting behind your back. Let their wealth be put into use for the "
"ordinary poor people, and let the conspirators join their number.\""
msgstr ""
"\"저들을 용서하되, 사람을 매수하고 당신의 뒤에서 음모를 꾸미게 하는 수단을 빼앗아야 합니다. 저들의 돈이 가난한 백성들을 위해 "
"쓰이도록 하고, 공모자들도 돕게 하십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0017_Text
#. Speaker : Capital_Tsanna
msgctxt "6f3c4926-bd65-4a38-a54b-a2a783942746"
msgid ""
"\"Dangerous and diseased pack members should be eliminated. I will take care "
"of everything, beginning with these pathetic conspirators.\""
msgstr "\"위험하고 오염된 자들은 없어져야만 해. 내가 모두 책임질게. 이 불쌍한 모의자들부터 시작해서 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0018_Text
#. Speaker : Tristian_Companion
msgctxt "c189f915-4f0a-4521-91a3-f1736d090925"
msgid ""
"\"Another visitor awaits an audience with you. He is the leader of the "
"druids of {kingdomname}.\""
msgstr "\"알현하길 기다리는 다른 방문객도 있습니다. {kingdomname} 드루이드들의 우두머리입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0019_Text
#. Speaker : Capital_Tsanna
msgctxt "2f35d81f-f02b-4861-81e4-74fe3e6cfc5d"
msgid ""
"{n}Tsanna's face darkens. She seems nervous. Her rat has disappeared "
"gone.{/n} \"Now that the destiny of the conspirators has been decided, "
"please accept another visitor. He is the leader of the druids of "
"{kingdomname}. But beware – he is not as simple as he seems.\""
msgstr ""
"{n}산나의 얼굴이 어두워진다. 그녀는 초조해한다. 그녀의 쥐는 사라져버렸다.{/n} \"이제 공모자들의 운명이 결정되었으니, 다른 "
"방문객을 받아야 해. {kingdomname} 에서 온 드로이드들의 우두머리야. 하지만 조심하라고. 보이는 대로의 인물이 아니니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0020_Text
#. Speaker : Tristian_Companion
msgctxt "4ac22d0c-cbe9-4b42-9bcb-62367a112472"
msgid ""
"\"{name}, the city council discussed the expansion of one of the districts "
"today. The square in its center will be named in your honor, by unanimously "
"consent. You deserve the love of your subjects! Not every ruler has a chance "
"to enjoy it.\""
msgstr ""
"\"{name}, 도시 의회에서 구역 중 하나의 확장에 대해 토론했습니다. 그 중심 광장에 당신의 명예를 기려 그 이름을 붙이는 것으로 "
"만장일치 결과가 나왔습니다. 당신은 백성들의 사랑을 받을 자격이 있습니다! 모든 군주가 이런 사랑을 즐길 수 있는 건 아니지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0021_Text
#. Speaker : Capital_Tsanna
msgctxt "3034f9bf-0851-4110-a7e4-48c8e712966b"
msgid ""
"\"The loyal hounds of your guard arrested the last members of the merchants' "
"conspiracy today. It's time to decide their fates. I would not recommend "
"mercy. It's not as if they'll ever do anything with their lives. Besides, "
"there's only one way to ensure that such a conspiracy never forms again: a "
"harsh punishment for all involved.\""
msgstr ""
"\"궁성의 사냥개들이 오늘 모의를 꾸미고 있던 상인들의 마지막 인원을 잡아들였어. 놈들의 운명을 결정지을 시간이야. 나라면 자비를 베풀지 "
"않겠어. 놈들도 사람 생명에 대해선 관대하지 않았을 거거든. 거기에 하나 더, 관련자 모두에게 가혹한 처벌을 하는 것만이 이런 작당질이 "
"다시는 형성되지 않을 유일한 길이기도 하고 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0022_Text
#. Speaker : RankUp_Druid
msgctxt "0def0a5b-f2c8-4973-aa5c-df1d697306a0"
msgid ""
"{n}A sturdy old man with a shaggy beard begins to clear his throat. His "
"penetrating eyes scan you, his face benign and respectful.{/n} \"Long live "
"Your Highness! I am here to speak on behalf of your vassals. – Those who "
"survive by farming the land, which my brothers and sisters have sworn to "
"protect. We were their only defenders before you came. We didn't think of "
"you as a friend at first, I admit. But we were wrong.\""
msgstr ""
"{n}수염이 덥수룩하고 튼튼해 보이는 노인 하나가 목청을 가다듬었습니다. 그의 얼굴은 유순하고 상냥해보이지만, 눈은 뚫어져라 당신을 "
"훑어봅니다.{/n} \"전하 만세! 소인은 이 땅 위에 밭을 일구며 살아가는 사람들, 그 사람들을 지키기로 한 형제자매들을 대신해 나온 "
"놈입니다. 전하께서 오시기 전에는 저희가 이곳을 지키고 있었지요. 처음엔 전하를 우리의 친구로 여기지 않았지만, 인정하건대 저희가 "
"틀렸습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0027_Text
#. Speaker : RankUp_Druid
msgctxt "d4847373-a5ca-40f8-9a6e-ef081dfb040b"
msgid ""
"\"We'll do it, {name}. It will take time, of course, but eventually we'll be "
"better for it.\""
msgstr "\"우리는 해낼 겁니다, {name} 시여. 물론 시간이 걸리겠지요, 하지만 나아질 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0028_Text
#. Speaker : RankUp_Druid
msgctxt "75489cb0-29ca-4521-8068-3d5d7aa7651f"
msgid ""
"\"You're speaking dark words, but I don't want to argue. It is true, in "
"times like these, all our neighbors envy us. Don't you worry. If any trouble "
"stirs up, your guards will be the first to know!\""
msgstr ""
"\"사악한 말씀을 하시는군요. 하지만 이에 대해 따지진 않겠습니다. 사실입니다. 이런 시국엔 모든 이웃들이 우리를 질투하지요. 걱정 "
"마십시오. 어떤 문제든 일어나면, 당신의 경비들이 먼저 알아챌 테니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0029_Text
#. Speaker : RankUp_Druid
msgctxt "b3187d4c-44ec-4e20-9598-c45216cdb039"
msgid ""
"\"It will be done. All your neighbors will hear how your people support you. "
"That will make them respect you!\""
msgstr "\"처리하겠습니다. 모든 이웃들이 백성들에 대한 당신의 사랑을 알게 되겠지요. 만인의 존경을 받으실 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0030_Text
#. Speaker : RankUp_Druid
msgctxt "dbb918f7-07b7-42ae-b722-ab16bf577677"
msgid ""
"\"We've seen many things, but a ruler who stands up for the ordinary people "
"against the rich – that's something new. The petty merchants that robbed the "
"people are like the bandits now. They're singing a different tune, and "
"engage in honest trade. For this I thank you on behalf of the druid circle. "
"Tell us what your people can do for you, and your words will be ours. The "
"people heed their druids.\""
msgstr ""
"\"살면서 많은 것을 봐왔지만, 부자에 대항하여 빈민들 편에 서는 군주라니. 이건 신선하군요. 사람들 주머니를 털고다니던 소상인들은 완전 "
"도적떼 수준이었습니다. 하지만 이젠 태도를 바꿔서 정직하게 거래하겠다고 하더군요. 이에 감사드리고자 합니다. 하지만 말로만 감사를 표하러 "
"온 것이 아닙니다. 저희들이 해드릴 수 있는 게 있다면 말씀해주십시오. 사람들은 드루이드의 말을 들을테니 말이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0031_Text
#. Speaker : Tristian_Companion
msgctxt "a0afff0d-da3c-4c12-8fdc-1304bf8ac5ed"
msgid ""
"\"Your people truly love you. However mighty or powerful a ruler may be, the "
"druids never bear gifts to tyrants or villains.\""
msgstr ""
"\"백성들이 당신을 진심으로 사랑하는군요. 제 아무리 강하고 권력이 넘치더라도 드루이드들은 폭군이나 악당에게 호의를 표하진 않으니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0032_Text
#. Speaker : Capital_Tsanna
msgctxt "01e9b5d1-cf0c-46bd-a748-6fe84a4af464"
msgid ""
"{n}Tsanna and the old man stare down one another as if discussing something "
"silently. Then the Councilor nods reluctantly.{/n} \"I'm glad to see you "
"have come in good faith, old man. You have delivered the people's message, "
"and we have heard you.\""
msgstr ""
"{n}산나와 노인은 무언의 토의를 하듯 서로를 응시했습니다. 그러자 평의원이 마지못해 고개를 끄덕입니다.{/n} \"이곳에 찾아온 그대의 "
"선의는 알겠소, 노인이여. 그대가 전달한 사람들의 말을 우린 잘 알아들었소.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0033_Text
#. Speaker : Capital_Shandra
msgctxt "9240ba57-48b8-4701-a7ba-006de3049f8a"
msgid ""
"\"Your Highness, the merchants who conspired against you have been arrested. "
"You will have to determine their fate. Naturally, the crowd is out for "
"blood. The smaller traders hope that you will confiscate the conspirators' "
"assets. – They're looking to take their place.\""
msgstr ""
"\"전하, 당신을 향해 음모를 꾸미던 상인들이 체포되었어. 이들의 운명을 결정해야 해. 물론 백성들은 피를 원하고 있어. 소상인들은 "
"놈들의 재산을 모조리 압수하길 원하고 있지. 저들의 자리를 자기들이 차지하려는 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0034_Text
#. Speaker : Capital_Shandra
msgctxt "bfa46b96-badc-466e-88d8-32162c84ab29"
msgid ""
"\"If they were mere peasants, I would agree. But these are people of great "
"value to the kingdom. They've made a fortune on their own wits. We all might "
"benefit from their wisdom. Their clever heads on spikes – that would truly "
"be a sorry sight!\""
msgstr ""
"\"만약 저자들이 단순한 백성이었다면 동의했을 거야. 하지만 이 사람들은 왕국에 있어 귀중한 자들이야. 자신의 재치를 사용해 재화를 "
"벌어들였지. 저들의 지혜로 이득을 꾀할 수도 있어. 그 똑똑한 머리들이 잘려서 걸려있다고 생각하면, 참으로 꼴불견이겠지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0035_Text
#. Speaker : Capital_Shandra
msgctxt "aa3c2616-fc9a-4aa1-9e31-67456dbc5287"
msgid ""
"\"Your Highness, it is time we graciously receive another visitor, if you "
"please. He is a representative of the people, so to speak. Ahem.\""
msgstr "\"전하, 자비를 보여 새로운 방문객을 맞이하셔야 할 시간이야. 소위 말해 시민들을 대표해서 왔다더군. 에헴.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0036_Text
#. Speaker : Capital_Shandra
msgctxt "cf043b51-5cc9-4558-adfd-2500464d3146"
msgid ""
"\"They've learned their lesson. Arrest and imprisonment sent them a clear "
"message. We can be sure that they'll think thrice before stirring up another "
"rebellion. – And more importantly, if any make such a proposal, they'll all "
"come running to report it to you!\""
msgstr ""
"\"놈들도 교훈을 배웠어. 체포와 구금으로 명확하게 의미를 전달했지. 놈들이 또 배신하려면 세 번은 다시 생각해볼 게 분명해. 그리고 더 "
"중요한 건, 다른 놈이 반란을 모의한다면 놈들이 달려와 네게 보고할 거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0037_Text
#. Speaker : Capital_Shandra
msgctxt "7b1a2605-06d2-4fa1-b7d8-03bd05e70ed2"
msgid ""
"\"Your Highness, that's tantamount to murdering them. But it's not their "
"individual lives that matter. It's their names and assets that are "
"important. Strip them of their gold, and you'll destroy pillars that support "
"your kingdom. Though your power to devastate will strike fear into the "
"hearts of the other merchants...\""
msgstr ""
"\"전하, 그건 죽이는 것이나 다름 없어. 놈들이 살아있건 말건 관계는 없어. 하지만 놈들이 가진 이름과 재산이 문제지. 놈들의 재산을 "
"빼앗으면 왕국을 지탱하는 기둥을 부수는 격이 될 거야. 다른 상인들에게 공포심을 조장하게 될 테니까...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0038_Text
#. Speaker : Capital_Shandra
msgctxt "a7259f30-f4ec-4540-9ffc-5c16ac2e0cbb"
msgid ""
"{n}The Councilor smiles at the druid graciously, but her gaze is cold.{/n} "
"\"Your Highness, I am glad there's someone in the kingdom who we may rely "
"on. Let's hope that the people's leaders will be reliable and loyal enough "
"to take the place of the kingdom's nobility.\""
msgstr ""
"{n}평의원은 드루이드에게 관대하게 미소지었지만, 그 눈빛은 차가웠습니다.{/n} \"전하, 우리가 기댈 수 있는 사람이 왕국에 있어 "
"다행이야. 이 백성들의 지도자가 왕국의 귀족들을 대신할 만큼 충성심있고 믿을만하길 바라자고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10ConspEnd/Cue_0039_Text
#. Speaker : Capital_Shandra
msgctxt "3ef36976-8424-4d4b-8562-065ac92e9450"
msgid ""
"\"But I suggest they should be pardoned. They made a mistake, true. But they "
"were caught. That will teach them to fear your wrath, and carefully consider "
"their actions in the future. They have been among the most noble people in "
"the capital. You have now their obedience. The same might not be true of "
"whoever should replace them.\""
msgstr ""
"\"난 저들이 사면되었으면 해. 실수를 하긴 했지. 하지만 붙잡혔잖아. 그것만으로도 당신의 분노에 대한 공포심을 심어줄 수 있을 거고, "
"향후 행동거지에도 재고를 하게 만들겠지. 저 사람들은 국가에서 가장 고귀한 사람들 중 하나였어. 이제 저 사람들은 당신에게 복종할 거야. "
"저들의 자리를 누구로 채우든 저들만치는 못 할 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10MerchGift/Answer_0003_Text
msgctxt "587ade39-4de0-4abb-87f8-1e88d09f8055"
msgid ""
"\"Open public schools. Even the peasants in my domain should know how to "
"read and write!\""
msgstr "\"공립학교를 설립하라. 영토 내의 농민까지도 읽고 쓰는 법을 알아야 한다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10MerchGift/Answer_0004_Text
msgctxt "b2df04fc-796a-4714-9a06-0c211c5d93e7"
msgid "\"Openly tell your neighboring partners how you are treated.\""
msgstr "\"자네 주변의 파트너들에게 어떤 취급을 받았는 지 공개적으로 말하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10MerchGift/Answer_0005_Text
msgctxt "911cc011-d889-4c37-b2ff-66189b0ece0e"
msgid ""
"\"You have ears everywhere. Put them to use. Report anything suspicious that "
"you come across.\""
msgstr "\"어디에든 귀가 있다. 그 귀를 사용하라. 수상한 것이 들리면 무엇이든 와서 보고하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10MerchGift/Cue_0001_Text
msgctxt "193fa09c-b323-40e3-8b07-7979bfe36b73"
msgid ""
"{n}A fresh-faced halfling bows before you affably. She looks very young, but "
"her voice sounds confident and bold.{/n} \"Greetings, Your Highness! I "
"represent a small trade alliance that was formed in your capital. Commerce "
"is in my blood. My family have been merchants for three generations. I am "
"here to thank you on behalf of all the other merchants that live and work in "
"your domain!\""
msgstr ""
"{n}어려보이는 하플링 하나가 당신에게 싹싹하게 몸을 굽힙니다. 그녀는 정말로 어려보이지만, 목소리는 차분하고 대담합니다.{/n} "
"\"반갑습니다, 전하! 전 전하의 수도에 있는 모든 소상인들을 대표하는 자입니다. 제 핏줄엔 돈이 흐르지요. 저희 가문은 3대째 상인을 "
"해오고 있습니다. 제가 여기 찾아온 이유는 전하의 영토에서 살고 일하는 모든 상인들을 대표해 할 말이 있어서 입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10MerchGift/Cue_0006_Text
msgctxt "63c0a22b-ab6f-4b2d-8736-c70a18865913"
msgid ""
"\"That's a very wise demand! An educated youth could come in handy, "
"especially now that trade in the {g|Stolen Lands}Stolen Lands{/g} is "
"flourishing!\""
msgstr ""
"\"참으로 현명한 요구입니다! 교육받은 아이들은 쓸모가 많지요. 특히 지금처럼 {g|Stolen Lands}도둑맞은 땅{/g} 이 "
"무역으로 번영하고 있는 때라면 말이죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10MerchGift/Cue_0007_Text
msgctxt "19876d2d-f6b7-4ded-84d9-c1f67e6911d5"
msgid ""
"\"Oh, I see! Rest assured, the merchants of the neighboring lands will be "
"green with envy. We will spread the greater glory of your name from here to "
"{g|Absalom}Absalom{/g}!\""
msgstr ""
"\"아, 알겠습니다! 푹 쉬시지요. 이웃 땅의 상인들은 질투로 얼굴이 헬쑥해지겠군요. 전하의 뇌성대명을 여기서부터 "
"{g|Absalom}압살롬{/g} 까지 널리 퍼뜨리겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10MerchGift/Cue_0008_Text
msgctxt "9e4ba7d5-7741-41c3-9feb-78abd70c860b"
msgid ""
"\"Of course. If the merchants learn that some rascal is planning to cause "
"trouble, the guards will be informed of it right away.\""
msgstr "\"물론입니다. 나쁜 자들이 문제를 꾀하고 있다는 걸 상인들이 알게 되면 곧바로 경비대에게 알리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10MerchGift/Cue_0009_Text
msgctxt "cfbe6c5a-7d23-44e3-b98b-7f530e35ef99"
msgid ""
"\"Lords often consider us nothing but milk cows for the state. We appreciate "
"that you have let us go about our business. You didn't rob us as you grew in "
"power. We're not used to such decent treatment, and your good faith and "
"understanding have been a great boon. My friends and I discussed it, and "
"decided that we'd return the favor. Tell us, what can we do for you, Your "
"Highness?\""
msgstr ""
"\"간혹 군주들은 저희를 국가를 위한 젖소 정도로만 여기곤 하지요. 사업에 대해 허가를 내려주셔서 정말로 감사합니다. 전하께서는 힘을 "
"기르신다고 저희를 수탈하지 않으셨습니다. 이런 대우에 저희는 익숙치 않았지만, 전하의 선의와 이해심은 참으로 도움이 많이 되었습니다. 제 "
"친구들과 상의 해본 결과, 전하께 저희가 받은 호의를 돌려줘야겠다는 결론을 내렸습니다. 말씀만 해주십시오, 뭘 해드리면 되겠습니까 전하?"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Answer_0006_Text
msgctxt "c4e54e01-29c7-40b3-bcf8-a122664dbccf"
msgid "{g|Loyalty10_4}[Choice effects]{/g} \"Off with their heads!\""
msgstr "{g|Loyalty10_4}[선택 시 효과]{/g} \"놈들의 목을 잘라라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Answer_0007_Text
msgctxt "18af66ef-204b-49df-84d0-1597c580767d"
msgid ""
"{g|Loyalty10_5}[Choice effects]{/g} \"I will grant pardon to them if the "
"priests agree to bail them out.\""
msgstr "{g|Loyalty10_5}[선택 시 효과]{/g} \"사제들이 사면을 원한다면 사면토록 하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Answer_0008_AlignmentShift.Description
msgctxt "66fd5b1a-3fd8-4c19-af06-72575a08fc79"
msgid "Showed mercy to the rebels by sending them to the army."
msgstr "반란분자들을 군대로 보내 자비를 보였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Answer_0008_Text
msgctxt "f825fa94-dd07-4b5b-8962-bbcd38cd61a0"
msgid ""
"{g|Loyalty10_6}[Choice effects]{/g} \"I'll spare their lives, but I cannot "
"let them go just like that. Let them make up for their sins by the honest "
"service in my army.\""
msgstr ""
"{g|Loyalty10_6}[선택 시 효과]{/g} \"저들의 목숨은 살려두겠다. 하지만 그냥 보낼 수는 없지. 지은 죄의 값 만큼 우리 "
"군에서 복역하게 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Answer_0009_Text
msgctxt "5e092838-2da3-495b-9cd1-b497e53268d9"
msgid "\"Decide their fate by yourself.\""
msgstr "\"놈들의 운명은 자네가 결정하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Answer_0024_Text
msgctxt "aad2ae35-4341-4095-96d8-6909101f28d5"
msgid ""
"\"Open public schools at the cost of your profits. Even the peasants in my "
"domain must know how to read and write!\""
msgstr "\"그대의 돈으로 공립 학교를 설립하라. 영토 내의 농민까지도 읽고 쓰는 법을 알아야 한다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Answer_0025_Text
msgctxt "d2162d99-118d-4040-90e9-b1c7517edacd"
msgid "\"I love magic trinkets.\""
msgstr "\"난 마법 장신구가 좋더군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Answer_0026_Text
msgctxt "89eba91e-4232-4a94-89b1-fbac791580c6"
msgid "\"You're wealthy, so reward me with gold.\""
msgstr "\"돈이 많을 터이니, 돈으로 보상해주길 바란다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0001_Text
#. Speaker : Tristian_Companion
msgctxt "2027228a-e5d4-4005-8de2-294f37b4561e"
msgid ""
"\"Now to the bad news. The guards arrested a few citizens, organizers of "
"riots in the wealthy quarter. You must determine their fate. You can impose "
"strict penalties... or show mercy – that's what I'd like to ask you to do. "
"Perhaps, you could kindly allow priests of {g|Erastil}Erastil{/g} and "
"{g|Sarenrae}Sarenrae{/g} to bail out their followers.\""
msgstr ""
"\"나쁜 소식입니다. 경비대가 시민을 몇 명 체포했는데, 부민 지구에서 폭동을 조직하려고 했습니다. 저들의 처우를 결정해야 합니다. "
"엄격하게 처벌하거나... 자비를 보여줄 수도 있습니다. 저라면 자비를 보여주는 쪽이 더 좋을 거 같습니다만. "
"{g|Erastil}에리스틸{/g} 과 {g|Sarenrae}서렌레이{/g} 의 사제들에게 신도들을 사면해달라고 할 수도 있겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0003_Text
#. Speaker : Capital_Tsanna
msgctxt "cdc7a42a-6ead-43b1-8964-2a93f6401c6b"
msgid ""
"\"Today the assembly of merchants decided that the city would hold a feast "
"in your honor! It's so lovely when your name is associated with joy and "
"wealth. It means, your pack is flourishing, and they know who they should "
"thank for it.\""
msgstr ""
"\"오늘 상인 무리가 도시에서 당신의 명예를 드높이고자 축제를 열기로 했어! 당신 이름이 즐거움과 풍요로움에 관련되어 있다니 참으로 "
"기쁘네. 이 말인 즉슨, 무리가 번영중이고 누구에게 감사해야 하는 지 알고있다는 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0010_Text
#. Speaker : Tristian_Companion
msgctxt "bdfa0c8a-8774-4d35-abe7-98b27a70fdc2"
msgid ""
"\"I understand... your wrath. Although I'm sorry for the poor fellows that "
"were denied mercy.\""
msgstr "\"그 분노를... 이해합니다. 다만 불쌍한 이들에게 자비의 손을 내밀지 못해 유감이로군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0011_Text
#. Speaker : Capital_Tsanna
msgctxt "1c28f87e-191f-4027-a6ac-676dace4f552"
msgid ""
"\"It's a shame. They were ambitious and strong. But they never feared you, "
"so they would have caused trouble anyway.\""
msgstr "\"안타깝군. 야망넘치고 튼튼한 자들이었는데. 당신을 두려워할 줄을 몰랐지. 그래서 문제를 일으킨 거고 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0012_Text
#. Speaker : Tristian_Companion
msgctxt "32078ac0-1390-4bc9-ba74-abb457cad297"
msgid ""
"\"The priests will gladly take the responsibility. This is merciful and "
"wise. Thank you!\""
msgstr "\"사제들은 기꺼이 책임을 지려 할 것입니다. 사려깊고 현명한 판단입니다. 감사합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0013_Text
#. Speaker : Capital_Tsanna
msgctxt "18e653f3-de0e-4c90-ac03-2a2157396573"
msgid ""
"\"I'm surprised at how willingly you share credit with these prudes. But "
"it's your decision, of course.\""
msgstr "\"이 내숭덩어리들이랑 그렇게 거리낌없이 서로 보듬을 줄은 몰랐네. 하지만 당신의 결정이니까 뭐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0014_Text
#. Speaker : Tristian_Companion
msgctxt "7466d63d-5398-428c-9f16-d02f14d817d3"
msgid "\"It is merciful and just. Let me pass your message to the general.\""
msgstr "\"자비롭고 공정한 결정입니다. 장군에게 전하도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0015_Text
#. Speaker : Capital_Tsanna
msgctxt "c53532eb-2681-4dbf-8bc8-e958094c9d2d"
msgid ""
"\"I agree. Why waste such daring and strong fellows? They may serve your "
"pack!\""
msgstr "\"동의해. 그토록 대담하고 강인한 놈들을 낭비할 이유가 없지. 네 무리를 섬기는 건 당연한 일이야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0016_Text
#. Speaker : Tristian_Companion
msgctxt "de59785f-8943-41c9-ae4c-6ec5352b0dde"
msgid ""
"\"Let's send them off to the temple for schooling. Priests will help their "
"heads clear by hard labor and a word of wisdom.\""
msgstr "\"저들을 교화시키기 위해 사원으로 보냅시다. 사제들이 힘든 노동과 지혜로운 말로써 저들의 머리를 정화시켜줄 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0017_Text
#. Speaker : Capital_Tsanna
msgctxt "49598229-0372-47cb-b4b5-83bfb0d175fc"
msgid ""
"\"I will dispatch them to your army. Their fault must be washed off with "
"enemies' blood. They're destined by fate to induce rage of their comrades.\""
msgstr "\"놈들을 네 군대로 보낼게. 잘못은 적의 피로 씻어내려야 하는 법. 동료들의 분노를 사는 것도 저들 운명이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0018_Text
#. Speaker : Tristian_Companion
msgctxt "0c937a82-a768-4ea7-a7af-16adaac6d57f"
msgid ""
"\"There's someone else waiting for your audience. Please, take the time to "
"talk to the visitor. It's the head of {kingdomname} kingdom's trade society."
"\""
msgstr "\"알현을 기다리고 있는 사람이 있습니다. 방문자를 맞아주시지요. {kingdomname} 왕국 무역단체의 수장입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0019_Text
#. Speaker : Capital_Tsanna
msgctxt "fda4ec0c-cf61-43c1-81af-e60818d76840"
msgid ""
"\"Now that we're done with the rebels, I'd like to ask you to receive one "
"more visitor. It's the leader of merchants of your kingdom.\""
msgstr "\"이제 반란군 얘기는 끝났으니, 다음 방문객을 맞이하라고 하고 싶어. 당신 왕국에 있는 상인들의 수장이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0020_Text
#. Speaker : Tristian_Companion
msgctxt "5721ccae-4b4e-4d30-bf0f-cac390dfbb7c"
msgid ""
"\"{name}, today the high society council decided that the city would hold a "
"feast in your honor! With street food, fairs, music and fun! The people want "
"to thank you for their peaceful, abundant life.\""
msgstr ""
"\"{name}, 오늘 상원의원 쪽에서 당신의 명예를 기리는 축제를 열기로 했습니다! 거리 음식과 공연, 음악이 가득합니다! 사람들이 "
"평화롭고 풍요로운 삶에 감사를 드리려고 하는군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0021_Text
#. Speaker : Capital_Tsanna
msgctxt "fdce2d48-71e7-4acd-902a-9ce91438ab7c"
msgid ""
"\"There's something else. The guards arrested the last organizer of the riot "
"today. It's time to pronounce the verdict. You may demonstrate your "
"strictness by executing them. Or you may acquire a reputation of a merciful "
"leader by pardoning and sending them off to purge the guilt with blood. The "
"only thing you shouldn't do is listen to {g|Erastil}Erastil{/g} and "
"{g|Sarenrae}Sarenrae's{/g} priests. They want you to pardon the "
"troublemakers and send them to temples on probation. Even if you do so, it's "
"them who will get the credit for mercifulness, not you.\""
msgstr ""
"\"그리고 또 있어. 경비대가 폭동의 마지막 주최자를 오늘 체포했어. 평결을 내릴 시간이야. 놈들을 처형해서 법의 지엄함을 증명할 수도 "
"있어. 아니면 놈들을 피로써 그 죄값을 갚으라고 군대로 보내 자비로운 군주라는 명성을 얻을 수도 있지. {g|Erastil}에라스틸{/g}"
" 과 {g|Sarenrae}서렌레이{/g} 사제들의 말만 듣지 마. 놈들은 당신이 그자들을 사면하고 보호관찰을 위해 사원에 보내기를 "
"바라고 있어. 그렇게 한다면, 자비로움의 명예를 얻는 것은 당신이 아니라 그 사제들이 될 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0022_Text
#. Speaker : RankUp_Merchant
msgctxt "f3f0117a-d744-4cbc-be2f-3c8302b42c8c"
msgid ""
"{n}A solid halfling with graying hair bows to you politely and wipes off the "
"excessive sweat.{/n} \"Greetings, Your Highness! I am here to thank you on "
"behalf of all merchants that live in your domain! Lords often consider us as "
"money cows. We appreciate that you let us go about our own business. You "
"didn't get to rob us as you took power. We discussed the matter and decided "
"that we'd like to pay you back for your kind understanding. What can we do "
"for you, Your Highness?\""
msgstr ""
"{n}새어가는 머리의 튼튼해보이는 하플링이 공손하게 당신의 앞에 몸을 숙이고 흘러내리는 땀을 닦아냅니다.{/n} \"반갑습니다, 전하! "
"전하의 땅에 살고있는 모든 상인들을 대표해 감사의 말씀을 전하고자 왔습니다! 군주들은 간혹 저희를 돈을 짜내는 젖소로 생각하곤 하지요. "
"하지만 전하께선 권력을 위해 저희를 수탈하지 않으셨습니다. 저희가 논의해본 결과 전하께서 내려주신 아량과 은혜에 보답하기로 결정을 "
"내렸습니다. 저희가 어떻게 도움이 되어드릴 수 있을까요, 전하?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0027_Text
#. Speaker : RankUp_Merchant
msgctxt "d5eafb90-35b0-4e8e-9df0-1fae537f696f"
msgid ""
"\"It's a very wise demand! The educated youth may come in handy, especially "
"now that the trade in the {g|Stolen Lands}Stolen Lands{/g} is flourishing!\""
msgstr ""
"\"참으로 현명한 결정입니다! 교육받은 아이들은 쓸모가 많지요.특히 지금처럼 {g|Stolen Lands}도둑맞은 땅{/g} 이 무역으로 "
"번영하고 있는 때라면 말이죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0028_Text
#. Speaker : RankUp_Merchant
msgctxt "c6a2255a-92b3-41fe-87e9-0a39dc7b39b7"
msgid ""
"\"You have a fine taste! My colleagues and I will do our best to surprise "
"you with a decent gift!\""
msgstr "\"참으로 고상한 취향이시군요! 제 동료들과 제가 멋진 선물로 전하를 놀래켜보도록 최선을 다하겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0029_Text
#. Speaker : RankUp_Merchant
msgctxt "b56d94f4-0e15-481f-8f0d-98865fdb863b"
msgid ""
"\"Believe me, Your Highness! We will spare no expense for the most luxurious "
"monument possible! It will make rulers of other kingdoms jealous!\""
msgstr ""
"\"믿어주시지요, 전하! 가능한 최고로 사치스러운 기념비를 만드는 데 돈을 아끼지 않겠습니다! 다른 왕국의 지도자들이 부러워 할 겁니다!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0030_Text
#. Speaker : Tristian_Companion
msgctxt "5caa1cc1-b106-41a1-8478-7cdb6d15f2fc"
msgid ""
"\"Don't forget to pay well to your servants, not only to your ruler!\" {n}"
"Tristian stops, looks at you apologetically and smiles.{/n}"
msgstr ""
"\"군주에게만 잘 대하지 말고, 하인들에게도 잘 대해주시오!\" {n}트리스티안은 멈추더니, 당신을 멋쩍게 보면서 웃습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0031_Text
#. Speaker : Capital_Tsanna
msgctxt "1dede5e8-f777-4de4-ac6f-5e823235d1bd"
msgid ""
"\"Remember who you owe your abundant life in the capital to, without having "
"to hide from robbers in the bushes.\" {n}The merchant nods hastily. Tsanna "
"looks up and down at him, like a cook checking out a fresh steak that goes "
"straight into cauldron.{/n}"
msgstr ""
"\"풀숲의 도적들에게 돈을 숨기지 않고, 누구 덕택에 수도에서 풍요로운 삶을 사는 지 기억해 봐.\" {n}상인은 허겁지겁 끄덕입니다. "
"산나는 마치 가마솥에 들어가는 신선한 고깃덩어리를 보는 것 마냥 그 상인을 위아래로 훑어봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0032_Text
#. Speaker : Capital_Shandra
msgctxt "59902776-3de8-4faa-a771-51f2b914cb71"
msgid ""
"\"Your Highness, the instigators of the riot have been arrested. You will "
"have to determine their fate. If you're asking yourself whether you should "
"make a grand gesture and pardon them, the answer is no. They're as dangerous "
"as a hound that tasted blood.\""
msgstr ""
"\"전하, 폭동을 선동한 자들이 체포되었습니다. 저들의 운명을 결정해주시지요. 혹여라도 품위있는 모습을 보여야한다는 생각에 저들을 "
"사면해야 한다고 생각하시면, 그에 대한 대답은 아니오 입니다. 저들은 피 맛을 본 사냥개처럼 위험합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0033_Text
#. Speaker : Capital_Shandra
msgctxt "b0dda7b5-4621-45f7-b6b7-0fbee0792145"
msgid ""
"\"It's questionable. They'll keep spreading their dissidence among soldiers. "
"The army mutiny is going to turn out much, much worse. I'll send my agents "
"for surveillance.\""
msgstr ""
"\"미심쩍군요. 저들은 계속해서 군인들 사이로 불화를 퍼뜨릴 겁니다. 군대의 반란은 훨씬 심각해 지겠지요. 제 요원들을 보내 조사를 "
"해보겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0034_Text
#. Speaker : Capital_Shandra
msgctxt "eb0f3911-622d-4615-9406-f7773ad27f8a"
msgid ""
"\"Your gentle heart will get you in trouble. The only lesson they'll learn, "
"is that starting a riot doesn't carry a penalty. The next riot will gather "
"even more followers. Those who got scared of the punishment last time, will "
"certainly join the next riot.\""
msgstr ""
"\"전하의 온화한 심성이 전하를 위험에 빠뜨릴 것입니다. 저들은 폭동을 일으켜도 아무런 제재를 받지 않는다는 걸 알게 될 겁니다. 다음 "
"번엔 더 많은 사람들이 따르겠지요. 두려움 때문에 지난 폭동에 참여하지 못한 이들도 분명 다음 폭동에는 참여할 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0035_Text
#. Speaker : Capital_Shandra
msgctxt "e20c9d49-cb5a-47e7-b945-1da83cc98846"
msgid ""
"\"Hang the troublemakers. It's your best option. It'll teach peasants a "
"proper lesson. Just the idea of a riot makes the kingdom unreliable.\""
msgstr ""
"\"문제가 되는 이들을 처형하십시오. 최선의 방책입니다. 백성들에게도 적절한 교훈이 될 겁니다. 폭동을 해야겠다는 생각 만으로도 왕국이 "
"위험할 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0036_Text
#. Speaker : Capital_Shandra
msgctxt "28db7f7e-51b6-44ee-98f0-442b1703fb9e"
msgid ""
"\"Now that we're done with the unpleasant task, I'd like to ask you to "
"receive an important visitor. He's the leader of merchants of your kingdom.\""
msgstr "\"불쾌한 일을 처리했으니, 중요한 방문객을 맞이하라고 권하고 싶군요. 우리 왕국 상인들의 수장입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0037_Text
#. Speaker : Capital_Shandra
msgctxt "6eef4895-5fa7-4f8a-97f6-70c1d3143178"
msgid ""
"\"I'm happy my advice came in handy, your Highness. You managed to tame the "
"natural urge to take populist measures, and carefully considered your policy "
"in a pragmatic manner. It was very insightful of you as a ruler!\""
msgstr ""
"\"제 조언이 쓸모있었다니 기쁩니다, 전하. 전하께서는 인민주의적 정책을 택하려는 본능에 저항하셨고, 숙고를 통해 실용적인 정책을 "
"택하셨습니다. 참된 군주의 통찰력을 지니셨습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank10/Loyalty_Rank10RiotEnd/Cue_0038_Text
#. Speaker : Capital_Shandra
msgctxt "c74d4b4a-a1da-4f0e-bd85-307afeed8664"
msgid ""
"\"The riot will start again unless you punish them. In Brevoy, they usually "
"hang the rebels or exile them to army service. Considering that we don't "
"want a military riot, I'm sure the rascals belong with the scaffold.\""
msgstr ""
"\"폭동은 전하께서 벌하지 않는 한 계속 될 것입니다. 브레보이에서는 보통 반란분자들을 목을 매달거나 군역을 살게 합니다. 군부의 폭동을 "
"바라지는 않으실 터이니, 저 못된 놈들은 교수대로 끌고가셔야 한다고 봅니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Answer_0011_Text
msgctxt "23c38e41-a30e-45ab-9178-164f7afbad9b"
msgid ""
"{g|Loyalty2_1}[Choice effects]{/g} \"We shall hold a fair for the common "
"people. I want them to know that I hold them closest to my heart.\""
msgstr ""
"{g|Loyalty2_1}[선택 시 효과]{/g} \"평민들을 위해 축제를 열라. 내가 그들을 가장 아끼고 있음을 알리고 싶다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Answer_0012_Text
msgctxt "a93ba3b0-2a2b-436d-8fe2-a3690952498e"
msgid ""
"{g|Loyalty2_2}[Choice effects]{/g} \"We will hold a luxurious dinner party "
"for the merchants. The support of our wealthiest citizens is essential.\""
msgstr ""
"{g|Loyalty2_2}[선택 시 효과]{/g} \"상인들을 위해 호화스러운 만찬을 열라. 가장 부유한 이들의 지지는 필수적이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Answer_0013_Text
msgctxt "e1a9c0a2-43ba-4752-8b8c-58ea14dc894b"
msgid ""
"{g|Loyalty2_3}[Choice effects]{/g} [Gain 20 BP] \"I don't care to arrange "
"anything. We can do without festivities and feasts.\""
msgstr ""
"{g|Loyalty2_3}[선택 시 효과]{/g} [20 BP 획득] \"아무것도 안 열어도 상관 없다. 축제 없이도 잘 해나갈 수 있을 "
"것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Answer_0014_Text
msgctxt "c78cbe74-f1f2-43bf-a327-0cd62a9cc1a5"
msgid "\"Make up your own mind. – I don't care who we pander to.\""
msgstr "\"그대의 생각대로 하라. 누구를 이용하든 상관치 않는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0001_Text
#. Speaker : Tristian_Companion
msgctxt "2f1aacbe-4423-42bf-b7ec-e54b740d6f14"
msgid ""
"{n}Tristian lowers his head.{/n} \"Greetings, {mf|baron|baroness|King|Queen}"
". I am sorry to take you away from your other affairs, but your people need "
"you.\""
msgstr ""
"{n}트리스티안이 당신에게 고개를 숙입니다.{/n} \"안녕하십니까, {mf|남작님|여남작님|전하|전하}. 바쁘신 와중에 죄송합니다만, "
"백성들이 당신을 필요로 하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0002_Text
#. Speaker : Capital_Shandra
msgctxt "45d92e61-62e9-4902-97b2-dd3370c22ea2"
msgid ""
"{n}Shandra bows briskly.{/n} \"{mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}, please spare me a moment of your time. As you know, it is my "
"responsibility to hear what words are spoken when you are absent. And I must "
"say, what I have heard lately does not bring me peace. The people are "
"suspicious of their new {mf|baron|baroness|King|Queen}. But I know how to "
"solve this problem.\""
msgstr ""
"{n}샨드라는 빠르게 허리를 숙입니다.{/n} \"{mf|영주님|영주님|전하|전하}, 잠시 시간 좀 내주십시오. 아시겠지만, 당신께서 "
"부재중이신 때 들리는 소리를 듣는 것이 제 임무입니다. 그래서 최근에 제가 들은 유쾌하지 못한 소식에 대한 말씀을 드리지 않을 수 "
"없군요. 사람들이 새로운 {mf|남작|여남작|왕|여왕}에 대해 미심쩍어 하고 있습니다. 그러나, 다행히 제가 이 문제를 해결하는 법을 "
"알고 있지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0004_Text
#. Speaker : Tristian_Companion
msgctxt "004bf7d9-ed9d-4f98-9718-7088e6c57407"
msgid ""
"\"When the {g|Stolen Lands}Stolen Lands{/g} were freed from the Stag Lord, "
"the people sighed in relief. But many are still confused by their swift "
"change of fortune. Truth be told, they simply don't know what to think of "
"their new {mf|baron|baroness|king|queen}, nor what to expect of you. Will "
"you be a fair ruler for all, or only for those of wealth and status?\""
msgstr ""
"\"{g|Stolen Lands}도둑맞은 땅{/g}이 수사슴 군주로부터 해방됐을 때 백성들은 안도의 한숨을 내쉬었습니다, 하지만 여전히 "
"많은 사람들이 갑작스러운 운명의 변화로 혼란스러워합니다. 사실대로 말하자면, 그들은 단지 새로운 {mf|남작|남작|왕|여왕}에 대해 "
"어떻게 생각해야 할지, 그리고 무엇을 기대해야 할지 모르고 있습니다. 당신은 모두를 위한 공정한 통치자가 될 것입니까, 아니면 부와 "
"지위만을 위한 통치자가 될 것입니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0005_Text
#. Speaker : Tristian_Companion
msgctxt "df9717d6-afb0-4237-8336-84c5d5809314"
msgid ""
"\"Let us reassure your people – show them where your favor truly rests. "
"Perhaps a small celebration would help to win them over. Of course, you "
"could spend the same amount on a luxurious dinner for the wealthiest of your "
"barony, but I recommend organizing a fair for the common people – the ones "
"upon whose shoulders your power truly resides!\""
msgstr ""
"\"당신의 호의가 진정 어디에 있는지 보여줌으로써 백성들을 안심시키십시오. 아마 작은 축제가 그들을 안심시키는 데 도움이 될 것입니다. "
"물론, 그럴 예산으로 남작령의 부유층들과 함께 호화로운 저녁 만찬을 가지실 수도 있지만, 저는 평민들을 위한 축제를 개최할 것을 권장 "
"드립니다. 당신의 힘이 진정으로 깃든 자들을 위한 축제 말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0006_Text
#. Speaker : Capital_Shandra
msgctxt "5a7a3466-5c42-4e1c-872b-a12e1c88bed3"
msgid ""
"{n}Shandra holds out a piece of paper.{/n} \"I took the liberty of composing "
"a list of the wealthiest and most influential merchants in the region. All "
"that is required of you is to hold an lavish dinner, to show them how "
"generously their support is rewarded. This would draw heavily from the "
"treasury, but I'm sure they will appreciate the gesture, and your noble "
"attention.\""
msgstr ""
"{n}샨드라가 종이를 내밉니다.{/n} \"이 지역에서 가장 부유하고 영향력있는 상인들의 명단입니다. 호화로운 만찬을 열어 그들의 지지가 "
"어떤 보상으로 돌아오는지 보여줄 필요가 있습니다. 국고에서 돈을 좀 많이 쓰게 되겠지만, 당신의 고귀한 관심에 상인들은 감사할 것입니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0007_Text
#. Speaker : Capital_Shandra
msgctxt "adb26afc-cfed-4f90-9451-09738016a750"
msgid ""
"{n}Shandra ponders for a moment.{/n} \"Of course you could use the dinner "
"money instead to entertain your peasants, but I wouldn't recommend it. The "
"whims of the crowd change with the wind. They will forget your generosity "
"after the first bad harvest.\""
msgstr ""
"{n}샨드라가 잠시 생각에 잠깁니다.{/n} \"물론 이 예산을 농민들을 접대하는 데에 쓸 수도 있겠지만, 저는 추천하지 않습니다. "
"군중의 변덕은 바람과도 같습니다. 흉년이 한 번 닥치고 나면 당신의 관대함을 잊어버릴 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0015_Text
#. Speaker : Tristian_Companion
msgctxt "0592d3ed-6568-45d4-ab27-db198b78b204"
msgid ""
"{n}Tristian smiles warmly.{/n} \"We will hold a common celebration, where "
"everyone will be welcome – including the poor and downtrodden. This is the "
"greatest gift a ruler can give to {mf|his|her} people!\""
msgstr ""
"{n}트리스티안이 따뜻하게 웃습니다.{/n} \"우리는 가난하고 억압받는 사람들은 물론 모든 사람들에게 열린 축제를 개최할 것입니다. "
"이것은 통치자로서 자신의 백성들에게 줄 수 있는 최고의 선물입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0016_Text
#. Speaker : Capital_Shandra
msgctxt "9ec95746-0394-4d1b-89bc-421f65896d67"
msgid ""
"\"Cheap populism has never done anyone any good. You'll throw your money to "
"the wind without achieving anything. But it's your decision, {mf|Your Grace|"
"Your Grace|Your Highness|Your Highness}.\""
msgstr ""
"\"값싼 인민주의는 아무에게도 도움 되지 않습니다. 결국 아무것도 이루지 못한 채 돈 낭비만 하게 되겠죠. 하지만 이것은 당신의 "
"선택입니다, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0018_Text
#. Speaker : Tristian_Companion
msgctxt "db427da0-31e6-4071-910a-57d45b5b5251"
msgid ""
"{n}Tristian keeps silent for a few moments. He is choosing his words very "
"carefully.{/n} \"It saddens me to see money that could feed the hungry and "
"bring joy to the suffering, will instead be spent on a feast for the "
"wealthy. But if that is your decision, I cannot change it.\""
msgstr ""
"{n}트리스티안은 침묵에 빠집니다. 할 말을 매우 신중히 고르는 듯합니다.{/n} \"배고픈 사람들을 먹여 살릴 수 있고 고틍받는 "
"이들에게 기쁨을 줄 수 있는 돈이 부유층을 위한 향연에 쓰일 것이라는 사실은 저를 슬프게 하는군요. 하지만 그게 당신의 결정이라면 바꿀 "
"수 없겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0019_Text
#. Speaker : Capital_Shandra
msgctxt "2331c117-bc42-44be-9344-30aeac8dae45"
msgid ""
"\"An impeccable choice, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. I shall make the necessary arrangements.\""
msgstr "\"탁월한 결정이십니다, {mf|영주님|영주님|전하|전하}. 필요한 준비를 하도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0021_Text
#. Speaker : Tristian_Companion
msgctxt "00600bf0-70e7-4d7b-8c3f-07084554eace"
msgid ""
"\"But...\" {n}Tristian interrupts himself and sighs.{/n} \"As you wish, "
"{name}. As you wish.\""
msgstr ""
"\"하지만...\" {n}트리스티안은 말을 멈추고 한숨을 내쉽니다.{/n} \"당신의 뜻대로, {name}. 당신의 뜻대로 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0022_Text
#. Speaker : Capital_Shandra
msgctxt "0ce44a72-385c-443e-9340-8c941322cc7e"
msgid ""
"{n}Shandra raises her puzzled eyebrow.{/n} \"Are you afraid of the extra "
"expense? You shouldn't be. But if this is your decision, so be it.\""
msgstr ""
"{n}샨드라는 어리둥절한지 눈썹을 치켜올립니다.{/n} \"추가적인 비용이 두려우십니까? 그래선 안됩니다. 하지만 이것이 당신의 "
"결정이라면, 그렇게 하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0024_Text
#. Speaker : Tristian_Companion
msgctxt "19891867-c242-48f1-9b5a-8469d7b0ed18"
msgid ""
"{n}Tristian's face darkens at your words, but he hides it, lowering his "
"head.{/n} \"Then I shall commence preparations for the folk fair.\""
msgstr ""
"{n}트리스티안의 얼굴이 당신의 말에 어두워지지만, 고개를 숙이며 어두운 얼굴을 숨깁니다.{/n} \"그럼, 축제 준비를 시작하겠습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0025_Text
#. Speaker : Capital_Shandra
msgctxt "dca10855-3ad1-43cd-8f72-24ef18ea2825"
msgid ""
"{n}Shandra looks through her list.{/n} \"I will send out invitations to the "
"merchants today.\""
msgstr "{n}샨드라는 목록을 살펴봅니다.{/n} \"오늘 상인들에게 초대장을 보내두겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0027_Text
#. Speaker : Capital_Tsanna
msgctxt "c9aec0f4-4d81-47bb-864a-5064eb07c46b"
msgid ""
"\"{name}, I'm offering you guidance on leading your pack, so I will share my "
"wisdom. You have won this land by right of strength. But your new pack "
"doesn't know you. Are you kind or vengeful? Should they seek your favor, or "
"flee in terror? Something tells me that the one who killed the Stag Lord "
"might become even more fearsome.\""
msgstr ""
"\"{name}, 네가 무리를 이끌고 있으니, 내 지혜를 나눠주겠다. 너는 힘의 권리로 이 땅을 쟁취했다. 하지만 네 새로운 무리는 너를 "
"몰라. 너는 다정한 인간인가, 아니면 복수심에 불타는 인간인가? 네 무리가 네 호감을 사려 할까, 아니면 공포에 질려 도망칠까? 수사슴 "
"군주보다 그를 죽인 네가 더 무시무시해질 거라는 생각이 든다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0028_Text
#. Speaker : Capital_Tsanna
msgctxt "a83eb7d2-7a65-431d-91bd-b48ea8aa7580"
msgid ""
"{n}You hear a rustling sound from under Tsanna' clothes, but she ends it "
"with a swift, impatient slap on her hip.{/n} \"Show your pack that you bring "
"peace and prosperity. Give them food. A feast is the surest way to loyalty. "
"And make no distinction between the wealthy and the poor.\""
msgstr ""
"{n}산나의 옷 밑에서 바스락거리는 소리가 들리지만, 그녀는 짜증스럽게 자기 엉덩이를 찰싹 때리며 빠르게 끝냅니다.{/n} \"너의 "
"무리에게 평화와 번영을 가져오는 것을 보여줘라. 음식을 주고 연회를 여는 것이 충성심을 얻는 가장 확실한 방법일 것이다. 그리고 부자와 "
"가난한 자를 구별하지 마라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0029_Text
#. Speaker : Capital_Tsanna
msgctxt "8a99a4c3-2e5d-4f39-bf9a-a516f7d75e8a"
msgid ""
"{n}A rat's grey face peeps out of Tsanna's sleeve.{/n} \"Very well. The "
"people will enjoy a royal feast, and my rats will sup upon their leftovers "
"and scraps.\""
msgstr ""
"{n}쥐의 잿빛 얼굴이 산나의 소매 속에서 보입니다.{/n} \"아주 잘했다. 백성들은 왕의 잔치를 즐길 것이고, 내 쥐들을 남은 음식과 "
"찌꺼기로 저녁 식사를 할 것이다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0030_Text
#. Speaker : Capital_Tsanna
msgctxt "932a160a-34b1-4dbd-a2f8-b5f987a51642"
msgid ""
"\"This is wrong, {name}. You tease your pack by feeding the well-fed in "
"front of the hungry. If you mock the hungry brutes long enough, they'll come "
"to you at night to gnaw upon your bones. Is that not right, my children?\" "
"{n}Two little grey faces emerge from Tsanna's sleeves.{/n}"
msgstr ""
"\"이건 잘못되었다, {name}. 넌 배부른 이들이 잘 먹는 곳 앞에 배고픈 자들을 세워서 배고픈 네 무리를 괴롭힌다. 배고픈 짐승을 "
"조롱하면 밤에 와서 네 뼈를 갉아먹을 것이다. 그렇지 않으냐? 내 아이들아?\" {n}산나의 소매에서 두 개의 작은 회색 얼굴이 "
"내비칩니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0031_Text
#. Speaker : Capital_Tsanna
msgctxt "f1b108ef-331c-4765-98ae-7343cc2a7cf8"
msgid ""
"\"It is your right. If you wish to be a strict leader, such gestures are "
"beneath you.\""
msgstr "\"그건 너의 권리이다. 엄격한 지도자가 되고싶다면, 그런 행동은 품위에 어울리지 않는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0032_Text
#. Speaker : Capital_Tsanna
msgctxt "d7be6198-9732-4439-a790-d0abb0b07b7e"
msgid ""
"\"I will succor your pack. Your subjects shall be fed and happy, and the "
"traders well entertained.\" {n}You see a rat's nose peek out from under "
"Tsanna's hair.{/n}"
msgstr ""
"\"너의 무리를 도와주겠다. 너의 백성들은 배부르고 행복해질 것이며, 상인들은 즐겁게 대접할 것이다.\" {n}산나의 머리카락 밑에서 "
"쥐의 코끝이 보입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank2/Cue_0033_Text
#. Speaker : Capital_Tsanna
msgctxt "1acc7466-980a-4424-aee9-f525b7b91d75"
msgid ""
"\"I know that your wealthy merchants seem the most powerful within your "
"pack. It may feel right to throw a feast for them and leave others to fight "
"over scraps. But beware of spoiling them before they prove their loyalty.\" "
"{n}You hear the rustling once again, and the folds of Tsanna's clothes shift "
"and ripple.{/n}"
msgstr ""
"\"부유한 상인들이 네 무리에서 가장 강력한 자들이라는 건 나도 알고있다. 상인들을 연회에 던져놓고 다른 놈들끼리 찌꺼기를 두고 싸우게 "
"하는 게 좋아 보일 지도 모르지. 하지만 놈들이 충성심을 증명할 때 까진 방심하지 말길 바란다.\" {n}바스락거리는 소리가 다시 한 번 "
"들리고, 산나의 옷주름이 움직이며 물결을 일으킵니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Answer_0004_Text
msgctxt "913336b4-95c6-4e83-830d-3827671abb5f"
msgid ""
"{g|Loyalty3_1}[Choice effects]{/g} [Gain 30 BP] \"Arrest that shifty "
"merchant immediately! He'll answer for selling stolen goods, even if it "
"happened before my time.\""
msgstr ""
"{g|Loyalty3_1}[선택 시 효과]{/g} [30 BP 획득] \"그 구린내나는 상인을 당장에 체포하라! 내가 이 자리에 앉기 "
"전에 일어난 일이라도 상관 없다. 장물 판매에 대해 성토하게 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Answer_0012_Text
msgctxt "c4a9c903-898e-4f57-8fa1-0a014afc9e69"
msgid "\"I'd prefer to forget about this minor matter.\""
msgstr "\"이런 사소한 문제는 잊어버리겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Answer_0013_Text
msgctxt "72526c2a-8e3f-4f22-ae04-800b65764c74"
msgid "\"Why don't you make your own decision?\""
msgstr "\"그대가 직접 결정해 보는 건 어떤가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Answer_0023_Text
msgctxt "8e75654f-451d-4a04-b20f-4f37d6fbcddc"
msgid ""
"{g|Loyalty3_3}[Choice effects]{/g} \"I will issue an order for free pardons. "
"Let the peasants keep out their countrymen's business.\""
msgstr ""
"{g|Loyalty3_3}[선택 시 효과]{/g} \"특사에 대한 명령을 하달할 것이다. 농민들이 동포의 일에 신경쓰지 않게 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Answer_0029_AlignmentShift.Description
msgctxt "ed679f7f-322c-423b-a969-32468316c935"
msgid "Handed the criminal over to the mob."
msgstr "범죄자를 군중에 넘겼습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Answer_0029_Text
msgctxt "2c9b059c-4f7d-4d1f-93d4-533111c54e30"
msgid ""
"{g|Loyalty3_4}[Choice effects]{/g} \"Turn him over to the people. Let them "
"do with him whatever they wish.\""
msgstr "{g|Loyalty3_4}[선택 시 효과]{/g} \"백성들에게 넘겨라. 원하는 대로 처리하도록 하라고 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0001_Text
#. Speaker : Tristian_Companion
msgctxt "23870f4c-2023-4a04-a0ea-a7a36af0d2a6"
msgid ""
"{n}There is a look of determination on Tristian's face.{/n} \"I bring bad "
"news from your subjects. Today one of our citizens stopped me in the street, "
"and asked me to tell you something of import.\" {n}Tristian ponders a while, "
"as if he doesn't dare continue.{/n}"
msgstr ""
"{n}트리스티안의 얼굴에 결심이 들어선 게 보인다.{/n} \"백성들로부터 나쁜 소식을 들고왔습니다. 오늘 우리 백성 중 하나가 "
"길거리에서 절 막아서더니 중요한 것을 전달해달라고 하더군요.\" {n}트리스티안은 감히 말을 잇지 못하고, 한동안 생각에 잠깁니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0002_Text
#. Speaker : Capital_Shandra
msgctxt "dfafe088-0ab4-44ab-a19b-e1887503d513"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}. A woman approached "
"me on the street and asked me to tell you of, as she put it, a 'great "
"injustice' in the capital.\""
msgstr ""
"\"{mf|영주님|영주|전하|전하님}. 거리에서 여자 하나가 절 막아서더니 말하더군요. 수도에서 '커다란 불의' 가 벌어지고 있다고 "
"말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0005_Text
#. Speaker : Tristian_Companion
msgctxt "10b6cace-fc21-4a2b-8108-7ffbd87046a5"
msgid ""
"\"You see... one of the traders, who today sells imported specialties in the "
"capital, has not always led an honest life. Under the Stag Lord, he helped "
"the bandits sell stolen goods – for a percentage, of course. This scoundrel "
"was far from the fort on the day you struck the decisive blow against the "
"Stag Lord and his band, and today he continues trading in plain view of "
"those who he recently helped rob!\""
msgstr ""
"\"아시겠지만... 현재 수도에서 수입 특산물을 팔고있는 상인 하나가 말입니다. 과거가 그리 깨끗한 인물이 아닙니다. 숫사슴 군주 아래 "
"그 자는 도적들이 장물을 파는 걸 도왔습니다. 물론 일정 지분을 받고 말입니다. 이 악한은 당신이 숫사슴 군주와 그 무리를 공격할 때 "
"요새에서 멀리 떠나있었습니다. 얼마 전 까지 강도들을 돕던 자가 계속해서 당당하게 물건을 팔고 있는 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0006_Text
#. Speaker : Tristian_Companion
msgctxt "9a17c072-0175-401e-a652-328b8fffb833"
msgid ""
"\"I never rush to judgment. But you must at least arrest this merchant, to "
"question him and give him a chance to repent. Think of those who see him in "
"the streets every day – walking free and unpunished for his crimes! The "
"people appeal to you for justice, {mf|baron|baroness|King|Queen}.\""
msgstr ""
"\"즉시 판결을 내려달라는 말은 아닙니다만, 최소한 이 상인을 체포해서 회개할 기회를 줘야 합니다. 매일 같이 거리에서 그 상인을 보는 "
"사람들을 생각해 보십시오. 자기 범죄에 대해 아무런 처벌도 받지 않고 말입니다! 백성들이 심판을 요구하고 있습니다, "
"{mf|남작님|남작님|왕이시여|여왕이시여}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0007_Text
#. Speaker : Capital_Shandra
msgctxt "2472ba6a-2e1e-452a-b5aa-86cf097271bb"
msgid ""
"\"It appears that one of the merchants doing business in the "
"{mf|barony|barony|kingdom|kingdom} has been keeping silent about his "
"previous ties to the Stag Lord and his bandits. This trader used his "
"position to his advantage, offering his services as a tradesman to act as "
"fence for the bandits' stolen goods. The merchant was away on the day you "
"defeated the Stag Lord, and since then he's kept a low profile. The "
"informant who brought this matter to our attention asks that you to give "
"this trader his due.\""
msgstr ""
"\"우리 {mf|남작령|남작령|왕국|왕국} 에서 사업을 벌이는 상인 하나가 전엔 숫사슴 군주와 그 도적떼와 결탁했더군요. 이 상인은 자기 "
"위치를 이용해 도적들의 장물을 파는 장물아비 역할을 했습니다. 당신이 숫사슴 군주를 격퇴했을 때 그 상인은 그곳에 없었습니다. 그래서 "
"지금까지 굽실거리며 살고 있는 중이지요. 이 문제를 가져온 정보원이 부탁하길 이 상인에게 심판을 내려달라고 하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0008_Text
#. Speaker : Capital_Shandra
msgctxt "f11f466c-3952-4d46-9a16-8ffd85254354"
msgid ""
"\"I fear the people will continue to demand punishment for any who were able "
"to profit during the times of trouble. If you want to know my opinion, you "
"must to do more than simply ignore this bullying – you must issue a general "
"pardon, for any who weren't directly involved in violence and vandalism. "
"Don't give these squealers any more reason to stir up trouble, or you'll "
"never hear the end of it.\""
msgstr ""
"\"혼란의 시대에 이득을 챙긴 자에게 백성들이 계속해서 처벌을 요구할까 두렵습니다. 여기에 대한 내 의견은 이 괴롭힘을 단순히 무시하기만 "
"하지 말고, 폭력과 기물파손에 직접적으로 연루되지 않은 자들에겐 사면을 내려줘야 한다고 봅니다. 이 불평꾼들에게 더 문제를 일으킬 빌미를 "
"제공하지 말아야지, 아니면 끝이 없을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0014_Text
#. Speaker : Tristian_Companion
msgctxt "f8e5de58-92b4-4d6c-8771-ccbb83bd92b0"
msgid ""
"\"I shall order that this merchant be detained. Of course we will fully "
"investigate all these rumors and get to the truth before we judge him.\""
msgstr "\"이 상인을 구금토록 하겠습니다. 물론 판결을 내리기 전 소문에 대한 진실여부를 조사할 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0015_Text
#. Speaker : Capital_Shandra
msgctxt "f2028319-b147-4b51-9451-01063cb81d80"
msgid ""
"{n}You see Shandra purse her mouth for a moment.{/n} \"I won't lie to you, "
"saying I understand your decision. In this situation I would act quite "
"differently. However, you are certainly in your own right.\""
msgstr ""
"{n}샨드라가 입술을 잠시 오므리는 모습이 보입니다.{/n} \"당신의 결정을 이해한다고 거짓말하진 않겠습니다. 이 상황에서 저라면 "
"다르게 행동했을 겁니다. 하지만 당신도 당신의 방식대로 해결하는 거겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0017_Text
#. Speaker : Tristian_Companion
msgctxt "e60e1979-9c55-47fb-a769-51eeefe2a457"
msgid ""
"{n}Tristian looks away.{/n} \"I can't agree with this decision... but I "
"understand your reasons.\" {n}The priest says no more, and falls deeply into "
"thought.{/n}"
msgstr ""
"{n}트리스티안은 눈을 돌립니다.{/n} \"이 결정엔 동의하진 못하겠습니다... 하지만 이해는 가는군요.\" {n}사제는 더 이상 말을 "
"하지 않고, 깊은 생각 속으로 빠져듭니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0018_Text
#. Speaker : Capital_Shandra
msgctxt "994155cd-3cb4-41cf-ba8e-befbc8192a61"
msgid "\"Hmm. If you think that will be enough...\""
msgstr "\"흠. 그래도 되겠다면...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0020_Text
#. Speaker : Tristian_Companion
msgctxt "cfcfc659-5c4c-4f4f-9a99-a4c2f4c5c91f"
msgid ""
"{n}Tristian sighs.{/n} \"I will handle this. To do so, I will need to detain "
"this merchant and speak with him. I'll see to it personally.\""
msgstr ""
"{n}트리스티안은 한숨 쉽니다.{/n} \"제가 해결하지요. 그러기 위해선 이 상인을 구금해서 대화를 나눠봐야겠습니다. 개인적으로 "
"처리하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0021_Text
#. Speaker : Capital_Shandra
msgctxt "150a5967-4073-447e-aa20-7cb5d9285883"
msgid ""
"\"Then I shall draft the general pardon. I am sure this will make all our "
"lives more peaceful.\""
msgstr "\"그렇다면 사면의 초안을 작성하겠습니다. 이것으로 우리 삶이 보다 평화로워질 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0024_Text
#. Speaker : Capital_Shandra
msgctxt "722e0fb7-7101-4e04-ae64-dc90823aa45b"
msgid ""
"\"A wonderful decision, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. I shall prepare the order for you.\""
msgstr "\"훌륭한 결정입니다, {mf|영주님|영주님|전하|전하}. 명령장을 준비하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0025_Text
#. Speaker : Capital_Tsanna
msgctxt "65fb0122-b7af-4afa-bec4-05f1b68a62d6"
msgid ""
"\"{name}, my confidants tell me of a wicked person in the capital. Under the "
"Stag Lord's reign, he trafficked in the bandits' stolen goods, but today he "
"wears the mask of a decent man. But we know his hands are stained with blood "
"from his ill-gotten gold.\""
msgstr ""
"\"{name}, 내 친구가 수도에 있는 나쁜 사람에 대해 말해줬다. 수사슴 군주 밑에서는 도적들의 장물을 처리하는 사람이었지만, 요즘은 "
"선량한 시민처럼 하고 다닌다는 것이다. 하지만 우리는 그사람의 손이 부정하게 얻은 황금에서 나온 피로 물들어있다는걸 안다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0026_Text
#. Speaker : Capital_Tsanna
msgctxt "1a93d7bb-7732-4593-8ee9-10697ea4a45a"
msgid ""
"\"Oh, you deprive yourself of a pleasure... It's a genuine delight to look "
"into the eyes of a man, chased down by a pack.\""
msgstr "\"아, 즐거움을 피하려는 건가... 무리에게 쫓겨 달아나는 사람의 눈을 들여다보는 건 참으로 즐거운 일인데 말이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0027_Text
#. Speaker : Capital_Tsanna
msgctxt "465d7460-efcf-4d57-a1d3-6f6a598dcece"
msgid ""
"\"Your pack will never forget. If you fail to exercise your authority, then "
"someday someone will seize it for themselves. That will be the consequence "
"of your mistake.\""
msgstr ""
"\"당신의 무리는 잊지 않을 것이다. 네가 권위를 제대로 휘두를 줄 모른다면, 네 무리가 직접 그 권위를 쥐고 휘두르겠지. 그게 네 "
"실수에 의한 결과가 될 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0028_Text
#. Speaker : Capital_Tsanna
msgctxt "b519d0e1-c4d9-44de-8793-9dfa2987cb03"
msgid ""
"\"I'll put out the word you no longer take an interest in this merchant's "
"life or well-being. Then we'll find the perfect spot to watch the chase!\""
msgstr "\"당신이 더 이상 이 상인의 인생이나 행복에 관심 없다는 것을 전하겠다. 이제 관람할 최적의 장소만 찾으면 되겠군!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0031_Text
#. Speaker : Capital_Tsanna
msgctxt "04a6009d-9d13-4159-b9dc-4d3749dfef5a"
msgid ""
"\"The people who were robbed by his cohorts surely know all about him. And "
"surely, they want revenge. I expect he's not the only one in the "
"{mf|barony|barony|kingdom|kingdom}. Whatever we subject him to, the same "
"will happen to all the others who laid down with the bandits.\""
msgstr ""
"\"믿었던 자에게 뒤통수 맞은 사람은 배신자에 대해 잘 알고있지. 그리고 분명 복수도 원할테고. 이런 사람이 "
"{mf|남작령|남작령|왕국|왕국} 내에 그 하나만은 아닐 것이다. 우리가 그 자에게 어떤 형벌을 내리든 간에, 도적떼와 결탁한 다른 "
"자에겐 똑같은 일이 벌어질 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank3/Cue_0032_Text
#. Speaker : Capital_Tsanna
msgctxt "d0182a60-b258-4129-b6ed-f3ea70032e69"
msgid ""
"\"What would you like to do with him? Grant him your protection? Send him to "
"prison? I see no crime in his actions, but punishing him will make your pack "
"love you. Let the crowd savage him, and they'll remember it was you who let "
"them taste his blood. They will adore you for it.\""
msgstr ""
"\"그자를 어떻게 할 거지? 보호를 제공할 건가? 아니면 감방으로 보낼 건가? 그의 행동엔 아무 죄가 없다. 하지만 그 자를 처벌하면 네 "
"무리가 널 좋아하겠지. 백성들이 그를 처리하게 하자. 그러면 백성들은 누가 자신들에게 피 맛을 가르쳐줬는지 기억할 것이다. 그대를 "
"공경하는 것은 물론이고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Answer_0011_Text
msgctxt "5868e6df-dcd0-4123-b494-d8ca56f5ef8b"
msgid ""
"{g|Loyalty4_1}[Choice effects]{/g} [Pay 100 BP] \"It would be well to open a "
"printing house in the capital.\""
msgstr "{g|Loyalty4_1}[선택 시 효과]{/g} [100BP 지불] \"수도에 인쇄소를 여는 것이 좋겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Answer_0012_Text
msgctxt "92f24c48-4cbc-428a-80c8-d4e5c71881dc"
msgid "\"We won't be opening a printing house in the capital.\""
msgstr "\"수도에 인쇄소를 열지 않을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Answer_0013_Text
msgctxt "c9713074-f060-47d2-a620-819afd2f2e89"
msgid "\"Make your own decision.\""
msgstr "\"당신이 결정하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Answer_0023_Text
msgctxt "42b25867-7ffb-4fa8-9610-c185a9fd198d"
msgid "\"But we have Linzi's printing shop. Why do we need another one?\""
msgstr "\"이미 린지의 인쇄소가 있는데 왜 다른 인쇄소가 필요하지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0001_Text
#. Speaker : Tristian_Companion
msgctxt "a6fc3d8c-b02d-45bd-8270-285067efeb92"
msgid ""
"\"There's something important I wanted to discuss with you.\" {n}Meeting "
"your eyes, Tristian looks away, as if perplexed.{/n} \"It's not easy to "
"admit, but recently the {mf|barony|barony|kingdom|kingdom} has grown so much "
"that I feel it slipping my grasp. Please, ease my burden by finding someone "
"for the position of curator of arts and education.\""
msgstr ""
"\"당신과 상의하고 싶은 중요한 것이 있습니다.\"{n}당신과 눈이 마주치자, 트리스티안은 당황한 듯 눈길을 돌렸습니다.{/n}\"인정하기"
" 쉽지 않지만, 최근 {mf|남작령|남작령|왕국|왕국}은 크게 성장하여 제가 붙잡지 못할 정도입니다. 누군가 예술과 교육을 담당할 학예사 "
"지위에 걸맞는 사람을 찾아 제 부담을 덜어주셨으면 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0002_Text
#. Speaker : Tristian_Companion
msgctxt "a289eade-187d-4493-ab52-c82576009eff"
msgid ""
"{n}Tristian catches his breath and smiles brightly.{/n} \"It's a huge weight "
"off my shoulders! I have other news as well, which I'm sure you will find "
"agreeable. As you know, our neighbor, {g|Galt}Galt{/g}, has been in chaos "
"for years. Their ever-changing rulers destroy that which goes against their "
"fickle doctrines, including scientists and creators. But one of them was "
"recently able to escape – to your lands!\""
msgstr ""
"{n}트리스티안은 안도하며 밝게 웃었습니다.{/n}\"제 어깨에 큰 짐이었습니다! 당신의 마음에 들 다른 소식들도 가지고 왔습니다. "
"아시다시피, 우리의 이웃국가인 {g|Galt}갈트{/g}는 오랫동안 혼란상태에 있었습니다. 그곳의 끊임없이 바뀌는 통치자들은 그들의 "
"변덕스러운 정책에 반하는 과학자와 창조자들을 포함한 모든 것들을 파괴해 왔습니다. 그런데 그들 중 한 명이 최근에 당신의 땅으로 빠져나올 "
"수 있었습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0003_Text
#. Speaker : Tristian_Companion
msgctxt "31dbdd87-e967-4a94-9890-da7e0cdb165b"
msgid ""
"\"He's the publisher of a newspaper, whose headquarters in {g|Galt}Galt{/g} "
"were burnt down after false accusations of slander. He wishes to move to the "
"capital where he will enjoy your protection, and in exchange he has offered "
"to found a new printing house! He escaped Galt with his plans for a printing "
"machine with him, and is ready to start his business here – with your "
"permission and help, of course. I think it's a wonderful opportunity – not "
"only to get our own newspaper, but to help an innocent man get back on his "
"feet. What do you say?\""
msgstr ""
"\"그는 신문을 출판하는 사람으로, {g|Galt}갈트{/g} 에 있는 그의 본부가 허위 기소로 불타 없어진 사람입니다. 우리의 보호를 "
"받으며 수도에 정착하는 대가로, 새 출판소를 차리겠다고 합니다! 갈트에서 도망칠 때 인쇄 기계에 대한 계획도 가지고 나왔기에 이곳에서 "
"사업을 시작할 준비가 되었다고 합니다. 물론 당신의 허락만 맡는다면 말이죠. 참으로 멋진 계획 같습니다. 우리만의 신문을 가지는 것 뿐만 "
"아니라, 무고한 사람을 도울 수도 있으니까요. 어떻게 생각하십니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0004_Text
#. Speaker : Capital_Shandra
msgctxt "12dd96c3-09d3-42e8-92e3-6432e8e95fad"
msgid ""
"{n}Shandra looks thoughtful.{/n} \"I am trying to solve a problem, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}. You see... my "
"responsibilities require me to focus on the most important problems of the "
"{mf|barony|barony|kingdom|kingdom}... meanwhile, less important issues – "
"particularly relating to culture, art and education – are left unattended. "
"The only way out I can see is to find a curator, who may deal with these "
"nuances, and free me to focus fully on our more urgent affairs.\""
msgstr ""
"{n}샨드라는 생각에 빠진 듯 하다.{/n} \"문제를 해결하려 하고 있습니다, {mf|영주님|영주님|전하|전하}. 아시겠지만... 저는 "
"{mf|남작령|남작령|왕국|왕국} 의 가장 중요한 문제에 집중하려고 합니다... 반면 사소한 문제는, 특히 문화, 예술이나 교육에 관련된 "
"건 별로 신경을 쓰지 못하고 있지요. 이런 문제에 신경 쓸 수 있는 학예사 한 명을 고용하시길 추천합니다. 제가 보다 긴급한 일에 집중할 "
"수 있게 말이지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0005_Text
#. Speaker : Capital_Shandra
msgctxt "3244d1d7-9a51-4be5-aa68-3481c7e2c202"
msgid ""
"\"Anyway, I've come to speak with you of another issue. There's a man from "
"Galt here in your lands, seeking asylum. He's different from the other sorry "
"refugees, fleeing {g|Galt}Galt's{/g} unending flames of revolution: this one "
"used to have his own newspaper press. Today all he possesses is a lingering "
"ambition, and the plans for a printing machine.\""
msgstr ""
"\"어쨌든, 다른 문제를 말씀드리러 왔습니다. 갈트에서 온 사람이 우리 땅에서 망명을 원하고 있습니다. 다른 블쌍한 난민과는 다르게 "
"{g|Galt}갈트{/g} 의 끝나지 않는 혁명의 불길에서 도망치던 사람이더군요. 자기 신문 출판사를 가지고있던 사람입니다. 이제 그에게 "
"남은 건 꺼지지 않는 야망과, 인쇄 기계에 대한 계획 뿐이군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0006_Text
#. Speaker : Capital_Shandra
msgctxt "bdab6e76-c705-4519-9718-463c93c5aa9e"
msgid ""
"\"You've probably guessed where I'm going with this. Much can be said "
"against Galt, but not for its lack of technical progress. I believe that "
"founding a printing house in the capital, run by an experienced manager, "
"would reflect well upon our population's education and enlightenment. "
"Besides, as patron you would control what would be printed in this workshop."
"\""
msgstr ""
"\"제가 무슨 말씀 드릴 지 대충 눈치 채셨을 겁니다. 갈트에 대해 할 말이 많긴 하지만, 부족한 갈트의 기술발전에 대해 비판하려는 것이 "
"아닙니다. 우리 수도에 경험 많은 관리자가 관리하는 인쇄소를 차리게 된다면, 분명 우리 백성들의 교육 수준과 이해 수준을 잘 반영해줄 "
"것입니다. 거기에 후원자 입장으로서 당신도 그 작업장에서 무엇을 인쇄해낼 지 마음대로 관리할 수 있겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0007_Text
#. Speaker : Capital_Tsanna
msgctxt "50e6f45f-67c3-4a1d-8a98-ea3d3e70b063"
msgid ""
"{n}Tsanna pats the two-headed rat peeping out from her clothes.{/n} \"{name}"
", everything is going smoothly in your domain. The people have filled their "
"bellies, and now they crave beauty. However, my vision of beauty... is "
"slightly differs from yours. Find a new advisor who can deal with the issues "
"of art and culture.\""
msgstr ""
"{n}산나는 옷 너머로 힐끔힐끔 쳐다보는 머리 둘 달린 쥐를 쓰다듬었습니다.{/n} \"{name}, 영토 내 모든 게 잘 돌아가고 "
"있다. 사람들이 부른 배를 쓰다듬고 있고, 아름다움을 갈망하고 있다. 하지만 내 관점에서의 아름다움이란... 그대의 것과 조금 다르지. "
"예술과 문화에 대한 문제를 해결할 수 있는 새 보좌관을 찾아보길 바란다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0008_Text
#. Speaker : Capital_Tsanna
msgctxt "9a43ca4b-b80f-40d0-abb0-8dc3483aed45"
msgid ""
"\"Before you find one, there's something I'd like to discuss. A poor fellow, "
"a typographer from {g|Galt}Galt{/g}, has come here seeking refuge with us. "
"To show his gratitude, he'd like to open a publishing house in the capital. "
"My job is to deliver the message, but if you want my opinion, it is this: "
"send him away.\""
msgstr ""
"\"보좌관을 하나 찾기 전에, 논의할 게 있다. {g|Galt}갈트{/g} 에서 온 불쌍한 인쇄공 하나가 수도에서 출판소를 열고자 한다. "
"소식을 전하는 게 내 일이지만, 사견을 더하자면, 그자를 쫓아내버려라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0009_Text
#. Speaker : Capital_Tsanna
msgctxt "4e0c5094-98c4-45f2-8fda-6d712521a193"
msgid ""
"\"It's difficult enough to manage a pack of scholars and academics. It's "
"even worse that this fellow is already someone else's prey. Don't stand in "
"the way of the {g|Galt}Galt{/g} hounds that chase him. It could end up worse "
"than you can imagine.\""
msgstr ""
"\"학자나 교수들을 관리하는 것 만으로도 충분히 힘들다. 게다가 이자들만 하더라도 이미 다른 자의 사냥감이다. 이자를 쫓는 "
"{g|Galt}갈트{/g} 의 사냥개들을 막지 말아야 한다. 생각보다 꼴이 안 좋게 끝날 수도 있다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0014_Text
#. Speaker : Tristian_Companion
msgctxt "9efc23c4-7877-4208-b578-77756def2e23"
msgid ""
"\"Wonderful! I shall immediately send a messenger to the poor fellow, and "
"inform him of your decision!\" {n}Tristian's eye flash with excitement.{/n} "
"\"You have saved another soul from hopelessness and despair!\""
msgstr ""
"\"멋지군요! 즉시 이 불쌍한 사람에게 전령을 보내 당신의 결정을 알리겠습니다!\" {n}트리스티안의 눈은 흥분으로 빛납니다.{/n} "
"\"절망과 체념으로부터 또 한 사람을 구원했군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0015_Text
#. Speaker : Capital_Shandra
msgctxt "91016432-b504-4617-857a-9286bcf00fea"
msgid ""
"\"I am happy we're of the same opinion on the matter. I'll make sure this "
"runaway receives a fair welcome in the capital.\""
msgstr "\"사안에 대해 같은 의견을 가지고 있다니 기쁘군요. 이 망명자가 우리 수도에서 환영받도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0016_Text
#. Speaker : Tristian_Companion
msgctxt "7338836c-fa40-44a3-8a28-46d8e49df563"
msgid ""
"{n}Tristian sighs.{/n} \"I am very, very sorry... well, I hope this refugee "
"finds a home somewhere else.\""
msgstr ""
"{n}트리스티안은 한숨쉽니다.{/n} \"정말로, 정말로 미안하군요.... 이 망명자가 다른 좋은 곳을 찾을 수 있길 바라야죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0017_Text
#. Speaker : Capital_Shandra
msgctxt "84f2b8c8-a2cf-49a8-8423-2b430a6c0744"
msgid ""
"{n}Shandra thinks for a few moments.{/n} \"I understand. You don't want "
"trouble with {g|Galt}Galt's{/g} authorities. Who knows what hunters chase "
"this refugee. Your decision is quite reasonable. I shall do as you say.\""
msgstr ""
"{n}샨드라는 잠시 생각합니다.{/n} \"이해합니다. {g|Galt}갈트{/g} 정부와의 충돌을 원하시지 않는 거겠지요. 어떤 현상금 "
"사냥꾼이 이 망명자를 잡으러 올 지 누가 알겠습니까. 합리적인 판단입니다. 명대로 하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0018_Text_String
#. Speaker : Capital_Tsanna
msgctxt "9fec88d2-a259-4a68-a6ed-6eab21a6e127"
msgid ""
"\"You'll cause trouble for your pack. The day you pay for this mistake will "
"surely be a black day indeed.\""
msgstr "\"네 무리를 곤경에 빠뜨릴 것이다. 이 실수로 치러야 할 대가는 혹독하겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0019_Text
#. Speaker : Capital_Tsanna
msgctxt "4020d54a-ff08-425f-be68-548344781c17"
msgid ""
"\"I agree. I'll make sure this refugee is driven from your lands as quickly "
"as possible.\""
msgstr "\"알겠다. 이 난민을 가능한 한 빨리 몰아내도록 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0020_Text
#. Speaker : Tristian_Companion
msgctxt "93590ab0-f3ba-429f-8f42-fba006a98f6d"
msgid ""
"\"Then I will immediately send a messenger with an invitation to the "
"capital. Forgive my haste, but I just can't stand by and watch someone "
"suffering.\""
msgstr ""
"\"그럼 즉시 수도로 초대하는 전갈을 보내겠습니다. 서둘러서 죄송합니다만, 남들이 고통받는 모습을 그냥 지켜만 보고 있을 수가 없군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0021_Text
#. Speaker : Capital_Shandra
msgctxt "365e8164-5560-4d28-9f54-0271a26ff2a9"
msgid ""
"\"Then I insist we open a printing house. Don't worry – I shall make all the "
"necessary arrangements.\""
msgstr "\"그럼 인쇄소를 열도록 하겠습니다. 필요한 모든 준비를 할테니 걱정마시기 바랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0022_Text
#. Speaker : Capital_Tsanna
msgctxt "ec9aa90c-cd57-41e7-9901-0ff08459b8db"
msgid ""
"\"I'll chase him from the capital, {name}. And I will make sure he never "
"approaches our borders again.\""
msgstr "\"놈을 수도에서 추적하겠다, {name}. 그리고 다시는 우리 국경 근처에도 얼씬 못 하게 만들어주지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0024_Text
#. Speaker : Tristian_Companion
msgctxt "ea81c63c-8c0c-47c8-9218-a76b3b1ba987"
msgid ""
"{n}Tristian smiles.{/n} \"Linzi publishes books, not newspapers. I doubt "
"she'd be interested in this kind of endeavor. And our guest from "
"{g|Galt}Galt{/g} specializes in it!\""
msgstr ""
"{n}트리스티안이 미소짓습니다.{/n} \"린지는 책을 출판하지요. 신문이 아니라. 린지도 이런 종류의 새 사업소가 들어오는 데 관심있을 "
"겁니다. {g|Galt}갈트{/g} 에서 온 우리 손님은 이런 쪽에 특화되어있으니 말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0025_Text
#. Speaker : Capital_Shandra
msgctxt "2b02b41a-1282-4959-bd35-db6aaa775dfb"
msgid ""
"\"With all due respect, Linzi is far too creative to manage newspaper "
"publishing. It demands certain discipline – which, I am sure, this publisher "
"from {g|Galt}Galt{/g} possesses.\""
msgstr ""
"\"기분이 상할지도 모르겠지만, 린지는 신문출판을 관리하기엔 너무 창의력이 뛰어납니다. 신문을 출판하는 데엔 교육이 필요하지요. 제가 "
"확신하는 바로는 이 {g|Galt}갈트{/g} 의 인쇄공은 그 교육을 이수했을 겁니다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank4/Cue_0026_Text
#. Speaker : Capital_Tsanna
msgctxt "9ffacaa7-0bb2-4cce-8a0b-ccb9346b384e"
msgid ""
"{n}Tsanna smiles sarcastically.{/n} \"All the more reason to reject the "
"refugee's offer.\""
msgstr "{n}산나가 비꼬듯 웃습니다.{/n} \"그러니 더더욱 난민의 제안을 거절해야지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Answer_0005_Text
msgctxt "de0ac2c6-7de2-479a-9d46-29e0eccba2a3"
msgid "\"Exempt this merchant from taxes.\""
msgstr "\"이 상인의 세금을 면제하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Answer_0007_Text
msgctxt "1735a7a1-715b-4fbe-b397-ed73030d93c4"
msgid "\"Tell him that the law in my domain applies equally to all.\""
msgstr "\"그에게 내 땅에서 법은 모두에게 공평하게 적용된다고 말하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Answer_0008_AlignmentShift.Description
msgctxt "bfa1ecfb-6316-4a92-85ec-4ed38c28d8d4"
msgid "Executed the trader for attempted bribery."
msgstr "뇌물 혐의로 상인을 처형시켰습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Answer_0008_Text
msgctxt "a334793f-abb7-4cf9-80b5-e218269d5c74"
msgid ""
"{g|Loyalty5_3}[Choice effects]{/g} [Gain 5000 gold and 40 BP] \"This corrupt "
"tradesman will pay for his insolence. Arrest and execute him.\""
msgstr ""
"{g|Loyalty5_3}[선택 시 효과]{/g} [5000 골드 및 40 BP 획득] \"이 타락한 상인은 거만함의 대가를 치를 "
"것이다. 체포하고 처형하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Answer_0009_Text
msgctxt "6f66eaaa-8f92-4639-baf4-0f6d01baf01e"
msgid "\"I trust your advice.\""
msgstr "\"그대의 조언을 믿는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0001_Text
#. Speaker : Tristian_Companion
msgctxt "0f4c3639-93aa-4694-91b9-befd3eaaaabf"
msgid ""
"\"{name}, a local merchant wishes to be relieved of his taxes, which "
"naturally stands against the laws of the {mf|barony|barony|kingdom|kingdom}. "
"In return for this… service... he promises to put in a good word for you "
"among the city's trade community.\""
msgstr ""
"\"{name}, 지역 상인이 세금을 완화해 주기를 희망하고 있는데, 이는 당연히 {mf|남작령|남작령|왕국|왕국}의 법에 위배됩니다. "
"이 서비스... 에 대한 보답... 으로 그는 도시의 무역 공동체에서 당신을 위해 좋은 말을 할 것을 약속했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0002_Text
#. Speaker : Capital_Shandra
msgctxt "eeaac375-d784-4c78-b5fc-fc474651656e"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, I've curious news "
"for you. A local merchant is trying to bribe you. He wants his new salt-"
"production shop relieved of trade taxes. In return, he promises to act as "
"your 'patron' among the {mf|barony's|barony's|kingdom's|kingdom's} trade "
"community.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 기이한 소식이 있습니다. 지역 상인이 영주님을 매수하고자 하고 있습니다. 그는 자신의 새 소금 "
"생산 공장에 세금을 완화해 줄 것을 원하고 있습니다. 그 대가로 그가 {mf|남작령의|남작령의|왕국의|왕국의} 무역 공동체에서 당신의 "
"'홍보 대사' 역할을 하겠다고 약속하더군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0003_Text
#. Speaker : Capital_Tsanna
msgctxt "1dc251d4-51e7-45a8-903a-822fd278d428"
msgid ""
"\"{name}, a merchant is offering you a business deal. He wants one of his "
"shops relieved of trade taxes. This certainly goes against our laws. "
"However, in return he promises to put in a good word for you among the high "
"society of tradesmen.\""
msgstr ""
"\"{name}, 한 지역 상인이 당신에게 사업적 거래를 제안했다. 그는 그의 사업체 중 한 곳에서 세금을 면제받고 싶어 하더군. 이건 "
"확실히 위법이다. 하지만 그 대가로 그는 상류 상인 공동체에서 너를 위해 좋은 말을 해줄 것을 약속했다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0010_Text_String
#. Speaker : Tristian_Companion
msgctxt "5701b2ac-3030-4a62-a82b-454708814b13"
msgid ""
"{n}Tristian blinks, perplexed.{/n} \"You... You're not joking, are you? So "
"you will turn your back on the equality of your subjects, in favor of those "
"who so easily buy and sell others?\""
msgstr ""
"{n}트리스티안은 당황하며 눈을 깜박입니다.{/n} \"당신... 농담하시는 겁니까? 이렇게 쉽게 당신의 상인들에게 유리함을 주고, "
"당신의 백성들에 대한 평등함에서 등을 돌리실 건가요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0011_Text
#. Speaker : Capital_Shandra
msgctxt "d4c41693-f673-44c7-80e8-968595d9ec0a"
msgid ""
"\"This deal proves your visionary leadership, {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}. The well-being of the "
"{mf|barony|barony|kingdom|kingdom}... and of your treasury... relies on "
"these people.\""
msgstr ""
"\"이 거래는 당신의 선견지명을 증명합니다, {mf|영주님|영주님|전하|전하}. {mf|남작령|남작령|왕국|왕국}의 행복... 그리고 "
"당신의 국고... 모두 백성들이 필요하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0012_Text_String
#. Speaker : Capital_Tsanna
msgctxt "16a04dee-984b-4a7f-b8e0-cc348ac3f74b"
msgid ""
"\"You shouldn't flirt with these men who imagine they own things, {name}. "
"Now that they've bought you, they'll find some way to sell you for a good "
"price.\""
msgstr ""
"\"자신이 가진 자라고 착각하는 이들과 나뒹굴면 안 된다, {name}. 이제 그들이 당신을 샀으니, 좋은 가격에 당신을 팔고자 할 "
"것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0014_Text
#. Speaker : Tristian_Companion
msgctxt "0959a4b7-6351-4527-9aef-6ceefe71603b"
msgid ""
"\"You'll have to turn down many similar offers. But eventually people will "
"come to realize that the {g|Stolen Lands}Stolen Lands{/g} have changed "
"forever. Henceforth, everyone is equal before the law.\""
msgstr ""
"\"당신은 앞으로 더 많은 이런 제안을 거절하셔야 합니다. 하지만 결국 사람들은 {g|Stolen Lands}도둑맞은 땅이{/g} 영원히 "
"변했다는 것을 알게 되겠지요. 앞으로도, 모든 이들은 법 앞에 평등할 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0015_Text_String
#. Speaker : Capital_Shandra
msgctxt "ff037751-b923-4e21-9ae5-18fb6396b68e"
msgid ""
"{n}Shandra's voice is notably cold.{/n} \"You're playing with fire, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}. These people may become "
"dangerous if they decide you threaten their most important possession – "
"their wealth.\""
msgstr ""
"{n}샨드라의 목소리가 유난히 차갑게 들립니다.{/n} \"불장난을 하고 계시군요, {mf|영주님|영주님|전하|전하}. 이 사람들은 만약 "
"당신이 그들의 가장 중요한 소유물, 즉 부를 위협한다고 생각하면 위험해질 수도 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0016_Text
#. Speaker : Capital_Tsanna
msgctxt "ab1e1fb5-b44a-4274-9fc2-f7645dd5e07b"
msgid ""
"\"Is that all? You expect him to be grateful for your lenience? He's going "
"to harbor a grudge anyway. You should have gotten rid of him.\""
msgstr "\"그게 다야? 너의 관대함에 감사할거라고 생각한거야? 뭘 하든 그는 원한을 품겠지. 그를 제거했어야 했어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0017_Text_String
#. Speaker : Tristian_Companion
msgctxt "f6f18386-18ab-49ce-b3e9-7a8049198711"
msgid ""
"\"Isn't such a verdict too strict? It's only money, after all. Can we blame "
"him for living so long in an evil, lawless country that he eventually "
"acquired something of a bandit's mentality?\""
msgstr ""
"\"그런 평결은 너무 엄격하지 않습니까? 결국 그저 돈일뿐입니다. 사악하고 무법천지인 나라에서 그렇게 오래 살다가 결국 도적의 사고방식을 "
"가지게 된 것을 탓할 수 있을까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0018_Text_String
#. Speaker : Capital_Shandra
msgctxt "c5d5f744-f233-4a30-9f7a-18572cbf39a2"
msgid ""
"{n}Shandra looks at you politely, her voice soft and slightly "
"indifferent.{/n} \"This is a grave mistake, {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}. You turn all the wealthy people of the domain "
"against you. Money may not be the only source of power, but it is among the "
"mightiest.\""
msgstr ""
"{n}샨드라는 부럽지만 무미건조한 목소리로 정중하게 당신에게 얘기합니다.{/n} \"이것은 중대한 실수입니다, "
"{mf|영주님|영주님|전하|전하}. 당신은 지역의 모든 부유한 이들에게 척을 지려합니다. 돈만이 힘의 원천은 아닐지 모르지만, 가장 "
"강력한 힘 중에 하나입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0019_Text
#. Speaker : Capital_Tsanna
msgctxt "990f8e65-7520-4032-bb61-52d090dbe7e9"
msgid ""
"\"I will be sure his colleagues are aware of how painful his death was. May "
"they mind their own business in the future – and not forget what happens to "
"those who fail to do so.\""
msgstr ""
"\"나는 그의 죽음이 얼마나 고통스러웠는지 그의 동료들이 알고 있다고 확신한다. 미래에 그들이 사업을 준비하며 실패했을 때 어떤 결말을 "
"맞이하는지 기억하기를 바란다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0023_Text
#. Speaker : Tristian_Companion
msgctxt "607945e1-1f61-41f1-8995-b5756bb38a25"
msgid ""
"{n}Tristian's voice is very soft.{/n} \"I realize that such offer might stir "
"you to outrage. But try to understand, greed can cloud anyone's judgment, "
"wealthy and pauper alike. We must teach these people that the times have "
"changed. The law no longer serves only the rich. Reject his offer, but "
"refrain from punishing him.\""
msgstr ""
"{n}트리스티안의 목소리는 매우 부드럽습니다.{/n} \"그런 제안이 당신을 분노하게 할 수도 있다는 것을 알고 있습니다. 하지만 "
"이해하려고 노력하셔야 합니다. 탐욕은 부유한 이와 빈곤한 이 모두에게 판단력을 흐리게 만듭니다. 우리는 이 사람들에게 시대가 변했음을 "
"가르쳐야 합니다. 법은 더 이상 부자들을 섬기지 않습니다. 그의 제안은 거절하되, 그를 처벌하는 것은 삼가셔야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0024_Text
#. Speaker : Capital_Shandra
msgctxt "55d9be2a-1d24-4f85-8c71-6b609465c76b"
msgid ""
"\"Surely, this fool is merely a symbol. He himself is not important. But all "
"the influential people of the {mf|barony|barony|kingdom|kingdom} are holding "
"their breaths, waiting for your decision. They need to know they can do "
"business with us, or we'll be seen as a danger. If I were you, I wouldn't "
"want to look like a fanatic, or a hostage of my own principles. Approve this "
"small request, and be done with this greedy fellow.\""
msgstr ""
"\"물론, 이 멍청이는 단지 상징일 뿐입니다. 이 사람 자체는 중요하지 않지요. 하지만 {mf|남작령|남작령|왕국|왕국}의 모든 영향력 "
"있는 자들은 당신의 결정을 기다리며 숨을 죽이고 있습니다. 그들은 우리와 거래할 수 있다는 것을 알게 되거나 혹은 우리를 위험하다고 "
"여기겠지요. 제가 당신이었다면, 무조건 신의 바른 뜻을 부르짖는 광신도처럼 보이고 싶지도 않을 테고, 꽉 막힌 고지식한 사람처럼 보이고 "
"싶지도 않을 겁니다. 그저 이 작은 요청을 받아들이고, 이 욕심 많은 친구는 끝내십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Cue_0029_Text
#. Speaker : Capital_Tsanna
msgctxt "0e97bb70-75f0-4974-aaca-abe000622cab"
msgid ""
"\"It's good he's come to you. It means he knows who the leader is. It's bad "
"he didn't come to beg, but instead offers to buy. This is disrespectful. The "
"insolent worm must be punished. The pack needs to see fear in his eyes, and "
"remember forever that your good will can never be bought and sold.\""
msgstr ""
"\"그가 당신에게 왔다는 건 좋은 것이다. 리더가 누구인지 알고 있다는 뜻이지. 다만 당신에게 구걸이 아닌 당신을 사려고 들어서 좋지 "
"않은 것이다. 이것은 무례한 행동이지. 이런 불손한 벌레는 반드시 벌을 받아야 한다. 무리는 그의 눈에서 두려움을 볼 필요가 있고, "
"당신의 선의는 절대 매수할 수 없는 것이라는 것을 영원히 기억해야 할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Shandrabye_String
#. Speaker : Capital_Shandra
msgctxt "12c6bd07-20c9-401e-be2d-9c89eac762a7"
msgid ""
"\"You obviously have some strategy, {mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}. But I cannot approve of your methods, so as your Councilor I "
"will fare poorly at providing the assistance you need. It only makes sense "
"for me to retire after fulfilling this order. You can recruit an advisor "
"whose thoughts are more attuned to your own.\""
msgstr ""
"\"당신꼐서는 분명히 어떤 전략을 가지고 있습니다, {mf|영주님|영주님|전하|전하}. 그러나 저는 그 전략에 동의할 수 없습니다. "
"그러므로 당신의 평의원으로서 나는 당신이 필요로 하는 도움을 제공하기 힘듭니다. 제가 이것을 인정하고 물러나는 것은 이치에 맞는 "
"일입니다. 당신의 생각과 더 잘 맞는 보좌관을 구하실 수 있으실 테지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Tristianbye_String
#. Speaker : Tristian_Companion
msgctxt "c65f002d-cf3f-4e43-a737-648dd6751a74"
msgid ""
"\"I'm sorry, but we regard caring for your subjects very differently. I "
"cannot countenance the way you exercise power. I am an unwilling participant "
"in this, and I cannot be a part of it any longer. Your order will be carried "
"out, but after this I will resign, and leave my position vacant for another "
"candidate.\""
msgstr ""
"\"죄송합니다만, 저희는 문제를 다루는 것에 있어 매우 다르게 생각하는 듯합니다. 저는 당신이 권력을 행사하는 방식에 찬성할 수 "
"없습니다. 그동안 이 일을 마지못해 해왔고, 더 이상은 하기 힘들 것 같습니다. 당신의 명령은 이행되겠지만, 이 일이 끝나면 저는 "
"물러나고 다른 후보를 위해 자리를 비우겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank5/Tsannabye_String
#. Speaker : Capital_Tsanna
msgctxt "b75e1b7c-652d-4206-ba4d-a975443210b9"
msgid ""
"\"I warned you I do not wish to argue. It's not my advice you reject. You "
"dismiss the wisdom of the great goddess, who is far more ancient than all of "
"us. This means you will have to do without my opinion in the future. I will "
"fulfill your order, but then you will find yourself a new advisor.\""
msgstr ""
"\"난 당신에게 논쟁하고 싶지 않다고 경고했었다. 당신이 무시하는 것은 한낱 나의 충고가 아닌 우리 모두보다 훨씬 더 오래 살아오신 "
"위대한 여신의 지혜였다. 이는 앞으로 당신이 내 의견 없이 해야 한다는 것을 의미하지. 내릴 명령은 이행하겠지만, 앞으로는 새로운 "
"보좌관을 찾아야 할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Answer_0005_Text
msgctxt "b7d4f354-0e9e-46ee-97f4-04cd2ec3b0cc"
msgid ""
"{g|Loyalty6_1}[Choice effects]{/g} \"Throw the mercenaries out of the "
"capital. They're making trouble, so they have to go.\""
msgstr ""
"{g|Loyalty6_1}[선택 시 효과]{/g} \"용병을 수도 밖으로 쫓아내라. 그들은 문제를 일으키고 있으니, 떠나야만 한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Answer_0006_Text
msgctxt "6ee753c0-23cb-44e8-aecd-5f8e71539cb3"
msgid ""
"{g|Loyalty6_2}[Choice effects]{/g} [Pay 100 BP] \"Finance more guards from "
"the treasury. Make sure the merchants' guards don't fight with the common "
"people.\""
msgstr ""
"{g|Loyalty6_2}[선택 시 효과]{/g} [100 BP 지불] \"재무부에게 경비에 더 많은 자금을 대라고 일러라. 반드시 상점 "
"경비가 백성들과 다투지 않도록 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Answer_0007_Text
msgctxt "f45b224b-d2d7-45cb-9373-ec4d6fa37613"
msgid ""
"{g|Loyalty6_3}[Choice effects]{/g} \"Send our citizens the message that "
"these mercenaries are under our protection.\""
msgstr "{g|Loyalty6_3}[선택 시 효과]{/g} \"백성들에게 이 용병들이 우리의 보호를 받고 있다는 뜻을 전해라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Answer_0008_Text
msgctxt "eb631255-6dcf-4cd6-9d2a-d4e68868e563"
msgid "\"You decide, and it's done.\""
msgstr "\"네 결정대로 처리하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0001_Text
#. Speaker : Tristian_Companion
msgctxt "7743fb7e-acfd-47eb-bcda-1b6313f92d99"
msgid ""
"\"{name}, the situation has become rather fraught. A group of mercenaries "
"arrived in our lands to seek a better future. They've banded together for "
"safety. Some have been hired by our merchants as bodyguards.\""
msgstr ""
"\"{name}, 상황이 다소 혼란스러워졌습니다. 한 무리의 용병들이 더 나은 미래를 찾기 위해 우리 땅에 찾아왔습니다. 자신들의 안전을 "
"위해 무리를 지어 다니며, 우리 상인들 중 그들을 경호원으로 채용한 곳도 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0002_Text
#. Speaker : Capital_Shandra
msgctxt "0ccf2e00-c497-46bb-af30-18cb2874db03"
msgid ""
"\"There's an issue that requires your attention. Tensions are rising between "
"the locals and a group of mercenaries that came at the capital to earn an "
"income. Some have been hired by wealthy merchants who can afford bodyguards."
"\""
msgstr ""
"\"당신의 주의를 요하는 문제가 있습니다. 돈을 벌기 위해 수도에 온 용병들과 주민들 사이에 긴장이 고조되고 있습니다. 부유한 상인들 중 "
"용병들을 경호원으로 채용한 곳도 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0003_Text
#. Speaker : Capital_Tsanna
msgctxt "2e213786-bff2-4bd7-9207-6b2bbbf95e58"
msgid ""
"\"{name}, there is trouble in the city. A group of mercenaries arrived at "
"the capital. The people don't seem to like them, so they've banded together "
"for safety. These vagabonds seek work, and some of them have been hired by "
"the merchants. {g|Lamashtu}Lamashtu{/g} blessed these people with strength "
"and a love for fighting, so why not use them?\""
msgstr ""
"\"{name}, 도시에 문제가 있다. 한 무리의 용병들이 수도로 왔다. 백성들이 그들을 경계하기 시작했고, 그들은 안전을 위해 무리를 "
"지어 다니기 시작했다. 이런 부랑자들을 일부 상인들이 경호원으로 고용하기도 했다. {g|Lamashtu}라마슈투{/g}께서 이들에게 힘과 "
"싸움에 대한 사랑에 대한 축복을 주셨는데 왜 사용하지 않는 것이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0009_Text
#. Speaker : Tristian_Companion
msgctxt "d805d8ee-c3a9-43a3-9c90-4f136f710e5f"
msgid ""
"{n}Tristian's voice sounds sad.{/n} \"You may be right. Not everyone is "
"capable of living side by side in peace. Nevertheless, it's a shame if we "
"never try to change things.\""
msgstr ""
"{n}트리스티안의 목소리가 슬퍼집니다.{/n} \"당신의 말이 맞을 수도 있습니다. 모든 이들이 평화롭게 나란히 살 수 있는 것은 "
"아니지요. 그럼에도 불구하고, 변화조차 시도하지 않는다면, 그것은 부끄러운 일입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0010_Text_String
#. Speaker : Capital_Shandra
msgctxt "ba3d8463-d809-4aac-b7ee-0aab3253311a"
msgid ""
"{n}Shandra shrugs.{/n} \"This was short-sighted. They'll be replaced by "
"someone else, who the crowd will dislike even more. It's only a question of "
"time.\""
msgstr ""
"{n}샨드라는 어깨를 으쓱합니다.{/n} \"이것은 근시안적인 판단이었습니다. 그들은 다른 누군가들에 의해 대체되겠지요. 대중들은 더더욱 "
"싫어할 것입니다. 그것은 단지 시간문제일 뿐입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0011_Text_String
#. Speaker : Capital_Tsanna
msgctxt "26ebd2ef-f0fe-4cd2-bb5e-0fa98eb892f1"
msgid ""
"\"You can't judge a predator for killing sheep. It's the natural order of "
"things, which neither you nor I can control. Banishing someone who makes "
"your pack stronger is... foolish. Truly foolish.\""
msgstr ""
"\"양들을 집어삼킨 짐승을 판단할 수는 없다. 그것은 당신이나 나나 통제할 수 없는 자연의 질서이지. 당신의 무리를 더 강하게 해줄 "
"이들을 추방하는 것은... 어리석군... 정말로 어리석어...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0012_Text
#. Speaker : Tristian_Companion
msgctxt "d0802d22-b90b-49f2-b804-a686758decff"
msgid ""
"\"Whatever money we spend on new guards, it will be worth it, if it prevents "
"any more blood from being spilled.\""
msgstr "\"더 이상의 유혈사태를 막을 수 있다면, 새로운 경비병에 얼마나 많은 돈을 쓰더라도 그만한 가치가 있을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0013_Text
#. Speaker : Capital_Shandra
msgctxt "4b7fd308-5b87-4db8-8ddc-9b947632b7ef"
msgid ""
"{n}Shandra raises her eyebrow.{/n} \"Where will this lead? Do you expect the "
"peasants will appreciate it? They'll just find something new to hate "
"tomorrow, and you'll be the one to blame. You can't afford to solve all "
"their problems.\""
msgstr ""
"{n}샨드라는 눈썹을 치켜올립니다.{/n} \"이/n} \"이것이 어디로 이어질까요? 농민들이 고마워할 것 같습니까? 그들은 그저 내일만 "
"되면 새로운 욕할 거리를 찾게 될 것이고, 그것의 책임은 또 당신에게 뒤집어 씌울 것입니다. 당신은 그들의 모든 문제를 해결할 여유가 "
"없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0014_Text
#. Speaker : Capital_Tsanna
msgctxt "9075de2a-7e9a-4573-a7ba-cb3ae2d1fa50"
msgid ""
"\"All right. In the future, I hope the two packs, the mercenaries' and "
"yours, will merge into one. Powerful... invincible.\""
msgstr "\"알겠다. 미래에 용병들과 네 무리가 하나로 뭉치길 바란다. 강력하고... 천하무적이겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0015_Text_String
#. Speaker : Tristian_Companion
msgctxt "dfc5dd40-3078-4512-8142-1b25935d8634"
msgid ""
"{n}Tristian lowers his head. His voice is barely audible.{/n} \"So this is "
"how highly you value your merchants' comfort? Their bodyguards will become "
"insolent under your protection. They'll start openly insulting the citizens. "
"And finally, these outlanders, servants of the wealthy, will rule the city, "
"not its citizens.\""
msgstr ""
"{n}트리스티안은 고개를 숙입니다. 그의 목소리는 거의 들리지 않습니다.{/n} \"그럼 상인들의 편의를 그렇게 가치있게 평가하시는 "
"겁니까? 당신의 보호 아래 그들의 경호원들은 무례하게 변할 겁니다. 백성들을 대놓고 모욕하려 들겠지요. 종국엔, 부유한 사람들의 하인인 "
"이방인들이 이 도시를 통치하게 될 겁니다. 우리 백성들이 아니라요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0016_Text
#. Speaker : Capital_Shandra
msgctxt "14706482-cc15-4780-a117-f16133f62629"
msgid ""
"\"Very wise. Allow the merchants to do as they like, and their coin will "
"fill your coffers.\""
msgstr "\"매우 현명한 판단이십니다. 상인들이 원하는 바를 하게 해주십시오. 그럼 그 동전들이 당신의 금고를 가득 채울 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0017_Text
#. Speaker : Capital_Tsanna
msgctxt "0c75ef8c-4dce-4e45-8fab-73bb12b74b6d"
msgid ""
"\"You lock your subjects in a cage with savage cutthroats. Very well, let "
"the strong survive, and the weak perish.\""
msgstr ""
"\"당신의 백성들을 야만적인 살인자들과 함께 우리 속에 가두어라. 비로소 강한 자들이 살아남고 약한 자들은 잡아먹히게끔 하여라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0018_Text
#. Speaker : Capital_Tsanna
msgctxt "d8d06cb3-e2f8-456f-9f1a-4e4d9aed002c"
msgid ""
"\"I'll draw from the treasury to hire more guards and avoid provocation. In "
"the future, I hope the two packs, the mercenaries' and yours, will merge "
"into one. Powerful... invincible.\""
msgstr ""
"\"경비병을 더 해서 도발을 막기 위해 국고에서 자금을 차출하겠다. 앞으로 용병들과 당신의 무리가 하나로 합쳐지길 바라마. 강력하고... "
"천하무적이겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0019_Text
#. Speaker : Tristian_Companion
msgctxt "549161ce-1d5a-4056-8d2c-0f3f53e122ee"
msgid ""
"\"Alas, their manners are low, and the locals are prejudiced against them. "
"They fight more and more often. The peasants want us to banish the "
"mercenaries from the city. The merchants expect us to protect them, "
"regardless of the peasants' complaints.\""
msgstr ""
"\"아아, 그들은 무례하고, 주민들은 그들에게 편견을 가지고 있습니다. 그들은 점점 더 자주 싸우고 있습니다. 농민들은 그 용병들을 "
"도시에서 추방하기를 원합니다. 상인들은 농민들의 불만에 개의치 않고 그 용병들을 지켜주기를 기대하고 있구요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0020_Text
#. Speaker : Tristian_Companion
msgctxt "2da72e70-5a95-40a9-9c43-79b9b8eec4be"
msgid ""
"\"If you ask me, we mustn't surrender to hatred. This matter should be "
"resolved peacefully. Draw from the treasury to finance more guards. They'll "
"put an end to these clashes. Nothing's going to change if we simply choose "
"sides. We must mediate, though this takes money and a will for peace.\""
msgstr ""
"\"제게 물으신다면, 우리는 증오에 굴복에서는 안 됩니다. 이 문제는 평화적으로 해결되어야만 해요. 더 많은 경비병들을 위해 자금을 "
"대려면 국고에서 차출하셔야 합니다. 이것은 그 충돌들을 종식시켜 줄 것입니다. 단순히 편을 선택한다고 해서 달라질 것은 없습니다. 비록 "
"이것은 돈과 평화를 위한 의지가 필요하지만, 우리는 중재해야만 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0021_Text
#. Speaker : Capital_Shandra
msgctxt "24fe47b8-6d19-4602-83d6-10bce272d659"
msgid ""
"\"Of course, the citizens regard them as brutes and bruisers – stereotypes "
"to which they gladly conform. The people call us to eject this mob from the "
"city. However, this would be a mistake. Think how helpful the loyal "
"merchants' troops will be, if ever the peasants riot.\""
msgstr ""
"\"물론입니다. 시민들은 그들을 짐승, 괴한으로 여깁니다. 이는 그들이 기꺼이 수긍하는 고정관념이죠. 그렇기 때문에 사람들은 이 "
"폭력배들을 도시에서 쫓아내 달라고 아우성치지요. 하지만, 그것은 큰 착오입니다. 만약 농민 폭동이 일어나면, 충성스러운 상인들의 용병 "
"군대가 얼마나 큰 도움이 될지 생각해 보십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0022_Text
#. Speaker : Capital_Shandra
msgctxt "950e7afa-a59b-4e67-806c-fb5046222258"
msgid ""
"\"Turn a deaf ear to those who encourage you to expel the mercenaries. It "
"won't make us popular among the people, but these mercenaries may prove "
"useful. Nor should you listen to the peasants who demand your guards to "
"protect them against the unruly brutes. There will always be clashes between "
"different layers of society. You must support the more useful ones, and "
"arrest those who provoke the mercenaries' bodyguards.\""
msgstr ""
"\"용병들을 추방하도록 부추기는 자들의 말은 귀담아듣지 마십시오. 이러한 결정이 우리들을 사람들에게 인기 있는 통치자로 만들어 주지는 "
"않겠지만, 이 용병들은 정말 유용하게 쓰일 수 있습니다. 또한 제멋대로인 짐승들로부터 경비병의 보호를 요구하는 농민들의 말을 귀담아 서는 "
"안 됩니다. 사회의 각 계층들 사이에는 항상 충돌이 있을 것입니다. 이런 상황 속에서, 당신은 더 유용한 사람들을 지지해야 하고, 용병 "
"경호원들을 도발하는 사람들을 체포해야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank6/Cue_0025_Text
#. Speaker : Capital_Tsanna
msgctxt "a9d9962f-9b79-48ca-a7fb-af264414540e"
msgid ""
"\"Alas, the citizens despise these mercenaries. They insult them behind "
"their backs, and spit where they step. They provoke them, taunt them into "
"fights, and then scream bloody murder when they get what they're asking for. "
"Your cowardly people need to learn the meaning of strength. Let them see "
"that there's a bigger fish now to be reckoned with. You won't let the "
"weakest of your tribe force you to expel the strongest, will you?\""
msgstr ""
"\"아아, 시민들은 이런 용병들을 경멸하지. 뒤에서 욕하고, 발 디딜 틈도 없이 침을 뱉어. 그들은 용병들을 도발하고, 싸움에 끌어들인 "
"다음, 자기들이 원하는 것을 얻으면 피비린내 나는 살인이라며 소리를 질러대지. 그 비겁한 놈들은 힘의 진정한 의미를 배울 필요가 있다. "
"이제 가서 더 큰 물고기가 있다는 것을 그들에게 보여주어라. 당신 무리의 가장 약한 자들이 가장 강한 자를 추방하도록 강요하게 두지는 "
"않겠지. 그렇지 않은가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Answer_0004_Text
msgctxt "2ac913bc-aabd-4d8b-bd5d-e097e8ef96d8"
msgid ""
"{g|Loyalty7_1}[Choice effects]{/g} \"Let the merchants know that their "
"efforts are not required. If they touch any vessels that isn't theirs, we "
"will have to resort to force.\""
msgstr ""
"{g|Loyalty7_1}[선택 시 효과]{/g} \"상인들에게 그들의 노력은 필요치 않다는 것을 알려주어라. 만약 그들이 그 어떤 남의 "
"그릇을 손댄다면, 우리는 무력을 쓸 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Answer_0005_Text
msgctxt "15e0b3f3-8c1e-49c9-afd7-a2f504d9634e"
msgid ""
"{g|Loyalty7_2}[Choice effects]{/g} \"Let the merchants and their mercenaries "
"do as they will.\""
msgstr "{g|Loyalty7_2}[선택 시 효과]{/g} \"상인들과 용병들을 마음대로 하게 두어라\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Answer_0007_Text
msgctxt "0de174b7-a9d6-43c8-a9e2-85a5075673ef"
msgid "\"Don't involve me in their fate.\""
msgstr "\"그들의 일에 나를 끌어들이지 마라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Answer_0027_Text
msgctxt "97d0a969-545d-4686-99ed-7b40711b977e"
msgid ""
"{g|Loyalty7_3}[Choice effects]{/g} \"Tell the guards stay away from the "
"dispute. The stronger will have the right to trading on the river.\""
msgstr ""
"{g|Loyalty7_3}[선택 시 효과]{/g} \"경비병들에게 그들을 제지하지 말라고 전해라. 더 강한 자들만이 강에서 거래할 권리를 "
"가질 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0001_Text
#. Speaker : Tristian_Companion
msgctxt "b9d9f5c2-697c-4209-a5ab-d92b06688e17"
msgid ""
"\"{name}, a situation has developed. We must decide if we shall follow the "
"letter of the law, or do what my heart tells me is right.\""
msgstr "\"{name}, 상황이 진행되었습니다. 법규를 따를 것인지, 자신의 심장이 시키는 대로 따를 것인지 결정해야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0002_Text
#. Speaker : Capital_Tsanna
msgctxt "259f8f67-ff5d-49c4-80b6-c966318a88c3"
msgid ""
"\"{name}, I require your judgment on a sensitive matter. The vessels of "
"river travellers have entered your frontiers. They sell cheap goods for "
"nearly nothing, and of course, they pay no taxes.\""
msgstr ""
"\"{name}, 민감한 문제라 당신의 판단이 필요하다. 강 여행자들의 배가 당신의 국경을 넘어왔다. 값싼 물건을 거의 헐값으로 팔고 "
"있지. 물론 세금도 내지 않고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0008_Text
#. Speaker : Tristian_Companion
msgctxt "fbb33542-4839-40a8-91db-d58bacf83d73"
msgid ""
"\"Thank you, {name}. The law doesn't always grant protection to those in "
"need.\""
msgstr "\"감사합니다, {name}. 법이 항상 도움이 필요한 이들에게 보호를 제공하는 것은 아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0009_Text_String
#. Speaker : Capital_Tsanna
msgctxt "0e5e2a15-2e22-4b5c-ace5-1acd0a6728f3"
msgid ""
"\"So the merchants may freely butcher the travellers? But the travellers "
"cannot lay a finger on the merchants else they be branded criminals? That "
"doesn't sound like a fair fight to me. Your laws, for some reason, protect "
"the weak from the strong, when instead they should be rewarding strength "
"wherever it may be found.\""
msgstr ""
"\"그럼 상인들은 여행자들을 마음대로 죽일 수 있는 건가? 반면에 그 여행자들은 상인들에게 손가락 하나 까딱할 수 없는가? 단지 "
"범죄자니까? 내게 그건 별로 공정한 얘기처럼 들리지는 않는군. 너의 법은 어떤 이유에서건 강자들로부터 약자들을 보호하고 있다. 그 대신, "
"어디서든지 돈이 되는 힘이 되어야 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0010_Text_String
#. Speaker : Tristian_Companion
msgctxt "28ed2c12-cc02-444c-895f-345f10aa20ff"
msgid ""
"{n}Tristian winces.{/n} \"This is a harsh act. You condemn not only the "
"travellers, but our people who will no longer see the travellers' floating "
"stores upon their shores. I'm sorry you've made this decision.\""
msgstr ""
"{n}트리스티안은 움찔합니다.{/n} \"이것은 가혹한 행위입니다. 당신은 여행자뿐만 아니라 더 이상 여행자들의 수상 상점을 볼 수 없는 "
"우리 백성들까지 좋지 않은 상황에 처하게 만들었습니다. 이런 결정을 내린 것에 대해 유감입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0011_Text_String
#. Speaker : Capital_Tsanna
msgctxt "ea9b2154-09f1-4a88-9ae0-914a72dda80b"
msgid ""
"\"But it's the merchants that pay you, not the travellers. Do you punish "
"those who submit? Do you protect those who deny you respect? This is a "
"strange decision, {name}.\""
msgstr ""
"\"하지만 당신에게 세금을 주는 이들은 상인들이지 여행자들이 아니다. 당신을 존중하는 이들을 처벌하는가? 존중하지 않는 이들을 보호하고? "
"이건 이상한 결정이다, {name}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0014_Text
#. Speaker : Tristian_Companion
msgctxt "3cbe139b-0865-4e1e-9a22-017f25e4b222"
msgid ""
"\"I will forbid this insanity. Let the merchants trade with those who can "
"afford luxuries. Meanwhile, leave the poor in peace, to buy what they can "
"afford from the traveler vessels.\""
msgstr ""
"\"전 이런 미친 짓을 금할 것입니다. 상인들은 사치품을 살 수 있는 부유한 이들과 거래하도록 하십시오. 가난한 이들은 여행자들의 배에서 "
"그들이 살 수 있는 저렴한 물건을 살 수 있게 평화롭게 두십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0016_Text
#. Speaker : Tristian_Companion
msgctxt "237c1851-e858-4032-a644-644e4b736c60"
msgid ""
"\"Travelers' merchant vessels roam the rivers of the {g|Stolen Lands}Stolen "
"Lands{/g}. They sell low-priced goods, and bypass the official fees. They "
"sell nothing special, of course. Cheap clothes, utensils, simple tools. "
"These are life-savers for our peasants, who can afford little else. However, "
"the merchants are unhappy with the current situation. They wish to fund a "
"boat squad to hunt down and sink the travelers' boats.\""
msgstr ""
"\"여행자들의 상선이 {g|Stolen Lands}도둑맞은 땅{/g} 근처를 배회합니다. 세금을 피해 저렴한 상품을 팔고 있죠. 물론 "
"특별한 물건들은 아닙니다. 값싼 옷, 잡화, 간단한 도구들입니다. 이 사람들은 우리 농민들을 위한 생명수 같은 이들입니다. 농민들은 "
"상인들에게 물건을 사는 것을 감당할 수 없기 때문이죠. 반면에 상인들은 현재 상황에 불만이 많습니다. 그들은 여행자들의 상선을 침몰시키기 "
"위한 습격선에 자금을 대고 싶어 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0017_Text
#. Speaker : Tristian_Companion
msgctxt "f54d2a4e-bf7e-4403-92b9-f4f20a0bd343"
msgid ""
"\"The merchants are allegedly enforcing the laws, and fighting against the "
"sales of stolen property. But in fact they're only greedy to control the "
"small percentage of goods that the travellers live on. It's up to you to "
"decide what we should do. I'm sure you can see why this troubles me. We must "
"interfere and prevent this injustice!\""
msgstr ""
"\"상인들의 주장에 따르면 그들은 법을 집행하고 있는 것이며, 장물 판매에 대해 맞서 싸우고 있다고 합니다. 하지만 사실 그들은 "
"여행자들이 먹고살기 위한 아주 적은 상품들을 탐욕스럽게 통제하려고 있지요. 우리가 무엇을 할지는 당신에게 달려 있습니다. 이 일이 왜 "
"저를 괴롭히는지 아실 겁니다. 우리는 이 부당함을 멈추고 방지해야 합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0019_Text
#. Speaker : Capital_Tsanna
msgctxt "2fd1a609-ea51-4897-b118-a94c920255ef"
msgid ""
"\"But your moneybags merchants hate competition. They're assembling a squad "
"of boats to hunt down the travellers, sink their boats, and drive them from "
"your lands. It's simple greed that drives them, but they are on the right "
"track.\""
msgstr ""
"\"하지만 당신의 돈주머니인 상인들은 경쟁을 싫어하지. 그들은 여행자들을 사냥하고, 상선을 침몰시키고, 당신의 땅에서 그들을 몰아내기 "
"위해 보트를 만들고 있어. 그들을 움직이는 것은 단순한 탐욕이지만, 그것은 옳은 길이지..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0021_Text
#. Speaker : Capital_Tsanna
msgctxt "e614daf5-74e5-4e60-956c-ce467fc3de03"
msgid ""
"\"My suggestion is to stay out of this. The river travellers are a hardy, "
"teeming people, much like termites. They please {g|Lamashtu}Lamashtu{/g}, "
"and we shouldn't trouble them unless we must. If the merchants decide to "
"strike at them, we should order the guard not to interfere. The waters will "
"run red with blood, and the river people will call upon their relatives from "
"the neighboring lands, and together they'll show the traders what they're "
"made of. Those who are strong will remain, to seek their fortune in our "
"lands. And we will profit no matter the outcome.\""
msgstr ""
"\"내 제안은 이 문제에 관여하지 않는 것이야. 강 여행자들은 흰개미처럼 빈곤하고 바글바글 거리지. 그들은 "
"{g|Lamashtu}라마슈투{/g}에게 맡기고, 우리가 필요하지 않는 이상 그들을 귀찮게 하지 말자고. 만약 상인들이 그들을 "
"공격한다면, 우리 경비병들에게 그것에 대해 간섭하지 말라고 명령해야 해. 그럼 강물은 피로 붉게 물들 것이고, 강 사람들은 이웃 땅에서 "
"온 친척들을 부를 것이야. 그리고 함께 그들이 무엇으로 만들어졌는지 상인들에게 보여줄 것이야. 강한 자들은 우리의 땅에서 그들의 재산을 "
"얻기 위해 남아 있을 것이다. 우리는 결과가 어떻든 이익을 보게 되지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0025_Text
#. Speaker : Capital_Shandra
msgctxt "5629670b-5dd0-43d1-b639-f24d8f2df5f7"
msgid ""
"\"Your Highness, there's something that requires your immediate attention. "
"As you probably know, there are travellers, humble merchant tribes of mixed "
"origins, sailing up and down the river, selling essentials to our peasants. "
"They pay no taxes, and answer to no authority. The merchants have decided to "
"put an end to their lawlessness. They're assembling a squad of boats to send "
"those travellers packing.\""
msgstr ""
"\"전하, 즉각적인 조치가 필요한 사안이 있습니다. 아마 아시겠지만 여행자들, 출신이 불분명한 초라한 상인들이 강을 오르내리며 생필품을 "
"우리 농민들에게 팔고 있습니다. 그들은 세금도 내지 않고, 어떤 권리도 인가받지 않았습니다. 상인들은 자체적으로 그 무법 행위에 종지부를 "
"찍기 위해 그 상선을 격추시킬 배를 만들고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0026_Text
#. Speaker : Capital_Shandra
msgctxt "72297121-5019-42cf-86a3-d6344bdd373d"
msgid ""
"\"It's a good start, although I expect we'll have certain issues with these "
"new enforcers. It's an abuse of justice to some extent. I suggest you "
"legalize their actions before they arouse civil unrest. After all, it's your "
"law that they're upholding.\""
msgstr ""
"\"시작이 좋군요. 비록 분명히 이 새로운 법의 집행자들과 어떤 문제가 있을 것으로 예상됩니다. 그것은 다소 정의 남용이니까요. 저는 "
"그들이 시민들의 불안을 야기하기 전에, 그들의 행동을 합법화할 것을 제안합니다. 결국, 그들이 지지하는 것은 당신의 법이니 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0028_Text
#. Speaker : Capital_Tsanna
msgctxt "49686e3c-fa44-4923-80de-610e8e2c7cc3"
msgid ""
"\"Yes, let the stronger win. If the merchants cannot protect their "
"interests, let ones who are smarter and more skilled do the work instead. If "
"the travellers are ousted, then their spirit and their flesh were too weak. "
"They would have died either way. In either case, our pack stays strong, and "
"the weak are culled.\""
msgstr ""
"\"그래, 강한 자가 이기도록 하여라. 만약 상인들이 자신의 이익을 보호할 수 없다면, 더 똑똑하고 숙련된 이들이 그 일을 대신하게끔 "
"해라. 만약 여행자들이 쫓겨난다면, 그들의 정신과 육체가 너무 약했다는 얘기겠지. 그랬다면 그들은 우리가 죽이지 않더라도 어떻게든 죽었을 "
"것이다. 어느 경우든 우리 무리는 강해지고 약자들은 도태되는 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0031_Text_String
#. Speaker : Capital_Shandra
msgctxt "30386123-8ee4-4a06-8862-1f6fc5d11376"
msgid ""
"\"What a surprising decision, your Highness. The merchants only mean to "
"pursue your own law, while the travellers are nothing but criminals, "
"thieves, and tax evaders – just like their customers. I have no idea how you "
"hope to earn the love of your subjects, if you deprive them of their income "
"and violate your own laws!\""
msgstr ""
"\"정말 놀라운 결정이군요, 전하. 상인들은 당신이 법을 지킬뿐이고 여행자들은 범죄자, 도둑, 세금 탈세범에 지나지 않습니다. 저는 "
"당신이 상인들을 막고 자신의 법을 부정한다면, 어떻게 당이 백성들의 사랑과 존경을 얻을 수 있을지 전혀 모르겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank7/Cue_0034_Text
#. Speaker : Capital_Shandra
msgctxt "443a3dc7-36a7-4f38-b480-3a6748b16f8d"
msgid ""
"\"Let the merchants give those petty thieves the boot. It's time we make it "
"clear that {kingdomname} is {kingdomname}, not the {g|Stolen Lands}Stolen "
"Lands{/g}! It's civilized now. There's an order to things!\""
msgstr ""
"\"상인들이 그 좀도둑들을 걷어 찰 수 있도록 하십시오. 이제 {kingdomname}은 {kingdomname}이지, 더 이상 {g|"
"Stolen Lands}도둑맞은 땅{/g}이 아니라는 것을 분명히 하셔야 할 때입니다! 이제 우리는 문명화 되었습니다. 모든 것엔 정해진 "
"질서가 있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Answer_0004_Text
msgctxt "3dd8cc36-aa7a-4ba8-8865-aa630dffcb1a"
msgid ""
"\"The land must bear fruit and feed the people, not amuse a crowd of wealthy "
"crooks. Allow the peasants to plow these new fields.\""
msgstr ""
"\"땅은 열매를 맺고 백성들을 먹여 살려야지, 부유한 사기꾼들을 배불려서는 안 된다. 농민들이 이 새로운 밭을 갈 수 있도록 허락한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Answer_0005_Text
msgctxt "202cee49-1001-42f9-991c-df2b3258acd9"
msgid ""
"\"I don't want any problems with the merchants. Let the peasants find "
"themselves another field to plow.\""
msgstr "\"상인들과 어떤 마찰도 일으키고 싶지 않다. 농민들이 다른 경작지를 찾을 수 있도록 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Answer_0006_Text
msgctxt "0c5c0f6f-ea15-4053-94b1-8972dfadb0fe"
msgid "\"I trust your judgment.\""
msgstr "\"너의 판단을 믿는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Answer_0014_Text
msgctxt "c0759ab7-73f3-4880-99dd-7434aa59333b"
msgid "\"Take the oak grove. It is my gift for you.\""
msgstr "\"참나무숲을 가지도록 하여라. 너를 위한 선물이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Cue_0001_Text
#. Speaker : Tristian_Companion
msgctxt "bc45fdb1-5e57-4981-93ef-e691c6f42050"
msgid ""
"\"There are more and more workers in the kingdom, and our farmers require "
"plots of fruitful soil. The ordinary people regard you as their defender "
"against the iniquity of the merchants. And they have come to you with a "
"request.\""
msgstr ""
"\"왕국에는 점점 더 많은 노동자들이 생겨나고, 우리 농민들은 기름진 토양을 원하고 있습니다. 보통 사람들은 당신을 상인들의 부당에 "
"대항하는 그들의 변호자로 여기고 있습니다. 그리고 그들이 요청해 왔지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Cue_0002_Text
#. Speaker : Capital_Tsanna
msgctxt "658a60ce-d650-4486-be85-e74130261187"
msgid ""
"\"{name}, your subjects grow countless, like a swarm of locusts. They "
"require food, and there is not enough cropland. Hunger brings them to you. "
"They seek your permission to plow an ancient oak grove. It is said that the "
"wealthy use this forest for entertainment, hunting for sport. They won't "
"like it if you take away their toy.\""
msgstr ""
"\"{name}, 당신의 백성들은 메뚜기 떼처럼 무수히 늘어나고 있습니다. 늘어난 만큼 음식을 필요로 하지만, 우리는 충분한 경작지가 "
"없습니다. 배고픔에 이끌린 농민들이 오래된 참나무숲을 경작할 수 있도록 당신의 허락을 구하고 있습니다. 부자들은 이 숲을 오락용 사냥하는 "
"데에 쓰고 있다고 합니다. 만약 당신이 부자들의 장난감을 빼앗는다면, 당연히 그들은 별로 좋아하지 않을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Cue_0007_Text
#. Speaker : Tristian_Companion
msgctxt "8643ab64-8116-4e46-a69c-9360ef0fad9e"
msgid ""
"\"You are merciful. The people will never forget who granted them land for "
"their honest labor.\""
msgstr "\"자비로우시군요. 정직한 노동을 위한 토지를 누가 허락하셨는지 백성들은 결코 잊지 않을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Cue_0008_Text
#. Speaker : Capital_Tsanna
msgctxt "9e86effc-e3b2-428d-b0a2-0317732070c9"
msgid ""
"\"I wish you had given them to me. But I understand. You must think of your "
"own pack.\""
msgstr "\"내게 맡기지 그랬나. 하지만 이해한다. 넌 너의 무리를 생각해야만 하니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Cue_0009_Text_String
#. Speaker : Capital_Tsanna
msgctxt "66de558a-b8a5-4ef3-b8a2-62b814adc5f6"
msgid ""
"\"It doesn't seem you care much for your pack, allowing a bunch of moneybags "
"merchants to entertain themselves in a place that might instead have fed "
"your starving people... not to mention the children of "
"{g|Lamashtu}Lamashtu{/g}!\""
msgstr ""
"\"굶어 죽어가는 사람들을 먹여 살렸을지도 모르는 땅에서 부자들이 흥청망청 놀고 있게 두다니, 별로 네 무리를 아끼지 않나 보군. "
"{g|Lamashtu}라마슈투{/g}의 아이들은 말할 것도 없지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Cue_0010_Text_String
#. Speaker : Tristian_Companion
msgctxt "024514a9-062b-4ce7-89e6-6b8863cfd036"
msgid ""
"\"But where? There aren't that many patches of fertile soil! It's a shame "
"that the miseries of a crowd of hungry peasants mean less to the kingdom "
"than the amusements of a few well-fed idlers.\""
msgstr ""
"\"하지만 어디로 말씀이십니까? 비옥한 토양은 그렇게 많지 않습니다! 당신에게 굶주린 농민들의 불행이 부유한 게으름뱅이들의 오락보다 신경 "
"쓸 가치가 없다는 것은 부끄러운 일입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Cue_0011_Text
#. Speaker : Capital_Tsanna
msgctxt "5b29c3c9-8998-4e55-95c9-a19ac9d1ff3f"
msgid ""
"\"The oak groves will be restricted to everyone except my pack. The children "
"of {g|Lamashtu}Lamashtu{/g} will finally have a place in the {g|Stolen Lands}"
"Stolen Lands{/g} where they can be free!\""
msgstr ""
"\"참나무 숲은 내 무리들만의 것이 될거다. {g|Lamashtu}라마슈투{/g}의 아이들에게 드디어 {g|Stolen Lands}"
"도둑맞은 땅{/g} 에서 자유롭게 지낼 보금자리가 생겼구나!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Cue_0013_Text
#. Speaker : Capital_Tsanna
msgctxt "0d6102a4-17c8-4c60-b87f-20a2e4dd0d83"
msgid ""
"\"But the earth must bear fruit, not serve as a playground. But I know "
"better than to chop down old trees or give them as playthings for the idle. "
"Grant this territory to me and my pack! My wards long for a place of their "
"own, where they can escape persecution... and your pack may take all the "
"rest. The children of {g|Lamashtu}Lamashtu{/g} will keep away from your "
"other lands, and leave them to be safe for your pack.\""
msgstr ""
"\"하지만 땅은 열매를 맺어야지, 오락용으로 쓰여선 안된다. 그럼에도 나는 고목을 베어버리거나 부유한 이들의 오락용으로 쓰는 것보다 더 "
"좋은 방법을 알고 있다. 나와 내 무리에게 이 땅을 허락해 줘. 내 아이들은 박해를 피할 수 있는 자기들만의 장소를 갈망하고 있다... "
"그리고 너의 무리는 다른 이득을 취할 수 있지. {g|Lamashtu}라마슈투{/g}의 아이들은 다른 땅으로부터 멀리 떨어져 있을 "
"것이며, 그 아이들은 너의 무리를 건드리지 않을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Cue_0015_Text
#. Speaker : Capital_Tsanna
msgctxt "441ea647-49da-4aba-b0f8-aecaa201732b"
msgid ""
"{n}Tsanna's smile is predatory.{/n} \"I can hear happy laughter. It's my "
"goddess! We shall drink blood to our heart's content. We shall glut "
"ourselves in celebration. We will produce beautiful monsters under that "
"canopy of trees. We shall leave to your subjects all the game and farmland "
"around the area. Thank you, {name}! You won't be sorry.\""
msgstr ""
"{n}산나가 포식자처럼 웃음 짓습니다.{/n} \"행복한 웃음소리가 들리는구나. 나의 여신이여, 우리는 마음껏 피를 마시고 오늘을 축하할 "
"만큼 충분히 먹을 것입니다. 우리는 나무 밑에서 아름다운 괴물들을 낳을 것입니다. 우리는 이 지역에서 네 백성들이 어떤 오락과 농사도 "
"허락할 것이다. 고맙다, {name}! 후회하지 않을 게야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Cue_0017_Text
#. Speaker : Tristian_Companion
msgctxt "7bc0598d-8b71-4f8b-8ffd-7d9350a7f0a4"
msgid ""
"\"Your subjects wish to clear and plow some nearby oak groves, where wealthy "
"men, both local and {g|Brevoy}Brevan{/g}, have hunted in sport for many "
"years. The merchants won't like it, but I'm sure you can see that food for "
"the children and the elderly is far more important than sports for the idle? "
"Wouldn't you agree?\""
msgstr ""
"\"당신의 백성들은 당신의 땅과 {g|Brevoy}브레보이{/g}의 부자들이 몇 년 동안 오락 삼아 사냥을 즐겨온 참나무숲 인근을 "
"경작하고 싶어 합니다. 상인들은 좋아하지 않겠지만, 아이들, 노인들을 위한 음식이 그따위 오락보다 휠씬 중요하다는 걸 알 수 있습니다. "
"당신도 동의하지 않습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Cue_0020_Text
#. Speaker : Capital_Shandra
msgctxt "2b1422e5-1326-4494-bada-4b0a0dc25ccb"
msgid ""
"\"Your Highness, your protection of the rabble has borne fruit. Now the "
"peasants are demanding a permit to level the oak grove near the capital. "
"They want to use the land as a field to plant crops. But you see, the "
"wealthy merchants have enjoyed hunting there for years. They won't be happy "
"of another violation of their privileges. Take my advice. Don't turn the "
"influential class against you.\""
msgstr ""
"\"하찮은 대중들에 대한 당신의 보호가 열매를 맺었습니다. 이제 농민들은 수도 근처의 참나무숲을 개간할 허가를 요구하고 있습니다. 하지만 "
"알다시피, 부유한 상인들이 수년 동안 그곳에서 사냥을 즐겼습니다. 그들은 또 다른 특권 침해에 대해 그리 달가워하지 않을 것입니다. 부디 "
"제 충고를 받아들여서, 영향력 있는 계층과 척을 지지 마십시오\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Cue_0021_Text_String
msgctxt "3439e4d9-7e9b-469d-92d8-83de3f00a2cf"
msgid ""
"\"Trust me, the love of the people is fickle. No matter how much you give "
"them, they'll forget everything at the first petty problem. Mind you, the "
"wealthy class has a significantly better memory. They will remember if you "
"stand up for them – or against them.\""
msgstr ""
"\"절 믿으십시오, 민중의 사랑은 변덕스러운 것입니다. 당신이 아무리 줘도 사소한 문제 하나면 다 잊어버릴 겁니다. 명심하십시오. 부유한 "
"이들은 훨씬 더 좋은 기억력을 가지고 있습니다. 그들은 당신이 자신을 지지하는지, 아니면 반대하는지 기억할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Comm/Cue_0024_Text
#. Speaker : Capital_Shandra
msgctxt "98ded162-a0b7-4dd6-9deb-5e2a0dd1e5db"
msgid ""
"\"Perfect. The forest will stay. The peasants will just have to make do with "
"the food they have. The merchants will be grateful for this gesture.\""
msgstr ""
"\"완벽합니다. 숲은 유지될 것입니다. 농민들은 자신들이 가진 식량으로 견뎌야만 할 것입니다. 상인들은 이런 결정에 크게 감사할 것입니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Answer_0004_Text
msgctxt "51826663-c5ec-4761-8365-9f76eb7f4aef"
msgid ""
"\"The free market isn't going anywhere, no matter what the merchants might "
"want.\""
msgstr "\"자유시장은 상인들이 무엇을 원하든 아무 데도 가지 않을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Answer_0005_Text
msgctxt "258b5d06-8ea7-4e01-8bb5-d13ea91b2c0b"
msgid "\"I like the merchants' idea. Let all trade go through the guild.\""
msgstr "\"상인들의 생각이 마음에 드는군. 모든 거래를 길드를 거쳐가도록 해라\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Answer_0006_Text
msgctxt "38ef045a-10dc-4250-b2e1-6e8e022a6d63"
msgid "\"I trust your opinion.\""
msgstr "\"그대의 판단을 믿는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Cue_0001_Text
#. Speaker : Tristian_Companion
msgctxt "32a5d66e-497b-400a-9c1b-172e4e10c290"
msgid ""
"{n}Tristian looks morose.{/n} \"It appears that the merchants have decided "
"they can do whatever they like in your kingdom. They're asking you to "
"control the free market! Do you even realize what that means? From now on, "
"our farmers won't be allowed to sell their own crops for themselves. They'll "
"have to hand over their goods to the trade guild for distribution – at "
"prices specified by the merchants!\""
msgstr ""
"{n}트리스티안은 시무룩해 보입니다.{/n} \"상인들이 왕국 내에서 뭐든지 할 수 있다고 생각하는 모양입니다. 자유 시장을 통제해달라고 "
"요구하고 있습니다! 저게 무슨 뜻인지 아시겠습니까? 이제부터 농부들은 자기 마음대로 곡물도 팔지 못한다는 이야기입니다. 상인들이 정해놓은 "
"가격에 물건을 팔기 위해 상인들한테 일정 수익 이상을 넘겨주며 자기 상품을 건네야 한다는 말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Cue_0002_Text
#. Speaker : Capital_Tsanna
msgctxt "533fdf0a-d320-46cd-b5b2-07d9b5769949"
msgid ""
"\"The merchants have come to me with a strange request. They regard you as "
"their champion and defender, and it appears they've come up with another way "
"to get rich. They want you to deny the free market!\""
msgstr ""
"\"상인들이 이상한 요구를 해오더군. 널 자기네들의 투사이자 수호자로 여기면서 부자가 될 방법을 생각해냈다고 하고 있다. 자유 시장을 "
"부정하려고 하는 것이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Cue_0007_Text
#. Speaker : Tristian_Companion
msgctxt "53c24011-3ee0-4eb8-8319-31070b9b2bb2"
msgid ""
"{n}Tristian bows his head.{/n} \"Thank you. It's a noble thing to protect "
"your subjects against the despotism of the rich.\""
msgstr "{n}트리스티안은 고개를 숙입니다.{/n} \"감사합니다. 백성들을 돈의 폭정으로부터 보호하는 것은 참으로 고귀한 일이지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Cue_0008_Text
#. Speaker : Capital_Tsanna
msgctxt "06590f2b-295d-4ad0-b25c-696854dc9fd0"
msgid ""
"\"You're doing the wise thing. When someone goes too far, you take them by "
"the throat and shake them a little. It's what leaders do.\""
msgstr "\"현명한 행동을 하는군. 선을 넘는 자가 있다면, 그자의 목덜미를 잡고 조금 흔들어주면 된다. 그게 지도자가 하는 일이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Cue_0009_Text_String
#. Speaker : Tristian_Companion
msgctxt "43e976af-8fbf-41ca-a916-4d775141a99a"
msgid ""
"{n}Tristian remains silent for a while, and then begins to speak as if he's "
"alone, addressing an empty room.{/n} \"Will the merchants ever have enough "
"gold, so they can finally leave the people alone? Will the people's cries "
"ever be heard in this hall?\""
msgstr ""
"{n}트리스티안은 잠시 침묵을 유지하더니, 혼자 텅 빈 방 안에서 연설하듯 되뇌입니다.{/n} \"상인들이 백성들을 가만히 내버려 둘 "
"만큼 충분한 돈을 벌 수가 있을까요? 과연 백성들의 울부짖음이 이곳까지 울려퍼질 수 있을까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Cue_0010_Text_String
#. Speaker : Capital_Tsanna
msgctxt "0b2e4754-fd13-4788-9d7b-b535a6961f28"
msgid ""
"\"I don't know much about trade, but I do know that the one who controls the "
"food controls the pack. You've just made a grave mistake, {name}.\""
msgstr ""
"\"난 무역은 잘 모르지만, 식량을 다스리는 자가 무리를 다스린다는 건 안다. 방금 넌 중대한 실수를 한 것이다, {name}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Cue_0011_Text
#. Speaker : Tristian_Companion
msgctxt "c2308cd3-db5b-47ee-b768-3ebf8dd6a6a3"
msgid ""
"\"I will inform the people that free trade in our kingdom will go on as "
"always.\" {n}Tristian's voice turns from relieved to sarcastic.{/n} \"The "
"merchants will just have to be happy with the vast riches they already have!"
"\""
msgstr ""
"\"백성들에게 왕국은 언제나 그렇듯 자유 경제를 수호한다고 말하겠습니다.\" {n}트리스탄의 목소리는 안도에서 비꼬는 목소리로 "
"바뀝니다.{/n} \"상인들은 이미 충분할 정도로 많은 부자들이 더 늘어날 수 있으니 기뻐하겠군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Cue_0012_Text
#. Speaker : Capital_Tsanna
msgctxt "67b720d8-96e6-40e6-86b7-d96071005a9a"
msgid ""
"\"In that case, let the merchants tame their appetites. I wouldn't deliver "
"even a tiny scrap of power into their hands.\""
msgstr "\"그렇다면, 상인들이 만찬을 즐기도록 하라지. 난 놈들의 손에 자그마한 권력이라도 넘겨주지 않을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Cue_0013_Text
#. Speaker : Tristian_Companion
msgctxt "7136d124-72ee-4359-b7ef-481606f25805"
msgid ""
"\"Excuse me for being blunt, but this is the most shameless exploitation of "
"the people that I've ever heard of. We will disgrace ourselves if we allow "
"the merchants to dictate this to us. We cannot grant their request. – Let us "
"stand on the people's side this time at least.\""
msgstr ""
"\"퉁명스럽게 말해서 죄송합니다만, 제가 들어본 바 중에 가장 끔찍한 착취로군요. 상인들에게 권력을 쥐어준다면 우리 스스로 품격을 "
"깎아내리는 격이 될 겁니다. 저들의 요구를 들어줘선 안 됩니다. 최소한 이번 만큼은 백성들의 편에 서야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Cue_0015_Text
#. Speaker : Capital_Tsanna
msgctxt "f83bc415-822d-407b-92d6-d943ea4dd0ec"
msgid ""
"\"From now on, farmers would be obliged to hand over their goods to the "
"trade guild at a price set by the guild, who will them possess the power of "
"distribution as well. I'm no good at trade, but the whole situation stinks. "
"They want more control. More power. Don't give it to them.\""
msgstr ""
"\"이제부터 농부들은 길드가 정한 가격에 물건을 내놓아야만 할 거다. 배급 권한도 길드가 맡게 되겠지. 난 거래에 대해선 잘 모르지만 이 "
"모든 상황이 구역질 나는군. 놈들은 더 많은 권한을 원하고 있다. 더 많은 권력을 말이다. 놈들에게 다 줘버리면 안 된다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Cue_0019_Text
#. Speaker : Capital_Shandra
msgctxt "c0b3b2a9-5cee-4b3b-940c-aadf70ad9ba4"
msgid ""
"\"Your Highness, the merchants of the kingdom have a request for you. They "
"are looking to consolidate trade in the farming markets. The farmers will be "
"obliged to hand over their goods to the trade guild at fair market prices, "
"ensuring their prosperity and saving them the trouble of bringing their "
"goods to market. This is a wise decision and would strengthen the merchant "
"class. I would support it.\""
msgstr ""
"\"전하, 왕국의 상인들이 요청을 해왔습니다. 농업 시장에서의 사업을 더 키우고 싶은 모양입니다. 이러면 농부들은 의무적으로 길드가 정한 "
"시장 가격에 상품을 넘겨, 수익을 보장받음과 동시에 시장까지 물건을 가져올 수고를 덜게 됩니다. 상인 계층에게 힘을 실어줄 수 있는 "
"현명한 계책입니다. 저는 동의합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Cue_0020_Text
#. Speaker : Capital_Shandra
msgctxt "e4cca43b-64f1-4a08-8a35-55d357e8ef16"
msgid ""
"\"Perfect. We will support the merchants. There's no reliable aristocracy "
"among the landowners, which makes the merchants the strongest class in the "
"kingdom. As we make them even stronger, we strengthening your own power.\""
msgstr ""
"\"완벽하군요. 상인들을 지원하지요. 지주들 가운데선 믿을 수 있을만한 인물이 없으니, 상인들을 왕국에서 가장 강력한 계층으로 "
"만들어야겠지요. 우리가 상인들에게 힘을 실어주면, 우리의 힘도 강해질 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank8/Loyalty_Rank8Merch/Cue_0022_Text_String
#. Speaker : Capital_Shandra
msgctxt "ac1420b3-030a-4e19-9ce0-e9ba9660edf6"
msgid ""
"\"Hmm... This is unwise. You don't have any landed nobles here, as we do in "
"Brevoy. Trade is your kingdom's only tangible source of income. A ban on "
"free trade would have strengthened the powerful class here.\""
msgstr ""
"\"흐음... 현명하지 못 합니다. 여기엔 브레보이처럼 땅을 가진 지주가 없지요. 왕국에서 실질적으로 수익을 얻을만한 원천은 거래 "
"뿐입니다. 자유 무역을 금하신다면 이곳의 강력한 계층에게 힘만 실어주는 꼴이 되겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank9/Loyalty_Rank9Consp/Cue_0001_Text
#. Speaker : Tristian_Companion
msgctxt "44328ea9-25c8-47fa-be9d-ac96be38b88e"
msgid ""
"{n}Tristian looks worried but unafraid.{/n} \"{name}, your life is in "
"danger. The merchants are angry with you for protecting your subjects "
"against their plots, and now they conspire against you. Luckily, the people "
"are loyal to you, and one of your loyal servants reported this treasonous "
"outrage.\""
msgstr ""
"{n}트리스티안은 걱정하는 얼굴이지만 두려워하진 않습니다.{/n} \"{name}, 당신의 목숨이 위험합니다. 상인들이 자기네들의 계획에 "
"맞서 백성들을 보호하려는 당신에게 화가 났습니다. 그리고 당신에게 모략을 꾸미려고 하고 있습니다. 다행히 백성들은 충성스러운 지라, "
"충성스러운 백성 중 하나가 이 배반 행위를 보고해왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank9/Loyalty_Rank9Consp/Cue_0002_Text
#. Speaker : Capital_Tsanna
msgctxt "201dd8a2-4a16-4927-a7f1-bd4d26ac1fd8"
msgid ""
"\"{name}, the merchants have had enough of your rule. They've suffered heavy "
"losses, and now they conspire against you. Luckily, one of your citizens "
"overheard them plotting, and reported their treason to me."
msgstr ""
"\"{name}, 상인들이 네가 정한 규범을 더 이상 못 버티겠다는군. 심각한 손해를 입었다고 놈들이 역적 모의를 하고 있다. 다행히 "
"그대의 백성 중 하나가 이 계획을 듣고 내게 이 배반행각을 보고해왔다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank9/Loyalty_Rank9Consp/Cue_0016_Text
#. Speaker : Tristian_Companion
msgctxt "4a4a9afb-87dd-4c41-b817-d54925400b65"
msgid ""
"\"We must make up our minds how to prevent this attack and neutralize the "
"conspirators. One options is to entrust your Treasurer with bribing some of "
"them. Another is to order your Minister to eliminate the traitors in secret. "
"But that's more their style, not ours. There's not enough time to call in "
"the troops, but if your Regent addresses the people, your faithful people "
"will rally around you.\""
msgstr ""
"\"역적들의 공격을 막고 처리할 방법을 계획해야 합니다. 아니면 재무관을 시켜 놈들에게 뇌물을 주는 방법도 있습니다. 장관을 시켜 "
"비밀리에 이 역적들을 제거해버릴 수도 있지요. 하지만 그렇게 하는 것은 놈들의 방식에 가깝지, 우리와는 다릅니다. 군대를 소집하기엔 "
"시간이 부족합니다. 하지만 섭정에게 말해 백성들에게 이 사실을 알리도록 하면, 충성스런 백성들이 당신을 보호하겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank9/Loyalty_Rank9Consp/Cue_0018_Text
#. Speaker : Capital_Tsanna
msgctxt "e00c6cd1-dc4a-4337-8780-b2ab388348cb"
msgid ""
"\"We must strike first! A coward would send a Treasurer with a purse, to "
"reward those who would renounce the conspiracy. Someone more naive might "
"send a Regent, in hopes of reaching the people's hearts, calling them to "
"stand united and protect the crown even in the face of their enemy's blades. "
"I advise you to show more wisdom. Visit upon them precisely what they plot "
"to visit upon you. Order your Minister to send assassins to the homes of the "
"conspiracy's leader. Decapitate the conspiracy, and no harm will come to "
"you. They will be like a pack whose leader was gutted on a horn.\""
msgstr ""
"\"선제공격을 해야 해! 재무관을 보내 몇 푼 쥐어주고 역적모의를 그만두게 하는 건 겁쟁이나 할 짓이다. 순진해 빠진 놈이라면 섭정을 "
"보내 백성들을 설득시켜 모집시킨 뒤 적들의 칼 앞에 서더라도 궁성을 지키게 할테고 말이다. 보다 현명한 방책을 알려주지. 널 암살하려는 "
"놈들에게 먼저 선수를 치는 거다. 장관에게 명령해 역모자들의 수괴의 집에 암살자를 보내자고. 역적의 목을 자르기만 하면 아무런 해가 없을 "
"거다. 놈들은 우두머리가 없어진 채 진퇴양난에 빠진 무리 꼴이 나겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank9/Loyalty_Rank9Consp/Cue_0019_Text
#. Speaker : Capital_Shandra
msgctxt "0ad3aab7-8db7-4af0-9bcf-5a691f161189"
msgid ""
"\"Your Highness, several prominent merchants of the capital are conspiring "
"against you. You are loved by ordinary people, and one of the servants "
"reported the conspiracy. We expect the merchants to dispatch an assassin.\""
msgstr ""
"\"전하, 수도의 유명한 상인 몇 명이 역적모의를 하고 있습니다. 전하께선 백성들의 사랑을 받으시는 지라, 백성 중 하나가 이 모의를 "
"보고해왔더군요. 놈들은 암살자를 보내올 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank9/Loyalty_Rank9Consp/Cue_0020_Text
#. Speaker : Capital_Shandra
msgctxt "f7bf5744-05dd-4e42-8343-6ad759721e60"
msgid ""
"\"We could send the Minister's assassins to deal with these malcontents, or "
"ask the Regent to call upon the people for protection. But I have a better "
"plan. Order your Treasurer to bribe several of these errant merchants. If "
"they come over to our side, the rebels will stop trusting each other, and "
"the conspiracy will fall apart without any casualties.\""
msgstr ""
"\"장관의 암살자를 보내 이 불순분자들을 처리할 수도 있습니다. 아니면 섭정을 불러 백성들의 보호를 살 수도 있지요. 하지만 더 나은 "
"방법이 있습니다. 재무관에게 명령해 이 탈선한 상인들에게 뇌물을 주는 겁니다. 놈들이 우리 편으로 넘어오면, 반란군도 서로를 믿지 못할 "
"겁니다. 그리고 역적 모의는 아무런 사상자 없이 끝나겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank9/Loyalty_Rank9Riot/Cue_0001_Text
#. Speaker : Tristian_Companion
msgctxt "03d8306b-a351-4712-8d25-14eab039bd48"
msgid ""
"\"There's trouble in the capital, {name}. The people can no longer bear the "
"oppression of the merchant class. Your patronage brought you the affection "
"and loyalty of the merchants, but has driven your poor people into rage and "
"despair. The peasants are prepared to go out into the streets and destroy "
"the wealthy neighborhoods. I understand the feelings of who are sickened by "
"poverty and injustice, but we must intervene if we wish to prevent a "
"massacre.\""
msgstr ""
"\"수도에 문제가 생겼습니다, {name}. 백성들은 더 이상 상인 계층의 탄압에 견딜 수 없습니다. 당신의 후원은 상인들의 애정과 "
"충성을 가져다주었지만, 당신의 가난한 백성을 분노와 절망으로 내몰았습니다. 농민들은 거리로 나가 상위 계층의 거주 구역을 파괴할 각오가 "
"되어 있습니다. 그들의 빈곤과 불평등으로 인해 곪은 상처를 이해하지만, 대학살을 막기 위해서는 우리가 개입해야만 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank9/Loyalty_Rank9Riot/Cue_0002_Text
#. Speaker : Capital_Tsanna
msgctxt "f45fc388-684e-45f4-943c-6f4061b870e4"
msgid ""
"\"Like I've always said, it's dangerous to taunt a hungry pack. And I was "
"right. The merchants are bleeding people dry, like fat spiders sucking out "
"their lifeblood. And your people have had enough. Everyone is talking about "
"the riots that the peasants are planning in the wealthy quarters. You must "
"intervene, or you'll lose your power and position.\""
msgstr ""
"\"내가 항상 말했듯이, 배고픈 무리를 조롱하는 것은 위험한 일이다. 그리고 역시 내가 옳았지. 상인들은 마치 살찐 거미가 피를 "
"빨아먹듯이 농민들의 피를 말리고 있다. 그리고 당신네 무리는 충분히 참았지. 부유층 구역의 모두가 농민들이 폭동을 계획하고 있다는 얘기를 "
"하고 있다. 개입하지 않으면 권력과 지위를 잃게 될 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank9/Loyalty_Rank9Riot/Cue_0016_Text
#. Speaker : Tristian_Companion
msgctxt "931ad517-256b-4a45-a23b-51d27775d77e"
msgid ""
"\"We could order the Warden to gather the capital guards, and stop the crowd "
"without spilling any blood. You might also order your Minister to kill the "
"people's leaders, although it pains me even to think of it... They are only "
"ordinary starving people, you know. You shouldn't try to resolve this matter "
"by force. Send in your Treasurer! Let them have some gold for their "
"families. It'll soothe down their wrath.\""
msgstr ""
"\"감시관에게 명령하여 수도 경비병을 모아 유혈사태 없이 군중들을 막으라고 할 수도 있고, 장관에게 명령하여 폭동 지도자를 죽이라고 "
"명령할 수도 있습니다. 이런 생각을 하는 것 자체가 괴롭습니다만... 그들은 단지 굶주리기만 한 평범한 사람들 입니다. 이 문제를 "
"강압적으로 해결하려 해서는 안 됩니다. 재무관을 보내십시오! 그들과 그 가족들을 위해 금을 조금 쥐여줍시다. 그러면 그들의 분노가 "
"가라앉을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank9/Loyalty_Rank9Riot/Cue_0018_Text
#. Speaker : Capital_Tsanna
msgctxt "5b57738d-5093-4167-8e46-a2dd8223dd7c"
msgid ""
"\"All they really want is gold. We could ask your Treasurer to distribute "
"some gold... If they promise obedience. Or we could send the Warden's guards "
"to stop them, though I wouldn't recommend it. The guards have families, and "
"they too bear a grudge against the merchants. It's best if the Minister "
"sends forth his faithful assassins. If they make a sudden display of force, "
"and drain the lives of the loudest among the mob, then the rest will see "
"this and flee in terror.\""
msgstr ""
"\"그들이 진정으로 원하는 건 금이다. 당신의 재무관에게 그들에게 금을 나누어 주라고 명령할 수 있다... 물론 그들이 복종을 "
"약속한다면. 아니면 감시관의 경비들을 보내 그들을 막으라고도 할 수 있다. 나는 별로 추천하지는 않는다. 경비병들도 가족들이 있고, 그들 "
"역시 상인들에게 원한을 품고 있지. 장관을 시켜 암살자를 보내는 것이 가장 좋은 방법일 것이다. 그들은 갑작스레 힘을 과시하고 시끄러운 "
"이가 목숨을 잃는다면 공포에 질려 도망칠 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank9/Loyalty_Rank9Riot/Cue_0019_Text
#. Speaker : Capital_Shandra
msgctxt "3087a44c-7bec-4ae1-b3fa-486ba172db18"
msgid ""
"\"Your Highness, there's a riot in the capital. A drunken, bloodthirsty mob "
"is heading to the trade district to pillage the merchants and burn down "
"their homes. This riot must be stopped!\""
msgstr ""
"\"전하, 수도에서 폭동이 일어나고 있습니다. 술에 취해 피투성이가 된 폭도들이 상인들을 약탈하고 집을 불태우기 위해 상업 지구로 "
"몰려들고 있습니다. 이 폭동은 반드시 막아야 합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Loyalty/Rank9/Loyalty_Rank9Riot/Cue_0020_Text
#. Speaker : Capital_Shandra
msgctxt "d0481198-f0b4-4227-b8be-e94db6e4a738"
msgid ""
"\"We could send the Treasurer to bribe the mob with gold. We could also "
"dispatch the Minister's assassins to deal with the instigators. But take my "
"best advice. Let the Warden call up the guards to disperse the crowd.\""
msgstr ""
"\"재무관을 시켜 폭도들에게 금을 쥐여 줄 수도 있습니다. 혹은 선동가를 암살하기 위해 장관의 암살자를 파견할 수도 있지요. 하지만 제가 "
"추천드리는 바는 감시관을 불러 경비병을 통해 군중을 해산시키도록 하는 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Merc/Cue_0001_Text
msgctxt "ee98e150-c82d-4a88-bf2f-298837bc828c"
msgid ""
"{n}Your advisor has arrived to report about the recent Military developments "
"in your {mf|barony|barony|kingdom|kingdom}.{/n}"
msgstr "{n}당신의 보좌관이 최근의 {mf|남작령|남작령|왕국|왕국}의 군사 발전에 대해 논의하기 위해 방문했습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Additional/Cue_0001_Text
#. Speaker : RankUp_Vodja
msgctxt "24097a31-a3bb-4615-b482-a2fac3d0d422"
msgid ""
"{n}Wodga, priest of Kurgess, salutes you vigorously, and flashes an excited "
"smile.{/n} \"Your Highness, your army grows stronger by the hour! Your "
"warriors loved Kurgess' lessons! A few have already committed themselves to "
"his religion. Many more will join them, I expect. But it's not only your "
"warriors that are interested in our faith.\""
msgstr ""
"{n}쿠르게스의 사제인 보드자가 힘차게 경례하며 상기된 미소를 띱니다.{/n} \"전하, 당신의 군대가 시간이 지날수록 더 강해지고 "
"있습니다! 당신의 전사들은 쿠르게스의 가르침을 굉장히 마음에 들어 했습니다. 몇몇은 이미 쿠르게스에게 귀의했고, 추후에 더 많은 이들이 "
"합류할 것으로 예상됩니다. 하지만 우리의 믿음에 관심을 갖는 이들은 당신의 전사들만이 아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Additional/Cue_0002_Text
#. Speaker : RankUp_Romelo
msgctxt "7bee9a31-47b5-431c-a7b8-83a622591ed8"
msgid ""
"{n}Captain Romelo gives you a sneaky wink.{/n} \"Reporting for duty! It's "
"good to see you in good health! Your first and second crossbow troops have "
"finished training and equipping! Your ballistaire squads are receiving their "
"heavy weapons today. I'd love to see the local bandits' faces when they see "
"your troops in their new formations!\""
msgstr ""
"{n}로멜로 대장이 은근한 윙크를 보냅니다.{/n} \"직무 보고드립니다! 건강히 뵙게 되어 대단히 반갑습니다! 첫 번째와 두 번째 석궁 "
"부대의 훈련과 교육이 끝났습니다! 발리스타 부대를 위한 중장 무기 가 오늘 배급되고 있습니다. 하루빨리 도적 놈들이 우리 부대의 새로운 "
"대형을 마주했을 때 지을 표정을 보고 싶군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Additional/Cue_0003_Text
#. Speaker : RankUp_Rakiyata
msgctxt "c54449b5-9437-46d1-a26a-527c557ed33a"
msgid ""
"{n}Raquillata nods curtly.{/n} \"Your Highness, last night's military "
"exercises were successful. Instructors from the Wands Brigade, acting as "
"opposing force, was successfully repelled by your mages! The training of "
"your first class is completed. The Brigade is now accepting students for the "
"second class!\""
msgstr ""
"{n}라키야타는 짧게 고개를 끄덕입니다.{/n} \"전하, 어젯밤 군사훈련은 성공적이었습니다. 적 역할을 하는 완드 여단의 강사들은 우리 "
"마법사들에 의해 성공적으로 격퇴되었습니다! 첫 번째 교육반의 훈련이 종료되었습니다. 여단은 지금 훈련병들을 두 번째 교육반으로 "
"승격시켰습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Additional/Cue_0008_Text
#. Speaker : RankUp_Vodja
msgctxt "7d571ee2-3094-487e-8ef8-21bdcd7c0a7a"
msgid ""
"\"Your citizens don't want to be weak and sick either, so they've taken a "
"natural interest in Kurgess. I thought – why don't we build a temple here, "
"complete with bathing ponds? There's a place in foothills where a small "
"creek flows. The water is warm, and it can heal diseases and fill your body "
"with strength.\""
msgstr ""
"\"당신의 백성들도 나약하고 아프고 싶지 않기 때문에, 자연스럽게 쿠르게스에 관심을 가지게 되었습니다. 그리고 저는 생각했습니다. 왜 "
"여기에 목욕할 수 있는 연못이 있는 신전을 짓지 않는 걸까? 저기 작은 개울이 흐르는 언덕이 있습니다. 그 물은 따뜻하고, 질병을 치유해 "
"주며 기운을 북돋아 줍니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Additional/Cue_0009_Text
#. Speaker : RankUp_Romelo
msgctxt "79e4ec34-b261-484e-84a0-8d71471624ce"
msgid ""
"\"I've a message from my employers. My company is eager to open a proving "
"ground to test our new products. – Somewhere far away from Alkenstar and it "
"industrial spies, and somewhere protected by a reliable and influential "
"ally, able to safeguard the factory's property and its secrets.\""
msgstr ""
"\"제 고용주로부터 전갈이 왔습니다. 저희 회사는 신제품을 시험해 볼 시연회를 열기에 여념이 없습니다. 알켄스타와 산업 스파이들로부터 "
"멀리 떨어져 있는, 그리고 신뢰할 수 있고 영향력 있는 동맹에게 보호받는 어딘가에서 공장의 재산과 비밀을 보호할 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Additional/Cue_0010_Text
#. Speaker : RankUp_Romelo
msgctxt "15a25202-c4b4-4013-9e2b-7e1467c1923a"
msgid ""
"\"Your Highness, you seem to be a respectable person to deal with. Would you "
"like to open a small... manufacturing center in your domain? It would be to "
"your benefit! You should think about it.\""
msgstr ""
"\"전하, 당신은 존경할 가치가 있는 사람인 듯하군요. 당신의 땅에 작은 제조 공장을 열고 싶으십니까? 그것은 당신에게 이익이 될 "
"것입니다. 생각해 보아주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Additional/Cue_0011_Text
#. Speaker : RankUp_Rakiyata
msgctxt "0d765b90-e73b-4000-8a88-bf2d79e669b7"
msgid ""
"\"Since everything has worked out so well, I have an offer for you. The "
"Wands Brigade would like to settle down. Most of us desire a home and a "
"family more than war and endless military campaigning. And we have grown to "
"like your kingdom. If you allow us to settle down here, it would surely be "
"for your own good as well.\""
msgstr ""
"\"모든 일이 잘 풀리고 있기 때문에, 당신께 제안 드릴 것이 있습니다. 완드 여단은 정착하고 싶어 합니다. 우리 대부분은 전쟁과 끝없는 "
"전쟁보다 집과 가족을 더 원하고 있습니다. 그리고 우리는 당신의 왕국을 좋아하게 되었습니다. 우리가 이곳에 정착할 수 있도록 허락해 "
"주신다면, 그것은 분명히 당신께도 큰 이익이 될 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Additional/Cue_0012_Text
#. Speaker : RankUp_Rakiyata
msgctxt "4f7a316b-0c9b-4337-bc83-1eecf11f4b30"
msgid ""
"\"We've seen so many different magical weapons over the years! Dwarven axes, "
"elven bows, wonders from {g|Katapesh}Katapesh{/g} beyond description... "
"We've studied them all, and our masters can easily reproduce these "
"masterpieces. With your support we could set up a guild where we'll enchant "
"the best weapons in {g|Avistan}Avistan{/g}.\""
msgstr ""
"\"우린 수년 동안 너무나 많은 마법 무기를 보아왔습니다! 드워프 도끼, 엘프 활, {g|Katapesh}카타페쉬{/g}에서 온 "
"경이로움은 이루 말할 수 없을 정도입니다... 우리는 그 모든 것들을 연구했고, 우리 장인들은 쉽게 그 명작들을 재현할 수 있습니다. "
"당신의 지원이 있다면 우리는 실드를 설립할 수 있을 겁니다. 그곳에서 우리는 {g|Avistan}아비스탄{/g}에서 제일 가는 무기에 "
"마법을 부여할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Additional/Cue_0014_Text
#. Speaker : RankUp_Vodja
msgctxt "123d17ae-8ae2-41d8-9b76-56702c6e4f27"
msgid ""
"\"Let the people rest their bodies and souls there. Other priests from our "
"church can come to offer their teachings. I hope you like the idea. Kurgess "
"bestows blessings upon the lands wherever he is worshipped.\""
msgstr ""
"\"그곳에서 사람들의 몸과 영혼을 쉬게끔 하십시오. 우리 교회의 다른 사제들이 와서 가르침을 드릴 수 있을 겁니다. 이 아이디어가 마음에 "
"들었으면 좋겠군요. 쿠르게스는 자신이 숭배되는 곳이라면 어디든지 그 땅에 축복을 내리십니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Answer_0008_Text
msgctxt "361b7f32-f321-4ecf-8598-9df4efaf5a49"
msgid "\"That's great news! Thank you.\""
msgstr "\"매우 좋은 소식이군! 고맙다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Answer_0009_Text
msgctxt "ac61a924-8370-4df1-ad92-ca5f160611ce"
msgid "\"Why do I have the feeling that I've made a huge mistake?\""
msgstr "\"왜 내가 엄청난 실수를 저질렀다는 느낌이 드는거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Answer_0010_Text
msgctxt "db121d2f-1a0c-4317-9811-853ebd019113"
msgid "\"The credit goes for you.\""
msgstr "\"신용은 네게로 간다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0001_Text
#. Speaker : Regongar_Companion
msgctxt "78e40aa3-3b52-400d-b9f9-8203e5e0a218"
msgid ""
"{n}Regongar grins, pride glowing in his eyes.{/n} \"You know, I've been "
"thinking about which of our neighbors would be capable of destroying us if "
"they wanted to. And it turns out that none of them can! As far as military "
"power is concerned, we'll surely defeat anyone stupid enough to cross us.\""
msgstr ""
"{n}레곤가르가 눈을 번뜩이며 으르렁거립니다.{/n} \"이봐, 우리 이웃들 중 어느 쪽이 우릴 파멸시킬 수 있을지 생각해 봤어. 아무도 "
"없는 것 같더군! 군사력에 관한 한, 우리를 침범하는 게 그 누구일지라도 물리칠 수 있을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0002_Text
#. Speaker : Amiri_Companion
msgctxt "c74f3843-2f57-49bf-8643-f8d7bb21c2a1"
msgid ""
"{n}Amiri looks at you solemnly, her chin held high.{/n} \"I have something "
"important to say, {name}. I want to congratulate you.\""
msgstr ""
"{n}아미리는 고개를 높이 들고, 진지하게 당신을 바라봅니다.{/n} \"{name}, 중요하게 할 말이 있다. 축하해 주고 싶군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0003_Text
#. Speaker : Regongar_Companion
msgctxt "bdae98d0-3185-4cb3-8bb0-4bdbd285c62c"
msgid ""
"\"Your army has so many well-trained blademasters that we've gained the "
"attention of the {g|Swordlords}Swordlords{/g}. It looks like the new sword-"
"fighting school will be opening soon in the kingdom. The Swordlords are "
"looking to recruit all the most talented students.\""
msgstr ""
"\"우리 군대에 잘 훈련된 검사들이 너무 많아서 {g|Swordlords}소드로드{/g}의 주목을 받았어. 새로운 검투 학교가 곧 "
"왕국에서 개교할 것으로 보이는군. 가장 재능 있는 학생들을 모집하려고 한다더라고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0004_Text
#. Speaker : Regongar_Companion
msgctxt "6d64c935-abe5-4434-9530-dcd4b8ab25b1"
msgid ""
"\"By the way, I'm not the only one who appreciates the decisions you've "
"made. There are so many mages in our army that one of the orders or "
"{g|Nethys}Nethys{/g} decided to move their coven to your kingdom. That's "
"worked damn well for us! Do you have any idea what kinds of deadly spells "
"they could teach us? They probably have a spell that summons a swarm of "
"carnivorous bees that fly into their victim's mouth and eats him from the "
"inside out! And a spell that makes your heart explode!\""
msgstr ""
"\"헌데 네가 내린 결정을 좋아하는 건 나 뿐만이 아니야. 본거지를 네 왕국으로 옮기려고 한 {g|Nethys}네서스{/g} 기사단 "
"출신의 마법사들이 정말 많아. 그게 정말이지 빌어먹을 호재라니까! 그 마법사들이 우리에게 가르칠 수 있는 치명적인 주문들을 상상이나 "
"해봤어? 분명 적의 입으로 들어가 내장부터 살을 파고먹고 나오는 육식성 벌떼에 대한 주문도 알고 있을 거라고! 그리고 심장을 터뜨릴 수 "
"있는 주문도 알테고 말이지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0005_Text
#. Speaker : Amiri_Companion
msgctxt "a5d980ce-84fd-4de0-932a-ea5c7a240f04"
msgid ""
"\"The {g|Swordlords}Swordlords{/g} are amazed by our glory, and want to set "
"up a new school in our kingdom. They hope that being close to us will give "
"them better chances to be in a big battle. To show their mastery and earn "
"some fame. I think this news will make you happy.\""
msgstr ""
"\"{g|Swordlords}소드로드{/g}는 우리의 영광에 감탄하며, 우리 왕국에 새로운 학교를 세우고자 한다. 그들은 큰 전투에서 "
"우리를 도울 수 있는 좋은 기회를 얻고자 우리와 가까이 있기를 원하지. 그들의 지배력을 보여주고 명성을 얻기 위해서겠지. 이 소식이 너를 "
"행복하게 할 것 같다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0006_Text
#. Speaker : Amiri_Companion
msgctxt "89946a52-3d65-4304-b408-2d6a4285e70a"
msgid ""
"\"In the North, victory is achieved with sword and axe. It's different with "
"you southerners. You're not so good as warriors, but you're crafty and "
"better with magic. Your army has very strong mages. That makes you strong... "
"for southerners anyway. The other mages have seen it too. It makes them come "
"to beg for protection. Priests of {g|Nethys}Nethys{/g} want to open their "
"own coven under your wing to share the knowledge.\""
msgstr ""
"\"북방에서 승리는 검과 도끼로 이뤄진다. 하지만 남쪽 사람들은 다르다. 너희는 전사들보다 힘이 세지는 않지만, 똑똑하고 마법에 능하다. "
"그리고 너의 군대는 매우 강한 마법사들도 있다. 그런 것들이 너희를 강하게 만드는 것들이겠지... 다른 마법사들도 본 적이 있다. 그것은 "
"그들이 보호를 구걸하게끔 만들지. {g|Nethys}네서스{/g}의 사제들은 너의 날개 아래 지식을 공유하기 위한 집회를 열고자 한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0011_Text
#. Speaker : Amiri_Companion
msgctxt "59ceec36-1c45-4450-89da-a56536f29cca"
msgid ""
"\"I have no more issues for you, chief. But there's a visitor who wants to "
"see you.\""
msgstr "\"더 이상 아무 문제 없다, 족장. 그런데 널 보고 싶어 하는 손님이 있더군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0012_Text
#. Speaker : Regongar_Companion
msgctxt "6c8bbb39-6862-42b1-98bd-58288b985f62"
msgid ""
"\"Well, that's all for now. There's someone else who wants to talk to you, "
"{name}. You can do that without me, right?\""
msgstr "\"음... 지금은 그게 다야, {name}. 너랑 얘기하고 싶은 사람이 또 있는 것 같던데. 나 없어도 할 수 있겠지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0013_Text
#. Speaker : Amiri_Companion
msgctxt "622ffcea-db77-4b8d-994c-8543dc20e5cb"
msgid ""
"{n}Amiri presses her hands to her chest and smiles lightly.{/n} \"We're a "
"tribe, and that means we all take the credit, not me.\""
msgstr ""
"{n}아미리는 가슴팍에 손을 대고 가볍게 웃습니다.{/n} \"우리는 한 부족이고, 그 말은 우리가 다 함께 공로를 나눈다는 거야. 나 "
"혼자만이 아니라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0014_Text
#. Speaker : Amiri_Companion
msgctxt "da194e0c-2629-41cc-895a-4c8adcd5b85c"
msgid ""
"\"That's the a chief's burden. The enemies' blows make warrior's head ache. "
"Doubts and second thoughts make the chief's head ache.\""
msgstr "\"그건 족장으로서의 짐이야. 적들의 공격은 전사의 머리를 아프게 하지만 족장의 머리를 아프게 하는 것은 의심과 심사숙고지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0015_Text
#. Speaker : Regongar_Companion
msgctxt "e0f62d37-9ab1-4be8-9790-867b57990a84"
msgid ""
"\"That's because you've got brain. Most people rarely have second thoughts. "
"Maybe that's why you're on the throne and we serve you. But don't be upset. "
"If you run into any problems, we can solve them. Together.\""
msgstr ""
"\"그것은 네가 두뇌를 가지고 있기 때문이 아닐까? 대부분의 사람들은 다시 생각하는 일이 거의 없어. 하지만 그렇기 때문에 네가 왕좌에 "
"올랐고 우리가 너를 섬기는 것일지도 모르지. 그래도 화내지는 말라고. 만약 네가 어떤 문제에 부딪히면, 우리 다 함께 해결할 수 있는 "
"거잖아. 함께 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0016_Text
#. Speaker : Regongar_Companion
msgctxt "e4f1f0de-ce9b-4529-ab88-63964a4d69c5"
msgid ""
"\"That's true, I'm a good leader. But you... well, you're good, too. You "
"didn't interfere.\" {n}Regongar grins contentedly.{/n}"
msgstr ""
"\"그건 맞아, 난 좋은 지도자지. 반면에 너는... 뭐, 너도 좋은 지도자야. 참견은 안 했잖아.\" {n}레곤가르는 만족스럽게 "
"웃습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0017_Text
#. Speaker : Amiri_Companion
msgctxt "50bbca95-8c5c-444a-a307-b90c26425de1"
msgid ""
"\"Your army, {name}, is the most dangerous bunch in the {g|River Kingdoms}"
"River Kingdoms{/g}. Being a warchief is a Kellids' biggest pride. I'm happy "
"to lead an army as powerful as yours.\""
msgstr ""
"\"{name}, 네 군대는 {g|River Kingdoms}강의 왕국들{/g}에서 가장 위험한 이들이야. 전쟁지도자가 되는 것은 켈리드의 "
"가장 큰 자부심이지. 네 군대 만큼이나 강력한 이들을 이끌게 되어 기쁘다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0018_Text
#. Speaker : Regongar_Companion
msgctxt "75bb1c75-4a32-4285-9d26-0b9185f74c87"
msgid ""
"\"I didn't understand you right away. You have ambition! And you can rule. "
"It wasn't a bad decision to come work for you.\""
msgstr ""
"\"바로 이해는 못 했었어. 너 야망이 있구나? 그리고 넌 지배할 수 있지. 너와 함께 일하게 된 것은 나쁘지 않은 결정이었던 것 같아."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0019_Text
#. Speaker : Capital_Kassil
msgctxt "ca252189-c6b0-434b-80a0-0dd7942695f2"
msgid ""
"\"Please, accept my congratulations, your Highness! It's under your guidance "
"that we have raised a strong army! An invincible one, by local standards. "
"Who could have imagined that such a young country would have such a powerful "
"military force? I'm proud I could prove myself in the service of such a "
"worthy ruler as you!\""
msgstr ""
"\"제 축하를 받아 주십시오, 전하! 우리가 이렇게 강력한 군대를 양성하게 된 것은 당신의 지도 덕분입니다! 이 지역에서는 무적 그 "
"자체입니다! 신생 국가가 이렇게 막강한 군사력을 가지게 되리라고 누가 상상이나 했겠습니까! 당신처럼 훌륭한 통치자를 섬길 수 있어서 "
"자랑스럽습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0020_Text
#. Speaker : Capital_Kassil
msgctxt "8d4fc98d-533e-4e9e-b6d1-bc7bc772f36e"
msgid ""
"\"Perhaps, at some point I lacked the wisdom to understand your intentions, "
"but I am only Lady Aldori's student. I still have a lot to learn. Anyway, a "
"group of priests of {g|Nethys}Nethys{/g} are looking to open a coven in your "
"domain. They appreciate the respect you've shown your mages, and hope that "
"you might grant them your protection if trouble ever arose. In exchange, "
"they promise to educate our combat mages. I find this a worthy deal.\""
msgstr ""
"\"아마도, 당신의 의도를 이해할 지혜가 부족한 순간도 있겠지만, 저는 아직 알도리님의 견습생일 뿐입니다. 배울 게 많지요. 어쨌든 "
"{g|Nethys}네서스{/g}의 사제들이 당신의 땅에서 집회를 열려고 하고 있습니다. 그들은 당신께서 마법사들을 보여줌으로써 행한 "
"존중에 감사하고, 문제가 생기면 당신께서 보호해 주기를 희망하고 있습니다. 대신 그들이 우리 전투 마법사들을 교육해 줄 것입니다. 저는 "
"이것이 가치 있는 거래라고 생각합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0021_Text
#. Speaker : Capital_Kassil
msgctxt "c2aa0c12-6f5f-408b-86bd-1e22b14dede1"
msgid ""
"\"There's always been a traditional rivalry between mages and warriors. The "
"troops that defend the front lines have to face down lightning bolts and "
"fiery rain with nothing but shields. They afterwards find it difficult to "
"embrace any rainmaker, even as an ally. However, the mages in your army are "
"respected and treated differently.\""
msgstr ""
"\"마법사와 전사들 사이에는 항상 전통적인 경쟁관계가 있었습니다. 전선을 지키는 부대는 방패로 라이트닝 볼트나 불의 비 같은 걸 막아내야 "
"합니다. 그러나 그 후에 그들은 공로를 치하 받기 힘들다는 것을 알게 됩니다. 하지만 당신의 군대는 존중받고 다르게 대우받습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0022_Text
#. Speaker : Capital_Kassil
msgctxt "a439a49a-198c-4baf-8652-3dc9dab438f5"
msgid ""
"\"The sword masters respect your army. Many are not bound by any obligation "
"to the major houses, and would like to join us. They know we expect many "
"battles to come, which promises a chance at glory and an opportunity to "
"prove themselves.\""
msgstr ""
"\"검의 달인들은 당신의 군대를 존경합니다. 그들 중 많은 이들이 주요 가문에 대한 어떠한 의무에도 얽매이지 않고 있으며, 우리와 "
"함께하기를 원합니다. 그들은 우리가 영광과 자신을 증명할 기회를 약속하는 많은 전투를 치를 것을 기대하고 있다는 것을 알고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0023_Text
#. Speaker : Capital_Kassil
msgctxt "3d3ad998-a026-460e-8fac-76f32be08b0d"
msgid ""
"\"I have nothing at present that requires your attention. But I brought one "
"of the military advisors, who may have an interesting offer.\""
msgstr ""
"\"현재 당신의 주의를 요하는 것은 없습니다. 다만 군사 보좌관 한 분을 모셔 왔는데, 흥미로운 제안을 할 수도 있을 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0024_Text
#. Speaker : Capital_Kassil
msgctxt "646f3fa1-da45-4e63-a4e4-d037764a4703"
msgid ""
"{n}Kassil shrugs.{/n} \"I'm sure all your decisions were correct. You only "
"question them because you consider it a sacred duty to carefully consider "
"your every step.\""
msgstr ""
"{n}카실은 어깨를 으쓱합니다.{/n} \"전 당신의 모든 결정이 옳았다고 확신합니다. 당신은 단지 한 걸음 한걸음 신중히 생각하는 것이 "
"신성한 의무라고 생각하기 때문에 그들에게 의문을 가지는 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0025_Text
#. Speaker : Capital_Kassil
msgctxt "4fff4567-3495-47ff-aa72-af4b8019274e"
msgid ""
"\"I was only doing my duty, your Highness. And I'm proud I managed to "
"maintain the kingdom's honor.\""
msgstr "\"저는 제 의무를 다했을 뿐입니다, 전하. 그리고 제가 그 왕국의 명예를 유지할 수 있었다는 것이 자랑스럽습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank10/Military_Rank10Main/Cue_0026_Text
#. Speaker : Capital_Kassil
msgctxt "53565b54-ef02-4d0d-ae5b-301361f8aee9"
msgid ""
"\"I understand them well. This is why the sword masters have offered to open "
"a military school in the capital. For me, this is no little matter of pride. "
"It means that Lady Aldori's lessons were not lost on me.\""
msgstr ""
"\"저는 그들을 잘 이해합니다. 이 때문에 검의 달인들이 수도에 군사학교를 열겠다고 나선 것입니다. 제게 있어서 이것은 작은 자랑거리가 "
"아닙니다. 이것은 알도리님의 가르침이 아직 제게 남아있다는 것을 의미합니다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Answer_0008_Text
msgctxt "26000a62-d98b-4bd3-a81c-2c7d0ee36cbf"
msgid ""
"{g|Military2_1}[Choice effects]{/g} \"Open unrestricted recruitment. Anyone "
"with the will for it is good enough for our army.\""
msgstr ""
"{g|Military2_1}[선택 시 효과]{/g} \"제한 없이 신병을 모집하라. 누구든 의지가 있는 자는 군에 도움이 될 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Answer_0009_Text
msgctxt "d4193aa5-9bff-4364-9ae9-749cc50dc83f"
msgid ""
"{g|Military2_2}[Choice effects]{/g} \"Select the strongest and most skillful "
"recruits. I need real fighters.\""
msgstr "{g|Military2_2}[선택 시 효과]{/g} \"가장 강하고 뛰어난 자들을 모집하라. 진짜 싸움꾼이 필요하다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Answer_0010_Text
msgctxt "a5373366-ded6-432a-b6b9-7b4822711049"
msgid ""
"{g|Military2_3}[Choice effects]{/g} \"Select those who have ambition. "
"Soldiers who dream of glory and rank always serve better.\""
msgstr ""
"{g|Military2_3}[선택 시 효과]{/g} \"야심이 있는 자들을 뽑아라. 영광과 높은 계급에 꿈을 가진 자만이 언제나 더 잘 "
"싸우는 법이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Answer_0011_Text
msgctxt "d05036bc-7876-4983-a9a3-e6ae2faab63f"
msgid "\"Make your own decision.\""
msgstr "\"알아서 결정하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "86089f4e-6a8b-4e01-9779-55b71657aeb3"
msgid ""
"{n}Kassil bows briskly, then hurries to speak.{/n} \"On your orders, I have "
"reviewed our military forces. The results are... disappointing, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}. We require new recruits – and "
"the sooner the better.\""
msgstr ""
"{n}카실은 힘차게 몸을 숙이며, 서둘러 말합니다.{/n} \"명에 따라, 우리 군사들을 살펴보았습니다. 그 결과는... 실망스럽더군요, "
"{mf|영주님|영주님|전하|전하}. 신병이 필요합니다. 빠르면 빠를 수록 좋지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0002_Text
#. Speaker : Capital_Kassil
msgctxt "8932307d-7c72-412a-979b-45d50124e6d7"
msgid ""
"\"We can introduce some restrictions, limiting how many could qualify for "
"service. However, under these circumstances I feel they shouldn't be very "
"stringent. Indeed, I would recommend we announce that anyone can join the "
"army – and I'm sure that we shall find many brave men among your subjects, "
"ready to protect their lands!\""
msgstr ""
"\"제한을 둬서 신병 모집의 기준을 높일 수 있습니다. 하지만 이 상황이라면 그 기준이 그리 높지는 않을 거 같긴 합니다만. 사실 저라면 "
"누구든 지원하면 군에 들어올 수 있게 하겠습니다. 분명 백성들 중에서 충심 있고 조국을 수호할만한 자들이 많이 나오겠지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0003_Text
#. Speaker : Amiri_Companion
msgctxt "89a1806e-95cd-4821-af51-e6458c95a212"
msgid ""
"{n}Amiri looks displeased.{/n} \"Since you made me the troops' chief, listen "
"to what I tell you: you need more people. The ones we have now are weaklings "
"and cowards. If we don't get any good fighters, our neighbors will smash us "
"whenever they want!\""
msgstr ""
"{n}아미리는 불편해 보입니다.{/n} \"네가 날 부대장으로 만들었으니, 내가 말하는 걸 들어야 해. 병사가 더 필요해. 현재 있는 "
"놈들은 약해빠진 겁쟁이들 뿐이야. 좋은 전투원이 충분하지 않으면 우리 이웃들이 언제든 우릴 뭉개버릴 거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0004_Text
#. Speaker : Amiri_Companion
msgctxt "dc83b5e7-cced-43f1-b474-0cb62899f4d1"
msgid ""
"\"Just so you know... you should pick better fighters. I don't want to deal "
"with overgrown kids who complain about every scratch! Don't take just anyone "
"who wants it – or else we'll have barracks full of pansies. What are we "
"going to do with pansies? We need them strong and gutsy or it's no point.\""
msgstr ""
"\"참고로 말하자면... 더 나은 전사들을 뽑아야 해. 생채기 가지고 이리저리 불평해대는 조금 자란 꼬맹이들을 데리고 다니긴 싫으니까! "
"오고 싶다고 다 받아주면 안 돼. 그렇지 않으면 병영이 호모새끼들로 가득 차버릴 거야. 그 호모새끼들을 데리고 뭘 할 수 있겠어? 강하고 "
"배짱 좋은 놈들 아니면 의미가 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0005_Text
#. Speaker : Regongar_Companion
msgctxt "51d89530-b08c-4575-994a-12b49fe9b0d6"
msgid ""
"\"You busy? No? Then I got something for you.\" {n}Regongar stretches his "
"shoulders, like he's readying for a fight.{/n} \"You may have killed the "
"Stag Lord, but it's too early to kick back and relax. There's still plenty "
"of bandits walking your lands. They still think it's their home. Let me get "
"some more soldiers, before they cut through the ones we have and leave us "
"with nothing.\""
msgstr ""
"\"바쁜가? 아니라고? 그렇다면 할 말이 있다.\" {n}레곤가르는 싸울 준비를 하듯 어깨를 쭉 폅니다.{/n} \"숫사슴 군주가 네 "
"손에 쓰러졌긴 하지만, 아직 다리 쭉 펴고 쉬긴 이르다. 이 땅을 걸어다니는 도적떼들이 아직 많다. 아직도 놈들은 이곳이 자기네 고향인 "
"줄 알고있지. 놈들이 백성들을 죽이고 아무것도 남기지 않기 전에 더 많은 병사를 모으도록 해다오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0006_Text
#. Speaker : Regongar_Companion
msgctxt "23295680-a7bb-4a02-b716-c797a85cc9d9"
msgid ""
"{n}The half-orc squints.{/n} \"You know which ones you need? Not the big "
"dumb guys. No, you need fighters who want power. They'll serve you well. And "
"if any should grow too bold...\" {n}Regongar sneers sullenly.{/n} \"I'll "
"hang them from the trees.\""
msgstr ""
"{n}하프오크는 찡그리며 바라봅니다.{/n} \"어떤 놈이 필요한 지 아나? 덩치만 큰 머저리들은 안 돼. 힘을 원하는 전사가 필요하지. "
"놈들은 널 잘 섬길 거다. 혹시 누가 기어오르기라도 하면...\" {n}레곤가르는 음흉하게 미소짓습니다.{/n} \"내가 놈들을 나무에 "
"매달아버리지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0012_Text
#. Speaker : Capital_Kassil
msgctxt "384327b4-afc6-4f4a-851e-0a165aade32b"
msgid ""
"\"Wonderful, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! I will "
"begin recruiting new soldiers immediately.\""
msgstr "\"멋지군요, {mf|영주님|영주님|전하|전하}! 즉시 신병을 모집하도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0013_Text
#. Speaker : Amiri_Companion
msgctxt "d527aa11-d73d-4cf7-908b-2c53ee3aed31"
msgid ""
"\"Seriously? Your capital is already guarded by a handful of pansies, and "
"now you want a whole army like that?! Ugh!\" {n}Amiri spits on the floor and "
"angrily turns away.{/n}"
msgstr ""
"\"정말이야? 수도가 이미 호모새끼들로 가득한데, 그런 놈들을 더 원한다고?! 으웩!\" {n}아미리는 바닥에 침을 뱉고는 성이 난 채로 "
"뒤돌아 사라집니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0014_Text
#. Speaker : Regongar_Companion
msgctxt "fdef484d-e341-46bf-a651-fc9f488c62e7"
msgid ""
"\"Is that right? Well, you're the boss. We'll find a use for cannon fodder "
"too.\" {n}Regongar shrugs nonchalantly.{/n}"
msgstr "\"정말인가? 뭐, 대장은 너니까. 고기방패도 필요가 있겠지.\" {n}레곤가르는 무심하게 으쓱합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0015_Text
#. Speaker : Capital_Kassil
msgctxt "c25b7b34-cd20-45b1-9563-d43cd6426428"
msgid ""
"\"As you wish, {mf|Your Grace|Your Grace|Your Highness|Your Highness}.\""
msgstr "\"바라시는 대로, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0016_Text
#. Speaker : Amiri_Companion
msgctxt "dc85a6ff-94ca-4c87-82e8-38ca0224da85"
msgid ""
"\"Right! Just like I say! No idea why I come to you. I could just do it all "
"myself.\""
msgstr "\"그래! 내가 말한 그대로구만! 내가 왜 널 따라왔는 지 모르겠네. 나 혼자서 다 할 수 있는데 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0017_Text
#. Speaker : Regongar_Companion
msgctxt "62b4154d-3493-4c5d-91d2-49d1080908b1"
msgid ""
"{n}Regongar shows his fangs.{/n} \"Dumb blockheads marching around? What am "
"I supposed to do with these idiots?!\" {n}The half-orc growls in irritation "
"and turns away.{/n}"
msgstr ""
"{n}레곤가르는 자신의 이빨을 드러냅니다.{/n} \"멍청한 돌대가리들을 행군시키겠다고? 내가 이 머저리들이랑 뭘 하려고 한 거지?!\" "
"{n}하프오크는 분노의 울음소리를 내더니 뒤돌아 사라집니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0018_Text
#. Speaker : Capital_Kassil
msgctxt "27481182-a75a-4369-a137-012a28fb4202"
msgid ""
"{n}Kassil frowns.{/n} \"Ambition is good, when there's a place for it. But "
"an army, with its strict order and hierarchy, is hardly a place for upstarts."
"\" {n}The half-orc coughs.{/n} \"I'm sorry to speak so freely.\""
msgstr ""
"{n}카실은 찡그립니다.{/n} \"야망은 좋지요. 적절한 위치에서는 말입니다. 하지만 엄격한 규율과 계급으로 나뉘는 군이라는 곳은 "
"아닙니다.\" {n}하프오크는 기침을 합니다.{/n} \"너무 무분별하게 이야기해서 죄송합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0019_Text
#. Speaker : Amiri_Companion
msgctxt "c93f9353-a47d-48ff-91df-02096206598b"
msgid ""
"\"Hmm... well, maybe something good will come from them. I understand. I'll "
"go find some.\""
msgstr "\"흐음... 뭐, 놈들도 잘 할 수 있는 게 있겠지. 이해해. 한 번 지켜보지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0020_Text
#. Speaker : Regongar_Companion
msgctxt "37f5df39-039a-4697-8b59-2ad782b64e82"
msgid "{n}Regongar grins.{/n} \"I like your attitude. I'll go get busy.\""
msgstr "{n}레곤가르는 미소짓습니다.{/n} \"네 사고방식이 마음에 드는군. 이제 좀 바빠지겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0021_Text
#. Speaker : Capital_Kassil
msgctxt "7f7350b8-63b1-4314-a988-f1ee5ebd2c5e"
msgid ""
"\"As you wish. I will announce immediately that anyone who wishes to serve "
"their native land shall be welcomed in its army.\""
msgstr "\"원하시는 대로. 조국을 위해 봉사하고 싶은 자들은 누구든 군에 환영이라고 공고하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0022_Text
#. Speaker : Amiri_Companion
msgctxt "70b87dda-f99a-4b0b-ae98-e10d778a6b5d"
msgid ""
"\"So why did I come all the way here from the other side of the castle?! "
"Fine, I'll recruit the ones I like. If he can get up after I punch him, then "
"he's in.\" {n}Amiri cracks her fingers, ready for a brawl.{/n}"
msgstr ""
"\"내가 뭐하러 성 밖에서 여기까지 기어들어 온 건지?! 좋아, 내 마음에 드는 놈들로 모집하겠어. 내 주먹 한 방 맞고 버티는 놈을 "
"뽑지.\" {n}아미리는 손가락을 우두둑 거리며, 싸울 준비를 합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank2/Cue_0023_Text
#. Speaker : Regongar_Companion
msgctxt "59ab5f3c-74ac-4a5b-b629-84f72000b29f"
msgid ""
"\"Great. I'll find the kind of recruits who'll crawl into the "
"{g|Abyss}Abyss{/g} if it means they'll get a medal.\""
msgstr "\"좋군. {g|Abyss}어비스{/g} 로까지 제발로 걸어갈 수 있는 놈들로 고르지. 훈장만 준다면 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Answer_0008_Text
msgctxt "d994a45e-b280-401c-89ee-e482c40905a0"
msgid "{g|Military3_1}[Choice effects]{/g} \"Hire Swordlords as officers.\""
msgstr "{g|Military3_1}[선택 시 효과]{/g} \"소드로드를 장교로 고용하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Answer_0009_Text
msgctxt "d674dd27-0ab1-4641-aa00-8190b1c44f8e"
msgid "{g|Military3_2}[Choice effects]{/g} \"Hire spellcasters as officers.\""
msgstr "{g|Military3_2}[선택 시 효과]{/g} \"주문 시전자를 장교로 고용하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Answer_0010_Text
msgctxt "ec1884b6-3781-4070-afb3-cd9874b7fce4"
msgid ""
"\"I see you understand these matters better than I. Solve the problem "
"yourself.\""
msgstr "\"나보다 이 문제들에 대해 더 잘 이해하는 듯하군. 네가 직접 문제를 해결해라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "90b4c9d5-99bc-408d-982c-14946dc19cf4"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, I am happy to "
"report that recruitment continues. Our ranks swell with more and more fine "
"soldiers. However, we now face another problem – there aren't enough "
"officers. We shouldn't look for them among the common citizens: command "
"requires certain skills and knowledge.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 신병 모집이 계속 진행된다는 보고를 드리게 되어 기쁩니다. 저희 병사들은 점점 더 훌륭한 병사들로 "
"채워지고 있습니다. 하지만, 우리는 또 다른 문제에 직면해 있습니다. 그 말인즉슨, 장교가 부족하다는 것입니다. 우리는 일반 시민들 "
"사이에서가 아닌, 특정한 기술과 지식을 갖춘 자를 찾아야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0002_Text
#. Speaker : Capital_Kassil
msgctxt "3ecabf96-b327-40df-bc3e-9995d7f5fb45"
msgid ""
"\"I recommend you recruit officers from among the "
"{g|Swordlords}Swordlords{/g}. They are experienced warriors and skillful "
"leaders, capable of strategic thinking and inspiring the sort of courage "
"that will survive the harsh realities of the battlefield.\""
msgstr ""
"\" {g|Swordlords}소드로드{/g} 중에서 장교를 모집할 것을 권합니다. 그들은 경험 많은 전사이자 능숙한 지도자이며 전략적인 "
"사고를 할 수 있고 전쟁터의 가혹한 현실에서 살아남을 수 있는 일종의 용기를 북돋울 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0003_Text
#. Speaker : Amiri_Companion
msgctxt "ca848280-d823-491d-bd04-a65cafffdf81"
msgid ""
"\"Well, {name}, it's me again. Our army is growing. We got more soldiers. "
"But not enough commanders. And there aren't no clever ones among the "
"recruits. Without good command, you know, you can't run an army.\""
msgstr ""
"\"음, {name}, 또 나야. 우리 군대는 성장하고 있어. 더 많은 병사들이 생겼지. 하지만 지휘관이 부족해. 신병 중에는 똑똑한 "
"사람이 없어. 좋은 지휘관 없이는, 음, 너도 알잖아. 군대를 운영할 수 없을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0004_Text
#. Speaker : Amiri_Companion
msgctxt "adf88a2a-85f7-4034-bb33-b3555866b44a"
msgid ""
"\"In some armies the officers are wizards or shamans. They might be brainy, "
"but they don't know a damn thing about soldiers. But when I was in "
"{g|Brevoy}Brevoy{/g}, I seen those... you know... "
"{g|Swordlords}Swordlords{/g}, right! They look skinny, but they know their "
"weapons, and soldiers look up to them. I think we should hire them to be "
"commanders in our army – they'll definitely have the troops' respect.\""
msgstr ""
"\"어떤 군대에서는 마법사나 샤먼이 장교를 맡더군. 그들은 머리는 좋지만... 군인에 대해서는 전혀 모르잖아? 하지만 "
"{g|Brevoy}브레보이{/g}에 있을 때 봤던 게 있는데... 있잖아... 그... {g|Swordlords}소드로드{/g}, 맞아! "
"그들은 좀 말랐지만 무기에 대해 잘 알고, 군인들도 우러러보잖아. 내 생각엔 그들을 우리 군의 지휘관으로 고용해야 한다고 생각해. 그들은 "
"분명 군대의 존경을 이끌어 낼 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0005_Text
#. Speaker : Regongar_Companion
msgctxt "6669f522-ccff-4c8f-bddb-0e69f7d62fad"
msgid ""
"\"Listen, {name}. Remember about recruitment? Well, I did that, we have the "
"numbers. But there's no one to command them.\" {n}Regongar spits through his "
"fangs.{/n} \"We need to find someone these dimwits will fear and obey. Me "
"alone is not enough.\""
msgstr ""
"\"들어봐, {name}. 신병 모집에 대해서 기억해? 음, 내가 그랬잖아. 우리는 숫자는 많은데 지휘관이 없다고.\" {n}레곤가르는 "
"그의 송곳니를 통해 침을 뱉습니다.{/n} \"우리는 이 멍청이들이 두려워하고 복종할 만한 누군가를 찾아야 해. 나 혼자만으로는 "
"부족하다고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0006_Text
#. Speaker : Regongar_Companion
msgctxt "d899a11e-62f5-4577-86ae-3f43536ca241"
msgid ""
"\"You know who we should make commanders? Not those boneheads from "
"{g|Brevoy}Brevoy{/g}, who dance around with their pig-stickers. No, we "
"should hire spellcasters instead! Our regular bonebreaker troops won't "
"whisper a word against a wizard. They're too afraid of getting lightning "
"thrown in their face. And just imagine what terror they'll bring to the "
"battlefield. Not like those {g|Swordlords}Swordlords{/g} – "
"{g|Choral}Choral{/g} mopped the floor with them!\""
msgstr ""
"\"누굴 지휘관으로 세워야 할지 알아? {g|Brevoy}브레보이{/g}에 춤추는 멧돼지 사냥꾼들 같은 멍청이들은 안되지, 안돼. 대신 "
"주문 시전자를 고용해야 해! 우리 성가신 군인들은 마법사에 대해서는 불평 한마디도 속삭이지 않을 거야. 얼굴에 번개가 떨어질까 "
"무서워할걸? 그리고 그 마법사들이 전쟁터에 어떤 공포를 가져올지 상상해봐. 대걸레로 바닥이나 닦던 {g|Swordlords}소드로드{/g}"
"나 {g|Choral}코랄{/g}이랑은 차원이 다를걸!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0012_Text
#. Speaker : Capital_Kassil
msgctxt "d373da7a-33df-449e-8e06-00b519ddbf4a"
msgid ""
"{n}Kassil nods.{/n} \"I will make the necessary arrangements immediately.\""
msgstr "{n}카실이 끄덕입니다.{/n} \"당장 필요한 준비를 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0013_Text
#. Speaker : Amiri_Companion
msgctxt "bcc1052d-0665-4ed5-9a85-0fa2c77cfdd2"
msgid ""
"{n}Amiri hums contentedly.{/n} \"Right. Fine, I'll go tell the others what "
"you said.\""
msgstr "{n}아미리가 만족스럽게 콧노래를 부릅니다.{/n} \"좋아. 가서 다른 사람들한테 네 명령을 전할게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0014_Text
#. Speaker : Regongar_Companion
msgctxt "7e3793c1-a261-4dbf-ba67-6d9077afcfa6"
msgid ""
"{n}Regongar sneers scornfully.{/n} \"What, you too? "
"{g|Swordlords}Swordlords{/g}, no shit... even the peasants aren't afraid of "
"them – what soldier will respect them?\""
msgstr ""
"{n}레곤가르는 경멸하며 비웃습니다.{/n} \"뭐야, 너도? {g|Swordlords}소드로드{/g}라니, 말도안돼... 농민들도 "
"그놈들은 안 무서워한다고! 어떤 군인이 그들을 우러러볼까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0015_Text
#. Speaker : Capital_Kassil
msgctxt "17f9792d-8a7f-43a2-89c9-a7cf2b30d12c"
msgid ""
"\"But... how should a spellcaster, who has sat all his life in a lab, be "
"expected to take up command?\" {n}Kassil shakes his head.{/n} \"I… I'm "
"surprised by this decision.\""
msgstr ""
"\"하지만 평생 연구실에 앉아 있는 주문 시전자들이 어떻게 지휘를 할 수 있을까요?\" {n}카실은 고개를 가로젓습니다.{/n} \"저"
".. 저는 당신의 결정이 조금 놀랍습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0016_Text
#. Speaker : Amiri_Companion
msgctxt "c4cdb0a2-dc42-40cc-8cf5-cc1fdf6f72ea"
msgid ""
"{n}Amiri looks insulted.{/n} \"Wha-a-at? These skinny dudes in robes will "
"boss my guys around? You kidding me, {name}?! What will I do with them?!\" "
"{n}Amiri spits on the floor furiously.{/n}"
msgstr ""
"{n}아미리는 모욕당한 듯한 표정을 하고 있습니다.{/n} \"뭐, 뭐어?! 로브나 입고 다니는 말라깽이들이 내 부하들한테 이래라저래라 "
"하게 한다고? 장난하냐, {name}?! 내가 그놈들을 가만둘 것 같아?!\" {n}아미리는 화가난 듯 바닥에 침을 뱉습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0017_Text
#. Speaker : Regongar_Companion
msgctxt "44b780be-ea28-4197-b9c6-84392d30c620"
msgid ""
"\"Great! A couple of fried troublemakers, and the rest of your soldiers will "
"toe the line.\""
msgstr "\"좋아! 골칫덩이 한두 명 정도 튀겨주고 나면, 나머지 병사들은 대열을 잘 지키고 서 있을거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0018_Text
#. Speaker : Capital_Kassil
msgctxt "6a42ef37-5d3d-4c83-8b6e-aa91a507d773"
msgid ""
"\"Thank you for your trust. I will immediately send letters to any "
"{g|Swordlords}Swordlords{/g} who may be interested in such a placement.\""
msgstr "\"믿어주셔서 감사합니다. 바로 이 직책에 관심이 있는 {g|Swordlords}소드로드{/g}들에게 편지를 보내보겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0019_Text
#. Speaker : Amiri_Companion
msgctxt "7eb453db-1de4-438e-adc6-291bf887dc36"
msgid ""
"\"Then I go find out how to get those {g|Swordlords}Swordlords{/g}. Be back "
"later.\""
msgstr "\"그럼 나는 그 {g|Swordlords}소드로드{/g}들을 구하는 방법을 좀 알아볼게. 나중에 다시 오지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank3/Cue_0020_Text
#. Speaker : Regongar_Companion
msgctxt "1a5b38ca-9ddb-47c9-ac4e-b822bd552fe5"
msgid ""
"\"I know a couple wizards who would make perfect commanders. I'll handle "
"everything.\""
msgstr "\"지휘관에 완벽하게 어울리는 마법사 몇 명을 알아. 내가 알아서 다 처리할게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/AmiriBYE_String
#. Speaker : Amiri_Companion
msgctxt "a60423ce-6cba-4a0e-989e-d05d7c729b14"
msgid ""
"\"You know…\" {n}Amiri scratches her nose, then sighs.{/n} \"Fine, I'll just "
"say it. I don't like being your General. I give you good advice, and you "
"never listen. Of course I'll do what you say this time, but after this – "
"forget it. Find yourself another general.\""
msgstr ""
"\"있잖아…\" {n}아미리는 코를 긁적이더니, 한숨을 쉽니다.{/n} \"좋아. 그냥 말할게. 나 네 장군이 되는 거 싫어. 내가 백날 "
"좋은 조언을 해줘도 넌 듣지도 않잖아. 물론 이번에는 네가 시킨 대로 하겠지만, 이 일이 끝나면 난 안 할 거야. 다른 사람 찾아봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Answer_0011_Text
msgctxt "f8eac3e1-9c86-4180-8d9d-6c98a0d38e6e"
msgid ""
"{g|Military4_1}[Choice effects]{/g} \"We will place training camps nearby "
"the capital.\""
msgstr "{g|Military4_1}[선택 시 효과]{/g} \"수도 인근에 훈련소를 설치할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Answer_0012_Text
msgctxt "04c74f0b-a345-4adc-a636-b3440fc1b4d9"
msgid ""
"{g|Military4_2}[Choice effects]{/g} \"We will place the barracks at the "
"borders.\""
msgstr "{g|Military4_2}[선택 시 효과]{/g} \"국경에 막사를 배치할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Answer_0013_Text
msgctxt "17003113-cd72-49e3-9ae3-fcc0f1b16273"
msgid "\"They're your soldiers – it's your decision.\""
msgstr "\"너의 병사들이니, 너의 뜻대로 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "f3c63452-5638-4999-b8fa-0a00f3e94b9a"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}! I must inform you –"
" military affairs have begun to take up all of my time, and more than once I "
"have missed overlooked a detail concerning domestic security. Please, hire a "
"Warden – an advisor who will watch over the safety of your subjects, and I "
"shall continue to carrying out the responsibilities of your General.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}! 알려드려야 할 사실이 있습니다. 군사 문제가 제 모든 시간을 차지하기 시작했고, 국내 안보에 관한 "
"세부 사항을 놓친 적이 한두 번이 아닙니다. 부디 당신의 백성들의 안전을 지켜볼 새로운 감시관을 고용해 주십시오. 저는 당신의 "
"장군으로서의 직무를 계속해 나가겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0002_Text
#. Speaker : Capital_Kassil
msgctxt "04927cc9-a120-4d34-956a-c43f746bb23a"
msgid ""
"{n}Kassil turns his attention to the map of the {g|Stolen Lands}Stolen "
"Lands{/g}.{/n} \"New recruits keep coming, {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}. You must decide where their barracks is to be built."
"\""
msgstr ""
"{n}카실은 {g|Stolen Lands}도둑맞은 땅{/g}의 지도에 주의를 돌립니다.{/n} \"신병들이 오고 있습니다, "
"{mf|영주님|영주님|전하|전하}. 그들이 지낼 막사를 지을 장소를 결정하셔야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0003_Text
#. Speaker : Capital_Kassil
msgctxt "b8988faf-bf4e-42b4-a7f1-b83f0f7ba771"
msgid ""
"\"To my mind, it would be best to build both the barracks and their training "
"camps nearby, close to the capital. Many of these youths burn with "
"enthusiasm, but until it is tempered by discipline they will never be as "
"good in battle as they would hope to be. I recommend we create camps to "
"train and drill all those who would protect these lands in the future.\""
msgstr ""
"\"제 생각에는 수도 근처에 막사와 그들의 훈련소를 짓는 것이 가장 좋을 것 같습니다. 이 젊은이들 중 많은 이들이 열정에 불타고 "
"있지만, 규율로 누그러질 때까지는 자신이들 원하는 만큼 전투에서 능하지 못할 것입니다. 저는 우리가 미래에 이 땅을 보호할 모든 이들을 "
"훈련시킬 훈련소를 만들 것을 권합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0004_Text
#. Speaker : Amiri_Companion
msgctxt "daedddef-5cf7-4ade-82b8-76efb9e2845e"
msgid ""
"\"Listen to me, {name}. I didn't become your General to chase criminals and "
"hang bandits! I used to be able to deal with it along with everything else, "
"but now your army is big and I don't have any extra time for guard duty! You "
"need to hire a Warden to keep order on the streets!\""
msgstr ""
"\"내 말 좀 들어봐, {name}. 나는 범죄자들이나 쫓고 도적들을 처형하는 장군이 된 게 아냐! 예전에는 다른 일들도 처리할 여유가 "
"있었지만, 지금은 군대가 커져서 치안에 시간을 쏟을 여유가 없다고! 거리의 질서를 지키려면 감시관이 필요해!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0005_Text
#. Speaker : Amiri_Companion
msgctxt "04264c2f-d540-4eaa-882a-d00d5569c7f9"
msgid ""
"\"There's something else. Your soldiers are gonna have to start sleeping on "
"the ground outside. There are more and more soldiers, but there aren't no "
"more houses for them. Of course I'm all for teaching the new recruits how to "
"survive in any conditions, but these wimps will run away like babies if they "
"don't get beds.\""
msgstr ""
"\"다른 것이 있다. 병사들은 땅에서 잠을 자야 한다. 군인들이 더 많아지고 있지만, 그들을 위한 막사가 부족하다. 물론 난 신병들이 "
"어떤 상황에서도 살아남는 방법을 가르치는 것에는 전적으로 찬성하지만, 이 겁쟁이들은 침대를 주지 않으면 아기처럼 탈영할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0006_Text
#. Speaker : Amiri_Companion
msgctxt "92676d2e-df70-4933-ba1d-d6c768a8e39a"
msgid ""
"{n}Amiri grins.{/n} \"Here is what I think. If we have to build barracks for "
"them, let's do it on the border. Let them find their feet there – patrol the "
"area and catch some spies. And if someone attacks us – then good! A real "
"battle is better than any training. What do you say? Where do we put the "
"barracks?\""
msgstr ""
"{n}아미리가 웃습니다.{/n} \"내 생각은 이렇다. 그들의 막사를 국경에다 짓는 거다. 거기서 국경 수비도 하고 스파이도 잡는 거지. "
"그리고 누가 우리 국경을 넘어와 공격한다면? 진짜 전투는 어떤 훈련보다 효과적이지! 어떻게 생각해? 막사는 어디 건설할까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0007_Text
#. Speaker : Regongar_Companion
msgctxt "1ebf4522-0359-4485-848b-14fe9c8b8c4b"
msgid ""
"\"Listen, I'm tired of hearing about bandits and thieves! My job is managing "
"the army, not chasing pickpockets. Hire a Warden. Let him drill the guards "
"and make sure your subjects don't make too much trouble.\" {n}Regongar "
"shakes his head fiercely.{/n}"
msgstr ""
"\"들어봐. 도적이니 도둑이니, 그런 소리 이제 지긋지긋하다고! 내 일은 군대를 관리하는 거지, 소매치기 쫓는 게 아니야. 감시관 "
"하나 고용해. 경비병 훈련시키고, 백성들이 말썽 안 피우게 하라고.\" {n}레곤가르는 짜증스럽게 고개를 "
"세차게 젓습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0008_Text
#. Speaker : Regongar_Companion
msgctxt "da330ffa-8f9f-4101-b1f2-74a52191cb4e"
msgid ""
"\"Fine. So why did I come here? Ah right! I was thinking – your soldiers "
"need to sleep somewhere. It's time we build a barracks. I've brought a map – "
"can you show me where you want it?\""
msgstr ""
"\"좋아. 근데 내가 왜 여기 온 거였더라? 아, 맞다! 생각해봤는데, 네 병사들도 잘 곳이 필요하잖아. 이제 막사를 지을 때가 됐어. "
"지도를 가져왔는데, 어디다 지을지 정해줄래?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0009_Text
#. Speaker : Regongar_Companion
msgctxt "57b7fc26-001d-4cf9-913e-ca2b769fd4d9"
msgid ""
"{n}An unkind smile shows up on Regongar's face.{/n} \"Of course, I'd build "
"them right on the border. Your neighbors are restless, and we need to show "
"them we're serious. Some troops in their face is serious all right!\""
msgstr ""
"{n}레곤가르의 입가에 냉소가 어린 미소가 번집니다.{/n} \"물론이지. 난 국경 바로 옆에 막사를 지을 거야. 이웃 놈들이 요즘 들썩이고 있으니, "
"우리가 장난이 아니라는 걸 보여줘야지. 놈들 코앞에 병력 몇 줄 세워두면 그게 진짜 경고지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0014_Text
#. Speaker : Capital_Kassil
msgctxt "76e15589-b6f1-4d7e-9388-884f9b3e5e8f"
msgid ""
"{n}Kassil bows.{/n} \"I'm happy you'll give our soldiers a chance to train "
"before we send them into battle. I will take care of everything.\""
msgstr ""
"{n}카실이 경례합니다.{/n} \"전투에 투입하기 전에 우리 병사들에게 훈련할 기회를 주셔서 기쁘군요. 제가 알아서 처리하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0015_Text_String
#. Speaker : Amiri_Companion
msgctxt "f3d0fd03-9a72-467a-ad01-8901e01971af"
msgid ""
"{n}Amiri cringes.{/n} \"You southerners, all a bunch of spineless crybabies! "
"Pups should be sent to fight, not nursed!\""
msgstr "{n}아미리가 움찔합니다.{/n} \"이 줏대 없는 울보 남방인들아! 새끼는 절벽에서 떨어트려야지, 품어줘선 안된다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0016_Text_String
#. Speaker : Regongar_Companion
msgctxt "578af896-bdf0-48be-96ab-4f8fbccbc1cc"
msgid ""
"{n}Regongar growls, annoyed.{/n} \"Maybe we'll requisition some fluffy "
"blankets too? Soldiers should learn to fight the enemy, not beat up wooden "
"dummies!\""
msgstr ""
"{n}레곤가르가 짜증 내며 으르렁거립니다.{/n} \"복슬복슬한 담요도 몇 장 가져다줄까? 군인이라면 적과 싸우는 법을 배워야지, 나무 "
"쪼가리나 두들겨 패선 안된다고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0021_Text_String
#. Speaker : Capital_Kassil
msgctxt "ea614023-df6a-4f54-8e35-1304d9826553"
msgid ""
"\"But... you do understand you're sending untrained youths to their deaths. "
"The slightest border conflict, and they'll flee – if they don't die first!\" "
"{n}Kassil considers your words for a while.{/n} \"But of course, I can't "
"argue with you, {mf|Your Grace|Your Grace|Your Highness|Your Highness}.\""
msgstr ""
"\"하지만... 훈련받지 않은 젋은이들을 죽음으로 내몰고 있다는 걸 알고 계시잖습니까. 작은 국경 충돌에서도, 그들은 죽거나 도망칠 "
"겁니다!\" {n}카실은 잠시 동안 당신의 말을 곱씹습니다.{/n} \"하지만 물론, 전 당신께 이의를 제기할 수 없습니다, "
"{mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0022_Text
#. Speaker : Amiri_Companion
msgctxt "54bf7951-6ea5-4b6d-ba5a-ef8cb9b04099"
msgid ""
"\"That's more like it! Let them see first hand what it's like to be a "
"warrior!\""
msgstr "\"그게 더 그럴듯하군! 먼저 그들에게 전사가 되는 것이란 어떤 것인지 직접 보게 하자!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0023_Text
#. Speaker : Regongar_Companion
msgctxt "2ec69bd4-b0ba-4bc1-a43d-0f75c937fc98"
msgid "\"Great!\" {n}Regongar rubs his hands together impatiently.{/n}"
msgstr "\"훌륭해!\" {n}레곤가르는 조바심 내듯 두 손을 비빕니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0024_Text
#. Speaker : Capital_Kassil
msgctxt "f8073316-a684-4495-a1eb-1d03967b162d"
msgid ""
"\"Then I will order training camps built. Don't worry, I'll make sure the "
"new recruits learn everything as swiftly as possible.\""
msgstr ""
"\"그럼 전 훈련소 건설을 명하도록 하겠습니다. 걱정하지 마십시오. 신병들도 가능한 한 빨리 모든 것을 배울 수 있도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0025_Text
#. Speaker : Amiri_Companion
msgctxt "ab0e6ced-4f41-4162-8137-750f86035d2c"
msgid ""
"\"Then I will pick places on the border with the most trouble, and build our "
"barracks there.\""
msgstr "\"그럼 국경에서 가장 충돌이 잦은 곳을 골라 거기다가 막사를 짓도록 하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/Cue_0026_Text
#. Speaker : Regongar_Companion
msgctxt "732d1b04-8523-45d6-a999-a72e12988a29"
msgid ""
"\"Ha ha, this is going to be fun. The subjects of other countries won't be "
"running through our borders any more... Unless they want to make themselves "
"live targets!\""
msgstr ""
"\"하하, 그거 재미있을 거 같군. 다른 나라 놈들은 더 이상 우리 국경을 통과하지 못할 거야... 살아 있는 표적이 되고 싶지 않다면!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/KassilBYE_String
#. Speaker : Capital_Kassil
msgctxt "7963b516-1636-4fc4-bbbf-4bf2eded4859"
msgid ""
"{n}Kassil keeps silent, gathering his thoughts.{/n} \"{mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}. All this time I have struggled to serve "
"you in the best possible manner. But it seems our opinions on how to handle "
"the army are simply too different. It is best that I should leave this "
"position to someone else. I will do so immediately after I carry out your "
"final order.\" {n}Kassil bows.{/n}"
msgstr ""
"{n}카실은 침묵을 유지하며, 생각을 가다듬습니다.{/n} \"{mf|영주님|영주님|전하|전하}. 지금까지 저는 당신을 모시기 위해 "
"최선을 다해왔습니다. 하지만 군을 어떻게 다룰지에 대한 우리의 의견은 너무 다른 것 같습니다. 이 자리를 다른 사람에게 맡기는 것이 좋을 "
"것 같습니다. 일단 당신이 명하신 것을 마치고, 즉시 자리를 비우도록 하겠습니다.\" {n}카실이 경례합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank4/RegongarBYE_String
#. Speaker : Regongar_Companion
msgctxt "e51ee350-06c8-48cb-ae0c-2cf146add0ec"
msgid ""
"{n}Regongar sizes you up.{/n} \"As you wish. But it's the last order you'll "
"give me, {name}. I'm tired of these arguments. I need to find something more "
"interesting to do. And you... you need to find yourself a new General.\""
msgstr ""
"{n}레곤가르가 당신에게 평가를 내립니다.{/n} \"네 뜻대로 하지. 하지만 이게 내게 내리는 마지막 명령일 거야, {name}.난 "
"이런 논쟁에 지쳤어. 좀 더 재미있는 일을 찾아봐야겠어. 그리고 넌... 새 장군을 찾아봐야겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Answer_0004_Text
msgctxt "d44fb58d-b7bc-44fd-8246-795983967054"
msgid ""
"{g|Military5_1}[Choice effects]{/g} \"You must immediately prohibit this "
"home-made booze among our soldiers, and arrest any who brew it. We need "
"fighters, not drunken murderers.\""
msgstr ""
"{g|Military5_1}[선택 시 효과]{/g} \"즉시 우리 병사들 사이에서 이 밀주를 금지하고, 그것을 제조하는 자를 체포해라. "
"우리에게 필요한 이는 술 취한 살인자가 아니라, 전사다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Answer_0005_Text
msgctxt "ad68ad4d-a25f-43f7-b9af-ed8e288af109"
msgid ""
"{g|Military5_2}[Choice effects]{/g} \"I provide my soldiers with weapons and "
"ask them to kill. How they do it is their business. I won't make anyone "
"drink, but I'm not prohibiting these potions either.\""
msgstr ""
"{g|Military5_2}[선택 시 효과]{/g} \"무기를 쥔 병사들에게 약물을 공급한 뒤 버리고 싶은지 물어보겠다. 어떻게 하던지 "
"그들의 자유다. 모든 병사들이 그 약물을 마시도록 강요하진 않겠지만, 그것을 법으로 금하지도 않겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Answer_0006_Text
msgctxt "75fe32f3-585b-4452-a419-ee64b27b82d0"
msgid ""
"{g|Military5_3}[Choice effects]{/g} \"I like the idea of these potions. Let "
"every soldier drink them if they really help. Whatever they lack in power, "
"they'll make up for with this magic.\""
msgstr ""
"{g|Military5_3}[선택 시 효과]{/g} \"난 이 물약에 대한 아이디어가 마음에 드는데. 만약 정말로 도움이 된다면 모든 "
"군인들이 그걸 마시게끔 해라. 기운이 부족해지더라도, 이 마법으로 만회할 수 있겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Answer_0016_Text
msgctxt "5836b028-3739-4bf5-b199-b2fcc6aa60f5"
msgid "\"What is the potion's effect? Is it dangerous?\""
msgstr "\"포션의 효능은 어떻지? 위험한가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Answer_0017_Text
msgctxt "2bbb5e49-5292-4278-a143-a559f19ac456"
msgid "\"You're the commander. You decide.\""
msgstr "\"넌 사령관이다. 네가 결정하도록.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "6b19a637-cae3-4fde-bd5c-b0fea2e95345"
msgid ""
"{n}Kassil seems to be lost.{/n} \"{mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}! I need your opinion. I caught a new recruit brewing "
"dangerous potions for himself and the other soldiers. These potions turn "
"them into fierce fighters for a while, but they dangerously twist their "
"minds.\""
msgstr ""
"{n}카실의 눈빛이 갈 곳을 잃은 것 같습니다.{/n} \"{mf|영주님|영주님|전하|전하}! 당신의 의견이 필요합니다. 자신과 다른 "
"병사들을 위해 물약을 제조하는 신병을 잡았습니다. 이 물약을 마시면 잠시 동안 사나운 투사가 되지만, 그들의 정신을 위험하게 "
"뒤틀어놓습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0002_Text
#. Speaker : Capital_Kassil
msgctxt "4af8ca14-9c68-4dbf-b0b6-e7a6a137ac48"
msgid ""
"\"Instead of training and drilling, these lazy fools are relying on their "
"potions. Many have already tried it, and the others are surely curious. I've "
"arrested the cooks, but the officers are of a different opinion! They "
"believe the potions might be effective, though they're quite unpredictable.\""
msgstr ""
"\"훈련과 교육 대신, 이 게으른 바보들은 물약에 의존하고 있습니다. 많은 이들이 이미 그것을 마셨고, 그러지 않은 다른 이들도 "
"궁금해하고 있습니다. 제조사들은 이미 체포했지만, 장교들이 다른 의견을 제시하고 있습니다! 그들은 물약이 효과적일 수도 있다고 "
"얘기하지만, 그것은 예측할 수 없는 것들입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0007_Text
#. Speaker : Regongar_Companion
msgctxt "303f7d7b-38c2-43eb-a058-f6a98b4ebc45"
msgid ""
"{n}Regongar has a strange look in his eyes, and his speech is confused.{/n} "
"\"Ah well, how you doing, your chieftesty? You know, I've seen a miracle! "
"{g|Gorum}Gorum{/g} himself honored one of my commanders... with a gift! He "
"turns pathetic weaklings to fierce spawn of the {g|Abyss}Abyss{/g}, able to "
"defeat anyone with their bare hands! You know how?\""
msgstr ""
"{n}레곤가르의 눈에 이상한 기운이 감돌며, 그의 말은 혼란스럽습니다.{/n} \"아, 좀 어때, 족장님? 나 기적을 봤어! 내 지휘관 "
"중에 하나가 {g|Gorum}고룸{/g}에게 영예와 선물을 받았어! 약해빠진 약골을 사나운 {g|Abyss}심연{/g}의 자식으로 "
"바꿔놓더니, 맨손으로 누구든 다 때려눕힐 수 있게 됐다니까! 어떻게 된 건지 알아?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0008_Text
#. Speaker : Amiri_Companion
msgctxt "66668747-26ef-4eb7-901e-94e55fb7855b"
msgid ""
"{n}Amiri looks annoyed.{/n} \"So, chief, it's about our soldiers. The pups "
"are brewing magic potions of strength and bravery. It leaves no fear or "
"doubt in their heads, just fury like the howling wind.\""
msgstr ""
"{n}아미리는 짜증 나 보입니다.{/n} \"그러니까, 족장. 이거 우리 병사들 얘긴데, 새끼들이 힘과 용기를 주는 물약을 만들고 있어. "
"마시면 머리에서 두려움을 지워주고 울부짖는 바람 같은 분노만 남는다더군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0009_Text
#. Speaker : Regongar_Companion
msgctxt "815c270b-15ca-4299-835c-a3f85224b9c7"
msgid ""
"{n}Regongar laughs out loudly.{/n} \"Potions, he says! He got his fighters "
"drunk! And they're not what you'd call fighters... All he's got is weaklings "
"in his squad! But they all went like they were battle-crazy, fighting anyone "
"who steps in their way! Pure gold, that's what this potion is.\""
msgstr ""
"{n}레곤가르가 박장대소합니다.{/n} \"물약이래, 그가 그러더군! 그는 그의 전사들을 취하게 했어! 원래 걔들은 흔히 얘기하는 투사 "
"같은 게 아니었어... 그놈 부대원들은 죄다 약골이었다니까! 그런데 걔네가 전투에 미친놈처럼 자기 앞을 막는 건 죄다 부수면서 "
"나아갔다니까! 이 물약은 순수한 금 같은 물건이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0011_Text
#. Speaker : Capital_Kassil
msgctxt "22d82757-cb8a-48b4-ad80-a02038b5a61d"
msgid ""
"{n}Kassil opens his mouth to object, but stays silent. After a while, he "
"nods.{/n} \"I understand, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. Everyone is responsible for the power in their own hands. I will "
"pass down the values of the {g|Swordlords}Swordlords{/g} to as many fighters "
"as I can reach. Those who won't listen... Well, I feel sorry for them.\""
msgstr ""
"{n}카실은 반대 의사를 밝히면서도 침묵을 지키고 있습니다. 이내 고개를 들고 끄덕입니다.{/n} \"이해합니다, "
"{mf|영주님|영주님|전하|전하}. 모든 이들은 자신이 가진 권력에 대한 책임감을 가지지요. 전 최대한 많은 이들에게 "
"{g|Swordlords}소드로드{/g}의 가치를 가르치겠습니다. 듣지 않는 이들에겐... 그저 불쌍할 뿐입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0012_Text_String
#. Speaker : Capital_Kassil
msgctxt "53ce04aa-bcda-48b3-bb08-248a980cbd3a"
msgid ""
"{n}Kassil bites his lip subtly, clenching his fists less so.{/n} \"So, you "
"don't trust me. I'm sorry. I...\" {n}His last words are muffled, and he "
"exhales forcefully.{/n} \"I've been sent to serve and assist you. I shall do "
"as you say.\""
msgstr ""
"{n}카실은 주먹을 살짝 쥐며 미묘하게 입술을 깨뭅니다.{/n} \"그러니까, 절 믿지 않으시는 거군요. 죄송합니다, 전...\" {n}"
"그의 마지막 말이 멈춰지고, 크게 한숨을 뱉습니다.{/n} \"전 당신께 봉사하고 도움을 드리기 위해 파견되었습니다. 당신의 뜻을 "
"받들겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0013_Text
#. Speaker : Amiri_Companion
msgctxt "44eb3ae1-c882-4a9b-a255-b437ae6436a7"
msgid ""
"\"I mean... Back in our tribe we used it some. But mostly it's for lazy "
"bones and weaklings. A real fighter like me doesn't need that stuff. I wish "
"there was more like me in your army. I would let them do what they want – "
"and the potions do make them look like real soldiers. But I decided to ask "
"you what you want.\""
msgstr ""
"\"내 말은... 예전에 우리 부족에서도 그런 걸 썼었어. 하지만 그런 건 대부분 게으른 놈들과 약골들을 위한 물건이었지. 나 같은 진짜 "
"전사는 그런 게 필요 없다고. 네 군대에도 나 같은 사람이 더 많았으면 좋겠어. 그들이 원하는 것을 하게 해줄게. 물약은 그들을 진짜 "
"군인처럼 보이게 하지. 그래도 난 네가 뭘 원하는지 물어보고 싶었어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0014_Text
#. Speaker : Capital_Kassil
msgctxt "f68664b1-d84e-4799-bfef-4a931131dd95"
msgid ""
"\"The {g|Swordlords}Swordlords{/g} taught me to rely on myself and my skills "
"– which were forged by sacrifice and struggle, not by drinking some potion. "
"But you're not Aldori. You have every right to establish your own order. "
"Must I bow to the officers' will, or will you trust me?\" {n}Kassil peers at "
"you, sweat running down his temple.{/n}"
msgstr ""
"\"{g|Swordlords}소드로드{/g}는 물약이 아닌 희생과 전투로 다져진 나 자신과 기술에 의지하라고 가르쳤습니다. 하지만 당신은 "
"알도리가 아니지요. 당신은 당신만의 질서를 확립할 충분한 권리가 있습니다. 장교들의 뜻에 따르실 겁니까, 아니면 저를 믿어 주실 겁니까?"
"\" {n}카실은 당신을 보며, 초조한 듯 식은땀을 흘립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0018_Text
#. Speaker : Amiri_Companion
msgctxt "e4d2cbf3-a700-43f0-8e8a-29c6d0098da0"
msgid ""
"{n}Amiri looks at you ironically.{/n} \"You southerners have strange ways, "
"you know. I don't know whether you're their chief or their nanny, {name}. "
"Are they adults with weapons and deadly skills, or naughty children you tell "
"little rules. I still don't understand your ways here in the South, but I'll "
"do what you told me to.\""
msgstr ""
"{n}아미리는 아이러니한 듯 당신을 바라봅니다{/n} \"남방인들은 이상한 방법을 가지고 있어. 있잖아. 난 네가 그들의 족장인지 "
"보모인지 잘 모르겠어, {name}. 그들은 치명적인 기술을 가진 성인들이야, 아니면 철부지 애들이야? 남방인인 네 방식을 아직 "
"이해하지는 못하겠지만, 일단 시키는 대로 할게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0019_Text_String
#. Speaker : Regongar_Companion
msgctxt "51819301-22f4-4506-ba75-4077929b9382"
msgid ""
"\"Do you realize how lucky you are? An army like this can conquer all the {g|"
"Stolen Lands}Stolen Lands{/g}! They're finally real soldiers! They've got "
"only one destination – to the other world, and in the prime of their lives! "
"May every one of them cut your path with their blood. And may this path lead "
"to something... really great.\""
msgstr ""
"\"네가 얼마나 행운아인지 알아? 이런 군대는 {g|Stolen Lands}도둑맞은 땅{/g} 전역을 정복할 수 있다고! 이제야 진짜 "
"군인이 됐구만! 그들은 오직 한 가지 목적만을 가질 거야. 인생의 전성기에, 다른 세계로 가자! 그들 모두가 피로 너의 길을 개척했으면 "
"좋겠네. 그리고 그 길이 무언가로 이어지길 바라... 정말로 훌륭해\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0020_Text
#. Speaker : Amiri_Companion
msgctxt "577ddd66-4e67-44af-9ea3-fb234c83462c"
msgid ""
"\"That is right. Fighters must be responsible for themselves. Otherwise it's "
"not a fighter, but just a bug wearing armor. If the potion is good for them, "
"maybe it'll help them live. If not, then it's their own fault they died.\""
msgstr ""
"\"그건 맞아. 전사들은 스스로를 책임져야지. 그렇지 않으면 전사가 아니라 그냥 갑옷 입은 벌레일 뿐이야. 만약 물약이 그들에게 좋은 "
"거라면, 그들의 삶 전체에 도움이 되겠지. 그렇지 않고 죽어버리면, 그건 그냥 자기 자신의 잘못일 뿐이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0021_Text
#. Speaker : Regongar_Companion
msgctxt "1a02408b-7ca8-4b74-9b2e-e635758bc461"
msgid ""
"{n}Regongar looks at you with respect.{/n} \"Protecting your reputation, eh? "
"Very wise. We don't want the neighbors spreading rumors that you're doping "
"your fighters. I'll take care of everything myself. You'll have nothing to "
"do with it. You are a deep thinker, {name}.\""
msgstr ""
"{n}레곤가르가 존경의 눈으로 당신을 바라봅니다.{/n} \"네 평판을 지키는 거야? 현명하기 그지없네. 우린 이웃들이 네가 전사들에게 "
"약을 먹이고 있다는 소문이 퍼지는 걸 원치 않잖아. 내가 다 알아서 할게. 넌 아무 상관도 없을 거야. {name}, 넌 신중한 "
"사람이잖아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0022_Text
#. Speaker : Amiri_Companion
msgctxt "3b174c3c-d988-434a-b2b6-13d1a96466be"
msgid ""
"{n}Amiri frowns.{/n} \"I'm not drinking this stuff. I decide for myself how "
"I kill my enemies. But you're the chief. Your word is the law for the others."
"\""
msgstr ""
"{n}아미리가 얼굴을 찌푸립니다.{/n} \"난 이딴 거 안 마셔. 적을 죽이는 방법은 스스로 결정해. 하지만 네가 족장이잖아. 네 말은 "
"다른 이들에게 법이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0023_Text
#. Speaker : Regongar_Companion
msgctxt "9ec13be3-e59c-4650-ac2f-ba5722768dac"
msgid ""
"\"Starting tomorrow, we'll have potion production in every camp. It'll turn "
"your weaklings into real head hunters. Just point them at the battle and "
"stay out of their way!\""
msgstr ""
"\"내일부터 모든 병영에서 물약이 생산될 거야. 이건 약골을 진짜 사냥꾼으로 만들어 줄 거야! 전투에서 적들을 겨누고 해치워 버릴 테지!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0024_Text
#. Speaker : Capital_Kassil
msgctxt "14118d74-48a3-4d31-bd5d-87c11c3fa465"
msgid ""
"\"The stuff makes your arms stronger and you vision clearer, but it clouds "
"your mind. It befits a savage – a goblin or a bandit – but not a fighter who "
"goes to battle with a cool head.\""
msgstr ""
"\"이건 당신의 힘을 더 강하게 하고 더 선명히 볼 수 있게 하지만, 당신의 마음을 어지럽힙니다. 고블린들이나 도적 놈들한테는 "
"어울리지만, 냉철한 정신으로 전투에 나서는 전사에게는 어울리지 않습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0025_Text
#. Speaker : Amiri_Companion
msgctxt "1926d8b5-662a-484f-958a-2593daafffb8"
msgid ""
"\"It makes you mad. Makes you want to fight. And it makes you strong as a "
"bear. And there's something else...\" {n}Amiri frowns and waves her hand.{/n}"
" \"Oh, never mind about that.\""
msgstr ""
"\"이건 널 화나게 해. 투쟁심을 불러 일으키지. 그리고 곰 같은 힘도 주고. 또 다른 효과가 있는데...\" {n}아미리는 얼굴을 "
"찡그리며 손사래를 칩니다.{/n} \"뭐, 이건 신경 쓰지 마.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0026_Text
#. Speaker : Regongar_Companion
msgctxt "659ba4a9-c6d5-45ef-9d66-c82d16ecf3e2"
msgid ""
"{n}Regongar's eyes grow dead. The half-orc looks away from you.{/n} \"The "
"quietest time is just before the thunderstorm... And then... drip, drop... "
"plip, plop... And then it bursts! And flashes! Your soul groans, and "
"whizzes, the wind howls, and the thunder strikes!\" {n}Regongar licks his "
"dry lips. He seems unaware of the electricity arcing between his fingers.{/n}"
" \"And you are the storm! No one can stop you. That's how it works. I tried "
"it. I know what I'm talking about.\""
msgstr ""
"{n}레곤가르의 눈이 점점 시들어 갑니다. 하프 오크의 눈은 당신 너머를 보고 있습니다{/n} \"원래 폭풍전야가 가장 고요한 "
"법이지... 그리고 점점... 비가 추적, 추적... 퐁당, 퐁당... 그리고 터져버리지! 번쩍거리고! 네 영혼이 신음하고, 쌩하며 "
"바람이 울부짖고, 천둥이 치지!\" {n}레곤가르는 마른 입술을 핥습니다. 자기 손가락 사이에 전기가 흐르고 있다는 걸 모르는 "
"듯합니다{/n} \"그리고 넌 폭풍우야! 아무도 널 막을 수 없지. 그게 폭풍이라고. 난 해봤어. 내가 말하는 게 뭔지 알아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0028_Text
#. Speaker : Amiri_Companion
msgctxt "ff732643-b99b-4fd7-a499-1a4d5a6e04e0"
msgid ""
"{n}Amiri's gaze is incinerating.{/n} \"I want to stay out of it. I'm their "
"commander, not their nanny. Let them drink whatever they want to as long as "
"they're ready to fight.\""
msgstr ""
"{n}아미리의 시선이 거두어집니다.{/n} \"난 그거 상관 안 할래. 난 그놈들 지휘관이지 보모가 아니라고. 싸울 준비만 된다면 "
"자기들이 원하는 건 뭐든 마시라 그래.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0033_Text
#. Speaker : Regongar_Companion
msgctxt "1edc2fd2-49f8-43a7-8682-2e9995408c60"
msgid ""
"{n}Regongar's mania suddenly fades. He speaks quietly.{/n} \"I've been "
"thinking... Let's make all our fighters take these potions. Then you'll have "
"an army of real cutthroats. They won't care about death, pain, fear, or "
"really have any feelings at all. They'll kill without hesitation. Burn "
"villages to the ground without a second thought. What do you say?\""
msgstr ""
"{n}레곤가르의 흥분이 갑자기 사라집니다. 그는 조용히 얘기합니다.{/n} \"생각해봤는데... 우리 전사들한테 이 물약 먹이자. 그러면 "
"진짜 도살자 군단이 생길 거야. 죽음, 고통, 두려움, 그 어떤 감정도 느끼지 않게 될 거야. 망설임 없이 사람을 도륙하고 마을을 "
"잿더미로 만들겠지. 어떻게 생각해?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank5/Cue_0042_Text
#. Speaker : Capital_Kassil
msgctxt "2202e113-0d1a-4cfd-a03b-3fa89a20ad61"
msgid ""
"\"I appreciate your trust, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}.\" {n}Kassil pauses, and then continues in an earnest tone.{/n} \"I"
" am glad that you've taken my views to heart. The potions will be prohibited "
"as of today. Any who produce them will be punished.\""
msgstr ""
"\"절 믿어주셔서 감사합니다, {mf|영주님|영주님|전하|전하}.\" {n}카실은 잠시 멈추고, 진지한 어조로 계속 이어나갑니다.{/n} "
"\"제 견해를 받아들여 주시다니 기쁩니다. 오늘부터 물약은 금지될 것입니다. 그것을 생산하는 이는 누구든지 처벌받을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Answer_0005_Text
msgctxt "d90b0f66-ade2-4046-bb35-5b56cd31adef"
msgid ""
"{g|Military6_1}[Choice effects]{/g} \"We don't leave our men behind. Let "
"them climb into the angry mountains, if they're so brave.\""
msgstr ""
"{g|Military6_1}[선택 시 효과]{/g} \"우리는 우리의 사람들을 버리지 않는다. 그들에게 용기가 있다면, 성난 산을 "
"오르라고 명해라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Answer_0006_Text
msgctxt "af0e8d76-85a0-4dbe-91bb-d3c068a4e581"
msgid ""
"{g|Military6_2}[Choice effects]{/g} \"It's dangerous and foolish. I'm not "
"risking more fighters for the sake of a few others.\""
msgstr ""
"{g|Military6_2}[선택 시 효과]{/g} \"이건 위험하고 어리석은 일이다. 몇 명 때문에 더 많은 전사들을 위험에 빠뜨릴 "
"수는 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Answer_0007_Text
msgctxt "6383d275-9815-46d4-99e9-b6df5bed0f42"
msgid ""
"\"You are the General. They're your soldiers. I'm expecting you to decide.\""
msgstr "\"넌 장군이다. 그들은 너의 병사이지. 네가 결정하도록 해라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "7be4f4a7-eb5c-43f8-bf96-09463ae255c9"
msgid ""
"{n}Kassil is agitated. He's in a hurry, and his voice trembles.{/n} \"{mf|"
"Your Grace|Your Grace|Your Highness|Your Highness}! A border patrol is "
"trapped under an avalanche in the Eastern mountains. We don't know whether "
"they're still alive, but hope fades with every passing second. They won't "
"survive for long without our help. We have many volunteers among our "
"soldiers, ready to go into the mountains and save them.\""
msgstr ""
"{n}카실이 동요하고 있습니다. 다급해하며, 목소리가 떨립니다.{/n} \"{mf|영주님|영주님|전하|전하}! 동쪽 산맥에서 눈사태로 "
"인해 국경순찰대가 고립되었습니다. 아직 그들이 살아있는지는 알 수 없지만, 시간이 지날수록 희망은 사라질 겁니다. 우리의 도움 없이 오래 "
"버틸 수 없을 겁니다! 우리 군인들 중에 그들을 구할 준비가 되어 있는 많은 자원자들이 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Cue_0002_Text
#. Speaker : Amiri_Companion
msgctxt "680bc42c-93dd-4cc0-8c9e-72fa260dbcfd"
msgid ""
"\"There's been an accident, {name}. A border patrol got buried under an "
"avalanche in the Eastern mountains. They're trapped, and they won't survive. "
"Some of our other soldiers want to go rescue their friends, but the "
"mountains are still angry. The earth is rumbling, and the stones are moving. "
"I can hear it even from here.\""
msgstr ""
"\"사고가 발생했어, {name}. 동쪽 산악지대에서 눈사태로 인해 국경 순찰대가 매몰됐어. 그들은 고립됐고, 살아남지 못할 거야. 다른 "
"병사들이 그들을 구하겠다 자원했지만, 여전히 산의 분노가 끝나지 않은 것 같아. 땅이 울리고 돌멩이가 움직이고 있어. 여기서도 들을 수 "
"있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Cue_0003_Text
#. Speaker : Regongar_Companion
msgctxt "ad739c38-d6b6-470b-a0f5-457faa8543c0"
msgid ""
"{n}Regongar looks gloomy.{/n} \"{name}, we need to talk. A border patrol got "
"buried under an avalanche in the Eastern mountains. They're probably all "
"dead. Not a great loss. They weren't be the first to die, and they won't be "
"the last. But there's a number of troops volunteering to go rescue them.\""
msgstr ""
"{n}레곤가르는 침울해 보입니다.{/n} \"{name}, 얘기가 필요해. 동부 산악지대에서 눈사태가 발생해서 국경순찰대가 매몰됐어. "
"아마 그들은 모두 죽었을 거야. 다만 큰 손실은 아닌 듯해. 어차피 그들이 첫 사상자도 아니고, 마지막도 아니겠지. 하지만 이들을 "
"구조하겠다 자원하는 병력들이 속출하고 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Cue_0008_Text
#. Speaker : Capital_Kassil
msgctxt "a81f21c9-8615-4c6b-b75f-add92c587df3"
msgid ""
"\"We'll rescue them, no matter what it takes! You won't be sorry. Your "
"soldiers will gladly give their lives for a general who is loyal and "
"reliable!\""
msgstr ""
"\"무슨 일이 있어도 구출하겠습니다! 후회하지 않으실 겁니다. 충성스럽고 믿음직스러운 장군을 위해 당신의 병사들은 기꺼이 목숨을 바칠 "
"것입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Cue_0009_Text_String
#. Speaker : Amiri_Companion
msgctxt "68176fbb-017d-45ed-b3db-7e4ce9afb159"
msgid ""
"{n}Amiri spits.{/n} \"Only fools challenge mountains. This is a dumb lesson "
"to teach, chief.\""
msgstr "{n}아미리는 침을 뱉습니다.{/n} \"바보들만이 산에 도전하지. 이건 멍청한 가르침이야. 족장.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Cue_0010_Text_String
#. Speaker : Regongar_Companion
msgctxt "ada138d2-96bc-48f2-ac8b-5431bae00e42"
msgid ""
"\"Pfff! They're probably dead already! It takes so much work to raise a good "
"fighter – and now we have to sacrifice them like this? When these volunteers "
"go missing, who's going to find them? Me or you?\""
msgstr ""
"\"허 참, 걔네는 벌써 죽었을 거라니까! 훌륭한 전사를 키워내려면 얼마나 많은 노력이 필요한데, 이렇게 더 많은 전사들을 희생해야 해? "
"이 자원자들이 실종되면 누가 찾을건데, 나? 아니면 너?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Cue_0011_Text_String
#. Speaker : Capital_Kassil
msgctxt "a6b4bb9b-f75f-4eb9-acc5-b93fda69ec1d"
msgid ""
"{n}Kassil's face darkens. He tries to show respect, but his lips curl, and "
"his fangs slip out.{/n} \"I will not dare dispute the order, {mf|Your Grace|"
"Your Grace|Your Highness|Your Highness}. But I fear that every soldier will "
"know henceforth that if he's in trouble, he's on his own. This shall "
"doubtless undermine their loyalty.\""
msgstr ""
"{n}카실의 얼굴이 어두워집니다. 존중을 갖추려 하지만 입술을 깨물고 송곳니가 드러납니다.{/n} \"당신의 명령에 감히 이의를 제기하지 "
"않겠습니다, {mf|영주님|영주님|전하|전하}. 하지만 저는 모든 군인들이 자신이 곤경에 처했을 때 오직 자기 혼자 책임지게 된다는 것을 "
"알게 될까 두렵습니다. 이것은 의심할 여지없이 그들의 사기를 떨어트릴 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Cue_0012_Text
#. Speaker : Amiri_Companion
msgctxt "1787ce9f-018d-4d72-913a-3e6b1ecdf429"
msgid ""
"{n}Amiri nods solemnly.{/n} \"You are wise. Their destiny is already set. "
"We'll raise a toast to them and remember them forever. The same for the ones "
"that die tomorrow.\""
msgstr ""
"{n}아미리가 진지하게 고개를 끄덕입니다.{/n} \"현명하군. 그들의 운명은 이미 정해졌어. 우리는 그들을 위해 술잔을 기울이고 영원히 "
"기억해야 할 뿐이야. 그건 언제 죽는 이들이 됐건 마찬가지고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Cue_0013_Text
#. Speaker : Regongar_Companion
msgctxt "a78af15c-52c6-4577-8e89-1ff4e46253f3"
msgid ""
"\"In fact, it's for the better. It will make our fighters angry – and "
"they're supposed to be angry! They need to get used to the fact that "
"military service is cruel. It chews up the noble and merciful sentiments.\""
msgstr ""
"\"분명, 이게 더 나은 방향인걸. 이건 우리 전사들을 화나게 하겠지. 분명 화날 거야! 하지만 그들은 군인으로서의 삶은 잔인하다는 "
"사실에 익숙해져야만 해. 그것은 고귀하고 자비로운 정서 따위는 씹어먹어 버리지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Cue_0016_Text
#. Speaker : Regongar_Companion
msgctxt "49496a1b-e40a-4de7-8ff3-c539e5b850b0"
msgid ""
"{n}Regongar grins.{/n} \"Ah, I don't care. Let them think of me however they "
"want! There will be no rescue missions. We're not going back. No one is "
"getting rescued today.\""
msgstr ""
"{n}레곤가르는 웃습니다.{/n} \"아, 상관없어. 자기들 마음대로 생각하라 그래. 구조 임무는 없을 테니까. 우리는 그곳으로 가지 "
"않을 거야. 오늘은 아무도 구조되지 않는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Cue_0018_Text
#. Speaker : Amiri_Companion
msgctxt "5106fce5-6ce3-422b-9e6a-27c03e81fd7f"
msgid ""
"{n}Amiri shrugs coldly.{/n} \"We Kellids appreciate a helping hand. But when "
"the mountains are angry, you should flee. When someone finds bad luck in the "
"mountains, they cannot be saved. They belong to the spirits. Mess with the "
"mountains and you'll die. Unless you want to bury your whole army under new "
"avalanches, just forbid the rescue mission.\""
msgstr ""
"{n}아미리는 냉담하게 어깨를 으쓱합니다.{/n} \"우리 켈리드는 도움의 손길에는 감사해하지. 하지만 산이 화가 났을 땐 도망쳐야만 "
"해. 누가 불운하게 산에 갇히면, 아무도 구원해 줄 수 없지. 그렇게 영혼이 되는 거야. 아수라장이 된 산과 함께 넌 죽는 거지. 전 "
"병력을 새로운 눈사태 속에 파묻고 싶지 않다면, 구조 임무를 금지해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Cue_0019_Text
#. Speaker : Regongar_Companion
msgctxt "44168a08-a23d-4095-ae6f-2653f3db1532"
msgid ""
"\"The first avalanche is never the last. We'll risk losing half the army up "
"there. It's just not worth it. But if I say we're not going to the "
"mountains, they won't learn anything. They'll just take me for a heartless "
"bastard. That's why I'd rather you to give the order to cancel the mission. "
"It's got to be you, the chief.\""
msgstr ""
"\"눈사태는 절대 한 번으로 끝나지 않는다고. 군대의 절반을 잃을 수도 있어. 이건 정말 그럴 만한 가치가 없는 일이야. 하지만 우리가 "
"산에 가지 않는다면, 아무 일도 없겠지. 그저 날 비정한 놈으로 생각하고 말 거라고. 그러니까 임무를 취소하라는 명령을 내려줘, 대장.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank6/Cue_0022_Text
#. Speaker : Capital_Kassil
msgctxt "f530f823-5ea7-4208-94f1-ad14da73213d"
msgid ""
"\"The mountains are restless. New avalanches are possible. They could bury "
"the search parties as well. But our volunteers don't care about the risks. "
"It isn't wise, but it's very brave of them. We shouldn't leave our people "
"behind. As a fighter, I support them. But as your General, I must receive "
"your permission before engaging upon such a dangerous mission.\""
msgstr ""
"\"산맥이 불안정합니다. 새로운 눈사태가 발생해서 수색대원 조차 조난될 수 있습니다. 하지만 우리 자원자들은 위험 따위 개의치 않습니다. "
"현명하다고 할 수는 없지만, 매우 용감하지요. 우리 사람들을 버려서는 안됩니다. 저는 전사로서 이들을 지지합니다. 하지만 장군으로서 그런 "
"위험한 임무를 수행하기 전에 당신의 허락을 받아야만 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Answer_0004_Text_1
msgctxt "521ebb4b-7f9e-40a2-a3a6-4d453b189fa2"
msgid ""
"{g|Military7_1}[Choice effects]{/g} [Pay 250 BP] \"My subjects have spilled "
"enough blood. We have plenty of gold to hire mercenaries.\""
msgstr ""
"{g|Military7_1}[선택 시 효과]{/g} [250 BP 지불] \"내 백성들은 이미 충분히 피를 흘렸다. 우린 용병을 "
"고용하기에 충분한 금을 가지고 있다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Answer_0005_Text_1
msgctxt "0205b98a-c003-4f4b-b8e0-79eb1f8d5fad"
msgid ""
"{g|Military7_2}[Choice effects]{/g} \"I don't trust the mercenary army. "
"They've got nothing to lose in the defeat. Let us begin a period of "
"mandatory military service.\""
msgstr ""
"{g|Military7_2}[선택 시 효과]{/g} \"나는 용병을 믿지 않는다. 그들은 패배에서 잃을 것이 없지. 병역 의무제를 "
"시행하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Answer_0006_Text_1
msgctxt "e1cadf0a-80ae-4372-b3d1-275faee5858e"
msgid ""
"{g|Military7_3}[Choice effects]{/g} \"We've just defeated the barbarians "
"from the North! No other enemy will dare challenge us. Let's just leave "
"everything as it is.\""
msgstr ""
"{g|Military7_3}[선택 시 효과]{/g} \"우리는 북방의 야만인조차 물리쳤다! 다른 적들은 감히 우리에게 도전하지 못할 "
"테지. 그냥 이대로 유지하도록 한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Answer_0007_Text_1
msgctxt "22f2c8d0-ff90-4f38-aa58-30b06ffc54a7"
msgid "\"You are my General. I trust your judgment.\""
msgstr "\"넌 나의 장군이다. 네 판단을 믿도록 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0001_Text_1
#. Speaker : Amiri_Companion
msgctxt "af4edd3a-121d-4285-9422-e10ee2e72a30"
msgid ""
"\"Chief, I've got a concern. We had a good battle with {g|Numeria}Numeria{/g}"
". Our soldiers fought and died as brave as the Kellids. Our glory is great. "
"Like everybody knows, the best way to get glory is to defeat someone who "
"already has it.\""
msgstr ""
"\"족장, 고민이 있다. 우린 {g|Numeria}누메리아{/g}와 좋은 싸움을 했다. 우리 병사들은 켈리드처럼 용감하게 싸우다 죽었다. "
"대단한 영광이지. 모두가 알다시피, 영광을 얻는 가장 좋은 방법은 이미 영광을 가진 이를 이기는 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0002_Text_1
#. Speaker : Regongar_Companion
msgctxt "caf83097-3876-40c1-9662-8446bbc5358f"
msgid ""
"\"{name}, here's the thing. We whipped {g|Numeria}Numeria{/g} into line, and "
"made a good show of it. But we lost a lot of soldiers along the way. Our "
"good neighbors must all be imagining how they'll to divide our territories "
"between them... That's what I'd be doing in their position. We have to renew "
"our ranks before it's too late.\""
msgstr ""
"\"{name}, 얘기할 게 있어. 우린 {g|Numeria}누메리아{/g}놈들을 일렬로 세워놓고 채찍질하는 좋은 쇼를 펼쳤지. 하지만 "
"그 와중에 많은 병사를 잃었어. 우리 착한 이웃들은 우리 영토를 어떻게 갈라 먹을지 상상하고 있을 거야.... 그게 바로 대비해야 할 "
"일이지. 더 늦기 전에 재정비해야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0009_Text_String
#. Speaker : Amiri_Companion
msgctxt "6b7dc6c5-8290-4f1a-9c05-f6bc858307e2"
msgid ""
"{n}Amiri snorts.{/n} \"Only cowards and traders put their hopes in "
"mercenaries. You never know when they'll decide to run for their lives, and "
"leave you holding their gold. I'd have to stand behind the lines, to kill "
"the ones who prefer desertion to fighting.\""
msgstr ""
"{n}아미리는 코웃음 칩니다.{/n} \"겁쟁이와 상인만이 용병에게 의지하지. 그들이 언제 자기 목숨을 위해 도망 칠지, 과연 네 금을 "
"가만히 둘지 결코 알 수 없어. 싸움보다 도망을 좋아하는 놈들을 죽이기 위해서라도 난 대열 뒤에 서야 할 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0010_Text
#. Speaker : Regongar_Companion
msgctxt "e1eb9e59-d49b-4df7-984f-3eb5cf973ea1"
msgid ""
"\"I'll strike a bargain with the mercenaries. I'd have joined them if I "
"hadn't become your General. Loads of weapons, pockets full of gold, and no "
"trace of remorse. That's my kind of party.\""
msgstr ""
"\"용병들과 흥정해볼게. 내가 장군이 아니었다면 나도 용병이 됐을 거야. 무기도 많고, 금으로 가득 찬 주머니도 얻고, 양심의 가책도 "
"필요 없지. 걔넨 딱 나 같은 놈들이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0011_Text
#. Speaker : Amiri_Companion
msgctxt "2e3473df-44a2-4a83-a908-ad2c0bd62661"
msgid ""
"\"Your subjects are confident there will always be someone to protect them. "
"Someone like me. I'll explain to all the craven idiots what's going to "
"happen if the Kellids reach your kingdom and aren't met with an army.\""
msgstr ""
"\"백성들은 자신을 보호해 줄 누군가가 항상 있을거라고 생각하지. 나 같은 사람 말이야. 켈리드가 왕국에 도착했을 때 군대가 없다면 "
"어떻게 될지 이 비겁한 놈들한테 설명해볼게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0012_Text_String
#. Speaker : Regongar_Companion
msgctxt "0cf75cab-e7f2-4604-beb9-11dc2e4a4fb7"
msgid ""
"\"That's a crazy idea. When your new 'soldiers' get homesick enough to put "
"you on the rack, don't cry for my help.\""
msgstr "\"그건 미친 생각이야. 네 새로운 '병사'들이 널 교수대에 세울 만큼 향수병에 걸려도, 내 도움을 바라지는 마.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0013_Text_String
#. Speaker : Amiri_Companion
msgctxt "384e2096-f3d7-43e3-90ec-f5a2e28b7470"
msgid ""
"{n}Amiri looks at you in astonishment.{/n} \"Are you out of your mind? "
"Without an army, this is not your land. This is nobody's land. If you don't "
"care about guarding it, then why don't you just dismiss all the rest of the "
"army too? Could an idea be any more stupid?!\""
msgstr ""
"{n}아미리는 눈을 크게 뜬 채 당신을 바라봅니다.{/n} \"정신 나갔어? 군대 없이는, 네 영지도 없는 거야. 그들을 지킬 생각이 "
"없다면, 나머지 군대도 해산하는 게 어때? 이것 만큼 바보 같은 생각이 있을 것 같아?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0014_Text_String
#. Speaker : Regongar_Companion
msgctxt "a0ec1b4f-aca2-4c20-ba2b-ac29a5475fd4"
msgid ""
"\"Sure, you defeated the barbarians – but now what? If your neighbors sent "
"an army right now, your military glory would be in the can!\""
msgstr ""
"\"물론, 넌 바바리안들을 물리쳤지. 그런데 이제 어떡하지? 만약 주변국들이 군대를 보내서 널 공격하면, 네 군대의 영광은 깡통 속에 "
"있을 거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0019_Text
#. Speaker : Amiri_Companion
msgctxt "ea02fd76-ec6f-4baf-abf8-5011be7ffc71"
msgid ""
"\"You need a bigger army. There are many mercenaries in the city, trying to "
"sell their skills. I don't trust them. They fight for their purse, not for "
"their general. If the enemy bribes them, they'll stab us in the back. Then "
"there's just more for us to execute. It's best if you draft the locals "
"instead. They won't be very happy about it, after all that's happened, but "
"let your people have to learn to stand up for their own land!\""
msgstr ""
"\"더 큰 군대가 필요해. 도시에는 많은 용병들이 자신의 기술을 팔고자 하지. 하지만 나는 그놈들을 믿지 않아. 그놈들은 장군이 아닌 "
"자신의 지갑을 위해 싸우니까. 적이 더 큰돈을 주면 우리 등을 찌를걸? 대신 생각할 수 있는 방법이 있지. 주민들 중에서 신병을 뽑는 "
"거야. 당연히 주민들은 별로 안 좋아하겠지. 하지만 백성들은 자기 땅을 위해 싸우는 법을 배워야 해!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0020_Text
#. Speaker : Regongar_Companion
msgctxt "a08f99e8-5870-499b-a28b-857dec76be70"
msgid ""
"\"You could call up the local citizens. However, all the volunteers are "
"either already recruited or six feet under ground. That means we either take "
"in the weaklings or we do it by force. We'll train them to kill, and then "
"one fine morning they'll take a blade in the heart. Not a bright future, eh? "
"It's best to pay the mercenaries. That bunch of daredevils is dreaming of "
"fighting for a warchief like you! And these guys are tough and dangerous "
"men, not some untrained farmhands.\""
msgstr ""
"\"주민들을 소집할 수도 있다. 하지만 지원자는 이미 소집된 상태거나 죽어서 땅에 묻혀있는 상태야. 이 말인즉슨 약한 놈들을 소집하거나 "
"무력으로 강제해야 한다는 말이지. 우리가 놈들을 잘 훈련시키면 어엿한 군인이 되어있을 거다. 언젠가는 말이지. 별로 밝진 않은 미래지 "
"않나? 그냥 용병들을 고용하는 게 낫다. 그 멧돼지 같은 놈들은 너 같은 지도자 밑에서 싸우고 싶어하니까! 게다가 이놈들은 강하고 거친 "
"놈들이다. 훈련받지도 못한 농부랑은 다르지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0029_Text
#. Speaker : Capital_Kassil
msgctxt "8cab1b33-003d-4463-8af5-70ff9349aec1"
msgid ""
"\"I have alarming news, your Highness. I've just audited the officers' "
"reports, and I have to admit: the war with the Kellids cost us dearly. It "
"was a glorious victory, but we lost many lives. Our losses must be "
"replenished, but with who? A general mobilization would end with a mob of "
"angry peasants in the ranks. Every volunteer has already joined. I guess "
"we'll be looking at forced conscription.\""
msgstr ""
"\"걱정스런 소식이 있습니다, 전하. 장교들의 보고서를 훑어본 결과, 한 가지 알 수 있는 사실이 있었습니다. 켈리드와의 싸움에 돈이 "
"많이 들어간다는 것 입니다. 영광스러운 승리였습니다만, 많은 희생자가 나왔습니다. 우리 손해를 벌충히야 합니다만, 누구와 해야 할지가 "
"걱정입니다. 국가에서 총동원을 한다면 화난 백성들이 날뛸 것입니다. 지원자들은 이미 모집해뒀습니다. 강제 징병이 필요하지 않을까 제안해 "
"봅니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0030_Text
#. Speaker : Capital_Kassil
msgctxt "239b5b64-ce4a-4567-ae79-1323a4972269"
msgid ""
"\"The other option is mercenaries, which is far worse. I've never trusted "
"those who fight for money, rather than honor or duty. It's better if we "
"recruit peasants by force. The training they'll undergo will make them "
"realize that it was the right thing to do for their own families and the "
"homeland.\""
msgstr ""
"\"다른 방안은 용병입니다만, 이건 훨씬 별로입니다. 전 명예와 의무 대신 돈을 받으며 싸우는 자들은 믿어본 적이 없습니다. 차라리 "
"백성들을 강제징용 하는 것이 훨씬 낫습니다. 백성들도 훈련을 받고 나면 자기 가족과 국가를 위해 꼭 필요한 일이었다는 것을 이해할 겁니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0031_Text_String
#. Speaker : Capital_Kassil
msgctxt "267ef02e-9063-431d-8b1a-b2df8d96ce32"
msgid ""
"\"I'm afraid they will disappoint you, or worse. You can occasionally come "
"across one or two decent people among them, but most mercenaries are greedy, "
"untrustworthy thugs.\""
msgstr ""
"\"저들이 당신을 실망시키지 않을까 걱정됩니다. 아니면 더 나쁜 상황이 될 수도 있고요. 괜찮은 사람 한 두 명 정도는 고용할 수 "
"있지만, 대부분의 용병들은 탐욕적이고 믿을 수 없는 깡패들입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0034_Text
#. Speaker : Capital_Kassil
msgctxt "be5acbf6-6848-419d-8f21-4590f57a1b50"
msgid ""
"\"I'll commence military conscription at once. Soldiers with families to "
"defend are far more reliable than mercenaries who only care about their own "
"skin and their pay. A mercenary will flee while a true defender holds out to "
"the end.\""
msgstr ""
"\"즉시 징병을 시작하겠습니다. 지킬 가족이 있는 군사들은 제 안위와 돈만 걱정하는 용병들보단 훨씬 낫지요. 진짜 수호자들이 끝까지 이 "
"땅을 지키는 동안 용병들은 분명 도망갈 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank7/Cue_0035_Text_String
#. Speaker : Capital_Kassil
msgctxt "5588958b-af9e-4b1d-870e-b4e1194ca5b6"
msgid ""
"\"I can't agree with this decision. Our weakened position may be too "
"tempting for our less noble neighbors. I'll try to use the remains of your "
"army to organize our defenses, but this may cost us dearly.\""
msgstr ""
"\"이 결정에 동의할 수 없습니다. 쇠약해진 우리 상황이 이 신의 없는 이웃들에게 너무 탐스러워 보이는 것 같군요. 전하의 남은 병력을 "
"모아 방어를 해보겠지만, 대가를 크게 치를 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Answer_0002_Text
msgctxt "7049331f-00e9-4f07-8c83-fb24bc072eb7"
msgid "\"What exactly do you have to offer to my army?\""
msgstr "\"우리 군에 정확히 뭘 제안하려는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Answer_0005_Text
msgctxt "abf0950e-8770-458f-b1d3-dc3b2e03e737"
msgid ""
"\"Tell me about your motherland. Where is it? We don't hear about it often "
"here, in our domain.\""
msgstr "\"그대의 모국에 대해 말해보라. 어디인가? 이곳에선 자주 못 들어본 이름인데.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Answer_0006_Text
msgctxt "8ecf766c-8476-4086-9436-a350c0e1d1b0"
msgid "\"Tell me about the weapon in your waistband.\""
msgstr "\"허리에 달아놓은 그 무기에 대해 말해보라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Answer_0013_Text
msgctxt "d60c208b-41ec-4ee6-8889-32e4bc4b9e1c"
msgid "\"Thank you. I need to think.\""
msgstr "\"고맙구나. 생각할 시간이 필요하다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Answer_0016_Text
msgctxt "6e8ffa67-1725-42c3-8c58-7e569b09fe99"
msgid ""
"\"What makes you think I'd prefer your odd toys to time-honored magic?\""
msgstr "\"내가 왜 전통적인 마법 대신 네 이상한 장난감에 관심있을 거라 생각하는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Cue_0001_Text
msgctxt "cf29348d-b35d-4921-8717-d85d6ed5b4af"
msgid ""
"{n}A halfling stands in front of you, wearing fine black cashmere. He has a "
"couple of weird-looking palm-sized metal weapons in his waistband. His "
"expensive attire does not disguise the scars on his face and hands, or his "
"sturdy posture. Your guest seems more accustomed to sitting in the saddle "
"and wearing traveling clothes, rather than to visiting palaces in expensive "
"attire.{/n}"
msgstr ""
"{n}질 좋은 검은색 캐시미어 옷을 입은 하플링 하나가 당신 앞에 섭니다. 그 하플링의 허리춤에는 손바닥 크기의 괴이해보이는 금속 무기가 "
"한 쌍 달려있습니다. 값비싸보이는 그 복장은 하플링의 얼굴과 손에 난 흉터, 그리고 그 완고한 태도를 그대로 드러냅니다. 당신에게 찾아온 "
"이 하플링은 화려한 옷을 입고 궁성을 방문하는 것 보다는, 여행용 옷가지를 입고 안장 위에 앉는 데 더 익숙해 보입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Cue_0003_Text
msgctxt "eb58cc54-54d6-4d24-a52b-a6b208030b5f"
msgid ""
"{n}The captain's voice grows serious.{/n} \"We will provide your soldiers "
"with our weapons, teach them how to use them, and make sure the weapons are "
"working. Believe me, each projectile shot by our devices will cost the enemy "
"an equal amount in gold.\""
msgstr ""
"{n}대장의 목소리가 진지해집니다.{/n} \"당신의 병사들에게 우리 무기를 제공하고, 사용법을 교육할 것이며, 확실히 무기를 쓸 수 "
"있게끔 만들 것입니다. 절 믿으십시오. 우리 장비들이 쏜 발사체 만큼 적들에게 손해를 입힐 것입니다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Cue_0008_Text
msgctxt "e2ab5c7c-2cc0-4f3e-9c2d-002bfb35ceca"
msgid ""
"\"Alkenstar is halfway around the world. You see, magic... how can I put "
"this... It doesn't work in our lands. Don't ask me why. That's a question "
"for the researchers and historians. But we ordinary people of Alkenstar "
"managed to turn this nuisance to the greater good.\""
msgstr ""
"\"알켄스타는 세계의 중심에 있습니다. 있잖습니까, 마법... 이걸 어떻게 표현할지... 그것은 우리 땅에서는 통하지 않습니다. 왜냐고 "
"묻지는 마십시오. 그것을 대답할 수 있는 사람은 학자들이나 역사학자 정도일 테니까 말입니다. 하지만 우리 알켄스타 사람들은 이 성가신 "
"일을 더 큰 이익으로 돌릴 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Cue_0009_Text
msgctxt "f4c5d794-f4da-4d2c-8e03-3dede251d842"
msgid ""
"{n}The captain grins and pats his crossbows.{/n} \"So, you'd like to know "
"how they're operated? What gears bring these small death machines to life? "
"It's a secret. We make our living from other people's ignorance of how our "
"weapons work. Nevertheless, I will tell you something about my weapons.\""
msgstr ""
"{n}대장은 활짝 웃으며 석궁을 쓰다듬습니다.{/n} \"자, 그럼 이게 어떻게 작동하는지 알고 싶으십니까? 어떤 기관이 이 살인 병기를 "
"움직이게 할까요? 비밀입니다. 우리는 이 무기의 작동원리로 먹고 산다고요. 그럼에도 불구하고 이 무기에 대해 말씀드리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Cue_0010_Text
msgctxt "6c35c1d9-98f4-4988-873c-8a1cab965ed6"
msgid ""
"\"Greetings, Your Highness. I'm Captain Romelo. I represent the Smoky Dawn "
"Arms Factory in the Grand Duchy of Alkenstar. Our enterprise is prepared to "
"provide your army with the finest weapons ever created.\""
msgstr ""
"\"안녕하십니까, 전하. 저는 로멜로 대장입니다. 저는 알켄스타의 대 공작령에 위치한 스모키 던 암 공장의 대표입니다. 우리 회사는 "
"당신의 군대 역사상 가장 훌륭한 무기를 제공할 준비가 되어 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Cue_0011_Text
msgctxt "d1835864-60fc-4233-b22c-a6fcb8425375"
msgid ""
"\"I should be clear from the beginning, we're not selling the technology. "
"Your engineers are not permitted to repair the weapons. We'll send our "
"specialists. However, if you're interested in any of our non-weapons "
"technologies, our craftsmen will gladly train your own!\""
msgstr ""
"\"처음부터 분명히 말씀드리지만, 저희는 기술을 판매하지 않습니다. 보통 기술자는 무기를 수리할 수 없을 테니, 전문가를 파견하겠습니다. "
"하지만 저희 비 무기 기술에 관심이 있으시다면, 저희 장인들이 기꺼이 가르쳐드릴 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Cue_0012_Text
msgctxt "0444c0e7-0135-458e-b5ed-61f0b102b745"
msgid ""
"{n}Romelo rubs his chin.{/n} \"We gave up magic for the sake of science. No "
"country can compare to Alkenstar in terms of its technological miracles! We "
"didn't just survive. We're doing very well here, where a mage could never "
"endure. And we are willing to share our findings with anyone willing to pay "
"a fair price.\""
msgstr ""
"{n}로멜로는 턱을 문지릅니다.{/n} \"우리는 과학을 위해 마법을 포기했습니다. 그 어떤 나라도 기술적 발전을 볼 때 알켄스타와 "
"비교할 수 없지요. 우리는 그냥 살아남은 것이 아닙니다. 그리고 우리의 연구 결과를 정당한 대가를 지불할 용의가 있는 모든 이들과 공유할 "
"생각이 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Cue_0014_Text
msgctxt "d5588eca-0154-4140-a086-83f2683409f0"
msgid "\"What else would you like to know?\""
msgstr "\"또 알고 싶은 것이 무엇입니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Cue_0015_Text
msgctxt "9fcc5733-c1f0-47c0-9440-1bf0dabcd8f7"
msgid ""
"\"The left one is for normal work. I use it to kill bandits and thieves "
"spying on our secrets. It's loaded with ordinary bullets. The right one is "
"for special occasions. Each of its bolts bears the name of a rascal who "
"wronged me or my family from the times we languished in "
"{g|Cheliax}Cheliax{/g}. When the right one is empty, my travels on "
"{g|Golarion}Golarion{/g} will end, and I will return to Alkenstar and find "
"myself something else to do.\""
msgstr ""
"\"왼쪽의 것은 평소에 일할 때 쓰는 것이지요. 이걸로 절 염탐하는 도적이나 강도들을 죽이곤 합니다. 평범한 탄약으로 채워져 있습니다. "
"오른쪽의 것은 특별한 경우에만 쓰는 겁니다. 오른쪽 무기의 볼트에는 {g|Cheliax}첼리악스{/g} 에서 가세가 기울었을 때 제 "
"가족과 절 욕보인 놈들의 이름이 적혀있지요. 오른쪽 무기의 볼트가 바닥나면 {g|Golarion}골라리온{/g} 에서의 제 여정도 끝이 "
"날 것이고, 저도 알켄스타로 돌아가 다른 일을 찾아볼 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Alkenstar/Cue_0017_Text
msgctxt "04a1f09b-7f27-4c52-a7b2-63dddd4570dc"
msgid ""
"\"That's because you're smart, Your Highness. First, our 'toys' are far "
"safer, and their failure far less dangerous than magic cast awry. Secondly, "
"anyone with an eye and two hands can use our weapons. That makes things a "
"bit simpler for you, doesn't it?\""
msgstr ""
"\"전하, 그것은 당신이 똑똑해서 그렇습니다. 첫째로, 우리 '장난감'은 훨씬 안전하며, 이것의 실패는 마법의 실패보다 훨씬 덜 "
"위험합니다. 둘째로, 눈과 손만 두 개 잘 달려있다면 누구든지 우리의 무기를 사용할 수 있습니다. 그럼 일이 더 간단해지죠. 안 "
"그렇습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Arcanamirium/Answer_0004_Text
msgctxt "6e165494-8667-43ed-86a2-5a006e49d2c6"
msgid "\"Your title is very unusual.\""
msgstr "\"네 직함은 굉장히 특이하군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Arcanamirium/Answer_0005_Text
msgctxt "98b01749-155f-4ce2-ae23-f9b0344467c8"
msgid "\"What do you have to offer to my troops?\""
msgstr "\"내 부대에 무엇을 제공할 것인가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Arcanamirium/Answer_0006_Text
msgctxt "9570dc9b-f4dd-4369-96df-f4871528247c"
msgid "\"What is this Arcanamirium so famous for?\""
msgstr "\"아르카나미리움은 무엇으로 유명한가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Arcanamirium/Answer_0007_Text
msgctxt "35cf2619-d3c8-4773-a131-2836e74d3217"
msgid "\"I need to think.\""
msgstr "\"생각할 시간이 필요하다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Arcanamirium/Cue_0001_Text
msgctxt "1987ee54-1862-4107-a10c-03b971f98572"
msgid ""
"{n}A sturdy middle-aged woman in practical grey attire bows to you. You can "
"tell by the numerous strings and laces on her neck that she's wearing quite "
"a number of amulets under her robe. Her hair is short and cropped.{/n}"
msgstr ""
"{n}실용적인 회색 의복을 입은 건장한 중년 여성이 당신에게 절을 합니다. 목에 걸린 수많은 끈과 레이스로 보아 그녀가 가운 밑에 꽤 "
"많은 부적을 차고 있다는 사실을 알 수 있습니다. 그녀의 머리는 아주 짧습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Arcanamirium/Cue_0002_Text
msgctxt "e6d8a1b6-f947-4469-8e4b-b61b8ede6a21"
msgid ""
"{n}The Wands Brigade's first foreman, Raquillata, nods politely and softly "
"clicks her heels together.{/n}"
msgstr "{n}완드 여단의 수석지휘관, 라키야타는 공손히 고개를 끄덕이며 부드럽게 발꿈치로 척 소리를 냅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Arcanamirium/Cue_0008_Text
msgctxt "1ec863ad-0b06-4296-8b3d-4d0c3a6a6957"
msgid ""
"\"Our experience. You're hiring the Wands Brigade, an independent squad of "
"mages, not merely as soldiers but as advisors and trainers for your other "
"troops. Each of us not only possesses magic but also has extensive combat "
"experience. What's more important, we know when and how to use it.\""
msgstr ""
"\"저희의 경험입니다. 당신께서는 완드 여단을 고용하고 있습니다. 완드 여단은 독립인 부대로, 단순한 군인이 아닌 다른 부대를 위한 "
"보좌관이자 훈련 교관입니다. 우리는 각각 마법을 쓸 수 있을 뿐만 아니라 다양한 전투 경험을 가지고 있습니다. 더 중요한 것은, 언제 "
"어떻게 사용할지 알고 있다는 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Arcanamirium/Cue_0010_Text
msgctxt "bdb57a55-749d-44e8-a4d3-d9a216d52a09"
msgid ""
"\"It is the oldest, biggest, and the most prestigious arcane academy in "
"{g|Absalom}Absalom{/g}. It's very influential. Students come from all over "
"the world to master the art of magic. Mind you, the school is tuition-free.\""
msgstr ""
"\"{g|Absalom}압살롬{/g}에서 가장 오래되고, 가장 크고, 가장 권위 있는 비전마법 학원입니다. 영향력이 크죠. 전 세계에서 "
"많은 학생들이 마법의 기술을 마스터하기 위해 이곳을 찾아옵니다. 기억해두십시오. 그곳은 수업료가 무료입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Arcanamirium/Cue_0011_Text
msgctxt "5d4d10bb-86e9-4069-b1e1-4c36035bbb91"
msgid ""
"\"First Foreman Raquillata, at your service, Your Highness. Reporting for "
"negotiations on behalf of the Wands Brigade, graduates of the Arcanamirium!\""
msgstr "\"수석 지휘관 라키야타입니다, 전하. 아르카나미리움 졸업생인 완드 여단을 대표하여 교섭을 위해 보고드립니다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Arcanamirium/Cue_0012_Text
msgctxt "c2133ca7-ce07-4158-be22-81e770abd66d"
msgid ""
"\"We're not theoreticians or professors, Your Highness. We're arcane "
"practitioners, combat specialists, and frontline workers. We're willing to "
"share our knowledge with your military mages.\""
msgstr ""
"\"우리는 이론가나 교수가 아닙니다, 전하. 실무자이자, 전투 전문가, 그리고 최전방에서 일하는 노동자입니다. 우리는 기꺼이 우리의 "
"지식을 당신의 군대와 공유할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Arcanamirium/Cue_0013_Text
msgctxt "bdd336de-457f-432f-948c-0dc126337ab6"
msgid ""
"\"Every member of our brigade is an Arcanamirium graduate. We each have "
"combat experience and a desire to build a mercenary career. We've been "
"preparing to accept your orders since we entered the Wands Brigade.\""
msgstr ""
"\"우리 여단의 모든 대원은 아르카나미리움의 졸업생입니다. 우리는 각각 전투 경력과 용병 경력을 쌓고자 하는 마음이 있습니다. 완드 여단 "
"일원들은 당신의 명령을 받들 준비를 하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Arcanamirium/Cue_0014_Text
msgctxt "1d0d07d6-1586-4b2e-8f1a-4dd4ee522ced"
msgid ""
"\"They teach both magic and practical skills, both of which are certainly "
"useful to combat mages. For instance, if you've learned to summon enraged "
"monsters, it might also be a good idea to learn to run fast.\"{n}A smile "
"brushes lightly over Raquillata's face.{/n}"
msgstr ""
"\"저들은 마법과 실용적인 기술 둘 다를 가르치는데, 둘 모두 전투 마법사에게 있어 유용합니다. 예를 들어 거대화된 괴물을 소환하는 "
"마법을 배웠다면 빠르게 뛰는 법도 배우면 좋을 거란 말이죠.\"{n}라퀼리타의 얼굴에 가볍게 미소가 번집니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0004_Text
msgctxt "4ed46375-2076-4d42-b922-f2897b15db34"
msgid ""
"{g|Military8_1}[Choice effects]{/g} [Pay 3 BP each week] \"I trust "
"Alkenstar's engineers. Have them supply us with their weapons.\""
msgstr ""
"{g|Military8_1}[선택 시 효과]{/g} [매주 3 BP 지불] \"알켄스타의 기술공들을 믿겠다. 그들이 우리 무기를 만들게 "
"하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0005_Text
msgctxt "8ff586fa-ef4e-4c97-890a-843b0616b558"
msgid ""
"{g|Military8_2}[Choice effects]{/g} [Pay 3 BP each week] \"I am impressed "
"with Arcanamirium's power. I'd like its graduates to train our mages.\""
msgstr ""
"{g|Military8_2}[선택 시 효과]{/g} [매주 3 BP 지불] \"아르카나미리움의 마법에 감명받았다. 그 졸업생들이 우리 "
"마법사들을 훈련시키면 좋겠군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0006_Text
msgctxt "371709b5-de80-4c5c-b894-f4762df1a0de"
msgid ""
"{g|Military8_3}[Choice effects]{/g} [Pay 3 BP each week] \"May Kurgess bless "
"our warriors with strength and agility.\""
msgstr ""
"{g|Military8_3}[선택 시 효과]{/g} [매주 3 BP 지불] \"쿠르게스께서 우리 전사들에게 힘과 기민함을 내려주시길.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0017_Text
msgctxt "37147943-ccae-456e-a5c2-7e6d6c1028d8"
msgid ""
"\"You understand our army's needs better than I do. You can make your own "
"decision.\""
msgstr "\"그대는 나보다 우리 군의 사정에 밝구나. 그대의 결정을 따르겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0020_Text
msgctxt "1768cfa2-59af-4600-ba25-56c5b6551c2e"
msgid "\"Who should I make the deal with?\""
msgstr "\"누구와 이야기하면 되는가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0021_Text
msgctxt "2db4ff82-0e19-4b02-a1d6-f4193ea6c7bd"
msgid "\"I should talk to their ambassadors.\""
msgstr "\"저들의 사절과 이야기 해보겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0031_Text
msgctxt "bbb80eee-c340-4b2d-b0c7-3bf2cca9b47a"
msgid "\"The halfling in black.\""
msgstr "\"검은 옷을 입은 하플링과.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0032_Text
msgctxt "4721962e-bf24-4902-aeda-d9b5a4b89b88"
msgid "\"With the dwarf.\""
msgstr "\"드워프와.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0033_Text
msgctxt "0aa41196-bb53-4b13-8b7b-210a2380da17"
msgid "\"With the sorceress.\""
msgstr "\"소서러들과.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0034_Text
msgctxt "145e55a9-e034-4246-be0d-fe74768bef9e"
msgid "\"In fact, it doesn't matter.\""
msgstr "\"사실, 누구든 상관 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0041_Text
msgctxt "9e8f7ebc-486b-42d7-9ba8-c5b3eecc41ec"
msgid "\"Your title is very unusual.\""
msgstr "\"그대의 직함은 굉장히 독특하구나.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0042_Text
msgctxt "280535f6-f557-45d2-9cce-93b94341d267"
msgid "\"What do you have to offer to my troops?\""
msgstr "\"우리 군에게 무엇을 제안할 것이더냐?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0043_Text
msgctxt "4ecb0802-8c9d-4cbd-a1ca-10d643299fac"
msgid "\"What is this Arcanamirium so famous for?\""
msgstr "\"이 아르카미리움은 뭐로 유명하지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0044_Text
msgctxt "a9806116-16b9-47df-8bea-d5044e86b3a0"
msgid "\"I need to think.\""
msgstr "\"그대의 생각이 듣고싶다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0058_Text
msgctxt "7f8ce472-8734-4191-8c2a-aa86721c7374"
msgid ""
"\"Tell me about your motherland. Where is it? We don't hear about it often "
"here, in our domain.\""
msgstr "\"그대의 모국에 대해 말해보라. 어디인가? 이곳에선 자주 못 들어본 이름인데.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0059_Text
msgctxt "af23ce33-f83f-4335-9354-29306d77eb1f"
msgid "\"Tell me about the weapon in your waistband.\""
msgstr "\"허리에 달아놓은 그 무기에 대해 말해보라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0060_Text
msgctxt "cc0db3ab-0128-4179-8e0e-88f43a006b5b"
msgid ""
"\"What makes you think I'd prefer your odd toys over time-honored magic?\""
msgstr "\"왜 내가 유서 깊은 마법보다 너의 이상한 장난감을 더 좋아할 거라 생각하는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0061_Text
msgctxt "53227f98-deb9-44b9-81fe-065dc3982e97"
msgid "\"Thank you. I need to think.\""
msgstr "\"고맙군. 생각해보겠다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0068_Text
msgctxt "6a410807-4623-4986-9511-338d8d281cd1"
msgid "\"What exactly do you have to offer?\""
msgstr "\"정확히 제안하고자 하는 게 뭐지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0075_Text
msgctxt "426f573c-71e6-419b-b060-7d343216ea3e"
msgid "\"How can you help my army?\""
msgstr "\"어떻게 내 군대를 도울 수 있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0076_Text
msgctxt "5b03271e-ead8-4515-9efa-6224d379df90"
msgid "\"Tell me about your god.\""
msgstr "\"네 신에 대해 말해다오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0077_Text
msgctxt "c3c59489-a3a0-4a75-b010-be67f6d662e6"
msgid "\"What is your church?\""
msgstr "\"네 교단은 뭐지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0078_Text
msgctxt "a230555d-fa37-4035-b3a5-7d48227a2b7e"
msgid "\"You... look outlandish. Where have you come from?\""
msgstr "\"넌... 이국적으로 보이는군. 어디 출신이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Answer_0079_Text
msgctxt "56a73316-2d1b-4fe2-9248-db0b0681a2ee"
msgid "\"I need to think it over.\""
msgstr "\"잘 생각해 봐야겠군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0001_Text
msgctxt "91f16048-695b-4f6c-8698-571159dfefed"
msgid ""
"{n}Regongar grins contentedly.{/n} \"I have an idea I'd like to share with "
"you. I'm sure it's occurred to you that we are now in control? We're the "
"power everyone answers to – and not only in the {g|Stolen Lands}Stolen "
"Lands{/g}. We demand respect. And those worthy of respect are worthy of "
"doing business with. Profitable business.\""
msgstr ""
"{n}레곤가르는 만족하며 웃습니다.{/n} \"할 말이 있다. 그대도 지금 우리가 국가를 잘 통제한다는 생각이 들지 않나? 우리의 힘은 "
"지금 어디서든 통한다. 비단 {g|Stolen Lands}도둑맞은 땅{/g} 내에서만 그런 게 아니지. 우린 보다 더 존경받아야 한다. "
"존중받는 사람들은 존중 받을만한 사업을 하는 법이지. 아주 수익성 좋은 사업을 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0002_Text
#. Speaker : Amiri_Companion
msgctxt "cf93adef-39e7-4590-aa28-7c084dd05aa0"
msgid ""
"{n}Amiri smiles in satisfaction.{/n} \"It looks like word of our heroic "
"feats made it all across {g|Golarion}Golarion{/g}. Merchants and shamans are "
"always chasing great warriors, trying to sell them their best sword. So they "
"can proudly announce it on every corner!\""
msgstr ""
"{n}아미리는 만족하며 웃습니다.{/n} \"우리의 영웅적인 위업이 {g|Golarion}골라리온{/g} 전체로 퍼져나간 모양이야. "
"상인들과 주술사들은 언제나 위대한 전사를 쫓아다니면서 자기네 칼을 팔려고 하지. 그래야 어디서든 자랑 할 수 있거든!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0008_Text
msgctxt "a3ce2236-8273-4b2d-bfb7-89811ec06420"
msgid ""
"\"Anyway, three representatives of... dealers in life and death have "
"requested an audience with you. All three are willing to support our army. "
"Talk to them and decide which of them we want to sign a contract with. "
"However, we can't hire all three. Each of them wants to be your main weapons "
"supplier. If I were you, I'd consider the Arcanamirium.\""
msgstr ""
"\"어쨌든, 목숨을 사고 파는 세 명의 대표가 알현을 요청해 왔어. 이 세 명 모두 우리 군을 지원하려고 해. 각자 만나보고 누구와 "
"계약을 할지 결정해봐. 세 명 다 고용할 수는 없어. 세 명 모두 자기가 주 공급자가 되기를 원하거든. 내가 너였다면 아르카나미리움을 "
"고를 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0009_Text
#. Speaker : Amiri_Companion
msgctxt "2e5e6ccb-695d-4b2f-bc80-811a69e4fca1"
msgid ""
"\"Three great clans want to offer support for our troops. There was more "
"before I got rid of the swindlers and the small fish. We should choose the "
"best one and seal the deal. But only one. We have to refuse the others to "
"command their respect. All three want to talk to you. Talk them all you "
"want, but look closest at...\" {n}Amiri gives you an 'inconspicuous' "
"wink.{/n}\"... the Kurgess guy, I say.\""
msgstr ""
"\"세 개의 거대 부족들이 우리 군을 지원하려고 해. 사기꾼과 씨알 작은 놈들을 다 쳐내기 전 까지는 더 많았었지. 최고의 한 명을 "
"뽑아서 협상을 타결해야 해. 한 명만. 명예를 봐서라도 다른 사람들은 거절해야 해. 원하는 사람 아무나와 말해봐. 하지만 주의하고...\""
" {n}아미리는 '눈에 띄지 않게' 윙크합니다.{/n}\"... 나라면 저 쿠르게스 놈이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0010_Text_String
#. Speaker : Amiri_Companion
msgctxt "ad67b2f8-5f54-43e3-98f2-4995b68a7ed3"
msgid "\"Have you decided who we're going to deal with for army support?\""
msgstr "\"군을 지원할 사람은 결정했어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0011_Text
#. Speaker : Amiri_Companion
msgctxt "89435183-cae8-43c0-9cd4-f5931dedc62e"
msgid ""
"\"You think their tricky devices will bring you victory? Well, you obviously "
"know better than me...\""
msgstr "\"저 장난감들이 과연 우리에게 승리를 안겨다줄까? 뭐, 네가 나보다 더 잘 알겠지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0012_Text_String
#. Speaker : Regongar_Companion
msgctxt "4cfe89c0-9247-41b9-9fd8-6138b1b266cf"
msgid ""
"\"They invented their pathetic toys because they had no magic. Why stoop to "
"their level? After all, we do have magic.\""
msgstr ""
"\"놈들은 마법이 없기에 저 가련한 장난감을 발명해냈다. 왜 저들이랑 같은 선상에 서려 하는 거지? 어쨌거나 우리에겐 마법이 있는데 "
"말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0013_Text_String
#. Speaker : Amiri_Companion
msgctxt "9eb5ed70-c44e-4002-bcb6-6b80938bea7b"
msgid ""
"\"A mage acting like a soldier? That doesn't stop them from being a dodger "
"and a coward. Don't trust anyone who avoids a fair fight.\""
msgstr "\"군인처럼 행동하는 마법사라고? 그렇다고 놈들이 겁쟁이처럼 도망 안 갈까? 정정당당한 싸움을 피하려는 놈은 믿지 마.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0014_Text
#. Speaker : Regongar_Companion
msgctxt "904dead5-3bc8-4652-a11b-3f198b5fb3da"
msgid ""
"\"You can get a decent education in Arcanamirium. They don't just teach the "
"books, but also how to use your legs and hold a weapon. The result is a well-"
"rounded warrior.\""
msgstr ""
"\"아르카나미리움에서 적절한 교육을 받을 수 있다. 저들은 책 내용만 가르치는 게 아니라 다리와 무기를 쥐는 법도 가르치지. 그 결과물로 "
"다재다능한 전사가 만들어지는 거다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0015_Text
#. Speaker : Amiri_Companion
msgctxt "7677f593-bc8b-4d7a-9c93-fc6be7485e43"
msgid ""
"\"If even half of our soldiers were like Wodga, we'd break every enemy spine "
"on the battlefield.\""
msgstr "\"우리 병사 중 절반만 보드자 같았다면 전장에서 적이란 적의 척추는 다 부숴버렸을텐데.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0016_Text
#. Speaker : Regongar_Companion
msgctxt "65f18971-d924-406d-9532-fd345d73838b"
msgid ""
"\"Did that jock impress you? Ah, what am I saying?! I liked him too.\" {n}"
"Regongar smirks.{/n}"
msgstr "\"그 농담 좀 괜찮았어? 아, 뭐라는 거야?! 나도 그가 마음에 들더라.\" {n}레곤가르가 빙그레 웃습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0022_Text
#. Speaker : Amiri_Companion
msgctxt "d91ce54b-cf0a-4a1e-89bf-71a7cb110c9f"
msgid ""
"\"Alkenstar's weapons are impressive, but relying too heavily on their power "
"may weaken our troops in other ways. You know what I think about magic and "
"mages. But if all our soldiers looked like that Kurgess priest, the war "
"might not happen at all! The enemy would flee on sight!\""
msgstr ""
"\"알켄스타의 무기는 인상적이지만 그들의 힘에 너무 많이 의존하는 건 다른 면에서 아군을 나약하게 만들 거다. 내가 마법과 마법사들에 "
"대해 어떻게 생각하는지 너도 알잖아. 그래도 우리 군인들이 죄다 저 쿠르게스 사제처럼 된다면 전쟁은 일어나지 않을지도 모르지! 적들은 "
"보자마자 도망칠 테니까!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0023_Text
#. Speaker : Regongar_Companion
msgctxt "23e6d3c2-7902-441d-b531-63d46f244a2f"
msgid ""
"\"With the mages, of course. Have you seen them fight? Now that's what I "
"call a massacre! Fireballs hurtling, ice crunching! Swoosh! Bang! They can "
"rip a soul right out of a body and use it as a bomb! Kaboom! Bony shrapnel "
"flying everywhere! Blood in everyone's eyes! And then they jump into the "
"shadows, spread out, and sneak behind the enemy's lines to finish the "
"survivors. They surround them, cover them with a force field, and create a "
"little explosion on the inside. And don't forget the roaring flame! All "
"that's left is ashes and footprints on the scorched earth...\""
msgstr ""
"\"마법사와 함께라니, 물론이지. 걔네 싸우는 거 본 적 있어? 그야말로 대학살 그 자체야! 파이어볼이 터지고, 얼음이 깨지고! "
"슈우우우욱! 쾅! 그들은 몸에서 영혼을 뜯어내서 폭탄으로 쓸 수도 있다고! 콰쾅! 그럼 뼛조각들이 사방으로 날아다니지! 모두의 눈엔 피가 "
"고이고! 그리고 죄다 그림자 속으로 뛰어들어 흩어졌다가, 적의 대형 뒤로 숨어들어가 살아남은 이들을 죽여버리지. 그들을 둘러싸고, 보이지 "
"않은 장막을 치고 안에다 폭발을 일으켜 버릴 수도 있어! 남은 건 잿더미와 그을린 땅 위에 찍힌 발자국밖에 없을 거야...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0028_Text
#. Speaker : Regongar_Companion
msgctxt "79e19422-00f3-490f-a533-2be2cd5f0406"
msgid "\"Which of the three?\""
msgstr "\"셋 중에 어느 쪽?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0029_Text
#. Speaker : Amiri_Companion
msgctxt "60ded03d-b27d-46fa-b204-c77b36e66327"
msgid "\"Which of the ambassadors?\""
msgstr "\"사절 중에 누구?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0035_Text
#. Speaker : Amiri_Companion
msgctxt "607d40e3-6f36-4d92-b64a-22b157240420"
msgid "\"They'll be waiting for your decision, chief.\""
msgstr "\"그들은 네 결정을 기다리고 있을거야, 족장.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0036_Text
#. Speaker : Regongar_Companion
msgctxt "4b76f8bb-f85c-4927-8e3d-1807eecec06c"
msgid ""
"\"You should think fast. What if an enemy assault takes us by surprise, and "
"we've got no reinforcements, hunh?\""
msgstr "\"빨리 생각해야 해. 적군이 우릴 기습하는데 지원군이 없으면 어떡하냐구, 응?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0037_Text
#. Speaker : RankUp_Rakiyata
msgctxt "76f913bf-78dd-4e02-b1ac-568b3ff444bb"
msgid ""
"{n}A sturdy middle-aged woman in practical grey attire bows to you. You can "
"tell by the numerous strings and laces on her neck that she's wearing quite "
"a number of amulets under her robe. Her hair is short and cropped.{/n}"
msgstr ""
"{n}실용적인 회색 의복을 입은 건장한 중년 여성이 당신에게 절을 합니다. 목에 걸린 수많은 끈과 레이스로 보아 그녀가 가운 밑에 꽤 "
"많은 부적을 차고 있다는 사실을 알 수 있습니다. 그녀의 머리는 매우 짧습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0038_Text
#. Speaker : RankUp_Rakiyata
msgctxt "895dc59f-cb51-437d-aef6-37ae3fab2d3c"
msgid ""
"{n}The Wands Brigade's first foreman, Raquillata, nods politely and softly "
"clicks her heels together.{/n}"
msgstr "{n}완드 여단의 수석 지휘관, 라키야타는 공손히 고개를 끄덕이며 부드럽게 발뒤꿈치로 척 소리를 냅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0039_Text
#. Speaker : RankUp_Rakiyata
msgctxt "a5030eb0-377b-4acd-87db-38c244e71685"
msgid ""
"\"First Foreman Raquillata, at your service, Your Highness. Reporting for "
"negotiations on behalf of the Wands Brigade, graduates of the Arcanamirium!\""
msgstr "\"수석 지휘관 라키야타입니다, 전하. 아르카나미리움 졸업생들로 구성된 완드 여단을 대표하여 교섭하고자 보고드립니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0045_Text
#. Speaker : RankUp_Rakiyata
msgctxt "b9424b94-01ca-44a0-a0d3-ad4b5cc814da"
msgid ""
"\"We're not theoreticians or professors, Your Highness. We're arcane "
"practitioners, combat specialists, and frontline workers. We're willing to "
"share our knowledge with your military mages.\""
msgstr ""
"\"우리는 이론가나 교수가 아닙니다. 우리는 실무자, 전투 전문가, 그리고 최전방에서 일하는 노동자들이지요. 기꺼이 우리의 지식을 당신으 "
"군대와 공유할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0046_Text
#. Speaker : RankUp_Rakiyata
msgctxt "3ada023d-fcf6-4e6e-972c-645ba5143963"
msgid ""
"\"Our experience. You're hiring the Wands Brigade, an independent squad of "
"mages, not merely as soldiers but as advisors and trainers for your other "
"troops. Each of us not only possesses magic but also has extensive combat "
"experience. What's more important, we know when and how to use it.\""
msgstr ""
"\"저희의 경험입니다. 당신은 독립적인 마법사 부대이자, 단순한 군인이 아닌 다른 부대를 위한 보좌관이자 훈련교관인 완드 여단을 고용하고 "
"계십니다. 우리는 각자 마법을 사용할 뿐만 아니라 다양한 전투 경험도 가지고 있습니다. 더 중요한 것은, 언제 어떻게 사용하는지 알고 "
"있다는 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0047_Text
#. Speaker : RankUp_Rakiyata
msgctxt "47e55c26-b0db-4448-bb0a-2bddfe3e1aeb"
msgid ""
"\"It is the oldest, biggest, and the most prestigious arcane academy in "
"{g|Absalom}Absalom{/g}. It's very influential. Students come from all over "
"the world to master the art of magic. Mind you, the school is tuition-free.\""
msgstr ""
"\"{g|Absalom}압살롬{/g}에서 가장 오래되고, 크고, 권위 있는 비전 마법 학교입니다. 영향력이 매우 크지요. 전 세계에서 "
"마법 기술을 마스터하기 위해 학생들이 모여듭니다. 기억해두십시오. 수업료가 무료랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0048_Text
#. Speaker : RankUp_Rakiyata
msgctxt "51a4087f-979d-4a94-b01c-ac26a78462eb"
msgid ""
"\"They teach both magic and practical skills, both of which are certainly "
"useful to combat mages. For instance, if you've learned to summon enraged "
"monsters, it might also be a good idea to learn to run fast.\"{n}A smile "
"brushes lightly over Raquillata's face.{/n}"
msgstr ""
"\"마법과 실용 기술을 함께 가르칩니다. 둘 다 전투 마법사에게 필요한 능력이죠. 예를 들어, 흉폭한 괴물을 소환하는 이는 현장에서 "
"빠르게 달아나는 법을 익히는 식으로요.\"{n}라키야타의 얼굴에 옅은 미소가 떠오릅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0049_Text
#. Speaker : RankUp_Rakiyata
msgctxt "c3300fae-cd34-4706-b896-bd8451e0d0f4"
msgid ""
"\"Every member of our brigade is an Arcanamirium graduate. We each have "
"combat experience and a desire to build a mercenary career. We've been "
"preparing to accept your orders since we entered the Wands Brigade.\""
msgstr ""
"\"저희 여단의 모든 대원들은 아르카나미리움의 졸업생입니다. 우리는 전투 경험과 용병 경력을 쌓고자 하는 욕구를 가지고 있습니다. 우리 "
"완드 여단은 당신의 명을 받들 준비가 되어 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0050_Text
#. Speaker : RankUp_Rakiyata
msgctxt "f8414b01-c1e7-43dd-b8d5-b9262375d88b"
msgid "\"Always at your service.\""
msgstr "\"항상 당신을 받들겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0051_Text
#. Speaker : RankUp_Romelo
msgctxt "f326537b-d6a2-4d32-a6d2-1085d7660779"
msgid ""
"{n}The halfling standing before you wears fine black cashmere. He has a "
"couple of strange-looking palm-sized crossbows in his waistband. His "
"expensive attire does nothing to disguise the scars on his face and hands, "
"or his sturdy posture. Your guest seems more accustomed to sitting in the "
"saddle and wearing traveling clothes, rather than visiting palaces wearing "
"expensive attire.{/n}"
msgstr ""
"{n}고급진 검정 캐시미어를 입고 서 있는 하플링이 있습니다. 허리춤에 이상하게 생긴 손바닥만한 석궁이 두어 개 달려 있습니다. 값비싼 "
"옷차림은 얼굴과 손의 흉터, 건장한 신체를 가리는 데 전혀 도움이 되지 않습니다. 이 자는 비싼 옷을 입고 궁궐을 방문하는 일보다 안장 "
"위에 올라 여행복을 입고 있는 것이 더 익숙한 듯 보입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0052_Text
#. Speaker : RankUp_Romelo
msgctxt "02e045a7-8d97-4872-9baf-e0481412bef8"
msgid "\"What else would you like to know?\""
msgstr "\"또 알고 싶은 것이 무엇입니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0053_Text
#. Speaker : RankUp_Romelo
msgctxt "0cd5d147-4bc6-4d0e-889b-76cf246053ed"
msgid ""
"\"Greetings, Your Highness. I am Captain Romelo. I represent the Smoky Dawn "
"Arms Factory in the Grand Duchy of Alkenstar. Our enterprise is prepared to "
"provide your army with the finest weapons ever made.\""
msgstr ""
"\"안녕하십니까, 전하. 저는 로멜로 대장입니다. 알켄스타의 대 공작령에 있는 자욱한 여명 무기 공장을 대표하여 왔습니다. 우리 회사는 "
"당신의 군대에 역사상 가장 훌륭한 무기를 제공할 준비가 되어 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0062_Text
#. Speaker : RankUp_Romelo
msgctxt "f8cfa9d8-f068-4961-9057-54bdcca2decb"
msgid ""
"\"Alkenstar is halfway around the world. You see, magic... how can I put "
"this... It doesn't work in our lands. Don't ask me why. That's a question "
"for the researchers and historians. But we ordinary people of Alkenstar "
"managed to turn this nuisance to the greater good.\""
msgstr ""
"\"알켄스타는 세계의 중심에 있습니다. 있잖습니까, 마법... 이걸 어떻게 말하면 좋을까요. 그것은 우리 땅에서는 통하지 않습니다. "
"왜냐고 묻지는 말아주십시오. 저는 연구자나 역사학자가 아니라서 대답해 드리기 힘듭니다. 하지만 저 같은 알켄스타 사람들은 이 성가신 일을 "
"더 큰 이익으로 만들 수 있지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0063_Text
#. Speaker : RankUp_Romelo
msgctxt "a2d86a63-6288-4e76-afdb-1d11a1c633a4"
msgid ""
"{n}Romelo rubs his chin.{/n} \"We gave up magic for the sake of science. No "
"country can compare to Alkenstar in terms of its technological miracles! We "
"didn't just survive. We're doing very well here, where a mage could never "
"endure. And we are willing to share our findings with anyone willing to pay "
"a fair price.\""
msgstr ""
"{n}로멜로가 턱을 문지릅니다.{/n} \"우리는 과학을 위해 마법을 포기했습니다. 그 어떤 나라도 기술적인 측면에서 알켄스타와 비견될 "
"수 없습니다. 저희는 그냥 살아남은 것이 아니니까요. 그리고 우리는 우리의 연구 성과를 정당한 대가를 지불할 용의가 있는 모든 사람들과 "
"공유할 생각이 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0064_Text
#. Speaker : RankUp_Romelo
msgctxt "eee991f7-06f5-4190-a3fa-c27c3a7875e2"
msgid ""
"{n}The captain grins and pats his crossbows.{/n} \"So, you'd like to know "
"how they're operated? What gears bring these small death machines to life? "
"How can they rain bolts down upon the enemy without ever recharging? It's a "
"secret. We make our living from other people's ignorance of how our weapons "
"work. Nevertheless, I will tell you a secret about these two crossbows of "
"mine.\""
msgstr ""
"{n}그 대장은 활짝 웃으며 석궁을 쓰다듬습니다.{/n} \"그럼, 어떻게 작동하는지 알고 싶으십니까? 어떤 기어가 이 작은 살인 병기에 "
"생명을 불어넣을까요? 어떻게 장전 없이 적에게 볼트를 쏴재낄 수 있을까요? 비밀입니다. 우리는 이 비밀로 먹고삽니다. 그럼에도 불구하고 "
"이 두 석궁의 비밀에 대해 말씀드리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0065_Text
#. Speaker : RankUp_Romelo
msgctxt "c21b7eda-cba9-42cc-ae8c-6a1561968b3c"
msgid ""
"\"The left one is for normal work. I use it to kill bandits and thieves "
"spying on our secrets. It's loaded with ordinary bolts. The right one is for "
"special occasions. Each of its bolts bears the name of a rascal who wronged "
"me or my family. When the right one is empty, my travels on "
"{g|Golarion}Golarion{/g} will end, and I will return to Alkenstar and find "
"myself something else to do.\""
msgstr ""
"\"왼쪽은 일반적인 석궁입니다. 우리의 비밀을 엿보고 있는 도둑놈을 죽이는데 사용하지요. 일반 볼트가 장착되어 있습니다. 오른쪽은 특별한 "
"경우를 위한 것입니다. 각각의 볼트에는 저나 제 가족을 욕한 악들의 이름이 새겨져 있습니다. 오른쪽 것의 볼트가 빌 때, "
"{g|Golarion}골라리온{/g}에서의 제 여정은 끝날 것이고, 저는 알켄스타로 돌아가 다른 일을 찾을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0066_Text
#. Speaker : RankUp_Romelo
msgctxt "3af080e7-b3d2-4bef-bf2e-54b4f8d0382f"
msgid ""
"\"Because you're smart, Your Highness. Firstly, our 'toys' are way safer, "
"and their failure is far less dangerous than magic cast awry. Secondly, "
"anyone with an eye and two hands can use our weapons. That makes things a "
"bit simpler for you, doesn't it?\""
msgstr ""
"\"그것은 당신이 똑똑하기 때문입니다, 전하. 첫째로, 우리의 '장난감'은 안전하며, 이것이 실패하더라도 마법 주문의 실패보다는 훨씬 덜 "
"위험합니다. 둘째, 눈과 손이 두 개인 사람은 누구나 우리의 무기를 사용할 수 있습니다. 그러면 일이 좀 더 쉬워지지요. 안 그렇습니까?"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0067_Text
#. Speaker : RankUp_Romelo
msgctxt "7d8c5d98-e2e5-4dfe-87c8-59cc261519da"
msgid "\"I'm sure we'll have a most productive association, Your Highness.\""
msgstr "\"전하, 저희는 분명 생산적인 관계를 맺게 될 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0069_Text
#. Speaker : RankUp_Romelo
msgctxt "d3bddc80-c1e5-4c27-9577-bd9c9847f874"
msgid ""
"{n}The captain's voice grows serious.{/n} \"We will provide your soldiers "
"with our weapon, teach them how to use it, and make sure the weapons are "
"working. Believe me, each bolt shot by our crossbows will cost the enemy an "
"equal amount in gold.\""
msgstr ""
"{n}그 대장의 목소리가 진지해집니다.{/n} \"당신의 병사들에게 우리의 무기를 제공하고, 사용법을 교육할 것이며, 제대로 사용하게끔 "
"만들 것입니다. 우리의 석궁이 쏜 볼트는 적에게 같은 양의 금을 쓰게 만들 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0070_Text
#. Speaker : RankUp_Romelo
msgctxt "28808d5e-d234-4b07-b8eb-21bce1ba558e"
msgid ""
"\"I should make clear from the beginning, we're not selling the technology. "
"Your engineers won't be permitted to repair the weapons; they're to be "
"handled exclusively by our specialists. However, if you're interested in any "
"of our non-weapons technologies, our craftsmen will gladly train yours!\""
msgstr ""
"\"처음부터 분명히 말씀드립니다만, 저희는 기술을 판매하지 않습니다. 당신의 기술자들은 무기를 수리할 수 없을 겁니다. 그 무기는 저희 "
"전문가들만이 다룰 수 있으니까요. 하지만 비 군사적 목적의 기술에 관심이 있으시다면, 저희 전문가들이 기꺼이 여러분에게 가르쳐 드릴 "
"것입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0071_Text
#. Speaker : RankUp_Vodja
msgctxt "1bbdbdf3-517f-4333-a7bd-686704f69ead"
msgid ""
"{n}An unusually tall and sturdy dwarf with a shaved head bows to you. "
"Despite the weather, his feet are bare, and he's wearing a simple vest over "
"his naked torso.{/n}"
msgstr ""
"{n}우난히 키가 크고 건장한 드워프가 당신에게 절합니다. 날씨에도 불구하고 발은 맨발에, 알몸에 조끼만을 입고 있습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0072_Text
#. Speaker : RankUp_Vodja
msgctxt "500b3fee-b0e9-4c25-8b5c-3223174ed39e"
msgid ""
"\"Hey – let's arm wrestle, eh? Oh, no, I'm only joking. I know that Your "
"Highness is mighty busy. Is there anything I can help you with?\""
msgstr ""
"\"이봐요, 팔씨름 한판 하시죠. 예? 아, 아닙니다. 농담이었습니다. 당연히 전하께서 바쁘시다는 건 알고 있지요. 도와드릴 일이라도 "
"있으십니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0073_Text
#. Speaker : RankUp_Vodja
msgctxt "6681c6ea-d9b1-4210-9ea1-325a56221693"
msgid ""
"{n}His mighty but pleasant voice fills the entire hall.{/n} \"Greetings, "
"Your Highness. I am Wodga, priest of the glorious god Kurgess! I believe it "
"was not by coincidence that the road brought me and my comrades to your "
"lands.\""
msgstr ""
"{n}그의 힘차지만 유쾌한 목소리가 회장 전체를 가득 채웁니다.{/n} \"안녕하십니까, 전하. 저는 영광스러운 쿠르게스의 사제, "
"보드자입니다! 저는 동지들과 저를 여기로 이끈 이 길이 우연이 아니라는 것을 믿고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0080_Text
#. Speaker : RankUp_Vodja
msgctxt "cd646306-8cfb-4c82-8b60-ecbc3a9362ef"
msgid ""
"\"Your soldiers are... brave, but weak. By the will of Kurgess, we'll sort "
"out your pathetic forces. My priests know how to strengthen a soldier with "
"magic that will give them the power and speed of a mighty animal. And if "
"that fails to protect them, our prayers will heal your warriors and restore "
"them to perfect fighting form.\""
msgstr ""
"\"당신의 병사들은... 용감하지만 약합니다. 쿠르게스의 의지로 당신의 불쌍한 병력을 정리하겠습니다. 제 사제들은 강력한 동물의 힘과 "
"민첩함을 부여할 마법으로 당신의 병사들을 강화시킬 수 있습니다. 그리고 만약 그걸로도 당신의 병사들을 보호하지 못한다면, 기도로 당신의 "
"전사들을 치유하고 완벽한 전투태세로 회복시킬 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0081_Text
#. Speaker : RankUp_Vodja
msgctxt "9f7f67bf-d024-4c33-837b-902bd7fe266a"
msgid ""
"\"Kurgess was a {g|Taldor}Taldan{/g} villager of remarkable figure! He "
"traveled around towns, visited trade fairs, took part in every competition "
"and show, and always won. It's only natural that everybody was jealous.\""
msgstr ""
"\"쿠르게스는 {g|Taldor}탈도르{/g}의 주목할만한 시골 사람이었습니다. 그는 온 마을을 떠돌며 교역 행사를 방문하고, 모든 "
"대회와 쇼에 참가하며 항상 우승했습니다. 모두의 질투를 사는 것은 당연했지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0082_Text
#. Speaker : RankUp_Vodja
msgctxt "f86d63d7-7e53-4df1-bd31-7e04a0642363"
msgid ""
"\"His rivals set a trap for him during a competition. He died, giving his "
"life to protect the other participants, but his glory lived on even after "
"his death. Few mortals are deemed worthy of joining the godly host, and "
"Kurgess was among them!\""
msgstr ""
"\"그의 경쟁자들은 경기 중에 그를 함정에 빠뜨렸습니다. 그는 다른 참가자들을 보호하고자 목숨을 바치고 죽었지만, 그의 영광은 그가 죽은 "
"후에도 계속되었지요. 신성에 합류할 가치 있는 필멸자는 몇 없지만, 쿠르게스는 몇 없는 이들 중 하나였습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0083_Text
#. Speaker : RankUp_Vodja
msgctxt "007544c6-74dd-4c82-ae24-0223e2228a55"
msgid ""
"\"Our church is young, and we don't have an established hierarchy yet. We "
"wander from town to town, healing the diseased, mentoring the weak and the "
"sick, teaching them how to harness their own powers, inspiring those who are "
"able to reach beyond their own boundaries. We do not build temples, for we "
"believe our bodies are the temples. A tent in a field, that's all we need.\""
msgstr ""
"\"저희 교단은 아직 젊고, 확립된 위계질서가 없습니다. 그저 마을을 돌아다니며, 병든 이들을 치료하고, 약자와 아픈 이들에게 그들의 "
"힘을 이용하는 방법을 가르치고, 그들 자신에게 한계를 넘을 수 있다고 영감을 줍니다. 우리는 신전을 짓지 않습니다. 우리의 몸이 곧 "
"성전이라고 믿기 때문입니다. 들판에 텐트만 있으면 됩니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0084_Text
#. Speaker : RankUp_Vodja
msgctxt "a42d2e31-2291-4f82-98fa-2adb040d34bf"
msgid ""
"\"It disgusts Kurgess when people cripple themselves, so we reject alcohol "
"and stupefying potions. I shall prohibit these among your soldiers. The "
"spirit grows stronger in a mighty body! Kurgess dislikes foul play, so "
"cheating is also illegal.\""
msgstr ""
"\"사람들이 스스로 불구가 될 때 쿠르게스는 그것을 혐오하시기에 우리는 술과 물약을 거부합니다. 병사들 사이에 이런 것들을 "
"금지하겠습니다. 강인한 정신은 강인한 육체에서 나타나는 법입니다. 쿠르게스는 반칙 역시 싫어하시기에 부정행위 역시 근절할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0085_Text
#. Speaker : RankUp_Vodja
msgctxt "e562c156-a66c-4130-a001-bea412f76fc4"
msgid ""
"{n}Dwarf laughs approvingly.{/n} \"Well, thank you! I wish you could meet my "
"grandfather! He was a real hero, stately and notable! Myself, I'm a mere "
"peasant from a small village on unclaimed land. I was once a fighter. "
"However peaceful I may be, I am still very passionate. When it comes to "
"wrestling, I can best even you! Though now I'm a priest as well.\""
msgstr ""
"{n}드워프는 만족스럽다는 듯이 웃습니다.{/n} \"흠, 감사합니다! 당신이 저희 할아버지를 만날 수 있었다면 좋겠군요.. 그는 위엄 "
"있고 주목할 만한 진정한 영웅이셨습니다. 저는 한때는 전사였지만, 그저 작은 마을에서 온 농민에 불과합니다. 이제 전 평화롭지만, 여전히 "
"매우 열정적입니다. 레슬링에 관해서는 당신보다도 더 잘 할 수 있을 겁니다! 하지만 지금 저는 성직자입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0086_Text
#. Speaker : RankUp_Vodja
msgctxt "5167735e-fedc-401c-adef-cd908f3c9c2d"
msgid ""
"\"Try throwing a kettlebell up and down. Physical effort stimulates the "
"brain.\""
msgstr "\"케틀벨 운동을 한번 해보십시오. 육체적인 노력은 뇌를 자극합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0087_Text
#. Speaker : Capital_Kassil
msgctxt "eb39c38d-27bf-4913-b566-9bcab2f37f8e"
msgid ""
"\"Your Highness, our army has grown strong enough to reckon with. There are "
"others who look to support our army, and share in the glory of our "
"victories. Representatives of three unions have arrived at the court to "
"offer their services. Unfortunately, we are forced to select only one, and "
"the others will have to leave. This is a matter of their insistence, "
"something to do with prestige.\""
msgstr ""
"\"전하, 우리 군대는 헤아릴 수 없을 만큼 강해졌습니다. 우리 군을 지지하고 승리의 영광을 함께 나누고자 하는 사람들이 있습니다. "
"3개의 조합 대표들이 서비스를 제공하고자 알현실에 도착했습니다. 불행히도, 저흰 한 명만 선택해야 하고, 다른 이들은 떠나야 할 "
"것입니다. 이는 그들의 고집과 위신의 문제입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0089_Text_String
#. Speaker : Capital_Kassil
msgctxt "a78761db-4a71-4115-8d40-6747f46fff83"
msgid ""
"\"That arrogant dwarf is going to train our soldiers?! I wonder what he can "
"offer them! Real battle isn't a time to show off, and I've never seen a "
"Kurgess priest on a battlefield. I've never heard anything of their "
"victories, either.\""
msgstr ""
"\"저 오만한 드워프에게 병사들의 훈련을 맡기실 생각이십니까?! 전 그가 무엇을 가르칠 수 있을지 정말 궁금합니다. 진짜 전투는 남에게 "
"으스댈 틈조차 없고, 전쟁터에서 쿠르게스 사제를 본 적도 없습니다. 전 그들에 관한 그 어떤 승리에 대해 들어 본 적도 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0090_Text
#. Speaker : Capital_Kassil
msgctxt "af479fdc-bf0a-40ad-b076-968bfe011b37"
msgid ""
"\"I don't trust these cutthroats. They're deadly, no doubt. But they're "
"prone to dirty tricks that ill becomes our army. I'm afraid their deeds "
"might destroy our reputation.\""
msgstr ""
"\"전 저 살인자 무리를 믿지 않습니다. 분명 엄청난 자들이겠지요. 하지만 저들은 장차 우리 군에 악영향을 끼칠 더러운 행동들을 잘 "
"해댑니다. 저들의 행동 때문에 우리 군의 평판이 깎이지 않을가 걱정되는 군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0091_Text
#. Speaker : Capital_Kassil
msgctxt "13b12f5a-2aa2-4d3b-ba9a-f4b7083b1474"
msgid ""
"\"I'll immediately begin training our shooters to use the weapons of "
"Alkenstar. I'll ask the ambassador for one for myself... to study our new "
"armaments.\""
msgstr ""
"\"우리 사수들에게 알켄스타의 무기를 사용하도록 훈련을 시작하겠습니다. 사절에게 제 무기도 하나 주문해놓지요... 우리 새로운 병기를 "
"연구하기 위해서 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0092_Text
#. Speaker : Capital_Kassil
msgctxt "76b904f1-96b7-439c-a143-2397e27d67dc"
msgid ""
"\"I dislike Arcanamirium. They're dishonest thugs. And that Kurgess priest – "
"he looks like he's about to burst with smugness. His strength is impressive, "
"but I don't like his bragging and vulgar manners. As for Alkenstar... Have "
"you seen their weapon? It's magnificent! I would love to be trained to "
"handle it! And the tactical perspective it offers! Nobody here possesses "
"anything like it!\""
msgstr ""
"\"저는 아르카나미리움이 싫습니다. 저들은 부정직한 깡패들입니다. 그리고 저 쿠르게스의 사제는, 금방이라도 온몸으로 거만함을 뿜어댈 거 "
"같군요. 저자의 힘은 인상깊으나 그 오만하고 저속한 태도가 마음에 들지 않습니다. 하지만 알켄스타는... 저들의 무기를 보셨습니까? 정말 "
"환상적이더군요! 저걸 당장이라도 배우고 싶어 몸이 근질거리는 군요! 거기다 무기가 제공하는 전략적인 관점까지! 이런 건 둘도 없는 겁니다!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0093_Text
#. Speaker : Capital_Kassil
msgctxt "34d37c18-892e-48db-b257-865030ff035e"
msgid "\"Who would you like to know about?\""
msgstr "\"누구에 대해 알고싶으십니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Main/Cue_0094_Text
msgctxt "3f847db4-0886-42d3-94ec-12bd45a6d103"
msgid "\"Your visitors will wait for as long as it takes.\""
msgstr "\"방문객들은 얼마든지 기다려 줄 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Sarenray/Answer_0004_Text
msgctxt "87d2bd66-f787-4e76-b63e-804f422bbda2"
msgid "\"How can you help my army?\""
msgstr "\"어떻게 내 군대를 도울 수 있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Sarenray/Answer_0005_Text
msgctxt "ed3f3b37-fd4d-44ee-8577-fd1cab46e0b5"
msgid "\"Tell me about your god.\""
msgstr "\"그대에 신에 대해 말해보라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Sarenray/Answer_0006_Text
msgctxt "7687ec06-92b4-4614-92f2-b4d2d43f2357"
msgid "\"What is your church?\""
msgstr "\"그대의 교단은 무엇인가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Sarenray/Answer_0014_Text
msgctxt "8c439869-2065-42ae-bb11-e859c87d786f"
msgid "\"You look... outlandish. Where do you hail from?\""
msgstr "\"그대는 좀... 이국적으로 보이는군. 어디서 왔는가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Sarenray/Answer_0022_Text
msgctxt "ec5cd648-2ae1-49db-98eb-49e56d2e64d6"
msgid "\"I need to think it over.\""
msgstr "\"재고할 시간이 필요하다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Sarenray/Cue_0001_Text
msgctxt "ec94ea09-28f1-4120-92a1-baa4d32f369c"
msgid ""
"{n}An unusually tall and sturdy dwarf with a shaved head bows to you. "
"Despite the weather, his feet are bare, and he's wearing a simple vest over "
"his naked torso.{/n}"
msgstr ""
"{n}비정상적으로 커다랗고 튼튼해보이는 드워프가 바싹 깎은 머리를 당신에게 숙입니다. 계절에 신경쓰지 않는 듯, 그 드워프는 맨발이며 "
"벌거벗은 상반신 위로 단순한 옷을 입고있습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Sarenray/Cue_0002_Text
msgctxt "1f773066-8645-4ba5-8659-e4bb4d21f359"
msgid ""
"\"Hey – let's arm wrestle, eh? Oh, no, I'm only joking. I know that Your "
"Highness is mighty busy. Is there anything I can help you with?\""
msgstr ""
"\"이봐요, 팔씨름 한판 하시죠. 예? 아, 아닙니다. 농담이었습니다. 당연히 전하께서 바쁘시다는 건 알고 있지요. 도와드릴 일이라도 "
"있으십니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Sarenray/Cue_0008_Text
msgctxt "7cc390c3-e221-47fc-ad5c-74ca2d9b034c"
msgid ""
"\"Your soldiers are... brave, but weak. By the will of Kurgess, we'll sort "
"out your pathetic forces. My priests know how to strengthen a soldier with "
"magic that will give them the power and speed of a mighty animal. And if "
"that fails to protect them, our prayers will heal your warriors and restore "
"them to perfect fighting form.\""
msgstr ""
"\"당신의 병사들은... 용감하지만 약합니다. 쿠르게스의 의지로 당신의 불쌍한 병력을 정리하겠습니다. 제 사제들은 강력한 동물의 힘과 "
"민첩함을 부여할 마법으로 당신의 병사들을 강화시킬 수 있습니다. 그리고 만약 그걸로도 당신의 병사들을 보호하지 못한다면, 기도로 당신의 "
"전사들을 치유하고 완벽한 전투태세로 회복시킬 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Sarenray/Cue_0009_Text
msgctxt "8df5c2f8-e2d0-4d1e-bdfe-080d016683b4"
msgid ""
"\"Kurgess was a {g|Taldor}Taldan{/g} villager of remarkable figure! He "
"traveled around towns, visited trade fairs, took part in every competition "
"and show, and always won. It's only natural that everybody was jealous.\""
msgstr ""
"\"쿠르게스는 {g|Taldor}탈단{/g}의 주목할만한 시골 사람이었습니다. 그는 온 마을을 떠돌며 교역 행사를 방문하고, 모든 대회와 "
"쇼에 참가하며 항상 우승했습니다. 모두의 질투를 사는 것은 당연했지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Sarenray/Cue_0010_Text
msgctxt "453a76b5-97a7-4fbd-a025-859dc5e04b66"
msgid ""
"\"Our church is young, and we don't have an established hierarchy yet. We "
"wander from town to town, healing the diseased, mentoring the weak and the "
"sick, teaching them how to harness their own powers, inspiring those who are "
"able to reach beyond their own boundaries. We do not build temples, for we "
"believe our bodies are the temples. A tent in a field, that's all we need.\""
msgstr ""
"\"저희 교단은 아직 젊고, 확립된 위계질서가 없습니다. 그저 마을을 돌아다니며, 병든 이들을 치료하고, 약자와 아픈 이들에게 그들의 "
"힘을 이용하는 방법을 가르치고, 그들 자신에게 한계를 넘을 수 있다고 영감을 줍니다. 우리는 신전을 짓지 않습니다. 우리의 몸이 곧 "
"성전이라고 믿기 때문입니다. 들판에 텐트만 있으면 됩니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Sarenray/Cue_0011_Text
msgctxt "32291f12-0a6d-4bb8-8382-14835eec6f90"
msgid ""
"{n}His mighty but pleasant voice fills the entire hall.{/n} \"Greetings, "
"Your Highness. I am Wodga, priest of the glorious god Kurgess! I believe it "
"was not by coincidence that the road brought me and my comrades to your "
"lands.\""
msgstr ""
"{n}그의 힘차지만 유쾌한 목소리가 회장 전체를 가득 채웁니다.{/n} \"안녕하십니까, 전하. 저는 영광스러운 쿠르게스의 사제, "
"보드자입니다! 저는 동지들과 저를 여기로 이끈 이 길이 우연이 아니라는 것을 믿고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Sarenray/Cue_0017_Text
msgctxt "649c794d-d003-4690-955e-bc32fa9c2a92"
msgid ""
"\"His rivals set a trap for him during a competition. He died, giving his "
"life to protect the other participants, but his glory lived on even after "
"his death. Few mortals are deemed worthy of joining the godly host, and "
"Kurgess was among them!\""
msgstr ""
"\"그의 경쟁자들은 경기 중에 그를 함정에 빠뜨렸습니다. 그는 다른 참가자들을 보호하고자 목숨을 바치고 죽었지만, 그의 영광은 그가 죽은 "
"후에도 계속되었지요. 신성에 합류할 가치 있는 필멸자는 몇 없지만, 쿠르게스는 몇 없는 이들 중 하나였습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Sarenray/Cue_0018_Text
msgctxt "7b2ec9cb-13f7-404b-8837-294172235130"
msgid ""
"\"It disgusts Kurgess when people cripple themselves, so we reject alcohol "
"and stupefying potions. I shall prohibit these among your soldiers. The "
"spirit grows stronger in a mighty body! Kurgess dislikes foul play, so "
"cheating is also illegal.\""
msgstr ""
"\"인사불성의 상태를 쿠르게스께선 혐오하시기에, 우리는 술과 물약을 거부합니다. 병사들 사이에 이런 것들을 금지하겠습니다. 강인한 정신은 "
"강인한 육체에서 나타나는 법입니다. 쿠르게스는 반칙 역시 싫어하시기에 부정행위 역시 근절할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank8/Military_Rank8Sarenray/Cue_0020_Text
msgctxt "3d91e22d-8163-4079-9e92-5bb956957fe6"
msgid ""
"{n}Dwarf laughs approvingly.{/n} \"Well, thank you! I wish you could meet my "
"grandfather! He was a real hero, stately and notable! Myself, I'm a mere "
"peasant from a small village on unclaimed land. I was once a fighter. "
"However peaceful I may be, I am still very passionate. When it comes to "
"wrestling, I can best even you! Though now I'm a priest as well.\""
msgstr ""
"{n}드워프는 만족스럽다는 듯이 웃습니다.{/n} \"흠, 감사합니다! 당신이 저희 할아버지를 만날 수 있었다면 좋겠군요.. 그는 위엄 "
"있고 주목할 만한 진정한 영웅이셨습니다. 저는 한때는 전사였지만, 그저 작은 마을에서 온 농민에 불과합니다. 이제 전 평화롭지만, 여전히 "
"매우 열정적입니다. 레슬링에 관해서는 당신보다도 더 잘 할 수 있을 겁니다! 하지만 지금 저는 성직자입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Answer_0006_Text
msgctxt "b6fc1ca7-0982-477d-9221-26dbb8facf7a"
msgid "{g|Military9_1}[Choice effects]{/g} \"Appoint a warrior to the post.\""
msgstr "{g|Military9_1}[선택 시 효과]{/g} \"전사 한 명을 임명하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Answer_0007_Text
msgctxt "21e793d7-65c4-47d0-81d5-1532c4e265e2"
msgid ""
"{g|Military9_2}[Choice effects]{/g} \"I want a mage to serve as general.\""
msgstr "{g|Military9_2}[선택 시 효과]{/g} \"장군 역할을 해줄 마법사가 하나 필요하다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Answer_0016_Text
msgctxt "8f6541b1-05eb-41ea-8d6d-055eab2aa270"
msgid "\"It's your deputy. You decide.\""
msgstr "\"그대의 부서니, 그대가 결정하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0001_Text
#. Speaker : Amiri_Companion
msgctxt "958f60df-d87c-4778-a8e0-401e0f5dfdf7"
msgid ""
"\"Chief. We need to talk. There's a problem in your... in our army. The "
"mages and warriors have been challenging one another to find out who's "
"tougher. The competition is worse than it was when you came to power. Today "
"I had to stop a knife fight.\""
msgstr ""
"\"대장. 얘기 좀 해. 대장 군대에... 문제가 생겼어. 마법사와 전사들이 서로 누가 더 강한 지를 가지고 경쟁하고 있어. 대장이 "
"권력을 잡기 전 보다도 경쟁이 더 심해. 오늘 이 싸움을 막아야겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0002_Text
#. Speaker : Regongar_Companion
msgctxt "70a75c98-4391-4599-9a13-41ca65f8e8cb"
msgid ""
"{n}Regongar looks a little banged up, and he smells like smoke.{/n} \"{name}"
", you know me. I would never cause alarm for no good reason. But right now "
"I'm telling you: there's unrest brewing in your army's ranks. And it's not "
"even proper conspirators, no! It's just the regular idiots.\""
msgstr ""
"{n}레곤가르는 조금 안 좋아보이며, 그에게서 연기 냄새가 납니다.{/n} \"{name}, 날 잘 알테지. 난 절대 사소한 일로 널 "
"부르거나 하지 않아. 하지만 지금 한 가지는 말 해야겠어. 군대에서 불안이 샘솟고 있어. 암살모의 하는 작자들은 아니긴 해. 그냥 평범한 "
"머저리들일 뿐이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0003_Text
#. Speaker : Amiri_Companion
msgctxt "8eec78bc-0b87-40c3-92f3-8a0b0ae8d802"
msgid ""
"\"Sooner or later, blood will spill and someone will die. I can always feel "
"death in the air. If you don't want to watch your warriors kill one another, "
"you should do something. Aside from appointing someone to beat the crap out "
"of the idiots.\""
msgstr ""
"\"얼마 안 있으면 피가 흐르고 누군가가 다칠 거야. 공기에서 죽음이 느껴져. 네 전사들이 서로 찔러대는 꼴을 보고싶지 않다면 뭔가 "
"조치를 취해야 해. 저 머저리들을 싸그리 조져버릴 사람을 임명해야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0004_Text
#. Speaker : Regongar_Companion
msgctxt "9a3f0ae3-c35f-41cc-883e-1f451161e376"
msgid ""
"\"Two of our commanders are bursting with ambition. Both of them have "
"outgrown their current positions. They're always challenging each other, and "
"settling their scores by stirring up our soldiers. Officer Chevold insists "
"that our infantry, the vanquisher of {g|Numeria}Numeria{/g}, rules the open "
"field. Commander Zefa argues that only mages truly understand the art of "
"battle, and the infantry are farmhands and mudbeaters. You can imagine where "
"this has led – to constant fighting among the ranks.\""
msgstr ""
"\"우리 지휘관 두 명이 서로 야심으로 경쟁하고 있어. 둘 다 현재 위치에는 맞지 않게 덩치가 너무 커졌어. 언제나 서로 경쟁하면서 "
"병사들을 들볶고 있지. 체볼트 장교는 {g|Numeria}누메리아{/g} 를 완파시킨 우리 보병대가 야전을 지배하고 있다고 말하고 있어. "
"제파 지휘관은 반면 전법을 이해하는 것은 온전히 마법사들의 몫이라며 보병들은 그냥 땅개에 불과하다고 하고 있지. 이게 계속 되면 결과는 "
"뻔할 거야. 끊이지 않는 군인들간의 충돌이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0009_Text
#. Speaker : Amiri_Companion
msgctxt "61e141a4-fd4d-40f2-bb3f-04417c25aab9"
msgid ""
"\"Chevold will make a good general. I'll train him myself. If he survives, "
"he'll be strong as a bear and smart like me.\""
msgstr "\"체볼트는 좋은 장군이 될 거야. 내가 직접 훈련시키지. 살아남으면 곰처럼 강력하고 나처럼 똑똑해질 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0010_Text_String
#. Speaker : Regongar_Companion
msgctxt "c799b917-a7b3-41b0-8f2f-c9ccb6529932"
msgid ""
"\"So you prefer the guy with a big sword to the clever girl? That's pretty "
"short-sighted. I'm disappointed, {name}.\""
msgstr ""
"\"그래서 똑똑한 여자애들 보다 커다랗기만 한 칼을 들고다니는 사내들이 좋다 이거지? 참으로 근시안적이군. 정말 실망이다, {name}."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0011_Text_String
#. Speaker : Amiri_Companion
msgctxt "dacd693a-1459-44c6-80af-f42633cd7479"
msgid ""
"{n}Amiri hems.{/n} \"That's too bad. A mage should stay in the rear and keep "
"quiet unless their magic is needed. Commanding the army is none of their "
"business. Now I'll have to watch my assistant, to make sure she doesn't "
"conjure anything stupid.\""
msgstr ""
"{n}아미리는 헛기침 합니다.{/n} \"안됐네. 마법사는 마법이 필요하지 않는 한 후방에서 조용히 있어야 하는데 말이야. 군을 지휘하는 "
"건 마법사들의 역할이 아니야. 이제 내 조수가 이상한 걸 소환해내지 않는지 감시해야겠구만.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0012_Text
#. Speaker : Regongar_Companion
msgctxt "1c8e7f4c-070f-427a-88df-b12d91c0b994"
msgid ""
"\"Good choice. A warrior needs a body that's tough enough to face the enemy "
"on the front lines, and a head that's small enough to do it without fear. "
"Mages are smarter and craftier. Zefa is your best option.\""
msgstr ""
"\"좋은 선택이다. 전사란 자고로 전방에서 적들을 막아설 정도로 몸이 튼튼해야 하고, 머리로는 공포를 몰라야 하는 법이지. 마법사들은 더 "
"똑똑하교 교활해. 제파를 선택한 건 잘 한 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0015_Text
#. Speaker : Regongar_Companion
msgctxt "e3aef873-c086-4939-a363-93b2c3402bc9"
msgid ""
"\"At first I just watched and laughed. But now it's not funny anymore. The "
"lads are so wound up, they're going to start killing each other! The "
"fighting has to be stopped. Divide the army in two. I'll take command of "
"half. A new general, Zefa, will command the other. She's the leader of the "
"mages. She's still green for now, but she's got potential. I'll put infantry "
"officer Chevold under her command. He's a swordmaster from "
"{g|Brevoy}Brevoy{/g}. That's what makes him think he can bully her. "
"Promoting her to be his immediate commander will force him to calm down.\""
msgstr ""
"\"처음엔 그냥 지켜보면서 웃었지. 하지만 이젠 더 이상 웃기지 않아. 병사들이 다쳤고, 서로 죽이려 하고 있어! 싸움을 멈춰야 해. "
"군을 둘로 나눠. 내가 절반을 맡지. 새로운 장군인 제파가 나머지를 맡을 거야. 제파는 마법사들의 우두머리야. 아직은 풋내기지만 잠재력이 "
"뛰어나지. 보병 장군인 체볼트는 제파 수하에 두겠어. 체볼트는 {g|Brevoy}브레보이{/g} 에서 온 검의 달인이야. 브레보이 "
"출신이라는 것 때문에 제파를 괴롭히려는 거 같아. 제파를 체볼트의 직속상관으로 배치 해두면 좀 잠잠해지겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0019_Text
#. Speaker : Amiri_Companion
msgctxt "9ddd0692-e23b-4fff-8a1c-c400f09a1ee6"
msgid ""
"\"It's time to show the mages that the soldiers are the real power in your "
"army. Divide the army and appoint a second general. I vote for Chevold, the "
"infantry officer. He was the very first {g|Brevoy}Brevoy{/g} swordmaster in "
"our army. He proved himself in the war with {g|Numeria}Numeria{/g}. When the "
"mage officer Zefa hears about this, she'll stop causing trouble.\""
msgstr ""
"\"마법사들에게 군의 진정한 전력은 병사들에게서 나온다는 것을 가르쳐 줄 시간이야. 군을 둘로 나누고 두 번째 장군을 임명해줘. 난 보병 "
"장군인 체볼트를 추천할 거야. 우리 군의 첫 번째 {g|Brevoy}브레보이{/g} 출신 검의 달인이지. "
"{g|Numeria}누메리아{/g} 와의 전쟁에서 충분히 그 능력을 입증했어. 마법 장교인 제파가 이 이야기를 들으면 문제를 덜 "
"일으키겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0024_Text
#. Speaker : Capital_Kassil
msgctxt "c2ea642b-2c5d-493d-9b36-24e77c7b5e27"
msgid ""
"\"Your Highness, there's unrest among the army's ranks. Your mages are "
"turning up their noses at the warriors, claiming that they're the army's "
"main assault force. There's little doubt that their power is great, but what "
"would it be worth if they weren't shielded by the infantry?\""
msgstr ""
"\"전하, 군단 사이에서 불안이 일고 있습니다. 당신의 마법사들은 전사들에게 코를 내밀며 이들이 주력 돌격대라고 주장하고 있습니다. "
"그들이 대단하다는 것은 의심의 여기자 거의 없지만, 보병들에게 방패가 되지 않는다면 무슨 가치가 있겠습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0025_Text
#. Speaker : Capital_Kassil
msgctxt "f14c04f3-1e33-41b9-b8b7-8aa943693c50"
msgid ""
"\"There have already been a few fights. And sooner or later, there will be "
"blood. We have to prevent this. And I've got a plan. You should appoint a "
"second general to show them who is more important.\""
msgstr ""
"\"이미 몇 번의 충돌이 있었습니다. 그리고 조만간 유혈사태가 일어날 것입니다. 이를 막아야만 합니다. 그리고 제게 계획이 있습니다. "
"누가 더 중한지 보여주기 위해 두 번째 장군을 임명해야 합니다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0026_Text
#. Speaker : Capital_Kassil
msgctxt "8b681488-af17-406b-a549-84243334fd52"
msgid ""
"\"If you choose Chevold, the infantry officer, the warriors won't be so "
"easily trifled with. He's a good fighter. He was among the first to join the "
"army, and he's proven himself in battle. He will be assigned the officer "
"mage Zefa. She's powerful but arrogant, and lacks experience.\""
msgstr ""
"\"보병 장교인 체볼트를 선택하신다면 전사들이 쉽게 얕보이지 않을 것입니다. 그는 훌륭한 투사이지요. 군대 창설 때부터 있던 이들 중 "
"하나이며, 전투에서 증명된 전사입니다. 그는 마법사 장교 제파에게 할당될 것입니다. 그녀는 힘이 세지만 거만하고 경험이 부족합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0027_Text_String
#. Speaker : Capital_Kassil
msgctxt "7c249242-e470-4b43-8167-6677013cd2ab"
msgid ""
"\"Do you trust the lady mage more than you trust your warriors? Or is there "
"a personal reason you refuse to listen to my reason? Do you think her wits "
"and skill in magic mean more than looking death in the eye on the front "
"lines? I'm not sure the soldiers will applaud your decision.\""
msgstr ""
"\"당신의 전사보다 그 여마법사를 더 믿으시십니까? 아니면 제 의견에 귀를 기울이지 않으시려는 개인적인 이유가 있으십니까? 그녀의 재치와 "
"마법 기술이 최전선에서 전선의 죽음을 목격하는 것보다 더 의미 있다고 생각하십니까? 당신의 결정에 병사들이 박수를 보낼지 확신할 수가 "
"없군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Military/Rank9/Cue_0030_Text
#. Speaker : Capital_Kassil
msgctxt "17a4bbfd-9544-443e-9b36-c69b1a90d089"
msgid ""
"\"A general must be able to stand in the front line and lead the troops, not "
"to sit back in the rear where the mages stay. Chevold will make a worthy "
"general!\""
msgstr "\"전사는 전선에서 군대를 지휘해야지, 마법사처럼 후방에 앉아 있어서는 안됩니다. 쉐볼드야말로 훌륭한 장군이 될 것입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Merc/Cue_0001_Text
msgctxt "cafc6eb3-fee0-4eb9-86ac-5eb96e254d44"
msgid ""
"{n}Your advisor has arrived to report about the recent Population "
"developments in your {mf|barony|barony|kingdom|kingdom}.{/n}"
msgstr "{n}당신의 보좌관이 최근의 {mf|남작령|남작령|왕국|왕국}의 주민 발전에 대해 논의하기 위해 방문했습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Answer_0017_Text
msgctxt "3538641b-9f00-4715-976d-b2c718a65b46"
msgid ""
"{g|Population10_1}[Choice effects]{/g} \"The kingdom requires developed "
"trade. I want every merchant across our lands to receive a warm welcome, "
"whether they're our own citizens or foreigners.\""
msgstr ""
"{g|Population10_1}[선택 시 효과]{/g} \"왕국은 발전된 무역을 필요로 한다. 난 우리 땅을 가로지르는 모든 상인들이 "
"우리 국민이든 외국인이든 따뜻한 환영을 받았으면 한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Answer_0018_Text
msgctxt "d266a432-1ca0-43b5-9903-ec91cf519666"
msgid ""
"{g|Population10_2}[Choice effects]{/g} \"Let them remember their less "
"fortunate neighbors. Let every poor man or a vagabond find their place on a "
"ship that sails toward opportunity, shelter, and wages.\""
msgstr ""
"{g|Population10_2}[선택 시 효과]{/g} \"그들에게 불행한 이웃을 기억하게끔 하라. 모든 가난한 이들이나 방랑자들에게 "
"배 위에서 기회, 피난처, 그리고 임금을 향해 항해하도록 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Answer_0022_Text
msgctxt "2bc3a0c8-39b7-4daa-9614-d2fbf6c66f11"
msgid ""
"{g|Population10_3}[Choice effects]{/g} \"Let them hold a celebration in my "
"honor. That will please me, and the people will have a good time!\""
msgstr ""
"{g|Population10_3}[선택 시 효과]{/g} \"그들이 나를 위해 연회를 열게끔 하라. 그것이 나를 기쁘게 할 것이고, "
"사람들도 즐거운 시간을 보내게 될 것이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Answer_0023_Text
msgctxt "63b6398c-203b-4319-940e-ffb473033b81"
msgid ""
"{g|Population10_4}[Choice effects]{/g} \"I want to develop trade. Let them "
"tend to the roads and guard foreign caravans with their lives!\""
msgstr ""
"{g|Population10_4}[선택 시 효과]{/g} \"난 무역을 발전시키고 싶다. 그들에게 도로를 순찰하게끔 하고 그들의 목숨으로 "
"외국의 캐러밴을 지키게끔 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Answer_0026_Text
msgctxt "28051da5-0dd1-4832-a6a7-c8223db81b01"
msgid ""
"{g|Population10_5}[Choice effects]{/g} \"Their crimes are serious. But I "
"expect they will to be forgiven, if each chief sacrifices a part of their "
"wealth to the temple of one of the gods.\""
msgstr ""
"{g|Population10_5}[선택 시 효과]{/g} \"그들의 범죄는 심각하다. 그러나 나는 각 우두머리들이 신전에 재산의 일부를 "
"바친다면 용서받을 거라 생각한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Answer_0028_Text
msgctxt "44668218-564b-43dd-b03f-38877acde257"
msgid ""
"{g|Population10_6}[Choice effects]{/g} \"I want my subjects to live in "
"safety. Let the bandits organize volunteer militia and to safeguard the "
"citizens' security.\""
msgstr ""
"{g|Population10_6}[선택 시 효과]{/g} \"나는 내 백성들이 안전하게 살기를 바란다. 도적들로 자경단을 조직하여 "
"시민들의 안전을 지키게끔 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "aacc097a-14f1-4bd0-839e-0b3da3d5f37b"
msgid ""
"\"I'd like to congratulate you, {name}. When you took the Stag Lord's "
"throne, you had a choice whether to rely on the support of decent, honorable "
"people – or thieves, which were then so powerful in these lands. You made "
"the right choice, and together with the people, you managed to overthrow the "
"bandits! Peasants who once cowered in fear now boldly report every crime! "
"They trust the authorities. The {g|Stolen Lands}Stolen Lands{/g} prosper "
"under your reign as never before!\""
msgstr ""
"\"축하해요, {name}. 당신이 수사슴 군주의 왕좌를 차지했을 때, 당신은 점잖고 명예로운 이들의 지원에 의지할 것인지, 도둑들의 "
"지원에 의지할 것인지 선택할 수 있었어요. 당시에 그들은 이 땅에서 꽤 강력했죠. 당신은 올바른 선택을 했고, 사람들과 함께 도적들을 "
"소탕할 수 있었어요! 한때 공포에 떨던 농민들은 이제 대담하게 모든 범죄를 신고해요! 이제 국가라는 것을 신뢰하는 거겠죠. {g|"
"Stolen Lands}도둑맞은 땅{/g}은 전에 없이 당신의 통치하에서 번성하고 있어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0002_Text
#. Speaker : Valerie_Companion
msgctxt "51080df9-896b-4fb2-b5c2-00f577e4f054"
msgid ""
"\"{name}, I'm proud to serve you. No one would have believed that the {g|"
"Stolen Lands}Stolen Lands{/g} could have turned from a criminal hotbed into "
"a secure legitimate country in such a short time. But you did it! Our youth "
"dream of becoming craftsmen, farmers and guards when they grow up, not "
"forest bandits! People that once cowered in fear of bandits now boldly "
"report every crime! It's no longer so easy for a bandit to hide among our "
"honest citizens.\""
msgstr ""
"\"{name}, 당신을 모시게 되어 자랑스럽습니다. {g|Stolen Lands}도둑맞은 땅{/g}이 이렇게 짧은 시간 안에 범죄의 "
"온상에서 안전한 합법 국가로 탈바꿈할 수 있으리라 그 누구도 믿지 않았을 것입니다. 하지만 당신은 해냈어요! 우리 청년들은 숲 도적이 "
"아니라 어른이 되어 장인, 농부, 경비병이 되는 꿈을 꿉니다! 한때 도적떼를 두려워 하던 이들도 이젠 적극적으로 모든 범죄를 신고합니다! "
"우리 정직한 시민들 사이에서 도적떼가 숨는다는 건 이제 더 이상 그렇게 쉬운 일이 아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0007_Text
#. Speaker : Octavia_Companion
msgctxt "c7461acb-a65a-428f-8c06-f8a82cbe2e62"
msgid ""
"\"{name}, you've done the impossible! You developed a mighty kingdom with "
"thieves and bandits from all across the {g|Stolen Lands}Stolen Lands{/g}! "
"Every other man in our domain keeps a bow or a mace under their bed. Who "
"could ever have imagined that the thugs could be this loyal... or grateful!\""
msgstr ""
"\"{name}, 불가능한 일을 해내셨군요! {g|Stolen Lands}도둑맞은 땅{/g}의 도적들과 함께 강력한 왕국을 건설하다니! "
"우리 땅의 모든 이들은 자기 침대 밑에 활이나 메이스를 숨겨두죠. 누가 상상이나 했겠어요? 그들이 이렇게 충성스럽거나... 감사해할 수 "
"있다고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0009_Text
#. Speaker : Octavia_Companion
msgctxt "811326b4-8085-4272-a3b5-a63f719458f4"
msgid ""
"\"A guild of river shipbuilders arrived today. They are very respected in "
"these lands, and local trade is impossible without them. They would like to "
"thank you for getting rid of the bandits, who sank most of the crafts they "
"built. They ask how they might repay you. How should we invest their energy?"
"\""
msgstr ""
"\"강의 선박공 길드가 오늘 도착했어요. 그들은 이 땅에서 매우 존경받고 있고, 그들이 없다면 지역 무역은 불가능하답니다. 자신들의 "
"제작한 배를 침몰시킨 도적들을 처치해 준 것에 대해 당신에게 감사를 표하고 싶어 하고 있습니다. 어떻게 보답할지 묻고 있는데, 그들의 "
"활기를 어떻게 투자해야 할까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0012_Text
#. Speaker : Octavia_Companion
msgctxt "ac770dd9-93f8-4bea-ad76-3523363b585b"
msgid ""
"\"If you'd failed to reckon with the forest brethren, things would have "
"turned out much worse. They truly appreciate you, their chieftain. In fact, "
"a messenger arrived only today. Several major bandit leaders send you their "
"wishes for many years of happiness, and ask how they can thank you for your "
"vision and your generosity.\""
msgstr ""
"\"산속 친구들을 염두에 두지 못했다면 상황은 더 악화되었을 거예요. 그들은 진심을 당신을 높이 평가하고 있어요. 사실, 오늘 전령이 "
"왔답니다. 여러 명의 주요 도적 두목들이 수년간의 행복에 대한 소원을 보내며 어떻게 하면 당신의 선견지명과 관대함에 감사할 수 있는지 "
"묻고 있어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0037_Text
#. Speaker : Octavia_Companion
msgctxt "e3ba6543-b3a5-495f-954e-dca062fe57cf"
msgid "\"Excellent! I'm sure the merchants will appreciate the attention.\""
msgstr "\"훌륭해요! 상인들은 그 관심에 고마워할 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0038_Text
#. Speaker : Octavia_Companion
msgctxt "a5028aec-1d99-4695-a316-1108c47d8ca5"
msgid ""
"\"That is so like you! Rather than caring about yourself and ordering a "
"statue of gold, you think of others! You're too kind! Let me pass along your "
"message.\""
msgstr ""
"\"정말 당신답네요! 자신을 아끼고 금을 모으는 것보다 다른 사람을 생각하다니! 당신은 너무 친절해요! 당신의 뜻을 널리 알릴께요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0042_Text
#. Speaker : Octavia_Companion
msgctxt "d11dbaf2-039a-4be7-8212-92fb917f4b79"
msgid ""
"\"We'll throw a magnificent singing contest! Bards from all around will sing "
"songs about your deeds, praising you and your kingdom, and the mark you've "
"left in history!\""
msgstr ""
"\"우린 멋진 노래 경연 대회를 열 거예요! 전국에서 온 병사들이 당신과 당신의 왕국을 찬양하며 당신의 업적에 대한 노래와 당신이 역사에 "
"그은 한 획을 노래할 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0043_Text
#. Speaker : Octavia_Companion
msgctxt "b80760ac-d3b2-40e4-90fb-5061023545d9"
msgid ""
"\"That is a good solution. If we engage them like this, they will feel "
"responsible for maintaining order. The next thing you know, they'll stop "
"spilling blood for no reason.\""
msgstr ""
"\"좋은 해결책이네요. 우리가 그들을 이렇게 고용하면, 그들은 질서를 유지할 책임을 느끼고, 이유 없이 피를 흘리는 걸 멈출 거예요\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0045_Text
#. Speaker : Valerie_Companion
msgctxt "cade6174-aba5-4725-aac9-c030e3f88125"
msgid ""
"\"Do you think the gods can wash away blood for gold? Hmm. But no matter, "
"this is a question of faith, not governance. I'll do as you say.\""
msgstr ""
"\"신들이 금을 위해서 피를 씻어낼 수 있으리라고 생각하십니까? 흠... 하지만 이건 통치가 아니라 믿음의 문제죠. 말씀하신 대로 "
"하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0046_Text
#. Speaker : Octavia_Companion
msgctxt "18a1d97f-d5d2-41a2-98bd-7e4206833547"
msgid ""
"\"I understand. The gods know they weren't born criminals. Everyone has "
"their own reason to do things... Things they're not proud of.\""
msgstr ""
"\"이해해요 신들은 그들이 선천적인 범죄자가 아니라는 걸 알고 계시죠. 모든 이들은 자기 나름의 이유가 있어요... 자신이 자랑스러워 "
"하지 않는 것들이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0048_Text
#. Speaker : Octavia_Companion
msgctxt "e731d7d6-b9b4-4f21-a43d-0c3a1f8f4a9a"
msgid ""
"\"That makes sense. Let the ones who have eyes everywhere help the guards "
"maintain order.\""
msgstr "\"말 되네요. 사방에 눈을 가진 이들에게 질서 유지를 돕게끔 하죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0049_Text
#. Speaker : Octavia_Companion
msgctxt "2b7f1c94-fde3-4166-bf66-1c05c6c0e63c"
msgid ""
"\"They say they recognize you as their leader. They also admit their fault "
"for failing to deal with Davor, who disrespected you. Their laws prohibit "
"them from remaining in debt. What shall we ask of them?\""
msgstr ""
"\"그들은 당신을 지도자로 인정한다고 합니다. 또한 당신을 무시한 다보어를 처리하지 못한 자신들의 잘못을 인정한다며, 자신들의 규율은 "
"자신들이 빚을 지고 있는 것을 금한다고 합니다. 그들에게 무엇을 물어볼까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0052_Text
#. Speaker : Valerie_Companion
msgctxt "c315cd86-72ee-4074-93c1-fa11631e39c0"
msgid ""
"\"People are grateful to you for the change. A guild of river shipbuilders "
"arrived at the palace today. They are highly respected in the {g|River "
"Kingdoms}River Kingdoms{/g}. They would like to thank you with a gift, for "
"ridding the rivers of the pirates who sank the ships they built. How shall "
"we put them to use?\""
msgstr ""
"\"사람들은 변화에 대해 당신에게 감사하고 있습니다. 오늘 강의 선박공들이 왕궁에 도착했습니다. 그들은 {g|River Kingdoms}"
"강의 왕국들{/g}에서 높은 존경을 받고 있지요. 자신들이 만든 배를 침몰시킨 해적들을 소탕해준 것에 대해, 감사를 표하고자 하고 있습니다. "
"어떻게 할까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0053_Text
#. Speaker : Valerie_Companion
msgctxt "ae74f7fd-aec1-4a50-9234-1e1e46b63099"
msgid ""
"\"I hope the merchants appreciate this gesture. I will convey your message "
"to them.\""
msgstr "\"상인들이 이 표시를 고맙게 여겼으면 좋겠군요. 그들에게 당신의 뜻을 전하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0054_Text
#. Speaker : Valerie_Companion
msgctxt "51e3cdd4-a6ec-439b-a380-8190eb2906a8"
msgid ""
"\"This is wise. It is best to reduce the number of desperate people in our "
"kingdom. I will pass on your suggestion.\""
msgstr "\"현명하시군요. 우리 왕국에서 절박한 사람들의 수를 줄이는 것은 최고로 중요한 사안이지요. 당신의 제안을 전하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0055_Text
#. Speaker : Valerie_Companion
msgctxt "c8c636e0-5d43-4c1a-a600-9844355b8412"
msgid ""
"\"Pardon me for saying this, but... that's a waste of money! I'll ask one of "
"your advisors to take care of it. Cultural events... aren't my thing.\""
msgstr ""
"\"이런 말씀을 드려서 죄송합니다만... 그건 돈 낭비입니다! 당신의 보좌관 중 한 명에게 부탁해서 이 일을 처리하도록 하겠습니다... "
"문화 행사라니... 제 취향은 아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0056_Text
#. Speaker : Valerie_Companion
msgctxt "e508a133-56fc-46ba-8d96-69db3f7b947b"
msgid ""
"\"I'd like to express my respect, {name}. I could never have done what you "
"did! It was no easy task to unite all our unruly troublemakers into a single "
"people, and earn their respect and trust. That takes more than just "
"willpower. It takes political vision!\""
msgstr ""
"\"존경합니다, {name}. 당신이 한 일을 전 절대로 못했을 겁니다! 이 제멋대로인 말썽쟁이들을 하나로 뭉쳐 존경과 신뢰를 얻는 일은 "
"쉬운 일이 아닙니다. 의지 그 이상의 것, 정치적 선견지명이 필요하죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0057_Text
#. Speaker : Valerie_Companion
msgctxt "7aa75cb6-8f19-41b1-b255-a68716ef96cd"
msgid ""
"\"I... don't entirely agree with you. But you decided to keep the peace with "
"the forest thugs, and even managed to come to terms with them, however shaky "
"that alliance was... Perhaps it was wise. Every other person in your domain "
"is a bandit, after all. So this brings you to the top of a strange pyramid. "
"You rule the bandits without starting a war. It's really quite unbelievable."
"\""
msgstr ""
"\"제가... 전적으로 동의한다는 것은 아닙니다. 하지만 당신은 숲속 도적들과 평화를 유지하기로 결심했고, 심지어 그들과 타협까지 "
"해내었습니다 동맹이 흔들리기도 했었지만... 현명했습니다. 당신의 영역의 사람들은 결국 도적입니다. 그러나 당인에 대한 이상한 위계질서가 "
"성립됩니다. 전쟁 없이 도적들을 다스리다니, 믿기 힘들 정도입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0058_Text
#. Speaker : Valerie_Companion
msgctxt "dc923f96-8155-4e33-9c2a-0700eceaffd6"
msgid ""
"\"The forest brethren repay you with their respect. A messenger arrived "
"today. A few chieftains declare their loyalty and ask for your orders. They "
"made a mistake letting Davor rebel, and now they wish to make amends. What "
"will you command of your, ahem, servants?\""
msgstr ""
"\"숲의 형제단에서 당신에 대한 존경심을 표합니다. 오늘 전령이 왔습니다. 몇몇 족장들이 당신에게 충성을 선언했습니다. 그들은 다보르가 "
"반란을 일으키도록 내버려 둔 실수를 저질렀고, 그것에 대해 보상하기를 원합니다. 당신의, 엣헴, 하수인들에게 무슨 명령을 내리시겠습니까?"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0059_Text
#. Speaker : Valerie_Companion
msgctxt "c598db66-b519-4d2e-8056-4a083d9863dc"
msgid ""
"\"As long as our trade routes remain safe, we can afford these bandits' fee. "
"They might even turn into regular guards over time. Who knows!\""
msgstr ""
"\"우리의 교역로가 안전하게 유지된다면, 이 도적들에게 수수료를 지불할 것입니다. 시간이 흐르면 보통 경비병이 될 수도 있겠지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank10/Cue_0060_Text
#. Speaker : Valerie_Companion
msgctxt "b1ecfaaa-a7b0-437c-ab90-ab92c08e9228"
msgid ""
"\"What a strange decision – to set forest thugs upon ordinary bandits and "
"criminals. I can't understand it, but your order will be fulfilled.\""
msgstr ""
"\"참으로 이상한 결정입니다. 산적들로 하여금 도둑들과 범죄자들을 공격하게 만들다뇨. 저는 이해할 수 없습니다만, 당신의 명령을 수행될 "
"것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Answer_0008_Text
msgctxt "16a3b8d2-68e8-4a35-bfc1-671c05ac4f2f"
msgid ""
"{g|Population2_1}[Choice effects]{/g} \"Drive this bandit from my lands, and "
"from now on do the same to any similar petitioners!\""
msgstr ""
"{g|Population2_1}[선택 시 효과]{/g} \"내 땅에서 이 도둑놈들을 쫓아내고, 이제부터 비슷한걸 들고오는 놈들에게도 "
"똑같이 해라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Answer_0009_Text
msgctxt "e837d05b-60fb-4d05-bb5a-220812eb7a77"
msgid ""
"{g|Population2_2}[Choice effects]{/g} [Gain 50 BP] \"Arrest this bandit and "
"clap him in irons. The same fate awaits any like him!\""
msgstr ""
"{g|Population2_2}[선택 시 효과]{/g} [50 BP 획득] \"이 도둑들을 체포하고 수갑을 채워라. 이런 놈들에게는 "
"똑같은 운명이 기다릴 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Answer_0010_Text
msgctxt "7f4c8270-0958-46f8-8529-4fc5c41a495c"
msgid ""
"{g|Population2_3}[Choice effects]{/g} \"I will accept this tribute. I hope "
"this good lad and his colleagues will continue to share their revenue in the "
"future.\""
msgstr ""
"{g|Population2_3}[선택 시 효과]{/g} \"이 공물은 받아들이겠다. 나는 이 훌륭한 사내와 그의 동료들이 앞으로도 "
"계속해서 수익의 일부를 나눠주길 기대한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Answer_0011_Text
msgctxt "e0419cb6-4a5e-449c-acfe-ecd1f5f66b0e"
msgid "\"You know best what to do.\""
msgstr "\"넌 무엇이 최선인지 알 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "4fe31cf7-1143-4987-bc5f-94235cd3e876"
msgid ""
"{n}Octavia looks alarmed.{/n} \"You won't believe what just happened! Some "
"crook showed up at your gates, insisting on seeing 'the {mf|lad|lass} who "
"bumped off the Stag Lord'! He says that he's brought a tribute to the new "
"chief of the {g|Stolen Lands}Stolen Lands{/g}, and asks for permission to "
"conduct his 'business' under your protection!\""
msgstr ""
"{n}옥타비아는 놀란 듯합니다.{/n} \"방금 무슨 일이 일어났는지 믿지 못할 거예요! 어떤 사기꾼이 성문 앞에 와서는, '수사슴 "
"군주를 해치운 {mf|사내|아가씨}'를 만나야겠다고 고집했어요. {g|도둑맞은 땅}도둑맞은 땅{/g}의 새로운 주인에게 드릴 공물을 "
"가져왔으니, 당신의 이름을 걸고 사업을 하게 해달라고 허가를 요청하네요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0002_Text
#. Speaker : Octavia_Companion
msgctxt "03d97f31-3050-45c6-8579-fc89b303b957"
msgid ""
"\"You don't want to be seen as another Stag Lord, and your lands as an open "
"field for thugs. Then throw this scoundrel out – along with his tribute!\""
msgstr ""
"\"수사슴 군주와 비슷한 부류로 보일 지도 몰라요. 도둑을 두 팔 벌려 환영하는 곳으로 소문날 거라구요. 사기꾼에게 공물을 돌려주고 "
"내쫓으면 안 될까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0003_Text
#. Speaker : Valerie_Companion
msgctxt "1a968543-3710-4aac-8a12-82c458f1941e"
msgid ""
"{n}Valerie enters the throne room, fiercely stabbing her heels into the "
"floor as she approaches. She stands before you and simmering with "
"indignation.{/n} \"I would never have thought that I'd commence my career as "
"Regent with such a case, but... the leader of a local gang is at your gate. "
"He's brought a chest stuffed with stolen goods, which he wants to share with "
"you – the new lord of the {g|Stolen Lands}Stolen Lands{/g}!\""
msgstr ""
"{n}발레리가 알현실로 들어옵니다. 그녀가 다가올 때마다 발뒤꿈치로 바닥을 사납게 찌릅니다. 그녀는 당신의 앞에 섰고 분노로 곧 폭발할 "
"것 같습니다.{/n} \" 제 섭정직의 시작을 이런 일로 하게 될 것이라고는 생각하지 못했습니다. 하지만... 지역 범죄조직의 우두머리가 "
"당신의 성문 앞에 와 있습니다. 그는 훔친 물건들로 가득찬 상자를 들고 왔고, 그걸 당신과 함께 나누고자 합니다. {g|도둑맞은 땅}"
"도둑맞은 땅{/g}의 새로운 군주와 함께 말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0004_Text
#. Speaker : Valerie_Companion
msgctxt "5e0bd067-724c-4a7e-8418-b65b699695be"
msgid ""
"\"I insist this impudent man be immediately arrested and brought to justice. "
"Your lands have a long and dark legacy, but your subjects fail to grasp that "
"the times of cutthroats and extortionists are over, and law rules here, now "
"and henceforth!\" {n}Valerie flares her nostrils vehemently.{/n} \"You will "
"not protect these bandits as the Stag Lord did!\""
msgstr ""
"\"저는 이 뻔뻔스러운 사람을 즉시 체포하여 재판에 회부해 주실 것을 주장합니다. {mf|영주님|영주님|전하|전하}의 땅은 길고 어두운 "
"과거를 가지고 있지만, 백성들은 살인마와 강도들의 시대가 끝났고, 이제 여기에, 앞으로도 법이 지배하고 있음을 아직도 파악하지 못하고 "
"있습니다!\" {n}발레리는 격렬하게 코구멍을 벌름거립니다.{/n} \"당신은 이 도적들을 수사슴 군주처럼 보호해선 안됩니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0005_Text
#. Speaker : Capital_Lander
msgctxt "858b014c-bfe4-4d71-84c6-8f6fafe3e28b"
msgid ""
"{n}Lander smiles.{/n} \"Oh, it's an amusing situation, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}! A former cohort of the Stag Lord – a "
"simple local bandit – has come to pay us a visit. It seems that he and all "
"the other bandits in the area believe that you are now the new lord of the "
"{g|Stolen Lands}Stolen Lands{/g}. So they sent him to pay their respects. He "
"even brings gifts!\""
msgstr ""
"{n}랜더는 미소 짓습니다.{/n} \"오, 재미있는 상황이군요, {mf|영주님|영주님|전하|전하}! 수사슴 군주의 예전 추종자들... "
"즉 그냥 동네 도적단이 우리를 방문하러 왔습니다. 이 지역 도적들은 당신이 이제 {g|Stolen Lands}도둑맞은 땅{/g}의 새로운 "
"영주라고 믿고 있는 것 같습니다. 심지어 존경의 뜻으로 선물도 가지고 왔습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0006_Text
#. Speaker : Capital_Lander
msgctxt "5b662cb0-cfb3-4f3b-8802-69bdf8de3209"
msgid ""
"\"He wishes to share his loot, so that in response you will permit him to "
"conduct his, ahem, business in your territory. It's not a bad solution – I'm "
"sure the bandits will pay generously for the right to be private tax-"
"collectors. Of course, outside your lands some may look upon this as "
"organized extortion – but what do you care about those stiffs from "
"{g|Brevoy}Brevoy{/g}?\""
msgstr ""
"\"그는 그의 전리품을 나누고 싶어 합니다. 그리해서 보답으로 당신이 그의, 에헴, 사업을 당신의 영토에서 수행 할 수 있도록 허락 "
"해주도록 말입니다. 나쁜 해결책은 아닙니다. 저는 그 도둑들이 사설 세금 징수자가 되기위한 권리를 위해서라면 후하게 지불할거라고 확신 "
"합니다. 물론 당신의 영토 바깥에서 누군가는 이걸 조직적인 강탈로 보겠습니다만, 하지만 {g|브레보이}브레보이{/g}의 빡빡한 놈들이 "
"무슨 상관입니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0012_Text
#. Speaker : Octavia_Companion
msgctxt "2c29e352-142f-4cf2-bf57-b675b667c211"
msgid ""
"{n}Octavia nods.{/n} \"Of course! I will indulge myself a bit, and let our "
"citizens chase the crook to the city gates!\""
msgstr ""
"{n}옥타비아는 고개를 끄덕입니다.{/n} \"물론이죠! 저도 몸 좀 풀겸, 우리 시민들과 같이 그 사기꾼을 성문으로 쫓아내도록 할께요!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0013_Text
#. Speaker : Valerie_Companion
msgctxt "2471935e-6cdc-4c90-af3a-e7322bd2df0c"
msgid ""
"\"So these presumptuous criminals can run rampant in someone else's lands? "
"Still, at least this may teach them half a lesson.\""
msgstr ""
"\"그럼 이 주제넘은 범죄자들이 다른 누군가의 영토에 만연하게 될까요? 여전히, 적어도 이걸로 그들은 절반정도의 교훈은 얻었을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0014_Text
#. Speaker : Capital_Lander
msgctxt "17accc32-616f-436f-b340-6ebd30728188"
msgid ""
"{n}Lander's face grows long.{/n} \"Oh, come now! You can't react like this "
"to every business proposal, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}!\" {n}Lander sighs.{/n} \"But of course, I will do as you say.\""
msgstr ""
"{n}랜더의 입이 벌어집니다.{/n} \"아, 왜 이러십니까. {mf|영주님|영주님|전하|전하}!\" {n}랜더가 한숨을 쉽니다.{/n} "
"\"하지만 알겠습니다. 당신의 명대로 하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0015_Text
#. Speaker : Octavia_Companion
msgctxt "a31ba33a-8b67-412c-ba75-6dc4322faf24"
msgid "\"You're in no mood for games today, I see! Fine, let it be so.\""
msgstr "\"오늘은 게임할 기분이 아니시군요. 알겠어요! 그냥 그렇게 놔두죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0016_Text
#. Speaker : Valerie_Companion
msgctxt "351d6e4a-8fe8-43a4-b4ab-c951e976f7fc"
msgid ""
"{n}Valerie catches her breath and allows a faint smile to show on her "
"face.{/n} \"I will carry out your orders with pleasure, {name}.\""
msgstr "{n}발레리는 숨을 죽이고 얼굴에 희미한 미소를 띱니다.{/n} \"당신의 명령을 기쁘게 수행하겠습니다, {name}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0017_Text
#. Speaker : Capital_Lander
msgctxt "dfe694e4-e873-44cf-bafe-52d62a7e8b77"
msgid ""
"{n}The smile disappears from Lander's face.{/n} \"Oh? I can't say this is a "
"wise decision: there won't be any fewer bandits in your lands… they just "
"won't be contributing to the treasury. But very well, it's up to you.\""
msgstr ""
"{n}랜더의 얼굴에서 웃음기가 사라집니다.{/n} \"오? 전 이게 현명한 결정이라고 말하기 힘들군요. 당신의 땅에는 조금의 도적들도 "
"없을 겁니다. 그건 별로 국고에 도움이 되지 않겠지요. 하지만 좋습니다. 이건 당신에게 달린 거니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0018_Text
#. Speaker : Octavia_Companion
msgctxt "07d0401a-5180-46b9-87ac-ce999c1ffaa0"
msgid ""
"{n}Octavia opens her mouth, amazed, and for a moment seems to have lost her "
"gift of speech.{/n} \"So… so we what? Just let these scoundrels rob our poor "
"citizens without fear? How can we allow this!?\" {n}The girl looks at you "
"anxiously.{/n} \"I don't know what's got into you, but I don't like this at "
"all!\""
msgstr ""
"{n}옥타비아는 그녀의 입을 벌리고 놀라며 잠깐동안 말하는 능력을 잃어버린것처럼 보입니다.{/n} \"그래서...우리가 어쩐다구요? 이 "
"불량배들이 겁도 없이 우리의 시민들을 털도록 놔둔다구요? 우리가 어떻게 이걸 허락 할 수 있죠!?\" {n}그 소녀는 당신을 걱정스럽게 "
"쳐다봅니다.{/n} \"당신에게 무슨 일이 일어나고있는지는 모르겠지만, 나는 이건 정말 싫어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0019_Text
#. Speaker : Valerie_Companion
msgctxt "1f4c3860-7756-4d17-9fd8-d3391fdf685e"
msgid ""
"{n}Valerie's face turns morbid and pale. For a moment she struggles to say "
"something, but in the end manages to force out only a single sentence, "
"through gritted teeth.{/n} \"As you wish.\""
msgstr ""
"{n}발레리의 얼굴이 아픈 듯이 창백해집니다. 잠시 동안 무언가를 말하려고 안간힘을 쓰지만, 결국 이를 갈며 단 한 문장만 "
"내뱉습니다.{/n} \"당신의 뜻대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0020_Text
#. Speaker : Capital_Lander
msgctxt "5fb9d11b-3502-48ed-a952-ee2ae8239d77"
msgid ""
"{n}Lander rubs his hands together.{/n} \"I'm sure your Treasurer will be "
"glad of this decision! Your subjects are not only the plowmen, but also such "
"adventurous folks as this one – and you can't just take away their wages!\""
msgstr ""
"{n}랜더가 두 손을 비빕니다.{/n} \"재무관이 이 소식을 들으면 좋아하겠군! 백성들이란. 시골뜨기들이라고 생각했는데 이렇게 "
"흥미진진한 도박도 할 줄 알고 말이야. 이번엔 그들 편을 들어주길 바라네!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0021_Text
#. Speaker : Octavia_Companion
msgctxt "40bafd90-c68a-4775-93c1-68213cf233af"
msgid ""
"\"Then this scoundrel and everyone like him can forget the way to these "
"lands!\""
msgstr "\"그럼 이 악당과 같은 부류들은 이 땅의 법을 잊어버릴 게 분명해요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0022_Text
#. Speaker : Valerie_Companion
msgctxt "ac5bd6c8-30c5-43aa-a8c5-82efca9f4a89"
msgid ""
"\"I will personally arrest this scoundrel, and see to it that his henchmen "
"end up in prison cells beside him.\""
msgstr "\"직접 이 악당을 체포하고 그 부하들도 같은 감방에 집어넣도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank2/Cue_0023_Text
#. Speaker : Capital_Lander
msgctxt "19e02bd4-6587-439a-aaa8-598de8716288"
msgid ""
"\"In that case I shall accept the petitioner's gifts, and discuss further "
"compensation with him.\""
msgstr "\"그런 경우라면 청원자의 선물을 받아들이고, 추후 보상에 대해 그와 논의해야 겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Answer_0011_Text
msgctxt "a289192f-4eb5-4373-bfcb-569a2db33681"
msgid "\"Return the cow to the shepherd.\""
msgstr "\"양치기에게 소를 돌려주도록 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Answer_0012_Text
msgctxt "da1cad89-f487-44bb-b662-674e040316ed"
msgid "\"Give the cow to the neighbor.\""
msgstr "\"이웃에게 소를 주도록 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Answer_0013_AlignmentShift.Description
msgctxt "100ee10d-ea20-4b55-9e8d-2f7b2790fec8"
msgid "Seized the cow from the villagers."
msgstr "마을 사람으로부터 소를 빼앗았습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Answer_0013_Text
msgctxt "89c04375-e248-4621-84d3-d02ae4e2307f"
msgid ""
"{g|Population3_3}[Choice effects]{/g} [Gain 10 BP] \"I like your idea, "
"Lander. Confiscate the cow. It belongs to the "
"{mf|barony|barony|kingdom|kingdom}.\""
msgstr ""
"{g|Population3_3}[선택 시 효과]{/g} [10 BP 획득] \"마음에 드는 제안이다, 랜더. 소를 압수하라. 그 소는 "
"{mf|남작령|남작령|왕국|왕국} 의 소유다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Answer_0014_Text
msgctxt "f2895fdb-0a3e-493e-a060-01fe86c20bc2"
msgid ""
"\"I will not deal with such trifles! Send this petitioner away, and don't "
"waste any more of my time.\""
msgstr "\"난 이런 사소한 일에 신경 쓸 시간 없어. 이 청원자를 내보내고 더 이상 내 시간을 낭비하게 하지 마라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Answer_0015_Text
msgctxt "d66b6d9c-79f1-452d-879c-27cef415268b"
msgid "\"I think you can manage this problem on your own.\""
msgstr "\"이 문제는 네가 알아서 해결할 수 있을 것 같군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "e75f5525-5fea-48ff-a0ca-eb5a72e77458"
msgid ""
"{n}Octavia smiles cunningly.{/n} \"I have good news. Your subjects, who have "
"until recently held you in distrust, now have such faith in you that they "
"insist on your final word to settle their disputes – such as the one I bring "
"you today!\" {n}Octavia giggles, but then grows serious.{/n} \"All right, "
"since we're here, we may as well help.\""
msgstr ""
"{n}옥타비아의 얼굴에 묘한 미소가 걸립니다.{/n} \"좋은 소식이 있어요. 최근까지만 해도 당신을 믿지 못하겠다는 백성이 많았잖아요? "
"이제는 어느 정도 당신을 믿나 봐요. 자기네들 분쟁을 매듭지어 달라고 도움을 요청하고 있어요. 그러고 보니, 지금 제가 하고 있는 일이 "
"바로 그거네요!\" {n}옥타비아는 킥킥 웃고는 이내 진지하게 말합니다.{/n} \"이왕 얘기가 나왔으니, 도와주는 게 좋겠어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0002_Text
#. Speaker : Octavia_Companion
msgctxt "9a2c1262-5913-42c2-bcbe-4392620094df"
msgid ""
"\"A shepherd has come to the capital, begging that you personally resolve a "
"delicate situation. You see, this shepherd has a favorite cow... please "
"don't laugh! This is important to your subjects! Well, this cow likes to "
"graze in his neighbor's yard. The neighbor was patient for a while, but then "
"locked the cow in her barn, claiming: 'If I feed the cow, then the milk is "
"mine!'\""
msgstr ""
"\"양치기 하나가 수도로 오더니, 복잡한 상황을 정리해달라고 부탁하고 있어요. 보면 이 양치기가 가장 좋아하던 소가 있어요... 웃지 "
"말라고요! 백성들에게 중요한 사안이에요! 뭐, 이 소가 이웃의 들판에서 풀을 뜯길 좋아하는 모양이더라고요. 양치기의 이웃은 한동안 조용히 "
"있다가, 어느날 소를 자기네 목장에 가두더니 이렇게 말했다네요. '우리 집 풀을 뜯었으니, 이 소의 젖도 우리 것이다!' 라고요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0003_Text
#. Speaker : Octavia_Companion
msgctxt "a6288de7-b84a-4af9-acd9-9334cf704df4"
msgid ""
"\"The shepherd and his neighbor have been quarreling for two days, and it's "
"nearly come to blows! Settle their argument for them – after all, you're the "
"{mf|baron|baroness|king|queen}!\" {n}Octavia shakes her head.{/n} \"I have "
"no idea, who I'd give the cow to. Both sides have reasonable arguments…\""
msgstr ""
"\"양치기와 그 이웃은 이틀동안 서로 볶아대더니, 이젠 투닥거리기 시작했어요! 이들의 분쟁을 해결해주세요. 어찌 되었건 간에, "
"{mf|남작님|남작님|왕|여왕} 이시잖아요!\" {n}옥타비아는 머리를 흔듭니다.{/n} \"이 소를 누구한테 줘야 할 지 전 "
"모르겠네요. 둘 다 그럴듯해서...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0004_Text
#. Speaker : Valerie_Companion
msgctxt "e3b3b488-497b-462b-b559-5dd9ef446a3c"
msgid ""
"{n}Valerie keeps silent for a few moments, pursing her lips.{/n} \"I don't "
"know where to begin... You see, your subjects, who until recently felt only "
"suspicion towards you, are gradually changing their minds. What you've been "
"able to do for the {mf|barony|barony|kingdom|kingdom} has apparently made "
"them feel that they can bring you any problem they have – even the most "
"trivial!\""
msgstr ""
"{n}발레리는 잠시 침묵을 유지하더니, 입술을 오므립니다.{/n} \"어디서부터 말을 시작해야 할지 모르겠습니다만... 보시다시피 "
"최근까지 당신에게 의심을 거두지 않던 백성들이 점차 마음을 바꾸기 시작했습니다. 여지껏 {mf|남작령|남작령|왕국|왕국}에 봉사하신 그 "
"노고 덕택에 당신이 어떤 문제든 해결해 줄 수 있다고 생각하는 것입니다. 아무리 사소한 거라도 말이지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0005_Text
#. Speaker : Valerie_Companion
msgctxt "085d67bc-234e-4277-81dd-a10ede366421"
msgid ""
"{n}Valerie sighs.{/n} \"The neighbor of a local shepherd has taken his cow. "
"Apparently, the owner let it graze in her back yard, and now the woman "
"refuses to return the animal. According to her, she tolerated the imposition "
"long enough, and now feels the milk belongs to her. The shepherd, of course, "
"is demanding the return of his property.\""
msgstr ""
"{n}발레리는 한숨 쉽니다.{/n} \"지역 양치기의 이웃이 양치기의 소를 빼앗아갔습니다. 확실히 주인이 이웃 마당에 방목을 하긴 "
"했습니다. 그래서 그 여자도 소를 되돌려주기 싫은 모양이겠지요. 그 이웃의 말에 따르면, 이미 충분히 참아왔고 이제 그 젖소가 자기 "
"것이라고 생각한다고 합니다. 양치기는 물론 자기 재산을 돌려달라고 말하고 있지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0006_Text
#. Speaker : Valerie_Companion
msgctxt "8964d21d-b960-4e98-860d-127212497355"
msgid ""
"\"As I see it, the shepherd is right. The cow belongs to him, and it must be "
"returned to the owner. Although, if you want to know my other opinion…\" {n}"
"Valerie's face becomes more stern.{/n} \"This is a matter for the village "
"chief or a village council, or something of the sort – not for the supreme "
"ruler of the lands. This {mf|barony|barony|kingdom|kingdom} may not be vast, "
"but that doesn't mean the peasants should bother you with such trifles.\""
msgstr ""
"\"제가 본 바로는, 양치기의 말이 옳습니다. 소는 양치기의 것입니다. 주인에게 되돌아가야겠지요. 하지만 제 다른 의견으로는...\" "
"{n}발레리의 얼굴이 근엄해집니다.{/n} \"이건 마을 이장이나 의회가 결정할 일이지, 이 땅의 군주가 결정할 일은 아닌 것으로 "
"사료됩니다. 이 {mf|남작령|남작령|왕국|왕국}의 크기가 크진 않지만, 그렇다고 백성들이 사소한 일을 가지고 주인을 괴롭힐 수 있다는 "
"말은 아니지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0007_Text
#. Speaker : Capital_Lander
msgctxt "42e1e96f-b7d1-4fb4-98d3-ce2622ee36d2"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}! Your subjects now "
"believe in you so sincerely that they even trust you with the fate of their "
"cattle!\" {n}Lander laughs, amused at himself.{/n} \"Don't look at me like "
"that, {mf|baron|baroness|King|Queen}, it's true! Not long ago, your peasants "
"thought you were an impostor, no better than the Stag Lord – and now they're "
"ready to hang all their troubles on your door!\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}! 이제 당신에 대한 백성들의 믿음이 자기 가축의 운명을 결정지어달라고 할 정도로 자라났군요!\" "
"{n}랜더는 혼자 신이 나서 웃습니다.{/n} \"그렇게 보지 마십시오, {mf|남작님|남작님|왕이시여|여왕이시여}, 사실인걸요! 얼마 "
"전까지만 해도 백성들은 당신을 사기꾼으로 생각했습니다. 숫사슴 군주와 하등 나을 게 없는 인물로 말입니다. 하지만 이제 백성들은 자기 "
"문제를 털어놓을 준비가 된 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0008_Text
#. Speaker : Capital_Lander
msgctxt "34c7d3a6-cade-496b-b3e8-165bb15a57dd"
msgid ""
"\"An aggrieved shepherd has come to court, demanding you deal with his "
"complicated and very mysterious case! You see, the shepherd has a cow, which "
"a neighbor has stolen from him. The woman, for her part, argues that the "
"animal has been grazing in her back yard for months, so both the cow and all "
"its milk belong to her. Oh, such brilliant village logic! Of course, the "
"shepherd is livid and demands justice.\""
msgstr ""
"\"억울해하는 양치기 하나가 궁성으로 와서 자기가 처한 복잡한 사건을 처리해달라고 하더군요! 양치기는 소를 가지고 있었습니다. 이웃이 "
"그로부터 훔쳐갔지만요. 그 여자는 자기 말로는 몇 달 동안 그 소가 자기네 마당 풀을 뜯어먹고 있었다고 합니다. 그래서 소와 그 젖 모두 "
"자기 소유라고 하더군요. 아, 정말이지 놀라운 논리입니다! 물론, 양치기는 화가 나서 판결을 요구하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0009_Text
#. Speaker : Capital_Lander
msgctxt "ebe8b1c3-74d6-4f15-8ac4-6047134a3ed3"
msgid ""
"{n}Lander smiles cunningly.{/n} \"Here's what I say. You can judge such "
"cases, if you wish to waste your time... or you can simply send some guards "
"to confiscate the cow. You'll take a modest profit and teach these foolish "
"peasants a lesson: they can solve their problems on their own, or lose "
"whatever they're quarrelling over.\""
msgstr ""
"{n}랜더는 교활하게 웃습니다.{/n} \"제 조언은 이겁니다. 시간 낭비하고 싶으시다면 이 사건을 직접 판결하십시오... 그게 싫으시면 "
"그냥 경비대 몇 명을 보내 소를 압류하면 됩니다. 저 멍청한 백성들에게 교훈을 가르쳐줌과 동시에 적당한 이득도 취하는 것입니다. 자기 "
"일은 스스로 해결하지 않으면 무엇으로 싸우고 있건 간에 자기 몫을 잃어버리게 될 거라는 교훈 정도겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0016_Text
#. Speaker : Octavia_Companion
msgctxt "4391d39e-9dc6-4f25-a3e9-ef4490e3b180"
msgid ""
"{n}Octavia nods in consent.{/n} \"The word of the "
"{mf|baron|baroness|King|Queen} is law!\""
msgstr "{n}옥타비아는 동의하며 고개를 끄덕입니다.{/n} \"{mf|남작님|남작님|왕|여왕님} 말씀이 곧 법이죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0017_Text
#. Speaker : Valerie_Companion
msgctxt "bd86123f-4797-431a-9267-8223de39c864"
msgid "{n}Valerie nods.{/n} \"Of course.\""
msgstr "{n}발레리는 끄덕입니다.{/n} \"물론이예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0018_Text
#. Speaker : Capital_Lander
msgctxt "883f372d-616c-4a39-8955-59d21b3a072b"
msgid ""
"{n}Lander cringes.{/n} \"A {mf|baron|baroness|king|queen}, deciding the fate "
"of a cow... There is something wrong about this, forgive my audacity. "
"Beware, they may start asking you which side of the bed they should get up "
"on in the morning!\""
msgstr ""
"{n}랜더는 움츠립니다.{/n} \"{mf|남작님|남작님|왕|여왕님}께서, 소의 운명이나 결정한다라... 뭔가 잘못되었습니다. 제 "
"무례를 용서하시길. 부디 조심하시길 바랍니다. 백성들은 나중 가면 아침에 어느 방향으로 일어나야 할 지까지 물어볼 테니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0019_Text
#. Speaker : Valerie_Companion
msgctxt "503953b0-8009-460d-9597-6840447ff364"
msgid ""
"{n}Valerie raises her brow.{/n} \"Do you think that's fair? Just taking "
"something that belongs to one person and giving it to another? I am sorry to "
"hear that this is your judgment.\""
msgstr ""
"{n}발레리는 눈썹을 들어올립니다.{/n} \"그게 공평하다고 생각해요? 이미 주인 있는 물건을 뺏어서 다른 사람을 준다는 게? 당신의 "
"판단이 이렇다는 게 참으로 안타깝군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0020_Text
#. Speaker : Capital_Lander
msgctxt "7208e75f-c839-472b-b395-5294146fa91e"
msgid ""
"{n}Lander bows slightly.{/n} \"I serve {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}!\""
msgstr "{n}랜더는 가볍게 목례합니다.{/n} \"{mf|영주님|영주님|전하|전하} 를 섬깁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0021_Text
#. Speaker : Octavia_Companion
msgctxt "aef97d2c-ceb6-4b47-9abc-51eca468a838"
msgid ""
"{n}Octavia looks baffled.{/n} \"How so? Your subjects trust you with an "
"important decision... and you just dismiss them? You can't do that!\""
msgstr ""
"{n}옥타비아는 당황한 것 같습니다.{/n} \"어떻게 그럴 수가? 백성들은 중대한 일로 당신을 믿었는데... 이렇게 묵살 해버린단 "
"말입니까? 이러면 안 됩니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0022_Text
#. Speaker : Valerie_Companion
msgctxt "e2637738-835f-4e3d-b51e-428fe9537e7e"
msgid ""
"{n}A contented smile crosses Valerie's face.{/n} \"I shall do precisely as "
"you ordered.\""
msgstr "{n}발레리의 얼굴에 만족한 미소가 드러납니다.{/n} \"명하신 대로 할게요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0023_Text
#. Speaker : Capital_Lander
msgctxt "af60c98a-ecac-4472-a620-54a376e20a2c"
msgid ""
"{n}Lander shrugs.{/n} \"Ah, and just when we were about to gain a dairy cow "
"for the state property fund. But as you wish.\""
msgstr "{n}랜더는 으쓱합니다.{/n} \"아, 소 한 마리를 국가 소유로 하려던 참이었습니다만, 명대로 하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0024_Text
#. Speaker : Octavia_Companion
msgctxt "f1ef61a2-0502-44d5-902c-15ad240b899a"
msgid ""
"\"I will give the cow to the neighbor. After all, without her clover there "
"wouldn't be any milk!\""
msgstr "\"이웃에게 소를 줄게요. 어쨌든 이웃의 풀이 아니었으면 저 소도 우유를 만들어내지 못했을 테니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0025_Text
#. Speaker : Valerie_Companion
msgctxt "d0b9da5f-a7b1-4c07-8239-cab230ac66ba"
msgid ""
"\"I will give the cow to the shepherd. Now make sure such issues are "
"resolved without my intervention from now on.\""
msgstr "\"소를 양치기에게 돌려주겠습니다. 이제 이런 문제는 제 간섭 없이 해결하도록 해보십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank3/Cue_0026_Text
#. Speaker : Capital_Lander
msgctxt "252f0710-c43c-41d3-9c61-1408d2fc6934"
msgid ""
"\"I will take the cow... I mean, I will order it confiscated. We must seize "
"the occasion, mustn't we?\""
msgstr "\"소를 가져가겠습니다... 그러니까, 압류하라고 명하겠다는 말입니다. 기회는 놓치지 말아야하니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Answer_0002_Text
msgctxt "6725556f-caaa-4bdb-b126-c744d7b41819"
msgid ""
"{g|Population4_1}[Choice effects]{/g} [Pay 75 BP] \"I like this idea. Let us "
"build a consulate in Brevoy.\""
msgstr "{g|Population4_1}[선택 시 효과]{/g} [Pay 75 BP] \"좋은 생각이군. 브레보이에 영사관을 짓겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Answer_0009_Text
msgctxt "f3c4d428-66dc-49b6-9f9a-25225ff3ca4f"
msgid "\"We can do without a consulate in Brevoy.\""
msgstr "\"브레보이에 영사관을 지을 필요는 없을 것 같군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Answer_0010_Text
msgctxt "d05a994a-c65e-4270-bc09-1e877c191074"
msgid "\"You can resolve this issue without me.\""
msgstr "\"나 없이도 이 문제를 해결할 수 있을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "6c82cf7a-06c4-48f3-918b-1ac15aab7d76"
msgid ""
"{n}Octavia looks embarrassed.{/n} \"I've come with... a request. Could you "
"find a diplomat to handle negotiations and politics? I lack the stamina to "
"lead complicated discussions... and I don't have time at all for politics. "
"Your subjects grow in number, and their problems multiply. It seems almost "
"everyone demands attention!\" {n}The girl smiles timidly.{/n}"
msgstr ""
"{n}옥타비아는 당황한 것 같습니다.{/n} \"저기... 요청이 하나 들어왔는데 외교관 좀 찾아주실 수 있어요? 이런 복잡한 토론을 "
"하기엔 체력이 부족해요... 행정에 힘쓸 시간이 부족해요... 점점 백성들은 늘어나고, 문제도 함께 늘어나죠. 거의 모든 백성들이 민원을 "
"넣는 것 같아요!{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0003_Text
#. Speaker : Octavia_Companion
msgctxt "45cbd7b0-2783-4876-9331-f2e47b454fd1"
msgid ""
"\"Speaking of their problems: I keep hearing about how difficult it is for "
"your subjects outside the {mf|barony|barony|kingdom|kingdom}. Especially in "
"{g|Brevoy}Brevoy{/g}, these past few weeks. Their merchants overcharge our "
"peasants or use their connections to force our people into a disadvantageous "
"agreements! Why not build a consulate there? I'm sure your subjects will "
"appreciate you taking care of them, even when they travel outside the "
"{mf|barony|barony|kingdom|kingdom}!\""
msgstr ""
"\"백성들이 어려움을 토하는 게, {mf|남작령|남작령|왕국|왕국} 밖에서 사는 백성들이 계속해서 힘들다고 하고 있어요.특히 "
"{g|Brevoy}Brevoy{/g} 에서 요 몇 주 동안 말이예요. 브레보이 상인들이 우리 백성들에게 바가지를 씌우거나 자기네 연줄을 "
"이용해 강제로 부당한 합의서에 사인을 하게 만든다고 해요! 브레보이에 영사관을 짓는 건 어떤가요? 거기 {mf|남작령|남작령|왕국|왕국} "
"밖에서도 백성들을 보살펴주면 분명 고마워할 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0004_Text
#. Speaker : Valerie_Companion
msgctxt "d8023cb1-89f8-441c-a341-febe4728dee9"
msgid ""
"{n}Valerie rubs her temple thoughtfully.{/n} \"Your "
"{mf|barony|barony|kingdom|kingdom} requires a diplomat, {name}. "
"Relationships with our neighbors require special attention. Appoint a new "
"advisor to manage this aspect of your barony.\""
msgstr ""
"{n}발레리는 자신의 관자놀이를 주무릅니다. {/n} \"{mf|남작령|남작령|왕국|왕국}에 외교관이 필요합니다, {name}. 우리 "
"이웃들과의 관계에 특별한 주의가 필요하다는 말입니다. 새 보좌관을 임명해 주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0005_Text
#. Speaker : Valerie_Companion
msgctxt "d2fb5810-8ad3-4ede-8aa3-f3a5af5f0356"
msgid ""
"\"But before you transfer these responsibilities to someone else, I would "
"like to make one suggestion. No country can ignore the interests of its "
"citizens who travel beyond its borders. Our most active trade relations and "
"cultural exchanges are with {g|Brevoy}Brevoy{/g}. I suggest we arrange with "
"them to build a consulate in their capital. Then, all your subjects who "
"visit there can enjoy our support and protection. As I see it, it's a worthy "
"investment.\""
msgstr ""
"\"이 책임을 다른 사람에게 맡기기 전에, 한 가지 제안을 하고싶습니다. 국가 입장에서 외국에 있는 백성들의 이익을 무시할 수는 없는 "
"노릇입니다. 현재 우리와 가장 무역적 및 문화적으로 교류가 활발한 곳은 {g|Brevoy}브레보이{/g}입니다. 브레보이의 수도에 "
"영사관을 짓자고 제안하고 싶습니다. 그러면 브레보이를 방문하는 모든 백성들이 우리 도움과 보호를 받을 수 있겠지요. 제가 보기엔 괜찮은 "
"투자 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0006_Text
#. Speaker : Capital_Lander
msgctxt "aaa054cd-3329-474f-a453-26e71f5e151d"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, it's time to hire "
"another advisor. You need someone who can oversee our diplomatic "
"relationships with other countries. Considering your complicated ties to "
"{g|Brevoy}Brevoy{/g}, and the character of the {g|River Kingdoms}River "
"Kingdoms{/g}, the earlier you find a talented Grand Diplomat, the better.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 다른 보좌관을 고용하셔야 합니다. 다른 국가와 우리와의 외교적인 관계를 관리할 수 있는 사람이 필요합니다. "
"{g|Brevoy}브레보이{/g}와의 복잡한 관계를 생각해보시죠. 그리고 {g|River Kingdoms}강의 왕국들{/g}의 성격 상, "
"수석 외교관을 빨리 임명할 수록 더 이득이 클 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0007_Text
#. Speaker : Capital_Lander
msgctxt "6366098d-cfbd-4b83-a995-c7d1ee61aebf"
msgid ""
"\"Speaking of diplomacy, the project of a consulate in {g|Brevoy}Brevoy{/g} "
"has appeared on my desk. This would be an establishment for your subjects, "
"who find themselves in trouble while traveling there. To my mind it's a "
"waste of money, but I felt duty-bound to inform you personally about this "
"idea.\""
msgstr ""
"\"외교 얘기가 나와서 그런데, 제 책상 위로 {g|Brevoy}브레보이{/g}에 영사관을 짓자는 안건이 올라왔습니다. 브레보이에서 "
"여행하는 백성들이 곤란에 빠졌을 때를 대비할 수 있을 겁니다. 제 의견으로는 돈 낭비입니다만, 그래도 말씀은 드려야겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0011_Text
#. Speaker : Octavia_Companion
msgctxt "d3443492-ec82-4c2c-b085-abf0bd97a13c"
msgid ""
"\"Wonderful! I'm glad that we'll be taking care of your subjects even when "
"they're traveling outside the country!\""
msgstr "\"멋지네요! 국외에서도 우리 백성들을 도울 수 있다니 참으로 기뻐요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0012_Text
#. Speaker : Valerie_Companion
msgctxt "2f5a79c4-00f2-4555-95fc-bfac56a97792"
msgid "\"Then I shall make the necessary arrangements.\""
msgstr "\"그렇다면 필요한 준비를 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0013_Text_String
#. Speaker : Capital_Lander
msgctxt "4de8647c-ad65-4c11-9efd-d005ac57aeb9"
msgid ""
"\"Hmm. As you wish, {mf|Your Grace|Your Grace|Your Highness|Your Highness}.\""
msgstr "\"흐음. 원하시는 대로, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0014_Text_String
#. Speaker : Octavia_Companion
msgctxt "0c08137d-286e-4514-adf7-3f730d311087"
msgid ""
"{n}Octavia grows dark.{/n} \"So you'll just let these matters slide? I "
"expected better from you.\""
msgstr "{n}옥타비아의 얼굴이 어두워집니다.{/n} \"이 문제를 그냥 넘겨버릴 거예요? 실망이네요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0015_Text_String
#. Speaker : Valerie_Companion
msgctxt "b0df4474-fd01-4a69-8e80-75a91fde9fe5"
msgid ""
"{n}Valerie frowns.{/n} \"Without legal support, your subjects will feel that "
"the weakness of their position is a reflection of their ruler's weakness. "
"But it's up to you – I'm only pointing out the potential for future problems."
"\""
msgstr ""
"{n}발레리는 찡그립니다.{/n} \"법적으로 도와주지 않는다면 백성들은 이게 군주의 외교적 약점을 반영하는 거라고 생각할 겁니다. 다 "
"당신에게 달려있습니다. 제가 한 말은 그냥 미래에 일어날 수 있는 잠재적 사건에 대해 말한 것 뿐입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0016_Text
#. Speaker : Capital_Lander
msgctxt "63bf3caa-768d-43fb-b369-b778db9a1a9f"
msgid ""
"{n}Lander nods.{/n} \"I am sure {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness} can find better uses for the "
"{mf|barony's|barony's|kingdom's|kingdon's} resources.\""
msgstr ""
"{n}랜더는 끄덕입니다.{/n} \"{mf|영주님|영주님|전하|전하} 께서는 분명 {mf|남작령|남작령|왕국|왕국} 의 자원을 보다 "
"현명하게 쓸 수 있으실 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0017_Text
#. Speaker : Octavia_Companion
msgctxt "c9f80512-4931-474c-a607-104111113e6a"
msgid ""
"\"I will arrange everything. I do hope {g|Brevoy}Brevoy{/g} supports this "
"project!\""
msgstr "\"제가 다 준비할게요. {g|Brevoy}브레보이{/g} 도 이 계획을 좋아하면 좋겠네요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0018_Text
#. Speaker : Valerie_Companion
msgctxt "b4938f56-592f-4d3e-9e34-f802b90c203a"
msgid ""
"\"I will send a few letters, and wait for an answer from {g|Brevoy}Brevoy{/g}"
". I think they will approve of the idea of building a consulate.\""
msgstr "\"편지를 몇 장 보내서 {g|Brevoy}브레보이{/g} 측의 답장을 기다리겠습니다. 제 생각엔 승인해 줄 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/Cue_0019_Text
#. Speaker : Capital_Lander
msgctxt "519abb0c-5050-479c-b6dd-3236ba002894"
msgid ""
"\"Nothing could be simpler! I just won't do anything. The easiest decision "
"of my entire regency!\""
msgstr "\"이렇게 쉬운 일이라니! 아무것도 안 하고 있겠습니다. 제 보좌 역사상 가장 쉬운 일이로군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/LebedaBYE_String
#. Speaker : Capital_Lander
msgctxt "d7aa5c08-fab0-4555-b60d-473bcaa2962d"
msgid ""
"{n}Lander yawns ostentatiously.{/n} \"{mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}, I wonder: have you noticed anything odd lately? For "
"example, that I'm trying my best to help you, and you... you simply dismiss "
"my advice! I think I should step down and let someone else take this "
"position. Of course, I will, as always, remain present at your court as an "
"envoy. But as for everything else – you know better than I, what the "
"{mf|barony|barony|kingdom|kingdom} needs.\""
msgstr ""
"{n}랜더는 과장되게 하품합니다.{/n} \"{mf|영주님|영주님|전하|전하}, 최근에 뭔가 이상한 것을 눈치 채셨는지 궁금하군요. "
"예를 들면, 제가 최선을 다해 당신을 돕고자 하는데... 그냥 제 의견을 묵살만 하시잖습니까! 아무래도 이 자리에서 물러나 다른 사람이 "
"이 직위를 맡도록 하셔야 할 거 같습니다. 물론, 언제나 그랬듯, 전 이 궁성에서 사절로 남아있을 겁니다. 하지만 그 외에는... 저보다 "
"{mf|남작령|남작령|왕국|왕국} 정세에 밝으신 거 같으니 물러나지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/OctaviaBYE_String
#. Speaker : Octavia_Companion
msgctxt "81d4c475-2c4e-48e6-a510-7cfd7398925b"
msgid ""
"\"I've had enough. I've tried my best to make your job easier, but you have "
"an opinion about everything! I think you need another Regent – someone who "
"cares less about her work than I do!\" {n}Octavia sighs.{/n} \"I'm sorry, "
"but you really will have to find another advisor to fill my post.\""
msgstr ""
"\"이제 그만 할래요. 최선을 다해서 일을 쉽게 만드려고 하는데, 모든 것에 토를 달잖아요! 다른 섭정을 찾아보세요. 저보다 일에 신경 "
"덜 쓰는 사람으로 말이죠! \" {n}옥타비아는 한숨 쉽니다.{/n} \"미안해요. 하지만 정말로 저 말고 다른 사람을 찾아보길 바라요."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank4/ValerieBYE_String
#. Speaker : Valerie_Companion
msgctxt "0da8dd78-4d34-459d-82f6-4c1ca3c6f435"
msgid ""
"\"I will do precisely as you say. But after this I will step down from "
"office. Our opinions on the administration of a country are simply too "
"different. Thank you for your trust, but you will simply have to find "
"someone else to fill the Regent's position.\""
msgstr ""
"\"당신이 시키시는 일을 그대로 했습니다. 하지만 이젠 여기서 내려와야 할 거 같습니다. 치국에 대한 우리 의견이 너무 다른 것 같군요. "
"믿어주셔서 감사했습니다만, 저 말고 다른 섭정 자리를 구해주시길 바라겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Answer_0017_AlignmentShift.Description
msgctxt "6df58e2a-958a-4917-aca9-6564998f5e1e"
msgid "Reimbursed the merchant's stolen goods."
msgstr "상인이 잃은 상품을 배상해주었습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Answer_0017_Text
msgctxt "058a1d7b-91b9-4306-b2b0-d57b4a408c22"
msgid ""
"{g|Population5_1}[Choice effects]{/g} [Pay 100 BP] \"Send guards to search "
"for Davor. Take care of the merchant and reimburse him for the stolen goods."
"\""
msgstr ""
"{g|Population5_1}[선택 시 효과]{/g} [100 BP 지불] \"경비를 보내 다보르를 찾아라. 상인을 잘 보호하고 잃은 "
"상품을 배상해주라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Answer_0018_Text
msgctxt "da47ad86-81e8-4d0f-b2f1-c25a847d2d48"
msgid ""
"{g|Population5_2}[Choice effects]{/g} \"Send guards to search for Davor. "
"Regarding the reimbursement... the Brevan will have to do without it.\""
msgstr ""
"{g|Population5_2}[선택 시 효과]{/g} \"경비를 보내 다보르를 찾아라. 배상에 대한 건... 그 브레보이인에겐 아무것도 "
"해주지 않을 거다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Answer_0019_AlignmentShift.Description
msgctxt "6b2e9ee7-2d11-473c-bace-e441ffd14c1b"
msgid "Ignored bloody banditry on the roads."
msgstr "길가의 피비린내 나는 도적질을 무시했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Answer_0019_Text
msgctxt "65937dfe-c90f-4883-89a5-d906c6221966"
msgid ""
"{g|Population5_3}[Choice effects]{/g} \"Let him deal with his problems "
"himself.\""
msgstr "{g|Population5_3}[선택 시 효과]{/g} \"알아서 처리하게 두라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Answer_0020_Text
msgctxt "816dd232-7786-4a00-bb95-5bb32b9cc69d"
msgid "\"I think you already know what should be done.\""
msgstr "\"뭘 해야 하는 지 이미 알고있는 듯 하군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Answer_0040_Text
msgctxt "837736fa-1fcb-43a4-8dfb-052d943b9e9e"
msgid ""
"{g|Population5_4}[Choice effects]{/g} [Pay 100 BP] \"Give him some money and "
"let him go in peace. We're not interested in hunting for robbers.\""
msgstr ""
"{g|Population5_4}[선택 시 효과]{/g} [100 BP 지불] \"돈 좀 주고 평화롭게 보내라. 강도 사냥에는 관심 없다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "6de8b1fa-c06a-4fc9-ae34-baa04c0afd1e"
msgid ""
"\"There's been an accident, {name}! A wounded man is at our gates, all "
"scratched up and covered in blood. He's a noble merchant from "
"{g|Brevoy}Brevoy{/g}, whose caravan was waylaid by robbers. All of his "
"traveling companions were killed! He's the only survivor.\""
msgstr ""
"\"사고가 있었어요, {name}님! 문 앞에 피투성이가 된 사람이 온몸에 상처를 입고 쓰러져있어요. 그 남자는 "
"{g|Brevoy}브레보이{/g}에서 온 귀족 상인이예요. 강도들에게 마차는 습격받았고 모든 동행자가 살해당했어요! 혼자 살아남았어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0002_Text
#. Speaker : Valerie_Companion
msgctxt "3cc3aa3b-6747-46fa-9b5e-f727a2a152d4"
msgid ""
"{n}Valerie clutches her sword.{/n} \"{name}! By the gate there a man who "
"survived an ambush. He's a nobleman from {g|Brevoy}Brevoy{/g}, whose caravan "
"was waylaid by bandits. His companions were all killed, and he's very lucky "
"to be alive himself.\""
msgstr ""
"{n}발레리는 검을 움켜쥐었습니다.{/n} \"{name}님! 성문 앞에 습격에서 살아남은 남자가 있습니다. "
"{g|Brevoy}브레보이{/g}에서 온 귀족입니다. 강도들에게 마차는 습격당했고 모든 동료가 살해되었습니다. 운이 좋게도 혼자 "
"살아남았습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0003_Text
#. Speaker : Capital_Lander
msgctxt "5f2bdcaa-d326-40e6-88c7-e18e0dbcb514"
msgid ""
"{n}Lander smiles carelessly.{/n} \"{mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}! A poor fellow, a nobleman from {g|Brevoy}Brevoy{/g}, has "
"been found near the gates. Sadly, his caravan was ambushed. It seems the "
"bandits who live in the forest claimed it for themselves.\""
msgstr ""
"{n}랜더는 조심성 없게 미소지었습니다.{/n} \"{mf|영주님|영주님|전하|전하}! {g|Brevoy}브레보이{/g} 에서 온 불쌍한 "
"귀족 하나가 성문 근처에서 발견되었습니다. 안타깝게도 그 상단이 습격당했습니다. 숲에 사는 도적떼가 그런 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0004_Text
#. Speaker : Octavia_Companion
msgctxt "7dd79e54-9a53-44ff-b28c-fe66ff3ce9bb"
msgid ""
"\"This ambush was carried out by the infamous villain, Davor the Grey! He's "
"returned to our lands, to continue his dirty deeds. He's not known for his "
"mercy, and responds only to force.\""
msgstr ""
"\"이 습격은 유명한 악당인 회색의 다보르가 한 짓이예요! 우리 땅으로 돌아와선 더러운 행동을 계속 하고 있죠. 자비는 보이지 않고 "
"언제나 힘으로 모든 것을 쟁취하는 놈이예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0005_Text
#. Speaker : Octavia_Companion
msgctxt "140a3b32-dc02-4770-8776-a8864333e6cd"
msgid ""
"\"Davor the Grey is behind this assault. I suspect he'll soon be bringing us "
"gifts... as soon as he's cleaned the blood off them!\""
msgstr ""
"\"회색의 다보르가 이 습격의 배후에 있어요. 그자가 곧 우리에게 선물을 가져오겠네요... 피를 모조리 씻어내자마자 말이예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0006_Text
#. Speaker : Octavia_Companion
msgctxt "33e0ed61-4555-46f5-a6dc-d1ab3f71eb31"
msgid ""
"\"Davor the Grey was in command of the robbers. I have no idea how he "
"managed to escape from prison. An old accomplice of his must have tricked "
"the guards or helped him somehow.\""
msgstr ""
"\"회색의 다보르는 도적들을 지휘하고 있어요. 어떻게 감방에서 도망쳤는지 모르겠네요. 공범이 나서서 경비를 속이고 다보르를 어떻게든 도운 "
"게 틀림없어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0007_Text
#. Speaker : Octavia_Companion
msgctxt "c173e58f-0839-4183-a471-7a38863b263b"
msgid ""
"\"The man from {g|Brevoy}Brevoy{/g} is frightened and outraged. And it is, "
"after all, somewhat our fault. He was robbed on our land, where he's "
"supposed to be under our protection. He wants us to find and punish the "
"robbers, and compensate him for the damages. I think we should comfort this "
"poor man. How would you feel in his position?\""
msgstr ""
"\"{g|Brevoy}브레보이{/g} 에서 온 사람은 두려워하며 분개해하고 있어요. 그리고 이건 전적으로 보면 우리 잘못이예요. 우리가 "
"보호를 제공해야 할 우리 땅에서 강도질을 당했으니 말이예요. 그 귀족은 강도를 찾아 벌을 주고, 입은 피해에 대해 보상을 해달라고 하고 "
"있어요. 이 불쌍한 사람을 도와야 할 거 같아요. 어떻게 생각하시나요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0009_Text
#. Speaker : Valerie_Companion
msgctxt "b877e563-f224-4a10-84e1-f7e14be474d6"
msgid ""
"\"It was Davor the Grey who arranged the ambush. As I said, he should have "
"been put in jail immediately.\""
msgstr "\"습격을 준비한 자는 회색의 다보르 입니다. 제가 말씀 드렸지만, 이자는 즉시 감옥으로 보내져야 하는 놈 입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0010_Text
#. Speaker : Valerie_Companion
msgctxt "df0c120d-2fce-4a96-93b9-3b8ace861a88"
msgid ""
"\"It was Davor the Grey who arranged the ambush. The one whose bloody gifts "
"you so gladly accepted.\""
msgstr "\"습격을 준비한 자는 회색의 다보르 입니다. 이렇게 피투성이의 선물을 보내올 줄은 몰랐군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0011_Text
#. Speaker : Valerie_Companion
msgctxt "62ded391-a187-4d8d-85f3-1495cf8c5bea"
msgid ""
"\"It was Davor the Grey who arranged the ambush. I already demanded an "
"explanation from the other prisoners. It turns out he escaped through a "
"tunnel he dug.\""
msgstr ""
"\"습격을 준비한 자는 회색의 다보르 입니다. 이미 다른 죄수들한테 설명을 들어놨습니다. 알고 보니 감옥에서 판 땅굴로 도망친 "
"모양이더군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0012_Text
#. Speaker : Valerie_Companion
msgctxt "4a79614b-d6e5-4c17-b629-5fa8b11337f2"
msgid ""
"\"The Brevan wants us to find the robbers, and he's every right to make such "
"demands. But then his business sense prevailed, and he asked us to "
"compensate his losses. Now this I consider most arrogant! We cannot be held "
"responsible for his caravan! It's Davor that owes him, not you.\""
msgstr ""
"\"그 브레보이인은 도적들을 찾고싶어 합니다. 그럴만도 하지요. 하지만 사업적 감각도 드러내더군요. 우리에게 손해에 대한 보상을 요구하고 "
"있습니다. 이거 참으로 건방지지 않습니까! 이 상단에 대해 책임을 질 수 없습니다! 책임을 져야하는 건 다보르지 우리가 아니지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0013_Text
#. Speaker : Capital_Lander
msgctxt "72c16ff0-190c-4348-9db7-52082b949ca5"
msgid ""
"\"It was Davor the Grey who arranged the ambush, the bandit you expelled so "
"carelessly. He must be very angry. Just think how we might have treated him "
"differently, and made him into your obedient hound.\""
msgstr ""
"\"습격을 준비한 건 회색의 다보르이며, 얼마 전에 별 생각 없이 쫓아버린 그 도적입니다. 분명 화가 엄청났겠지요. 우리 그놈을 대할 때 "
"좀 다르게 해서, 말 잘 듣는 사냥개로 키우면 어떤지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0014_Text
#. Speaker : Capital_Lander
msgctxt "02b4cc64-5dc8-4fd3-a5e1-d0436e2beeb2"
msgid ""
"\"It was Davor the Grey who arranged the ambush. See how hard he works to "
"fill your coffers.\""
msgstr "\"습격을 준비한 것은 회색의 다보르입니다. 우리 금고를 채워주기 위해 그자가 얼마나 노력한 지 한 번 살펴보시지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0015_Text
#. Speaker : Capital_Lander
msgctxt "615c709e-0104-4bb0-a53f-14f4654f8377"
msgid ""
"\"The gang's leader was Davor the Grey, who you so carelessly imprisoned. He "
"only recently escaped, and he has a lot to catch up on.\""
msgstr ""
"\"그 도적단의 우두머리는 회색의 다보르로, 부주의하게 가둬놓았던 그자 입니다. 얼마 전에 탈출을 했고, 우리에게 갚아줄 게 많은 "
"모양입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0016_Text
#. Speaker : Capital_Lander
msgctxt "490d7313-682c-449d-b80d-40585804ad48"
msgid ""
"\"The merchant demands that we find and hang the ambushers, and compensate "
"him for his damages. What makes him think we're ready to pay? Was it we who "
"robbed him? Did he pay us to ensure his safety? Nothing of the sort. We must "
"send a message to him and all the other merchants: anyone looking to travel "
"safely across our lands should dip into their purses. Just ignore his "
"whining, {mf|Your Grace|Your Grace|Your Highness|Your Highness}.\""
msgstr ""
"\"그 상인은 우리에게 습격자를 찾아 목을 매달라고 요구해오고 있으며, 자기가 입은 피해를 보상해달라고 하고 있습니다. 왜 우리가 돈을 "
"줄 거라고 생각하는 걸까요? 우리가 그 양반을 털었습니까? 우리에게 보호세라도 줬냐는 말입니다. 전혀 아니지요. 그자와 다른 상인들에게 "
"말을 전해야 합니다. 우리 땅을 안전하게 지나가려면 돈 좀 깨나 써야 할 거라고 말입니다. 그 징징거림은 무시하시지요, "
"{mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0022_Text
#. Speaker : Octavia_Companion
msgctxt "6bacbd7d-942e-4535-9c4e-6803a8e6597a"
msgid ""
"\"Perfect! We'll find Davor, and this time he won't get away so easily. The "
"merchants will see that we're tough on murderers.\""
msgstr ""
"\"완벽해요! 다보르를 찾아서 이번엔 그렇게 쉽게 못 도망치게 해야겠어요. 상인들에게 우리가 살인자에겐 강경하다는 걸 볼 수 있을거예요."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0023_Text
#. Speaker : Valerie_Companion
msgctxt "16def1db-cb35-41f7-a904-2be032225c9c"
msgid ""
"\"You're far too generous. On the other hand, a good reputation never did "
"anyone any harm.\""
msgstr "\"자비가 지나치십니다. 뭐 달리 말하면, 좋은 평판이 누가 되는 일은 없지만 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0024_Text_String
#. Speaker : Capital_Lander
msgctxt "3b5e4a12-60d2-4307-b416-3502ba9f6e96"
msgid ""
"\"You act as though you have another set of subjects in your pocket, who are "
"somehow entirely different from Davor. Don't you understand that by "
"prosecuting him, you are making half your citizens nervous? They're all "
"doing the same thing, you know.\""
msgstr ""
"\"마치 주머니 속에 다보르랑 전혀 다른 성향의 백성들을 들고다니시는 것 처럼 행동하시는 군요. 우리가 다보르를 잡아 죽이면, 백성들 "
"절반이 불안해 할 거라는 것을 이해 못 하시는 겁니까? 아시겠지만 백성들도 다 그렇게 행동하고 있단 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0025_Text
#. Speaker : Octavia_Companion
msgctxt "a92ab9c8-3f2f-4334-9137-17905ae1f2e2"
msgid ""
"\"Very well, I don't like the fact that he's so concerned with his money, "
"either. He should thank gods for keeping him alive, not rush to fill his "
"pockets!\""
msgstr ""
"\"좋아요. 저도 그 사람이 그렇게 돈에 환장했다는 게 마음에 들진 않아요. 목숨을 살려줬다는 걸 고맙게 여겨야지, 빈 주머니나 "
"채우겠다고 그렇게 달려들다뇨!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0026_Text
#. Speaker : Valerie_Companion
msgctxt "75b13b6c-2276-4db6-8328-fd5910a86313"
msgid ""
"{n}Valerie looks determined.{/n} \"We won't stop until we have that villain "
"cornered! He shall pay for his deeds.\""
msgstr ""
"{n}발레리는 단호하게 말합니다.{/n} \"우린 저 악당이 궁지에 몰릴 때까지 멈추지 않을 겁니다! 그의 행동에 대한 대가를 치르게 "
"해주죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0027_Text
#. Speaker : Capital_Lander
msgctxt "a6a9db16-dc13-47df-8966-e999af4cecb2"
msgid ""
"{n}{g|House Lebeda}Lebeda{/g} rolls the eyes.{/n} \"Oh, but what's the "
"point? {mf|Your Grace|Your Grace|Your Highness|Your Highness} will cut "
"Davor's head off, and the locals will elect a new chieftain, who will step "
"up and cause the same trouble that Davor did. Mark my word!\""
msgstr ""
"{n}{g|House Lebeda}레베다{/g}는 눈을 이리저리 굴립니다.{/n} \"아, 하지만 그게 무슨 소용인가요? "
"{mf|영주님|영주님|전하|전하} 께서 다보르의 목을 베실 것이고, 주민들은 다보르가 했던 것과 같은 문제를 일으킬 새로운 대장을 뽑을 "
"겁니다. 제 말 꼭 기억하십시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0028_Text_String
#. Speaker : Octavia_Companion
msgctxt "d742acdd-d524-480a-b6e2-5712af80c8c3"
msgid ""
"{n}Octavia sniffs and clenches her fists.{/n} \"This... is wrong. People are "
"being ambushed and killed on our roads, and you... how many more will die by "
"his hand?\""
msgstr ""
"{n}옥타비아는 훌쩍이며 주먹을 불끈 쥡니다.{/n} \"이건... 잘못됐어요. 사람들은 습격으로 인해 죽어가고 있어요. 그리고 "
"당신은... 얼마나 많은 이들을 그의 손에 죽게 만들 건가요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0029_Text_String
#. Speaker : Valerie_Companion
msgctxt "fc9ca3a3-7039-4750-b4ff-561ff439b746"
msgid ""
"{n}Valerie stays silent for a few seconds. Then she speaks somberly.{/n} "
"\"This goes against the law, and against all good conscience. Robbers should "
"be executed. But... I shall inform him of your decision.\""
msgstr ""
"{n}발레리는 잠시 침묵하다 침울하게 말을 꺼냅니다.{/n} \"이건 법이 위배되고, 모든 양심에 위배됩니다. 강도들은 처형되어야만 "
"합니다. 하지만... 그에게 당신의 결정을 알리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0030_Text
#. Speaker : Capital_Lander
msgctxt "031ff4bc-88d7-4921-a68e-c352eac1f6c6"
msgid ""
"\"Wonderful. Rest assured, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}, this will do your treasury good. Merchants are always trying to "
"avoid taxation, hide their goods, pass fake gold and the like. Robbery is a "
"far more honest profession. Our forest brethren are happy to pay their fair "
"share to {mf|Your Grace|Your Grace|Your Highness|Your Highness} – in a "
"timely manner and without quarrel.\""
msgstr ""
"\"멋지군요. 편히 쉬시길,{mf|영주님|영주님|전하|전하}, 이로써 국고가 가득 찰 겁니다. 상인들은 언제나 징세를 회피하고, 상품을 "
"숨기면서 가짜 돈이나 건네는 놈들이지요. 도적질은 보다 정직한 직업입니다. 우리 숲의 형제들은 기꺼이 자신들의 수익을 "
"{mf|영주님과|영주님과|전하와|전하와} 나눌 것입니다. 다툼도 없이 참으로 시의적절한 방안이지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0031_Text
#. Speaker : Octavia_Companion
msgctxt "44592de0-444f-42f2-a80b-e3d9e84dc39f"
msgid ""
"\"We will pay for the merchant's lost goods, and we'll send our people to "
"search for Davor. Assault and robbery cannot be tolerated!\""
msgstr "\"상인이 잃은 상품에 대해 보상해주고, 사람들을 보내 다보르를 찾겠어요. 습격과 강도질은 용납할 수 없으니 말입예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0032_Text
#. Speaker : Valerie_Companion
msgctxt "f0ca691a-133d-4b20-84d3-ca30be0542ed"
msgid ""
"\"The merchant is lucky to be alive. But it wasn't we who assaulted him. We "
"didn't steal his goods. So he shall get no compensation from us. However, "
"justice will be done. We'll send a troop to find Davor.\""
msgstr ""
"\"상인이 살아서 다행입니다. 하지만 그를 습격한 건 우리가 아니지요. 물건도 빼앗지 않았고요. 그렇기에 우리가 보상해줄 일은 없을 "
"것입니다. 하지만 심판은 할 겁니다. 부대를 보내 다보르를 찾겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0033_Text
#. Speaker : Capital_Lander
msgctxt "f4fcd401-14a7-42a5-8082-53547a6f2739"
msgid ""
"\"That merchant can go to hell. I hereby announce a new law: if you wish to "
"take a road through the {g|Stolen Lands}Stolen Lands{/g}, make sure you pay "
"its {mf|baron|baroness} the proper fee, or you risk being robbed of all your "
"belongings.\""
msgstr ""
"\"상인은 지옥으로 꺼지라지요. 새로운 법을 제정하겠습니다. {g|Stolen Lands}도둑맞은 땅{/g} 의 길을 지나려면, 그 땅을 "
"다스리는 {mf|남작|남작} 께 적절한 요금을 내든지, 아니면 스스로 위험을 무릅쓰고 가진 걸 모두 다 뺏기든지 라고 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0041_Text_String
#. Speaker : Octavia_Companion
msgctxt "b73867cc-7289-4a12-8e60-e4cc390d5a42"
msgid ""
"\"That is most generous. But we should focus on the murdered caravan escort, "
"who will never need gold again, rather than consoling the merchant for his "
"lost goods. We need to capture those cutthroats!\""
msgstr ""
"\"참으로 자비로우시군요. 하지만 자기 물건을 잃은 상인을 위로하는 것 보단 목숨을 잃은 그 상단 호위병에 더 집중해야 해요. 그 "
"도적들을 잡아야만 해요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0042_Text_String
#. Speaker : Valerie_Companion
msgctxt "f16ea051-429f-4be1-93a9-f5a7fa3601d9"
msgid ""
"\"Hm... Will we pay compensation to all who ever were or will be robbed? Or "
"only the people we like? Only wealthy and influential foreigners perhaps? "
"This doesn't smack of justice at all.\""
msgstr ""
"\"흠... 우리 땅에서 강도를 맞은 사람들 모두에게 보상을 해주시려는 겁니까? 아니면 우리 마음에 드는 사람들에게만 해주시려는 겁니까? "
"돈 많고 영향력있는 외국인들에 한정해서만 보상을 해줄까요? 이건 전혀 공평하지 않습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5Robbery/Cue_0043_Text_String
#. Speaker : Capital_Lander
msgctxt "11f05472-24de-4448-ac22-fbcd15d0c876"
msgid ""
"{n}Lander frowns.{/n} \"So it turns out it's not he who has been robbed... "
"it's us? Sometimes I simply do not understand your decisions.\""
msgstr ""
"{n}랜더는 찡그립니다.{/n} \"강도를 당한 건 그 사람이 아니군요... 우리가 당해버렸어요. 가끔은 당신의 결정이 이해가 되지 않을 "
"때가 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Answer_0005_Text
msgctxt "2e3f1f88-54e1-4d2c-b864-8f5125632ed1"
msgid ""
"{g|Population5_5}[Choice effects]{/g} \"We need money and that means "
"business. I'm willing to make a deal.\""
msgstr ""
"{g|Population5_5}[선택 시 효과]{/g} \"우리는 돈이 필요하고, 돈을 위해서는 사업이 필요하지. 거래하지 않을 이유가 "
"없어 보이는군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Answer_0006_Text
msgctxt "ed65a745-1e5b-49b3-9233-2dbb255cac65"
msgid ""
"{g|Population5_6}[Choice effects]{/g} \"We're not Brevoy's dump. Let them "
"find another place to put their trash.\""
msgstr ""
"{g|Population5_6}[선택 시 효과]{/g} \"우리는 브레보이의 쓰레기들을 처리해주는 곳이 아니니 다른 곳을 찾아보라고 해."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Answer_0007_Text
msgctxt "a2d739ba-3466-4539-84bb-cd5f329fc261"
msgid "\"I trust your opinion.\""
msgstr "\"그대의 판단을 믿는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "cc4516b4-4983-45ac-8bf3-2f5ea4b287bf"
msgid ""
"\"{name}! We have a big fish here today – a noble from {g|Brevoy}Brevoy{/g}. "
"His clothes are worth hundreds of gold coins, and his eyes are shifty. He "
"has a business offer to make. He wants to open a leatherworking shop in our "
"domain, to tan skins.\""
msgstr ""
"\"{name}! 오늘은 거물이 한 명 등장했네요. 수백 골드는 되어 보이는 비싼 옷을 입고, 무언가 찔리는 구석이 있어 보이는 듯한 "
"눈을 가진 {g|Brevoy}브레보이{/g} 출신의 귀족이 말이예요. 우리 땅에서 가죽 세공점을 열고 싶어 해요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Cue_0002_Text
#. Speaker : Valerie_Companion
msgctxt "9d0a7fa6-b81c-4f0c-8e4e-5f1da7637bc3"
msgid ""
"\"{name}, a nobleman from {g|Brevoy}Brevoy{/g} has arrived. He requests your "
"approval to open a small business. He desires to open a few leatherworking "
"shops in your domain, to tan skins.\""
msgstr ""
"\"{name}님, {g|Brevoy}브레보이{/g}에서 귀족 한 명이 도착했습니다. 조그마한 사업을 하는 것에 대한 허락을 받고 싶다고 "
"합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Cue_0003_Text
#. Speaker : Capital_Lander
msgctxt "b19c1120-55bf-466f-b75c-284b55737632"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, a man of influence "
"has arrived. He's a nobleman from {g|Brevoy}Brevoy{/g}, a wealthy charlatan –"
" the kind of a dealer I like most. He has a few tanneries in Brevoy. He "
"desires to relocate them to your lands, and share the profit with you.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 지역의 유지가 방문했습니다. {g|Brevoy}브레보이{/g} 출신의 귀족으로, 일종의... "
"부유한 사기꾼 같은 작자입니다. 제가 가장 좋아하는 부류지요. 브레보이에 몇 개의 가죽 세공점을 가지고 있다고 합니다. 그 세공점을 우리 "
"땅으로 이전하고, 이익을 나누겠다는군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Cue_0009_Text_String
#. Speaker : Octavia_Companion
msgctxt "20c41d76-2d42-440a-abd5-a85f811b562b"
msgid ""
"\"So that's how it is now, eh? We receive shiny gold, and "
"{g|Brevoy}Brevoy{/g} gets clean air and healthy children.\" {n}Octavia's "
"voice rings with irritation, and her eyes flash with a scornful look.{/n} "
"\"Indeed, who cares about these beggars, your subjects!\""
msgstr ""
"\"그런 것이로군요? 우리는 반짝이는 돈을 받고, {g|Brevoy}브레보이는{/g}는 맑은 공기와 건강한 아이들을 얻게 되고요.\" {n}"
"옥타비아의 목소리는 분노로 울리며, 경멸하는 눈빛으로 빛납니다.{/n} \"물론이죠. 누가 이런 거지나 백성따위를 신경쓰겠나요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Cue_0010_Text
#. Speaker : Valerie_Companion
msgctxt "a0495541-d71d-4211-b682-273b0d97cf82"
msgid ""
"\"I'll give the orders to begin construction. I'll also reinforce the "
"patrols, in case there's any unrest. It's time your subjects learn how to "
"work for an honest living, even if it means a nasty smell.\""
msgstr ""
"\"건축을 시작하라고 명령을 내려놓겠습니다. 순찰을 강화하라고 명령해 혹시 모를 불안에도 대비하라고 하겠습니다. 이제 백성들에게 정당하게 "
"돈을 번다는 게 어떤 건지 알려줄 차례입니다. 냄새가 조금 나더라도 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Cue_0011_Text
#. Speaker : Capital_Lander
msgctxt "8252a06a-c66b-476f-98d9-f78ff49e269d"
msgid ""
"{n}Lander winks and smiles delicately.{/n} \"Excellent. After all, nobody "
"ever died of a nasty odor. I assume.\""
msgstr "{n}랜더는 윙크하더니 우아하게 미소짓습니다.{/n} \"좋습니다. 악취로 사람이 죽기야 하겠습니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Cue_0012_Text
#. Speaker : Octavia_Companion
msgctxt "87402d3f-d27a-4e64-9a5b-9f63d2818e10"
msgid ""
"{n}Octavia's eyes glow.{/n} \"Perfect! We didn't save these lands to just "
"turn them into a dump! Free from alchemical fumes, our people will live here "
"happily and give birth to healthy children.\""
msgstr ""
"{n}옥타비아의 눈이 빛납니다.{/n} \"완벽해요! 이 땅이 쓰레기로 뒤덮히는 것에서 구원한 것 뿐만 아니라, 연금술 연기로부터 "
"지켜냈어요! 이제 백성들은 행복하게 살고 건강한 아이를 낳겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Cue_0013_Text_String
#. Speaker : Valerie_Companion
msgctxt "e3fb9b3b-3f40-4723-a48f-a1e71e01dbb2"
msgid ""
"{n}Valerie's tone betrays thinly veiled irony.{/n} \"I'm sure your subjects "
"will make better use of {g|Brevoy}Brevoy's{/g} gold than they can of their "
"pride. Especially gold they earn by plying a fair trade – as opposed to "
"their typical methods!\""
msgstr ""
"{n}발레리가 얇게 비꼬는 듯한 목소리를 냅니다.{/n} \"백성들이 긍지를 조금만 굽힌다면 {g|Brevoy}브레보이{/g} 의 돈을 "
"보다 유용하게 쓸 수 있을 겁니다. 특히 공정한 거래로, 전통적인 방법과는 다르게 얻은 돈이라면 말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Cue_0014_Text_String
#. Speaker : Capital_Lander
msgctxt "7329123b-517d-4fb9-860b-77eacb3133d8"
msgid ""
"{n}Lander rubs his eyes wearily.{/n} \"It's not rubbish. It's trade and "
"profit. Which we'll never see, unless you quit acting as if your throne is "
"standing upon bags of gold.\""
msgstr ""
"{n}랜더는 자신의 눈을 진저리친다는 듯 주물러댑니다.{/n} \"쓰레기가 아닙니다. 거래고 이익이지요. 그 옥좌가 돈 가방 위에 세워진 "
"것이라는 걸 아셨으면 좋겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Cue_0016_Text
#. Speaker : Valerie_Companion
msgctxt "fd1cc35a-80b8-4f70-814b-26ebd24c47ca"
msgid ""
"{n}Valerie nods solemnly.{/n} \"I'll give the order to prepare a location "
"for the tanneries. The guards will deal with any loudmouths who complain "
"about the smell.\""
msgstr ""
"{n}발레리는 진지하게 끄덕입니다.{/n} \"세공점의 위치를 준비하라고 명령을 내려놓겠습니다. 악취에 대해 불평하는 자들은 경비대가 "
"처리하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Cue_0017_Text
#. Speaker : Capital_Lander
msgctxt "c1868be6-1e94-4505-bbb0-455979d92d67"
msgid ""
"\"A fine choice, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. You "
"can count on me. I'll immediately have people sent out to determine the best "
"location for the tanneries. We certainly wouldn't want their...\" {n}{g|"
"House Lebeda}Lebeda{/g} frowns gently.{/n} \"... odor... clouding the air we "
"breathe here at the palace.\""
msgstr ""
"\"멋진 선택입니다, {mf|영주님|영주님|전하|전하}. 절 믿어주십시오. 즉시 사람들에게 일러 가죽 세공점을 위한 최적의 장소를 "
"물색하도록 하겠습니다. 거기서 나오는...\" {n}{g|House Lebeda}레베다{/g} 는 점젆게 찡그립니다.{/n} \"... "
"악취가... 이곳 궁성에서 물씬거리기는 바라시지 않을 테니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Cue_0019_Text
#. Speaker : Octavia_Companion
msgctxt "95e02c0c-4ff3-4bed-9ad3-756fdef6cefc"
msgid ""
"\"These tanneries smell like a kobold's backside. This industry requires the "
"use of alchemical components, which are carried by the wind and cause nasty "
"diseases. Nobody's happy about these factories being in {g|Brevoy}Brevoy{/g}"
". That's the reason he's come to us. The offer is profitable, no doubt, but "
"the smell that comes with it is foul. We mustn't make a deal with this "
"little man. Better to send him away – and quickly. That will teach the other "
"moneybags a lesson too. Just because you're stuffed with gold, that doesn't "
"mean you're allowed to do whatever you want.\""
msgstr ""
"\"이 세공점은 코볼트 궁둥이에서 나는 냄새가 나요. 이 산업단지를 위해선 연금술 자재들이 필요하고, 그 성분은 바람을 타고 역겨운 "
"질병을 퍼뜨리죠. 이 공장이 {g|Brevoy}브레보이{/g}에 있을 때 좋아하던 사람은 없었어요. 그래서 그 사람이 여기로 온 거죠. "
"그 제안은 분명 이득이 될 거예요. 하지만 그 악취가 함께 따라올 거예요. 이 사람과 담판을 지어야 해요. 멀리 쫓아버리면 좋을 거예요. "
"가능한 빠르게 말이죠. 그러면 다른 상인들에게도 교훈을 안겨줄 거예요. 돈 부족으로 우리가 고통받고 있더라도, 그네들 마음대로 모든 걸 "
"다 하게 내버려두진 않겠다는 교훈을요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Cue_0020_Text
#. Speaker : Valerie_Companion
msgctxt "f41ef8ff-7a2c-459b-ad0c-7bfb7471c7bb"
msgid ""
"\"This alchemical enterprise would make an unpleasant neighbor. Of course, "
"the locals won't be happy about the waste and the smell, but we must "
"concentrate on our business interests and relationships with our neighboring "
"countries. The people of {g|Brevoy}Brevoy{/g} will happily pay to move these "
"tanneries away from their homes. But you have the right to make whatever "
"decision you consider best for the country.\""
msgstr ""
"\"이 세공점은 불편한 이웃이 될 겁니다. 물론, 주민들도 쓰레기와 악취를 싫어하겠지요. 하지만 이웃 국가와의 관계와 사업 이익에 "
"집중해야 합니다. {g|Brevoy}브레보이{/g}의 백성들은 자기네 고향에서 이 세공점을 없애는 데 기꺼이 돈을 대줄 겁니다. 하지만 "
"이 땅을 위한 최선의 결정을 내리는 것은 모두 당신의 손에 달려있지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank5/Population_Rank5manufact/Cue_0021_Text
#. Speaker : Capital_Lander
msgctxt "b7d634cc-12b3-48f7-9cc8-79db25101102"
msgid ""
"\"These tanneries stink. The alchemical waste is hazardous, unless you're a "
"Kobold of course. It's only natural that nobody in {g|Brevoy}Brevoy{/g} is "
"happy about having such a neighbor. This merchant will pay handsomely to "
"pour his waste into our land instead. We have plenty of forests and rivers, "
"after all. Even if we ruin a couple, it won't be so bad, and the gold will "
"certainly come in handy. Some of your people will surely be unhappy, but "
"when are we concerned about the complaints of peasants? I think we must say "
"yes!\""
msgstr ""
"\"이 세공점은 악취가 진동합니다. 우린 코볼트가 아니니 이 연금술 폐기물도 분명 위험하겠지요. {g|Brevoy}브레보이{/g}의 사람들도 "
"이런 이웃을 싫어하는 건 자연스러운 일입니다. 하지만 이 상인은 자기 폐기물을 우리 땅에 버리는 걸로 돈을 많이 줄 겁니다. 이 땅엔 "
"숲과 강이 많지요. 그 중 몇 개 좀 오염시킨다고, 크게 문제는 안 될 겁니다. 돈이 확실하게 많이 들어오는 걸요. 당신의 백성들도 분명 "
"행복해하진 않을 겁니다만, 언제부터 우리가 농민들의 불만이나 들어주고 앉아있었습니까? 동의해야 합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank6/Answer_0012_AlignmentShift.Description
msgctxt "98d4d0e2-2a7e-4142-b0de-5a6a22323283"
msgid "Crushed a rebellion in the worst way possible."
msgstr "가능한 최악의 방법으로 반란을 진압했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank6/Answer_0012_Text
msgctxt "dd676470-68ec-45c5-86c9-10165d5bb559"
msgid "\"We'll crush this rebellion with force. Gather the troops.\""
msgstr "\"무력으로 이 반란을 진압할 것이다. 군대를 소집하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank6/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "4c6908ff-63cb-4686-a9b6-4d22683d67e9"
msgid ""
"\"{name}, we've received news regarding Davor the Grey. Our guards have "
"chased him and his gang out to the {g|Narlmarches}Narlmarches{/g}. In an "
"attempt to save his own neck, the villain has been lying the locals – trying "
"to win them to his side. He says he's defending the River Freedoms from us, "
"who he calls tyrants and despots. – And it seems he's been successful: he's "
"rallied the people of the Narlmarches, and they've joined forces against us!"
"\""
msgstr ""
"\"{name}, 잿빛의 다보르에 대한 소식이 들어왔어요. 우리 경비병들이 그 패거리들을 {g|Narlmarches}날마치{/g}까지 "
"쫓아냈다고 해요. 그는 자기 목숨을 구하고자, 주민들을 자기 편으로 끌어들이려고 자신이 폭군인 우리로부터 강 자유 연맹을 지키고 있다고 "
"거짓말 해왔다고 하더군요. 그 공작은 성공적으로 작용했고, 날마치 사람들과 함께 우리에게 맞서고 있어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank6/Cue_0002_Text
#. Speaker : Octavia_Companion
msgctxt "53dd2eab-0b4b-4268-b5df-8a89c50c17e3"
msgid ""
"{n}Octavia is agitated.{/n} \"Grave news, {name}! The chieftain, Davor the "
"Grey, has bitten off more than he can chew. He's sparked a riot in the "
"{g|Narlmarches}Narlmarches{/g}, obviously in an attempt to overthrow you.\""
msgstr ""
"{n}옥타비아가 동요하고 있습니다.{/n} \"심각한 일이에요, {name}! 다보르가 이빨을 드러냈어요. "
"{g|Narlmarches}날마치{/g}에서 당신을 타도하고자 폭동을 일으켰어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank6/Cue_0004_Text
#. Speaker : Valerie_Companion
msgctxt "4aebfcc7-0149-4fbb-9d79-f82a017218af"
msgid ""
"\"Something happened that was always destined to happen. The wanton Davor "
"the Grey has spilled so much blood that he's finally lost his mind. He's in "
"the {g|Narlmarches}Narlmarches{/g}, trying to raise a rebellion against us. "
"Ridiculous as it may sound, I'm afraid he's hoping to start a civil war, and "
"ultimately seize power.\""
msgstr ""
"\"일어날 일이 일어나고 말았습니다. 악당 회색의 다보르가 피를 너무 많이 쏟았는지 결국 제정신을 잃어버린 모양입니다. 지금 그자가 "
"{g|Narlmarches}날마치{/g} 에서 우리에게 반기를 들었습니다. 어이없게 들릴 수도 있지만, 내전을 유발해 옥좌를 노리려는 "
"생각인듯 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank6/Cue_0005_Text
#. Speaker : Capital_Lander
msgctxt "fa4a7c32-3eda-41c1-adc3-05a99051c927"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, we have news! Do "
"you remember Davor the Grey? The one your guards have been hunting. Well our "
"soldiers drove him out into the depths of the {g|Narlmarches}Narlmarches{/g}"
", and there he's been taking rather desperate measures. He gathered the "
"peasants there, and fed them lies about how he's defending them from the "
"greedy tyrant's taxations, and that we're hunting him as a result. The "
"people of the Narlmarches have rallied behind him, and they're ready to "
"march on the capital!\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 급보입니다! 회색의 다보르를 기억하시는지요? 우리 경비대가 쫓고있었던 그 남자 말입니다. 우리 "
"병사들이 {g|Narlmarches}날마치{/g} 까지 놈을 쫓아내는 데 성공했지만, 조금 악수를 둔 모양입니다. 그곳의 백성들을 모집한 "
"뒤, 밥을 먹이고 거짓말로 폭군의 탐욕스러운 징세로부터 그들을 보호하던 도중 쫓기고 있다고 한 모양입니다. 날마치의 사람들이 그를 따라 "
"수도로 진격해 올 거 같습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank6/Cue_0006_Text
#. Speaker : Capital_Lander
msgctxt "177206a2-7add-4c3f-b1db-642bd749ccf5"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, we are having a "
"minor issue with one of the chieftains. Davor the Grey has claimed the "
"{g|Narlmarches}Narlmarches{/g}, and now he's raising a rebellion. The "
"peasants are behind him. It's unfortunate that he failed to appreciate the "
"advantages of our patronage, but it's an easy problem to remedy.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 족장 중 하나와 사소한 문제가 발생했습니다. 회색의 다보르가 "
"{g|Narlmarches}날마치{/g}를 점령하고 우리에게 반기를 들었습니다. 백성들이 그를 따르고 있습니다. 우리 후원을 받지 "
"않겠다는 것은 참으로 유감입니다만, 그래도 처리하기 어려운 문제는 아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank6/Cue_0007_Text
#. Speaker : Octavia_Companion
msgctxt "aa47773c-5353-4bc5-9aaf-ae6b1da7020f"
msgid ""
"\"So we have ourselves quite a situation. On the one hand, we can send out "
"our forces, led by the General. On the other hand, the Treasurer might offer "
"a bounty for Davor's head. But I believe the best way forward is to use "
"diplomacy to persuade the peasants to lay down their weapons. They mustn't "
"die in this petty war, just because some villain abuses their trust! Please "
"remember this when it's time to make your decision.\""
msgstr ""
"\"상황이 나쁘네요. 그래도 장군을 시켜 병사들을 보낼 수 있어요. 한 편으로는 재무관이 다보르의 머리에 현상금을 걸 수도 있겠죠. "
"하지만 현 시국에 가장 시급한 건 백성들을 설득해 무기를 내려놓게 할 외교력이예요. 악당의 꾐에 넘어갔다고 해서 이런 하찮은 내전에 "
"휩싸여 죽게 내버려 둘 순 없어요! 결정을 내리실 때 이걸 기억해주세요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank6/Cue_0008_Text
#. Speaker : Valerie_Companion
msgctxt "1c0c252d-7222-4a59-b227-bea18649b055"
msgid ""
"\"We must hurry. We can't afford to enter negotiations with Davor and his "
"cutthroats. It's time for the General's army to crush this rebellion. I "
"suppose the Treasurer wouldn't mind bribing Davor's henchmen. I also expect "
"that the Grand Diplomat would prefer to settle this in a peaceful manner. "
"However, there's no more time for such half-measures. The rebels have "
"determined their fate. Remember this when it's time to make your decision.\""
msgstr ""
"\"서둘러야 합니다. 다보르 도적단과 협상하면 안 됩니다. 장군과 그 부대를 보내 저 반란군들을 뭉개버려야 합니다. 재무관으로 하여금 "
"다보르의 수하들을 매수하고자 할 겁니다. 수석 외교관은 보다 평화로운 방법으로 해결하고자 할 거 같군요. 하지만 그런 임시방책을 취하기엔 "
"시간이 모자랍니다. 저 반란군들은 자신의 운명을 선택한 겁니다. 결정하실 때 이것을 기억해 주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank6/Cue_0009_Text
#. Speaker : Capital_Lander
msgctxt "e220c60b-0cc6-41a7-92dc-ece2be10d1d3"
msgid ""
"\"We could dispatch troops led by the General – or the Grand Diplomat could "
"commence exhausting negotiations with the peasants. But there's a far easier "
"solution. Let's ask the Treasurer to offer a bounty for Davor's head. I'm "
"sure if we made the right offer, the other chieftains would come running in "
"with Davor's head on a silver platter. Simple and elegant, is it not? But "
"it's up to you to decide, of course.\""
msgstr ""
"\"장군을 시켜 부대를 보낼 수도 있습니다. 수석 외교관을 시켜 백성들과 진빠지는 협상을 할 수도 있지요. 하지만 보다 쉬운 방책이 "
"있습니다. 재무관을 시켜 다보르의 머리에 현상금을 거는 겁니다. 우리가 돈만 제대로 제공하면 다른 족장들이 뛰어가 다보르의 머리를 은쟁반 "
"위에 가져다 올 겁니다. 간단하고 우아하지 않습니까? 물론, 선택은 제가 하는 것이 아니지만요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank6/Cue_0036_Text
#. Speaker : Valerie_Companion
msgctxt "a0af156b-affc-41a9-89cb-a16448061713"
msgid ""
"\"{name}, we have an update about the robberies on the roads. Our guards "
"chased Davor the Grey out into the {g|Narlmarches}Narlmarches{/g}. In "
"desperation, he's persuaded the local peasants to rise up in rebellion. "
"Ridiculous as it may sound, he's looking at overthrowing you.\""
msgstr ""
"\"{name}, 길가의 강도들에 대한 소식이 새로 들어왔습니다. 우리 경비들이 다보르를 {g|Narlmarches}날마치{/g} 로 "
"쫓아버렸습니다. 절박한 나머지 다보르는 지역의 백성들을 설득해 반란을 꾸민 모양입니다. 우습게 들릴 지 모르지만, 옥좌를 노리고 있습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank7/Answer_0010_AlignmentShift.Description
msgctxt "1f3cd29e-4102-42a2-92e8-da1054a1884a"
msgid "Denied upholding the ancient tradition of the marsh clans."
msgstr "늪지 부족들이 그들의 전통을 따르는걸 허락하지 않았습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank7/Answer_0010_Text
msgctxt "8e4ed5de-8540-45be-b19b-3c872f6ce845"
msgid "\"Deny the fight.\""
msgstr "\"싸움을 허락하지 않겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank7/Answer_0011_AlignmentShift.Description
msgctxt "c348ac14-fdbf-43c7-8b61-b2fdb64d9dc4"
msgid "Allowed upholding the ancient tradition of the marsh clans."
msgstr "늪지 부족들이 그들의 전통을 따르도록 허락했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank7/Answer_0011_Text
msgctxt "421ee5c2-fd17-4cb4-99ac-baf9b5b3cbe6"
msgid "\"Let them fight, according to their tradition.\""
msgstr "\"저들의 전통에 따라, 싸우도록 허락하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank7/Answer_0013_Text
msgctxt "66c3241e-ccd2-4948-b362-d1b711c160f0"
msgid "\"Act as you see fit.\""
msgstr "\"적절하다고 생각하는 대로 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank7/Cue_0005_Text
#. Speaker : Octavia_Companion
msgctxt "30b72f68-53f3-4d43-b9ff-ef43a192dd6d"
msgid ""
"\"I need your advice. There are two clans living in the swamp, both of them "
"old and large families. They've been arguing over a marshland meadow for a "
"few years now. Such fertile land is more valuable than human life in the "
"swamps. The two families have decided to determine the owner by a long-"
"standing tradition.\""
msgstr ""
"\"도움이 필요해요. 늪에 두 부족이 살고있는데 둘 다 역사도 깊고 커다란 가문들이예요. 요 몇 년 전부터 습지대의 건초지대를 두고 "
"싸우고 있었어요. 늪에서 사는 사람들에게 있어 그런 비옥한 땅은 귀중한 지역이예요. 두 가문은 오랫동안 내려오던 전통으로 그 주인을 "
"가리겠다고 했어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank7/Cue_0007_Text
#. Speaker : Valerie_Companion
msgctxt "aff3744d-c06e-4e35-8f26-fe7dd6db3390"
msgid ""
"\"I'd like to ask you for advice, {name}. Two clans from the swamps are "
"arguing over a meadow. Solid fertile ground is very valuable in the marshes, "
"especially when you have so many mouths to feed. The clan elders decided to "
"determine the owner by a long-standing tradition.\""
msgstr ""
"\"조언을 구하고 싶습니다, {name}. 늪지에 사는 두 부족이 건초지대를 두고 다투고 있습니다. 습지에서 비옥한 평지는 귀중한 "
"자원입니다. 먹일 입이 많을 때는 특히나 말입니다. 각 부족의 원로들은 오랫동안 내려져오던 전통으로 그 주인을 가리고자 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank7/Cue_0014_Text
#. Speaker : Octavia_Companion
msgctxt "11387868-7661-4f33-9b8e-57a42fee97e3"
msgid ""
"\"Just as I said. There will be no duel! Who cares about their bloody "
"traditions. They wouldn't just be killing each other – they'd be setting an "
"example for their children!\""
msgstr ""
"\"제가 말한 대로예요. 결투는 없을 거예요! 그 피로 얼룩진 전통을 지키면 안 돼요. 저 부족들은 단순히 서로를 죽이는 데서 끝나지 "
"않고 아이들에게 본보기를 보일 거라고요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank7/Cue_0015_Text_String
#. Speaker : Valerie_Companion
msgctxt "a76bfde2-4c70-4e18-ab3b-3cec1f98dca4"
msgid ""
"\"This tradition is older than your kingdom, {name}. Is it wise to interfere "
"with other people's laws without first understanding them?\""
msgstr "\"이 전통은 우리 왕국보다 오래되었습니다, {name}. 다른 사람들을 이해하기 전에 방해하는 게 현명한 길일까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank7/Cue_0017_Text
#. Speaker : Valerie_Companion
msgctxt "2b0931a9-aad7-44cb-8f42-16de31040047"
msgid ""
"\"Trying to cancel a centuries-old tradition by a decree would be like "
"trying to empty their swamp with a bucket. It'll be many years before "
"they're prepared to change their ways.\""
msgstr ""
"\"수세기는 내려져오던 전통을 법 하나로 막으려는 건 저들이 살고있는 늪의 물을 양동이 하나로 다 퍼나르겠다는 말이나 다름없습니다. "
"저들의 방식을 바꾸려면 수년은 기다려야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank7/Cue_0022_Text
#. Speaker : Valerie_Companion
msgctxt "e5df9747-adad-4ed1-b866-ab90c98e0715"
msgid ""
"\"Here's the essence of it. Ten armed men from each clan will face each "
"other in the meadow. The first clan to lose all its fighters relinquishes "
"its claim to the land. It's a cruel tradition, but they've been following it "
"for many generations. Even if we prohibit the tradition, it'll only make "
"them angrier, and they'll seek to settle their scores by other means. Their "
"way of life shouldn't be disturbed.\""
msgstr ""
"\"요약해 드리겠습니다. 각 부족에서 무장한 사람 열 명이 건초지대에서 서로를 맞이할 겁니다. 전사를 먼저 모두 잃는 쪽이 땅을 차지할 "
"것입니다. 잔인한 전통이지만, 수세대에 걸쳐 내려져온 것입니다. 이 전통을 우리가 금지하면 저들을 성나게 할 뿐입니다. 그리고 다른 "
"방법으로 원한을 갚으려고 하겠지요. 저들이 사는 방식을 방해해선 안 됩니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank7/Cue_0023_Text
#. Speaker : Octavia_Companion
msgctxt "4e6bdbc0-dee9-4c2e-b1d5-b0db07852e92"
msgid ""
"\"And that's where the nightmare begins. They're preparing a massacre. A few "
"dozen of armed people, half-naked, will fight on the meadow until one side "
"has lost all of its combatants. This is nothing short of savagery! So I had "
"to threaten them. I told them that if anyone is killed, the crown will claim "
"the meadow. Now the swamp clans complain that we're ruining their centuries-"
"old tradition. I need your support. I'm doing the right thing, aren't I?\""
msgstr ""
"\"거기가 악몽이 시작되는 곳이예요. 저들은 대량학살을 준비하고 있어요. 무장한 사람들 여럿이서, 거의 헐벗은 상태로 한 쪽이 전멸할 때 "
"까지 목초지에서 싸움을 할 거예요. 이건 야만적인 행위예요! 그래서 협박하는 수 밖에 없었어요. 저들에게 누구라도 죽인다면, 왕궁에서 "
"건초지대를 차지할 거라고요. 이제 늪의 부족들은 수세기는 내려져오는 자신들의 전통을 망치고 있다고 불평해오고 있어요. 도움이 필요해요. "
"제가 잘 한 것 맞지 않나요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank7/Cue_0026_Text_String
#. Speaker : Octavia_Companion
msgctxt "464a8992-beb2-4606-b344-7dbd3d504e64"
msgid ""
"{n}Octavia speaks with sorrow.{/n} \"You know, you've changed a lot of "
"things here. A lot, but not everything. It's a shame that you think "
"traditional killing over a plot of land is too important to give up.\""
msgstr ""
"{n}옥타비아는 슬픔에 젖어 말합니다.{/n} \"당신은 여기서 많은 것을 바꿨어요. 많이 바꿨지요. 하지만 모든 것을 바꾸진 못 "
"했어요. 이 땅에서 서로를 죽이는 전통이 그렇게 포기하기 힘든 것이였는 지 참으로 슬프네요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Answer_0008_AlignmentShift.Description
msgctxt "272a8b2c-4190-4b30-af12-6509c1520653"
msgid "Announced amnesty for all criminals."
msgstr "모든 범죄에 대해 사면령을 내렸습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Answer_0008_Text
msgctxt "58ccc080-71e6-47b5-bfc1-da4f3f2198da"
msgid ""
"{g|Population8_1}[Choice effects]{/g} \"Anyone who starts working for an "
"honest living will be pardoned for their crimes.\""
msgstr "{g|Population8_1}[선택 시 효과]{/g} \"건전하고 성실하게 살아가는 사람들은 죄를 사면해 줄 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Answer_0009_AlignmentShift.Description
msgctxt "3880c9b4-863e-4d48-ab9f-69fe26b3994b"
msgid "Refused to forgive the criminals."
msgstr "사면을 거절했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Answer_0009_Text
msgctxt "3d21d5bc-060e-462e-ba4f-a8d9b0bb29e5"
msgid ""
"{g|Population8_2}[Choice effects]{/g} \"They must be held accountable for "
"their crimes. They will be shown no mercy.\""
msgstr "{g|Population8_2}[선택 시 효과]{/g} \"죄를 지으면 그 대가를 치뤄야 한다. 자비는 없을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Answer_0010_Text
msgctxt "eabd3169-a5e2-4b1e-b6a3-2ba4108ec706"
msgid "\"You should find the solution yourself.\""
msgstr "\"알아서 결정하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "dd93df61-1ded-45c9-821d-0a05cc4237d6"
msgid ""
"\"Our anti-criminal measures have been a success! The bandits hide deep in "
"the thicket, afraid to poke their heads out. But guess what. Many of them "
"went down that dark road in the first place because they had no other way to "
"provide for their families...\""
msgstr ""
"\"우리 범죄 예방 정책이 성공을 거뒀어요! 도적들은 풀숲 깊이 숨어서 머리도 못 내밀고 있는 상황이예요. 하지만 그 사람들도 자기 "
"가족들을 먹여살릴 방법이 없으니 그런 길을 택한 것이겠죠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Cue_0002_Text
#. Speaker : Octavia_Companion
msgctxt "6a195443-939e-47fa-bfba-fdc1a8f5aaa0"
msgid ""
"\"{name}, your kingdom is a refuge for criminals. Bandits feel at ease here, "
"their pockets full of gold – and they pay you their respects. Indeed, they "
"regard you as their chieftain, not an enforcer of the law. That is why they "
"leave your servants alone. However, they would like something in return. We "
"should pardon them. Many of them are sick of being outlaws, even though "
"they're wealthy ones. They want to live out in the open, and be solid "
"citizens!\""
msgstr ""
"\"{name}, 왕국이 범죄자들의 은신처가 되었어요. 도적들은 여길 고향처럼 여기고, 주머니는 금은보화로 가득하며 당신에게 존경을 "
"표하고 있어요. 분명 당신을 법의 심판관이 아닌, 자기들의 우두머리로 여기는 것 같아요. 그래서 우리 부하들을 가만히 내버려두는 "
"것이겠죠. 하지만 그에 대한 대가를 원하고 있어요. 저들을 사면해야 해요. 많은 이들이 범법자로서의 삶을 더 이어나가고 싶지 않아해요. "
"아무리 돈이 많더라도 말이죠. 보다 자유로운 곳에서, 당당한 시민이 되려고 하는 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Cue_0003_Text
#. Speaker : Valerie_Companion
msgctxt "27785448-508d-4b88-b7e2-186ba9e47bca"
msgid ""
"\"{name}, we're fighting crime in our lands, and the bandits are running "
"scared. In fact, many of them are ready to come clean and return to civilian "
"life. They insist that it was starvation that led them down the slippery "
"slope, but now that the kingdom is prospering, they want to return and do "
"honest work. Their families are flooding us with petitions for pardon.\""
msgstr ""
"\"{name}, 저희는 이 땅에서 범죄와 싸웠고, 도적들은 겁에 질려있습니다. 사실 많은 도적들이 예전의 삶을 청산하고 시민으로서의 "
"삶을 되찾고자 합니다. 저들이 주장하는 바로는 가난이 자신들을 그런 극단적인 상황으로 몰아갔지만, 이제 왕국이 번영하고 있으니 다시 "
"건실한 일꾼으로 돌아가고 싶다는 겁니다. 도적들이 가족을 동원해 사면을 요청하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Cue_0004_Text
#. Speaker : Valerie_Companion
msgctxt "e3bdfe3b-f0ed-4c7c-bd9a-02384a3aa390"
msgid ""
"\"Robbery is thriving in our kingdom. Some of the bandits who've made their "
"fortune here even act as your unofficial vassals. They pay their respects to "
"you and your people, and regard you as the chieftain of these lands.\""
msgstr ""
"\"도적질이 왕국 내에서 만연하고있습니다. 여기서 부를 쌓은 어떤 도적들은 심지어 비공식적인 신하처럼 행동하기도 합니다. 이들은 당신과 "
"백성들에게 존경을 표하며, 당신을 이 땅의 우두머리로 생각하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Cue_0005_Text
#. Speaker : Octavia_Companion
msgctxt "335fd42b-3cd9-4c01-8ac1-0320734f88bd"
msgid ""
"\"Now that the people are better off, they're anxious to return home. But "
"they're frightened of the consequences. Their families are flooding us with "
"petitions of pardon. I think they deserve a second chance.\""
msgstr ""
"\"사람들의 삶이 나아졌으니, 집에 돌아갈 걱정을 하고있어요. 하지만 결과에 대해서 걱정을 하고 있죠. 그 사람들의 가족들이 물밀듯이 "
"밀려와 사면을 요구하고 있어요. 저 사람들에게 두 번째 기회를 줘야 할 거 같아요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Cue_0006_Text
#. Speaker : Valerie_Companion
msgctxt "01e97fe1-92aa-4ca7-a3f0-7ce3a3689f00"
msgid ""
"\"I consider it inappropriate. You can't pardon highwaymen and murderers, "
"and let them live in peace among their victims! Every single one of them "
"must answer for their crimes.\""
msgstr ""
"\"부적절하다고 생각합니다. 노상강도나 살인마들을 그냥 사면하고 피해자들과 평화롭게 살게 내버려두면 안 됩니다! 죄를 지은 자들은 모두 "
"죄값을 치러야 합니다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Cue_0011_Text
#. Speaker : Octavia_Companion
msgctxt "8aff5227-0a00-4738-b144-af8815f44ff6"
msgid ""
"\"This is merciful. I'm sure they'll enjoy peaceful life better than "
"banditry. As far as their conscience is concerned... perhaps they'll find a "
"way to clear it.\""
msgstr ""
"\"자비로우시네요. 분명 저들도 도적질을 하던 삶 보다 평화로운 삶을 즐길 거예요. 양심이 남아있다면 말이지요... 아마 옛 삶을 청산할 "
"방법을 찾으려 들 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Cue_0012_Text_String
#. Speaker : Valerie_Companion
msgctxt "65398d12-bd0e-48a3-9b3d-816a4c0fd48b"
msgid ""
"\"Do you expect them to give up their criminal habits so easily? Do you "
"expect your people to forget who robbed them, and not seek to settle the "
"score? You've only divided your people even further...\""
msgstr ""
"\"저들이 제 버릇을 그리 쉽게 고칠 것 같습니까? 백성들이 과연 자기를 털어간 자들을 용서하고, 복수하지 않으리라 생각하시는 겁니까? "
"사람들을 더 분열만 시키는 꼴이 될 겁니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Cue_0013_Text_String
#. Speaker : Octavia_Companion
msgctxt "1f407a80-c9d6-4445-8817-dcc40b9e035a"
msgid ""
"{n}Octavia suddenly blushes, clenches her fists and blurts out, nearly "
"shouting,{/n} \"Well, if someone has done something wrong in their life, "
"should they always bear the mark?!\" {n}She then decisively stomps her "
"foot.{/n}"
msgstr ""
"{n}옥타비아의 얼굴이 갑자기 붉어지고는, 주먹을 꽉 쥐고는 거의 소리치듯 말을 내뱉습니다.{/n} \"잘못을 한 사람이 있다면, 평생 "
"그 낙인을 안고 살아가야 한다는 말인가요?!\" {n}그리고는 발을 동동 구릅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Cue_0014_Text
#. Speaker : Valerie_Companion
msgctxt "f43c30cf-37cf-4a69-a244-a5b673803590"
msgid "\"That is reasonable. I'm glad we see the situation the same way.\""
msgstr "\"합리적이군요. 같은 방향으로 상황을 바라볼 수 있어 다행입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Cue_0015_Text
#. Speaker : Octavia_Companion
msgctxt "dd752335-004b-4d20-ae92-c6db12bc60c1"
msgid ""
"\"Let those seeking an honest living return to their homes. But the gods "
"won't protect them if they betray our trust!\""
msgstr "\"견실한 삶을 추구하는 자들을 집으로 돌려보내주세요. 하지만 저들이 우리 신뢰를 져버린다면 신들께서 용서치 않으시겠지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Cue_0016_Text
#. Speaker : Valerie_Companion
msgctxt "c412ff7e-4cab-4ab3-88e9-e7313236dedf"
msgid ""
"\"Let them turn themselves in and face a fair trial for their deeds. There "
"will be no general pardon.\""
msgstr "\"저들에게 자신이 저지른 죄에 대한 정당한 대가를 치르도록 하십시오. 사면은 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Cue_0021_Text
#. Speaker : Octavia_Companion
msgctxt "f603c34f-e3c1-4215-a793-4a5f9ffc7039"
msgid ""
"\"It's a good idea, if you ask me. The bandits are the most powerful "
"'estate' in all of {kingdomname}. Since we're not fighting them, let's try "
"to make friends with them.\""
msgstr ""
"\"제 의견을 물어보신다면, 좋은 생각이예요. 도적들은 온 {kingdomname} 에서 가장 강력한 '자산' 이예요. 싸우지 않기로 "
"했으니, 친해져 보죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank8/Cue_0022_Text
#. Speaker : Valerie_Companion
msgctxt "a836773a-befb-472b-87db-37e601c15145"
msgid ""
"\"But our guards remain a thorn in their side. In hopes of someday living "
"openly, the bandits have sent you a petition for pardon. They say they'll "
"declare themselves your servants if you stop hunting them down. It's just "
"more evidence that this situation with the criminals has already gone too "
"far. It's high time we hunt them down and bring them to justice!\""
msgstr ""
"\"경비대 입장에서 아직 손에 박힌 가시가 남아있습니다. 언젠가 자유롭게 살고자 하는 희망으로 도적들이 사면을 요청해 왔습니다. "
"자기네들을 그만 쫓는다면 신하로 들어오겠다는 말을 했습니다. 이건 저 범죄자들이 이미 선을 넘어버렸다는 증거입니다. 저들을 쫓아 심판을 "
"내려줄 때가 무르익은 것 같습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Answer_0004_AlignmentShift.Description
msgctxt "08112a43-00ba-4333-bd84-5df5dc653fb8"
msgid "Prohibited the River Freedoms in the kingdom."
msgstr "왕국에서 강 자유 연맹원들을 출입금지 시켰습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Answer_0004_Text
msgctxt "9f2887e7-f058-4599-ad25-bfac9c6e1172"
msgid ""
"{g|Population9_1}[Choice effects]{/g} \"My kingdom is in need of a noble "
"class. Appoint those who possess enough power and influence to rule over "
"their lands.\""
msgstr ""
"{g|Population9_1}[선택 시 효과]{/g} \"내 왕국에는 고귀한 자들이 필요하다. 저들의 땅을 다스릴 수 있는 힘과 영향력 "
"있는 사람을 임명하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Answer_0005_AlignmentShift.Description
msgctxt "f72f1bec-78d4-4724-a7dc-6e2193ba8f35"
msgid "Refused to prohibit the River Freedoms in the kingdom."
msgstr "왕국에 강 자유연맹원들을 출입금지 시키라는 제안을 거절했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Answer_0005_Text
msgctxt "ec9a2343-42df-4b25-9890-d4ebd2e4234e"
msgid ""
"{g|Population9_2}[Choice effects]{/g} \"The Stolen Lands managed without "
"aristocrats before, they can live without them now and in the future. Let "
"the people decide who they want as governors.\""
msgstr ""
"{g|Population9_2}[선택 시 효과]{/g} \"본디 귀족 없이 관리됐던 도둑맞은 땅이기에, 앞으로도 귀족의 부재가 큰 문제는 "
"되지 않을 것이다. 국민이 원하는 영주를 세우도록 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Answer_0015_Text
msgctxt "707c7a46-2cdb-49d0-9627-823ca409882a"
msgid "\"I'll leave this decision to you.\""
msgstr "\"네게 결정을 맡기겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "0b240766-ce44-4951-8a4a-9efd5c73b3d5"
msgid ""
"\"{name}, your kingdom is growing, and its problems grow along with it. They "
"must all be addressed, and this leaves no time for the trivial things. "
"{mf|Barons|Baronesses|Kings|Queens} normally appoint others to deal with the "
"little things. Sometimes it's the mayors and the local leaders. That's how "
"an aristocracy is formed... a circle of power holders... But no matter what "
"you call it, we can't do without such a group of trustees.\""
msgstr ""
"\"{name}, 왕국이 성장하면서 그에 대한 문제도 자라나고 있어요. 전부 반드시 해결해야 하고, 사소한 일에 신경쓸 시간이 없어요. "
"{mf|남작|남작|왕|여왕}은 일반적으로 다른 사람들을 임명해 사소한 일들을 다루게 하죠. 그 사람들은 시장이나 지역 지도자가 맡으면 "
"돼요. 그렇게 귀족이 생겨났죠... 권력을 손에 쥔 자들... 하지만 그 사람들을 뭐라고 부르든 간에, 그들이 없으면 안 돼요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Cue_0002_Text
#. Speaker : Valerie_Companion
msgctxt "e8a7ffbc-e5a3-4db8-93ca-7dab689e9be4"
msgid ""
"\"{name}, your kingdom is growing bigger. No matter how many advisors you "
"hire, your officers can't address every problem and issue. A monarch should "
"have vassals: knights, mayors, guild leaders, local chiefs and elders. It is "
"they that form the natural aristocracy, the high society of any kingdom.\""
msgstr ""
"\"{name}, 당신의 왕국이 커져가고 있습니다. 얼마나 많은 보좌관을 고용하든, 모든 문제에 다 대처할 수는 없을 것입니다. 군주는 "
"반드시 신하가 필요합니다. 기사, 시장, 길드장, 지역 유지나 장로라든지 말입니다. 이렇게 이들은 자연스럽게 귀족이라는, 어느 왕국에서나 "
"볼 수 있는 고위 계층을 만들어 냅니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Cue_0007_Text_String
#. Speaker : Octavia_Companion
msgctxt "06691ea2-71ac-4c92-81a8-e1bdbf9e57de"
msgid ""
"\"Oh, I don't think that will work. We risk breeding an arrogant lot. "
"They'll consider the power they hold over other people's lives some kind of "
"birth right...\""
msgstr ""
"\"아, 그건 안 될 거 같아요. 지금 우린 위험을 무릅쓰고 거만한 사람들을 육성하고 있어요. 사람들의 생사여탈권을 쥐고 있는 것을 "
"타고난 권리라고 생각하는 사람들 말이예요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Cue_0008_Text
#. Speaker : Valerie_Companion
msgctxt "02761c63-ed47-4c3d-9824-c7f2c7631c13"
msgid ""
"\"I will personally select those whose ambition equals their talent. They "
"will be powerful enough not only to give people orders, but to protect them. "
"You will have nothing to worry about. It doesn't matter who they were. These "
"warriors will be your loyal vassals, reliable and just. I'll make sure of it."
"\""
msgstr ""
"\"야망만큼 재능이 뛰어난 사람들을 개인적으로 고르도록 하겠습니다. 그들은 사람들에게 명령만 내릴 뿐만 아니라, 보호할 수 있을 만큼 "
"강할 겁니다. 걱정 마십시오. 그들이 어떤 사람인지는 중요하지 않습니다. 이 전사들은 당신의 충성스러우며 믿을 수 있고 공정한 신하가 될 "
"겁니다. 제가 보장하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Cue_0009_Text
#. Speaker : Octavia_Companion
msgctxt "c7132fc5-84f7-4e20-9684-7c30b9afddfb"
msgid ""
"\"Perfect. I will announce to people that there will be no strange 'barons'. "
"From now on, they are a self-governing the kingdom. This will make them so "
"happy!\""
msgstr ""
"\"완벽해요. 사람들에게 '남작들'은 없을 거라고 말할게요. 이제부터 저들은 왕국을 스스로 다스리릴 거예요. 이러면 다들 행복하겠죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Cue_0010_Text_String
#. Speaker : Valerie_Companion
msgctxt "0fd04406-2fb1-418b-9044-3a5037ab826e"
msgid ""
"\"You shouldn't. Governance is not something you can learn as a merchant or "
"craftsman. It takes talent and an understanding of social responsibility. "
"Community leaders hardly possess such skill.\""
msgstr ""
"\"안 됩니다. 통치력이란 상인이나 장인의 기술처럼 배울 수 있는 것이 아닙니다. 여기엔 재능과 사회적 책임에 대한 이해력이 필요합니다. "
"공동체의 지도자들에겐 이런 능력이 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Cue_0013_Text
#. Speaker : Octavia_Companion
msgctxt "1b98ba89-a909-4566-9b4d-96e8dafc5a4d"
msgid ""
"\"Many knights and adventurers seek to become your vassals, and fill the "
"vacancy left by the local bandits you've exterminated. But what if they want "
"more than you're willing to give? This will only puff them up. They might "
"even start bossing people around and hurting them.\""
msgstr ""
"\"수많은 기사들과 모험가들이 당신의 신하가 되려해요. 그리고 우리가 토벌한 지역 도적들의 빈 자리를 채우려고 하고 있어요. 하지만 "
"저들이 당신이 주려는 것 이상을 원하면 어쩌죠? 저들을 신하로 만들면 그에 대해 힘만 실어주는 꼴이 될 거예요. 사람들 위에서 "
"거들먹거리고 다치게 할 수도 있어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Cue_0014_Text
#. Speaker : Valerie_Companion
msgctxt "885722db-f9a5-4cf8-b4e3-73a2d5f75b45"
msgid ""
"\"There was a time when bandit chiefs were the aristocracy of the {g|Stolen "
"Lands}Stolen Lands{/g}, but we put an end to that. Many knights of honor now "
"look to serve you, to become your faithful vassals and enforce the laws of "
"your lands.\""
msgstr ""
"\"과거 {g|Stolen Lands}도둑맞은 땅{/g} 에서는 도적들이 귀족 역할을 했습니다. 하지만 우리가 그 역사를 끝내버렸지요. "
"수많은 명망높은 기사들이 이제 당신을 섬겨, 충성스런 신하가 됨과 동시에 이 땅의 법을 집행하려 하고싶어합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Cue_0017_Text
msgctxt "46564174-a468-4732-a01c-ed52568d0b19"
msgid ""
"\"A common law made up by bandits has lasted for centuries in the {g|River "
"Kingdoms}River Kingdoms{/g}. It says that every troublemaker has the right "
"to talk about whatever they like, that there is no law beyond an oath. Every "
"tramp is free to wander wherever they want. – And no merchants are obliged "
"to pay royal taxes.\""
msgstr ""
"\"{g|River Kingdoms}강의 왕국들{/g}에서는 도적들의 관습법이 수세기동안 내려왔지요. 거기엔, 어떤 말썽을 피우는 사람이든 "
"자기가 원하는 것을 말할 수 있는 권리가 있고, 아무것도 그들을 옥죌 수 없다고 말이죠. 어떤 부랑자든 어디든 갈 수 있으며, 그 어떤 "
"상인도 세금을 낼 필요가 없다고 말이예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Cue_0023_Text
#. Speaker : Octavia_Companion
msgctxt "dfa1cdeb-c1cd-4dd1-9e2d-3fa247f9a238"
msgid ""
"\"The bandit chieftains hold the greatest power in your lands. They already "
"imagine themselves as the barons of your kingdom. Take it from me, giving "
"them even more power would be... Just plain dangerous.\""
msgstr ""
"\"이 땅에선 도적 우두머리가 가장 강력한 권력을 가졌어요. 이미 스스로를 이 왕국의 남작으로 생각하고 있어요. 제 말을 믿어주세요. "
"저들에게 더 많은 권력을 주면... 더 위험해질 뿐이예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Cue_0024_Text
#. Speaker : Octavia_Companion
msgctxt "b038e604-9b51-4b0b-934f-a576b0a4c506"
msgid ""
"\"Who lives in the villages and towns? The people! Regular citizens! Let "
"them govern their own lives! Our cities and towns have elected their mayors. "
"The villages have chosen their chiefs. They are the pillars we rely on, not "
"a bunch of self-absorbed sloths!\""
msgstr ""
"\"소도시와 마을엔 누가 살죠? 사람들이예요! 일반 시민들 말이죠! 시민들이 알아서 자치하게 만드세요! 우리 도시와 소도시에선 시장을 "
"뽑았어요. 마을에서도 이장을 뽑죠. 백성들이 믿어야 하는 건 이런 사람들이예요. 이기적인 굼벵이들이 아니라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Cue_0025_Text
#. Speaker : Valerie_Companion
msgctxt "ff67b17c-bbe4-47a0-93a0-88ce1fba9f69"
msgid ""
"\"Unfortunately, the only people powerful enough to be granted titles are "
"the local bandit chiefs. I'm afraid this situation is all too typical for "
"the {g|Stolen Lands}Stolen Lands{/g}. Law and virtue is overtaken by brute "
"force and deception. One might expect them to behave with dignity and "
"respect if they become true vassals of the {mf|King|Queen}.\""
msgstr ""
"\"불행히도, 작위를 얻을 수 있을 만큼 강력한 사람은 지역의 도적 수괴들 뿐입니다. 이 상황이 {g|Stolen Lands}도둑맞은 "
"땅{/g} 에 있어 너무 전형적인 상황이 아닌가 의심되는군요. 법과 미덕은 잔혹한 힘과 기만에 전복당한 상황입니다. 저들이 진정으로 "
"{mf|왕|여왕} 의 신하가 될 수 있다면 품위와 존중을 기대할 수 있을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Population/Rank9/Cue_0026_Text
#. Speaker : Valerie_Companion
msgctxt "a213a1cb-2841-418d-b080-499972e6e7c3"
msgid ""
"\"It's only natural that the law now rests on the shoulders of your royal "
"vassals, not 'representatives of the people'. Mayors and chiefs come and go, "
"but aristocrats remain, committing themselves to a ruler and raising worthy "
"successors from a young age. They're obliged by the nobility that naturally "
"arises from their responsibility to their subjects!\""
msgstr ""
"\"법은 군주가 데리고 있는 신하들의 손에 남아있을 때 가장 자연스럽습니다. '시민 대표'들의 손에 있을 때가 아니라 말입니다. 시장과 "
"이장은 생겨나고 사라지지만, 귀족은 남습니다. 어린 나이에도 군주에게 헌신하고 가치있는 후계자를 육성합니다. 백성에 대한 책임감에서 "
"자연스럽게 만들어지는 고결함의 의무가 있으니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Merc/Cue_0001_Text
msgctxt "35a35bd3-867b-40c4-907f-fcba8fa1c564"
msgid ""
"{n}Your advisor has arrived to report about the recent Relations "
"developments in your {mf|barony|barony|kingdom|kingdom}.{/n}"
msgstr "{n}당신의 보좌관이 최근의 {mf|남작령|남작령|왕국|왕국}의 외교 발전에 대해 논의하기 위해 방문했습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Answer_0014_Text
msgctxt "067ed03b-d70e-4202-9b46-f96b9958f32e"
msgid ""
"{g|Relations10_1}[Choice effects]{/g} \"Open publishing houses to print "
"newspapers for our subjects abroad.\""
msgstr ""
"{g|Relations10_1}[선택 시 효과]{/g} \"외국에 나가있는 우리 백성들을 위해 출판소를 열어 신문을 출간하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Answer_0015_Text
msgctxt "ddf181c6-3667-4a56-8012-c19ac33977d0"
msgid ""
"{g|Relations10_2}[Choice effects]{/g} \"Let the General establish a regiment "
"for foreigners who will serve in the military in exchange for citizenship.\""
msgstr ""
"{g|Relations10_2}[선택 시 효과]{/g} \"시민권을 얻고자하는 외국인들에게 대가로 군역을 살도록 만들게 장군에게 연대를 "
"만들라고 명령하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Answer_0016_Text
msgctxt "c1683bdc-6553-4b51-87ec-ffef79ff7c53"
msgid ""
"{g|Relations10_3}[Choice effects]{/g} \"Our domain will accept every "
"oppressed fugitive from foreign lands.\""
msgstr "{g|Relations10_3}[선택 시 효과]{/g} \"우리 땅에서는 외국의 모든 억압받는 망명자들을 받아줄 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Answer_0018_Text
msgctxt "6fd34588-8278-482a-a0f0-d5146224750b"
msgid ""
"{g|Relations10_4}[Choice effects]{/g} \"Start accepting reports about "
"foreign spies in our lands.\""
msgstr "{g|Relations10_4}[선택 시 효과]{/g} \"우리 땅에 있는 외국인 밀정에 대한 보고를 받으라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Answer_0019_Text
msgctxt "d99bf9fa-71ca-42d7-99f4-98d4061e8930"
msgid "{g|Relations10_5}[Choice effects]{/g} \"Assemble a censorship board.\""
msgstr "{g|Relations10_5}[선택 시 효과]{/g} \"검열 위원회를 만들라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Answer_0020_Text
msgctxt "52c9f4e4-a579-48e3-997f-fe2f677fb168"
msgid ""
"{g|Relations10_6}[Choice effects]{/g} \"Support our native merchants with "
"special privileges — even if it's not to the foreigners' liking.\""
msgstr ""
"{g|Relations10_6}[선택 시 효과]{/g} \"우리 나라 토박이 상인들에게 특권을 주라. 외국인들이 안 좋아하더라도 말이다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Answer_0045_Text
msgctxt "081f8640-a715-4f03-bacf-f08049ab1141"
msgid "\"Act as you see fit.\""
msgstr "\"적절하다고 생각하는 대로 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Answer_0046_Text
msgctxt "b791c627-083e-4955-b2a8-7634b9081384"
msgid "\"Act as you see fit.\""
msgstr "\"적절하다고 생각하는 대로 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "c8a603f9-3b20-4617-a9b5-42aa2e47fdf9"
msgid ""
"\"I'd like to congratulate you, {name}. For the first time, the Stolen Lands "
"have emerged onto the international scene as a strong country worthy of "
"respect. It has far exceeded its history as a wild wasteland. I can hardly "
"believe our diplomacy has achieved such positive effects! I'm thinking of "
"establishing a string of grand embassies, all across Avistan!\""
msgstr ""
"\"축하하고 싶어요, {name}. 처음으로 도둑맞은 땅이 강대국으로 국제 무대에 서게 되었어요. 야생의 황무지라는 과거로부터 벗어나게 "
"된 거예요. 우리 외교 활동이 이렇게 긍정적인 효과를 낳았다니 믿겨지지가 않네요! 대형 대사관을 온 아비스탄 전역에 걸쳐 지을 수 있을 "
"거 같아요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0002_AlignmentShift.Description_String
#. Speaker : Valerie_Companion
msgctxt "2ca3aaaa-85c7-4361-a6e2-821f1fc7eb06"
msgid ""
"\"You've managed to establish a country whose citizens look to foreign lands "
"with great interest, rather than keeping their distance out of fear. This is "
"a great achievement, especially considering how things once were around "
"here. Many foreigners arrive at our borders seeking citizenship, though they "
"understand that such things are not handed out lightly. They are prepared to "
"serve in the army to earn their place in your domain.\""
msgstr ""
"\"당신은 시민들이 두려움에 거리를 두는 대신, 흥미를 가지고 외국을 바라볼 수 있는 나라를 만들어냈습니다. 과거 이 땅의 역사를 "
"생각해볼 때 이건 굉장한 업적입니다. 수많은 외국인들이 우리 국경으로 찾아와, 쉬운 일이 아닌 것을 알면서도 우리의 시민권을 얻으려 하고 "
"있습니다. 이들은 우리 땅에서 살 공간을 얻기 위해 군대에 들어갈 준비가 되었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0002_Text
#. Speaker : Linzi_Companion
msgctxt "c4674e32-f6b2-45be-8249-cb3ee69e4253"
msgid ""
"\"So you've managed to build a truly open country. Many foreigners reside in "
"your domain, while your own subjects have no fear of traveling abroad. We "
"are beset by those striving to become citizens, and many are willing to "
"serve in our military to earn the privilege.\""
msgstr ""
"\"진정으로 열린 나라를 만드셨네요. 많은 외국인들이 우리 땅에서 살고, 우리 백성들은 아무런 두려움 없이 외국으로 돌아다니고 있어요. "
"지금 우리 국민이 되고자하는 사람들이 너무 많아서 귀찮을 정도예요. 게다가 많은 이들이 시민권을 위해 군역을 살고자 해요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0003_AlignmentShift.Description_String
msgctxt "164cb21b-6306-47c0-af13-b3b671ce2fdc"
msgid "Built a closed state."
msgstr "국경을 닫았습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0003_Text
#. Speaker : Linzi_Companion
msgctxt "04dbb5ab-cbe2-4563-a1a5-ff0cd94972b9"
msgid ""
"\"The Stolen Lands used to be but a waystation on the road to a better "
"future, which lay somewhere far beyond the horizon. But you've convinced the "
"people to stop seeking greener pastures, and accept this land as their home. "
"This is a true accomplishment!\""
msgstr ""
"\"도둑맞은 땅은 한때 많은 이들이 스쳐지나가는 정류장에 불과했죠. 하지만 당신은 사람들이 더 푸르른 목장을 찾지 않고, 이 땅을 "
"자기네들의 고향으로 삼게 믿음을 주었어요. 진정한 업적이란 거죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0005_Text
#. Speaker : Valerie_Companion
msgctxt "7ed532ee-ab06-4770-a427-44f01195df87"
msgid ""
"\"{name}, it is a great honor to serve you. One isn't even guaranteed a "
"single chance in a lifetime to see someone build something so grand from so "
"little. What was once but a waystation along the road is now a prosperous "
"state rivaling all the River Kingdoms! I'm sure even the rulers of faraway "
"countries were impressed when they first heard about the Stolen Lands. From "
"this day forth, {kingdomname} will be spoken of with respect across the "
"world.\""
msgstr ""
"\"{name}, 당신을 섬기게 되어 진심으로 영광입니다. 이렇게 티끌에서부터 웅장한 크기로 자라날 때 까지를 볼 수 있는 기회가 보통 "
"사람들에게는 잘 주어지지 않습니다. 한때 길가의 정류장에 불과했던 이곳은 이제 온 강의 왕국들과 경쟁할 수 있는 번영하는 국가로 "
"자라났습니다! 분명 머나먼 땅의 군주들도 도둑맞은 땅에 대한 소식을 처음 듣는다면 놀랄 겁니다. 오늘부터, {kingdomname} 의 "
"이름은 존경과 함께 온 세상에 울려퍼질 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0006_Text
#. Speaker : SadisticMage_Capital
msgctxt "baa846c0-e349-44cb-a7a9-f80812193e41"
msgid ""
"\"Your Highness, I received several letters today – welcoming diplomatic "
"notes and offers of friendship. We've had many similar letters before, but "
"these are addressed from Garund. Governors on the other edge of the world "
"have taken an interest in our friendship! They've heard much about us — and "
"we have their respect! This is a great success, Your Highness!\""
msgstr ""
"\"전하, 오늘 편지를 몇 통 받았습니다. 환영하는 외교적 언사와 친우가 되자는 제의가 담긴 편지들이었습니다. 전에도 이런 편지는 많이 "
"받았지만, 이번엔 가룬드에서 보내왔다는 점에서 다릅니다. 이역만리 떨어진 타국의 군주들도 우리와 친분을 쌓는데 관심이 있는 모양이로군요! "
"우리에 대해 많이 들어본 모양입니다. 게다가 우리는 그들의 호감도 사고있습니다! 이건 크나큰 성공입니다, 전하!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0008_Text
#. Speaker : Valerie_Companion
msgctxt "8c69a9ee-0ecd-43b0-9ed3-3428ffd217de"
msgid ""
"\"You managed to create a country with its own culture and ideals, with no "
"connection to foreign demagogues who would only try to drag us into their "
"own quarrels or inject their foreign ideas. This is admirable. I'm sure we "
"could eliminate all foreign spies and troublemakers completely, if you "
"encouraged your subjects to report all those who promoting the interests of "
"other rulers.\""
msgstr ""
"\"우리는 독자적인 문화와 이념을 가진 국가를 만들어냈습니다. 자기네 정치 다툼이나 이국의 이념을 주입하는 데 끌어들이는 외국의 "
"선동가들과는 아무런 연관도 되지 않고 말입니다. 참으로 감탄이 나오는군요. 이로써 모든 외국의 밀정과 문제거리들을 완전히 타파할 수 있을 "
"겁니다. 백성들에게 타국의 군주들에 대한 흥미를 유발시키는 자들에 대해 모조리 보고하라고 독려해준다면 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0009_Text
#. Speaker : SadisticMage_Capital
msgctxt "f1341346-21ed-447c-b315-ea294df4c56c"
msgid ""
"\"Just as it's always been – people see everything beyond the stinking swamp "
"next door as a bizarre and frightening world that's best avoided. But you "
"somehow managed to elevate your subjects, and they've finally begun to "
"travel abroad. And as for our foreign guests... Well, at least they no "
"longer mumble curses under their breath as soon as they step out of their "
"wagons.\""
msgstr ""
"\"언제나 그랬던 것처럼, 사람들은 옆 나라를 생각할 때 기묘하고 피해야 하는 두려운 것이라고 생각합니다. 하지만 당신은 어떻게든 "
"백성들을 바꾸는 데 성공했습니다. 마침내 백성들이 외국으로 여행을 가기 시작한 겁니다. 그리고 외국인 손님들은... 뭐, 적어도 마차에서 "
"내리자 마자 욕을 내뱉지는 않는군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0010_Text
#. Speaker : SadisticMage_Capital
msgctxt "9c60cade-85fe-4523-89be-c2ca722b4f77"
msgid ""
"\"You managed to build an independent state, one that keeps out of foreign "
"business and doesn't let anyone interfere with our own. Naturally, your "
"authority is stronger than ever before. I have a few ideas on how to sustain "
"this momentum. For starters, you could essentially buy even greater love "
"from your subjects. Grant your merchants certain privileges that are "
"unavailable to their foreign colleagues. Of course, those foreign merchants "
"might be offended. – Some of them would even turn their caravans away. Your "
"main duty, however, is to please your own merchants, and keep your subjects "
"happy and well-heeled.\""
msgstr ""
"\"당신은 외세의 압박을 받지 않는, 독립된 나라를 만드는 데 성공했습니다. 자연스럽게 당신의 권위도 전보다 커졌지요. 이 탄성을 "
"유지시킬 몇 가지 방안이 있습니다. 우선, 필수적으로 백성들의 사랑을 더 많이 얻으셔야 합니다. 우리 상인들에게는 외국인들에게는 주지 "
"않는 특권을 주면서 말이죠. 물론, 외국 상인들의 반발이 심할 것입니다. 어떤 자들은 자기 상단을 데리고 떠나겠지요. 하지만 당신의 본 "
"의무는 우리 상인들을 기쁘게 하는 데 있습니다. 그리고 우리 백성들을 행복하고 부유하게 만드는 것 말이지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0021_Text
#. Speaker : Linzi_Companion
msgctxt "73d26957-5060-46c6-8fa6-edeee592cd85"
msgid ""
"\"Wonderful. The world will hear all about us as soon as the presses start "
"their first run!\""
msgstr "\"훌륭해요. 우리 인쇄소가 처음으로 신문을 찍어내기만 하면 온 세상이 우리의 소식을 들을 수 있을 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0022_Text
#. Speaker : Valerie_Companion
msgctxt "ee5cc792-4d82-448b-b502-495db8d3ccda"
msgid ""
"\"Let it be so. Your subjects would become foreigners if they were long "
"enough separated from their homeland.\""
msgstr "\"그렇다면 그렇겠지요. 당신의 백성들도 고향에서 오래 떨어져 있으면 외국인이 되니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0023_Text
#. Speaker : Linzi_Companion
msgctxt "a51387b9-f067-460c-a1a0-3f45d1352591"
msgid ""
"\"Newcomers from all corners of the world will become not only your "
"subjects, but defenders of your kingdom! It would be so curious to speak "
"with them and hear their stories...\""
msgstr ""
"\"온 세상에서 찾아온 새로운 사람들 모두는 단순히 백성이 되는 게 아니라, 왕국의 수호자가 될 거예요! 저들과 이야기 했을 때 어떤 "
"얘기를 해줄지 참으로 궁금하네요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0024_Text
#. Speaker : Valerie_Companion
msgctxt "df75d1a9-c4ea-4c64-b07b-65922914034b"
msgid ""
"\"Citizenship paid for with blood will be more legitimate in the eyes of the "
"people.\""
msgstr "\"피로써 얻은 시민권은 사람들이 보기에도 적절할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0025_Text
#. Speaker : SadisticMage_Capital
msgctxt "e540e657-f6a4-40c5-bb05-b0c0c1243060"
msgid ""
"\"Excellent! Your subjects will be grateful if you make those common "
"strays... I mean, zealous citizenship applicants spill their blood for them!"
"\""
msgstr ""
"\"훌륭합니다! 백성들도 저 사람들을 머무르게 한다면 감사해 할 겁니다... 그러니까, 시민권을 얻으려는 지원자들도 질투하며 저들을 위해 "
"피를 흘려줄 거라는 것이지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0026_Text
#. Speaker : Linzi_Companion
msgctxt "9fc94085-6ab8-4dc8-b8f9-73de9a40ec61"
msgid ""
"\"That's a very merciful decision. Let every poor fellow and unfortunate "
"slave find refuge in this land of hope and unity we have established here.\""
msgstr "\"참으로 자비로운 선택이예요. 불쌍한 사람들과 노예들이 우리가 세운 이 희망과 화합의 땅에 도피를 할 수 있다니요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0027_Text
#. Speaker : Valerie_Companion
msgctxt "db668978-4e5c-48ea-9564-59d860670c47"
msgid ""
"\"Very well, let the kingdom be known as a refuge from border to border. "
"Anyone who has suffered injustice or cruelty will find a safe shelter and a "
"fair trial here.\""
msgstr ""
"\"좋습니다, 왕국이 피난민들을 위한 곳으로 알려지게 하지요. 불의나 잔혹함으로 인해 고통받은 누구든 이곳을 안식처로 삼고 공정한 판결을 "
"받을 수 있을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0028_Text
#. Speaker : SadisticMage_Capital
msgctxt "5017e9cd-246c-4e5d-8933-14ffb5edf1aa"
msgid ""
"\"Hm... Such a measure will attract cheap labor. Our guest workers won't "
"complain about being left the dirtiest jobs. This is a wise and most "
"compassionate decision, Your Highness!\""
msgstr ""
"\"흠... 그 방법을 쓰면 값싼 노동력을 얻을 수 있을 겁니다. 우리 이주 노동자들도 더러운 일을 하면서 불평하지 않겠지요. 현명하고도 "
"연민어린 결정입니다, 전하!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0029_Text
#. Speaker : SadisticMage_Capital
msgctxt "1bd6d1ab-40fc-42c9-94f4-8941bc15701a"
msgid ""
"\"Hm... The press is a powerful instrument for shaping the attitude of "
"foreign subjects. This is very wise, your Highness.\""
msgstr "\"흠... 외국 백성들의 태도를 바꾸는 데 신문은 강력한 수단이지요. 현명하십니다, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0030_Text
#. Speaker : Linzi_Companion
msgctxt "55db9b07-95d5-4786-987b-c2bae9f84d6e"
msgid ""
"\"I guess it's best if we rely on our people – and they should be able to "
"trust and depend on us in return. If someone commits a crime, naturally "
"their fellows should tell us. It's not like we're doing anything wrong! We "
"just care about them... Right?\""
msgstr ""
"\"우리 백성들에게 맡기는 게 가장 최선의 방법 같아요. 그러면 백성들도 우리에게 보답으로 신뢰를 보여주겠죠. 누군가가 범죄를 저지르면, "
"당연히 그 친구들이 우리에게 말 해줘야 해요. 뭔가 잘못된 것을 하는 게 아니예요! 백성들을 돌보는 거죠... 아시겠나요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0031_Text
#. Speaker : Valerie_Companion
msgctxt "046bd433-fd5b-4358-99d4-3d87ad00e6d6"
msgid ""
"\"We will prevail upon the people that reporting on spies and traitors is a "
"moral obligation. If you're aware of a crime, remaining silent makes you an "
"accomplice!\""
msgstr ""
"\"밀정과 배반자에 대해 신고하는 것이 도덕적인 의무라고 사람들을 설득하겠습니다. 범죄를 발견했을 때 가만히 지켜보기만 하면 공범이 "
"된다고 말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0032_Text
#. Speaker : SadisticMage_Capital
msgctxt "1b99dbb0-f4cb-4207-861a-320bd19fb6df"
msgid ""
"\"Perfect! Why would anyone ever hesitate to report criminal activity? "
"Coming forward is a duty for the sake of society! At least, that's what "
"we'll have to convince the younger generations moving forward...\""
msgstr ""
"\"완벽합니다! 왜 사람들이 범죄 활동에 대해 보고하는 걸 망설이는 걸까요? 나서는 게 사회를 위해 도움이 되는 것인데 말입니다! 적어도 "
"어린 세대들에게 이렇게 말은 해줘야 합니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0033_Text
#. Speaker : Linzi_Companion
msgctxt "104577c9-1e86-43fd-bd38-45a9bd14f8e7"
msgid ""
"\"Hmm... I strongly object to censorship on principle. However, I agree that "
"artists must create lasting masterpieces, not throwaways to serve the "
"interests of Irovetti and his ilk. I will order that we only prosecute "
"propaganda, and leave the true artists alone.\""
msgstr ""
"\"흠... 전 검열에 대해서 반대해요. 하지만 예술가들이 길이길이 남을 걸작을 만들어야 한다는 것엔 동의해요. 이로베티같은 자들의 "
"흥미거리 역할만 하다 끝나지 말고 말예요. 우린 선전만 할 뿐, 예술가들을 괴롭히진 말라고 말해둬야겠어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0034_Text
#. Speaker : Valerie_Companion
msgctxt "11381a56-33c9-44c3-b20e-a4bab503c664"
msgid ""
"\"Very good. I've always disliked the fact that foolish, dirty, and "
"troubling concepts which are naturally forbidden from polite discussion are "
"nevertheless routinely published, even in polite society. From now on, let "
"both our conversation and our press be right and just.\""
msgstr ""
"\"좋군요. 점잖은 사회에서조차 자연스럽게 터부시되는 이 어리석고, 지저분하며 말썽만 가득한 개념이 관례적으로 통용되는 게 마음에 안 "
"들었습니다. 이제부턴 언론과 대중이 공정하고 올바르게 나아가도록 합시다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0035_Text
#. Speaker : SadisticMage_Capital
msgctxt "bdb6ab4d-b095-4250-a2e0-4508d5bc33a3"
msgid ""
"\"A wise decision. We cannot allow rebellious concepts to trouble your "
"subjects' minds. Let all our writers and artists, who hope to be published, "
"pursue a positive tone in their writing – befitting to the kingdom, its "
"people, and of course, to you, Your Highness.\""
msgstr ""
"\"현명한 선택입니다. 백성들의 정신 속에 반란분자들의 생각이 돌아다니게 내버려둘 수는 없지요. 관심받길 원하는 우리 작가와 예술가들이 "
"글을 적을 때 긍정적인 논조로만 적게 합시다. 왕국에도 좋고, 백성들에게도 좋고, 물론 당신에게도 좋은 일입니다, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0036_Text
#. Speaker : Linzi_Companion
msgctxt "7354d6e2-66f4-4662-9242-207898152566"
msgid ""
"\"You've made a truly generous decision. Some of the foreigners are bound to "
"grumble and leave, but the well-being of your own people is your first "
"responsibility. Why shouldn't we be allowed to help our own merchants and "
"subjects?\""
msgstr ""
"\"참으로 관대한 결정을 내리셨어요. 몇몇 외국인들이 투덜거리며 떠나고 있지만, 백성들의 안위가 제일 먼저죠. 우리 상인과 백성들을 돕는 "
"게 뭐가 잘못되었나요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0037_Text
#. Speaker : Valerie_Companion
msgctxt "eacf41fd-5bf0-4073-b4ac-f63a18dd71ce"
msgid ""
"\"A decent ruler must provide for their subjects. Their well-being is your "
"most important responsibility. If any foreign merchants raise an objection, "
"let them demand the same treatment from their own ruler, not from us!\""
msgstr ""
"\"군주란 모름지기 백성들을 위해야 하는 법입니디다. 백성들의 안위가 최우선입니다. 다른 외국 상인들이 반항한다면, 그들에게 자기네들 "
"군주에게도 같은 것을 요구하라고 하십시오. 우리가 아니라 말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0038_Text
#. Speaker : SadisticMage_Capital
msgctxt "cbfc4dad-081a-41b4-a262-f25da1bf1fd4"
msgid ""
"\"Wonderful. Let the foreigners leave if they don't like it. It can only "
"indicate one thing — that they'd hoped to trick and cheat our merchants, and "
"we rightly defended our interests.\""
msgstr ""
"\"멋집니다. 싫으면 저들이 떠나라지요. 한 가지는 확실합니다. 저들이 우리 상인들에게 사기를 치려고 한다면, 우리는 정당하게 우리 "
"이익을 보호할 거라는 것이지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0039_Text
#. Speaker : Linzi_Companion
msgctxt "3626f084-dec9-4984-9a6d-349e7fde6d8d"
msgid ""
"\"Others seek to hide from persecution, slavery, or the disdain that they "
"face at home. We can officially invite them to come here and live under your "
"protection. – But here's a better idea I've been polishing: why don't we "
"establish publishing houses abroad? They could print regular reports for "
"your subjects, so they can keep up with domestic affairs.\""
msgstr ""
"\"다른 이들은 고향에서 멸시당하고, 박해받는 사람들이에요. 노예 상인을 피해 숨을 곳을 찾고 있죠. 공식적으로 우리 땅에 초청해서 "
"보호할 수 있지만, 제게 더 좋은 생각이 떠올랐어요. 해외에 인쇄소를 차리면 어떨까요? 정기적으로 보고를 받으면 우리 국민들이 바깥 "
"소식을 더 잘 알 수 있을 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0040_Text
#. Speaker : Linzi_Companion
msgctxt "eda58551-eee1-4473-8acc-30d851bc8580"
msgid ""
"\"You must remember, however, that not every neighbor is fond of your glory. "
"I would advise you to take measures to limit their influence on your "
"citizens' thoughts. For instance, we could establish a censorship board to "
"block the political efforts of our enemies. – But with a light touch, and "
"not to a point of cultural domination.\""
msgstr ""
"\"하지만 명심하세요. 우리의 영광을 시기하는 이웃나라는 시민들에게 안 좋은 영향을 끼치려 할 거예요. 그 영향력에 제한을 두려면 검열 "
"위원회를 구성하는 것도 한 방법이죠. 적의 정치 공작을 막을 수 있게 느슨한 규제만 주자는 거예요. 시민들의 문화 활동은 그대로 놔두고요."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0041_Text
#. Speaker : Valerie_Companion
msgctxt "b768b967-675a-4c23-9ae9-230ff1a9f9f3"
msgid ""
"\"On the domestic front, our citizens travel to foreign countries and settle "
"down, but deep inside they still consider themselves your subjects. It would "
"be nice to maintain this connection by keeping them apprised events in their "
"homeland. We could distribute some printed media just for the natives of "
"your kingdom. On the other hand... Are you aware how many people would be "
"happy to be your subjects? Thousands! The oppressed, the abused, the "
"mistreated, the wrongly accused, the slaves... What a noble gesture it would "
"be to declare your lands a safe haven for all these lost souls, and to "
"promise them your protection.\""
msgstr ""
"\"우리 시민이 외국에 나가 살기도 하지만, 스스로를 여전히 당신의 백성이라 여기고 있습니다. 교포들을 위해 고국의 소식을 전하는 것으로 "
"이 유대를 유지하는게 좋겠습니다. 그리고 또... 얼마나 많은 사람들이 당신의 백성이 되서 행복해질 수 있을지 아십니까? 수천입니다! "
"탄압받는 사람들, 부당한 대우를 받는 사람들, 억울하게 고소당한 사람들, 노예들... 당신의 땅을 이 길 잃은 영혼들을 위한 안식처로 "
"선포하고, 보호를 약조하면 정말 고귀한 행동이 될 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0042_Text
#. Speaker : Valerie_Companion
msgctxt "a491cf28-20bf-4434-8aed-6dc886e1958a"
msgid ""
"\"Another way to eliminate any chance of sedition is to show the people how "
"benevolent you are. Grant certain privileges to the native merchants, which "
"are denied to importers. Of course, many foreign traders will be "
"disappointed, but the newfound wealth of the locals will give them good "
"reason to glorify you! However, I think it wisest to simply silence anyone "
"who promotes dangerous ideas. With your approval, I will assemble a "
"censorship board right away.\""
msgstr ""
"\"다른 방법으로 당신의 자애로움을 드러내서 선동의 기회를 차단할 수 있습니다. 우리 상인들에게 수입상에게는 허용되지 않는 일정한 특권을 "
"부여하는 겁니다. 물론 많은 외국 상인들이 실망할 것입니다. 그러나 주민들을 위해 부를 창출하는 것은 당신을 찬미할 좋은 이유가 될 "
"것입니다. 하지만 위험한 생각을 조장하는 사람은 입을 다물게 하는게 현명하다 생각합니다. 명을 내리시면 바로 검열위원회를 소집하겠습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0043_Text
#. Speaker : SadisticMage_Capital
msgctxt "69d8464d-3d4f-4b0d-9bc7-f35afb323cec"
msgid ""
"\"We have a few options for maintaining this growth. Firstly, it would be "
"nice to stay in touch with those who are traveling abroad. One could compare "
"it to a sort of leash, you know. That is to say, we could publish a "
"newspaper for our kingdom's expatriates. Even if things aren't going so "
"smoothly here at home, our reputation abroad will be protected.\""
msgstr ""
"\"이 성장세를 유지할 수 있는 방안이 몇 가지 있습니다. 첫째, 해외 여행을 나간 사람들과 소식을 주고 받는 것입니다. 아시다시피 이건 "
"목줄에 비유할 수 있겠습니다. 우리 왕국의 국외 이주자를 위한 신문을 발행하면, 국내 상황이 좋지 않게 돌아가더라도 해외에서는 우리의 "
"명성을 유지할 수 있을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0044_Text
#. Speaker : SadisticMage_Capital
msgctxt "dcea2de3-c6ee-4263-a78d-e30a8ecd657b"
msgid ""
"\"Secondly, we could form a censorship board to prevent foreign agitators "
"from clouding your subjects' minds with doubt. Thirdly, and this is my "
"preferred method, we could expel from our borders all our disgruntled "
"commoners — and all the henchmen of foreign monarchs. It wouldn't take much. "
"We would simply have to persuade your subjects that denunciating their "
"neighbors for the good of the kingdom is a noble and honorable act.\""
msgstr ""
"\"둘째, 검열위원회를 구성해서 다른 나라의 선동가들이 당신의 백성에게 의심을 불어넣는 것을 막을 수 있습니다. 셋째, 저는 이 방법을 "
"추천드립니다만, 불만을 품은 평민들과 다른 나라 군주의 심복들을 모조리 국경에서 추방하는 겁니다. 우리는 그저 왕국의 이익을 위해 이웃 "
"나라를 비난하는 것은 고귀하고 명예로운 행동이라고 백성들을 설득하기만 하면 됩니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0047_Text
#. Speaker : Linzi_Companion
msgctxt "616436f0-2522-454b-a9fa-9e7d910624d3"
msgid ""
"\"We could call upon the people's help. Let them report those who spread "
"seditious ideas. – After all, it's for their own good! However, I think the "
"best option would be simply to show that your concern for your own subjects "
"surpasses all else. Consider giving your merchants special privileges, which "
"are denied to foreigners. The latter might object, but this will be "
"guaranteed to maintain national pride."
msgstr ""
"국민에게 선동가를 제보 받는 방법이 있죠. 자발적으로 치안을 강화할 수 있겠네요! 저는 백성을 최우선으로 생각하는 모습을 보여주는 게 더 "
"좋을 것 같아요. 우리 상인들에게 외국인에겐 주지 않는 특권을 주는 거죠. 외국인들은 싫어하겠지만, 애국심을 기를 수 있을 거예요."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank10/Cue_0048_Text
#. Speaker : SadisticMage_Capital
msgctxt "b4c9adb3-3ad1-4e67-8932-cd9e829af0b5"
msgid ""
"\"Apart from that, there are many citizenship applicants. Rumor has it that "
"you plan on turning your kingdom into a refuge for the poor, ugly, and sick. "
"But what use could we possibly have for a crowd of invalids? It would be "
"better to promise citizenship only to the strong and brave – those prepared "
"to spill their blood in military service to prove their loyalty!\""
msgstr ""
"\"그 밖에도 시민권 신청자가 많이 있습니다. 당신이 왕국을 가난하고, 못생기고, 아픈 사람들을 위한 피난처로 만들 계획이라는 소문이 "
"있습니다. 이 쓸모없는 군중들을 어디에 쓸 수 있겠습니까? 강하고 용맹한 사람들에게만 시민권을 주십시오. 군대에서 피 흘려 싸워 충성을 "
"입증할 준비가 된 사람들 말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Answer_0011_Text
msgctxt "7e833a1c-1bd0-4fec-9fb7-0e33433c979c"
msgid ""
"{g|Relations2_1}[Choice effects]{/g} \"Let's just look the other way. "
"They're only hunters.\""
msgstr "{g|Relations2_1}[선택 시 효과]{/g} \"다른 방법을 찾아 보자. 그들은 사냥꾼일 뿐이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Answer_0012_Text
msgctxt "fd3b2ad7-6486-42db-93a8-9d22c8a08859"
msgid ""
"{g|Relations2_2}[Choice effects]{/g} \"We will immediately increase border "
"control. We must put an end to such incursions immediately!\""
msgstr "{g|Relations2_2}[선택 시 효과]{/g} \"즉시 국경 통제를 강화하고, 당장 그런 침입을 막아라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Answer_0013_Text
msgctxt "9187a206-87e0-457f-88dc-4b2ca1831484"
msgid ""
"{g|Relations2_3}[Choice effects]{/g} \"I agree with your proposal. Set the "
"fines as you see fit.\""
msgstr "{g|Relations2_3}[선택 시 효과]{/g} \"제안을 받아들인다. 너의 생각대로 벌금을 정해라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Answer_0014_Text
msgctxt "8eae5eb4-0192-4054-8873-7e9acd360668"
msgid "\"You can deal with this without me.\""
msgstr "\"알아서 처리하도록.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "d7c0ea61-b00d-436f-a6c9-e5907a669bbd"
msgid ""
"\"This will only take a moment! Really, it's nothing. But I do need your "
"advice!\""
msgstr "\"잠깐이면 돼요. 정말로요! 별일 아니지만 당신의 조언이 필요해요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0002_Text
#. Speaker : Linzi_Companion
msgctxt "9bd1790c-491d-4df0-becf-70eb75899eca"
msgid ""
"\"Some hunters from {g|Pitax}Pitax{/g} are wandering the outskirts of your "
"{mf|barony|barony|kingdom|kingdom}. If you ask me – I don't care. There's "
"enough game for everyone. But the locals are outraged: what kind of "
"{mf|barony|barony|kingdom|kingdom} is it, if just anyone can cross our "
"borders!\""
msgstr ""
"\"몇몇 {g|Pitax}피탁스{/g} 사냥꾼이 당신의 {mf|남작령|남작령|왕국|왕국}의 외곽을 돌아다니고 있어요. 나는 어차피 "
"사냥감도 많은데 별 상관없다고 생각해요. 하지만 우리 주민들은 아주 화가 났어요. 누구든 국경을 넘을 수 있다면, 그게 무슨 "
"{mf|남작령|남작령|왕국|왕국}이냐면서요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0003_Text
#. Speaker : Linzi_Companion
msgctxt "fa601175-73fe-4a4e-a07a-5b707dd427bb"
msgid ""
"{n}Linzi shrugs.{/n} \"We are not going to introduce border patrols because "
"a couple of does got shot! Right? Right?\""
msgstr "{n}린지는 어깨를 으쓱한다.{/n} \"두 사람이 화살을 맞았을 뿐인데 국경 순찰을 시행하진 않겠죠? 그쵸? 그쵸?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0004_Text
#. Speaker : Valerie_Companion
msgctxt "1bebb186-cb59-4035-bb1b-902ff0e97dfa"
msgid ""
"\"It appears that not all of your neighbors know that lawful order has come "
"to the {g|Stolen Lands}Stolen Lands{/g}!\" {n}Valerie frowns severely.{/n} "
"\"Over many years, they have grown accustomed to these territories belonging "
"to monsters and bandits – and have learned to behave accordingly.\""
msgstr ""
"\"{g|Stolen Lands}도둑맞은 땅{/g}에 질서가 도래했다는 사실을 이웃 나라 모두가 알지는 못하는 걸로 보입니다!\" {n}"
"발레리는 아주 인상을 썼습니다.{/n} \"수 년에 걸쳐 괴물과 산적이 이 영토를 지배하는 동안, 이웃 나라는 거기에 맞춰 행동해왔습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0005_Text
#. Speaker : Valerie_Companion
msgctxt "e43b54b6-de73-44aa-af0d-7563775c40b0"
msgid ""
"\"I've heard rumor that hunters from {g|Pitax}Pitax{/g} cross the borders "
"into the {mf|barony|barony|kingdom|kingdom}, searching for game. They cross "
"state borders as easily as wading across a stream!\""
msgstr ""
"\"저는 {g|Pitax}피탁스{/g} 사냥꾼들이 {mf|남작령|남작령|왕국|왕국}의 국경을 넘어 사냥감을 찾아다닌다고 들었습니다. "
"그들은 마치 개울을 건너는 것처럼 쉽게 국경을 넘어다닙니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0006_Text
#. Speaker : Valerie_Companion
msgctxt "c1b58ef3-7726-4730-a670-ed9e08433eae"
msgid ""
"\"I don't want to sit idly and watch, as the peasantry of a foreign kingdom "
"mocks our laws! Please, enforce control over the "
"{mf|barony|barony|kingdom|kingdom}'s borders – it will be an important move, "
"for anyone who doesn't yet take your rule seriously!\""
msgstr ""
"\"외국 촌뜨기들이 우리의 법을 비웃는데 멍청히 앉아서 지켜보기만 하고싶지는 않습니다! 제발 {mf|남작령|남작령|왕국|왕국} 국경을 "
"통제해 주십시오. 당신의 규칙을 심각하게 받아들이지 않는 이들에게는 중요한 한 수가 될겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0007_Text
#. Speaker : SadisticMage_Capital
msgctxt "39098755-8cb3-4f98-8ea6-32bdd87b1585"
msgid ""
"{n}Bartholomew bows to you.{/n} \"You won't believe this, {mf|Your Grace|"
"Your Grace|Your Highness|Your Highness}. There are border crossers in your "
"lands!\""
msgstr ""
"{n}바솔로뮤는 당신에게 인사합니다.{/n} \"믿기 힘들겠지만 {mf|영주님|영주님|전하|전하}, 당신의 땅에 국경을 넘어다니는 놈들이 "
"있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0008_Text
#. Speaker : SadisticMage_Capital
msgctxt "df92fe9c-7419-452c-b16b-49ee6ec115c8"
msgid ""
"\"In fact they're just some deer hunters from {g|Pitax}Pitax{/g}, roaming "
"the swamps looking for game. But they gave me a wonderful idea – which I "
"hasten to share with you!\""
msgstr ""
"\"사실 그들은 {g|Pitax}피탁스{/g}에서 온 사슴 사냥꾼일 뿐입니다. 사냥감을 찾아 늪을 돌아 다녔습니다. 하지만 그걸로 멋진 "
"생각을 떠올렸습니다. 당신께 알려드리려고 서둘러 왔습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0009_Text
#. Speaker : SadisticMage_Capital
msgctxt "9f01490e-c277-4326-b690-e8a05b0c86c8"
msgid ""
"\"Of course, we could look the other way in this situation... Or enforce "
"border control... but I propose something else: let's set large fines for "
"crossing our borders! Believe me, these adventurers will have an easy choice "
"between money and prison!\""
msgstr ""
"\"물론, 이 상황에 대처할 다른 방법을 찾을 수도 있습니다만... 국경 통제라든지... 하지만 저는 다른 제안을 하겠습니다. 국경을 "
"넘을 때 많은 벌금을 부과하는 겁니다! 저를 믿으십시오. 이 모험가들은 돈과 감옥 사이에서 쉬운 선택을 할겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0015_Text
#. Speaker : Linzi_Companion
msgctxt "d71de6f3-03bd-4650-9c53-d88ef27a290a"
msgid ""
"\"That's what I thought too! So let's discuss something more important...\""
msgstr "\"그게 바로 내 생각이야! 어디 더 중요한 것을 논의해 볼까...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0016_Text
#. Speaker : Valerie_Companion
msgctxt "de398edb-346e-40d4-a953-d4db8daf6dfa"
msgid ""
"{n}Valerie squints.{/n} \"I am concerned by your casual attitude towards "
"such a serious issue. But so be it.\""
msgstr "{n}발레리 곁눈질을 합니다.{/n} \"저는 당신이 이런 심각한 문제를 대수롭지 않게 생각하는게 걱정됩니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0017_Text
#. Speaker : SadisticMage_Capital
msgctxt "d808c0e8-442e-4098-9a2c-af27c01e00d8"
msgid ""
"{n}Bartholomew waves his hands.{/n} \"Why pass up such an opportunity?\" {n}"
"He quickly straightens himself.{/n} \"Well, if this is your wish, I dare not "
"argue.\""
msgstr ""
"{n}바솔로뮤는 그의 손을 흔들었다.{/n} \"왜 이런 기회를 놓치십니까?\" {n}그는 빨리 자신을 가다듬습니다.{/n} \"뭐, "
"이것이 당신의 바람이라면, 저는 별 말하지 않겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0018_Text
#. Speaker : Linzi_Companion
msgctxt "379b5743-398d-4fa4-917b-e137fc123529"
msgid ""
"{n}Linzi lets out a disappointed moan.{/n} \"Seriously? Just because someone "
"got lost while they were hunting? We could just pretend we didn't notice!\""
msgstr ""
"{n}린지는 실망스러운 신음을 내뱉습니다.{/n} \"정말로요? 누가 사냥을 하다가 길을 잃은 것 때문에요? 그냥 못알아챈 척 할수도 "
"있잖아요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0019_Text
#. Speaker : Valerie_Companion
msgctxt "0f7ef0b1-6b92-4332-8a41-c44854606b0a"
msgid ""
"{n}Valerie nods.{/n} \"I will see to it that our soldiers take up this duty "
"as soon as possible.\""
msgstr "{n}발레리는 고개를 끄덕인다.{/n} \"저는 우리 병사들이 가능한 한 빨리 이 임무를 수행하도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0020_Text
#. Speaker : SadisticMage_Capital
msgctxt "83050b81-9f4c-4a92-a5bb-0dbcb558a0da"
msgid "\"As you wish, as you wish...\""
msgstr "\"분부하신대로 하겠습니다. 분부대로...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0021_Text
#. Speaker : SadisticMage_Capital
msgctxt "75501deb-90a1-4164-aa32-8fedf0cd43cb"
msgid ""
"{n}Bartholomew breaks into a sugary smile.{/n} \"Thank you, {mf|Your Grace|"
"Your Grace|Your Highness|Your Highness}!\""
msgstr "{n}바솔로뮤는 달콤한 웃음을 터뜨립니다.{/n} \"고맙습니다, {mf|영주님|영주님|전하|전하}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0022_Text
#. Speaker : Linzi_Companion
msgctxt "bacbe179-7569-46cd-ac3e-2804633adbbc"
msgid "\"Then I will try to calm our over-vigilant subjects!\""
msgstr "\"그러면, 저는 백성들의 과도한 경계를 진정시킬게요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0023_Text
#. Speaker : Valerie_Companion
msgctxt "9fb26902-cbcf-48cd-ba14-ace71c16280b"
msgid "\"Agreed. I will set up border outposts at the first opportunity.\""
msgstr "\"알겠습니다. 이번 기회에 저는 국경 초소를 세우겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank2/Cue_0024_Text
#. Speaker : SadisticMage_Capital
msgctxt "ecf6c75f-9bed-42d9-ad10-f9a4a9028507"
msgid ""
"\"Then your treasury will soon be filled at the expense of our neighbors!\""
msgstr "\"이로써 이웃 국가의 부를 소진시켜 당신의 금고를 채울 것입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Answer_0011_Text
msgctxt "d854211f-a4e7-4e0a-93bd-ad98d114bacf"
msgid ""
"{g|Relations3_1}[Choice effects]{/g} \"I support the trade agreement with "
"Razmiran.\""
msgstr "{g|Relations3_1}[선택 시 효과]{/g} \"나는 라즈미란과의 교역 협정을 지지한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Answer_0012_Text
msgctxt "04119997-544f-4d43-9c5b-cec7ab458d15"
msgid "\"Reject this proposal.\""
msgstr "\"제안을 거부해라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Answer_0013_Text
msgctxt "58f96744-baea-463b-bfcf-a846b3ad191e"
msgid "\"I will fully rely on you in this matter.\""
msgstr "\"이 문제를 너에게 위임하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Answer_0023_Text
msgctxt "19406ef1-2442-4463-aca9-26ab76c22933"
msgid "\"Tell me about this Razmir.\""
msgstr "\"라즈미르에 대해 말해봐라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "654681c4-4a6d-41e8-a86f-7cae6ecb7319"
msgid ""
"{n}Linzi broods upon the letter she's holding in her hands.{/n} \"I received "
"this today. An official letter from {g|Razmiran}Razmiran{/g}... with a trade "
"proposal.\""
msgstr ""
"{n}린지가 손에 쥔 편지를 보며 생각에 잠겼다.{/n} \"저는 오늘 이걸 받았어요. {g|Razmiran}라즈미란{/g}의... 무역 "
"제안서입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0002_Text
#. Speaker : Linzi_Companion
msgctxt "9ef30d12-cc7e-4afe-8e99-4e7b2e986e6c"
msgid ""
"\"It seems the {mf|barony|barony|kingdom|kingdom} has grown large enough to "
"excite curiosity even in odd corners of the {g|River Kingdoms}River "
"Kingdoms{/g}. It's just that...\" {n}Linzi sighs.{/n} \"I don't think "
"{g|Razmiran}Razmiran{/g} would make the best ally. Since their self-"
"proclaimed god, Razmir, rules there, tyranny has flourished across the "
"country, and they think little of their neighbors. – They just occupy any "
"lands they can!\""
msgstr ""
"\"{mf|남작령|남작령|왕국|왕국}이 {g|River Kingdoms}강의 왕국들{/g}의 외진 구석에 있으면서도 다른 나라의 호기심을 "
"불러 일으킬 정도로 커졌어요. 그치만... \" {n}린지가 한숨을 쉬었다.{/n} \"나는 {g|Razmiran}라즈미란{/g}이 "
"최고의 동맹국이 될거라고 생각하지 않아요. 라즈미르는 신을 자청하는 자가 나라를 통치하기 때문에 폭정이 온나라를 덮고 있고, 이웃 국가를 "
"조금도 생각하지 않아요. 라즈미르는 차지할 수 있는 땅은 모조리 차지하죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0003_Text
#. Speaker : Linzi_Companion
msgctxt "64eec7d5-c44c-4677-871e-81930108e6d5"
msgid ""
"\"If I were you, I would politely decline their trade agreement. Who knows – "
"maybe it's a trick? Although the terms seem profitable...\" {n}Linzi looks "
"at the letter again.{/n}"
msgstr ""
"\"저라면 정중하게 무역 협상을 거절하겠어요. 속임수일지도 모르잖아요? 괜찮은 조항도 있지만...\" {n}린지는 편지를 다시 "
"봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0004_Text
#. Speaker : Valerie_Companion
msgctxt "2cf1c63a-0f8f-4a0f-917d-414603127775"
msgid ""
"{n}Valerie shows you an open letter bearing an official seal.{/n} \"We have "
"received an offer of a trade agreement from the kingdom of "
"{g|Razmiran}Razmiran{/g}, which lies to the west of your lands.\""
msgstr ""
"{n}발레리는 공식 인장이 있는 공개 서한을 보여줍니다.{/n} \"우리는 {g|Razmiran}라즈미란{/g}의 교역 협정의 제안을 "
"받았습니다. 당신의 땅의 서쪽에 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0005_Text
#. Speaker : Valerie_Companion
msgctxt "7f5a789b-e4ca-4e58-88d6-b7afa712e338"
msgid ""
"\"The proposal seems quite fair. The letter was composed by Razmir's "
"lawyers, and it seems very transparent. Of course, I will give it to our men "
"of law, if you deem it worthy of consideration.\""
msgstr ""
"\"이 제안서는 꽤 공정해보입니다. 서한은 라즈미르의 법률가들이 작성했으며, 아주 투명성 있게 보입니다. 당신이 이게 고려할만하다고 "
"생각하면, 물론 우리 법률가들에게도 보여 줄 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0006_Text
#. Speaker : Valerie_Companion
msgctxt "b13cf9df-e394-4eb1-99d4-38b945d9433a"
msgid ""
"{n}Valerie pauses.{/n} \"Of course you know that {g|Razmiran}Razmiran{/g} is "
"an unusual kingdom. Many are suspicious of its self-proclaimed god ruler, "
"and its aggressive ambitions... But I won't give you any advice on this "
"matter. Please make your own decision.\""
msgstr ""
"{n}발레리가 멈칫합니다.{/n} \"물론 아시다시피 {g|Razmiran}라즈미란{/g}은 특이한 왕국입니다. 신을 자칭하는 통치자와 "
"그 정복욕에 대해서 많은 사람들이 수상하게 여기고 있습니다... 그러나 저는 이에 대해서는 의견을 내지 않겠습니다. 결정을 내려주십시오."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0007_Text
#. Speaker : SadisticMage_Capital
msgctxt "1206c533-fbbc-4669-bebc-0741625e86e9"
msgid ""
"{n}Bartholomew holds up an open letter.{/n} \"Look, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}! Your neighbors seek trade agreements "
"with you. I received this letter from distant {g|Razmiran}Razmiran{/g} – a "
"country ruled by Razmir himself. Have you heard of him?\""
msgstr ""
"{n}바솔로뮤는 공개 서한을 들고 왔다.{/n} \"보십시오, {mf|영주님|영주님|전하|전하}! 이웃 나라들이 당신과 교역 협정을 "
"맺고자 합니다. 저는 멀리서 이 서한을 받았습니다. {g|Razmiran}라즈미란{/g}, 라즈미르가 통치하는 나라. 들어보셨습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0008_Text
#. Speaker : SadisticMage_Capital
msgctxt "3ef5ef77-c9ac-4145-b4f0-e9a95bbbb4b2"
msgid ""
"\"He's quite a curious person, I must say! Managed to persuade the entire "
"country that he's a living god! That's something to admire!\" {n}Bartholomew "
"laughs.{/n} \"Well, whatever you may think of that, his country is among the "
"most promising of the young kingdoms. We could use such a friendship!\""
msgstr ""
"\"그는 아주 특이한 사람입니다. 들어보십시오! 그가 살아있는 신이라는 것을 믿도록 국가 전체를 관리하다니! 존경할 만한 일입니다!\" "
"{n}바솔로뮤는 웃는다.{/n} \"글쎄, 당신이 그걸 어떻게 생각하든 간에, 그의 나라는 젊은 왕국들 중에서 가장 유망한 나라입니다. "
"친교를 맺는다면 아주 요긴할 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0009_Text
#. Speaker : SadisticMage_Capital
msgctxt "a81bfb85-4927-4fdd-ada6-d200d52b23fd"
msgid ""
"\"I think we should accept this agreement. But of course, the final decision "
"is yours!\""
msgstr "\"저는 우리가 이 합의를 받아들여야 한다고 생각합니다. 물론 결정은 당신이 하시지만.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0014_Text
#. Speaker : Linzi_Companion
msgctxt "7c6976f8-e420-4e48-a0db-e749a6762b1f"
msgid ""
"{n}Linzi sighs.{/n} \"As you wish. I'm just afraid this might not turn out "
"well for us...\""
msgstr "{n}린지가 한숨을 쉬었다.{/n} \"분부대로, 이게 우리에게 안 좋은 일이 될까봐 두려워요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0015_Text
#. Speaker : Valerie_Companion
msgctxt "c670f728-8cfb-4704-a21a-ceaf85b365bf"
msgid "{n}Valerie nods.{/n} \"Understood.\""
msgstr "{n}발레리는 고개를 끄덕인다.{/n} \"알겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0016_Text
#. Speaker : SadisticMage_Capital
msgctxt "3d251608-a62f-4cd2-8654-4c2da4ede2b9"
msgid ""
"{n}Bartholomew tenderly strokes the letter in his hands.{/n} \"An excellent "
"decision, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! I will "
"compose our reply immediately!\""
msgstr ""
"{n}바솔로뮤는 편지를 톡하고 쳤다.{/n} \"훌륭한 결정이십니다, {mf|영주님|영주님|전하|전하}! 저는 즉시 답장을 작성하겠습니다!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0017_Text
#. Speaker : Linzi_Companion
msgctxt "a9914dc8-69bf-4bf3-992c-51a63a40bc32"
msgid ""
"{n}Linzi catches her breath.{/n} \"Ah... truth be told, I'm glad. I wouldn't "
"feel good about dealing with a rascal like Razmir...\""
msgstr ""
"{n}린지는 호흡을 가다듬습니다.{/n} \"아... 솔직히 다행이에요. 라즈미르 같은 악당과 거래하면 기분이 좋을 리가 없으니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0019_Text
#. Speaker : SadisticMage_Capital
msgctxt "2076218d-fe84-45f2-bbb1-68ecb862c4db"
msgid "{n}Bartholomew closes his eyes wearily.{/n} \"As you wish...\""
msgstr "{n}바솔로뮤는 짜증으로 눈을 감습니다.{/n} \"분부대로...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0020_Text
#. Speaker : Linzi_Companion
msgctxt "7aded821-0795-48a3-84b8-4ed37c6335cf"
msgid ""
"\"Really? Then I will reject the agreement. Let's just say we both listened "
"to my intuition – it never lets me down!\""
msgstr "\"정말요? 그럼 협약을 거절할게요. 모두 제 직감에 귀를 기울였다고 해두죠. 실망하지 않으실 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0022_Text
#. Speaker : SadisticMage_Capital
msgctxt "832d5221-e78e-4b35-9e56-e28593bac362"
msgid ""
"\"In that case, {mf|Your Grace|Your Grace|Your Highness|Your Highness}, I am "
"inclined to accept. I shall compose our reply without delay!\""
msgstr "\"그 경우, {mf|영주님|영주님|전하|전하}, 저는 받아들이고 싶습니다. 지체없이 답장을 작성하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0024_Text
#. Speaker : Linzi_Companion
msgctxt "07c08244-8907-4580-87b9-605f542c5835"
msgid ""
"\"He's a quirky fellow. He took over a kingdom, and persuaded all the locals "
"that he's a living god! He installed his henchmen in all the key positions, "
"and now rules as he pleases, oppressing the population!\""
msgstr ""
"\"그는 괴짜같은 사람이에요. 그는 왕국 하나를 차지하고, 주민들에게 자신이 살아있는 신이라고 설득했죠! 모든 중요한 자리에는 자기 "
"부하를 심어두고, 자기가 원하는대로 통치하면서, 주민들을 억압하고 있어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0025_Text
#. Speaker : Linzi_Companion
msgctxt "1c29c244-6561-4467-a5c2-19d2bcee8ea0"
msgid ""
"{n}Linzi sighs.{/n} \"The more I think about it, the less I like the idea of "
"dealing with him. He has repeatedly expanded the territory of his own "
"kingdom by occupying his neighbors! Such an attitude towards other countries "
"is seriously worrying.\""
msgstr ""
"{n}린지가 한숨을 쉽니다.{/n} \"생각해볼수록 그와 거래를 하는게 좋은 생각이 아닌 것 같아요. 그는 계속 이웃 나라를 점령해서 "
"자기 왕국의 영토를 확장해왔어요. 다른 나라에 보이는 그런 태도가 정말 걱정돼요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0026_Text
#. Speaker : Valerie_Companion
msgctxt "e9d1c4e8-acdd-425d-8c91-87996736ab65"
msgid ""
"\"If you asked one of {g|Razmiran}Razmiran{/g}'s citizens, you'd hear "
"praises to great god, protector of his nation.\" {n}Valerie purses her "
"lips.{/n} \"But Razmir is no god. Most likely, he's a mighty wizard. He "
"doesn't possess even a trace of true divinity.\""
msgstr ""
"\"만약 전하께서 {g|Razmiran}라즈미란{/g} 시민에게 물어보면, 위대한 신을 찬양하는걸 들을 수 있을겁니다, 그들 국가의 "
"보호자 말입니다.\" {n}발레리는 입술을 오므립니다.{/n} \"하지만 라즈미르는 신이 아닙니다. 확실한건, 그는 강력한 마법사입니다. "
"그에게는 진정한 신성의 한 조각조차 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0027_Text
#. Speaker : Valerie_Companion
msgctxt "32ddb3d4-462f-46a8-90dc-9a752ca50f28"
msgid ""
"\"But {g|Razmiran}Razmiran{/g} is far more than a handful of fanatics. It's "
"a fully independent state. Under Razmir, it has only thrived, and can stand "
"against its enemies. Razmir set his own laws – and it's not up to me to "
"judge them. It's better there are laws than not.\""
msgstr ""
"\"하지만 {g|Razmiran}라즈미란{/g}은 소수의 광신자가 아닙니다. 완전히 독립적인 국가입니다. 라즈미란은 라즈미르의 통치 아래 "
"번영했고 적에 맞설 수 있습니다. 라즈미르는 스스로 법을 제정하였습니다. 그리고 그걸 평가하는게 제 몫은 아닙니다. 법이 없는 것보다는 "
"있는 편이 낫습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0028_Text
#. Speaker : SadisticMage_Capital
msgctxt "775b14af-fc64-4ca3-888c-30d02634afed"
msgid ""
"\"I don't know who he is and where he came from. What's important is that "
"he's capable of subduing an entire nation! Presenting himself as a new god – "
"what an unconventional step! He even provides divine spells to his priests! "
"I don't know how, but he found a way!\""
msgstr ""
"\"저는 그가 누구인지 그리고 어디에 왔는지도 모릅니다. 중요한건 그가 하나의 국가 전체를 제압할 수 있다는 사실입니다! 스스로를 새로운 "
"신으로 소개하면서 말입니다 – 참으로 틀에 박히지 않은 방식이죠! 그는 자신의 사제들에게 신성 주문을 내리기까지 합니다! 어떻게 한건진 "
"모르겠지만, 그는 방법을 찾은겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank3/Cue_0029_Text
#. Speaker : SadisticMage_Capital
msgctxt "2cad9618-c6b9-447d-9686-f0009c165aa3"
msgid ""
"{n}Bartholomew lifts a finger.{/n} \"Think well on this trade agreement with "
"{g|Razmiran}Razmiran{/g}, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. Who knows what opportunities may open to us if we sign it!\""
msgstr ""
"{n}바솔로뮤는 손가락을 들어올립니다.{/n} \"{g|Razmiran}라즈미란{/g}과의 교역 협정에 대해 잘 생각해 보십시오, "
"{mf|영주님|영주님|전하|전하}. 우리가 서명하면 어떤 기회들이 주어질지 누가 알겠습니까!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Answer_0005_Text
msgctxt "583ef2c2-9bea-41ff-a724-31c8c988b62f"
msgid ""
"{g|Relations4_1}[Choice effects]{/g} \"Help the guards find and arrest the "
"runaway elf.\""
msgstr "{g|Relations4_1}[선택 시 효과]{/g} \"경비병들이 도주한 엘프를 찾아 체포할 수 있도록 하여라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Answer_0006_Text
msgctxt "685848fe-e867-4542-b7a6-9e68cdcb3d0c"
msgid ""
"{g|Relations4_2}[Choice effects]{/g} \"Make sure the elf reaches Kyonin.\""
msgstr "{g|Relations4_2}[선택 시 효과]{/g} \"그 엘프가 쿄닌에 확실히 도착할 수 있도록 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Answer_0007_Text
msgctxt "4172a43b-e57a-4b0e-8906-24f46ddc74c2"
msgid "\"Decide his fate as you see fit.\""
msgstr "\"네가 옳다고 생각하는대로 그의 운명을 정하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Answer_0020_Text
msgctxt "ce4f2372-dbaa-4132-b7c3-061fba06d2f0"
msgid "\"Tell me about this conflict between Sevenarches and Kyonin.\""
msgstr "\"세븐아치와 쿄닌 사이의 분쟁에 대해 말해달라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Answer_0024_Text
msgctxt "3836d1ce-2a1b-4b9d-a521-b1aa8bfbb7d8"
msgid ""
"{g|Relations4_3}[Choice effects]{/g} \"We aren't going to interfere in this "
"matter.\""
msgstr "{g|Relations4_3}[선택 시 효과]{/g} \"이 문제에 개입하지 않겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/BartrelBye_String
#. Speaker : SadisticMage_Capital
msgctxt "56e87fb3-dd4f-4e8c-9a76-75d3620e7d7a"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}! I'm probably not "
"wise enough to understand your orders. But I feel a complete fool every time "
"I recommend one thing, and you do something completely different! Does my "
"advice mean so little to you? Did you invite me to become a diplomat just to "
"make fun of me? Alas, I am tired of being a buffoon. You should find a "
"replacement for me, and I will continue to serve you elsewhere.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}! 제가 전하의 명령을 이해할 정도로 충분히 현명하지 못할 수는 있습니다. 하지만 제가 뭔가를 "
"권하고, 전하께서 완전 다른 결정을 내릴 때에는 완전 바보가 된 것 같은 기분이 드는군요! 제 조언이 전하께는 아무것도 아닌 겁니까? "
"제가 외교관이 되도록 초대한건 그저 저를 놀리기 위해서였는지요? 아아, 전 광대가 되는 것에 지쳤습니다. 저를 대신할 사람을 찾으셔야 "
"할겁니다. 그러면 전 다른 곳에서 전하를 섬기도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "cbc2d484-9199-488d-9916-e176043d783a"
msgid ""
"\"There is a guard detail from Sevenarches at the border. They were sent by "
"the Voice of the Wind – one of the elder druids who rule Sevenarches, a "
"diplomat and chief scout. Their guard keeps insisting there's an elf hiding "
"in our lands, a fugitive who slipped out of their city.\""
msgstr ""
"\"세븐아치 국경에서 보내온 경비대가 왔어요. 바람의 목소리가 보낸 사람들이에요. 그는 세븐아치를 다스리는 장로 드루이드 중 한 "
"사람이자, 외교관 그리고 정찰대장이죠. 경비대는 우리 영토에 그들의 도시를 빠져나온 도망자 엘프 한 명이 숨어있다고 주장하고 있어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0002_Text
#. Speaker : Valerie_Companion
msgctxt "8174b74e-1bb6-46a2-a818-1aca1b1a25eb"
msgid ""
"\"But now to the point. – A guard detail from Sevenarches has been stopped "
"at the border. They've been sent by the Voice of the Wind, a druid charged "
"with diplomacy in this River Kingdom. The guards are hunting some elven "
"criminal, a fugitive who is hiding in our lands. They've asked us to provide "
"support, and seem concerned that we might instead help him escape to "
"{g|Kyonin}Kyonin{/g}.\""
msgstr ""
"\"이제 중요한 건입니다. 세븐아치에서 보내온 경비대가 국경에 멈춰서있습니다. 그들은 바람의 목소리가 보낸 사람들입니다. 그는 그 강의 "
"왕국에서 외교를 책임지고 있는 드루이드입니다. 경비대는 우리 영토에 숨어있는 어떤 엘프 범죄자, 도망자를 쫓고 있습니다. 우리가 지원을 "
"해주기를 요청했는데, 우리가 대신 그를 {g|Kyonin}쿄닌{/g}으로 도망갈 수 있도록 돕는게 아닌지 걱정하는 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0003_Text
#. Speaker : SadisticMage_Capital
msgctxt "de1f9c86-1a4c-44e7-a8ba-a56f500d36b3"
msgid ""
"\"For now let me simply report one of such delicate matter. There's a guard "
"detail at the border, sent by the Voice of the Wind – a druid and diplomat "
"from Sevenarches. They're hunting a criminal, an elf who's escaped to our "
"lands. I would imagine they're worried that someone might help the fugitive "
"get to {g|Kyonin}Kyonin{/g}, and ask our assistance in hunting him down.\""
msgstr ""
"\"이제 섬세한 문제에 대해 간단히 보고드리려 합니다. 국경에서 바람의 목소리가 보낸 경비대가 머무르고 있습니다. 그는 세븐아치의 "
"드루이드이자 외교관입니다. 그들은 우리 영토로 도주한 한 엘프 범죄자를 쫓고 있습니다. 그들은 누군가가 도망자를 "
"{g|Kyonin}쿄닌{/g}에 갈 수 있도록 도울지도 모른다고 걱정하고 있는지, 우리에게 그를 추적할 수 있도록 도움을 청했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0008_Text_String
#. Speaker : Linzi_Companion
msgctxt "5f51adaa-1fdd-4234-be15-b78fdd213315"
msgid ""
"\"Why would you believe the guard so readily? It wouldn't be the first time "
"that someone unfavored by the authorities was falsely branded a criminal! We "
"judge without hearing the evidence!\""
msgstr ""
"\"왜 경비대를 그렇게 손쉽게 신뢰하는거죠? 권력의 눈 밖에 난 사람들이 범죄자라는 가짜 낙인을 찍히는건 처음이 아닐건데요! 우린 증거를 "
"듣지도 않고 판단하고 있어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0009_Text_String
#. Speaker : Valerie_Companion
msgctxt "798753e3-ae74-45dd-a15e-9be84aaf04c9"
msgid ""
"{n}Valerie remains silent for a while, biting her lip.{/n} \"So you believe "
"that accusations against this elf are fair? I wouldn't be so sure of that. "
"It pains me to think that you've made a decision so hastily and without "
"consideration.\""
msgstr ""
"{n}발레리는 잠시 침묵하더니, 입술을 깨뭅니다.{/n} \"그래서 전하는 이 엘프에 대한 고발이 공정하다고 믿는 것입니까? 저는 그렇게 "
"확신하지 못할 것 같습니다. 전하께서 너무 성급하고 심사숙고하지 않은채 결정을 내렸다고 생각하니 고통스럽군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0010_Text
#. Speaker : SadisticMage_Capital
msgctxt "a504aee5-4cdc-49b1-a912-079e08690c7e"
msgid ""
"\"Very good! We will catch the criminal and hand him over to Sevenarches. "
"I'm sure the Voice of the Wind will appreciate the gesture... and might even "
"have some information to share about our neighbors.\""
msgstr ""
"\"훌륭합니다! 범죄자를 잡아서 세븐아치로 넘기도록 하겠습니다. 바람의 목소리가 우리의 몸짓에 감사를 표할거라고 확신합니다... 그리고 "
"어쩌면 우리 이웃들에 대한 정보를 공유할 수 있을지도 모르겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0011_Text
#. Speaker : Linzi_Companion
msgctxt "23d9075f-ef5a-423b-b221-eb73733dbc38"
msgid ""
"\"Helping him get home is the nice thing to do. I'll make sure we find the "
"elf and get him back home safely. I'm sure {g|Kyonin}Kyonin{/g} will "
"appreciate the friendly act! They might even send a letter of gratitude... "
"along with some ancient magical books... Oh, I should stop daydreaming!\""
msgstr ""
"\"그가 고향에 돌아갈 수 있도록 도와주는건 좋은 일이에요. 확실히 엘프를 찾아서 고향에 돌아갈수 있도록 할게요. "
"{g|Kyonin}쿄닌{/g}이 우리의 우호적인 행동에 감사할거라고 확신해요! 어쩌면 감사의 편지를 보낼지도 모르죠... 고대의 마법서와 "
"함께라거나... 오, 몽상은 그만 해야겠어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0012_Text_String
#. Speaker : Valerie_Companion
msgctxt "59072ee3-362b-468f-b60b-790fece09eb7"
msgid ""
"\"I don't like hiding fugitives from justice, until it's proven that their "
"trial was corrupt. And I'm more troubled by the thought that your decision "
"was guided not by your desire to see justice done, but to befriend the elves."
"\""
msgstr ""
"\"저는 도망자를 정의로부터 숨겨주는 것을 좋아하지 않습니다. 그들의 법정이 부패해 있다는 것이 입증되기 않는 한 말입니다. 그리고 "
"전하께서 내린 결정이 정의를 이루기 위해서가 아니라, 엘프와의 친선을 위한 것이라고 생각하니 더 우려되는 바입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0013_Text_String
#. Speaker : SadisticMage_Capital
msgctxt "3f1896ed-e4a4-4800-9221-3b8ecb6a7925"
msgid ""
"\"Ah, {mf|Your Grace|Your Grace|Your Highness|Your Highness}, do you really "
"expect gratitude from {g|Kyonin}Kyonin{/g}? I need scarcely remind you that "
"the elves can be quite arrogant towards their neighbors, and are unlikely to "
"offer any generous gifts in return.\""
msgstr ""
"\"아, {mf|영주님|영주님|전하|전하}, 정말 {g|Kyonin}쿄닌{/g}에서 감사해할 것이라고 예상하시는지요? 엘프들이 이웃 "
"국가에 상당히 거만한 태도로 나온다는 점을 상기시켜드릴 필요도 없을텐데요. 보답으로 관대한 선물을 줄 가능성도 적습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0017_Text
#. Speaker : Linzi_Companion
msgctxt "04af82ee-40f2-4536-9e56-3f78baabd24e"
msgid ""
"{n}Linzi shifts from foot to foot.{/n} \"{name}, not all diplomatic problems "
"are solved openly. Sometimes a problem needs to be concealed, and sometimes "
"knowledge must be cyphered, and secrets overheard. To do this you would need "
"a spy chief. I'm not fit for the job – I'm used to speaking my mind, not "
"keeping silent. Please find a worthy 'minister' for this position, and "
"meanwhile I will try to handle today's delicate matter.\""
msgstr ""
"{n}린지가 비틀거리며 걸어옵니다.{/n} \"{name}, 외교 문제는 공개적으로 해결할 수 없기도 해요. 문제가 있다는 사실 자체를 "
"숨겨야 할 때도 있고, 정보를 암호화하거나, 비밀을 엿들어야 할 때도 있죠. 이런 문제에는 첩보 대신이 필요할 거예요. 저는 그쪽으론 잘 "
"안 맞아요. 생각을 말하는 데는 익숙해도 침묵하긴 어렵거든요. 제발 이런 일에 적합한 장관을 찾아주세요. 저는 다른 까다로운 외교 사안을 "
"해결할게요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0018_Text
#. Speaker : Valerie_Companion
msgctxt "d9e62aed-17c0-4bb4-a484-61cba81f6cea"
msgid ""
"\"{name}, I was born in a noble family, so I can imagine why you decided to "
"entrust me with a diplomatic position. I understand how noble persons think, "
"and how they should be addressed. But I also know that the nobility doesn't "
"always solve their problems openly. Sometimes a dagger, or poison, or a "
"purse of gold in the right pocket can do far more than charters and official "
"letters could hope to achieve. But I myself am no infiltrator. These methods "
"disgust me. You should choose... some other 'minister' to lead your spies.\""
msgstr ""
"\"{name}, 전하께서는 귀족 출신인 제게 외교직을 맡기셨죠. 저는 귀족의 사고방식과 처세술을 익히 알고 있습니다만, 귀족이 언제나 "
"문제를 공개적으로 해결하지는 않습니다. 암살과 음독, 적당한 뇌물이 헌장이나 공식 서한보다 좋은 성과를 이루기도 합니다. 저는 첩보에 "
"익숙하지 않습니다. 또한 그런 방식을 혐오하고요. 하여... 첩보원을 다룰 수 있는 '장관'을 임명하시기를 조언드립니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0019_Text
#. Speaker : SadisticMage_Capital
msgctxt "1abad9fe-b766-4231-b920-62c8ac8b6243"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, more and more "
"delicate issues arise with our neighbors. You need a spymaster... who "
"should, of course, simply be called 'a minister'. I could certainly hold "
"this position, but a spymaster sometimes learns too much about his "
"{mf|lord|lady}, and I wouldn't want you to have even a shadow of a doubt "
"about my loyalty.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 우리의 이웃들과 섬세한 문제들이 점점 더 많이 발생하고 있습니다. 전하께서는 첩보대신이 "
"필요합니다... 물론 그저 단순하게 '대신'이라고 부를 수 있는 사람 말이지요. 저도 분명 그 직책을 맡을 수는 있습니다만, 첩보대신은 "
"때때로 그가 섬기는 {mf|주군|주군}에 대해 너무 많은걸 알게 되기도 합니다. 그리고 저는 전하께서 제 충성심에 대해 의심할 여지조차 "
"없었으면 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0021_Text
#. Speaker : Linzi_Companion
msgctxt "353e2534-965c-4789-9f84-c6206fedbd0f"
msgid ""
"\"Sevenarches are built on a spot that is sacred to elves. The elves fled "
"from there once, and druids, the Oakstewards, have ruled there ever since. "
"The elves of {g|Kyonin}Kyonin{/g} would like to return their shrine, or at "
"least be granted access to it. But druids are wary of Kyonin, and feel "
"hostile to any elves on their territory.\""
msgstr ""
"\"세븐아치는 엘프들에게 신성한 땅 위에 지어졌어요. 예전에 엘프는 그곳에서 도망쳤고, 그 이후로 드루이드 집단인 오크스튜어드가 그 땅을 "
"지배하고 있죠. {g|Kyonin}쿄닌{/g}의 엘프들을 그들의 사원을 되찾거나 적어도 그곳에 갈 수 있는 허락을 받고 싶어해요. 하지만 "
"드루이드는 쿄닌을 경계하고, 그들 영토에 있는 엘프들에게는 적대감을 느끼고 있어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0022_Text
#. Speaker : Valerie_Companion
msgctxt "0c93c447-af8c-41ce-b934-566cea428ac0"
msgid ""
"\"The elves' ancestors even built the seven arches which give the city its "
"name. Then elves abandoned their shrines, or to put it more precisely – they "
"fled. The druids then came to this place to make it their own. Now the "
"Oakstewards rule there.\""
msgstr ""
"\"엘프의 조상들은 도시를 이름짓게한 일곱 개의 아치를 건설하기도 했습니다. 그 이후 엘프는 그들의 사원을 버리고 - 더 정확하게 "
"말하자면 도망갔습니다. 그리고 드루이드들이 이 장소에 와서 자신들의 땅으로 만들었습니다. 이제 오크스튜어드가 그곳을 지배하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0023_Text
#. Speaker : SadisticMage_Capital
msgctxt "a538c36d-9e7e-4bad-9d5a-6f54fa30571b"
msgid ""
"\"The elves claim they built seven arches for which the city is named, "
"though the evidence of this is questionable. Anyway, the elves fled these "
"lands, and druids of the bolder tribes claimed this land for themselves, any "
"built a flourishing settlement.\""
msgstr ""
"\"엘프들은 도시 이름의 유래가 된 일곱 개의 아치를 건설했다고 주장하지만 그에 대한 증거는 의심스럽습니다. 어쨋거나, 엘프는 이 땅을 "
"버리고 도망쳤고, 더 용감한 부족의 드루이드들이 이 땅을 점유하였고, 번성하는 거주지를 건설했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0025_Text
#. Speaker : Linzi_Companion
msgctxt "6a02b01f-e743-4024-b748-1ce98dafeee0"
msgid ""
"\"Hm... At least that way we won't be hurting anyone. But we aren't helping "
"either...\""
msgstr "\"흠... 적어도 그렇게 하면 누군가를 다치게 하지는 않겠네요. 하지만 누굴 돕는 것도 아니죠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0026_Text
#. Speaker : Valerie_Companion
msgctxt "084648ec-943d-4089-b25e-6b61fcc8c6ca"
msgid ""
"\"Very good. We won't help anyone, as we have no proof of anyone's guilt or "
"innocence.\""
msgstr "\"아주 좋습니다. 어느쪽이 죄가 있거나 없는지에 대한 근거가 없으니 어느쪽도 돕지 않겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0027_Text
#. Speaker : SadisticMage_Capital
msgctxt "e4b2d833-a3d6-4713-a7b1-57b1d7140e66"
msgid ""
"\"Well, we won't make any enemies this way. But we won't get useful allies "
"either... though we might have!\""
msgstr ""
"\"글쎄요, 이런 방식이면 적을 만들지는 않겠습니다. 하지만 유용한 동맹을 구할 수도 없겠군요... 동맹을 만들 수도 있을텐데 말입니다!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0028_Text
#. Speaker : Linzi_Companion
msgctxt "68272294-c5b9-409b-b084-fdef08a13312"
msgid ""
"\"They asked us to help capture him, or at least not to hinder their search. "
"But in Sevenarches they'll say an elf is a 'criminal' when they really mean "
"he's a 'hindrance'. Since it wasn't us who sentenced him, why should we "
"assume that he's the villain? It would be better if find him and help him "
"get back home to {g|Kyonin}Kyonin{/g}.\""
msgstr ""
"\"우리한테 추격을 돕거나 적어도 방해하지 말아 달라고 요청했어요. 하지만 세븐아치에서 유죄 판결받은 엘프는, 대체로 윗사람 심기를 "
"거스른 거라고 보시면 돼요. 우리 영토에서 저지른 죄도 아닌데, 나쁜 사람 취급할 필요는 없겠죠. 물론 엘프를 먼저 찾아서 "
"{g|Kyonin}쿄닌{/g}에 있는 고향으로 돌아갈 수 있게 도와주면 더 좋을 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0029_Text
#. Speaker : Valerie_Companion
msgctxt "18e311ee-bf6e-4676-8c91-80d68b84b3b0"
msgid ""
"\"I don't advise taking either side. Everyone knows that the people of "
"Sevenarches have no love of elves and rarely judge them equitably. But "
"everyone has heard of the elven conspiracy to reclaim Sevenarches for "
"themselves. Either way, this argument has nothing to do with us. I recommend "
"you refuse to allow the guards onto our lands, but don't help the runaway "
"elf either.\""
msgstr ""
"\"중립을 유지하는 편이 좋겠습니다. 세븐아치는 엘프에게 호의적이지 않습니다. 공정한 재판을 기대하기 어렵겠죠. 하지만 엘프가 세븐아치를 "
"되찾을 음모를 꾸민다는 얘기도 유명합니다. 어느 쪽이든, 이 분쟁은 우리와 관련이 없습니다. 저는 경비대의 입국 요청을 거절하시고, "
"동시에 엘프를 돕지 않으시는 방법을 권하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0030_Text
#. Speaker : SadisticMage_Capital
msgctxt "844a9ba5-ad5d-41c6-b7c2-3bc881e9cdb6"
msgid ""
"\"The Voice of the Wind is very knowledgeable. The winds whisper many "
"secrets to him. It is wise to befriend such useful persons. If we must give "
"them the elf to win their favor, then I'd consider it a bargain no matter "
"who he is or what he's done.\""
msgstr ""
"\"바람의 목소리는 아는 것이 많은 자입니다. 바람이 그에게 많은 비밀을 전해주지요. 그런 유용한 인물과 친구가 되는 것은 현명한 "
"일입니다. 만약 그들의 호의를 얻기 위해 엘프를 줘야한다면, 저는 그가 누구든, 무슨 짓을 저질렀든 좋은 거래라고 생각합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0031_Text
#. Speaker : Valerie_Companion
msgctxt "e297899d-a9f5-41a3-9a57-529fe0e25f84"
msgid ""
"\"The elves of {g|Kyonin}Kyonin{/g} keep trying to return Sevenarches, "
"though they abandoned the place many centuries ago. Meanwhile, the druids "
"see a spy in every elf, and won't tolerate them on their land, although "
"without the elves there wouldn't be any arches at all! Anyway, it's a "
"complicated story, with no one clearly in the right or wrong.\""
msgstr ""
"\"비록 수 세기 전에 세븐아치를 버리기는 했지만 {g|Kyonin}쿄닌{/g}의 엘프들은 세븐아치를 되찾기 위해 노력하고 있습니다. "
"그러는 중에, 드루이드들은 모든 엘프를 스파이라고 의심하고 있고, 그들이 자신들의 영토에 있는 것을 허용하지 않을겁니다. 하지만 엘프가 "
"아니었으면 그곳에는 아치조차 없었을 것입니다! 어쨋거나, 이건 복잡한 얘기이고, 누구도 명백하게 옳거나 그르다고 할 수 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/Cue_0032_Text
#. Speaker : SadisticMage_Capital
msgctxt "b2f7d54a-12a4-4bfe-a00c-c58a6ae807ca"
msgid ""
"\"Now the elves of {g|Kyonin}Kyonin{/g} are demanding the return of "
"Sevenarches – as the land is supposedly sacred to them! Though if you ask "
"me, such a demand smells of deceit. In any case, the Oakstewards who now "
"rule Sevenarches have refused. As a result there's very little peace between "
"them.\""
msgstr ""
"\"{g|Kyonin}쿄닌{/g}의 엘프들은 세븐아치의 반환을 요구하고 있습니다. 그 땅이 그들에게는 신성하다는 이유에서 말입니다! "
"하지만 저에게 물으신다면, 그러한 요구에서는 기만의 냄새가 납니다. 어떤 경우라도 현재 세븐아치를 지배하는 오크스튜어드는 거부했을 "
"겁니다. 그 결과 둘 사이에서는 평화라는걸 찾아보기가 어렵게 되었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/LindziRelbye_String
#. Speaker : Linzi_Companion
msgctxt "ac9d71da-40f6-4d7b-8e5d-69cc0402c13b"
msgid ""
"{n}Linzi rubs her cheek, baffled.{/n} \"{name}, forgive me, but I must "
"refuse the position of diplomat. I have always been closer to the people "
"than their rulers, and these diplomatic games are not my strong suit. I will "
"obey your orders, but after today I'd rather just focus on my book. I know "
"you can find a more competent advisor to take my place.\""
msgstr ""
"{n}린지는 당황해서 뺨을 문지릅니다.{/n} \"{name}, 용서해 주세요, 난 외교관을 그만둬야할 것 같아요. 난 항상 지배자보다는 "
"사람들에게 더 가까웠어요, 그리고 이런 외교적인 놀이는 제가 강점이 아니에요. 명령에는 따르겠지만, 오늘 이후로는 그냥 내 책에 "
"집중할래요. 내 자리를 대신할 다른 유능한 보좌관을 찾을 수 있는거 알고 있어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank4/ValerieRelBye_String
#. Speaker : Valerie_Companion
msgctxt "adefd4fc-ff05-463d-accb-f7479659720d"
msgid ""
"\"{name}, I must refuse the position of diplomat. To be honest, your "
"decisions disappoint me, and I don't wish to feel like that towards someone "
"I've sworn to serve loyally and faithfully. I shall guard your back and slay "
"your enemies, but I will not argue over matters of state. You must find "
"yourself another diplomat.\""
msgstr ""
"\"{name}, 제 외교관 직위를 거부해야 하겠습니다. 솔직하게 말해서, 전하의 선택은 저를 실망시켰고, 저는 그런 감정을 충성을 다해 "
"섬기기로 한 사람에게 느끼고 싶지는 않습니다. 전하의 등 뒤를 지키고 적을 베겠지만, 국가 문제에 대해 논쟁하지는 않겠습니다. 다른 "
"외교관을 찾으셔야 할겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5-end/Cue_0002_Text
#. Speaker : Valerie_Companion
msgctxt "f5f0e1e6-229b-4b24-b436-45587d8aaad6"
msgid ""
"\"Here are the latest reports from our scouts. The Black Marquis who used to "
"take interest in your domain has departed for other lands after our "
"modest... demonstration. It seems we managed to avoid the pirate war! This "
"news is truly great for all of us!\""
msgstr ""
"\"정찰대로부터 온 최신 보고입니다. 우리 땅에 관심을 가지고 있던 검은 후작이 우리가 보여준 수수한... 장면을 보고선 돌아섰다고 "
"합니다. 해적 전쟁을 피할 수 있을 거 같습니다! 참으로 호재로군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5-end/Cue_0003_Text
#. Speaker : SadisticMage_Capital
msgctxt "013e845a-a294-4a45-955b-92a405c5dbc5"
msgid ""
"\"{name}, wonderful news! The scouts report that the Black Marquis's "
"blunderheads took an interest in other lands and have left your "
"{mf|barony|barony|kingdom|kingdom}. They'll be someone else's problem now.\""
msgstr ""
"\"{name}, 멋진 소식입니다! 정찰대가 말하길 검은 후작의 무리가 다른 땅에 관심을 돌렸고 우리 {mf|남작령|남작령|왕국|왕국} "
"을 내버려 둘 모양입니다. 이제 우리 문제는 아니군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5-end/Shared_LinziResponse_String
#. Speaker : Linzi_Companion
msgctxt "0149e2b7-de5f-4510-9e3d-9b4b0ce5ce44"
msgid ""
"\"Congratulations, {name}! It looks like your subjects' efforts weren't "
"wasted after all. The Black Marquis and his pirates that were prowling "
"around here won't be attacking the {mf|barony|barony|kingdom|kingdom}. At "
"least that's one problem off our hands!\""
msgstr ""
"\"축하해요, {name}! 백성들의 노력이 헛된 것이 아니었나봐요. 주변을 돌아다니던 검은 후작과 그 해적들이 "
"{mf|남작령|남작령|왕국|왕국} 을 공격하지 않으려는 거 같아요. 이렇게 한 가지 해결 되었군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Answer_0005_Text
msgctxt "7570a0c1-03b2-4f21-ba22-19ca0a8acb04"
msgid "\"I wish to know more about the Black Marquis and his Protectorate.\""
msgstr "\"검은 후작과 그의 보호령에 대해 좀 더 알고 싶습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Answer_0006_Text
msgctxt "eab476a3-9697-4564-8d67-3dce3a568e6c"
msgid ""
"{g|Relations5_1}[Choice effects]{/g} \"Show him how strong our army is. "
"They'd better not cross swords with us.\""
msgstr ""
"{g|Relations5_1}[선택 시 효과]{/g} \"우리 병력이 얼마나 강한지 보여주시오. 우리랑 검을 섞지 않는 게 좋을 것이요."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Answer_0007_Text
msgctxt "24e59afa-d46f-4c1a-b3c2-5760ec442202"
msgid ""
"{g|Relations5_2}[Choice effects]{/g} \"Show him we're rich, and he'll "
"conclude that they'll be better off as our friends.\""
msgstr ""
"{g|Relations5_2}[선택 시 효과]{/g} \"우리가 부자임을 보여주시오, 그리하면 우리랑 친구로 지내는 것이 더 낫다고 "
"생각할 것이오\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Answer_0008_Text
msgctxt "41cb6412-504d-441b-b18a-6d061416227c"
msgid ""
"{g|Relations5_3}[Choice effects]{/g} \"Deceive him. Convince him we're a "
"backwards country with little to offer.\""
msgstr ""
"{g|Relations5_3}[선택 시 효과]{/g} \"그를 속이시오. 아무 것도 가져 갈 것 없는 벽촌이라고 확신하게끔 하시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Answer_0009_Text
msgctxt "f6063082-1cdc-496d-8151-bec29d62358f"
msgid "\"I will leave this decision to you.\""
msgstr "\"당신에게 맡기겠소.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "f5d8293e-7d8b-4003-a359-01131a886783"
msgid ""
"\"{name}, we've arrested a strange man. He was making a map of our rivers "
"and bays. Upon his capture, he shouted that he serves the Black Marquis, and "
"was sent to create a map of the local trade routes. But pirates are full of "
"guile, and this map might be used not for trade, but for raids. What are we "
"going to do with him, being that he's admittedly serving another king?\""
msgstr ""
"\"{name}, 수상한 사람을 체포했습니다. 그는 우리 강역 지도를 만들고 있었습니다. 체포당할때, 그는 검은 후작을 섬긴다고 "
"소리쳤습니다. 무역로 지도를 제작하라고 보내졌다고 말입니다. 하지만 해적들은 교활합니다. 그리고 이 지도는 무역을 위한 것이 아니고, "
"약탈을 위한 것일지도 모릅니다. 그가 다른 왕을 섬긴다는 것을 인정하게 하려면 그에게 무엇을 해야할까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0002_Text
#. Speaker : Valerie_Companion
msgctxt "5f395075-c7d0-4d88-80f8-ef6b8eb91824"
msgid ""
"\"{name}, we captured a suspicious man. He was making a map of our rivers, "
"bays and backwaters. When he was placed under arrest, he admitted that he "
"serves the Black Marquis. By his account, he was sent to create a map, in "
"order to arrange trade with us. But I'd more likely believe that the pirates "
"are preparing for a big raid.\""
msgstr ""
"\"{name}, 수상한 사람을 붙잡았습니다. 그는 우리 강역 지도를 제작하는 중이었습니다. 그는 붙잡힐 때 검은 후작을 섬기는 것을 "
"인정했습니다. 그자의 말에 따르면, 그는 우리와의 무역을 위한 지도를 제작하라고 보내졌다고 합니다. 하지만 저는 해적들이 큰 습격을 "
"준비하고 있는 중이라고 생각합니다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0003_Text
#. Speaker : SadisticMage_Capital
msgctxt "c7de39f4-d7f8-40ef-9a67-d3695d2a15f9"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}! I'm afraid I have "
"bad news. Today by the river they caught a man making a map of rivers and "
"bays in our lands. He said he was a scout for the Black Marquis, and was "
"drawing a map to open a trade route with us. But everyone knows the greedy "
"and deceptive nature of these pirates. It's more likely that they're "
"preparing an attack against us.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}! 나쁜 소식이 있습니다. 오늘 강에서 우리 강역지도를 만들고 있는 남자를 붙잡았습니다. 그는 그가 "
"검은 후작의 정찰병이라고 말했고, 우리와의 무역을 위한 무역로 지도를 제작하는 중이었다고 말했습니다. 하지만 모두가 이 해적들의 탐욕과 "
"속임수를 알 겁니다. 우리에 대한 공격을 준비하고 있었다는 것이 더 들어맞는 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0010_Text
#. Speaker : Linzi_Companion
msgctxt "a2579319-997a-42b4-8526-b7f6dbf857e2"
msgid ""
"\"Once a {g|Cheliax}Chelish{/g} pirate named Morgan the White visited the "
"village of Deadbridge to rest and replenish his supplies. He settled there "
"and in time decided to build a whole pirate nation there! Those joined him "
"began to collect duties from foreign ships, but they never touched the ships "
"of the {g|River Kingdoms}River Kingdoms{/g}. Thus he gained the support and "
"respect of his neighbors. That's how the Protectorate was created.\""
msgstr ""
"\"언젠가 유명한 {g|Cheliax}첼리악스{/g} 해적이었던 창백한 모건은 데드브릿지 마을에서 머물고 물자를 보충했었죠. 그는 그곳에 "
"정착했고 곧 그곳에 해적의 국가를 건설하기로 결심했어요! 그의 부하들은 타국의 배들로부터 통행세를 뜯어내기 시작했지만, {g|River "
"Kingdoms}강의 왕국들{/g}의 배는 일절 손대는 일이 없었어요. 그로 인해 그는 주변 이웃들의 지지와 존경을 얻어냈죠. 이렇게 "
"보호국이 만들어진 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0011_Text
#. Speaker : Valerie_Companion
msgctxt "efc839cc-d23e-458c-a541-dcf00e186ca4"
msgid ""
"\"It's a group of pirates calling themselves a country. It was created by a "
"{g|Cheliax}Chelish{/g} bandit Morgan, the White Marquis. But he didn't rule "
"for long. The Protectorate changed hands several times, until the Black "
"Marquis took its helm – the most cunning and treacherous of the White "
"Marquis' henchmen. There is only one law in this land – the law of the "
"pirate. But these bandits don't touch the ships of the {g|River Kingdoms}"
"River Kingdoms{/g}... at least, that's the official tale. But how far that "
"agreement is respected – only the dead can say.\""
msgstr ""
"\"스스로를 국가라고 부르는 해적 집단입니다. {g|Cheliax}첼리악스{/g} 해적인 하얀 후작, 모건이 만들었지요. 하지만 모건은 "
"오랫동안 다스리지 못 했습니다. 검은 공작이 그 제위에 오르기 전 까지 주인이 여러번 바뀌었지요. 검은 후작은 하얀 공작의 가장 간사하고 "
"교활한 수하였습니다. 그곳에선 한 가지 규칙만이 지배하지요. 해적의 규칙 말입니다. 하지만 이 도적들은 {g|River Kingdoms}"
"강의 왕국들{/g} 의 배는 건들지 않는다고 합니다... 공식적으로는 그렇게 말 하지요. 헌데 그 합의가 얼마나 잘 이루어지는 지는, 죽은 "
"사람들이 말 해주겠군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0012_Text
#. Speaker : SadisticMage_Capital
msgctxt "cad87eb1-2704-4d6a-b746-a8cbdfecb8e5"
msgid ""
"\"It's a dangerous place. This dominion was founded by a pirate from "
"{g|Cheliax}Cheliax{/g}. When he came across the village of Deadbridge, he "
"saw an ideal camp for pirates and the capital of his future domain. Morgan "
"called on many allies, and ordered that no ships be touched if they fly "
"under the banners of the {g|River Kingdoms}River Kingdoms{/g} – and 'duties' "
"from all other countries be collected. Now the pirate nation is ruled by the "
"Black Marquis, and his subjects are, all of them, pirates and robbers.\""
msgstr ""
"\"위험한 장소입니다. 이 나라는 {g|Cheliax}첼리악스{/g} 의 도적이 세웠습니다. 그자가 데드브릿지라는 마을을 발견하자, 향후 "
"자신의 나라에 있어 해적들에게 이상적인 수도의 모습을 보았습니다. 모건은 수많은 동맹을 맺으며, {g|River Kingdoms}강의 "
"왕국들{/g}의 깃발을 꽂아놓은 배는 건들지 않기로 했지요. 다른 모든 국가로부터 '세금'을 받으면서 말입니다. 이제 그 해적 국가는 "
"검은 후작과 함께 그 휘하의 해적 및 도적들이 지배하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0013_Text
#. Speaker : Valerie_Companion
msgctxt "4fcf3438-a2d0-4f3a-8c10-6151d00eaf14"
msgid ""
"\"I'll show him the strength of our army. After the pirate sees our "
"soldiers, he'll not likely recommend that his Black Marquis ever approach "
"our shores.\""
msgstr ""
"\"우리 병력의 강함을 보여주겠습니다. 해적들이 우리 병사를 보고 나면, 검은 후작에게 우리 강변으로 가자고 말하지 못할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0014_Text
#. Speaker : Linzi_Companion
msgctxt "aab09fe2-ce9c-4d8f-8177-437efd09a753"
msgid ""
"\"Well, maybe it's better we have no business with them. Who knows how much "
"blood there would be on their wares and gold?\""
msgstr ""
"\"뭐, 더 이상 저들과 연을 맺지 않는 게 더 좋을 수도 있어요. 저들이 다루는 상품과 돈에 얼마나 많은 피가 묻어있을 지 누가 알아요?"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0015_Text_String
#. Speaker : SadisticMage_Capital
msgctxt "6c058d0c-465a-45c1-8550-8b153d41808e"
msgid ""
"\"Oh... You're provoking them! This could be a mistake, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}! They don't understand who they're "
"dealing with! Of course you'll defeat them, there's no doubt about that – "
"but at what cost?\""
msgstr ""
"\"오... 그들을 도발하려 하시는 군요! 이건 실수일지도 모릅니다, {mf|영주님|영주님|전하|전하}! 그들은 누구를 상대하고 있는지 "
"이해하지 못하고 있어요! 물론 당신은 이길것입니다, 이견의 여지가 없지요. 하지만 그 대가는요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0016_Text
#. Speaker : Linzi_Companion
msgctxt "faf49c9c-99bd-4e96-9212-207d6e62da2a"
msgid ""
"\"Great! When we show off our riches, and convince pirates to trade with us, "
"not fight. I can't wait for an opportunity to chat with the first captains "
"who bring us their goods!\""
msgstr ""
"\"좋아요! 우리의 재력을 보여주면 해적들은 우리와 싸우기보단 거래하려 들 거예요. 저들의 상품을 가져오는 첫 번째 선장과 이야기해볼 "
"날이 기다려지는군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0017_Text_String
#. Speaker : Valerie_Companion
msgctxt "92e90763-87d9-4685-ae2f-4d64f56de1ba"
msgid ""
"\"Showing gold to a bandit so he doesn't return... I don't see the sense in "
"this. You'll only be feeding their greed.\""
msgstr ""
"\"금을 도적에게 보여줌으로서 돌아오지 않게끔 한다.... 저는 이해가 가지 않습니다. 당신은 그들의 탐욕을 채워주기만 할겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0018_Text
#. Speaker : SadisticMage_Capital
msgctxt "fb650192-397f-4690-bd0d-70225c1e36dc"
msgid ""
"\"Hm.... You're probably right, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}! Your courage allows you to see their greed, whereas I, due to my "
"humble nature, am too horrified by their cruelty to see anything beyond it. "
"I do hope our riches tempt them to start trading with us.\""
msgstr ""
"\"흠.... 옳으신 말씀일지도 모릅니다, {mf|영주님|영주님|전하|전하}! 당신의 용기가 당신에게 저들의 탐욕을 볼 수 있게 "
"해줬지만, 제 천한 본성으로는 저들이 보여주는 잔혹함에 두려워져 그 이상을 보지 못 했군요. 우리 돈으로 저들과 교역을 할 수 있게 "
"된다면 좋겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0019_Text_String
#. Speaker : Linzi_Companion
msgctxt "579e65b6-456c-4fc2-8683-0cee782876ee"
msgid ""
"\"This is a bad idea. The more pathetic we look, the safer a target we seem. "
"And I don't want my former friends saying that Linzi now serves the ruler or "
"some backwater country!\""
msgstr ""
"\"나쁜 생각이예요. 우리가 약하게 보일 수록, 더 안전한 약탈 대상으로 보일 뿐이예요. 제가 낙후된 나라의 군주를 섬긴다는 말을 제 "
"친구로부터 듣고싶지도 않고요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0020_Text
#. Speaker : Valerie_Companion
msgctxt "3377b691-d7a5-4431-a4cf-dbf9ebc8b718"
msgid ""
"\"Hm... Fine, I'll lead him past the pigsties and chicken houses, so he "
"thinks it's our main avenue. Let's hope it works. Although acting has never "
"been my strong suit.\""
msgstr ""
"\"흠... 좋습니다. 우리 주 거리를 양돈장이나 양계장으로 착각하도록 그곳으로 데려가겠습니다. 이게 먹히길 바라야겠군요. 연극은 약한데 "
"말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0021_Text
#. Speaker : SadisticMage_Capital
msgctxt "2d927230-2b22-4a08-98a8-31185dfb0005"
msgid ""
"\"Great! This pirate will doubly regret his mission, because there's nothing "
"worthy waiting for him here!\""
msgstr "\"좋군요! 여기엔 아무런 가치있는 것도 없으니 이 해적은 분명 곱절은 후회할 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0022_Text
#. Speaker : Valerie_Companion
msgctxt "239a2ba8-0cce-46f7-8a9b-9577946add0d"
msgid ""
"\"The prisoner awaits his fate. We could receive him as an honorable guest, "
"showing off our riches and power. But it would only whet the pirate's "
"appetite. Better to show him an empty corner where there's nothing to take. "
"But only demonstration of military power would make these pirates forget the "
"road to our lands. Everything else is a half-measure.\""
msgstr ""
"\"죄수가 판결을 기다리고 있습니다. 그에게 우리의 부와 권력을 보여줌으로써 손님으로 맞이할 수 있습니다. 허나 그렇게 하면 이 해적들의 "
"입맛만 돋우게 되겠지요. 아무 것도 가져갈 것 없는 텅 빈 구석만 보여주는 게 더 나을 거 같습니다. 우리의 군사력만 보여준다면 이 "
"해적들도 우리 땅을 침범할 생각은 추호도 하지 못 하겠지요. 그 외의 방법은 부적절 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0023_Text
#. Speaker : SadisticMage_Capital
msgctxt "128a44dc-9341-41b2-9e2b-c475016f0815"
msgid ""
"\"I do not recommend we try impressing him with military parades. Pirates "
"are fearless and stupid, they're not afraid of a stronger opponent. It's "
"better we receive him as a dear guest and convince that it would be "
"beneficial to be friends with us. Or we could do the complete opposite, and "
"pretend we're a poor backwards country, with no treasures or riches "
"whatsoever! This would yield the best result!\""
msgstr ""
"\"그에게 우리 군사력을 과시하는 건 좋지 않아 보입니다. 해적들은 두려움을 모르고 어리석습니다. 더 강한 상대를 두려워할 줄 모르지요. "
"차라리 우리의 귀빈으로 맞아 서로 친구가 되도록 믿음을 주는 것이 더 좋을 듯 싶습니다. 아니면 완전 반대로 행동해, 여기는 한 푼도 "
"없는 가난한 빈털터리 국가인 척 하는 것도 좋겠지요! 이러면 최고의 결과가 나올 것입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank5/Cue_0024_Text
#. Speaker : Linzi_Companion
msgctxt "305d669b-c4c5-4f91-add2-15ea44613a3b"
msgid ""
"\"The most important thing now is to appear strong and influential. If we "
"demonstrate our military power, the pirates will be afraid to face us. Even "
"better – we could show them our riches. Whether or not the story about trade "
"routes is a tale, we can let the Black Marquis wonder if he'd be better off "
"if he were our friend.\""
msgstr ""
"\"현재 가장 시급한 건 힘과 영향력을 보여주는 거예요. 우리의 군사력을 보여주면 해적들도 우리를 두려워 하겠죠. 나아가, 우리의 부를 "
"보여주면 더 좋을 거예요. 무역로에 대한 이야기가 사실이든 아니든, 검은 후작에게 우리를 친구된 입장으로 남겨둘 수 있을테니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Answer_0006_Text
msgctxt "360653f0-1b7d-4ff3-b234-d8609f2f5508"
msgid "{g|Relations6_1}[Choice effects]{/g} \"Let's help Sevenarches.\""
msgstr "{g|Relations6_1}[선택 시 효과]{/g} \"세븐아치를 돕자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Answer_0007_Text
msgctxt "cce54db6-4c6d-4d9e-ac2f-bc763ea5499c"
msgid "{g|Relations6_2}[Choice effects]{/g} \"Let's stand up for Kyonin.\""
msgstr "{g|Relations6_2}[선택 시 효과]{/g} \"쿄닌을 돕자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Answer_0008_Text
msgctxt "69c9a75e-2c09-45c1-bb19-e86c20385485"
msgid ""
"{g|Relations6_3}[Choice effects]{/g} [Gain 2 BP each week] \"Bring in our "
"troops to keep peace in Novoboro.\""
msgstr "{g|Relations6_3}[선택 시 효과]{/g} [매주 2 BP 획득] \"우리 부대를 보내 노보보로의 평화를 지키라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Answer_0025_Text
msgctxt "3ae27747-cc57-4cf6-a530-c6900e872520"
msgid ""
"{g|Relations6_4}[Choice effects]{/g} [Gain 2 BP each week] \"We will buy "
"wares from those who bring them. It's as simple as that.\""
msgstr ""
"{g|Relations6_4}[선택 시 효과]{/g} [매 주 2 BP 획득] \"상품을 가져오는 쪽의 물건을 살 것이다. 간단하다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Answer_0026_Text
msgctxt "9ea609cf-2345-4b1c-aaff-a9c31b9bd776"
msgid "\"You know best what to do.\""
msgstr "\"어떻게 해야 할 지는 그대가 잘 알겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "9d0ad611-f4ba-48a1-96f8-f7a3d69222e3"
msgid ""
"\"There's an issue that demands your attention. Sevenarches want to bring "
"their fleet to Novoboro – allegedly to combat piracy. But in fact they "
"simply can't accept that the elves of {g|Kyonin}Kyonin{/g} are trading "
"dwarven wares with the {g|Five Kings Mountains}Five Kings Mountains{/g}. "
"Control over Novoboro would allow Sevenarches to collect duties along this "
"trade route.\""
msgstr ""
"\"아셔야 할 문제가 있어요. 세븐아치가 노보보로에 함대를 배치하려고 해요. 자기네들 말로는 해적질을 방지할 목적이라네요. 실은 "
"{g|Kyonin}쿄닌{/g}의 엘프가 {g|Five Kings Mountains}다섯 왕의 산맥{/g} 드워프랑 교역하는 걸 용납하지 "
"못하는 거예요. 노보보로를 점령하면 세븐아치가 무역로에서 보호세를 걷을 수 있으니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0002_Text
#. Speaker : Valerie_Companion
msgctxt "0f896192-0a7c-429c-9bc4-7124b2ab66da"
msgid ""
"\"One issue requires your attention. Sevenarches are bringing their fleet to "
"Novoboro, an important point along the river trade, and create a 'customs' "
"there to combat piracy. But don't be fooled, they're really just going there "
"to level duties on wares brought in from the {g|Five Kings Mountains}Five "
"Kings Mountains{/g} and heading towards {g|Kyonin}Kyonin{/g}.\""
msgstr ""
"\"보셔야 할 문제가 있습니다. 세븐아치 쪽에서 해상 무역에 있어 요충지인 노보보로로 함대를 끌고 가, '관행'을 만들어 해적질을 "
"막는다고 합니다. 하지만 이 말에 현혹되시면 안 됩니다. 저들은 사실 {g|Five Kings Mountains}다섯 왕의 산맥{/g}과 "
"{g|Kyonin}쿄닌{/g}으로 가는 물건에 관세를 부여하려는 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0003_Text
#. Speaker : SadisticMage_Capital
msgctxt "3c366f0e-d90b-4730-85c2-275a725edfef"
msgid ""
"\"An important issue requires your attention! Sevenarches wants to bring "
"their ships into the harbor of Novoboro, a key point along "
"{g|Kyonin}Kyonin{/g} river trade route. They claim that their only goal is "
"fighting piracy, but in fact they'll be searching all ships for dwarven "
"wares. The smart captains will pay duties to Sevenarches; the fools will be "
"declared pirates.\""
msgstr ""
"\"보셔야 할 문제가 있습니다! 세븐아치 쪽에서 자기네들 함선을 끌고 {g|Kyonin}쿄닌{/g} 과의 해상 무역의 교두보인 노보보로로 "
"가져간다는군요. 주장하는 바로는 해적들과 싸우려고 한다지만, 사실은 드워프제 상품을 싣는 배들을 찾아다니는 겁니다. 머리 좋은 선장이라면 "
"세븐아치에게 관세를 바치겠지요. 어리석은 선장들은 해적으로 간주될 거고요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0012_Text_String
#. Speaker : Linzi_Companion
msgctxt "c4953317-4133-4aef-b321-5c7f4565dd59"
msgid ""
"\"Sevenarches might call it fighting piracy, but as I see it, they're the "
"ones who are acting like pirates!\""
msgstr "\"세븐아치의 말로는 해적과 싸운다고 하지만, 제가 보기엔 저들도 해적처럼 행동하는 자들일 뿐이예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0013_Text
#. Speaker : Valerie_Companion
msgctxt "af7daf2e-12d4-4cc1-b80f-e3bf66fb3adb"
msgid ""
"\"As you say. I hope you have a good reason for getting us into this broil – "
"and I hope you've chosen the right side.\""
msgstr "\"당신의 뜻대로. 이 전투에 우리를 끌어들인 충분한 이유가 있기를 바랍니다. 또한 옳은 쪽을 선택했기를 바라지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0014_Text
#. Speaker : SadisticMage_Capital
msgctxt "994f84d7-f16e-49dd-bbba-58075b5dc0f3"
msgid ""
"\"Great! It's time for {g|Kyonin}Kyonin{/g} to know their egoistic politics "
"is over. There are several new, strong players in the {g|River Kingdoms}"
"River Kingdoms{/g}. Like you, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}!\""
msgstr ""
"\"좋습니다! {g|Kyonin}쿄닌{/g} 에게 그네들의 이기적인 정책에 끝이 도래했음을 알려야겠군요. {g|River Kingdoms}"
"강의 왕국들{/g} 에 강력한 이들이 새로이 등장했으니 말입니다. 당신 같은 사람 말이죠, {mf|영주님|영주님|전하|전하}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0015_Text
#. Speaker : Linzi_Companion
msgctxt "f655bf5d-5182-4701-af12-79570f25b1f1"
msgid ""
"\"Wonderful. We will let Sevenarches know that we won't tolerate their "
"brazen efforts to seize an honest trade route.\""
msgstr "\"멋져요. 세븐아치에게 무역로를 점령하려는 그들의 뻔뻔한 노력을 용납하지 않을 것임을 알릴게요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0017_Text_String
#. Speaker : SadisticMage_Capital
msgctxt "838f768e-1937-4418-9742-a07a87a7181b"
msgid ""
"\"We'll support {g|Kyonin}Kyonin{/g}, even though elves won't even consider "
"sharing their revenue or connections with us? {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}, I lack the wisdom to understand your decisions!\""
msgstr ""
"\"{g|Kyonin}쿄닌{/g}을 돕겠습니다. 엘프들 쪽에선 복수를 함께 하려하지 않는 것 같긴 합니다만. "
"{mf|영주님|영주님|전하|전하}, 제 모자란 지혜로는 당신의 결정을 따라가기 힘들군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0018_Text
#. Speaker : Linzi_Companion
msgctxt "86a3df10-bee3-40a8-949b-97d32fa19aef"
msgid ""
"\"At least we'll be sure that no one is oppressing anyone. But will the "
"others be sure that we're not oppressing them...\""
msgstr ""
"\"적어도 우리 쪽에선 아무도 누구든 억압하지 못 하게 할 거라고 확신할 수 있어요. 하지만 상대쪽에서도 자기네들이 억압받지 않는다고 "
"생각할지는 모르겠네요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0019_Text
#. Speaker : Valerie_Companion
msgctxt "7cd3cc50-ea7c-4882-92e1-59a43922ce25"
msgid ""
"\"I will order our ships to reach Novoboro first. We seize control over "
"trade, whatever our neighbors might think, and keep our eyes open for "
"pirates and smugglers.\""
msgstr ""
"\"함대들에 명령을 내려 노보보로에 먼저 도착하라고 하겠습니다. 우리 이웃들이 어떻게 생각하건 간에, 무역로의 통제권을 쥐고 해적들과 "
"밀수업자들을 계속 지켜보지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0020_Text
#. Speaker : SadisticMage_Capital
msgctxt "24aa27fe-0265-4805-aa6f-397e51ea3ce5"
msgid ""
"\"That's a bold move, seizing their prize right out from under Sevenarches. "
"But the fastest runner wins the race, right? I applaud your wisdom yet again."
"\""
msgstr ""
"\"세븐아치로부터 상품을 빼앗다니, 그거 대담하군요. 하지만 빠른 자가 경주에서 이기는 법 아니겠습니까? 당신의 지혜에 다시 한 번 "
"감탄하게 되는 군요. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0027_Text
#. Speaker : Linzi_Companion
msgctxt "15641bcb-9225-484c-981e-62904a2f8967"
msgid ""
"\"Maybe it's better to keep out of the troubles of others. The elves aren't "
"completely right to inflate the prices of dwarven wares and not share them "
"with anyone!\""
msgstr ""
"\"끼어들지 않는 게 더 좋을 지도 모르겠네요. 엘프들이 드워프제 물품에 대한 가격을 부풀리는 게 확실하지 않을 뿐더러 누구와도 거래하지 "
"않으려 할 지도 모르니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0028_Text_String
#. Speaker : Valerie_Companion
msgctxt "24b15473-476b-4a31-b525-f34233c40d17"
msgid ""
"\"Even if they have their previous owner's blood on them? Don't imagine that "
"your {mf|barony|barony|kingdom|kingdom} can avoid this conflict.\""
msgstr ""
"\"이전 주인의 피가 아직 묻어있는 데도 말입니까? 우리 {mf|남작령|남작령|왕국|왕국} 이 이 문제를 피할 수 있을 거라 생각하지 "
"마십시오 .\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0029_Text
#. Speaker : SadisticMage_Capital
msgctxt "0075c3f7-b5f0-4d34-a669-890dfe1c76c1"
msgid ""
"\"It is wise to keep your economy separate from the political broils of "
"others. Let them fight over duties without us. Most reasonable, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}.\""
msgstr ""
"\"우리 경제 문제를 타국의 정치와 엮이게 하지 마시길 바랍니다. 우리 없이 관세로 싸우라고 하십시요. 이게 가장 합리적입니다, "
"{mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0030_Text
#. Speaker : SadisticMage_Capital
msgctxt "5405f0f2-5a20-400b-8766-f3b21d158f01"
msgid ""
"\"At present, all the wares from the {g|Five Kings Mountains}Five Kings "
"Mountains{/g} that we receive arrive here via the elves, at the prices they "
"set. {g|Kyonin}Kyonin{/g} asks for our help in this trade war, and "
"Sevenarches also offers its cooperation. I think we should make an agreement "
"with Sevenarches, though it would be tempting to beat them both to the "
"punch, and set up our own customs office in Novoboro, and take all the "
"profit ourselves.\""
msgstr ""
"\"현재 {g|Five Kings Mountains}다섯 왕의 산맥{/g}으로부터 받은 물건들은 모두 엘프를 통해 옵니다. 가격도 "
"엘프들이 정하지요. {g|Kyonin}쿄닌{/g}쪽에서 이 무역 전쟁에 우리 도움을 요청하고 있고, 세븐아치 쪽에서도 협력을 구하고 "
"있습니다. 둘 모두 때려눕히는 게 더 좋아 보이지만, 제 생각엔 세븐아치 쪽을 도와 노보보로에 우리 세관을 건설해 수익을 받는 게 좋을 "
"듯 싶습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0031_Text
#. Speaker : Valerie_Companion
msgctxt "e719d5aa-f24e-441b-ace7-2c6f660e24f6"
msgid ""
"\"Both {g|Kyonin}Kyonin{/g} and Sevenarches are asking for support. I don't "
"trust either of them, so I suggest we bring our own fleet to Novoboro. We're "
"more than capable of keeping an eye on the pirates, even if our neighbors "
"are not grateful for our interference.\""
msgstr ""
"\"{g|Kyonin}쿄닌{/g}과 세븐아치 모두 우리의 지원을 요청하고 있어요. 전 둘 다 믿지 않아요. 그렇기에 우리 함대를 끌고 "
"노보보로에 가자고 제안하고 싶어요. 우리 이웃들이 우리 개입을 마음에 들어하진 않겠지만, 우린 해적들을 감시하는 것 이상의 것을 해낼 수 "
"있으니까 말이예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank6/Cue_0038_Text
#. Speaker : Linzi_Companion
msgctxt "50b59850-4f94-420e-94ca-33854252aa7c"
msgid ""
"\"Both {g|Kyonin}Kyonin{/g} and Sevenarches are asking for diplomatic "
"support. I think we should put Sevenarches on a shorter leash. Their most "
"recent step is just another attempt to take away someone else's living! We "
"could also bring our own fleet to Novoboro to steal their initiative, but "
"it's better we have Kyonin as an ally.\""
msgstr ""
"\"{g|Kyonin}쿄닌{/g}과 세븐아치 모두 외교적 지원을 요청했습니다. 저는 세븐아치의 목줄을 더 죄여야 한다고 생각합니다. "
"저들은 또 다른 누군가의 삶을 빼앗으려 하는 것 뿐입니다! 우리 함대를 노보보로에 보내 저들로부터 선제권을 앗아올 수 있겠지만, 쿄닌을 "
"동맹으로 삼는 게 가장 나을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Answer_0005_Text
msgctxt "49b13f65-35cd-4957-afd2-21b711b545a9"
msgid ""
"{g|Relations7_1}[Choice effects]{/g} [Gain 500 BP] \"We could make use of "
"Razmir's gold.\""
msgstr "{g|Relations7_1}[선택 시 효과]{/g} [500 BP 획득] \"라즈미르의 금을 이용할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Answer_0006_Text
msgctxt "8ba44cea-35e3-4234-a33b-9f6f6a6a7f85"
msgid ""
"{g|Relations7_2}[Choice effects]{/g} \"I'd prefer payment in the form of a "
"magical artifact.\""
msgstr "{g|Relations7_2}[선택 시 효과]{/g} \"마법 아티팩트로 지불하면 좋겠군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Answer_0007_AlignmentShift.Description
msgctxt "4ca7d264-1188-43bc-91dc-ee9fb5073802"
msgid "Massacred the Razmirans."
msgstr "라즈미르인들을 학살했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Answer_0007_Text
msgctxt "ab639c2f-1483-43dd-bbe6-d94ff29d48a7"
msgid ""
"{g|Relations7_3}[Choice effects]{/g} \"Execute all of Razmir's servants in "
"the country.\""
msgstr "{g|Relations7_3}[선택 시 효과]{/g} \"나라 안의 라즈미르 신봉자들을 모조리 처형하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Answer_0009_Text
msgctxt "3eae2776-44d0-4f53-9d79-f7805479b4f8"
msgid "\"Do as you see fit.\""
msgstr "\"그대 생각대로 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "86beb003-6cad-4fa2-9ef8-bce47670027b"
msgid ""
"\"{name}, I have some bad news. It looks like we did well to keep our "
"distance from Razmir. Our warriors arrested a smuggler crossing the border. "
"He was carrying a large quantity of Razmir's Tears, a magical drug that can "
"break any man's will and turn him into a shivering addict. He also carried "
"letters threatening our merchants.\""
msgstr ""
"\"{name}, 안 좋은 소식이 있어요. 라즈미르쪽과 거리를 둔게 잘 한 거 같아요. 우리 전사들이 국경을 넘어오는 밀수꾼 하나를 "
"체포했어요. 마법으로 만든 라즈미르의 눈물이라는 마약을 엄청나게 들고오다가 붙잡혔는데, 이 마약을 사용하는 자는 누구든 정신이 붕괴되어 "
"마약만을 찾게 된다고 해요. 그리고 그자의 품 속에서 우리 상인들을 겁박하는 편지를 발견했어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0002_Text
#. Speaker : Valerie_Companion
msgctxt "3733e41e-825b-4a7a-8e36-02aceab7afad"
msgid ""
"\"{name}, a Razmiran spy was arrested at the border. He was carrying letters "
"filled with threats, along with a large quantity of a drug known as Razmir's "
"Tears. Judging from the letters, this agent was under orders to drug our "
"merchants and dominate their wills.\""
msgstr ""
"\"{name}, 라즈미르 스파이가 국경에서 붙잡혔습니다. 그는 위협으로 가득찬 편지들과 라즈미르의 눈물이라고 알려진 많은 양의 마약을 "
"운반하는 중이었습니다. 편지로부터 판단하건데, 이 요원은 우리 상인들을 중독시키고 그들의 의지를 지배하라는 명령을 받은 것같군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0003_Text
#. Speaker : SadisticMage_Capital
msgctxt "c05ee50d-7f39-41da-b7a3-c4146ece1cec"
msgid ""
"\"Your Highness! The sneaky, treacherous, nasty Razmir has made an attempt "
"on the stability of your kingdom! He's challenging Your Highness! We just "
"arrested one of his spies, who was carrying bags full of Razmir's Tears, a "
"powerful drug, so addictive that even a man of great spirit cannot resist! "
"He also carried threatening letters, directed at our major merchants.\""
msgstr ""
"\"전하! 이 교활하고, 간사하며 구역질나는 라즈미르 놈들이 우리 왕국의 안위를 흔들려고 했습니다! 전하께 도전하는 것 입니다! 막 그 "
"밀정 중 하나를 체포했는데, 강철의 의지를 가진 사람도 굴복하고 만다는 강력한 마약인 라즈미르의 눈물을 싣고다녔다고 합니다! 또한 협박 "
"편지도 들고있었는데, 우리 왕국의 상인들에게 바로 전해는 것이었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0008_Text_String
#. Speaker : Linzi_Companion
msgctxt "506422d7-ef30-4f9f-8b80-c648001ba01d"
msgid ""
"\"Hm... Don't you think we made a bad bargain? It's only gold! Don't we "
"already have enough of that? All right, well... I guess some things I just "
"don't understand.\""
msgstr ""
"\"흠... 나쁜 거래를 했다고 생각하지 않아요? 오직 돈 뿐이라고요! 돈은 이미 충분히 가지고 있지 않나요? 좋아요, 음... 제가 "
"이해 못 하는 것일 수도 있죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0010_Text
#. Speaker : Valerie_Companion
msgctxt "b84d7f8c-13de-4ef2-aa6b-52bf019236f8"
msgid ""
"\"Your subjects will make good use of this gold, and our enemies will be "
"reminded that any attempt against us will cost them dearly.\""
msgstr ""
"\"백성들은 이 돈을 잘 쓸 수 있을겁니다. 그리고 우리 적들은 우리에게 맞서는 어떤 시도라도 대가를 호되게 치뤄야 한다는 걸 "
"기억할겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0011_Text
#. Speaker : SadisticMage_Capital
msgctxt "6461d145-86aa-4f2d-836d-cea6a0206253"
msgid ""
"\"Very well – let it be gold then. Razmir will pay a high price for his "
"mistake if he doesn't want to face the consequences!\""
msgstr "\"좋습니다. 돈으로 지불하라고 하지요. 라즈미르도 좋지 않은 결과를 피하기 위해선 돈을 많이 주는 수 밖에 없을 것입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0012_Text
#. Speaker : Linzi_Companion
msgctxt "e35855d5-4459-4682-ba96-601d91ef2ce9"
msgid ""
"\"Perfect! I can't wait to see this new wonder from Razmiran! It will have "
"to be something amazing – after such a diplomatic incident we won't accept "
"some minor trinket! – You will allow me to study the gift, won't you?\""
msgstr ""
"\"완벽해요! 이 라즈미르인들의 새로운 경이를 보는 것이 기다려지네요! 분명 놀라운 것일 거예요. 이런 외교 사건 이후로 우린 이런 "
"사소한 장신구는 받지 않을 거니까요! 제가 선물에 대해 연구해봐도 될까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0013_Text_String
#. Speaker : Valerie_Companion
msgctxt "b5598ac4-b92e-46b1-a387-6652c556f0c6"
msgid ""
"\"Hm... It's a questionable decision. The gift could be a trap, just as "
"Razmir's Tears were in fact a poison. Magical gifts are often treacherous.\""
msgstr ""
"\"흠... 의뭉스러운 결정이군요. 저들이 주는 선물이 함정일 수도 있습니다, 라즈미르의 눈물이 사실은 독약이었던 것처럼 말입니다. 마법 "
"선물은 종종 위험하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0014_Text
#. Speaker : SadisticMage_Capital
msgctxt "ca2c196b-1c4c-405c-b45d-75c41e8e0bc2"
msgid ""
"\"Well, getting our hands on Razmir's treasure is wiser than hanging his "
"subjects.\""
msgstr "\"뭐, 라즈미르의 보물을 받아들이는 게 그 백성들을 목 매다는 것 보단 훨씬 현명하겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0015_Text_String
#. Speaker : Linzi_Companion
msgctxt "27faf3ac-1096-4e01-86cd-1d12a1796b34"
msgid ""
"\"What?! How could you do this?! What is their crime?! Is it their fault "
"that they're ruled by a bloody tyrant, desperate to take over the world? "
"This... This is horrible.\""
msgstr ""
"\"뭐라고요?! 어떻게 그렇게 하실수 있나요?! 무슨 죄로요?! 세상을 집어삼키려던 망할 폭군에게 지배받던 것이 죄인가요? 이건... "
"이건 끔찍해요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0017_Text_String
#. Speaker : Valerie_Companion
msgctxt "ff015f92-39a7-46c8-abf2-e59e186877c5"
msgid ""
"{n}Valerie bites her lip.{/n} \"This is unjust, {name}. This punishment is "
"far worse than Razmir's crime. It will be a senseless bloodbath.\""
msgstr ""
"{n}발레리는 입술을 물어뜯습니다.{/n} \"이건 정의가 아닙니다, {name}. 이 처벌은 라즈미르의 범죄보다 훨씬 끔찍합니다. 이건 "
"무의미한 학살입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0018_Text
#. Speaker : SadisticMage_Capital
msgctxt "c58bbb10-e606-4c61-a3a4-8e6eadab5d86"
msgid ""
"\"Perfect! We'll punish every Razmiran subject we can catch in our domain. "
"Your Highness, this is a lesson they are sure to understand! – They got in "
"our way, and now they'll pay with the lives of their servants! Razmir will "
"regret his refusal to forge an alliance.\""
msgstr ""
"\"완벽합니다! 우리는 영토내에서 잡아들이는 라즈미르 백성들을 모조리 처벌할겁니다. 전하, 여기서 우리가 알아야 할 교훈이 있습니다! "
"그들은 우리 앞에서 설쳤고, 그리고 지금 그들은 백성들의 목숨으로 그 대가를 치뤄야 할 겁니다! 라즈미르는 우리와의 동맹을 거절한 것을 "
"후회할겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0027_Text
#. Speaker : Linzi_Companion
msgctxt "71831b7a-d036-4128-b15f-cbd5fc67c209"
msgid ""
"\"Razmir's plan was to cripple trade by manipulating our merchants after "
"getting them addicted to the Tears. Now that his agent is in our hands, "
"Razmiran is offering an apology – and a substantial compensation in gold – "
"if we set aside thoughts of revenge. I agree that we should extend some "
"courtesy, and spare the lives of Razmir's subjects. But gold is not good "
"enough. We should request a treasure from Razmir's private magic arsenal, "
"which is rumored to be stocked with many curious items.\""
msgstr ""
"\"라즈미르의 계획은 우리 상인들을 눈물로 중독시킨후에 그들을 조종해서 무역을 망가뜨리는 것이었습니다. 지금 그의 요원이 우리 손안에 "
"있고, 라즈미르는 사죄하려고 하는 중입니다. 만약 우리가 복수하지 않으려고 한다면, 상당한 보상금도 제공할겁니다. 우리가 약간의 격식을 "
"차려주고, 라즈미르 백성들의 목숨을 살려주는 것에 동의합니다. 하지만 돈으로는 충분치 않습니다. 우리는 흥미로운 물건으로 가득 차있다는 "
"소문의 라즈미르 개인 마법 무기고의 보물을 요구해야합니다. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0028_Text
#. Speaker : Valerie_Companion
msgctxt "d100b0db-1a0b-4876-a5b3-17dd26e9ed29"
msgid ""
"\"Razmiran's evil plot has failed. Fearing revenge, they have already sent "
"us proposal for compensation. They've offered us a choice between gold and a "
"magical treasure. I suppose it's safer to accept the gold – their 'gift' "
"could easily contain a magical trap.\""
msgstr ""
"\"라즈미르인의 사악한 계획이 실패했습니다. 복수 당할까 두려워, 이미 우리에게 보상약속을 했습니다. 돈과 마법보물중에서 보상을 고르라고 "
"합니다. 돈을 받아들이는 게 안전하다고 생각합니다 - 그들의 '선물'은 쉽게 마법 함정을 품을수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugDealer/Cue_0029_Text
#. Speaker : SadisticMage_Capital
msgctxt "5ede6a08-8290-4970-a3b8-684ca529edfb"
msgid ""
"\"Evidently, Razmir was going to use the Tears to subdue these merchants. "
"It's an ingenious plan! – I wish I had thought of it myself... But it was "
"also a brazen affront, and Razmiran is trying to buy their way out of it "
"with offers of gold or magical treasure. But we should reject their offer! "
"Razmir will only leave us alone if he sees a monarch equal to himself – "
"strong, ruthless, and dangerous. Have their subjects executed. Only this "
"will earn Razmir's respect.\""
msgstr ""
"\"듣기로는 라즈미르가 눈물을 사용해 이 상인들을 복속시키려 했다고 하더군요. 참으로 독창적인 계획입니다! 제가 생각해냈으면 좋았을텐데 "
"말입니다... 하지만 동시에 뻔뻔한 모욕이기도 하군요. 게다가 라즈미르는 마법 보물이나 돈을 줘서 빠져나가려 하고 있고 말입니다. 저들의 "
"제안을 거절해야 합니다! 라즈미르는 우리가 강하고, 무자비하고 위험해져 자신들과 동등해지지 않는 한 계속해서 우리를 괴롭혀 올 겁니다. "
"저들의 백성을 처형하시지요. 이 방법으로만이 라즈미르의 존중을 얻어낼 수 있을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Answer_0005_AlignmentShift.Description
msgctxt "38c993e5-5979-49fb-adb6-f08b02512981"
msgid "Provided treatment to the addicts of Razmir's Tears"
msgstr "라즈미르의 눈물 중독자에게 치료를 제공했습니다"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Answer_0005_Text
msgctxt "78fecf6f-4c9e-43e3-83ac-d5973bdba69d"
msgid ""
"{g|Relations7_4}[Choice effects]{/g} \"Place all the drug addicts in health "
"institutions. We take care of our people.\""
msgstr ""
"{g|Relations7_4}[선택 시 효과]{/g} \"모든 약물 중독자들을 우리 치료시설에 상주시키라. 우리는 백성들을 돌볼 것이다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Answer_0006_AlignmentShift.Description
msgctxt "99d2539b-774b-4c94-91e8-565130e3dd6f"
msgid "Destroyed the dens of Razmir's Tears addicts"
msgstr "라즈미르의 눈물 중독자들의 소굴을 파괴했습니다"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Answer_0006_Text
msgctxt "f6468b41-5411-4209-92fb-ea9445b4be9b"
msgid ""
"{g|Relations7_6}[Choice effects]{/g} \"Hang the drug addicts. Appoint more "
"reliable people to their positions.\""
msgstr ""
"{g|Relations7_6}[선택 시 효과]{/g} \"약물 중독자들을 목 매달라. 그들의 자리에 보다 더 신뢰할만한 사람을 임명하라."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Answer_0007_AlignmentShift.Description
msgctxt "907f4a65-7e66-4617-b55a-e703ffe3914d"
msgid ""
"Punished the drug addicts by stripping them of their property and positions."
msgstr "약물 중독자들의 재산과 지위를 빼앗음으로써 처벌하였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Answer_0007_Text
msgctxt "1fc99893-3419-4d23-9869-f50b54a146bc"
msgid ""
"{g|Relations7_5}[Choice effects]{/g} \"Remove all the addicts from their "
"stations.\""
msgstr "{g|Relations7_5}[선택 시 효과]{/g} \"모든 중독자들을 해임시켜라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Answer_0008_Text
msgctxt "d948f4a0-4975-4fc1-a529-fb584d9f6c59"
msgid "\"You should act of your own accord.\""
msgstr "\"그대 생각대로 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "fe3f5f3d-d886-4cb1-8471-dc5bd053b945"
msgid ""
"\"{name}, this is bad! Our union with Razmiran has brought us nothing but "
"trouble. The guards report that many of your most powerful and influential "
"subjects have become addicted to an imported drug known as Razmir's Tears. "
"Razmiran is threatening to cut off the supply of Tears, unless our merchants "
"sell them goods for next to nothing. This must be stopped immediately!\""
msgstr ""
"\"{name}, 나쁜 소식이에요! 라즈미란인과의 연합은 말썽거리만 낳고 말았어요. 경비대가 대부분의 강력하고 부유한 백성들이 라즈미르의 "
"눈물이라고 알려진 독에 중독됐다고 보고하고 있어요. 라즈미르인들은 우리 상인들이 다음번에 물건을 헐값에 팔지 않으면 라즈미르의 눈물 "
"공급을 끊겠다고 협박중이에요. 이건 반드시 중단되야 해요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0002_Text
#. Speaker : Valerie_Companion
msgctxt "9cdb8227-a063-405b-8ba4-3d5a0fd4ec04"
msgid ""
"\"{name}, our friendship with Razmiran has borne the fruit of a poisonous "
"tree. Their spies have infiltrated our ranks, and distributed Razmir's Tears "
"to our servants. It is a powerful drug that strips the user of all "
"willpower, to say nothing of honor and judgment. Many of our subjects are "
"already deep in the throes of addiction, willing to sell our goods for next "
"to nothing just to get another dose of the drug. It is time to put an end to "
"this.\""
msgstr ""
"\"{name}, 라즈미란인과의 우정이 독사과를 자라나게 했습니다. 그들의 밀정이 우리 고위직에 침투했고 라즈미르의 눈물을 나눠줬습니다. "
"그 약물은 사용자의 의지를 완전히 벗겨내릴정도로 강력합니다. 체면과 판단력은 말할 것도 없습니다. 우리 백성들 중 많은 이들이 이미 "
"중독의 고통에 빠져있고, 이 약물을 얻기 위해서 기꺼이 헐값에 물건을 넘길겁니다. 이것을 끝내야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0003_Text
#. Speaker : SadisticMage_Capital
msgctxt "c49b8e53-1d6b-4a35-bf67-45424a020300"
msgid ""
"\"Your Highness, Razmiran is carrying out a malicious plot against us. After "
"establishing trade, they saw to it that many of our servants would become "
"addicted to Razmir's Tears, a dangerous and powerful drug. The poor souls "
"are now entirely under Razmir's power, and are ready to sell our goods for "
"nothing, only to please their new master. Razmir made a bold move – and a "
"successful one. It's time we make our own.\""
msgstr ""
"\"전하, 라즈미란인이 악의적인 계획을 우리에게 선사하고 있습니다. 그들은 무역이 성립된 후에, 우리 백성들중 다수가 라즈미르의 눈물에 "
"중독되도록 준비했습니다. 아주 위험하고 강력한 약물입니다. 그 불쌍한 영혼들은 이제 완전히 라즈미르의 눈물의 지배되고 있고 그들의 주인을 "
"기쁘게 하기 위해 자기들 물건을 헐값에 팔아넘길 준비가 되어있습니다. 라즈미르가 대담한 움직임을 보였습니다. 그리고 매우 성공적이었고요. "
"우리도 움직여야합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0009_Text
#. Speaker : Linzi_Companion
msgctxt "92362659-e156-436a-a755-b6f4d45cffc2"
msgid ""
"\"We'll treat them in the temples, and the treasury will pay the priests. "
"This is the right decision. Everyone makes mistakes. Once they're cured, the "
"Tears won't trouble us any more!\""
msgstr ""
"\"우리는 신전에서 그들을 치료하고, 재무부가 신관들에게 보상을 지불할거예요. 이게 올바른 결정이에요. 모든이가 실수를 저지르죠. "
"중독자들이 치료되고 나면, 눈물은 더는 우리에게 문제가 되지 않을거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0010_Text
#. Speaker : Valerie_Companion
msgctxt "069cddef-18e9-4aab-a29e-af64ddb85063"
msgid ""
"\"It's a merciful choice, but unjust. These people were never forced to take "
"the drug. Why must our priests treat them? Why should we pay for their "
"misdeeds? Why don't we appoint decent people in their places. – People who "
"are more deserving?\""
msgstr ""
"\"자애로운 결정입니다만, 정의롭지 못합니다. 이 사람들은 강제로 약물을 취한게 아닙니다. 왜 우리 신관들이 그들을 치료해야 합니까? 왜 "
"우리가 그들의 일탈때문에 값을 치뤄야 합니까? 그들의 지위에 더 괜찮은 사람들을 앉히는게 어떻습니까? 그 지위에 더욱 걸맞는 사람들을?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0012_Text_String
#. Speaker : SadisticMage_Capital
msgctxt "026b7530-e269-47c0-840c-909ea9fa1f4b"
msgid ""
"\"Why should we have to care about them, your Highness? The logic escapes "
"me. Essentially, they betrayed you and your legitimate interests! They "
"deserve the gallows, not a nurse!\""
msgstr ""
"\"왜 우리가 그들을 신경써야 합니까, 전하? 논리적이지 않습니다. 본질적으로, 그들은 당신과 당신의 정당한 처사를 배신했습니다. 그들은 "
"지하감옥이 어울립니다, 간호사가 아니라요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0013_Text_String
#. Speaker : Linzi_Companion
msgctxt "cca1e137-de20-4de0-a331-87da6d2b443c"
msgid ""
"\"This punishment is too severe! Have mercy! Everyone strays from the path "
"sometimes! This punishment is worthy of Razmir, not you!\""
msgstr ""
"\"이 처벌은 너무 가혹해요! 자비를 보여주세요! 모든 사람이 간혹 올바른 길에서 벗어나곤 해요! 이 처벌은 라즈미르나 내릴 처벌이예요, "
"당신이 아니라요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0014_Text
#. Speaker : Linzi_Companion
msgctxt "cfbc0c86-f3ed-48de-9913-788b2131143d"
msgid ""
"\"Oh... They'll be beyond hope. Their lives will be ruined... I feel sorry "
"for them, you know. They had everything one could hope for. Status, wealth, "
"fancy houses. Why did they have to go and ruin themselves with Razmir's "
"poison?\""
msgstr ""
"\"오... 그들에게 가망은 없을거예요. 그들의 삶은 파괴될 거고요... 그들에게 미안하네요. 그들은 모두가 바라는 것을 가졌었죠. "
"지위, 부, 멋진 집. 어째서 그들 스스로를 라즈미르의 눈물로 망쳐야 했을까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0015_Text
#. Speaker : Valerie_Companion
msgctxt "92f3ca9d-a870-4e2b-ba58-3576b5c2f4c6"
msgid ""
"\"I don't like the severity of the punishment, but the fact that both of us "
"regard them as criminals, not victims, is satisfying. Justice may be cruel, "
"but it's better than chaos and lawlessness.\""
msgstr ""
"\"이 처벌의 가혹함을 좋아하지는 않습니다, 그러나 우리 둘다 그들을 피해자가 아니라 범죄자로 생각하는 것은 사실이기에 만족합니다. "
"정의는 때로 잔혹합니다, 그러나 혼돈과 무질서보다는 낫습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0016_Text
#. Speaker : SadisticMage_Capital
msgctxt "a1190290-03a7-4eb1-b2e9-d64806330bb1"
msgid ""
"\"Excellent! The sight of the poison addicts on the gallows will make their "
"successors think twice about the consequences of weakness.\""
msgstr "\"훌륭합니다! 감옥에 수감된 중독자들의 광경은 그들의 후계자로 하여금 유약함의 결과에 대해 두 번 생각하게끔 할겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0017_Text_String
#. Speaker : Valerie_Companion
msgctxt "b437ea12-5e16-48fc-be61-281cacdc0ae8"
msgid ""
"\"Perfect. All those spineless drug fiends will be right where they belong – "
"at the ends of lonely country roads. Worthier candidates will take their "
"places.\""
msgstr ""
"\"완벽합니다. 이 줏대없는 약물 마귀들은 원래 그들에 있어야 할 곳에 있게 될겁니다. 외딴 시골길의 끝에 말입니다. 더 가치있는 "
"후보자들이 그들의 지위를 차지할겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0018_Text
#. Speaker : SadisticMage_Capital
msgctxt "bb173baa-bf69-4f36-a9ca-59b8b0061911"
msgid ""
"\"Your Highness, Razmir planned dire consequences for the "
"{mf|barony|barony|kingdom|kingdom}, leveraged on your people's vicious "
"thirst. And with all modesty, I dare remind you that it was my timely "
"interference that prevented it. You are far too merciful with the pathetic "
"vermin.\""
msgstr ""
"\"전하, 라즈미르가 당신 백성들의 성마른 목마름을 노린 지독한 일을 {mf|남작령|남작령|왕국|왕국},에 계획했습니다. 감히 "
"아뢰옵건데, 지금이야말로 이 계획을 막기위해 적절하기 개입할 때라고 상기시켜드리겠습니다. 당신은 이 애처로운 해충들에게 너무 자비롭습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0025_Text
#. Speaker : Linzi_Companion
msgctxt "829d87ce-af80-459b-b454-b8ac741ac16c"
msgid ""
"\"We could ban the Tears, and dismiss the victims from their posts, and we'd "
"be rid of Razmiran's influence. A crueler ruler could even count the victims "
"as traitors and sentence them to death. Personally, I trust in your mercy. I "
"believe that you'll hand the addicts over to the priests for treatment. That "
"would disrupt Razmiran's plans, our subjects would be saved.\""
msgstr ""
"\"우리는 눈물을 없애버리고, 그 피해자들을 해임 시킬수 있어요, 그리고 라즈미르인의 영향력을 없애버릴수도 있죠. 가혹한 지배자는 "
"피해자들을 배신자로 간주하고 사형을 명할 거예요. 개인적으로 저는 당신의 관용을 믿고 있어요. 이 중독자들을 사제들에게 치료하게끔 "
"하실꺼라 생각해요. 이를 통해 라즈미르인의 계획을 막고, 우리 백성들도 구원받을거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0026_Text
#. Speaker : Valerie_Companion
msgctxt "0ed6d1bb-8d54-4180-ac69-f44da0ca0f86"
msgid ""
"\"These people fell for the drug. They jeopardized our kingdom's safety, and "
"they must be punished. I suggest you strip them of their positions and their "
"possessions, and bequeath them to their successors – who will hopefully be "
"individuals of stronger will and moral fiber. We do not delight in severe "
"punishment, but indulging their vices and then financing their treatment "
"from the people's budget – that is a bridge too far.\""
msgstr ""
"\"이 사람들은 약물에 빠져버렸습니다. 그들은 왕국의 안전을 위태로게 했고, 따라서 처벌받아야만 합니다. 그들의 지위와 재산을 압수하고 "
"의지와 도덕심이 강한 후계자에게 넘겨야합니다. 가혹한 처벌이 즐겁지는 않습니다만, 그들의 일탈을 그저 받아주는 것과 시민들의 지갑에서 "
"치료를 위한 자금조달을 하는 것은, 그건 무리입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank7/Relations_Rank7DrugImport/Cue_0027_Text
#. Speaker : SadisticMage_Capital
msgctxt "757c862e-e208-4615-b61e-fb687919478a"
msgid ""
"\"These corrupt drug lovers have betrayed your Highness for their narcotic! "
"I hope they don't expect your Highness to give any thought to their "
"treatment! The traitors' punishment must be severe, so their successors will "
"never be tempted to follow in their footsteps! I suggest you sentence the "
"addicts to death. Merely taking away their positions and belongings isn't a "
"sufficient deterrent for betrayal.\""
msgstr ""
"\"이 타락한 약물 중독자들은 마약을 위해서 전하를 배신했습니다! 전하께서 그들에게 치료제를 주리라고 그들이 생각하지 않았으면 "
"좋겠습니다! 배신자들에 대한 처벌이 가혹해야만, 후계자들이 그 전철을 절대 밞지 않으려고 할 겁니다! 중독자들에게 사형을 명할것을 "
"제안합니다. 그저 그들의 직위와 재산을 빼앗는 것은 배신에 대한 충분한 제재가 아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank8/Relations_Rank8Kyonin/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "88aa6396-64b1-445e-8a0c-f7f531a82eed"
msgid ""
"\"{name}, we have alarming news! Kyonin has frowned upon our politics for "
"quite a while. Now they're encouraging the elves in our lands to renounce "
"their allegiance to you, stop paying taxes, and leave the country. Many of "
"these elves are among our most respected leaders, artists, and craftsmen – "
"and they've already started packing their belongings!\""
msgstr ""
"\"{name}, 알아야할 소식이 있어요! 쿄닌이 우리 정치에 대해 꽤 못마땅해하고 있어요. 지금 쿄닌은 우리 영토내의 엘프들에게 우리에 "
"대한 충성을 포기할 것과 세금을 지불하지 말것, 그리고 국가를 떠나도록 종용하고 있어요. 이 엘프들 중 다수가 존경받는 지도자들과 "
"예술가들 그리고 장인들이에요. 그리고 그들은 벌써 짐을 싸고 있어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank8/Relations_Rank8Kyonin/Cue_0002_Text
#. Speaker : Valerie_Companion
msgctxt "4eadba84-37b7-4eb1-8c38-58afdc425125"
msgid ""
"\"I hate to say it, {name}, but Kyonin has stood up to us. They're publicly "
"denouncing your rule, and encouraging all the elves in the kingdom to "
"renounce their allegiance, stop paying taxes, and leave the country. A wave "
"of refugees is streaming for the border, and we mustn't let them cross. "
"There are many talented and well-respected figures among their number, and "
"their loss would be a severe blow to the {mf|barony|barony|kingdom|kingdom}."
"\""
msgstr ""
"\"말하기 싫지만, {name}, 쿄닌이 우리와 대립하고 있습니다. 그들은 공개적으로 당신의 지배를 비판하고 있고, 우리 왕국내에 모든 "
"엘프들에게 충성을 포기할 것과 세금을 지불하지 말 것, 그리고 국가를 떠나도록 종용하고 있습니다. 피난민들이 국경에 줄을 잇고 있고, "
"우리는 그들이 떠나지 못하도록 해야합니다. 그들중에 매우 존경받는 인사들이 다수 있습니다. 그리고 그들을 잃는 것은 "
"{mf|남작령|남작령|왕국|왕국}에 치명적인 타격이 될 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank8/Relations_Rank8Kyonin/Cue_0003_Text
#. Speaker : SadisticMage_Capital
msgctxt "6a3fe46e-d4df-4750-90f4-fb6745514a4d"
msgid ""
"\"Your Highness, the hypocrites of Kyonin dare criticize your governance! "
"They are encouraging the elves who live by your mercy to throw off their "
"allegiance to you, forego their taxes, and desert the country! It is "
"revolting! Worse still, there are experienced craftsmen and talented mages "
"among them. If we allow them to flee it will be a heavy blow to both our "
"economy and our reputation!\""
msgstr ""
"\"전하, 쿄닌의 위선자들이 감히 당신의 지배를 비판합니다! 그들은 당신 밑의 엘프들에게 당신에 대한 충성을 내던질 것과 세금 지불을 "
"포기하도록 그리고 국가를 저버릴 것을 종용하고 있습니다! 이건 반란입니다! 설상가상으로, 숙련된 장인들과 재능있는 마법사들이 이에 "
"포함되어 있습니다. 만약 그들이 자유롭게 떠나도록 한다면, 우리 경제와 명성에 치명적인 타격이 될 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank8/Relations_Rank8Kyonin/Cue_0026_Text
#. Speaker : Linzi_Companion
msgctxt "5a7d329a-4998-4988-a3b1-a7acf44d1d1a"
msgid ""
"\"Please, don't let the Warden's guards attack them! That would cause havoc "
"and suffering! They don't understand that they're being used as pawns in a "
"campaign against our {mf|barony|barony|kingdom|kingdom}. Of course, we could "
"have the General close the country's borders, but wouldn't it be best if no "
"one tries to leave at all? I suggest the Curator should begin a retaliatory "
"defamation campaign against Kyonin. Why are they always telling elves who "
"live elsewhere how they should live their own lives?\""
msgstr ""
"\"간청하건데, 감시관의 경비대가 그들을 공격하도록 놔두지 말아주세요! 큰 혼란과 고통이 야기될 거예요! 그들은 스스로가 우리 "
"{mf|남작령|남작령|왕국|왕국}에 대한 작전에 이용되는 장깃말이라고 이해하지 못하고 있어요. 물론, 장군으로 하여금 국경을 봉쇄하도록 "
"할 수 있지만, 그냥 그 누구도 떠나지 않게끔 하는 것이 최선아닐까요? 쿄닌에 대한 보복 명예훼손 운동을 학예사에게 시작하게끔 해야해요. "
"왜 언제나 그들은 다른곳에서 살고있는 엘프들에게 어떤 삶을 살아야하는지 이러쿵저러쿵 조잘대는 걸까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank8/Relations_Rank8Kyonin/Cue_0027_Text
#. Speaker : Valerie_Companion
msgctxt "0b51b20b-b6cf-4b50-bbf6-815e0e1ecdfa"
msgid ""
"\"They may eventually come to see that trusting Kyonin was a mistake, but "
"swaying opinion like that isn't something that can happen overnight. I don't "
"think we'll ever be able to convince them, although I know understand that "
"our Curator is desperate for a chance to turn the war of words around, and "
"shame Kyonin. We could instead simply order the Warden to arrest the "
"influencers behind the exodus. They're known to be hiding in the capital, so "
"we could make the arrests directly – but the elves would surely fight back, "
"and there would be blood. The better option would be to have the General "
"close the borders and prevent the elves from leaving the kingdom. They'd "
"have to listen to sense and see reason, and soon enough they'd thank us for "
"our intervention.\""
msgstr ""
"\"결국 쿄닌을 믿는 것이 실수였다는 것을 알게 될 겁니다만, 이러한 선동은 하루아침에 이뤄지는 것은 아닙니다. 우리가 그들을 설득시킬수 "
"있을지도 잘모르겠습니다, 우리 학예사가 간절하게 언론전을 반향시키고 쿄닌을 수치스럽게 하고 싶어하는 것은 알고있지만요. 우리는 대신에 "
"그저 감시관에게 이 대탈주의 배후에 있는 선동가들을 체포함게끔 할수도 있습니다. 수도에 숨어있는 것으로 알려져 있기에, 직접적으로 "
"체포할수 있습니다. 그러나 엘프들은 분명히 반격할겁니다, 그리고 피가 흐를겁니다. 더 좋은 의견은 장군으로 하여금 국경을 봉쇄하고 "
"엘프들이 왕국을 떠나지 못하도록 하는겁니다. 그들은 합리와 이성을 느껴야만 합니다, 그리고 얼마 안가서 우리의 간섭에 고마워 할 겁니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank8/Relations_Rank8Kyonin/Cue_0028_Text
#. Speaker : SadisticMage_Capital
msgctxt "e9f3c75a-bf75-4475-b35c-80b96bf9a2e3"
msgid ""
"\"We must stem the flow of refugees before it's too late. Closing the "
"borders wouldn't help, the elves would continue to plot their escape, "
"meanwhile refusing to work for the good of the kingdom. The very idea of "
"deserting the country must be shattered completely. We could order the "
"Curator to paint Kyonin as the bloody tyrants they are, but in the meantime "
"we should order the Warden to raid the city and arrest every troublemaker "
"who talks of leaving. – There must be no dissent!\""
msgstr ""
"\"너무 늦기전에 피난민들의 행렬을 저지해야만 합니다. 엘프들이 자기 일을 내팽겨치고 계속해서 탈출을 도모할 것이기 때문에, 국경봉쇄는 "
"별 도움이 안될겁니다. 이 탈출에 대한 생각은 완벽하게 분쇄해야합니다. 우리는 학예사로 하여금 쿄닌이 피의 독재자라고 선동하게끔 할수도 "
"있습니다만, 그동안 감시관에게 도시를 급습해서 탈출을 선전하는 모든 이들을 체포하게끔 해야합니다. 반대 의견은 없어야만 합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank8/Relations_Rank8Sevenarches/Cue_0003_Text
#. Speaker : Linzi_Companion
msgctxt "17994917-8284-4a65-94ed-a9c20d34a750"
msgid ""
"\"{name}, Sevenarches is trying to exact revenge for our refusal to aid in "
"the Novoboro conflict! Not only have they cut off food supplies, their "
"wandering druids hired to fight this crisis are instead spoiling our crops "
"further! Faced with the risk of starvation, our people are panicking and "
"fighting for food in the markets. This must be resolved.\""
msgstr ""
"\"{name}, 세븐아치가 노보보로 갈등 구원 요청 거절에 대한 확실한 복수를 꾀하고 있어요. 식량 공급을 끊는 것뿐만이 아니라, "
"위기상황에서 싸우도록 고용된 그들의 방랑 드루이드들은 우리 작물들을 오염시키고 있어요! 기근의 위험을 마주하고 우리 백성들은 혼란에 "
"빠져있고 시장의 음식을 위해 투쟁하고 있어요. 반드시 해결해야만 해요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank8/Relations_Rank8Sevenarches/Cue_0004_Text
#. Speaker : Valerie_Companion
msgctxt "b57c85d7-917b-4b2f-83a0-5ece22fbbabf"
msgid ""
"\"{name}, Sevenarches us putting pressure on us for not joining them in the "
"Novoboro conflict. They've stopped supplying us with food, and their druids, "
"the traveling farm hands, seem suddenly to be sabotaging the local crops. As "
"the threat of starvation rises, there's an increasing sense of panic in the "
"kingdom. The peasants will start fighting for bread before we even run out "
"of it.\""
msgstr ""
"\"{name},세븐아치가 노보보로 갈등 지원 거절때문에 우리에게 압박을 가하고 있습니다. 음식공급을 끊고, 저들의 드루이드와 농장 "
"일꾼들이 갑자기 우리 지역 작물들에 사보타지를 가하고 있습니다. 기근의 위협이 올라감에 따라, 왕국 전체가 혼란에 빠지고 있습니다. 우리 "
"빵이 다 떨어지기도 전에 농민들은 빵을 위해 투쟁하기 시작할 겁니다. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank8/Relations_Rank8Sevenarches/Cue_0005_Text
#. Speaker : SadisticMage_Capital
msgctxt "9437690d-5fa2-4f2e-8647-0d0dff8ca4c6"
msgid ""
"\"Your Highness! Our reports indicate that Sevenarches is undermining our "
"farming industry! They've cut off our food supply, and their druids that "
"travel around the River Kingdoms as farmhands are now suspected of spoiling "
"our crops! We're facing starvation, and the people know it. Their panicked "
"attempts to stock supplies 'for leaner times' are devastating the market "
"even more!\""
msgstr ""
"\"전하! 세븐아치가 우리 농업을 약화시키고 있다는 보고입니다! 우리에 대한 식량 공급을 끊고 강의 왕국들을 여행하는 농장 일꾼으로서의 "
"그들의 드루이드들이 우리 작물을 오염시키고 있다고 의심받는 중입니다! 우리는 기근을 마주하고 있습니다, 그리고 우리 백성들은 이를 "
"알고있습니다. 보릿고개를 위한 사람들의 물품 사재기가 시장을 완전히 파괴하는 중입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank8/Relations_Rank8Sevenarches/Cue_0026_Text
#. Speaker : SadisticMage_Capital
msgctxt "2744ba2a-2976-428e-accd-25a64d058cf4"
msgid ""
"\"Sevenarches expects us to tighten our belts, send the Warden's guards to "
"collect bread from the citizens, and beg for mercy – but this will never "
"happen! We can find druids who will rejuvenate our crops. The High "
"{mf_HighPriest|Priest|Priestess} will be able to persuade them... or force "
"them. The best we can do for now is send the General to the Sevenarches "
"border. Faced with an army, the farmers will obediently sell us whatever we "
"ask for.\""
msgstr ""
"\"세븐아치는 우리가 허릿띠를 졸라메고 감시관을 보내서 시민들의 빵을 압수하기를 기대하고 있습니다. 그리고 그들에게 자비를 구걸하기를 "
"말입니다. 하지만 이는 절대 일어나지 않을 겁니다! 작물을 재생시켜줄 드루이드들을 찾아야 합니다. 고위 "
"{mf_HighPriest|사제|여사제}가 그들을 설득 할 수 있을 겁니다... 혹은 강제할 수 도 있고 말이죠. 지금 우리가 할 수 "
"있는 최선은 장군을 세븐아크 국경으로 보내는 겁니다. 군대와 마주하면, 농민들은 고분고분하게 우리가 요구하는 무엇이건 내줄 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank8/Relations_Rank8Sevenarches/Cue_0027_Text
#. Speaker : Linzi_Companion
msgctxt "f51809f4-448c-4e9b-a254-4a080cce7a67"
msgid ""
"\"We must take urgent measures! Sending the General's army to Sevenarches "
"would be effective, but cruel to the local farmers. I have two ideas. First, "
"the response they expect from us is to tighten our belts, stockpile bread, "
"and order the Warden to distribute it evenly. The second, and the better "
"plan, is to have the High {mf_HighPriest|Priest|Priestess} persuade the "
"local druids to fix the situation with this year's harvest. They normally "
"stay out of such conflicts, but this is a dire emergency."
msgstr ""
"\"긴급 조치를 취해야만 해요! 장군의 군대를 세븐아치로 보내는 것이 효율적이겠지만, 지역 농부들에게 너무 가혹한 방안이에요. 두 개의 "
"방법이 있어요. 첫 번째로, 그들이 우리에게 바라는 반응은 우리 허리띠를 졸라매고, 빵을 거둔다음에, 감시관으로 하여금 이를 분배하게끔 "
"하는 거예요. 두 번째로, 이게 좀 더 나은 방법인데, 고위 {mf_HighPriest|사제|여사제}로 하여금 지역 드루이드들에게 이 "
"한해 수확 문제를 해결하게끔 설득하는 거예요. 보통 그들은 이러한 갈등에서 떨어져 있지만, 이건 긴급 상황이니까요."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank8/Relations_Rank8Sevenarches/Cue_0028_Text
#. Speaker : Valerie_Companion
msgctxt "979c03b4-8dc0-4d4c-831e-21d62a7b7955"
msgid ""
"\"We must act quickly. We have many druids living in the local woods, but "
"they stay neutral in any political disagreement. The High "
"{mf_HighPriest|Priest|Priestess} will have to be delicate if we're to seek "
"their help. Although if Sevenarches really expects us to starve to death, it "
"would only be fair to deploy the General's troops. I'm sure their farmers "
"will negotiate more freely with warriors than merchants. But in truth "
"there's nothing gained by making the farmers suffer for the sins of their "
"rulers. We could instead give them a role in solving the crisis. The best "
"way to avoid starvation is to gather all the grain that's produced – and "
"then have the Warden distribute it based on need.\""
msgstr ""
"\"재빠르게 움직여야 합니다. 우리 지역 숲에 많은 드루이드들이 살고있지만, 그들은 어떤 정치적 충돌에도 중립을 지킬겁니다. 고위 "
"{mf_HighPriest|사제|여사제}가 드루이드의 도움을 얻기 위해 충분히 봉사해줄수 있을 겁니다. 세븐아치가 진정 바라는 것은 "
"우리가 기근으로 말라죽는 것이지만, 장군의 병력을 배치하는 것이 공정할 겁니다. 그들의 농부들은 상인들보다는 전사들과 더 자유롭게 "
"교섭할겁니다. 하지만 사실 지배자의 죄때문에 농부들을 고통 받게 하는것으로는 그 무엇도 얻지 못할것입니다. 대신에 우리는 농부들에게 이 "
"위기를 해결할 수 있는 역할을 쥐어줄수 있습니다. 기근을 피하는 가장 좋은 방법은 생산되는 모든 작물을 모두 모아서 감시관으로 하여금 "
"필요에 따라 분배하게끔 하는 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Answer_0009_Text
msgctxt "118a8405-4e5e-4bcb-a149-4becffa1ec9b"
msgid ""
"{g|Relations9_1}[Choice effects]{/g} \"Send messengers to announce that all "
"those unwilling to become a slave to Razmir must unite.\""
msgstr ""
"{g|Relations9_1}[선택 시 효과]{/g} \"라즈미르의 의해 노예되기 싫은 자들은 반드시 단결해야 한다고 전령이 알리게끔 "
"하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Answer_0010_Text
msgctxt "e006f6f8-b9e6-4fb6-a0a2-e2060ae0b71a"
msgid ""
"{g|Relations9_2}[Choice effects]{/g} [Gain 250 BP] \"We aren't meddling in "
"the domestic affairs of other countries.\""
msgstr ""
"{g|Relations9_2}[선택 시 효과]{/g} [250 BP 획득] \"우리는 다른 나라의 내정에 간섭하지 않을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Answer_0011_Text
msgctxt "4bc8b8e6-38d0-45fe-8de5-c28b090c3511"
msgid "\"I want to know more about this political conflict.\""
msgstr "\"이 정치적 갈등에 대해 좀 더 말해보라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Answer_0014_Text
msgctxt "227a74e7-df18-4db6-8375-30b2a515ec0e"
msgid "\"I trust your opinion.\""
msgstr "\"그대의 판단을 믿겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0005_Text
#. Speaker : Linzi_Companion
msgctxt "eaea8140-8b0e-434d-a620-1007f767be52"
msgid ""
"\"The Outlaw Council wants to know our opinion on Razmiran's current "
"behavior. They're continuing to expand their borders, slowly extending their "
"territory on all sides. Tymon has already mobilized their army, and Lambreth "
"is recruiting volunteers from among the Black Eagles. But alone, they can "
"never match the might of Razmiran. – We must bring them together in stable "
"union if we wish to curb Razmir's ambitions.\""
msgstr ""
"\"무법자 의회는 라즈미란의 현재 행동에 대한 우리의 의견을 알고 싶어 합니다. 라즈미란은 국경선을 계속 넓히고 있는 중이고, 천천히 "
"그들의 영토 전방항으로 진출하고있습니다. 타이몬은 벌써 군대를 동원했고, 램브레스는 검은 독수리들 중에서 자원자를 모집하고 있습니다. "
"하지만 그들 홀로는 강력한 라즈미란과 싸울 수 없을겁니다. 만약 우리가 라즈미르의 야망을 막고싶다면, 우리는 그들을 안정된 연합으로 "
"만들어야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0006_Text
#. Speaker : Valerie_Companion
msgctxt "8dea8db0-8774-4ae1-a550-d14e918ce05e"
msgid ""
"\"The Outlaw Council is willing to hear us out. Razmir is pushing back his "
"neighbors in the East, and Tymon has mobilized his forces. Lambreth is "
"bolstering the Black Eagles with volunteers. But their forces are scattered "
"and divided. Only in a stable union would they be strong enough to oppose "
"Razmir.\""
msgstr ""
"\"무법자 의회가 우리 애기를 듣고 싶어합니다. 라즈미르가 그의 동쪽 이웃을 밀어내고 있는 중이고, 타이몬은 병력을 동원했습니다. "
"램브레스는 검은 독수리 자원자를 독려하는 중입니다. 그러나 그들 병력은 흩어졌고 나눠져있습니다. 오직 안정적인 연합으로써야 라즈미르에 "
"대항할만큼 강해질수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0007_Text
#. Speaker : SadisticMage_Capital
msgctxt "dc238532-151f-4c21-960f-98c62fa36615"
msgid ""
"\"The Outlaw Council wishes to hear your opinion. Razmir is testing his "
"eastern border once again, and Tymon's ruler has started recruiting "
"mercenaries to oppose Razmir. Lambreth has mobilized the Black Eagles. Alas, "
"these forces stand divided, where they should be united in common cause. "
"Only a stable union can stand up to Razmiran.\""
msgstr ""
"\"무법자 의회가 우리 의견을 듣고 싶어합니다. 라즈미르가 그의 동쪽 국경을 다시한번 자극하고 있고, 타이몬의 지배자는 라즈미르에 "
"대항해서 용병들을 모집하는 중입니다. 램브레스는 검은 독수리를 동원했습니다. 하지만, 공통의 목적을 위해 단결해야 할 그들의 힘은 "
"분열되어 있습니다. 오직 안정된 연합만이 라즈미란에게 대항할수 있을겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0012_Text
#. Speaker : Linzi_Companion
msgctxt "8bc3b952-7dd3-400d-863c-e142ba956d6b"
msgid ""
"\"Perfect! We shall call upon the River Kingdoms to stand together to face "
"Razmir's threat. I'm sure this open confrontation of tyranny will only add "
"to your fame.\""
msgstr ""
"\"완벽합니다! 우리는 라즈미르의 위협에 대항해 같이 일어서도록 강의 왕국들에게 청할겁니다. 이 폭정에 대한 공개적 대립은 당신의 명성을 "
"드높일겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0013_Text
#. Speaker : Valerie_Companion
msgctxt "965cd568-1eae-4388-9609-782e3ab7bf79"
msgid ""
"\"We're calling upon the River Kingdoms to unite and face Razmir. His "
"appetite is too immense to imagine that we are not likewise consumed. As for "
"the common people, they will adore your commitment to striking down tyranny."
"\""
msgstr ""
"\"우리는 강의 왕국들에게 라즈미르에게 대항해 단결할 것을 요구하고 있습니다. 라즈미르의 탐욕은 너무 거대해서 우리가 삼켜지지 않을 "
"것이라고 상상하기 어렵습니다. 일반 국민들은 폭정을 저지하기 위한 당신의 노력을 아주 좋아할겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0015_Text
#. Speaker : Linzi_Companion
msgctxt "e46f3d03-c8de-4925-b53c-56f60b6459d3"
msgid ""
"\"Well, Tymon and Lambreth are Razmiran's immediate neighbors to the East. "
"Tymon's founder was Maldar Tymon, a renowned Taldan hero. By long tradition, "
"it is a city of warriors, arena fighters, and gladiatorial champions. The "
"Arena of Aroden is there, along with numerous military schools. Razmiran has "
"a predictably difficult time of dealing with Tymon's army – especially when "
"they're supported by Gorum's priests.\""
msgstr ""
"\"자, 타이몬과 렘브레스는 라즈미란 동쪽의 가장 가까운 이웃들입니다. 타이몬의 건국자는 탈단 영웅으로 잘 알려진 말다르 "
"타이몬이었습니다. 오랜 전통에 따라, 타이몬은 전사, 투기장 싸움꾼, 검투사들의 도시입니다. 수없이 많은 군사 학교와 함께 알도렌 "
"투기장이 거기 있습니다. 라즈미란이 타이몬의 병력과 힘든 시간을 보내고 있을거라고 생각합니다. - 특히 그들이 고룸의 사제들에게 지원받고 "
"있을 때 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0016_Text
#. Speaker : Valerie_Companion
msgctxt "b04e4eda-9b6a-44f6-a29a-b1e3628d6731"
msgid ""
"\"Tymon and Lambreth are Razmir's preferred prey, though both countries are "
"hard nuts to crack. Tymon was founded by Maldar Tymon, a great warrior and a "
"hero of Taldan. The state will send entire armies of gladiators and highly-"
"trained soldiers to fight under his banners.\""
msgstr ""
"\"두 나라 모두 까먹기 힘든 땅콩들이지만, 타이몬과 램브레스는 라즈미르가 선호하는 먹잇감입니다. 타이몬은 위대한 탈단 영웅 전사 말다르 "
"타이몬에 의해 건국됐습니다. 타이몬은 도시 깃발 아래서 싸울 검투사들과 고도로 훈련받은 싸움꾼들의 군대 전체를 내보낼겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0017_Text
#. Speaker : SadisticMage_Capital
msgctxt "9b4fb079-d717-4781-9364-de305d28e26d"
msgid ""
"\"It's obvious that Tymon and Lambreth will soon fall to Razmir. Tymon is a "
"foolish state of gladiators, whose favorite sport is to slay one another in "
"the giant Arena of Aroden. Their fighting ability is unquestioned, but they "
"lack any political skill. Champion Ullorth Ungin, Tymon's ruler, begs the "
"Outlaw Council in Daggermark to help him defend against Razmir every year.\""
msgstr ""
"\"타이몬과 램브레스가 라즈미르에게 함락될 것은 명백합니다. 타이몬은 거대한 알도렌 투기장에서 또 다른 이를 살해하는 스포츠를 가장 "
"선호하는 어리석은 국가입니다. 그들의 싸움 실력에 의문점은 없습니다만, 정치적 기술이 부족합니다. 타이몬의 지배자 용사 울로스 운진은 "
"대거마크의 무법자 의회에 라즈미르에 대항하는 것을 도와달라고 매년 빌고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0018_Text_String
#. Speaker : SadisticMage_Capital
msgctxt "51dda7b4-4ea4-4413-b892-0f11db864596"
msgid ""
"\"Hm... This decision will surely please the people, but is it really wise? "
"Sooner or later, the minor kingdoms will fall, and their lands will be taken "
"by Razmir. It would be wiser to support the stronger state, and reap a share "
"of the spoils.\""
msgstr ""
"\"흠... 이 결정은 분명 사람들을 기쁘게 할겁니다, 하지만 진정 현명할까요? 빠르건 늦건, 약한 왕국들은 몰락할것이고, 그들의 영토는 "
"라즈미르에게 빼앗길겁니다. 더 강한 국가를 지원하는게 더 현명할겁니다, 그리고 전리품을 공유받읍시다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0019_Text_String
#. Speaker : Linzi_Companion
msgctxt "e915b719-82e3-47fd-97db-ae939165fd64"
msgid ""
"\"So we're leaving our neighbors to rot? Will we leave them to be enslaved "
"by this foul wizard who thinks he's a god? It's... just horrible. How can I "
"write about that!?\""
msgstr ""
"\"그러면 우리 이웃이 바스러지게 내버려둘건가요? 자기가 신이라고 생각하는 이 멍청한 마법사의 노예가 되도록 그들을 방치할건가요? "
"이건...정말 끔찍하네요. 제가 어떻게 이걸 기록하죠!? \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0020_Text_String
#. Speaker : Valerie_Companion
msgctxt "dff0fade-02ef-4251-b012-5d7c9e77285a"
msgid ""
"\"You shouldn't imagine that invading his immediate neighbors will sate "
"Razmir's appetite. There will come a day when we see his mask on soldiers at "
"our gates.\""
msgstr ""
"\"아주 가까운 이웃을 침략하는 것으로 라즈미르가 만족할거라고 생각해선 안됩니다. 언젠가 우리 문앞에서 그의 가면을 쓴 병사를 볼 날이 "
"올겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0021_Text
#. Speaker : SadisticMage_Capital
msgctxt "16ab42f8-e96b-4798-a337-9d13cd13d50d"
msgid ""
"\"Very cunning. Only two monarchs of the River Kingdoms can see the future "
"of this land – Your Highness and Razmir. The others are destined to rot. We "
"won't derail our relations with Razmir – not yet. It is more strategic to "
"wait... and claim everything that he cannot claim himself.\""
msgstr ""
"\"매우 현명합니다. 오직 강의 왕국들 중 오직 두개의 전제왕국만이 이 땅의 미래를 볼 수 있습니다 - 전하와 라즈미르말입니다. 다른 "
"국가들은 바스러질 운명입니다. 우리는 라즈미르와의 관계를 헝클어트리지 않을겁니다. 아직까지는 말입니다. 기다리는 것이 좀 더 "
"전술적입니다... 그리고 라즈미르 혼자 힘으로 할 수 없는 모든 것들을 요구합시다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0022_Text
#. Speaker : SadisticMage_Capital
msgctxt "0ce9bdb6-731b-4a4a-93d2-35edaea66f2e"
msgid ""
"\"Kyonin and the other countries will listen to us if we vote for the River "
"Kingdoms to unite against Razmiran. However, Razmir has made a generous "
"offer in exchange for our silence. Besides, his future is far brighter than "
"those minor monarchs. I think we should side with him.\""
msgstr ""
"\"우리가 라즈미란에 대항하는 강의 왕국들 연합에 대해 투표하면 쿄닌과 다른 나라들은 우리 말을 들어줄겁니다. 그러나 우리의 침묵에 "
"라즈미르가 상당한 대가를 제안했습니다. 게다가, 그의 미래는 다른 미약한 전제왕국들에 비해 좀 더 밝습니다. 제 생각에는 그와 같이 "
"하는게 좋을 것 같군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0023_Text
#. Speaker : SadisticMage_Capital
msgctxt "442196f4-e168-44bf-948f-11afa64d2c79"
msgid ""
"\"Sevenarches and other countries will listen to us, if we vote for the "
"River Kingdoms to unite against Razmiran. However, Razmir has made a "
"generous offer in exchange for our silence. Besides, his future is far "
"brighter than those minor monarchs. I think we should side with him.\""
msgstr ""
"\"라즈미란에 대항하는 강의 왕국들 연합에 우리가 투표한다면, 세븐아치와 다른 나라들은 우리 말을 들어줄겁니다. 그러나 우리의 침묵에 "
"라즈미르가 상당한 대가를 제안했습니다. 게다가 그의 미래는 다른 미약한 전제왕국들에 비해 좀 더 밝습니다. 제 생각에는 그와 같이 하는게 "
"좋을 것 같군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0024_Text
#. Speaker : Valerie_Companion
msgctxt "99856a83-516a-47a6-a852-ea09cf43c420"
msgid ""
"\"Kyonin is prepared to follow us, and many others will join them. But on "
"the other hand, Razmiran would generously reward our friendship. But to be "
"honest, I think it's time Razmir be taught a lesson. Should we call upon the "
"River Kingdoms to unite?\""
msgstr ""
"\"쿄닌은 우리를 따를 준비가 되었고, 다른 나라들도 쿄닌에 가담할 겁니다. 다른 한편, 라즈미란은 우리의 우정에 대해 상당히 "
"보상해줄겁니다. 허나 솔직히 말해서 지금은 라즈미르가 교훈을 배울 시간인것 같습니다. 강의 왕국들 연합을 소집할까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0025_Text
#. Speaker : Valerie_Companion
msgctxt "b41e807e-856e-46b9-9067-9e3c525d2d13"
msgid ""
"\"Sevenarches is prepared to follow us, along with many other countries, but "
"Razmiran has promised to reward our friendship generously. Still, if you ask "
"me, it's time to teach Razmir a lesson. Should we call upon the River "
"Kingdoms to unite?\""
msgstr ""
"\"세븐아치와 다른 나라들은 우리를 따를 준비가 되어있습니다. 하지만 라즈미란은 우리에 우정에 대한 상당한 대가를 약속했습니다. 그럼에도 "
"제게 물으신다면, 저는 라즈미르에게 교훈을 가르쳐줄 시간이라고 생각합니다. 강의 왕국들 연합을 소집할까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0026_Text
#. Speaker : Linzi_Companion
msgctxt "87408b31-cd3d-4eef-baf1-3e46f06426b4"
msgid ""
"\"The Sevenarches trust us to act as we think best, as do many of the "
"smaller kingdoms. Razmir, for his part, has offered to generously reward our "
"silence. But we must call upon the River Kingdoms to unite. The Razmiran "
"expansion must be stopped!\""
msgstr ""
"\"세븐아치는 우리가 가장 최선의 행동을 할 것이라고 다른 작은 왕국들만큼이나 믿고 있습니다. 라즈미르는 우리의 침묵에 대해 상당한 "
"대가를 제안했습니다. 그러나 우리는 강의 왕국들 연합을 소집해야만 합니다. 라즈미르의 팽창은 중단되야 합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0027_Text
#. Speaker : Linzi_Companion
msgctxt "d72038cd-3ec9-4524-b95c-13a204d84f98"
msgid ""
"\"Kyonin trusts us, as do many other states. Razmiran has offered to reward "
"our silence generously, but I think in good faith we must call upon the "
"River Kingdoms to unite. This Razmiran expansion must be stopped!\""
msgstr ""
"\"쿄닌은 다른 나라들만큼 우리를 믿고 있습니다. 라즈미르는 우리의 침묵에 대해 상당한 대가를 제안했습니다. 그러나 강의 왕국들 연합을 "
"소집하는 것이 제 생각에는 가장 맞는것 같습니다. 라즈미르의 팽창은 중단되야 합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0034_Text
#. Speaker : Linzi_Companion
msgctxt "79053136-91a1-4f4e-9b08-0d6015a59ac9"
msgid ""
"\"Every year, champion Ullorth Ungin, Tymon's current ruler, asks the Outlaw "
"Council to help him fight off Razmir's aggression. The Outlaw Council "
"consists of the rulers each River Kingdom, and they hold court every year in "
"Daggermark. Unfortunately, not many of them are receptive to Ungin's pleas. "
"Even Kamdyn Arnefax is not his ally, though they have a shared enemy in "
"Razmiran.\""
msgstr ""
"\"매년 타이몬의 현재 지배자 울로스 운진은 라즈미르의 도발에 맞서 싸우는 것을 무법 평의회에 도와달라고 간청하고 있습니다. 무법 "
"평의회는 각 강의 왕국들의 지배자들로 구성되어있습니다. 그리고 대거마크에서 매년 의회를 소집합니다. 불행하게도, 그들 중 다수가 운진의 "
"간청에 소극적입니다. 캠딘 아른팩스 또한 그의 편이 아닙니다, 그럼에도 불구하고 그들은 라즈미란이라는 공통의 적을 가지고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0035_Text
#. Speaker : Linzi_Companion
msgctxt "a4dd7a27-9327-46d1-a805-378b5ed6b65c"
msgid ""
"\"Arnefax governs Lambreth, a small state that was formed through the union "
"of three rival merchant families, who feared annexation by their neighbors. "
"Razmiran's shameless land-grabbing is nothing new to them. – It was "
"Razimir's invasion that elevated Arnefax from a mere general to the Dictator "
"of Lambreth. The Black Eagles, his private knights, impose order in the "
"country and ensure that his will is carried out. They are feared even among "
"the people of Lambreth, but they excel at protecting the country and the "
"citizens against invaders.\""
msgstr ""
"\"아른팩스는 그들 이웃의 의해 합병되는 것을 두려워하던, 세 개의 경쟁 상가가 연합하여 만든 작은 나라 램브레스를 다스립니다. "
"라즈미란의 뻔뻔한 토지강탈은 그들에게 새로운 것이 아닙니다. 라즈미르의 침략은 아른팩스가 램브레스의 작은 독재자 장군일 시절부터 이어져 "
"온 것입니다. 그의 사기사단인 검은 독수리들은 나라 안에서 왕의 명령을 수행하고 그의 의지가 발현되도록 합니다. 그들은 램브레스 백성들 "
"대부분에게조차 공포의 대상입니다. 그러나 검은 독수리는 침략자에 맞서 나라와 시민을 지키는데 있어 탁월합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0036_Text
#. Speaker : Valerie_Companion
msgctxt "15da01ab-48fc-48ef-823b-b722a347dbdb"
msgid ""
"\"The state of Lambreth was established by three merchant families who "
"feared annexation from their power-hungry neighbor. Razmir's aggression "
"elevated general Kamdyn Arnefax to the throne, which he occupies as a "
"genuine dictator. His personal knights, the Black Eagles, are feared "
"throughout Lambreth, though they maintain order and protect the country "
"against constant Razmiran incursions.\""
msgstr ""
"\"램브레스는 힘에 굶주린 이웃에 대해 공포를 느끼던 세개의 상가가 건국한 나라입니다. 라즈미르의 도발은 독재자로서 군림하던 캠딘 "
"아른팩스가 장군에서 왕좌에 오르기까지 계속되었습니다. 그의 사기사단인 검은 독수리는 램브레스 전역에 걸쳐 공포의 대상입니다, 비록 그들이 "
"질서를 유지하고 라즈미란 침략에 지속적으로 대항하면서 나라를 지키고 있지만 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0037_Text
#. Speaker : Valerie_Companion
msgctxt "8d0272b4-6c8f-4966-b613-95c543391313"
msgid ""
"\"Despite this opposition, Razmir stands strong. Every year, champion "
"Ullorth Ungin, Tymon's ruler, asks the Outlaw Council in Daggermark to help "
"him defend against Razmir. Hardly anyone listens to him. What else would you "
"expect from a union of River Kingdom monarchs, half of whom were once bandit "
"chieftains themselves?\""
msgstr ""
"\"이러한 반발에도 라즈미르는 건재합니다. 매년 타이몬의 지배자인 용사 울로스 운진이 대거마크의 무법자 의회에 라즈미르에 대항하는 것을 "
"도와달라고 간청합니다. 하지만 그 누구도 그의 말을 듣지 않습니다. 인원중의 반수가 한 때 도적 두령이었던 강의 왕국들 연합으로부터 무엇을 "
"기대하겠습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0038_Text
#. Speaker : SadisticMage_Capital
msgctxt "9b73e8e3-eb22-4ff9-8551-9788a9949801"
msgid ""
"\"Not even neighboring Lambreth comes to his aid, though both face the same "
"enemy. The state of Lambreth was established by three merchant families, "
"under constant threat of annexation by their neighbors. This annexation was "
"exactly what eventually came to pass, though not by Razmir. Instead, "
"Lambreth was seized by general Kamdyn Arnefax, commander of the Black "
"Eagles. This grim dictator is no better than Razmir, if you ask me. His "
"knights are known for dispensing justice after hours – as judge, jury, and "
"executioner.\""
msgstr ""
"\"둘이 공동의 적을 가지고 있으면서도, 이웃인 램브레스조차도 도와주러 오지 않습니다. 램브레스는 이웃의 끊임없는 위협에 대한 "
"공포심때문에 세 상가가 뭉쳐서 만든 나라입니다. 이 공포가 결국에는 현실이 되었습니다, 라즈미르 때문은 아니지만요. 대신에, 램브레스는 "
"검은 독수리 지휘관 장군 캠딘 아른팩스에 의해 점유되었습니다. 제게 보기에 이 음침한 독재자는 라즈미르보다 나을것이 하등 없습니다. 그의 "
"기사단은 시간이 지난후에 정의를 부여하는 것으로 잘 알려져 있습니다. - 판사로써, 배심원으로써 그리고 처형인으로써 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Relations/Rank9/Cue_0039_Text
#. Speaker : SadisticMage_Capital
msgctxt "41b5c13d-76f5-4a18-b78a-af8e0f6007eb"
msgid ""
"\"Clearly, the Outlaw Council has no wish to help those who are too weak to "
"stand up for themselves. The Council consists of the rulers of all the River "
"Kingdoms, and none of them have any desire to upset Razmir. There are plenty "
"of fools among these minor lords, and none of them know the first thing "
"about politics. Luckily, we're nothing like them!\""
msgstr ""
"\"확실히, 무법자 의회는 스스로 방어하지 못하는 약한 자를 구하고 싶어하지는 않습니다. 의회는 강의 왕국들의 지배자들을 구성원으로 하고 "
"있고, 그들 중 그 누구도 라즈미르에게 맞서고 싶지 않아합니다. 이 미약한 군주들은 대부분이 머저리들이고 그들 모두가 정치에 대해선 "
"쥐뿔도 모릅니다. 운좋겠도, 우리는 그 놈들과는 다릅니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Merc/Cue_0001_Text
msgctxt "4c85ad2e-dc22-4afb-bdc2-91335edfbb05"
msgid ""
"{n}Your advisor has arrived to report about the recent Stability "
"developments in your {mf|barony|barony|kingdom|kingdom}.{/n}"
msgstr "{n}당신의 보좌관이 최근의 {mf|남작령|남작령|왕국|왕국}의 치안 발전에 대해 논의하기 위해 방문했습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "4cb49d13-045f-4619-8187-c3d3a478d4c5"
msgid ""
"\"I have news, {name}. Wigmold has finished his magic system. It's easier to "
"catch bandits now. Much easier.\""
msgstr ""
"\"소식이 있어, {name}. 위그몰드가 그의 마법 시스템을 완성했다. 이제 도적들을 잡기가 더욱 쉬워질거야. 훨씬 편하게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0002_Text
#. Speaker : Ekun_Companion
msgctxt "52b5e1c0-b78b-43e0-9923-878d147bc4fd"
msgid ""
"\"The Kellid shaman problem has been dealt with. The Golden Shields got all "
"of them.\""
msgstr "\"켈리드 주술사 문제가 해결됐다. 골든 쉴드가 그들 모두를 붙잡았어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0003_Text
#. Speaker : Capital_Kesten
msgctxt "c580aa00-42fd-463d-b162-b91096be4b1b"
msgid ""
"\"Your Highness, I'm pleased to report that Wigmold has successfully "
"installed his magical surveillance system! Now it's practically impossible "
"for any criminal to hide from us.\""
msgstr ""
"\"전하, 위그몰드가 마법 감시 시스템을 성공리에 설치했다는 것을 기쁜 심정으로 알려드립니다! 이제 그 어떤 범죄라도 우리로부터 숨지 "
"못합니다..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0004_Text
#. Speaker : Capital_Kesten
msgctxt "1ab0be5c-cd95-4610-8187-7cd57b46981c"
msgid ""
"\"Your Highness, as soon as the Golden Shields stepped onto the streets, "
"your domain became even more safe. Truth be told, I've come to think that I "
"underestimated them — though I already had much respect for their experience "
"and skills from the outset.\""
msgstr ""
"\"전하, 골든 쉴드가 거리로 나서자마자, 당신의 영토는 더욱 안전해졌습니다. 솔직히 말씀드리자면, 전 그들을 좀 얕보고 있었습니다. "
"처음부터 그들의 기술과 경험에 대해서는 존중하고 있었지만 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0005_Text
#. Speaker : Regongar_Companion
msgctxt "8245d50f-e815-4499-8ac5-aac51de18b68"
msgid ""
"\"Remember the magical surveillance system we purchased from that gnome? "
"Well, he's finally finished it, and it's working like a charm!\""
msgstr "\"우리가 노움에게서 구입한 마법 감시 시스템 기억해? 자, 그가 결국 완성했다고. 그리고 정말 잘 돌아가지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0006_Text
#. Speaker : Regongar_Companion
msgctxt "6a8d018a-bbef-4441-b289-813f315f98e8"
msgid ""
"\"{name}, I just had a brawl with one of Golden Shields' patrols! This "
"barkeep wanted to make a little extra for himself off my tab. The bastard "
"thought I wouldn't remember how much I drank, ha! I was already done with "
"the furniture and ready to turn my attention to the barkeep when the golden "
"heroes showed up... The point of all this being that they know what they're "
"doing! The just need to learn who they can and cannot put their paws on, ha "
"ha. But no matter — a few days in the hospital will be enough time to think "
"it over, ha ha ha hmmm... I think I hurt my spine...\""
msgstr ""
"\"{name}, 골든 쉴드 정찰병들과 다툼이 있었어! 술집주인은 내 술값으로 한 몫 턱턱히 잡으려고 했지. 이 개자식은 내가 얼마나 "
"마셨는지 기억도 못한다고 생각했고, 하! 주인장을 손봐주고 돌아나설때 이 황금 영웅들이 나타났는데... 여기서 중요한점은 사람은 자기가 "
"뭘 하고 있는지 똑똑히 알고있어야 한다는 거야! 누구 일에 발을 들이밀어야 할지 말야, 하하. 뭐 병원에서 지내는 며칠간 잘 "
"생각해보겠지, 하하하 흠... 등뼈가 좀 아픈것 같은데... \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0007_Text
#. Speaker : Ekun_Companion
msgctxt "6b475351-a90a-45dd-8d76-91d0888aa06d"
msgid ""
"\"We found the shamans who were planning to poison our food and water. – "
"Even before they reached the city's walls.\""
msgstr "\"우리 음식과 물에 독을 타려고 했던 주술사를 발견했어. 도시 장벽에 가까이 오기도 전에 말야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0008_Text
#. Speaker : Ekun_Companion
msgctxt "11e6592f-393d-43a6-9dbd-b86a80aedba8"
msgid ""
"\"We tracked down the shamans who were planning to poison our food and "
"water. – Took them as soon as they entered the city! But the townsfolk were "
"watching. Now there are rumors that the {mf|King|Queen} is spying on "
"{mf|his|her} people. How else could they have captured the barbarians before "
"they even acted?\""
msgstr ""
"\"우리 음식과 물에 독을 타려고 했던 주술사를 추적했어. 도시에 들어오자마자 붙잡았다고! 하지만 마을 주민들이 지켜보고 있었어. 이제 "
"{mf|왕|여왕}이 {mf|그의|그녀의} 백성을 사찰한다는 소문이 돌고 있어. 어떻게 야만인들이 행동하기도 전에 체포할수 있었던걸까?\\"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0009_Text
#. Speaker : Ekun_Companion
msgctxt "d5b9f401-b3cf-499b-bf19-bc76e14ee48f"
msgid ""
"\"They took the barbarians before they even got near the food and water "
"supplies. Ours suffered no losses.\""
msgstr "\"야만인들이 음식과 물에 접근하기도 전에 골든 쉴드가 체포했어. 사상자는 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0010_Text
#. Speaker : Ekun_Companion
msgctxt "8a883b8f-2233-4a7f-beec-94add6e61578"
msgid ""
"\"The barbarians snuck into some of the warehouses and poisoned the grain. "
"But Roham's people quickly found them. The grain was burned, and we suffered "
"no losses.\""
msgstr ""
"\"야만인들이 창고에 숨어들어서 곡식에 독을 탔다. 하지만 로함의 사람들이 재빠르게 야만인들을 찾아냈어. 곡식은 불태워졌고, 인명 피해는 "
"없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0011_Text
#. Speaker : Regongar_Companion
msgctxt "8f38b649-4e4e-400b-b641-5bd89c16a59d"
msgid ""
"\"He showed me how to use it for spying, and how to focus the system on "
"searching for specific threats. — And bam! We found our hairy friends' "
"hiding place! You remember those chest pounding shamans who swore to poison "
"all the food and water in the capital? Well you can forget about them now... "
"forever, ha ha ha, hmmm.\""
msgstr ""
"\"위그몰드가 마법 감시 시스템으로 수색하는 방법을 알려줬지, 원하는 놈을 찾기 위해서 뭐에 집중해야 하는지도. 그리고 밤! 우리는 이 "
"털많은 친구들의 은신처를 찾아냈다고! 사람 심장 벌렁거리게 만들던 주술사 기억해? 수도의 모든 음식과 물에 독을 타겠다고 맹세하던 놈 "
"말이야. 자 이제 신경 끌수 있을거야... 영원히, 하하하, 흠\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0012_Text
#. Speaker : Regongar_Companion
msgctxt "ffcfb34b-24cf-484a-97ed-4bc76ef8cbd2"
msgid ""
"\"As soon as those shamans entered the city, his system alerted us. Out food "
"and water is safe, but a crowd of gaping townsfolk gathered round and "
"watched as we were finishing the arrest. I chased them off as quick as I "
"could, but the rumors are already spreading anyway: 'See how quickly {name} "
"took care of those barbarians? '{mf|He|She}'s watching us — always...'\""
msgstr ""
"\"이 주술사들이 도시에 들어오자 마자, 위그몰드의 시스템이 경보를 울렸습니다. 바깥의 음식과 물은 안전합니다, 하지만 마을 사람들이 "
"모여서 우리가 체포하는 장면을 끝까지 지켜봤습니다. 주민들을 가능한 한 빨리 해산시켰지만, 소문이 벌써 멀리까지 퍼졌습니다. '{name}"
"이 얼마나 빠르게 야만인들을 붙잡는지 봤어?' '{mf|그|그녀}가 우리를 지켜보고 있어, 언제나...'\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0013_Text
#. Speaker : Regongar_Companion
msgctxt "8454de5d-87ef-4ad7-be28-8cc3b65b6874"
msgid ""
"\"They captured those hapless Kellid poisoners, by the way. It happened a "
"few days back. One of our guards caught sight of the barbarians, and "
"followed him. But when they got to the granaries, the Golden Shields were "
"already waiting for them. I hear it was a real blast. Someone even passed "
"around a hat — to chip in for the entertainment. The show earned a fair pile "
"of coins!\""
msgstr ""
"\"그런데 골든 쉴드가 이 불운한 켈리드 독살포자들을 붙잡았습니다. 며칠전에 일어난 일입니다. 우리 경비대중 한 사람이 야만인들을 "
"발견했고 그들을 미행했습니다. 하지만 야만인들이 곡물 창고에 들어갈때, 골든 쉴드가 이미 야만인들을 기다리고 있었습니다. 굉장한 "
"광경이었다고 하더군요. 누군가는 모자에 돈을 담아달라고 까지 했답니다. 여흥을 보여준 대가로요. 공연은 성공적이었다고 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0014_Text
#. Speaker : Regongar_Companion
msgctxt "88a358b4-2231-41dc-90a3-47c551b1c128"
msgid ""
"\"They captured the last of those shamans who were planning to poison the "
"capital's food and water in. It happened a few days back. Anyway, one of "
"them actually did manage to get inside one of the warehouses, but Roham's "
"people quickly found and destroyed the poisoned grain.\""
msgstr ""
"\"수도의 음식과 물에 독을 타려고 계획한 마지막 주술사들을 골든 쉴드가 붙잡았습니다. 며칠전에 일어난 일입니다. 야만인들 중 하나가 "
"창고로 어떻게든 들어가긴 했습니다만, 로함의 사람들이 재빠르게 발견했고 중독된 곡식을 파괴했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0015_Text
#. Speaker : Capital_Kesten
msgctxt "d8ddf0c7-68d0-4b05-a376-7e69a1c4b994"
msgid ""
"\"Thanks to his magics, we almost immediately found and neutralized all of "
"the shamans who were planning to poison our food and water supplies.\""
msgstr "\"위그몰드의 마법덕분에, 음식과 물에 독을 타려고 했던 주술사들을 거의 즉시 발견하고 무력화시킬수 있었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0016_Text
#. Speaker : Capital_Kesten
msgctxt "2734b173-8405-497d-9f1a-6461325b337d"
msgid ""
"\"Thanks to his magics, we were able to catch every last one of the shamans "
"who snuck inside the capital to poison our food and water supplies. "
"Unfortunately, there were witnesses during one of the arrests, and our "
"citizens are puzzled. – How could the guard have known where to look for the "
"barbarians, or where to conceal its forces and wait in ambush? Some suspect "
"that we're somehow spying on the people of the capital.\""
msgstr ""
"\"위그몰드의 마법덕분에, 음식과 물에 독을 타려고 숨어들던 주술사들을 모조리 잡을 수 있었습니다. 불행하게도, 체포과정 중에 목격자들이 "
"있었고, 시민들은 혼란에 빠졌습니다. 어떻게 경비대는 야만인들을 찾기 위한 장소를 알고있었지? 혹은 그들이 병력을 숨긴 곳을 어떻게 알고 "
"매복했지? 라고 말입니다. 어떤 이는 모종의 방법을 통해 수도 사람들을 사찰하고 있다고 의심하고 있습니다..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0017_Text
#. Speaker : Capital_Kesten
msgctxt "ad3d7a22-c820-4fce-97ef-59c39c8f1494"
msgid ""
"\"The shamans who threatened to poison food and water in the capital were "
"caught one by one. None of them came within an arrow's flight of a well or "
"granary.\""
msgstr ""
"\"음식과 물에 독을 풀겠다고 협박하던 주술사들이 하나 둘 잡히고 있습니다. 그들 중 누구도 곡식창고나 우물에 가까이 접근하지 못했습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0018_Text
#. Speaker : Capital_Kesten
msgctxt "a0e45824-9305-4038-82cd-bc6ab102fe07"
msgid ""
"\"The shamans who swore they'd poison the capital's food and water were "
"captured one by one. Unfortunately, a few of them managed to make good on "
"their threats. But Roham's people found and destroyed the poisoned grain "
"before anyone could be hurt.\""
msgstr ""
"\"음식과 물에 독을 타겠다고 맹세한 주술사들이 하나 둘 붙잡히고 있습니다. 불행하게도, 그들 중 소수가 그 목적을 달성했습니다. 하지만 "
"로함의 사람이 중독된 곡식을 발견했고 사람들에게 해를 끼치기 전에 파괴했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0019_Text
#. Speaker : Ekun_Companion
msgctxt "534dcd71-0658-4f14-bf27-27faa86a79cf"
msgid ""
"{n}Ekun falls silent, but after a while he continues:{/n} \"The kingdom has "
"grown much. It's far stronger now. We can protect our people from many "
"dangers. Perhaps nearly all of them. It's an impressive feat. I am glad that "
"you chose me as your advisor. I am happy that I could walk this path with "
"you.\""
msgstr ""
"{n}에쿤다요가 침묵에 잠깁니다, 그러나 잠시후에 그가 말을 잇습니다.:{/n} \"왕국이 꽤나 커졌어. 그리고 충분히 강하지. 우리는 "
"백성들을 많은 위험으로부터 지킬 수 있어. 거의 모두를. 이건 감명깊은 일이야. 당신이 나를 보좌관으로 선택해서 고맙군. 당신과 같은 "
"길을 걸을 수 있어서 기뻐. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0020_Text
#. Speaker : Capital_Kesten
msgctxt "383e7c23-f49f-45c6-b99e-ee40209708a7"
msgid ""
"\"I also wanted to take this opportunity to congratulate you, Your Highness. "
"I've served many rulers, and none was able to achieve such order in his {mf||"
"or her} domain — especially under such harsh conditions. I shall remember "
"with pride my service to you in these trying times. I will carry these "
"memories fondly, to my grave.\""
msgstr ""
"\"축하드리고 싶습니다, 전하. 저는 많은 지배자를 섬겼지만, 그 누구도 이 정도의 질서를 그의{mf||or 그녀의} 영토에서 확립하지는 "
"못했습니다. 특히 이런 가혹한 조건에서 말입니다. 이런 시기에 당신을 섬기게 된 것을 자부심으로 여기고 기억하겠습니다. 이 기억을 애정을 "
"가지고 제 무덤까지 가지고 갈 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank10/Rank10/Cue_0021_Text
#. Speaker : Regongar_Companion
msgctxt "16f83847-2eb0-4c85-b8dd-70099f57423c"
msgid ""
"\"I gotta say, I never thought being Warden could be so fun. Hell, I figured "
"that watching over the peasants and chasing away con artists would be "
"boring. But you… you've achieved heights far beyond the reach of any of the "
"other River kinglings. And did it all while your domain was suffering from "
"three times the normal number of cataclysms, monster invasions and wars... "
"{n}Regongar bares his fangs in a smile:{/n} \"My congratulations! The local "
"dimwits could never have dreamed of a defender like yourself!\""
msgstr ""
"\"감시관이 된다는게 이렇게 즐거운 일일지 몰랐어. 하, 농민들을 지켜보고 사기꾼을 쫓는 지겨운 일이 될줄 알았지. 하지만 너...너는 "
"다른 강의 왕국 중 에서도 가장 정점에 올라섰어. 그리고 이 모든 것을 너의 영토가 세 번의 대재앙, 괴물, 침략과 전쟁을 겪는 동안 "
"이뤄냈다고...{n}레곤가르가 송곳니를 보이며 미소 짓습니다.{/n} \"축하하지! 이 지역 얼간이들은 너와 같은 수호자가 올 거라고 "
"꿈에도 못그렸을거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Answer_0004_Text
msgctxt "2d32ccde-f2b9-4c97-a840-70b8f26c9278"
msgid ""
"{g|Stability2_1}[Choice effects]{/g} \"I order the guard doubled in all "
"settlements.\""
msgstr "{g|Stability2_1}[선택 시 효과]{/g} \"모든 정착지에 경비 수를 두 배로 늘리라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Answer_0009_Text
msgctxt "fc175a77-5501-4657-a9d0-b4d8c75336de"
msgid "{g|Stability2_2}[Choice effects]{/g} \"I order a curfew.\""
msgstr "{g|Stability2_2}[선택 시 효과]{/g} \"통행 금지령을 내리겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Answer_0010_Text
msgctxt "219b83db-925e-4713-8b0e-fe9dede4be85"
msgid ""
"{g|Stability2_3}[Choice effects]{/g} \"Let them get used to taking care of "
"themselves.\""
msgstr "{g|Stability2_3}[선택 시 효과]{/g} \"자립하는 법을 배우게 내버려두라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Answer_0011_Text
msgctxt "ff174daf-720d-4fd0-a886-e5185863e4d1"
msgid "\"You're the Warden – you know what to do.\""
msgstr "\"감시관은 그대이다. 뭘 해야 할 지는 그대가 잘 알 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0001_Text
#. Speaker : Capital_Kesten
msgctxt "d5d17a72-a691-4975-aa5e-ed61ac1eaa81"
msgid ""
"{n}Kesten bows hastily and starts talking right away.{/n} \"Bandit attacks "
"continue in your {mf|barony|barony|kingdom|kingdom}. In some places, the "
"people are scared of leaving their houses even at dusk, not to mention in "
"the dead of night.\""
msgstr ""
"{n}케스턴은 허둥지둥 예를 올리더니 바로 말을 꺼냅니다.{/n} \"{mf|남작령|남작령|왕국|왕국} 내 도적들의 공격이 계속 이어지고 "
"있습니다. 어떤 곳에선 사람들이 동이 틀 때도 집 밖에 나서는 걸 두려워 하고 있으며, 심야는 말 할 것도 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0002_Text
#. Speaker : Capital_Kesten
msgctxt "822bb815-fbb6-477b-a66f-b41472be366e"
msgid ""
"\"As your Warden, I recommend we double the number of guards. That will "
"allow us to keep the situation under control. I will arm everyone I can, and "
"hasten their training.\""
msgstr ""
"\"감시관으로서, 경비대 수를 두 배로 늘리길 추천합니다. 그러면 상황이 안정될 것입니다. 제가 가능한 모두를 무장시키고, 훈련을 "
"서두르겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0003_Text
#. Speaker : Ekun_Companion
msgctxt "3d5ee7be-7ead-48bb-abc5-c84f8fffa3b0"
msgid ""
"{n}Ekun looks sullen.{/n} \"There's disaster. Everywhere. The Stag Lord may "
"be gone, but there's still much trouble in your lands. Robbing and killing "
"on the roads...\""
msgstr ""
"{n}에쿤은 시무룩해 보입니다.{/n} \"재앙이다. 모든 곳에 말이다. 숫사슴 군주는 사라졌을 지 몰라도, 아직 이 땅엔 많은 문제가 "
"있다. 도둑질이나 노상강도라든지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0005_Text
#. Speaker : Ekun_Companion
msgctxt "dd7190f6-9740-4dbe-b350-52e9786aac3f"
msgid ""
"\"You must do something. Protect the people. My advice? A curfew. Announce a "
"time of night when people remain inside their homes. My guard will maintain "
"order.\""
msgstr ""
"\"뭔가를 해야 한다. 사람들을 보호해라. 내 조언? 통행 금지령을 내려라. 사람들이 밤 동안에는 거리를 돌아다니지 못 하게 만들어라. "
"우리 경비대가 질서를 지킬 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0007_Text
#. Speaker : Regongar_Companion
msgctxt "59f03c29-1b67-4eb8-94ad-9bdb2eb51fb2"
msgid ""
"{n}The half-orc grins darkly.{/n} \"Sometimes your subjects make me wonder. "
"They live in the {g|Stolen Lands}Stolen Lands{/g}. They've always got plenty "
"of bandits around, but they start families here, they raise their kids – all "
"while they keep complaining that the bandits won't let them live! And they "
"don't ever leave!\""
msgstr ""
"{n}하프오크는 음침하게 미소짓습니다.{/n} \"가끔 네 백성들 때문에 궁금해진단 말이지. {g|Stolen Lands}도둑맞은 "
"땅{/g} 에 살면서 말이야, 주변에 도적들이 천지인데 여기서 가족을 꾸리고 아이를 기르지. 계속해서 도적들이 자기네들을 살게 내버려두지 "
"않는다면서 말이야! 떠나지도 않으면서!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0008_Text
#. Speaker : Regongar_Companion
msgctxt "12c9a087-569a-4d3f-a2e3-67325d4811c8"
msgid ""
"\"Well, the peasants finally got to me with all their nagging about bandits. "
"But I'm fine, I can handle it. I've just got to try to ignore them. I've "
"already lived here long enough to understand: as soon as the locals realize "
"no one is going to protect them, they'll stop whining and take up arms "
"themselves. Give them a chance to show their worth!\""
msgstr ""
"\"뭐, 백성들이 결국 내게 찾아와서 도적떼 얘기로 징징거리더군. 그래도 괜찮아. 내가 다 해결할 수 있어. 난 그냥 저들을 무시할 "
"생각이야. 이미 이해할 수 있을 정도로 여기 충분히 살았단 말씀. 백성들이 아무도 자신들을 구해주지 않는다는 걸 알게 되면, 투정을 그만 "
"두고 스스로 무기를 꼬나쥘 거야. 백성들에게 자신들의 가치를 보여줄 기회를 주게 되는 거지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0012_Text
#. Speaker : Capital_Kesten
msgctxt "f59f7fc5-0dfb-4362-8c11-a7ad9906e457"
msgid "\"Will do, {mf|Your Grace|Your Grace|Your Highness|Your Highness}!\""
msgstr "\"그리 하겠습니다, {mf|영주님|영주님|전하|전하}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0013_Text
#. Speaker : Ekun_Companion
msgctxt "a27fe94b-af72-46c2-b433-26fb41755dc9"
msgid "\"You know what's best.\""
msgstr "\"어떤 게 최선의 방법인지는 너도 잘 알 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0014_Text
#. Speaker : Regongar_Companion
msgctxt "9aa8d399-fdc4-4125-86ff-283eeaba9608"
msgid ""
"{n}Regongar cringes with disgust.{/n} \"So the guards will loiter in the "
"streets rather than clearing out the bandits' lairs? Your barony won't go "
"far at this rate!\""
msgstr ""
"{n}레곤가르는 혐오감에 움찔거립니다.{/n} \"경비대가 도적 소굴을 청소하는 대신 거리를 돌아다니게 하겠다고? 이런 식으로 계속 가면 "
"남작령도 얼마 못 버틸 거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0016_Text
#. Speaker : Ekun_Companion
msgctxt "e8314e03-d820-4b0d-8767-1c73aaf05c40"
msgid "\"Right. I will give the order.\""
msgstr "\"좋다. 명령을 내리겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0017_Text
#. Speaker : Regongar_Companion
msgctxt "7201f066-a7f8-4ba7-854e-b6e4d24e3576"
msgid ""
"\"At least your subjects won't be crowding the streets like useless sheeple."
"\""
msgstr "\"적어도 백성들이 이리저리 쓸모없이 휘둘리기만 하는 양떼처럼 거리에 가득차진 않겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0018_Text
#. Speaker : Capital_Kesten
msgctxt "c7e12711-85a0-42f4-8afe-80b4bfd85fe9"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}! We can't just... "
"lock people up in their houses and hope that the violence will stop!\" {n}"
"Kesten shakes his head, but decides not to continue.{/n}"
msgstr ""
"\"{mf|영주님|영주님|전하|전하}! 이렇게... 그냥 사람들을 가둬놓고 폭력이 끝나기를 기다릴 수는 없습니다!\" {n}케스턴은 "
"머리를 흔들지만, 계속 말을 이어나기로 결심합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0019_Text
#. Speaker : Ekun_Companion
msgctxt "b54ce66b-479e-44ac-b522-fbc84faae13e"
msgid ""
"\"They will fail. And when the criminals finish robbing people on the "
"streets, they'll start breaking into their homes. This is a bad decision.\""
msgstr "\"실패할 거다. 범죄자들이 거리에서 사람들 주머니를 다 털고 나면, 이젠 집으로 쳐들어 가겠지. 나쁜 선택이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0020_Text
#. Speaker : Regongar_Companion
msgctxt "79b40a6b-998c-4290-adaf-913591c59a9d"
msgid ""
"\"Exactly.\" {n}Regongar cracks his fingers, as if he's preparing for a "
"fight himself.{/n}"
msgstr "\"바로 그거야.\" {n}레곤가르는 손가락을 우두둑 거리며, 마치 싸움을 준비하는 듯 합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0021_Text
#. Speaker : Capital_Kesten
msgctxt "13332787-ebf7-44d6-a71c-979c5b337ebe"
msgid ""
"\"I will immediately start looking for new guards, and dispatch units to the "
"farthest reaches of the {mf|barony|barony|kingdom|kingdom}.\""
msgstr "\"즉시 새 경비병을 물색하고, {mf|남작령|남작령|왕국|왕국} 의 가장 멀리 떨어진 국경까지 병사를 배치하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0022_Text
#. Speaker : Ekun_Companion
msgctxt "baf6c203-56bd-439a-953c-17b02568f38f"
msgid ""
"\"I will announce time of night when the people should keep themselves "
"inside.\""
msgstr "\"밤에 사람들이 집에 머물러야 할 시간을 알리도록 하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0023_Text
#. Speaker : Regongar_Companion
msgctxt "4c9d53c3-fb70-4e81-b0d1-a8c0e9c5eead"
msgid ""
"\"Like I said – nothing. You'll see, these petitioners can handle everything "
"themselves.\""
msgstr "\"말 했지만, 의미 없어. 곧 알게 될 거야. 이 청원자들이 스스로 할 수 있다는 걸 말이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank2/Cue_0024_Text
#. Speaker : Capital_Kesten
msgctxt "4ae11a43-de26-40d1-934f-2f407cd52371"
msgid "{n}Kesten shakes his head, but doesn't argue.{/n}"
msgstr "{n}케스턴은 머리를 흔들지만, 따지고 들진 않습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Answer_0011_Text
msgctxt "a418773b-ddaf-487a-89cc-bb2010864f93"
msgid ""
"{g|Stability3_2}[Choice effects]{/g} \"Set up additional guard posts and "
"keep the locals away from conflict with the fairies.\""
msgstr ""
"{g|Stability3_2}[선택 시 효과]{/g} \"경비초소를 추가로 세우고 지역 주민들로 하여금 요정들과 분쟁을 빚지 말라고 하라."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Answer_0012_Text
msgctxt "74c10527-f4fe-4d42-9880-80206e05dcf5"
msgid ""
"{g|Stability3_1}[Choice effects]{/g} \"Fairies don't attack for no reason. "
"We've invaded their lands. Help the locals pull up their roots and take them "
"to another area.\""
msgstr ""
"{g|Stability3_1}[선택 시 효과]{/g} \"요정들은 이유 없이 공격해오지 않는다. 우리가 그들의 땅을 침략한 것이다. 지역 "
"주민들이 그 자리에서 벗어나 다른 곳에 정착하도록 도우라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Answer_0013_Text
msgctxt "93622cd8-4cfc-42da-9bb8-aa9b9dd83355"
msgid ""
"{g|Stability3_3}[Choice effects]{/g} \"Wipe them out, Regongar. I don't want "
"to hear about these fairies again.\""
msgstr "{g|Stability3_3}[선택 시 효과]{/g} \"모두 쓸어버리라, 레곤가르. 이 요정 이야기는 더 듣고싶지 않다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Answer_0014_Text
msgctxt "030cc1ff-2160-4322-9e17-139314e8e1c3"
msgid "\"Make your own decision.\""
msgstr "\"알아서 결정하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0001_Text
#. Speaker : Capital_Kesten
msgctxt "29fce6f8-3423-460e-94db-bf5c8b04afc9"
msgid ""
"{n}Kesten is as black as thunder.{/n} \"{mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}, there's a disaster in {g|Narlmarches}Narlmarches{/g}"
". Suddenly a group of fairies came out of the forest to the edge of the "
"swamps. They're a vicious tribe – fitting their reputation perfectly.\""
msgstr ""
"{n}케스턴은 천둥이라도 맞은 듯 어둡습니다.{/n} \"{mf|영주님|영주님|전하|전하}, {g|Narlmarches}날마치{/g}에 "
"재앙이 나타났습니다. 갑자기 요정 무리가 늪 끝의 숲에서 나타났습니다. 놈들은 그 평판에 걸맞듯 포악한 족속들입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0002_Text
#. Speaker : Capital_Kesten
msgctxt "e52dafc1-a144-402b-a669-eda0b90269cb"
msgid ""
"\"Until recently they merely toyed with the locals. – Pounded on their roofs "
"at night, threw their boots up in the trees. But now they've started "
"spoiling the cattle and trying to lure the people into the woods! We need to "
"put an end to this, {mf|Your Grace|Your Grace|Your Highness|Your Highness}!\""
msgstr ""
"\"최근까지는 그저 지역 주민들을 가지고 장난을 칠 뿐이었습니다. 밤에 지붕을 요란하게 두드린다던지, 주민들의 신발을 나무에 "
"던진다던지요. 하지만 지금은 가축을 오염시키고 사람들을 숲으로 꾀고 있습니다! 이 일을 해결해야 합니다, "
"{mf|영주님|영주님|전하|전하}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0003_Text
#. Speaker : Capital_Kesten
msgctxt "25ce28e5-28bd-4f7c-bae3-a1b45048de83"
msgid ""
"\"We shouldn't just go attack the fairies, of course. – They haven't done "
"anything yet that would warrant such a response. But increasing the guard "
"would help.\""
msgstr ""
"\"물론, 이 요정들을 그저 공격해서는 안됩니다. 아직 그들이 공격받을 만한 짓을 하지는 않았습니다. 하지만 경비대를 늘리는 것은 도움이 "
"될 겁니다. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0004_Text
#. Speaker : Ekun_Companion
msgctxt "a84c8be4-e795-47ef-a447-59aba295bd6f"
msgid ""
"{n}Ekun nods at you.{/n} \"We have fairies, {name}. They wander the "
"{g|Narlmarches}Narlmarches{/g}, along the border. They refuse to leave. They "
"say the lands are theirs. Your people are frightened.\""
msgstr ""
"{n}에쿤다요가 고개를 끄덕입니다.{/n} \"요정이다, {name}. {g|Narlmarches}날마치{/g} 국경을 따라서 떠돌지. "
"그리고 떠나기를 거부하더군. 날마치가 자기들 땅이라면서 말야. 사람들이 겁에 질렸어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0005_Text
#. Speaker : Ekun_Companion
msgctxt "f78cf9d8-7dea-46d4-8939-bcd22116ec7d"
msgid ""
"{n}The man cringes and shakes his head.{/n} \"The fairies are an old tribe. "
"They have their rules, and we must honor them. Order your subjects to leave "
"this land or there will be war.\""
msgstr ""
"{n}에쿤다요가 움츠린채로 머리를 흔듭니다.{/n} \"요정은 오래된 족속이야. 그들만의 법이있고, 우리는 존중해줘야 돼. 백성들에게 "
"날마치를 떠나라고 말해 아니면 전쟁이 일어날거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0006_Text
#. Speaker : Capital_Kesten
msgctxt "ae645009-4195-44b9-a123-84d63ebec5b0"
msgid "\"Certainly, {mf|Your Grace|Your Grace|Your Highness|Your Highness}.\""
msgstr "\"알겠습니다, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0007_Text
#. Speaker : Regongar_Companion
msgctxt "dbe797f1-f77e-446d-9f8a-12f80268b791"
msgid ""
"{n}Regongar smiles angrily.{/n} \"Good news finally! My guys were getting "
"bored at their posts, but we've just now gotten word about a chance to "
"stretch our bones!\""
msgstr ""
"{n}레곤가르가 성나서 웃습니다.{/n} \"마침내 좋은 소식이야! 내 부하들은 초소에서 지겨워 하는 중이었는데, 지금 드디어 몸을 풀 "
"기회라고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0008_Text
#. Speaker : Regongar_Companion
msgctxt "c8abf772-de8d-41a3-aa17-dca4b3fedda7"
msgid ""
"\"Some fairies showed up near the settlements in the "
"{g|Narlmarches}Narlmarches{/g}. – And not just showed up. They're pushing "
"our people back, saying they're driving invaders from their lands. Do you "
"know what that means?\""
msgstr ""
"\"요정 몇이 {g|날마치}날마치{/g} 정착지 근처에 나타났어. 그저 나타나기만 한게 아니야. 자기네들 땅에서 침략자를 물리치는 "
"거라면서 우리 백성들을 몰아내고 있다고. 이게 무슨 의민지 알아?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0009_Text
#. Speaker : Regongar_Companion
msgctxt "58b169c6-924a-4464-a561-9321c850eeb2"
msgid ""
"{n}Regongar squints.{/n} \"It means we can gather a team and crush those "
"pipsqueaks. Give this job to my guys – and you can forget about this problem "
"forever!\""
msgstr ""
"{n}레곤가르가 눈을 가늘게 뜹니다.{/n} \"사람들을 모아서 이 쓰레기들을 박살내줄수 있다는 의미지. 내 부하들한테 일을 맡겨줘, "
"그럼 이 일을 신경 끌수 있을꺼야. 영원히!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0015_Text
#. Speaker : Ekun_Companion
msgctxt "37951875-84b3-42e4-94ca-6f9eb56ad391"
msgid ""
"\"Senseless. People will die. Fairies too. And for what? A piece of land?\" "
"{n}Ekun shakes his head.{/n}"
msgstr ""
"\"무의미하군. 사람들이 죽을 거야. 요정도 죽을거고. 무엇을 위해? 땅 한 줌 때문에?\" {n}에쿤다요가 고개를 내젓습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0016_Text
#. Speaker : Regongar_Companion
msgctxt "4432a5a1-3125-4a8c-bbc0-76bd53beeafe"
msgid ""
"{n}Regongar sighs disappointedly.{/n} \"And we could have had so much fun..."
"\""
msgstr "{n}레곤가르가 실망한 듯 소리냅니다..{/n} \"재미 좀 볼수 있었을텐데...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0017_Text
#. Speaker : Capital_Kesten
msgctxt "b8d4e603-07a1-4f67-8f4e-efa80124afa4"
msgid ""
"\"You know, I'm loyal to you forever, but the people won't like this "
"decision. To be honest, I don't like it either, but an order is an order.\""
msgstr ""
"\"알다시피, 나는 너에게 영원히 충성할거야, 하지만 사람들이 이 결정을 좋아하진 않겠지. 솔직히 말해서, 나도 맘에 들지는 않지만 "
"명령은 명령이니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0018_Text
#. Speaker : Ekun_Companion
msgctxt "8d6f80b9-d279-40b6-9773-790e8c879dc5"
msgid "{n}Ekun silently nods.{/n}"
msgstr "{n}에쿤다요가 소리없이 끄덕입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0019_Text
#. Speaker : Regongar_Companion
msgctxt "e67fa0b3-763a-457a-9223-499f09e46713"
msgid ""
"{n}Regongar's smile turns into a grin.{/n} \"So we put our tail between our "
"legs and run? From freaking fairies?!\" {n}The words of the half-orc turn "
"into an angry growl.{/n}"
msgstr ""
"{n}레곤가르가 활짝 웃기 시작합니다.{/n} \"그래 꼬리를 말고 도망가자고? 이 요정 병신들로부터?!\" {n}하프오크의 말이 성난 "
"으르렁소리로 바뀝니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0020_Text
#. Speaker : Regongar_Companion
msgctxt "35e7eb65-5340-46b6-a23f-34765fd47940"
msgid "\"Ha ha ha ha hmmmmm... I knew you would appreciate my plan!\""
msgstr "\"하 하 하 하 흐으음... 네가 내 계획을 좋아할줄 알고 있었지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0023_Text
#. Speaker : Capital_Kesten
msgctxt "c48de852-1529-4e66-b282-ceeffbee797b"
msgid ""
"\"I assure you, {mf|Your Grace|Your Grace|Your Highness|Your Highness}, the "
"guard won't allow any fighting. And we won't allow some fairies to terrorize "
"your subjects.\""
msgstr ""
"\"경비대가 어떤 다툼도 허용하지 않을 것이라고 보장드립니다, {mf|영주님|영주님|전하|전하}. 그리고 요정들이 우리 백성들을 겁에 "
"질리게 하는 일도 없을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0024_Text
#. Speaker : Ekun_Companion
msgctxt "322f67cc-4743-4d4a-ba3f-68058197a0ce"
msgid ""
"\"I will lead the people away from there. I know of a place they could move "
"to, near {g|Lake Silverstep}Silverstep{/g}.\""
msgstr ""
"\"사람들이 거기서 멀어지도록 이끌겠어. {g|Lake Silverstep}실버스텝{/g} 근처로 사람들이 이동할 장소도 알고 있고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank3/Cue_0025_Text
#. Speaker : Regongar_Companion
msgctxt "5abd17d1-a843-4d53-9014-ca4751f8cc81"
msgid "{n}Regongar's eyes flare.{/n} \"Let the hunt begin!\""
msgstr "{n}레곤가르의 눈이 빛납니다.{/n} \"사냥을 시작하지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Answer_0005_Text
msgctxt "e0175f0b-b0e9-4d32-bbfc-3483a90eeec6"
msgid "\"The decision is yours.\""
msgstr "\"선택은 너의 몫이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Answer_0016_AlignmentShift.Description
msgctxt "7f9b93e3-7185-4cfd-b2c8-e9ea7b1054d0"
msgid ""
"Ordered that the love potion swindler be fined just like any other swindler."
msgstr "사랑의 묘약 사기꾼에게 본래 사기꾼이 받는 벌금을 부과했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Answer_0016_Text
msgctxt "99d46221-e8e4-4f4f-a032-829e28603d8c"
msgid ""
"{g|Stability4_2}[Choice effects]{/g} \"Let us follow the letter of the law. "
"The miscreant shall be fined.\""
msgstr "{g|Stability4_2}[선택 시 효과]{/g} \"법대로 할 것이다. 범법자는 벌을 받아야 한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Answer_0017_AlignmentShift.Description
msgctxt "b355068e-6fd4-458e-8d61-15c12be2191c"
msgid ""
"Ordered that the love potion swindler be punished stricter than usual — "
"thrown into jail."
msgstr "사랑의 묘약 사기꾼에게 평소보다 엄한 처벌을 부과하여 감옥에 수감했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Answer_0017_Text
msgctxt "b27982be-a947-4df1-be49-55d330ece6f6"
msgid ""
"{g|Stability4_1}[Choice effects]{/g} \"This is more than simple deception. "
"Throw the villain in jail.\""
msgstr "{g|Stability4_1}[C선택 시 효과]{/g} \"이건 단순한 사기가 아니다. 악당을 감옥에 수감해라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Answer_0018_AlignmentShift.Description
msgctxt "c61d11bd-5616-4462-bf1f-adc044efcb76"
msgid "Ordered that the love potion swindler be executed."
msgstr "사랑의 묘약 사기꾼을 처형했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Answer_0018_Text
msgctxt "302dfc01-39c8-4ffe-bb5a-339bbd477158"
msgid "{g|Stability4_3}[Choice effects]{/g} \"Execute the fool.\""
msgstr "{g|Stability4_3}[선택 시 효과]{/g} \"그 멍청이를 처형해라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Answer_0019_Text
msgctxt "f78af692-4d37-4b02-9329-76472f6c085c"
msgid ""
"{g|Stability4_4}[Choice effects]{/g} [Gain 4000 gold] \"We agree. The search "
"for the merchant's daughter shall be the guards' top priority.\""
msgstr ""
"{g|Stability4_4}[선택 시 효과]{/g} [4000골드를 얻는다] \"동의한다. 경비대의 최우선 사항은 상인의 딸을 찾는 "
"것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Answer_0020_Text
msgctxt "876afc68-80a2-497c-a63f-3eb05c525cd6"
msgid ""
"\"The guard already has their orders. This case shall be dealt with like any "
"other.\""
msgstr "\"경비대는 이미 받고 있는 명령이 있다. 이 사건은 다른 사건과 마찬가지로 다뤄질 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Answer_0039_Text
msgctxt "da964079-f6c4-4a0f-8b88-07af912c4330"
msgid "\"You can decide this yourself.\""
msgstr "\"당신 스스로 판단하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Conf_EkunRefusal_Text_String
#. Speaker : Ekun_Companion
msgctxt "091e3cca-1e15-4a64-96e7-1861ad2de127"
msgid ""
"{n}After some hesitation, he finally goes on:{/n} \"{name}. We both want to "
"protect this land. But when we consider the best ways to do this, we see "
"different things. It would be better if you find a different Warden. My "
"place is in the forest, with a bow in my hands.\""
msgstr ""
"{n}몇번의 망설임후에, 그가 입을 열기 시작합니다:{/n} \"{name}. 우리 둘 모두 이 땅을 지키고 싶어하지. 하지만 땅을 "
"지키기 위한 최선의 방법을 찾을 때, 우리 둘은 견해가 다른 것 같군. 다른 감시관을 찾는게 좋을거야. 나는 활을 들고 숲으로 가겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Conf_KestenRefusal_Text_String
#. Speaker : Capital_Kesten
msgctxt "479cfa89-8cf3-4ff4-99eb-f024ec783000"
msgid ""
"\"There's something else, Your {mf|Grace|Grace|Highness|Highness}… I've "
"thought about this for a long time, and I must give up my position. I cannot "
"guarantee the safety of those whose lives have been entrusted to me, if I "
"don't understand the decisions of my superiors.\" {n}Shuffling his feet, "
"Kesten adds:{/n} \"I am sorry, Your {mf|Grace|Grace|Highness|Highness}.\""
msgstr ""
"\"다른 문제가 있습니다, {mf|영주님|영주님|전하|전하}…. 많은 고민을 했습니다만, 감시관을 그만둬야 할 것 같습니다. 저를 "
"신뢰하는 사람들의 안전을 보장할 수 없습니다, 만약 상급자가 제 결정을 이해하지 못한다면 말입니다.\" {n}발을 이리저리 움직이며, "
"케스턴이 덧붙입니다:{/n} \"죄송합니다, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Conf_RegongarRefusal_Text_String
#. Speaker : Regongar_Companion
msgctxt "7fda93e1-4b15-408b-8e5d-c3327d09349f"
msgid ""
"\"If I were you, I'd start looking for a new Warden. I'm not doing this any "
"more. All I ever do here is get angry and run pointless errands. It's not "
"like you need me here either. – You make all the calls yourself anyway. Long "
"story short, if you wanna go stomp some goblins or fry a troll or two, just "
"whistle. But as for being a warden, you can count me out.\""
msgstr ""
"\"내가 너라면, 신참 감시관을 찾기 시작하겠어. 이 일을 더이상 못해먹겠다고. 내가 이 자리에서 한 것이라고는 화를 내거나 무의미한 "
"심부름 뿐이었어. 그리고 너도 더이상 내가 필요하지 않은 것 같군, 어찌됐건 모든 결정을 니 마음대로 하잖아? 간단히 말해서, 네가 "
"고블린이나 트롤 한 두 마리를 구워버리고 싶다면, 날 불러. 하지만 감시관을 찾는다면, 난 빼줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "be77a732-4ca3-45d1-8884-db549cc5ccc8"
msgid ""
"{n}Ekun's face is grim.{/n} \"Caught a swindler. He tried to pour a love "
"potion into a merchant daughter's drink. Her family is well-known, and the "
"case is unusual... The people are watching, and his guilt is already proven. "
"But the judges don't know how to punish him. You must decide.\""
msgstr ""
"{n}에쿤다요의 얼굴이 암울해집니다.{/n} \"사기꾼을 잡았어. 상인의 딸이 먹을 음료수에 사랑의 묘약을 부을려고 하더군. 여자의 "
"가족은 유명하지만, 사건이 특이해서... 사람들이 지켜보고 있어. 그 자의 죄는 이미 증명됐고. 하지만 판사가 어떻게 처벌해야 할지 "
"갈피를 못잡고 있어. 네가 결정해야만 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0002_Text
#. Speaker : Capital_Kesten
msgctxt "e3dadecb-517c-4a79-93c3-97525f765080"
msgid ""
"\"A minor court case has been the talk of the capital, Your "
"{mf|Grace|Grace|Highness|Highness}. A swindler was caught trying to slip a "
"love potion to the daughter of an important merchant. The court has found "
"him guilty – but decreed that since the situation is so unusual, only you "
"could pronounce a just sentence.\""
msgstr ""
"\"사소한 법정 사건이 수도 사람들 입에 오르락 내리고 있습니다. {mf|영주님|영주님|전하|전하}. 유력상인의 딸에게 사랑의 묘약을 "
"먹이려던 사기꾼이 붙잡혔습니다. 법정은 그가 유죄임을 증명했습니다. 하지만 사건의 특이성을 선언했기때문에, 오직 당신만이 판결을 내릴 수 "
"있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0003_Text
#. Speaker : Regongar_Companion
msgctxt "b65113bd-42be-4fa9-870a-a04bff71d305"
msgid ""
"{n}Regongar's footsteps boom throughout the throne room.{/n} \"The damn "
"swindlers, {name}! They're like lice – no matter how many you catch, "
"tomorrow there will be even more! My boys caught another scoundrel a few "
"days back. This one was trying to slip a love potion into the daughter of a "
"local moneybag.\""
msgstr ""
"{n}레곤가르의 발자국 소리가 알현실에 울려퍼집니다.{/n} \"망할 사기꾼들, {name}! 그놈들은 이하고 똑같아. 네가 오늘 얼마나 "
"잡던간에, 내일이면 더 많아지지! 부하들이 몇일전에 또다른 한량을 붙잡았어. 이 놈은 지역 상인의 딸에게 사랑의 묘약을 먹이려고 했지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0004_Text
#. Speaker : Ekun_Companion
msgctxt "314183de-4f3d-4d89-a8a0-5c4ff7038618"
msgid ""
"\"The usual punishment is a fine. But in this case... too soft. My "
"suggestion – a prison sentence.\""
msgstr "\"일반적인 처벌도 괜찮겠지. 하지만 이 사건의 경우... 너무 유하군. 내 제안은 감옥행이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0006_Text
#. Speaker : Capital_Kesten
msgctxt "11e49038-1af9-4dde-96bc-e53db9be01c2"
msgid ""
"\"The established punishment for fraud in the "
"{mf|barony|barony|kingdom|kingdom} is a fine. To my mind, this case does not "
"warrant a departure from established procedure. The case is not so "
"exceptional as the locals imagine.\""
msgstr ""
"\"사기꾼은 {mf|남작령|남작령|왕국|왕국}에서 원래 벌금형이야. 내 생각엔 이 사건도 별 다른 것 같지는 않군. 주민들이 생각하는 "
"만큼 별난 사건은 아니야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0007_Text
#. Speaker : Regongar_Companion
msgctxt "6dd4aaba-b5f6-48c5-bd5f-80f8026be61d"
msgid ""
"{n}Regongar chuckles.{/n} \"Anyhow, we caught the poor sod, the court found "
"him guilty, and all we need from you is a sentence. His plan was devious and "
"cold, and everybody in the capital is watching this case. Unless you show "
"the thieving scum around here who's boss, they'll just keep at it. I suggest "
"a public execution. Love can make you lose your head, ha ha hmmm.\""
msgstr ""
"{n}레곤가르가 낄낄 웃습니다..{/n} \"어찌됐건, 이 불쌍한 놈을 붙잡았고, 법원은 유죄를 증명했어, 필요한건 오직 판결이야. 그 "
"놈의 계획은 부정직하고 냉혹했어 그리고 수도의 모든 사람이 이 사건을 지켜보고 있다고. 네가 이 도둑 쓰레기에게 누가 두목인지 보여주지 "
"않으면, 모두가 잊어먹겠지. 공개 처형을 추천하는 바야. 자비는 네 머리를 잃게 만들지, 하하 흠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0008_Text
#. Speaker : Ekun_Companion
msgctxt "d7ebdafa-6357-44cd-a369-50220817d8a6"
msgid ""
"\"The daughter of a wealthy merchant has gone missing. Stolen, most likely. "
"Her father wants us to send out our best to search for her.\" {n}After a "
"moment, Ekun adds:{/n} \"He's hinted that he'll reward us for our trouble.\""
msgstr ""
"\"유력상인의 딸은 실종상태야. 정확히 말하자면, 납칟아했지. 그녀의 아버지는 우리 최정예가 딸을 수색해주기를 바래..\" {n}잠시 "
"후에, 에쿤다요가 덧붙입니다.:{/n} \"이 골칫거리를 처리하면 보상해주겠더군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0009_Text
#. Speaker : Capital_Kesten
msgctxt "a975b857-a819-4c3e-a455-967c33447fd7"
msgid ""
"\"Rumors are flying around the capital, Your "
"{mf|Grace|Grace|Highness|Highness}. The daughter of a well-known merchant "
"has gone missing. Some say that she might have been kidnapped. Her father is "
"calling on us to send every man and woman we have to go search for her – and "
"promises that he will generously repay his debt of gratitude.\""
msgstr ""
"\"수도에서 소문이 떠돌고 있습니다 {mf|영주님|영주님|전하|전하}. 유력 상인의 딸이 실종 중입니다. 혹자는 그녀가 납치된거라고 "
"하더군요. 모든 인력을 투입해서 딸을 찾아야만 한다고 그녀의 아버지가 요구했습니다. 그렇게 하면 그가 보상은 넉넉히 해주겠다고 "
"약속하면서요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0010_Text
#. Speaker : Regongar_Companion
msgctxt "ee0f8a78-a371-4a3d-a163-ec6923d924d1"
msgid ""
"\"Another day, another debacle, {name}! Someone's whisked away the daughter "
"of a local moneybag. The trader swears 'he'll make us all rich' if we send "
"every guard in town out in search of his precious little girl.\""
msgstr ""
"\"또 다른 날에, 또 다른 사건이야, {name}! 어떤 자식이 지역 상인의 딸을 채갔다고. 무역업자가 맹세하더군 '우리 모두를 부자로 "
"만들어준다'라고, 만약 우리가 소중한 딸을 찾기위해서 모든 경비대를 차출해준다면 말야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0011_Text
#. Speaker : Ekun_Companion
msgctxt "4e3dde2a-adc0-45ef-9487-f7e274f15aa4"
msgid ""
"\"We should agree to help. We'll have to deal with the situation regardless. "
"If we agree, we might also fill our coffers.\""
msgstr "\"도와줘야만 해. 이 사태를 어떤식으로던지 해결할거야. 그렇게하면, 돈도 좀 받을 수 있겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0012_Text
#. Speaker : Capital_Kesten
msgctxt "5fd3001d-8143-4f56-930c-dbf2e208f221"
msgid ""
"\"There are several reasons we should accept his offer. I've learned that he "
"has friends in high places in the trade guild…\""
msgstr "\"제안을 받아들여야만 하는 여러 이유들이 있습니다. 제가 알기론 그의 친구들이 무역조합 고위직에 여럿있다더군요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0013_Text
#. Speaker : Regongar_Companion
msgctxt "f15447fc-3413-4980-b5d3-0b98b5582310"
msgid ""
"\"To tell you the truth, it wouldn't surprise me if she ran off herself. As "
"for the merchant – what's there to talk about? What should we care? Seems "
"like the idiot just forgot his place. 'He'll make us all rich'?! Who the "
"hell does he think he is?! We spend more on feasts in a week than he earns "
"in a year!\""
msgstr ""
"\"솔직히 말하면, 딸내미가 그냥 도망쳤다고 해도 놀라울 건 없어. 상인에 대해 말하면, 뭐 말할 게 더 있나? 우리가 왜 신경써야 "
"되지? 멍청한 놈이 자기 분수를 잊은 모양이군. '우리를 모두 부자로 만들어준다'고?! 자기가 뭐라도 된다고 생각하나?! 우리 일주일 "
"식비가 그놈 년수익보다 더 크다고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0021_Text
#. Speaker : Ekun_Companion
msgctxt "1ffcd18b-32b7-4fb3-bdf1-d6147823222f"
msgid "{n}Ekun slowly nods.{/n} \"I understand. It will be done.\""
msgstr "{n}에쿤다요가 천천히 끄덕입니다.{/n} \"이해했다. 그렇게 될거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0022_Text_String
#. Speaker : Ekun_Companion
msgctxt "439b20de-2b76-4fa8-b3a0-007b5c832e0e"
msgid ""
"{n}Ekun wrinkles his forehead.{/n} \"This will not teach him anything. Nor "
"everyone else.\""
msgstr "{n}에쿤다요가 이마를 찡그립니다.{/n} \"이렇게 한다고 그가 교훈을 배우진 못할거야. 다른 그 누구도 마찬가지고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0023_Text
#. Speaker : Ekun_Companion
msgctxt "c32bd484-9dbd-4774-8852-d70343d7a354"
msgid "\"Wise choice.\""
msgstr "\"현명한 선택이군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0024_Text
#. Speaker : Ekun_Companion
msgctxt "23b03743-0386-40d4-92b5-ac6d113a2383"
msgid "\"Then I'll send him to prison. I'm glad that you trust me, {name}.\""
msgstr "\"그럼 그놈을 감옥으로 보내겠어. 네가 날 믿을 줄 알았어, {name}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0025_Text
#. Speaker : Capital_Kesten
msgctxt "57ae31af-11ba-46b9-bd20-4ceb33c822c7"
msgid "\"In that case, the criminal shall be fined and set free.\""
msgstr "\"그런 경우에, 범죄자는 벌금을 내고 풀려날거야.\\"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0026_Text
#. Speaker : Regongar_Companion
msgctxt "ceb42bb9-710b-4b15-ac9b-e74c10fc60ca"
msgid ""
"\"Good thinking. Why would you even need me otherwise? Hah. Long story "
"short, we're hanging the bastard.\""
msgstr "\"좋은 생각이야. 네가 필요하기는 해? 하. 간단히 말해, 우리는 이 개자식을 목매달거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0027_Text_String
#. Speaker : Capital_Kesten
msgctxt "1ba4547d-ace4-41e3-ab69-39db7656ad9a"
msgid ""
"{n}Kesten presses his lips together.{/n} \"As you command, Your "
"{mf|Grace|Grace|Highness|Highness}. However, it is my duty to inform you "
"that this punishment does not befit the crime.\""
msgstr ""
"{n}케스턴은 입술을 다뭅니다.{/n} \"분부대로 하겠습니다, {mf|영주님|영주님|전하|전하}. 하지만, 이 처벌이 범죄에 걸맞는 "
"것이 아님을 알려드리는 것이 제 의무입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0028_Text
#. Speaker : Regongar_Companion
msgctxt "8c169be9-c482-4bc5-907e-a811df7331d2"
msgid "\"Nice! I'll get right to it.\""
msgstr "\"좋습니다! 당장 시행하도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0030_Text
#. Speaker : Regongar_Companion
msgctxt "c8b95385-d117-4a55-b42d-e5b598124730"
msgid "\"That should do it, I guess. Your wish is my command, ha ha hmmm.\""
msgstr "\"그렇게 해야겠지. 당신이 원하는 대로 다 하겠어, 하 하 흠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0031_Text
#. Speaker : Capital_Kesten
msgctxt "fdfeb9d0-5980-4bce-bb44-06cde01a853d"
msgid "\"I'll inform the court, Your {mf|Grace|Grace|Highness|Highness}.\""
msgstr "\"법원에 알리겠습니다, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0032_Text_String
#. Speaker : Regongar_Companion
msgctxt "190f98b2-685b-493f-91a1-a487eb3cf95d"
msgid ""
"\"Damn it, {name}. These rabble don't understand mercy. They'll just figure "
"we have no spine.\""
msgstr "\"젠장, {name}. 이 폭도놈들은 자비를 이해하지 못해. 우릴 그저 강단없다고 생각할거라고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0033_Text
#. Speaker : Ekun_Companion
msgctxt "623c30a9-9a51-4af4-b1e3-90543c1fa817"
msgid "{n}Ekun shortly nods.{/n}"
msgstr "{n}에쿤다요가 짧게 끄덕입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0034_Text_String
#. Speaker : Ekun_Companion
msgctxt "8c990c49-5872-4192-879d-4408eb51d47a"
msgid "\"We're missing a good opportunity.\""
msgstr "\"우린 좋은 기회를 놓치고 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0035_Text
#. Speaker : Capital_Kesten
msgctxt "90d77a72-da66-41cb-afd3-1776acccdddc"
msgid ""
"\"It shall be done, Your {mf|Grace|Grace|Highness|Highness}.\" {n}Kesten "
"bows, holding his hand against his chest.{/n}"
msgstr "\"그렇게 될 겁니다, {mf|영주님|영주님|전하|전하}.\" {n}케스턴이 손을 가슴에 둔채로 조아립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0036_Text_String
#. Speaker : Regongar_Companion
msgctxt "6ee5fb84-81ac-4a5e-a1da-44f85d3942c7"
msgid ""
"\"What?! This city is chock-full of killers and thugs. All sorts of scum "
"that need to be kept in check. And now you want us to drop everything just "
"to chase after some runaway kid?!\""
msgstr ""
"\"뭐라고?! 이 도시는 살인자들과 깡패들로 가득차있어. 이 온갖종류의 쓰레기들을 감시해야 한다고. 근데 도망간 꼬맹이 하나 쫓자고 이 "
"모든걸 내려놓으라고?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0037_Text_String
#. Speaker : Capital_Kesten
msgctxt "24ef3e1b-d88f-4bfc-b378-2878a3fb2e35"
msgid ""
"{n}Kesten shakes his head.{/n} \"The merchants should not be underestimated. "
"Their power in the {g|Stolen Lands}Stolen Lands{/g} is great…\""
msgstr ""
"{n}케스턴이 머리를 흔듭니다.{/n} \"상인들을 과소 평가해선 안됩니다. {g|Stolen land}도둑맞은 땅{/g}에서 그들의 "
"힘은 강력합니다…\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0040_Text
#. Speaker : Ekun_Companion
msgctxt "34551231-5ef6-42c2-a85f-616ecfd0b021"
msgid "\"I'll order the guard to focus on the search.\""
msgstr "\"수색에 집중하도록 경비대에게 명하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0041_Text
#. Speaker : Capital_Kesten
msgctxt "62a3d569-c677-4862-9e3e-2058625f26b4"
msgid ""
"\"As you command, Your {mf|Grace|Grace|Highness|Highness}. I will tell the "
"merchant that his case is in good hands.\""
msgstr "\"명령대로 하겠습니다, {mf|영주님|영주님|전하|전하}. 사건에 힘 써보겠다고 상인에게 전달하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0042_Text
#. Speaker : Regongar_Companion
msgctxt "23019a59-3c82-449b-a47b-2252742fca69"
msgid "\"Nice. Can't wait to tell the pig where he can stuff his gold…\""
msgstr "\"좋아. 그 돼지한테 어디에 돈을 박아놨냐고 묻는 순간이 기다려지는군\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank4/Cue_0043_Text
#. Speaker : Regongar_Companion
msgctxt "da3cef73-9f4c-4013-b9e1-25c752d128df"
msgid ""
"\"Not sure why he went to all the trouble though. The dowry is all right, of "
"course. But the girl herself… Let's just say I'd rather be earning my bread "
"crawling around stinking dungeons through the rat droppings.\""
msgstr ""
"\"그가 이 모든 문제를 왜 겪었는지는 잘 모르겠지만. 물론, 지참금은 괜찮아. 하지만 여자 쪽은... 냄새나는 던전 속 쥐가 먹다 "
"남겨서 굴러다니는 빵을 얻는게 더 낫다고 말해두지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Answer_0008_Text
msgctxt "627296b1-3d54-443f-aac6-161885181a51"
msgid ""
"{g|Stability5_2}[Choice effects]{/g} \"Such beasts have no place in my "
"lands. They must be eradicated.\""
msgstr "{g|Stability5_2}[선택 시 효과]{/g} \"이 짐승들은 내 땅에서 있을 곳이 없다. 그들은 제거되야만 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Answer_0009_Text
msgctxt "bf6078b0-deeb-4f55-8eae-93dc18aa45a6"
msgid ""
"{g|Stability5_1}[Choice effects]{/g} \"We should strive to live in harmony "
"with nature – as much as is reasonable. Henceforth, these lands are "
"protected by my decree.\""
msgstr ""
"{g|Stability5_1}[선택 시 효과]{/g} \"우린 합리적인 선에서 자연과 조화를 이루면서 살아야 한다. 이제부터 이 땅은 내 "
"법령에 의해 보호받는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Answer_0010_Text
msgctxt "8d90e4aa-c67c-43af-ba0b-ad118e7919d4"
msgid "\"You are the Warden of these lands. I trust your judgment.\""
msgstr "\"당신은 이 땅의 감시관이다. 당신 판단을 믿는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Answer_0020_Text
msgctxt "c30031f0-d3dc-4d67-9471-52c040f21962"
msgid ""
"{g|Stability5_3}[Choice effects]{/g} \"A bulette hunt? Sounds interesting. "
"Do as you like, Regongar.\""
msgstr "{g|Stability5_3}[선택 시 효과]{/g} \"불렛 사냥? 흥미롭군. 뜻대로 하라, 레곤가르.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "5db5eb46-f338-4822-b08d-be88b69352f1"
msgid ""
"\"A strange quarrel. I don't understand. There's a region where bulettes "
"live. Guards and hunters kill them, so that it's safe. But some are "
"displeased.\""
msgstr ""
"\"이상한 다툼이군. 이해가 안가. 불렛들이 살고 있는 지역이 있다. 경비대와 사냥꾼들이 불렛을 죽이고, 따라서 안전하지. 하지만 "
"누군가는 탐탁치 않아해\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Cue_0002_Text
#. Speaker : Capital_Kesten
msgctxt "51149e11-6653-4c5f-8796-84d9053d7f29"
msgid ""
"\"Your {mf|Grace|Grace|Highness|Highness}, a decision has to be made "
"regarding the bulettes that inhabit one of your regions. The guard and a "
"local hunting club seek them out and kill them, as they should. But the, "
"uhhh... scholarly community of the {mf|barony|barony|kingdom|kingdom} has "
"objected to this.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 영토 내 불렛서식지에 대한 판단이 필요합니다. 그들의 의무대로 경비대와 지역 사냥꾼 모임이 불렛을 "
"찾아내서 사살하고 있습니다. 그런데, 어... {mf|남작령|남작령|왕국|왕국} 학자 모임에서 이를 반대하고 있습니다 .\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Cue_0003_Text
#. Speaker : Regongar_Companion
msgctxt "f559bba5-9f46-4123-889d-5a0c6c69d617"
msgid ""
"{n}Regongar talks fast, his face beaming with excitement.{/n} \"Just wait "
"until you hear this, {name}! A rare, exotic type of bulette lives in one of "
"our provinces. However, they're almost extinct, so the bookworms across the "
"{mf|barony|barony|kingdom|kingdom} want us to declare their lands a natural "
"reserve. The locals, as you can imagine, want to rip them all to shreds – "
"the landsharks and the know-it-alls too, ha ha! Everyone is looking to us "
"for a solution, and I kept thinking – what the hell are we supposed to do "
"about this? And then it hit me!\""
msgstr ""
"{n}레곤가르가 환희에 찬 표정으로 빠르게 말 합니다.{/n} \"이것 좀 들어봐, {name}! 희귀하고 특이한 불렛이 우리 영토내에서 "
"살고있어. 근데 이놈들은 거의 멸종 상태여서, {mf|남작령|남작령|왕국|왕국} 책벌레들이 불렛 서식지를 자연 보존하기를 원해. 지역 "
"주민들은, 너도 상상이 가겠지만, 불렛들은 모두 조각내버리기를 바래. 지역유지들도 말야, 하 하! 모두가 해결해주기를 바라고 있어. "
"그리고 나는 이 문제를 도대체 어떻게 할지 계속 생각했는데 말야? 딱 좋은 방법을 생각해냈지! \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Cue_0004_Text
#. Speaker : Ekun_Companion
msgctxt "7c0afd84-3510-417a-9e65-5091807e73ae"
msgid ""
"\"Scholars of some sort. They say that a rare type of bulette lives there, "
"one that is almost extinct. They want us to forbid hunting in these parts. "
"{n}Ekun shakes his head.{/n} \"It's a strange quarrel. You know what I will "
"say. The monsters must die.\""
msgstr ""
"\"학자 몇명들 말야. 거거에 멸종 직전인 희귀 불렛들이 살고 있다고 하더군. {n}에쿤다요가 머리를 내젓습니다.{/n} \"이상한 "
"다툼이야. 너는 내가 무슨 말을 할지 알겠지. 괴물은 죽어야만 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Cue_0005_Text
#. Speaker : Capital_Kesten
msgctxt "19ea1857-b4b5-4fcb-b6e4-94df7a6f11ee"
msgid ""
"\"Some zoologist has declared that these bulettes are a rare species… or "
"subspecies… Long story short, they only live around these parts and nowhere "
"else. Your {mf|Grace|Grace|Highness|Highness}, the scholars ask that we take "
"these lands under our protection and outlaw the killing of these bulettes. "
"However, I firmly believe that the beasts should be eradicated. The safety "
"of local peasants outweighs other concerns.\""
msgstr ""
"\"이 불렛들이 희귀종이거나 희귀 아종이라고 단언했습니다. 간단히 말하면, 이 종들이 오직 이 지역에서만 서식하고 딴 곳에는 없다고 "
"하더군요. {mf|영주님|영주님|전하|전하}, 학자들이 그 땅을 보호구역으로 두고 불렛을 죽이는 것을 불법으로 하자고 요청합니다. 하지만 "
"괴물들은 멸종되야 한다고 단호히 믿습니다. 지역 주민들의 안전이 우리들의 최우선입니다. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Cue_0006_Text
#. Speaker : Regongar_Companion
msgctxt "d83ac398-c5a6-41b3-b4be-73b0fd03899c"
msgid ""
"\"We should declare the area a royal hunting ground! Then we wait a few "
"months, let those bad boys get fatter and breed some young… and go hunt "
"ourselves some bulettes! Just imagine, their hides hanging along the throne "
"room wall! Or are you supposed to do something with their claws and teeth or "
"something? Whatever. So, who's your most cunning, most irreplaceable "
"advisor? Ha ha ha hmmmm!\" {n}Regongar's laughter booms, and sparks jump "
"across his fingers.{/n}"
msgstr ""
"\"그 지역을 왕실 사냥터로 삼자고! 그리고 몇 달 좀 기다린 후 이 불렛들이 살 찌고 새끼를 좀 치면, 그 때 우리가 이 놈들을 "
"사냥하는거야! 알현실 벽에 걸려있는 그놈들 가죽좀 생각해봐! 아니면 발톱, 이빨, 다른 어떤 부위던간에 생각하는 거 있어? 뭐든간에. 자 "
"이제 누가 너의 가장 머리 좋고, 가장 대체 불가능한 보좌관이지? 하 하 하 흠!\" {n}레곤가르가 박장 대소합니다. 그리고 그의 "
"손가락에서 전류가 흐릅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Cue_0013_Text_String
#. Speaker : Regongar_Companion
msgctxt "bddb447e-e924-407a-b469-857af242f9b3"
msgid ""
"{n}Regongar is dumbfounded, and the excitement on his face slowly falls.{/n} "
"\"What the… Why would you let some lousy guards have all the fun? There we "
"go again, another brilliant plan out the window…\""
msgstr ""
"{n}레곤가르가 할 말을 잃습니다. 그리고 그의 얼굴에서 즐거운 표정이 서서히 사라집니다..{/n} \"아니.... 왜 얼빠진 경비들 "
"몇이 즐기도록 하는거야? 또 시작이야, 기가막힌 내 계획이 창문밖으로 내던져져...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Cue_0014_Text_String
#. Speaker : Ekun_Companion
msgctxt "29993a0f-c254-4be1-ac9b-2686d7408404"
msgid ""
"{n}Ekun's nostrils flare, but his voice is steady and cold.{/n} \"A "
"dangerous whim. I hope we don't come to regret it.\""
msgstr ""
"{n}에쿤다요가 콧김을 내뱉습니다. 그러나 그의 목소리는 안정되고 차분합니다.{/n} \"위험한 변덕이군. 우리가 이 결정을 후회하지 "
"않길 바래.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Cue_0015_Text_String
#. Speaker : Capital_Kesten
msgctxt "cf4bb18e-5b46-4a88-8782-b4f55d605ee3"
msgid ""
"{n}Kesten grits his teeth and answers in a muffled voice:{/n} \"As you "
"command, Your {mf|Grace|Grace|Highness|Highness}.\""
msgstr "{n}케스턴이 이를 악물고 소리죽여 대답합니다.:{/n} \"명대로 하겠습니다, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Cue_0016_Text
#. Speaker : Regongar_Companion
msgctxt "af75f6d8-0fc5-491e-a848-03a125fe8d2d"
msgid ""
"\"Ha. We'll see what you say when one of those cute little buggers comes to "
"say 'hi' while you're sleeping in your tent… I know we're going to run into "
"one of them sooner or later – and then I'll have my hunt. But whatever. The "
"main thing is we're not letting anyone else kill them all off.\""
msgstr ""
"\"하. 언젠가 니가 자는 텐트에 이 귀엽고 작은 새끼들이 와서 '안녕'이라고 했을때 뭐라고 말할지 지켜봐야겠군... 늦건 빠르건 우리가 "
"이놈들을 만나게 될 거란걸 난 알아. 그리고 사냥을 시작하겠지. 주안은 우리가 그 누구라도 이 놈들을 죽이지 못하도록 하는거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Cue_0017_Text
#. Speaker : Ekun_Companion
msgctxt "87c38c69-28c3-4a2a-9b8b-7968a7a15a71"
msgid ""
"\"Good. I'll order the guards to take care of the bulettes, and offer a "
"reward to any other hunters.\""
msgstr "\"좋아. 경비들한테 이 불렛들을 처리하도록 명령하지. 그리고 다른 사냥꾼들한테도 보상을 제시하겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Cue_0018_Text
#. Speaker : Capital_Kesten
msgctxt "5594f212-7c1d-4112-acbc-b4bd08b19850"
msgid ""
"{n}Kesten gives a short nod.{/n} \"The guard will hunt them down. Any who "
"volunteer to help will be rewarded.\""
msgstr "{n}케스턴이 짧게 끄덕입니다.{/n} \"경비대는 즉시 사냥을 시작하겠습니다. 돕고자 자원하는 이들도 보상을 받을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Cue_0019_Text
#. Speaker : Regongar_Companion
msgctxt "ea4ea259-4fcc-4698-9cf7-a55a461850a3"
msgid ""
"\"Great!\" {n}Grinning, Regongar claps and rubs his hands together.{/n} "
"\"This is going to be fun!\""
msgstr "\"좋았어!\" {n}미소지으면서, 레곤가르는 박수를 치고 손을 비빕니다.{/n} \"이거 재밌어질거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank5/Cue_0023_Text
#. Speaker : Regongar_Companion
msgctxt "4c1dd42b-7c4f-4a2b-9471-5d03daf749c0"
msgid ""
"\"Perfect! I can't wait to shoot one of these things! You're supposed to "
"shoot them, right? Or do you use a spear? Whatever, we'll improvise!\""
msgstr ""
"\"완벽해! 이 놈들 중 하나를 쏴버리는걸 참을수가 없구만! 너도 이 놈들을 쏴버리겠지, 그렇지? 아니면 창을 사용할건가? 뭐든간에 손에 "
"있는걸로 하자고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Answer_0008_Text
msgctxt "6b3386f7-fa9e-4b2d-8730-a2e0d150ca29"
msgid ""
"{g|Stability6_1}[Choice effects]{/g} [Pay 200 BP] \"We should focus on "
"causes, not consequences. I command you to begin renovating the slums.\""
msgstr ""
"{g|Stability6_1}[선택 시 효과]{/g} [200 BP 지불] \"결과가 아닌 원인에 주목해야 한다. 빈민가 재개발을 명한다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Answer_0009_Text
msgctxt "17d509a7-82a5-40cb-9647-1f90a28c87e7"
msgid ""
"{g|Stability6_2}[Choice effects]{/g} \"Order your men to patrol the slums "
"more frequently. You should check everyone who enters or leaves.\""
msgstr ""
"{g|Stability6_2}[선택 시 효과]{/g} \"부하들에게 빈민가 순찰을 더 자주 하도록 하라. 누가 드나드는지 전부 파악하여야 "
"한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Answer_0010_Text
msgctxt "89820e3e-71b9-48e2-8b3b-56735d279ded"
msgid ""
"{g|Stability6_3}[Choice effects]{/g} [Pay 50 BP] \"There's no place in my "
"capital for this breeding ground of crime and disease. The slums must be "
"removed.\""
msgstr ""
"{g|Stability6_3}[선택 시 효과]{/g} [50 BP 지불] \"수도에 범죄와 질병의 온상은 필요없다. 빈민가를 없애도록 "
"하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Answer_0011_Text
msgctxt "38393ee9-85c2-4ac5-89c2-521431a94ebe"
msgid ""
"{g|Stability6_4}[Choice effects]{/g} \"Such is life in the city. It can't be "
"helped, so we shouldn't agonize over it.\""
msgstr ""
"{g|Stability6_4}[선택 시 효과]{/g} \"도시에 산다는건 그런 것이다. 어쩔 수 없는 일이니 고민할 필요가 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Answer_0012_Text
msgctxt "cc6d39b6-2c2c-41f6-bc26-650fccd11005"
msgid "\"Settle this matter as you see fit.\""
msgstr "\"이 문제를 그대 생각대로 해결하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "d15cde12-98ce-46fc-b4d9-28d298fcfa54"
msgid ""
"\"But now there's a new concern. I've heard several complaints about the "
"slums on the outskirts of the capital. They say that only thieves and "
"beggars live there. They say that we should tear down their huts and send "
"them away, and the city would be cleaner and safer for it.\" {n}Ekun shakes "
"his head.{/n} \"But the poor have nowhere to go. They'll just find a new "
"place and build new huts, even shabbier than before.\""
msgstr ""
"\"새로운 걱정거리가 있다. 수도 근교 슬럼에서 여러가지 요청있다더군. 오직 도둑과 거지들만이 거주한다고 애기들하지. 이 움집을 "
"철거해버리고 도둑과 거지들을 쫓아내버리자는거야. 그렇게 하면 도시가 훨씬 깔끔해지고 안전해진다는 거지. \" {n}에쿤다요가 머리를 "
"흔듭니다..{/n} \"하지만 가난한 사람은 어디에도 갈 곳이 없어. 이 사람들은 그저 새 장소를 찾아서 새 집을 지을거야. 그 전 "
"집보다도 추레한 것으로..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0002_Text
#. Speaker : Capital_Kesten
msgctxt "51f4e4b8-ab42-4031-b5c0-0ef64354e1ca"
msgid ""
"\"There is other news as well. Due to the capital's rapid growth and the "
"inflow of people from the provinces, the outskirts of our capital have "
"become a real slum. Streams of sewage crisscross the streets, hordes of rats "
"and disease abound… What's worse – robbers, pickpockets, fences and the "
"other dregs of society have found a home there.\""
msgstr ""
"\"다른 소식도 있어. 수도의 급속한 성장과 지역 주민들의 유입때문에, 수도 근교지역이 슬럼가가 됐어. 오물덩이들이 거리에 천지고, 쥐 "
"떼랑 질병이 가득하지... 더욱 심각한 건. 강도와 소매치기가 둥지를 치고 다른 사회 찌꺼기들도 집을 찾았단 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0003_Text
#. Speaker : Regongar_Companion
msgctxt "ff36d834-d285-47c0-8207-9be5054b74b2"
msgid ""
"\"Oh, by the way, there's something else. The people of the capital are "
"complaining – again! This time it's the slums on the outskirts of the city. "
"They stink to high heaven, hordes of rats piling out 'em every night, and "
"every thief and pickpocket in town has a hideout there – or so they say.\""
msgstr ""
"\"오, 그나저나. 다른 일도 있어. 수도 사람들이 또 다시 불평을 시작했다고! 이번에는 도시 외곽 슬럼 구역일이야. 그 구역 악취가 "
"너무 심하고 쥐 떼가 밤마다 쏟아져 나온다는군, 그리고 마을의 모든 소매치기들은 거기 은신처를 두고있고, 사람들이 말하기로는 그래..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0004_Text
#. Speaker : Ekun_Companion
msgctxt "bf8b4df9-975a-4a72-b0c2-2ed83aa730cb"
msgid ""
"\"My advice – lift up the slums from the mud. Hire those who live there as "
"builders. Teach them to dig wells and waste pits, to pave the roads and put "
"up street lamps. Then, once they're done cleaning their district, hire them "
"to start work on the next one. Give these people jobs and decent homes, and "
"there won't be a thief among them.\""
msgstr ""
"\"내 조언은 진창인 빈민가를 변화시키는 것이다. 그곳에 사는 자들을 목수로 고용하자. 그들에게 우물과 매립지를 만드는 법을 가르치고, "
"길을 닦는 방법과 가로등을 설치하는 방법도 가르쳐야지. 그들이 살던 거리의 정리가 끝나면, 다른 거리에서 일을 시키면 된다. 그들에게 "
"직업과 좋은 집을 마련해준다면, 도둑질을 하는 사람은 사라지겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0005_Text
#. Speaker : Capital_Kesten
msgctxt "ca864be2-7445-4f04-8065-89f206648e9e"
msgid ""
"\"I suggest we double the guard in the slums and place restrictions on who "
"can come and go, and when. It's much cheaper than trying to clean them up, "
"and more effective than simply tearing them down.\""
msgstr ""
"\"저는 빈민가의 경비병을 두 배로 늘리고 통금시간과 통행 가능한 사람을 정하는 것을 제안합니다. 빈민가를 정리하는 것보단 훨씬 싸고, "
"파괴하는 것보단 효율적입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0006_Text
#. Speaker : Regongar_Companion
msgctxt "38543ae4-f4e2-4692-8161-9851cec6d1bb"
msgid ""
"\"And as far as the last part, that's definitely true. Me and my boys would "
"have a much easier time if you let us just tear those dirty shacks down, and "
"drive off all the scum that lives there. Of course, some think the district "
"could be cleaned up... but they're just crazy. You could spend a mountain of "
"gold building it up. In a few years it'll just turn back into a slum again.\""
msgstr ""
"\"마지막에 얘기했던 부분은 사실이지. 저 오두막을 그냥 부숴버리고 그곳의 쓰레기들을 전부 내쫓게 해준다면 나와 내 부하의 일이 편해질 "
"거야. 몰론 그곳을 깨끗하게 청소하는것이 가능하다고 생각하는 자들도 있어. 하지만 그건 말도 안되는 이야기야. 청소하는데는 산더미같은 "
"금화를 써야 할거야. 하지만 몇년 지나면 다시 빈민가가 되어 있겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0013_Text
#. Speaker : Ekun_Companion
msgctxt "afb290a5-de0c-48a4-86e7-d24f3b354034"
msgid "\"I will begin at once.\""
msgstr "\"즉시 시작하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0014_Text_String
#. Speaker : Capital_Kesten
msgctxt "12692bea-6115-4a3d-9254-ec1ded830760"
msgid ""
"\"As you wish, Your {mf|Grace|Grace|Highness|Highness}. I must inform you, "
"however, that this decision will prove costly.\""
msgstr "\"명을 받들겠습니다, {mf|영주님|영주님|전하|전하}. 하지만 많은 자금이 필요할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0015_Text_String
#. Speaker : Regongar_Companion
msgctxt "0bf513bb-492f-47d1-ba89-0e16fbce5339"
msgid ""
"\"Well, there we go again. Working for the commoners instead of making them "
"work for us…\""
msgstr "\"흠... 또야. 평민들에게 일을 시키는게 아니라 우리가 평민들을 위해 일을 한다니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0016_Text
#. Speaker : Ekun_Companion
msgctxt "30f93f45-fa40-4d9e-a6b4-643edf6800ca"
msgid "\"It will be done.\""
msgstr "\"그렇게 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0017_Text
#. Speaker : Capital_Kesten
msgctxt "e3e8433e-28b8-42c9-8987-24511ecd65df"
msgid ""
"\"Certainly, Your {mf|Grace|Grace|Highness|Highness}. I should have "
"suggested this a long time ago.\""
msgstr "\"몰론입니다, {mf|나리|나리|전하|전하}. 진작에 말씀드릴걸 그랬군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0018_Text
#. Speaker : Regongar_Companion
msgctxt "4807e9de-1e66-4e44-a098-fbbd6186475f"
msgid ""
"\"Hm. That should do it just as well. I'll tell my boys to get busy. Maybe "
"this will finally teach them a thing or two about life on the streets…\""
msgstr ""
"\"흠. 그것도 나쁘지 않지. 부하들에게 바빠질 거라고 얘기해둬야겠군. 이제 그놈들에게 길거리에서 산다는게 어떤 건지 좀 알려줄 수 "
"있겠는걸...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0019_Text_String
#. Speaker : Ekun_Companion
msgctxt "d5488a07-1404-4297-a934-d0fac067ce06"
msgid ""
"{n}Ekun gazes at you with a deep frown.{/n} \"A harsh decision. That's not "
"the same thing as a strong one.\""
msgstr "{n}에쿤은 매우 찡그린 얼굴로 당신을 바라봅니다.{/n} \"가혹한 처사로군. 강한것과 가혹한 것은 달라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0021_Text
#. Speaker : Regongar_Companion
msgctxt "d6d8a000-66d7-4138-82be-45bd9bd59134"
msgid ""
"{n}The half-orc rubs his hands in anticipation.{/n} \"Well said, ha ha! It's "
"high time me and the boys got a little exercise…\""
msgstr ""
"{n}하프오크가 기대감에 차서 손바닥을 문지릅니다.{/n} \"말 잘했군, 하하! 나랑 부하들이 운동 좀 하지 딱 좋은 때야...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0022_Text_String
#. Speaker : Ekun_Companion
msgctxt "47ce67d4-aced-4973-ab38-9c588eba63c4"
msgid "\"A rash decision. We'll reap its consequences soon enough...\""
msgstr "\"경솔한 판단입니다. 곧 결정의 여파가 닥치게 되겠죠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0023_Text_String
#. Speaker : Capital_Kesten
msgctxt "5401eb83-b51a-4ecf-8f93-9e75c5a7a894"
msgid ""
"\"As you wish, Your {mf|Grace|Grace|Highness|Highness}\". {n}After some "
"hesitation, Kesten continues:{/n} \"However, tensions are rising. I hope we "
"do not come to regret this decision.\""
msgstr ""
"\"명을 받들겠습니다, {mf|나리|나리|전하|전하}. {n}케스턴은 잠시 주저하다 말을 잇는다.{/n} \"하지만 긴장이 고조되고 "
"있습니다. 이 결정을 후회하지 않기를 바를 뿐입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0024_Text
#. Speaker : Regongar_Companion
msgctxt "369bc060-82d3-41b1-b937-146ca29916da"
msgid ""
"\"Ha! Spot on. What do we care? The commoners can squabble all they want.\""
msgstr "\"하! 맞는 말이군. 우리가 신경쓸게 뭐있어? 평민들끼리 알아서 다투고 있으라지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0025_Text
#. Speaker : Ekun_Companion
msgctxt "e79acfaa-e24f-4805-abb8-d72b360c2437"
msgid ""
"{n}Ekun nods.{/n} \"We'll commence the renovation. The outskirts will become "
"a fine place to live, just like any other district.\""
msgstr "{n}고개를 끄덕이며{/n} \"재개발을 하도록 하지. 도시 외곽도 다른 곳처럼 살기 좋은 곳이 될거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0026_Text
#. Speaker : Capital_Kesten
msgctxt "361b4c46-d954-455a-b6ff-0200d1f2431c"
msgid ""
"\"As you command, Your {mf|Grace|Grace|Highness|Highness}. I'll double the "
"patrols and ensure all entrances are watched day and night.\""
msgstr ""
"\"명령대로 하겠습니다, {mf|영주님|영주님|전하|전하}. 순찰을 배로 늘리고 모든 출입로를 밤낮으로 빠짐없이 감시하도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0027_Text
#. Speaker : Regongar_Companion
msgctxt "6d3e7d3d-2748-4bbb-af47-279382293508"
msgid ""
"\"Sure thing. I'll rid the capital of this filth… It's been a while since me "
"and the boys had some fun.\""
msgstr "\"좋아. 수도에서 이 더러운 것을 쓸어버리지... 나랑 내 부하들이 재미본지도 꽤 오래 됐다고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0030_Text
#. Speaker : Regongar_Companion
msgctxt "02fd8552-3cf4-404b-86b5-b5d4bb103fcd"
msgid ""
"\"Great news! More and more bulettes are being spotted in that region, "
"what's it called… I heard that some trader saw a landshark as big as a "
"house! About time we paid them a visit, ha ha ha hmmm…\""
msgstr ""
"\"좋은 소식이야! 더 많은 불렛들이 그 지역에서 발견됐다고 해, 뭐라고 하더라... 듣기로는 거래상이 집채만한 땅상어를 봤다더군! "
"근시일내에 한번 들러보자고, 하하하 흠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0031_Text
#. Speaker : Capital_Kesten
msgctxt "bb47f6e1-6012-48d3-a27d-1d41e4e1d4f3"
msgid ""
"\"There have been new sightings of bulettes, Your "
"{mf|Grace|Grace|Highness|Highness}. The creatures are becoming more and more "
"numerous – as well as bigger and more aggressive. One of the guards swears "
"he saw one as big as a hut…\""
msgstr ""
"\"새로운 불렛들이 발견됐다고 합니다, {mf|영주님|영주님|전하|전하}. 이 생물들의 숫자가 점점 많아지고 있습니다. 또한 더 커지고 "
"있고 더 공격적으로 변하고 있습니다. 우리 경비 중하나가 집채만한 녀석을 봤다고 맹세하더군요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0032_Text
#. Speaker : Ekun_Companion
msgctxt "4000c02e-4fe6-442c-9bff-516d789dc30c"
msgid ""
"\"Those bulettes. They are gone. All dead. But the peasants have begun to "
"complain about other wild animals and bandits. It seems that without the "
"bulettes, the other threats have become more numerous. But of course wolves "
"and bandits are better than giant monsters…\""
msgstr ""
"\"이 불렛들 말이야. 사라졌다. 다 죽었어. 하지만 사람들이 다른 야생동물이나 도적들에 대해 불평하고 있다. 불렛이 사라지니까, 다른 "
"위협이 더 많아지는 것 같군. 물론 늑대나 도적이 거대 괴물보단 낫지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0033_Text
#. Speaker : Capital_Kesten
msgctxt "3ef153a0-d7ba-47be-9361-5ac1ddc73b93"
msgid ""
"{n}Kesten looks grim.{/n} \"I've received new reports about those bulettes, "
"Your {mf|Grace|Grace|Highness|Highness}. We managed to get rid of them, but "
"this only led to an increase in attacks from other dangerous beasts – and "
"even bandits! It seems that the bulettes had been keeping them at bay...\""
msgstr ""
"{n}케스턴이 침울해 보입니다.{/n} \"이 불렛들에 대한 새로운 보고를 받았습니다, {mf|영주님|영주님|전하|전하}.이 놈들을 "
"제거했습니다만, 이게 다른 위험한 야수의 공격을 늘린 것 같습니다. 도적떼도 말입니다! 불렛들이 이 놈들을 붙잡아놨던것 같습니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0034_Text
#. Speaker : Ekun_Companion
msgctxt "d6eb43ea-9285-462f-9029-af59174f944b"
msgid ""
"\"Bad news. The hunters are terrified of a giant bulette, a really mean one. "
"It's giving the locals a lot of trouble. You were warned.\""
msgstr ""
"\"나쁜 소식이야. 사냥꾼들이 거대 불렛한테 겁을 먹었어, 진짜 큰 놈 이야. 지역이 이 놈 때문에 골머리를 썩고있어. 내가 경고했듯이."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0035_Text
#. Speaker : Regongar_Companion
msgctxt "a1ddeee7-0759-41ae-b831-ed22fdfa3106"
msgid ""
"{n}Regongar is beaming.{/n} \"Remember those rare bulettes? Well not long "
"ago, the locals finally killed them all off… but now they're constantly "
"under attack from bears, wolves and even bandits! They've taken the "
"bulettes' place! Ah ha ha ha ha hmmmmm!\""
msgstr ""
"{n}레곤가르의 얼굴에 화색이 만면합니다.{/n} \"그 희귀 불렛들 기억나? 얼마 전에, 지역 주민들이 모두 죽였었지... 그런데 지역 "
"주민들이 이제 곰, 늑대들한테 계속 공격받는다더군. 심지어 도적들한테도! 이 것들이 불렛의 자리를 꿰찼어! 아 하 하 하 하 흐으음!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank6/Cue_0036_Text
#. Speaker : Capital_Kesten
msgctxt "26c9243d-f7a7-4c0c-92fd-67682e37fca8"
msgid "\"As you command, Your {mf|Grace|Grace|Highness|Highness}.\""
msgstr "\"분부대로 하겠습니다, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Answer_0004_Text
msgctxt "5bed79c0-f684-495f-89f2-18a71e08618e"
msgid ""
"{g|Stability7_1}[Choice effects]{/g} \"We'll take the initiative. Gather "
"your troops and drive the barbarians from my lands.\""
msgstr ""
"{g|Stability7_1}[선택 시 효과]{/g} \"선제 공격을 가한다. 부대를 소집해서 야만인들을 내 땅에서 몰아내라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Answer_0009_Text
msgctxt "fe9899fb-9b5d-491b-a82c-f039f086c4cf"
msgid ""
"{g|Stability7_2}[Choice effects]{/g} \"I wouldn't be surprised if that was "
"exactly what they wanted us to do. — Start chasing them across the hills. "
"Double the guard in all the raided regions. We shall defend ourselves.\""
msgstr ""
"{g|Stability7_2}[선택 시 효과]{/g} \"우리에게 정확히 원한게 그게 아니었다면 좀 놀랐을 것이다. 언덕 너머로 추격을 "
"시작하라. 약탈당한 지역의 경비를 두배로 늘린다. 우리 스스로를 지킬 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Answer_0010_Text
msgctxt "441dee23-c5f7-43ed-a06b-2a0f6f69c7ad"
msgid "\"This choice is yours.\""
msgstr "\"그대가 선택하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "d17751d9-d38c-4299-9363-c97e8e4e934d"
msgid ""
"\"Still there are many barbarians near the borders. They attack trade "
"caravans. Raid remote villages. Something must be done.\""
msgstr "\"아직도 다수의 야만인들이 국경 근처에 있다. 그 자들이 대상을 공격해. 외딴 마을들을 약탈하고. 뭔가 해야만 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0002_Text
#. Speaker : Capital_Kesten
msgctxt "08df64d7-ebd1-4e05-b296-4ac1b0737b14"
msgid ""
"\"Your Highness... Our border regions inform us that remnant groups of "
"barbarians are still carrying out raids, burning villages and taking "
"peasants as slaves. We must put an end to this.\""
msgstr ""
"\"전하... 국경지대에서 야만인 잔당들이 여전히 약탈을 일삼고, 마을을 불태우며 농민들을 노예로 끌고 간다고 알려왔습니다. 이 일을 "
"끝내야만 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0003_Text
#. Speaker : Regongar_Companion
msgctxt "ae05b01b-1dc2-4969-bd58-a0c871a747e5"
msgid ""
"\"Tough shit today, {name}. The barbarians are still pecking at the border "
"regions. They've gathered into raiding parties and started harassing our "
"peasants. Of course the peasants are completely incapable of standing their "
"ground, so they keep jumping onto the corpse pile. – Leaving us fewer and "
"fewer subjects and servants each day. How dare they, the traitorous bastards!"
"\""
msgstr ""
"\"개 같은 날입니다, {name}. 야만인들이 국경지대를 갉아먹고 있습니다. 놈들이 약탈단을 조직하고 우리 농민들을 괴롭히고 있습니다. "
"당연히 농민들은 땅을 지킬 능력이 없고, 시체 더미만 쌓여가고 있습니다. 하루가 다르게 신하와 하인들이 우리를 떠나고 있습니다. 어떻게 "
"그럴수가 있는지, 이 더러운 개자식들!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0005_Text
#. Speaker : Ekun_Companion
msgctxt "e0712518-b15b-436c-bb19-bf721ca8498a"
msgid ""
"\"We can strengthen the guard in the regions. But how can we know where "
"they'll strike next? We'd have to strengthen the guard everywhere. This "
"would be expensive, and difficult. I suggest we gather the troops and search "
"for them. Scour the woods and strike first.\""
msgstr ""
"\"국경 지대 경비를 강화할 수 있다. 하지만 놈들이 다음엔 어디를 공격할지 어떻게 알지? 결국 모든 곳의 경비를 강화해야 할 거다. "
"이건 비싸고, 어려운 일이 되겠지. 병력을 모아 놈들을 찾는 게 낫다. 숲을 샅샅이 뒤져서 선제 공격을 가하자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0006_Text
#. Speaker : Capital_Kesten
msgctxt "79fb1e04-ba25-4466-adff-bfe4057d4059"
msgid ""
"\"We could perform a preemptive strike. – Send out a regiment, scour all the "
"nooks and crannies that the barbarians might be hiding in... However, this "
"would be risky, and it would mean playing the game by their rules. They'd "
"never face us in a decisive battle, but instead lure our troops deeper and "
"deeper into unknown territory. They'd force us to fight in constant "
"skirmishes, and wear us down until our soldiers simply started deserting en "
"masse.\""
msgstr ""
"\"우리가 선제 공격을 가할 수도 있습니다. 연대를 보내서 야만인들이 숨어있을만한 모든 구석구석을 샅샅이 살펴보는 겁니다... 하지만, "
"이 방법은 위험할 뿐 아니라 놈들의 규칙대로 게임을 하겠다는 뜻이기도 합니다. 놈들은 결정적인 전투에서는 절대 우리와 맞서지 않고 대신 "
"우리 병력을 점점 더 깊은 알려지지 않은 영역으로 끌고 들어갈 겁니다. 우리에게 끊임없는 교전을 강요하고, 우리 병사들이 지쳐 나가 "
"떨어져 탈영할 때까지 괴롭히겠죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0007_Text
#. Speaker : Regongar_Companion
msgctxt "58fe8864-2e18-4f32-8573-2e64e586e217"
msgid ""
"\"So I see two solutions here: a bad one and a glorious one. We could send a "
"whole regiment of guards to the villages, tell them to dig in and hope that "
"the barbarians run out of the woods and stick themselves on their spears. "
"Or, we could do it like this: I'll gather a small squad of my best boys and "
"girls, and assign 'em to a captain I know — a smart fellow, thinks on his "
"feet. They'll scour the area, find these blasted savages, and rip off their "
"hairy... well, they'll know what kinds of things are best to rip off. So, "
"what say you? Not a bad idea, eh?\""
msgstr ""
"\"자 두 가지 방법이 있어: 나쁜 것과 영광스러운 것. 우리 경비대 전체를 마을에 보낼 수 있어. 경비들로 하여금 마을에 처박히게 한 "
"다음에 야만인놈들이 나무를 다써서 창이 부족하길 기도하는 거지. 이렇게 할 수도 있어. 내 최고의 부하들로 별동대를 만들자 그리고 자기 "
"앞가림 할 줄 아는 똑똑한 녀석을 대장으로 임명하는거야. 별동대는 지역을 뒤져서, 이 망할 야만인놈들을 찾을거야 그리고 야만인 놈들의 "
"털을 밀어버리겠지... 자, 이 별동대는 해치울 줄 아는 놈들일거라고. 자, 어때? 나쁜 계획은 아니지, 어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0011_Text
#. Speaker : Ekun_Companion
msgctxt "49484396-2c5e-4d12-8038-8c5588008eb3"
msgid ""
"\"I'll take a squad of my best hunters to the border. We'll strike from "
"nowhere and crush the Kellids.\""
msgstr "\"최고의 사냥꾼들을 국경에 보낸다. 우리는 보이지 않는 곳에서 공격할 것이고 켈리드 야만인들을 부술 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0012_Text
#. Speaker : Capital_Kesten
msgctxt "47b04677-caa6-4fa1-a91b-766edee27795"
msgid ""
"\"In that case, I'll increase the number of guards in our the border "
"settlements. We'll see how the savages like to fight real warriors instead "
"of unarmed peasants.\""
msgstr ""
"\"그렇다면, 우리 국경 정착지의 경비 인원을 늘린다. 야만인들이 비무장한 농민 상대로 어떻게 진정한 전사처럼 싸울지 지켜볼 것이다..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0013_Text
#. Speaker : Regongar_Companion
msgctxt "3f8cb5c5-ed08-40a6-94d3-32180d15b44b"
msgid ""
"{n}The half-orc's eyes light up with excitement.{/n} \"Just what I like to "
"hear, {name}. The troops will march today.\""
msgstr "{n}하프 오크의 눈이 즐거움으로 빛납니다.{/n} \"내가 듣고 싶었던 말이야, {name}. 부대는 오늘 출발할거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0014_Text_String
#. Speaker : Ekun_Companion
msgctxt "b468846a-0436-4361-97fe-4084108f479e"
msgid "{n}Ekun frowns and looks away.{/n} \"It will be done.\""
msgstr "{n}에쿤다요가 눈살을 찌푸리면서 고개를 돌립니다.{/n} \"그렇게 되도록 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0015_Text
#. Speaker : Capital_Kesten
msgctxt "01ec7aa6-a8cf-474f-81ae-a8149cefa727"
msgid ""
"{n}A grim look of satisfaction spreads across Kesten's face.{/n} \"As you "
"command, Your Highness. We'll show the savages how this land forges her men "
"and women!\""
msgstr ""
"{n}흡족스런 표정이 케스턴의 얼굴에 번집니다.{/n} \"명대로 하겠습니다, 전하. 우리 남녀를 이 땅이 어떻게 담금질 했는지 "
"야만인놈들에게 보여주겠습니다! \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0016_Text_String
#. Speaker : Regongar_Companion
msgctxt "3fea55dd-63cb-4d7b-be1d-8d48d09801e7"
msgid ""
"{n}Regongar's face turns sour.{/n} \"Defense? How exciting... Ever since I "
"was a kid I've yearned to sit in defense...\""
msgstr "{n}레곤가르의 안색이 안좋아집니다.{/n} \"방어? 흥미롭구만... 꼬맹이었을때부터 앉아서 방어하고 싶었지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0017_Text
#. Speaker : Ekun_Companion
msgctxt "cd798b32-6417-484d-ac7a-5ea0bc351180"
msgid ""
"{n}Ekun gives a short nod, his face a picture of decisiveness and "
"resolve.{/n}"
msgstr "{n}에쿤다요가 짧게 끄덕입니다. 그의 얼굴에서 단호함과 결심이 보입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0018_Text_String
#. Speaker : Capital_Kesten
msgctxt "f20a584f-7941-4181-8744-2e503c5bf732"
msgid ""
"{n}A deep shadow crosses the warrior's face.{/n} \"As you command, Your "
"Highness.\""
msgstr "{n}깊은 그림자가 전사의 얼굴을 비춥니다.{/n} \"명대로 하겠습니다, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank7/Cue_0020_Text
#. Speaker : Capital_Kesten
msgctxt "ee4dd942-0109-4f7e-95cf-22497dbdbc6d"
msgid ""
"\"My advice — strengthen the guard in the settlements along the border, and "
"fortified our position there. Then the barbarians will have to come to us... "
"and they'll be easily dealt with.\""
msgstr ""
"\"제 생각은, 국경선을 따라서 정착지 경비를 강화하고, 국경에서의 우리 위치를 공고히 하는 겁니다. 그렇게 하면 야만인들이 우리에게 "
"와야만 하겠지요... 그 다음은 쉽게 처리 할 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Answer_0008_Text
msgctxt "b9feb881-30ce-4e23-8ef3-a5877c9a34bb"
msgid ""
"{g|Stability8_1}[Choice effects]{/g} [Pay 2 BP each week] \"Sacrificing "
"safety is folly. We'll pacify the people by lowering the taxes.\""
msgstr ""
"{g|Stability8_1}[선택 시 효과]{/g} [매주 2 BP 지불] \"안전을 희생하는 것은 어리석다. 세금을 낮춰서 사람들을 "
"진정시킬 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Answer_0009_Text
msgctxt "4e6a40e4-5734-4273-b8a6-5993f5b6c4d6"
msgid ""
"{g|Stability8_2}[Choice effects]{/g} \"If such is the will of the people, "
"then we must surrender some of our control. Certain security measures will "
"simply have to be let go.\""
msgstr ""
"{g|Stability8_2}[선택 시 효과]{/g} \"만약 이것이 사람들의 의지라면, 우리 통제권의 일부를 포기해야만 한다. 안보 "
"조치의 일부는 그냥 풀어 줘야 할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Answer_0010_Text
msgctxt "74e6d70a-1017-45e8-bff2-03944206f64b"
msgid ""
"{g|Stability8_3}[Choice effects]{/g} \"We cannot allow ourselves dance to "
"the commoners' tune. Scatter the rebels and outlaw such gatherings — for "
"their own safety.\""
msgstr ""
"{g|Stability8_3}[선택 시 효과]{/g} \"일반인들의 요구에 춤춰줄수는 없다. 반동분자와 무법자의 집회를 해산시켜라. 그들 "
"스스로의 안전을 위하여.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Answer_0018_Text
msgctxt "7fc3ec04-d1e3-4c93-a528-6b79e89df1d6"
msgid ""
"{g|Stability8_4}[Choice effects]{/g} \"The guards of this kingdom have been "
"through hell and back. They deserve a raise.\""
msgstr "{g|Stability8_4}[선택 시 효과]{/g} \"왕국 경비들은 지옥을 헤쳐왔다. 급료 인상을 받을 자격이 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Answer_0019_Text
msgctxt "d8fa0c2e-b78a-4b0a-862f-1d649ab034cb"
msgid ""
"{g|Stability8_5}[Choice effects]{/g} \"A tired warrior is no use anyway. Let "
"our guardsmen enjoy the rest they so deserve.\""
msgstr ""
"{g|Stability8_5}[선택 시 효과]{/g} \"지친 전사는 쓸모가 없다. 경비들로 하여금 마땅이 받아야 할 휴식을 즐기게끔 "
"하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Answer_0020_Text
msgctxt "602e1950-ab4c-452d-ae27-a5b359aea6cf"
msgid ""
"{g|Stability8_6}[Choice effects]{/g} \"They've brought my wrath upon their "
"heads. Every man and woman who shirks their duties will be shamefully "
"discharged, and replaced with a mercenary.\""
msgstr ""
"{g|Stability8_6}[선택 시 효과]{/g} \"사람들이 화가 머리끝까지 치밀어 올랐다. 의무를 등한시한 모든 남녀는 수치스럽게 "
"퇴역한다. 그리고 이를 용병으로 대체할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Answer_0053_Text
msgctxt "7238807c-ba5c-487e-b3d7-71a78242997d"
msgid "\"I'll follow your advice.\""
msgstr "\"당신 조언대로 하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Answer_0055_Text
msgctxt "aed93888-44ef-4640-b314-3fa805e3a404"
msgid "\"I'll follow your advice.\""
msgstr "\"당신 조언대로 하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "9978c262-5073-49f9-a08a-4b0f8a8f0455"
msgid ""
"{n}Ekun's face is darker than a storm cloud.{/n} \"Big trouble, {name}. "
"People on the streets. They demand... 'a return to freedom'.\" {n}Shaking "
"his head, Ekun continues.{/n} \"They demand that we reduce the number of "
"guards, the frequency of patrols, and ban personal searches...\""
msgstr ""
"{n}에쿤다요의 얼굴이 먹구름 보다 어둡습니다.{/n} \"'큰 일이다 {name}. 거리의 사람들이. 그들이 요구하고 있어... "
"'자유'를 돌려주기를\" {n}머리를 흔들면서, 에쿤다요가 말을 잇습니다.{/n} \"우리로 하여금 경비 숫자와 정찰 빈도를 줄여달라고 "
"요구하고 있어 그리고 민간인 사찰을 중지하라고...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0002_Text
#. Speaker : Capital_Kesten
msgctxt "857fc8e0-c848-46bd-a1ac-e0f98c35cd30"
msgid ""
"{n}Kesten's voice is grim and harsh.{/n} \"It's a revolt, Your Highness. The "
"simple folk have flooded the streets. Pamphlets are scattered throughout the "
"capital. The way they put it, we're 'holding the people captive in their own "
"country'. Everything we've done to protect them is misinterpreted as "
"measures to limit their freedoms.\""
msgstr ""
"{n}케스턴의 목소리가 단호하고 거칩니다.{/n} \"반란입니다, 전하. 군중들이 거리에 몰려나왔습니다. 전단지가 수도 전체에 "
"뿌려졌고요. 그들이 말하길, 우리가 '자국민을 국가의 인질로 삼고있다'라고 합니다. 국민을 지키기 위해 했던 우리의 모든 일을 국민의 "
"자유를 제한하는 조치라고 여기고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0003_Text
#. Speaker : Regongar_Companion
msgctxt "f911216d-c3b9-4f59-a149-84e2ba98a9be"
msgid ""
"\"The lousy peasants! Who do they think they are?! {name}, your subjects "
"have taken to the streets, and dare to make demands! 'The guard watches our "
"every step!' Just think of it — they want us to stop personal searches, "
"lower the number of guards, decrease the patrols...\""
msgstr ""
"\"시끄러운 농부놈들! 그 놈들이 뭔 생각을 하는지 누가 알겠어?! {name}, 네 백성들이 거리를 점거하고, 감히 우리에게 요구를 "
"하고있어! '경비들이 우리 일거수일투족을 보고있다! 생각해보자고. 그 치들이 민간인 사찰의 중지와 경비 숫자와 순찰 빈도의 감소를 원해. "
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0004_Text
#. Speaker : Ekun_Companion
msgctxt "acae4f28-a021-4556-8dc1-6e6f4c5249f2"
msgid ""
"\"My advice: do not clench your fist even tighter. It is not right for "
"everyone to suffer for the sins of the rash and the shortsighted. But I "
"would not give in either.\" {n}Ekun wrinkles his forehead in concentration. "
"After a while, he continues.{/n} \"What can we sacrifice instead of "
"sacrificing safety? I can think of one alternative: money.\""
msgstr ""
"\"내 조언은: 주먹을 강하게 쥐지도 마라. 경솔함과 근시안으로 인한 죄로 모두가 고통받는 것은 올지않아. 하지만 그들이 원하는 것을 "
"주지도 않는다.\" {n}에쿤다요가 이마를 찌푸리며 집중합니다. 잠시 후에 그가 말을 잇습니다.{/n} \"안전을 희생하는 대신에 무엇을 "
"희생할 수 있지? 내 생각에 돈이 그 답이 될 것 같군..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0005_Text
#. Speaker : Capital_Kesten
msgctxt "111acccd-8773-4b81-bc02-b82d3d5da06d"
msgid ""
"{n}Kesten stands in silence, then continues.{/n} \"I'm afraid we'll just "
"have to give in. At least partially. It would certainly be cheaper than "
"trying to placate the people by lowering their tithes. And it's safer and "
"more just than using force to run them back to their homes.\""
msgstr ""
"{n}케스턴이 말 없이 서있다가 말을 잇습니다.{/n} \"그들이 원하는 바를 그저 내어줘서는 안됩니다. 적어도 제한은 있어야합니다. "
"감세로 사람들을 달래는 것이 좀 더 싸게먹힐 것 같습니다. 그리고 이 방법이 좀 더 안전 할 겁니다. 힘을 써서 집으로 돌려보내는 것 "
"보다는 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0006_Text
#. Speaker : Regongar_Companion
msgctxt "bf04a919-c06a-4b76-97c8-cd9e8611f040"
msgid ""
"\"I'll tell it like it is, {name} — if there's one thing they hate, it's "
"that I've brought this place to order! See, they can't loiter for days on "
"end anymore, idle away their day and then steal whatever they can get their "
"dirty mitts on! My hounds are watching their every move. There can be no "
"deals, no appeasing them. — Just give me the order, and my boys will have "
"those dirty oafs back in their homes, hiding under their beds!\""
msgstr ""
"\"이렇게 말하고 싶군, {name}. 하나 마음에 안드는 것이 있다면, 바로 이 명령이 실행되게끔 하는거야! 잘봐, 그 놈들이 온종일 "
"어슬렁 거릴수는 없단말야, 하루종일 빈둥거리며 놀고 있을수도 없지. 그후엔 더러운 손에 잡히는 무엇이든 훔칠거라고! 내 사냥개들이 "
"일거수일투족을 감시하는 중이야. 협상은 있어서는 안돼고, 달래서도 안돼. 그냥 나한테 명령을 내려줘 그러면 내 부하들이 이 더러운 "
"멍청이들을 집으로 돌려보내서 이불 속에 숨게끔 할테니! !\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0011_Text
#. Speaker : Ekun_Companion
msgctxt "6b44b96d-3bb7-4cd7-b4d4-9440f2df0fdc"
msgid ""
"{n}A deep furrow crosses Ekun's forehead.{/n} \"The guards have revolted. "
"They refuse to work. They say, we 'fill every gap and patch every hole' with "
"them. This cannot go on.\""
msgstr ""
"{n}에쿤다요의 이마에 깊은 주름이 집니다..{/n} \"경비대가 반동을 일으켰다. 근무하기를 거부하고 있어. 우리가 경비들의 모든 "
"격차를 줄이고 모든 구멍을 메꿔야 한다고 말하더군. 이대로 갈수는 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0012_Text
#. Speaker : Capital_Kesten
msgctxt "4d107475-0a81-4449-892a-0b1c1eced1db"
msgid ""
"{n}Kesten's ever-grim visage is painted with concern.{/n} \"Ill news, Your "
"Highness. The guard refuses to go out on patrols. The officers have declared "
"that their people will not take up weapons, until the conditions of their "
"service are improved. Truth be told, it is rare for a kingdom to see their "
"guard take part in so many battles, wars, raids and monster hunts...\""
msgstr ""
"{n}항상 미소짓던 케스턴의 형상이 걱정으로 물들어 있습니다.{/n} \"나쁜 소식입니다, 전하. 경비대가 순찰 가기를 거부하고 "
"있습니다. 근무조건이 향상되지 않으면 무기를 들지 않겠다고 장교들이 선언했습니다. 솔직히 말씀드리자면, 이렇게 많은 전투와 전쟁, 습격 "
"그리고 괴물 사냥에 참여하는 경비를 보는 것은 왕국들 중에서 희귀한 편입니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0013_Text
#. Speaker : Regongar_Companion
msgctxt "46ae5a72-47f7-4746-8ecf-f6191467a8af"
msgid ""
"{n}Regongar's voice booms across the throne room.{/n} \"{name}, your good-"
"for-nothing runts have gone on strike! Made demands! From me! When they were "
"starting out, I was like their ma and pa! I taught them which end of a "
"halberd to hold! How to shake down a vagabond! How to talk to the merchants, "
"and make sure they pay on time for their safety! And this is how they repay "
"me! — By refusing to go out on patrol?! By asking for a better quality of "
"life?!\""
msgstr ""
"{n}레곤가르의 목소리가 알현실에서 크게 울려퍼집니다.{/n} \"{name}, 네 아무 짝에도 쓸모없는 놈들이 파업에 들어갔다! 요구를 "
"해대면서! 다름아닌 내게 말이야! 놈들 징징거리는 소리를 듣자하니, 부모가 된 기분이야! 난 녀석들한테 할버드 쥐는 법을 가르쳤어! "
"전위대가 되는 방법을! 상인들이랑 이야기하는 방법, 상인들이 살고싶다면 제때 돈을 내게 만드는 법을 가르쳤단 말이야! 그런데 지금 이런 "
"식으로 내게 은혜를 갚다니! 감히 순찰 나서는 걸 거절해?! 더 나은 삶을 위한다고?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0014_Text
#. Speaker : Ekun_Companion
msgctxt "ad6fc7fd-d07a-4146-b437-74372dcebd9e"
msgid ""
"\"Mercenaries can never truly replace warriors who fight for their homeland. "
"Firing some of the guard would mean leaving someone without a defender. I "
"think instead we should raise their pay.\""
msgstr ""
"\"돈으로 고용한 용병들이 자신의 고향을 걸고 싸우는 병사들을 대신할 수는 없습니다. 경비병을 내쫓으면 그로 인해 누군가는 제대로 된 "
"보호를 받지 못하게 되기도 하구요. 저는 차라리 병사들의 월급을 올려주는 것이 맞다고 생각합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0015_Text
#. Speaker : Capital_Kesten
msgctxt "faa185a7-12f3-4d2a-88e8-50d36f694d08"
msgid ""
"\"Your Highness may instead pay for the services of mercenaries. But I think "
"that our boys deserve some time off. They risk their lives every day, and "
"they need to spend more time with their families... while they still can.\""
msgstr ""
"\"전하께서는 돈으로 용병들을 고용하실 수도 있겠지요. 하지만 우리 병사들은 적당한 휴식 시간을 가질 이유가 충분하다고 생각됩니다. "
"그들은 매일 같이 목숨을 걸고 싸우고 있기에 그들의 가족과 지낼 수 있는 시간이 더 필요하기도 하구요. 그게 아직 가능 할 때만이라도 "
"말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0016_Text
#. Speaker : Regongar_Companion
msgctxt "af7e7171-b148-4954-8cc1-298c6f5c3de9"
msgid ""
"\"I would kill the bastards if I could! There's so many damned people around "
"— and not a single soul you can trust! I say we just cut the dead weight, "
"fire the whiners and replace them with mercenaries.\""
msgstr ""
"\"가능하기만 하다면 저 개자식들을 다 죽여버렸을 거야! 빌어먹을 놈들이 너무나도 많아! 한 놈도 믿을만한 놈이 없다니까! 저 "
"짐덩어리들을 그냥 잘라버려, 징징대는 놈들을 잘라버리고 빈자리를 용병으로 채우란 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0021_Text
#. Speaker : Ekun_Companion
msgctxt "ea296da0-5939-4d53-87d8-5a9452a6674b"
msgid ""
"{n}Ekun's shoulders relax in relief.{/n} \"I'll talk to your advisors. We'll "
"come up with something.\""
msgstr "{n}에쿤의 어깨가 안심으로 풀어집니다.{/n} \"보좌관과 이야기 하겠다. 뭔가 방법이 생기겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0022_Text
#. Speaker : Capital_Kesten
msgctxt "71f49f22-bdff-4d8e-a782-1404ffd84cc5"
msgid "\"I will obey, Your Highness.\""
msgstr "\"따르겠습니다, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0024_Text
#. Speaker : Ekun_Companion
msgctxt "f7e53e47-fe99-43db-9ab0-639d4e7ebba3"
msgid ""
"{n}Ekun nods in contemplation.{/n} \"It will be as you say. Perhaps it is "
"for the best.\""
msgstr "{n}에쿤이 사색하며 끄덕입니다.{/n} \"그대의 말 대로 하겠다. 그게 최선이겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0025_Text
#. Speaker : Capital_Kesten
msgctxt "e9b6d4ea-f04c-4c0c-84ec-466b0edef26b"
msgid ""
"{n}Kesten's face softens considerably.{/n} \"Your Highness only makes it "
"even clearer to me that this was the only proper course.\""
msgstr "{n}케스턴의 얼굴이 꽤나 누그러집니다.{/n} \"이게 유일하게 옳은 길임을 전하께서 확신시켜 주시는군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0027_Text_String
#. Speaker : Ekun_Companion
msgctxt "4ea5eae3-0cfc-4f7a-82c6-143325846e71"
msgid "{n}Ekun winces, sighs heavily, and finally nods.{/n} \"I see.\""
msgstr "{n}에쿤이 움찔하더니, 크게 한숨을 쉬고는 종래엔 끄덕입니다.{/n} \"알겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0028_Text_String
#. Speaker : Capital_Kesten
msgctxt "8f90151c-de65-46f4-af9b-24e3e1a69bdd"
msgid ""
"{n}Kesten grits his teeth, straightens his back, and answers in a muffled "
"voice.{/n} \"An order I had hoped never to receive... As you command, Your "
"Highness!\""
msgstr ""
"{n}케스턴은 그의 이를 꽉 물으며, 등을 곧게 피고는, 낮은 목소리로 대답했다.{/n}\"제가 받지 않았으면 했던 "
"명령입니다만...지시대로, 전하!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0029_Text
#. Speaker : Regongar_Companion
msgctxt "01d02916-a992-473e-a74f-6327ab571d8f"
msgid "\"With pleasure, {name}!\""
msgstr "\"영광입니다, {name}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0030_Text
#. Speaker : Ekun_Companion
msgctxt "0eaac491-704e-44f4-90ac-cdd28c9a80f9"
msgid "\"I'm glad of this. I will deliver the good news.\""
msgstr "\"기쁩니다. 좋은 소식을 전달하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0031_Text
#. Speaker : Capital_Kesten
msgctxt "d7aff6d1-97d9-468e-9886-6fb424975063"
msgid ""
"{n}A slight smile crosses Kesten's lips.{/n} \"Thank you, Your Highness! "
"I'll go and tell your people the good news.\""
msgstr ""
"{n}케스턴의 입술에 슬며시 미소가 번집니다.{/n}\"감사합니다, 전하! 당신의 백성들에게 가서 이 기쁜 소식을 전하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0032_Text_String
#. Speaker : Regongar_Companion
msgctxt "251c7cd6-3d16-490c-baa8-521878c4501f"
msgid ""
"\"If you've got money you don't need lying around — then sure, give it to "
"them. Just don't say I never mentioned what sort of bastards you have "
"serving in your guard. I should know – I picked 'em myself, ha ha. Cut-"
"throats and cold-blooded killers send prayers to their gods when they see my "
"guys crossing the street. Just thought I should mention what kind of guys "
"you're pampering, and what might be in store for you.\""
msgstr ""
"\"쓸모 없는 돈이 굴러다니고 있다면, 상관없지. 놈들한테 줘버려. 널 섬기고 있는 경비들이 어떤 개자식들인지 내가 말 안 했다고는 하지 "
"말라고. 난 알아. 내가 놈들을 직접 골랐거든, 하하. 강도와 냉혹한 살인마들도 내 부하들이 거리를 돌아다니면 신을 찾곤 하지. 네가 "
"애지중지하는 놈들이 어떤 놈들인지, 그리고 네가 어떤 준비를 해야할지 알려줘야 할 거 같아서 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0034_Text
#. Speaker : Capital_Kesten
msgctxt "3e7cae23-35ef-4fe2-bfde-e4e789d5e4ce"
msgid "\"As you command, Your Highness! I shall pass along your orders!\""
msgstr "\"지시하신 데로, 전하! 당신의 명령을 따르겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0035_Text_String
#. Speaker : Regongar_Companion
msgctxt "a739e639-3d58-465b-90ae-66376b692bb2"
msgid ""
"\"You don't know what you're saying! A good guard has to be either lean and "
"mean, or fat and cunning. These guys don't score too high in the brains "
"department, so I keep them running so they stay mean. We keep doing things "
"your way, you'll end up with a horde of fat, lazy bumknuckles!"
msgstr ""
"\"스스로 무슨 말을 하는 지 넌 모르고 있어! 좋은 경비란 마르고 비열해야 해. 아니면 뚱뚱하고 교활하거나. 이놈들은 머리를 쓸 줄 "
"몰라. 그러니 내가 성질 더러워지게 좀 뛰게 만들겠어. 계속 네 방식대로만 하다간 뒤룩뒤룩 찌고 게을러빠진 놈들만 가득차게 될 거야!"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0036_Text_String
#. Speaker : Ekun_Companion
msgctxt "078974ab-d41f-43cc-8973-9978cbbbdbcd"
msgid "\"It is not my decision. But they do not deserve such treatment.\""
msgstr "\"그것은 나의 결정이 아니다. 그러나 그들은 그런 대우를 받을 자격이 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0037_Text_String
#. Speaker : Capital_Kesten
msgctxt "c3928530-3c5b-4658-a68e-5a36423a8378"
msgid ""
"{n}Kesten sighs heavily.{/n} \"Those are the words that I have feared to "
"hear... As you command, Your Highness.\""
msgstr "{n}케스턴은 크게 한숨을 쉬었다.{/n}\"그 말씀은 제가 듣기를 두려워 했던 것입니다만...지시하신 데로, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0038_Text
#. Speaker : Regongar_Companion
msgctxt "b38967e8-e614-4cf4-8e77-ac9a31917494"
msgid ""
"{n}Regongar snaps his fingers and grins.{/n} \"Ha ha! That's just perfect "
"for the lazy numbskulls! They'll come crawling back to papa, begging for us "
"to take them back — and we'll give them nothing! The treacherous bastards!\""
msgstr ""
"{n}레곤가르는 손가락을 튕기며 웃음을 띄었다.{/n}\"하하! 게으른 멍청이 들을 위한 완벽한 방법이군! 그들은 기어들어와서는 우리에게 "
"다시 받아달라 빌기 시작하겠지, 그러면 우린 그들에게 아무것도 주지 않으면 되고! 믿을 수 없는 병신들!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0045_Text_String
#. Speaker : Regongar_Companion
msgctxt "8380459e-95df-4da1-9e30-525bfaecea47"
msgid ""
"\"What?! You'll bend to these layabouts? These dimwits?! Ah, curses...\""
msgstr "\"뭐?! 너 그 게으름뱅이들에게 숙이고 들어갈거야? 그 멍청이들에게?! 아, 망할....\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank8/Cue_0054_Text
#. Speaker : Regongar_Companion
msgctxt "b6b3ed89-67a6-4467-bbb0-f4e90d562766"
msgid ""
"\"Oh, I'll enjoy this, {name}! My boys'll clean up the streets in no time!\""
msgstr "\"오, 난 이게 즐겁나니깐, {name}! 내 애들이 곧 거리를 말끔하게 치워놓을 거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/AbadarJusticiary/Answer_0003_Text
msgctxt "3c5c657f-42ab-410c-b997-5888d6847c2e"
msgid "\"Tell me about your society.\""
msgstr "\"너희 조직에 대해 말해달라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/AbadarJusticiary/Answer_0005_Text
msgctxt "79a25bce-9966-4c0d-b539-0ebc916baf42"
msgid "\"That will be all. Thank you, Roham.\""
msgstr "\"그게 전부다. 고맙다, 로함.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/AbadarJusticiary/Answer_0006_Text
msgctxt "a1239f95-4ad7-419d-9f87-342c1d1db467"
msgid ""
"\"My advisor referred to you as the 'Golden Shields', yet you say 'Golden "
"Shield'. Which one is it?\""
msgstr "\"내 보좌관들이 자넬 '황금 방패단' 이라고 했거늘, 자네는 '황금 방패' 라고 하는군. 어느 쪽이 옳은 건가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/AbadarJusticiary/Answer_0050_Text
msgctxt "1d10bc5e-385e-411f-921a-947c61b6b074"
msgid "\"How did you become a justiciar of Abadar?\""
msgstr "\"어떻게 아바다르의 재판관이 되었지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/AbadarJusticiary/Cue_0001_Text
#. Speaker : RankUp_Roham
msgctxt "39006522-f7cb-45dc-b3a3-cea7b1d1121c"
msgid ""
"{n} The woman before you holds herself erect, and there is confidence in her "
"stance. Her polished armor shines even in the dimly-lit throne room. {/n} "
"\"Greetings, Your Highness. I represent the Golden Shield — a society of "
"Abadar's faithful, which offers law enforcement services to anyone that may "
"require them.\""
msgstr ""
"{n}당신 앞의 그 여성은 곧게 서 있고, 그녀의 자세엔 자신감이 있습니다. 그녀의 윤이 나게 닦여진 갑옷은 어둑한 왕좌의 방 안에서조차 "
"빛이 납니다.{/n} \"반갑습니다, 전하. 저는 아바다르님의 신자들로 이루어진 조직인 황금 방패단을 대표해서, 누구든 법을 집행함에 "
"있어 조력을 필요로 하는 자들을 돕고자 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/AbadarJusticiary/Cue_0007_Text
#. Speaker : RankUp_Roham
msgctxt "6f2b6d8b-6a50-44a0-b592-86cc5614b14e"
msgid ""
"\"We are more than mere mercenaries. We are a brotherhood of warriors "
"devoted to upholding the law – and fighting the ruinous powers of chaos. "
"Each of us has sworn a solemn oath to follow the ideals of Abadar, and stay "
"true to the best interests of society. These are more than words. — By the "
"powers bestowed upon me by our divine benefactor, they have become a sacred "
"pact, guided by the higher spheres.\""
msgstr ""
"\"저희는 한낱 용병 그 이상입니다. 저희는 법을 수호하며 파괴적인 혼돈의 힘과 맞서 싸우는 전사들의 형제단입니다. 저희 한 명 한 명이 "
"아바다르님의 이상을 따르고, 조직의 최선의 이익에 충실할 것임을 굳건하게 맹세하였지요. 단순한 말을 넘어서서 저희 신께서 제게 내려주신 "
"힘에 의하여 이 모든 말은 신성한 맹약이 되고, 더 높은 곳으로 인도할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/AbadarJusticiary/Cue_0008_Text
#. Speaker : RankUp_Roham
msgctxt "71068744-b57b-4489-95ae-5757b20d8e48"
msgid ""
"{n} The captain smiles at you.{/n} \"It is 'Shield'. But it's a mistake so "
"common that we have long stopped correcting anyone. We even had to purchase "
"the golden shields which supposedly gave us our name. — Without them, some "
"of our clients refused to believe that we were who we claimed to be! In "
"truth, our name was chosen for a different reason. Gold is the color of our "
"patron Abadar, the God of laws, cities and prosperity. And the shield "
"symbolizes our purpose — to protect civilization and order from chaos and "
"anarchy.\""
msgstr ""
"{n}그 대장은 당신을 보면서 웃었습니다.{/n}\"'방패'입니다. 그렇지만 그런 실수는 너무나도 흔한 것이어서 저희는 오래 전부터 "
"누군가의 그런 실수를 바로 잡는 것을 그만두었습니다. 저희는 심지어 저희 단체의 이름에 맞게끔 황금 방패들을 사야만 했습니다. 황금 "
"방패가 없는 채로는, 저희의 몇몇 의뢰인들은 저희가 어떤 사람들인지 믿기조차 거부했습니다! 사실, 저희의 명칭은 다른 이유에서 선택된 "
"것입니다. 황금은 우리의 후원자이신 질서와 도시와 번영의 신 아바다르의 상징색입니다. 그리고 방패는 우리의 목적인 무법과 혼돈으로부터 "
"질서와 문명을 지키고자 하는 것을 상징한 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/AbadarJusticiary/Cue_0009_Text
#. Speaker : RankUp_Roham
msgctxt "fc4f9dd1-4640-4694-998c-c985be21812a"
msgid ""
"\"Should one of us breach his contractual obligations to an employer or "
"commit any deed that breaks the law, in letter or in spirit, then the "
"heavens themselves will smite him down. He will be cursed, and all the "
"members of his society will immediately sense it – wherever they may be and "
"whatever they may be doing. Our oath demands that we track down their former "
"comrade and bring him to justice.\""
msgstr ""
"\"우리 중 한 사람이 그의 고용주와의 계약 의무를 위반하거나 법의 조문이나 그 정신을 위배하는 행위를 저지르면, 천상으로부터 그를 내려 "
"칠 것입니다. 그는 저주 받을 것이고, 조직의 모든 구성원들이 그들이 어디있고 무슨일을 하던 중이던 간에 그것을 곧 감지할 수 있습니다. "
"우리의 맹세는 우리의 예전의 동료를 찾아내고 그를 정의에 따르도록 하게끔 요구합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/AbadarJusticiary/Cue_0010_Text
#. Speaker : RankUp_Roham
msgctxt "9a4f1275-bf5f-4ef5-a23c-4cba9c2cf501"
msgid ""
"\"I grew up in Molthune. My town entered a contract with the local temple of "
"Abadar: the taxes on the priests' extensive property were waived, and in "
"exchange they raised the city's orphans. I happened to be one such child.\""
msgstr ""
"\"저는 몰튠에서 자랐습니다. 제 마을은 현지의 아바다르의 신전과 계약을 맺었습니다. 사제들의 막대한 제산에 대한 세금은 도시의 고아들을 "
"그들이 대신 키우는 것으로 면제되었습니다. 저 또한 그렇게 자라난 아이들 중 하나입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Answer_0004_Text
msgctxt "74ccec27-cbca-4b5d-932a-43ce67116a8b"
msgid "\"What's your advice?\""
msgstr "\"당신의 의견은 어떻소?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Answer_0009_Text
msgctxt "2f39ef8f-62d4-4170-a57e-b37e1aaa1be5"
msgid ""
"\"The barbarians are coming for us anyway, so let our guard benefit from the "
"extra numbers. Let the Golden Shields take up their duties immediately.\""
msgstr ""
"\"바바리안들이 우리를 향해 몰려오고 있습니다. 그러므로 우리의 방어는 더 많은 인원을 통해 증진될 수 있습니다. 황금 방패가 즉시 "
"그들의 임무를 수행하게 합시다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Answer_0010_Text
msgctxt "e989fb6c-d0c6-4d04-9272-02de5337f210"
msgid ""
"\"We shall accept Wigmold's proposal. His magical surveillance system sounds "
"most promising.\""
msgstr "\"우리는 위그몰드의 제안을 받아들이겠다. 그의 마법 감시 체계가 가장 유용할 것 같다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Answer_0020_Text
msgctxt "d21be324-7967-41f2-a803-f90367ec1a63"
msgid "\"I wish to speak with Roham, the leader of the justiciars.\""
msgstr "\"사법관들의 지도자인 로함과 대화하고 싶다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Answer_0029_Text
msgctxt "81dbb06f-915d-478f-8cb4-8977e77bbcb7"
msgid ""
"\"Let us hear what Wigmold has to say about his magical surveillance system."
"\""
msgstr "\"위그몰드가 그의 마법 감시 체계에 대해 이야기하는 것을 들어보자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Answer_0073_Text
msgctxt "efb30fc1-02b8-49ca-a4ee-2079ea2c41bc"
msgid "\"I wish to further question Wigmold\"."
msgstr "\"좀 더 위그몰드에게 질문하고 싶다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Answer_0074_Text
msgctxt "8bfc11ac-94ca-4346-b653-023c6a626f91"
msgid "\"I wish to speak further with Roham.\""
msgstr "\"좀 더 로함에게 질문하고 싶다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Answer_0080_Text
msgctxt "0df1f7a0-66c5-4846-a494-7968adc4a9eb"
msgid "\"Enough. That is all that I needed to know.\""
msgstr "\"충분하다. 내가 알고자 하는 것은 그것이 전부이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Answer_0082_Text
msgctxt "60774ad6-0b30-4d9c-b172-c1b454f95cd5"
msgid "\"So why did you leave Druma?\""
msgstr "\"왜 드루마에서 떠났지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Answer_0084_Text
msgctxt "82751b21-9886-4151-9e47-15c89ebbf504"
msgid "\"Tell me about the lands that you hail from.\""
msgstr "\"그대가 태어난 곳에 대해서 이야기 해보라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Answer_0087_Text
msgctxt "4b4bf600-d631-465e-9f2c-14512eaa457c"
msgid "\"What exactly is it that you do?\""
msgstr "\"그대가 하는 일이 정확히 무엇이더냐?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Answer_0088_Text
msgctxt "5498607b-f855-4c8c-b958-376e3466f213"
msgid "\"How does your surveillance system work?\""
msgstr "\"그대의 감시 체계는 어떻게 작동하지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "1e5b7c6e-adb9-4939-89d2-df566d1029f6"
msgid ""
"\"There's been trouble. The night patrol caught a barbarian. He was about to "
"poison a well on the outskirts of the capital. Tried to run, got shot. As he "
"died, he swore that the shamans of his tribe would stop at nothing to poison "
"all the food and water in the city.\""
msgstr ""
"\"문제가 있었습니다. 야간 순찰자들이 바바리안을 잡았습니다. 그는 수도 외곽에서 우물에 독을 풀고자 한 것 같았습니다. 도망치려 "
"하다가, 화살에 맞았습니다. 그는 죽어가며 도시의 모든 물과 음식들에 독을 풀기까지 그의 부족의 샤먼들은 멈추지 않을 것이라 외쳤습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0002_Text
#. Speaker : Capital_Kesten
msgctxt "282c3231-7295-4385-a3e9-c598a3e3fd08"
msgid ""
"\"The Capital is in danger, Your Highness! A night patrol in the outskirts "
"caught a Kellid barbarian trying to poison a well. He was fatally wounded "
"during the arrest. But before he breathed his last, he threatened that their "
"shamans were going to poison all our food and water, and even the air we "
"breathe.\""
msgstr ""
"\"수도가 위험합니다, 전하! 야간 순찰자가 우물에 독을 풀려고 하던 켈리드 부족 바바리안을 붙잡았습니다. 그는 잡히는 과정에서 중상을 "
"입었습니다만, 그가 마지막 숨을 내뱉기 전에, 그는 그들의 샤먼이 우리의 음식과 물 그리고 심지어 우리가 숨쉬는 대기에도 독을 풀 것이라 "
"위협했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0003_Text
#. Speaker : Regongar_Companion
msgctxt "1341a657-64b3-4f81-8928-b0edc078ff99"
msgid ""
"\"I got three pieces of news for you: one good, one bad, and the last one "
"good again. The first is that my boys caught a Kellid barbarian trying to "
"poison a well last night. That's pretty good, eh? He still managed to poison "
"the well though...\""
msgstr ""
"\"나한테 세 가지 소식이 있어. 좋은 것, 나쁜 것, 그리고 다시 좋은 것. 첫번째 건은 내 애들이 켈리드 부족 바바리안놈이 지난 밤에 "
"우물에 독을 풀려는걸 잡았다는거야. 좋은 소식이지, 응? 그가 계속해서 우물에 독을 풀려고 했지만 말야...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0005_Text
#. Speaker : Capital_Kesten
msgctxt "299125e8-e867-4042-bf0f-d3119700434e"
msgid ""
"\"We don't know what shamans he spoke of, or when they might strike. We "
"don't even know if we can trust the words of the dying barbarian. We're in a "
"rough spot, but I brought a couple of allies who could help.\" {n}Kesten "
"nods in the direction of his companions.{/n}"
msgstr ""
"\"우리는 그가 말한 샤먼이 누군지 모르는 데다가, 언제 그들이 침략할지도 모릅니다. 게다가 그 죽어가던 바바리안 내뱉은 말을 우리가 "
"믿을 수 있는 것인지도 알 수 없습니다. 우리는 힘든 상황이지만, 제가 우리에게 도움을 줄 수 있는 몇몇 협력자을 모셔왔습니다.\" {n}"
"케스턴은 그의 동료들이 있는 곳을 향해 고개를 끄덕였다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0007_Text
#. Speaker : Ekun_Companion
msgctxt "05b6abc5-4d7c-4516-9806-016df2cd2084"
msgid ""
"\"We don't know who they are, how many they are, or where they are… And we "
"need any help we can get. Two of our citizens have already stepped forward "
"to offer plans and resources. The first — Roham Orand, justiciar of Abadar "
"and leader of the Golden Shields. She wants to distribute her people around "
"the city and capture the barbarians as soon as they appear. The other one — "
"Wigmold Smegglyduddn. He has plans for a magical spying system. With his "
"help, we might be able to find out where the enemy is hiding, and strike "
"first.\""
msgstr ""
"\"우리는 그들이 누구인지, 얼마나 많은지, 어디 있는지 알 수 없습니다...그리고 우린 구할 수 있는 어떠한 지원도 필요로 합니다. "
"우리 시민 가운데 두 명이 이미 기획과 자원을 제공하기 위해 나섰습니다. 먼저, 아바다르의 법관이자 황금 방패단의 지도자인 로함 "
"오랜드입니다. 그녀는 그녀의 사람들을 도시 곳곳에 배치하여 바바리안들이 모습을 드러내자 마자 붙잡기를 원합니다. 다른 한명은 위그몰드 "
"스메글리더든입니다. 그는 마법적인 정탐 체계를 기획하고 있습니다. 그의 도움이라면 우리는 아마도 그들이 어디에 숨어있는지 알 수 "
"있을것이고 그들을 습격할 수 있을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0008_Text
#. Speaker : Regongar_Companion
msgctxt "3c81594d-0834-46a6-9a79-8706de67c892"
msgid ""
"\"Naturally, the savage gave us some lip while we questioned him. At one "
"point he even spat his teeth at us, ha ha! But in the end he sang. "
"Apparently, a whole group of Kellid shamans are planning to poison the "
"capital's food and water supplies. This whole thing has got me blazing mad. "
"We knew nothing about this! And it was just dumb luck that we caught this "
"idiot. Who are they? How many are there? – And when are they going to "
"strike? It would have been a mess – and there's no way we'd be able to catch "
"them... However!\" {n} The half-orc smiles, baring his fangs.{/n} \"Don't "
"forget, the third piece of news is another good one.\""
msgstr ""
"\"당연히, 그 야만인은 우리가 그를 심문할때 주제넘은 소리를 했지. 어느 순간 그 놈은 입을 꾹 다물더군, 하하! 하지만 결국엔 그 "
"놈은 노래하듯 다 주절거렸지. 듣자하니, 켈리드 샤먼들 전체가 수도의 음식과 물 공급에 독을 탈 계획인더군. 이 모든 일이 날 열받게 "
"하더군. 우리 아무것도 알지 못했잖아! 그리고 우연찮게도 우린 이 머저리를 잡아낸거지. 그들은 누구지? 그들은 얼마나 있지? 그리고 언제 "
"그들이 침공할 것인지? 전부 엉망이고 우린 그들은 잡을 방법이 없지... 그렇지만!\"{n}하프 오크는 웃으며, 그의 송곳니를 "
"드러냈습니다.{/n}\"잊지 말라고, 세 번째 소식은 다시 좋은거라 했으니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0011_Text
#. Speaker : Ekun_Companion
msgctxt "8a2d58f3-1637-4024-aa21-f50893653f39"
msgid ""
"\"I don't know what sorcery Wigmold uses. But I do know that if you're "
"looking for a needle in a haystack, it's best to use magic. Too many people "
"live in the capital. There's too many wells, granaries, warehouses. Our "
"guard isn't trained to cover so much ground at once, and besides, we don't "
"have enough guards to do it. Instead, we've taught them to track down the "
"criminals beforehand, and move in to intercept. That makes Wigmold the "
"better option.\""
msgstr ""
"\"나는 위그몰드가 어떤 마법을 사용할지 알지 못한다. 그러나 건초 더미에서 바늘을 찾는다면 가장 좋은 방법은 마법을 사용하는 거라는 "
"것은 알고 있다. 아주 많은 이들이 이 수도에 살고 있다. 또한 많은 우물과 식료품점과 창고들이 있지. 우리의 경비대는 이런 넓은 곳을 "
"단번에 다룰 수 있는 훈련을 하지 못했고, 이에 더해, 우리는 충분한 수의 경비대가 있는 것도 아니다. 대신에, 우린 그들에게 범죄자를 "
"사전에 추적해서, 잡을 수 있도록 훈련시켰다. 바로 이 점이 위그몰드를 보다 나은 제안으로 만드는군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0012_Text
#. Speaker : Capital_Kesten
msgctxt "f7218093-1639-4eca-b775-501b57342a18"
msgid ""
"\"I do not trust magic. However, I know that our guards would make better "
"use of a surveillance system. The way we have approached the problems that "
"have arisen over the years – this has taught them specific skills. They know "
"how to move quickly and strike first, to prevent crimes from occurring... "
"but they would fare worse at protecting multiple locations at once, or "
"sealing off every entry and exit from the city. We simply won't have enough "
"people for that. Thus, it's better to chose Wigmold.\""
msgstr ""
"\"나는 마법을 믿지 않는다. 그러나, 경비병들이 감시 체계를 더 잘 활용할 것이라는 것을 안다. 오랫동안 제기되어온 문제를 해결해온 "
"우리의 방식이 그들에게 특유한 기술을 가르쳐 주었다. 그들은 범죄가 발생하는 것을 예방하기 위하여 어떻게 빠르게 선공을 가할 것인지를 "
"알고 있지만...여러 장소를 단 번에 지켜내는 것이나 도시의 모든 출입구를 봉쇄하는 것은 어려워 할 것이다. 우리에게 그런 일을 할만한 "
"충분한 수의 사람들이 없다. 때문에, 위그몰드를 고르는 것이 낫겠군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0013_Text
#. Speaker : Regongar_Companion
msgctxt "5de4dc43-c8f6-474b-8327-ba96328cab04"
msgid ""
"\"I know our men. We've trained them to work with their muscles and their "
"intuition – but we haven't trained them for patience. They're just not the "
"kind of guys who can stand guard day and night at every gate and crossroads. "
"And we don't even have the manpower for it. So it would be better to let "
"Wigmold cast his magic thing and tell us how to catch the shamans before "
"they strike.\""
msgstr ""
"\"난 우리의 부하들을 안다. 우리는 그들의 힘과 직감을 길러내었지만 그들에게 인내를 가르치진 않았다. 그들은 단지 관문과 교차로를 "
"밤낮으로 지키고 서 있을 법한 사내들이 아니다. 그리고 우린 충분한 인력조차 없다. 그러니 위그몰드가 그의 마법을 시전하여 샤먼들이 "
"공격하기 전에 어떻게 하면 그들을 잡을 수 있을지 이야기 하게끔 해야 할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0014_Text
#. Speaker : Ekun_Companion
msgctxt "3ba08adc-f703-4acc-a477-c7ed300a9275"
msgid "\"I'll help Roham and her people settle in.\""
msgstr "\"난 로함과 그녀의 사람들이 정착하는 것을 도울 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0015_Text
#. Speaker : Capital_Kesten
msgctxt "354bcfe9-ec32-4ea0-a24d-9b23f63652ac"
msgid ""
"\"As you wish, Your Highness. I'll make sure Roham and her team are briefed."
"\""
msgstr "\"당신이 바라시는 데로, 전하! 로함과 그녀의 단체에게 알려줄 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0016_Text
#. Speaker : Regongar_Companion
msgctxt "9bb1e771-903c-4809-b253-56b00d761d44"
msgid "\"Shall be done. We'll see what they're worth…\""
msgstr "\"끝내야 한다. 우리는 그들이 어떤 가치를 가졌는지 보게 될 것이다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0017_Text
#. Speaker : Ekun_Companion
msgctxt "b18f1450-c01e-4d6e-9d47-471959579ff3"
msgid "{n}Ekun nods with a barely audible sigh.{/n}"
msgstr "{n}에쿤은 거의 들리지 않는 한숨을 지으며 고개를 끄덕였다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0018_Text
#. Speaker : Capital_Kesten
msgctxt "b7517bc6-daa8-4338-8cbb-e4bd4152013d"
msgid ""
"\"As you command, Your Highness. We will begin calibrations immediately.\""
msgstr "\"바라시는 데로, 전하. 저희는 바로 조정을 시작할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0019_Text
#. Speaker : Regongar_Companion
msgctxt "cd645cc1-987f-4c91-9b4f-2b56022dbb78"
msgid ""
"\"Excellent. Well, no point standing around then. Let's go have a little "
"talk, Wigmold…\""
msgstr "\"아주 좋아. 음... 멀뚱히 서있기엔 뭐하군. 가서 이야기나 할까, 위그몰드...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0021_Text
#. Speaker : Ekun_Companion
msgctxt "634f6bf9-46db-4b6f-9e69-067f6f20d48d"
msgid ""
"\"Magic is good. But our guards cannot use the knowledge that Wigmold's "
"spells would provide. They're not fast enough, not nimble enough. They don't "
"know how to strike first, preemptively. We've rarely ordered them to do so. "
"But they do know how to lock down the city, and guard it day and night, so "
"that no one can pass by unnoticed – which would be even easier with more "
"eyes and swords. I would choose Roham.\""
msgstr ""
"\"마법은 쓸만하다. 하지만 경비대는 위그몰드의 주문이 주는 정보를 잘 쓰지 못할거야. 그정도로 빠르지도 영리하지도 않으니까. 선제공격을 "
"어떻게 해야할지도 잘 몰라. 그런 명령을 자주 받지도 않고. 하지만 어떤 사람도 은밀하게 움직일 수 없도록 도시를 봉쇄해서 밤낮으로 "
"지키는 방법은 알고 있다. 더 많은 눈과 검이 있으면 더 쉬워질거야. 나라면 로함을 택하겠어. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0022_Text
#. Speaker : Capital_Kesten
msgctxt "4cb670b1-b4e5-457f-8137-886dd6a217b5"
msgid ""
"\"The strength of our guard does not lie in its ability to track down "
"potential criminals and catch them ahead of time. But our guard can capably "
"cast a net over the whole city and maintain constant control over multiple "
"remote locations. And if the Golden Shields can help us make the net even "
"stronger, and guard all entrances and exits from the city even more "
"thoroughly...\""
msgstr ""
"\"우리 경비들의 힘은 잠재적 범죄자들을 추적한 후 한발 먼저 체포하는 능력에 있지 않습니다. 하지만 도시 전체에 그물망을 펼쳐서 많은 "
"구역을 지속적으로 장악할 수는 있습니다. 거기에 만약 골든 쉴드가 도와준다면 그물망을 더 촘촘하게 만들뿐만이 아니라,모든 도시의 출입구를 "
"더 철저하게 지킬 수 있을겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0023_Text
#. Speaker : Regongar_Companion
msgctxt "365402d1-dcb4-4711-88df-4b04930f4f24"
msgid ""
"\"Even if Wigmold tells us where to look for the barbarians, even our "
"fastest guards wouldn't be able to intercept them quickly enough. Our boys "
"can block off several streets at a time, and stay on post day and night – "
"and thoroughly pat-down everyone entering and leaving the city... My fat-"
"arsed oafs barely remember how to walk. You think they'll be more effective "
"staring at crystal balls instead of patrolling the streets? Ha! We'll be "
"better off with the Golden Shields.\""
msgstr ""
"\"어디서 야만인을 찾아야할지 위그몰드가 말해준다 한들, 제일 빠른 경비들도 시간 맞춰 처리할 만큼 빠르지는 않아. 하지만 우리 애들은 "
"여러 거리를 동시에 차단 할 수 있어, 그리고 밤낮으로 눌러 앉을 수 있다고. 그 다음에 도시를 출입하는 모든 사람을 철저하게 몸수색 할 "
"수도 있지... 내 살찐 멍청이들은 걷는 법도 겨우 기억해. 그 놈들이 순찰보다 수정구를 더 잘들여볼거라고 생각해? 하! 황금 방패단이 "
"더 나을거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0024_Text
#. Speaker : Capital_Kesten
msgctxt "fb7576bf-334c-4f2d-b8bf-4a72525f4af7"
msgid ""
"\"The big one is Roham Orand, justiciar of Abadar and captain of the Golden "
"Shields. She guarantees that if her people go on patrol with our guards, "
"they'll pounce on the trouble-makers as soon as they enter the city. And… "
"ahem… that's Wigmold Smegglyduddn. He says he'll install a magical "
"surveillance and prevention system that will allow us to locate and "
"neutralize those barbarians before they can even get close to the city walls."
"\""
msgstr ""
"\"로함 오란드가 거물입니다. 아바다르의 법투사이자 골든 쉴드의 대장입니다. 로함이 보장했습니다. 만약 우리 경비들과 골든 쉴드가 같이 "
"순찰하게 되면, 골칫거리들을 골든 쉴드가 도시에 들어오는 대로 물어다 주겠다고 말입니다. 그리고... 어험... 위그몰드 "
"스메글리다든입니다. 위그몰드는 마법 감시 시스템을 설치해주겠다고 합니다. 야만인들이 도시 벽에 접근하기도 전에 위치를 알려줘서 무력화 "
"하도록 도와주는 장비라더군요. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0025_Text
#. Speaker : Regongar_Companion
msgctxt "f0cf49e1-e07c-4e40-9345-346570f1ebc7"
msgid ""
"\"There's a couple folks ready and waiting to help us out. You just gotta "
"pick which one gets the job. Meet Roham, a justiciar of Abadar — her band, "
"the Golden Shields, promises to stand guard at every city gate and catch our "
"unwashed friends within a fortnight. And there's... what was his name, damn "
"it... Ah, ha ha, Wigmold. He's ready to set up a magical surveillance system "
"of his own invention in the Capital. With that we'll be able to catch both "
"the barbarians and any other undesirables, ha ha hmm...\""
msgstr ""
"\"우리를 도와주려고 준비된 채로 기다리는 한 쌍이 있어. 누가 일을 할 지 선택하면 돼. 아바다르의 법관투사 로함과 그녀의 수하인 황금 "
"방패단이야. 모든 도시 출입구를 경비해서 구리구리한 친구들을 2주일 내에 잡아주겠다고 공언했어. 그리고... 아 이름이 뭐였지, "
"젠장... 아, 하하, 위그몰드. 자기 발명품인 마법 감시 시스템을 수도에 설치할 준비가 되어있다더군. 그걸로 야만인하고 그 외 다른 "
"불청객 모두를 잡을 수 있을거라던데, 하 하 흠... \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0031_Text
#. Speaker : RankUp_Roham
msgctxt "411e7db0-e1d0-4b08-a666-69b53455f20c"
msgid "{n}Roham bows courteously.{/n}"
msgstr "{n}로함이 공손하게 허리를 숙입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0032_Text
#. Speaker : RankUp_Roham
msgctxt "cc0e7703-a386-4fa0-bbf9-9b7b3837b6d2"
msgid ""
"{n}The captain's face lights up with a barely visible smile.{/n} \"Thank "
"you, Your Highness. We will justify your trust in us.\""
msgstr "{n}대장의 얼굴에 희미한 미소가 피어납니다.{/n} \"감사합니다, 전하. 믿음에 보답도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0033_Text
#. Speaker : RankUp_Vigmold
msgctxt "99451ff2-dde0-49ac-bbcf-141d72420462"
msgid ""
"\"Aha! And there you have it!\" {n} The gnome gleams with happiness. It "
"seems like he's barely holding back from sticking his tongue out at "
"Roham.{/n} \"An excellent choice, Your Highness! I promise, you will always "
"remember old Wigmold with gratitude!\""
msgstr ""
"\"아하! 바로 그겁니다!\" {n} 노움이 행복으로 빛납니다. 노움은 로함에게 혀를 쭉 내미려는 것을 가까스로 자제하고 있는 것 "
"같습니다.{/n} \"현명한 선택이십니다, 전하! 약속드리건데, 이 늙은 위그몰드를 언제나 괜찮게 생각하시게 될겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0034_Text
#. Speaker : RankUp_Vigmold
msgctxt "909c0282-087c-4c7e-97e2-454241647f9b"
msgid ""
"{n}Wigmold lowers his heavy gaze in a farewell bow. Even his bracelets seem "
"to clink more sadly.{/n}"
msgstr "{n}위그몰드는 작별 인사를 하면서 그의 무거운 시선을 내립니다. 팔찌의 달그락 소리조차도 더 슬프게 들립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0076_Text
#. Speaker : RankUp_Roham
msgctxt "acf212b1-9475-4fb0-bd14-1e1a59673b5c"
msgid "\"How may I help?\""
msgstr "\"어떻게 도와줄까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0077_Text
#. Speaker : RankUp_Vigmold
msgctxt "c54a8298-5c06-4ce9-a102-08007adf454d"
msgid ""
"{n}The aged gnome bows long and deep, as the many bracelets on his wrists "
"chime softly. The expensive cloth and elegant cut of his robe would be the "
"envy of any metropolitan dandy, though few would dare leave the house draped "
"in such bold colors.{/n} \"Wigmold Smegglyduddn, the finest magical "
"surveillance system specialist from Druma to Brevoy. At your service!\""
msgstr ""
"{n}늙은 노움이 길고 깊게 조아립니다. 손목의 수많은 팔찌가 부드럽게 울리고, 값비싼 천과 우아하게 재단된 그의 로브는 도시의 많은 "
"멋쟁이들이 질투할 정도입니다. 오직 소수의 사람만이 이런 과감한 색깔을 걸치고 집에서 나설것입니다.{/n} \"위그몰드 스메글리다든, "
"드루마에서 브레보이까지 당도한 최고의 마법 감시 시스템 전문가. 여기 대령했나이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0078_Text
#. Speaker : RankUp_Vigmold
msgctxt "578a8ffe-699a-436e-8a3e-6daecd0a80f2"
msgid "\"At your service!\""
msgstr "\"분부대로 하겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0081_Text
#. Speaker : RankUp_Vigmold
msgctxt "44c63bcf-989b-43c9-bbeb-3b655a612c68"
msgid ""
"{n}Wigmold bows deeply, and the hall is once more filled with soft "
"clinking.{/n}"
msgstr "{n}위그몰드가 깊게 조아립니다.그리고 알현실은 다시금 부드러운 달그락 소리로 가득찹니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0083_Text
#. Speaker : RankUp_Vigmold
msgctxt "647e353b-d044-4094-b59a-87d9cc2a0944"
msgid ""
"\"Life in Druma is most remarkable, but it grows dull quite quickly. The "
"constant struggle for power and gold is wearisome. I felt a lack of "
"spontaneity, of unpredictability, of strong feelings and grand gestures… In "
"other words, all those things that are so abundant in your lands.\" {n}For a "
"second the gnome loses himself as he gazes dreamily into the distance.{/n}"
msgstr ""
"\"드루마에서의 삶은 놀랍습니다만, 금세 따분해집니다. 계속해서 부와 권력을 갈망하는 것은 지루한 일이지요. 즉흥성, 불확실성, 강렬한 "
"감정 그리고 과단성이 결핍됐다고 생각했습니다... 다시 말하자면, 이 모든 것들이 전하의 영지에서는 넉넉합니다.\" {n}찰나의 시간동안 "
"노움은 먼 곳을 바라보며 상념에 잠깁니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0085_Text
#. Speaker : RankUp_Vigmold
msgctxt "ce3eebc9-6909-4b7a-8911-0dbb05338bf6"
msgid ""
"\"Your Highness wishes to learn of Druma?\" {n}The gnome smirks.{/n} \"'Tis "
"a land most striking, for its people worship not the gods, but trade and "
"prosperity. Nearly all the people of Druma follow the Prophesies of "
"Kalistrade — a philosophy that preaches severe abstinence, and professes "
"that the acquisition of wealth is the purpose of life.\""
msgstr ""
"\"전하께선 드루마에 대해 알고 싶으십니까?\" {n}노움이 히죽히죽 웃습니다.{/n} \"'신이 아니라 상업과 번영을 믿는 자들에게는 "
"딱 맞는 땅입니다. 드루마의 거진 모든 사람들이 칼리스트레이드의 예언을 믿고 있지요. 엄격한 금욕에 대해 설교하고, 삶의 목적은 부의 "
"획득이라고 주장하는 철학입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0086_Text
#. Speaker : RankUp_Vigmold
msgctxt "9b46b1bc-4283-4c41-987f-edef30533f2c"
msgid ""
"\"They respect law and order, but never choose sides in the universal battle "
"between good and evil. They follow a strict diet and refuse themselves basic "
"comforts, even though they could afford to drown themselves in luxuries. "
"They maintain ritual purity, only draping themselves in white colors and "
"wearing elbow-length gloves to avoid any physical contact with infidels. It "
"is considered a virtue to never give to charity, and those who acquire "
"wealth despite their superiors' efforts are rewarded.\""
msgstr ""
"\"드루마 사람들은 법과 질서를 존중합니다만, 선과 악이라는 가치관 싸움에서 절대 어느 한쪽을 편들지 않습니다. 그들 스스로 사치와 빠질 "
"능력이 되지만, 식사도 검소하게 하고 향락을 추구하지 않습니다. 종교적인 순수성도 유지하고 있습니다. 하얀색 옷만 입고 팔꿈치까지 닿는 "
"장갑을 끼고 이교도들과 물리적 접촉을 피합니다. 절대 기부하지 않는 것 그리고 우수한 사람의 노력에도 불구하고 부를 쟁취하는 사람이 "
"보상받는 것을 미덕으로 여깁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0089_Text
#. Speaker : RankUp_Vigmold
msgctxt "58de5232-e50c-4508-a922-e2966770e33f"
msgid ""
"\"Your Highness's interest flatters me, but I'm afraid that I would be "
"ruining myself if I were to surrender the details. It's a trade secret, you "
"see. I can only say that it is my own design, which has allowed me to "
"radically increase the zone of control compared to my competitors' products. "
"While many of the usual charms can capably detect a breach and send out the "
"alarm within one or two buildings, my system is capable of covering several "
"districts... and a whole city if necessary!\""
msgstr ""
"\"전하의 관심이 절 추켜올리게 합니다만, 유감스럽게도 세부 사항을 말씀드리느니 그냥 자리를 피하겠습니다. 아시다시피, 기업 비밀입니다. "
"저의 고유 설계에 대해 말씀 드릴수 있는 것은 이것 뿐입니다. 제 경쟁자의 설계보다 활성 구역이 월등하게 넓다는 것이지요. 대다수의 "
"일반적인 마법들도 건물 한두 개 범위내에서는 범죄를 탐지하고 경보를 울릴 수 있습니다. 하지만 제 시스템은 구역 몇 개를 덮을 수 "
"있습니다... 만약 필요하다면 도시 전체도요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0090_Text
#. Speaker : RankUp_Vigmold
msgctxt "5da61230-3436-4a8c-924d-f920f98f5c8a"
msgid ""
"\"My enterprise offers a full range of services in security assurance! If "
"you install one of my magical surveillance complexes, you will always know "
"who enters or leaves the contractually determined zone of control, as well "
"as when they enter and leave, and even — for a price — why.\""
msgstr ""
"\"제 사업은 폭 넓은 보안 보장 서비스를 제공합니다! 만약 제 마법 감시 구조물을 설치하시게 되면, 보장받으신 활성 구역에 누가 "
"들어오고 나가는지 언제나 아실 수 있을 겁니다, 입출입 시기도 그렇고요, 그리고 — 왜 비싼지까지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/Rank9/Main/Cue_0091_Text
#. Speaker : RankUp_Vigmold
msgctxt "6fb9e021-d65f-42d1-8b8f-420e4a222219"
msgid ""
"\"In Druma, my systems were in high demand from both law enforcement, who "
"needed to keep the town hall and prison under constant surveillance, and "
"countless private clients. I've experience working with banks, jewelery "
"stores, art galleries…\""
msgstr ""
"\"제 시스템은 마을 회관과 감옥을 항상 감시해야 하는 법 집행기관 그리고 수많은 개인 고객들 모두에게 강한 수요가 있었습니다. 저는 "
"은행, 보석상 그리고 미술관하고 일해봤지요... \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Confidants/Stability/StabilityUnrestMod_String
msgctxt "1bc3ce57-6903-4c24-b545-0f1e2855fe06"
msgid "Stability rank increase"
msgstr "치안 등급 상승"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0004_AlignmentShift.Description
msgctxt "1d8cc920-3726-46dc-9429-94983d93cdbb"
msgid "Killed the cultists for their evil ways."
msgstr "광신자들을 그들의 사악한 방식대로 죽였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0004_Text
msgctxt "20894009-b202-48e2-b629-0cc945e33cc5"
msgid "[Attack] \"You will pay for what you've done!\""
msgstr "[공격] \"네 놈이 한 짓의 대가를 치러라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0005_AlignmentShift.Description
msgctxt "35736538-f594-4a20-a7c3-65e69420a672"
msgid "Killed the cultists for your personal enjoyment."
msgstr "광신자들을 당신의 개인적인 만족을 위해 죽였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0005_Text
msgctxt "01da189d-7310-417c-b40e-81644bde0705"
msgid "[Attack] \"It is my will that you die!\""
msgstr "[공격] \"네놈이 죽는게 내가 바라는 바다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0006_Text
msgctxt "5dcd4106-9425-488e-a363-d57a058f5c78"
msgid "\"Who are you? What kind of ritual are you planning to hold here?\""
msgstr "\"당신은 누구십니까? 여기서 어떤 의식을 치루려고 하고 있는겁니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0007_Text
msgctxt "73bd0545-4d9d-47b3-9e6c-3e86a8c261b0"
msgid "\"Why me?\""
msgstr "\"왜 나입니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0008_AlignmentShift.Description
msgctxt "1477b3e8-c227-490d-9387-0f1af4c6d0da"
msgid "Refused to participate in the ritual of the Abraxas cultists."
msgstr "아브락사스의 광신자 무리의 의식에 참가하는 것을 거부했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0008_Text
msgctxt "83bba604-5244-4744-9bb3-219cef435503"
msgid "\"I'm not going to take part in your disgusting ritual!\""
msgstr "\"나는 당신네 역겨운 의식에 참가하지 않을 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0009_Text
msgctxt "407a3304-119d-4506-84c1-9ba67987b6d6"
msgid "\"Who is Abraxas?\""
msgstr "\"아브락사스가 누구입니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0010_AlignmentShift.Description
msgctxt "9e401b09-dd76-4b5e-82fb-c3df12cf6a06"
msgid "Agreed to become a vessel for Abraxas' knowledge."
msgstr "아브락사스의 지식을 담는 그릇이 되는 것에 동의했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0010_Text
msgctxt "7a0a3797-4aa5-4d04-a28e-4b2807844291"
msgid "\"I am ready to become the vessel for the wisdom of Abraxas.\""
msgstr "\"아브락사스의 지혜를 위한 그릇이 될 준비가 되었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0014_Text
msgctxt "29b94b01-4ad3-404f-a872-dd4ceefc9697"
msgid "\"You are guilty of the abduction and death of new-born children!\""
msgstr "\"당신은 신생아들을 납치하고 살해한 범죄자입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0020_Text
msgctxt "9b61a1ac-19d0-4899-8837-11dd177c14b0"
msgid "\"I'm leaving now.\""
msgstr "\"나는 이제 떠나겠소.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0022_AlignmentShift.Description
msgctxt "36364e9b-8476-41b8-8396-10c9dae2e935"
msgid "Agreed to become a vessel for Abraxas' knowledge."
msgstr "아브락사스의 지식을 담는 그릇이 되는 것에 동의했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0022_Text
msgctxt "71191071-8e29-4e57-9924-17738ff66b17"
msgid "\"All right, I will accept the gift of Abraxas.\""
msgstr "\"좋습니다, 나는 아브락사스의 선물을 받겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0023_AlignmentShift.Description
msgctxt "9c75770f-706b-4338-a986-c57476ff03fb"
msgid "Refused to participate in the ritual of the Abraxas cultists."
msgstr "아브락사스의 광신자 무리의 의식에 참가하는 것을 거부했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Answer_0023_Text
msgctxt "41bf1e93-e118-4cf2-bf0c-b67d2bc968f3"
msgid "\"I'm not going to take part in this filth.\""
msgstr "\"나는 이 역겨운 짓거리에 함께하지 않을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Barks/Cultist_Attack_01_String
msgctxt "88c2cdab-28dd-4991-9911-83b3681aa965"
msgid "\"Death to the renegade!\""
msgstr "\"배신자에게 죽음을!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Barks/Cultist_Attack_02_String
msgctxt "ea1a76a0-0bf1-400a-af66-20e4ddb48d09"
msgid "\"Traitor!\""
msgstr "\"반역자!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Barks/Cultist_Entry_01_String
msgctxt "d21bf6a0-6a2f-49cd-8734-8e10f93c522b"
msgid "\"{mf|He|She}'s here!\""
msgstr "\"{mf|그|그녀}가 여깄다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Barks/Cultist_Entry_02_String
msgctxt "2f44351c-0ad2-45ed-9f91-96f7f6726b2a"
msgid "\"Look! It's the chosen one!\""
msgstr "\"봐! 선택된 자다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Barks/Cultist_Entry_03_String
msgctxt "96813b6d-21fc-4c2f-a4c1-43c8ca8b6fd7"
msgid "\"The will of Abraxas will be fulfilled at last!\""
msgstr "\"아브락사스의 의지가 마침내 이뤄지는구나!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Cue_0001_Text
msgctxt "bff17b5e-19d4-4fba-9825-7919e2a24c15"
msgid "\"You have finally come, the Named.\""
msgstr "\"마침내 오셨군요, 이름지어진 자여.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Cue_0002_Text
msgctxt "90553755-ec7e-4c6a-be65-c24383987ea2"
msgid ""
"{n}The elf looks at you with expectation from under his hood, and speaks "
"almost impatiently.{/n} \"We are ready. Command us to begin, and we shall "
"fulfill the will of our master, the Named. The ritual that will bind you to "
"Abraxas may be carried out at any moment.\""
msgstr ""
"{n}그 엘프는 그의 후드 아래로, 당신을 기대감을 가지고 바라보더니, 안달난 듯 말했습니다.{/n} \"저희는 준비되었습니다. 시작을 "
"명해주시길, 그러면 저희는 우리 주인, 이름지어진 자의 뜻을 완수될 수 있도록 할 것입니다. 당신과 아브락사스를 묶는 의식은 언제라도 "
"시행될 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Cue_0011_Text
msgctxt "5fbd0da9-3ab8-447f-8688-2e4bd871dfb4"
msgid ""
"\"You were chosen by Abraxas himself. The signs showed us the way. Your "
"deeds are proof to any with eyes to see: here is the one who knows no "
"boundaries! Here is the vessel worthy of the forbidden knowledge possessed "
"by the blackest and cruelest of demons. Tales of your glory has reached "
"Abraxas — and he led us here to prepare the ritual and await your coming.\""
msgstr ""
"\"당신은 아브락사스께서 직접 선택하셨습니다. 징조가 저희에게 길을 보여주었습니다. 당신의 업적은 여기에 한계를 모르는 자가 있다는 것을 "
"눈으로 보게끔 증명해주었습니다! 여기 가장 어둡고, 잔혹한 데몬들이 보유했던 금지된 지식을 담을 가치가 있는 그릇이 있습니다. 당신의 "
"영광된 이야기들이 아브락사스에게 닿았고, 그분께선 우리로 하여금 의식을 준비하고, 당신께서 오시게끔 기다리게 하셨습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Cue_0012_Text
msgctxt "9c91b04c-99b0-4abe-97c4-8a88ff50bbb2"
msgid ""
"{n}The elf lowers his head.{/n} \"You joke with us, the Named. We are the "
"hand of Abraxas, Master of the Final Incantation and keeper of forbidden "
"knowledge. We are the ones who shall led the way for the Named, who will "
"embody the wisdom of our lord.\""
msgstr ""
"{n}그 엘프는 그의 고개를 낮추었습니다.{/n} \"저희에게 장난을 치시는 군요, 이름지어진 자여. 저희는 최후의 주문의 주인이시자 "
"금지된 지식의 보관자이신 아브락사스의 손입니다. 저희는 우리 주의 지혜를 체현하실 이름지어진 자를 이끌고자 하는 이들입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Cue_0013_Text
msgctxt "a48939f1-5672-4b04-92ef-5775df2958ee"
msgid ""
"\"The great lord of the {g|Abyss}Abyss{/g}, more ancient than the world "
"itself. Witness to history, he discovered mysteries long buried under the "
"ashes of ages. His mind stores forbidden knowledge which he is ready to "
"share with his chosen ones – those who have no fear of his gift. And he has "
"chosen you, the Named.\""
msgstr ""
"\"이 세계보다 더 오래된, {g|Abyss}어비스{/g}의 대군주. 역사의 목격자인 그분께선 시대의 잿더미 아래 오랫동안 뭍혀있던 "
"신비를 발견하셨습니다. 그분께선 그의 선물을 두려워하지 않는 그분께서 선택한 이에게 그의 머릿속에 있는 금지된 지식을 나누어 주실 준비가 "
"되셨습니다. 그리고 그분은 당신을 선택하셨습니다, 이름붙여진 자여.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Cue_0015_Text
msgctxt "e27b7652-619b-4335-8eda-274a1e62e73e"
msgid ""
"\"For such is the will of our lord.\" {n}The elf sighs, as if gathering his "
"strength.{/n} \"We mustn't waste time: we have prepared for your arrival, o "
"the Named. We are ready. Are you?\""
msgstr ""
"\"이것이 우리 주의 뜻이라면.\" {n}엘프는 그의 힘을 모으듯, 한숨을 쉬었습니다.{/n} \"저희는 시간을 낭비해서는 안됩니다. "
"저희는 당신의 도착을 기다렸습니다, 오 이름지어진 자여. 우리는 준비되었습니다. 당신은 어떠신지요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Cue_0016_Text
msgctxt "9bf626f0-8b15-4732-9c40-059b9e1bef98"
msgid ""
"{n}The elf looks up, his voice is trembling with anticipation.{/n} \"Then "
"step into the magic circle, the Named, and accept your fate!\""
msgstr ""
"{n}엘프는 고개를 들고, 그의 목소리는 기대감으로 떨렸습니다.{/n} \"그러면 이 마법진 안으로 오시지요, 이름지어진 자여, 그리고 "
"당신의 운명을 받아들이십시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Cue_0017_Text
msgctxt "08119cdf-7d8d-4ee2-8d1a-9e29bc7b3bd1"
msgid ""
"\"There's no soul blacker than yours in all of Avistan. You came here "
"following the trail of innocent blood. You are ready to accept the gift of "
"Abraxas. As soon as we begin reading the spell, step into the circle — and "
"your mind will become a vessel of power unknown to all of Golarion! Abraxas "
"himself will share his wisdom with you and bestow upon you knowledge other "
"mortals can only dream of!\""
msgstr ""
"\"온 아비스탄전역에서 당신보다 더 검은 영혼을 가진이는 없을 것입니다. 당신은 이곳까지 무고한 피의 흔적을 쫓아왔습니다. 당신은 "
"아브락사스의 선물을 받아들일 준비가 되 있습니다. 우리가 주문을 외자마자, 이 원 안으로 몸을 들이면, 당신의 정신은 골라리온 어디에서도 "
"알려지지 않은 힘을 담을 그릇이 될 것입니다! 아브락사스께서는 그의 지혜를 당신과 나누시고 다른 필명자들이 오직 꿈꿔왔던 지식을 부여받을 "
"것입니다.!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Cue_0018_Text
msgctxt "39b261d1-b8ea-41c2-9b41-012059c31a24"
msgid ""
"{n}The elf hisses through his teeth.{/n} \"False prophet! We will wash away "
"this insult with your blood!\""
msgstr "{n}엘프는 그의 이 사이로 쉿소리를 냈습니다.{/n} \"거짓된 선지자! 네 놈의 피로써 이 모욕을 씻어낼 것이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Cue_0019_Text
msgctxt "d3a7561d-881d-4b73-bcc0-1dcb971d3999"
msgid ""
"{n}The light in your eyes dims, and your mind is filled with a horrendous "
"torrent of noise, which threatens to crack your skull open from the inside. "
"You try to move, but your body refuses to obey. You are bound by another's "
"will. Through the excruciating pain that pulses in your temples, you sense a "
"strange, dark presence.{/n}"
msgstr ""
"{n}당신의 눈 앞이 희미해지고, 당신의 머리 속은 마치 두개골 안에서부터 깨고 나오려는 듯한 끔찍한 잡음들의 급류로 채워집니다. 당신은 "
"움직이려 해 보았지만, 당신의 몸은 따르기를 거부했습니다. 당신은 또 다른 의지에 의해 지배되었습니다. 당신의 관자놀이에 요동치는 고통을 "
"통해, 당신은 이상하고 어두운 존재를 느겼습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Cue_0021_Text
msgctxt "494bb54f-266b-4d06-867b-633716c75967"
msgid ""
"\"You cannot just turn away from your fate, the Named. Accept your fate – or "
"pay for your deception with blood!\""
msgstr ""
"\"당신은 운명을 거부할 수 없습니다, 이름지어진 자여. 당신의 운명을 받아들이거나 아니면 당신의 피로써 당신의 기만의 댓가를 치루십시오!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Cue_0024_Text
msgctxt "9c81bdd2-fcee-4605-995d-348c164a063a"
msgid ""
"{n}The deafening noise begins to fade, and the pain in your temples "
"diminishes. You catch echoes of strange thoughts and knowledge in languages "
"you do not speak, too complex and strange for you to comprehend. At last you "
"feel the farewell touch of the evil being that only a moment ago fully "
"possessed you. The strange mind, having bestowed its gift upon you, leaves "
"you with his final message.{/n}"
msgstr ""
"{n}귀가 먹을 것 같은 소음이 줄어들기 시작하고, 당신의 관자놀이에 충격이 가셨습니다. 당신은 당신이 말할 줄 모르는 언어로 되어있는, "
"너무 복잡하고 이상해서 당신이 이해할 수 없는 이상한 지식과 생각들의 메아리를 잡았습니다. 마침내 당신은 당신을 한 순간 완전히 "
"통제했었던 사악한 존재의 작별의 손길을 느꼈습니다. 당신에게 그것의 선물을 준, 그 이상한 존재는 당신에게 마지막 메세지를 남기고는 "
"떠났습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep2_Encounter/Cue_0025_Text
msgctxt "31df1d0b-23c1-4e29-a747-6b777c588168"
msgid "\"...kill... them... all...\""
msgstr "\"...모두...죽여라...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Answer_0005_Text
msgctxt "e9263e7d-9f37-4b22-8d0c-1d15705d029f"
msgid "\"What brought you here from Nex to the Stolen Lands?\""
msgstr "\"무슨 연유로 넥스에서 도둑맞은 땅으로 왔지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Answer_0006_Text
msgctxt "3ee3f7a3-6eb5-4e05-a307-28d144d4eb42"
msgid "\"Don't be afraid of me. Just tell me why you're here.\""
msgstr "\"두려워하지 마라. 그저 여기 왜 왔는지만 말하도록.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Answer_0007_Text
msgctxt "f62526c0-2e27-4139-98d1-40decdc21728"
msgid "\"I don't want to waste my time on you. Guards, take him away!\""
msgstr "\"너에게 시간을 더 낭비하지는 않겠다. 경비, 그를 끌고가라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Answer_0014_Text
msgctxt "9a41fbf7-3431-4647-a60e-13370162f353"
msgid "\"What will I gain by building this vault?\""
msgstr "\"이 볼트를 만들면 나는 무엇을 얻을 수 있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Answer_0015_Text
msgctxt "565b488a-5389-4418-b8e9-a71a5776d0f0"
msgid ""
"\"You have my consent. Tell your brothers that I will need their help.\""
msgstr "\"허락한다. 형제들에게 내가 도움이 필요하다고 알리도록.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Answer_0016_Text
msgctxt "ca5e185d-cf6e-4a6d-a0dd-563ebaeff660"
msgid ""
"\"The dark knowledge placed in my head will pass into eternity along with "
"me. Take your blueprints and go home.\""
msgstr "\"내 머릿속의 검은 지식은 나와 함께 영면에 빠질 것이다. 네 청사진을 챙겨서 집으로 돌아가도록.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Answer_0022_Text
msgctxt "f37cd06a-0d4a-4f47-a3b2-f4a27cdae498"
msgid "\"Why do you think I need any help?\""
msgstr "\"왜 내가 도움이 필요하다고 생각하지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0001_Text
msgctxt "a2069ddb-f702-42e8-b483-efcd50f7afb1"
msgid ""
"{n}This dark-skinned, wily halfling is quite different from his kin who "
"you've met in the {g|Stolen Lands}Stolen Lands{/g}. He's constantly looking "
"around, even beneath his feet, and rubbing his palms together as if the "
"action is about to commence.{/n}"
msgstr ""
"{n}이 검은 피부의 약삭빠른 하플링은 {g|Stolen Lands}도둑맞은 땅{/g}에서 당신이 만나본 친척들과는 상당히 다릅니다. "
"그는 주위를 계속 둘러보고 있습니다, 그의 발밑 조차 예외는 아닙니다. 그리고 무슨 일이라도 날 것처럼 손바닥을 계속 비비고 "
"있습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0002_Text
msgctxt "3657c0bb-c071-402b-9ed3-bfc838d1f8ab"
msgid ""
"{n}The halfling dares to look up at you — and you see servile admiration in "
"his eyes.{/n} \"{mf|Your Illustrious Grace|Your Illustrious Grace|Your "
"Resplendent Highness|Your Resplendent Highness}, what... what an honor to "
"meet you in person!\""
msgstr ""
"{n}하플링이 용기를 내어 당신을 쳐다봅니다. 그리고 당신은 그의 눈빛에서 감미로운 찬사를 느낍니다.{/n} \"{mf|찬란한 영주님|"
"찬란한 영주님|찬란한 전하|찬란한 전하}, 지...직접 뵙게 되어 영광입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0003_Text
msgctxt "eaeff5d9-af3e-4809-9b2f-cc46a3246b5c"
msgid ""
"\"I have just arrived from Quantium, the capital of faraway Nex. I am sure "
"you have heard of this land... Ah, but of course you know all about the "
"place where they store... where they cherish – as the apple of their eye...\""
" {n}The halfling becomes confused and licks his lips nervously.{/n} \"Forgive"
" me... my words fail me. In your presence I feel as a wretched worm, "
"unworthy of even your casual glance!\""
msgstr ""
"\"저는 먼 넥스의 수도인 콴티움에서 막 도착했습니다. 넥스에 대해서 분명 들어보셨겠죠... 아, 하지만 당신 또한 넥스인이 눈에 넣어도 "
"안 아플 것처럼 저장하는... 소중히 여기는 장소에 대해 모든 것을 알고 계실겁니다...\" {n}하플링이 혼란에 빠졌고, 그의 입술을 "
"초조하게 핥습니다.{/n} \"용서해주십시오... 제대로 말을 할 수가 없습니다. {mf|영주님|영주님|전하|전하}앞의 저는 가련한 "
"벌레여서 저를 바라보는 시선마저 받을 자격이 없습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0008_Text
msgctxt "b2488bce-2902-489f-857d-1b8de228ca18"
msgid ""
"\"I have arrived as a messenger from a small group of wizards and wise men, "
"who have devoted themselves to the search for greatness and might. Our "
"patron is the great demon lord Abraxas, Master of the Final Incantation. For "
"many years we believed that the largest collection of forbidden books and "
"ancient sources of knowledge was stored in the secret library in Quantium... "
"but then we caught news of the Named.\""
msgstr ""
"\"위대함과 힘을 찾고있는 마법사들과 현자들의 작은 집단의 전령으로서 여기 왔습니다. 저희 후원자는 최후의 주문의 지배자, 위대한 데몬 "
"군주 아브라삭스십니다. 수년간 우리는 콴티움의 비밀 도서관에 가장 많은 잊혀진 책들과 고대 지식의 원천이 저장되있다고 믿어왔습니다... "
"그러다가 이름 지어진 자의 소식을 접한겁니다..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0009_Text
msgctxt "c771d0c3-716f-4feb-9eae-64b7412254fd"
msgid ""
"{n}The halfling takes a deep breath.{/n} \"You are not only great, but "
"merciful, {mf|Your Illustrious Grace|Your Illustrious Grace|Your Resplendent "
"Highness|Your Resplendent Highness}. Lucky are those who you command!\""
msgstr ""
"{n}하플링이 숨을 깊게 고릅니다.{/n} \"위대하신 것 뿐만 아니라 자비롭기까지 하시군요, {mf|찬란한 영주님|찬란한 영주님|찬란한 "
"전하|찬란한 전하}. {mf|영주님|영주님|전하|전하}의 종복들은 행운아입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0010_Text
msgctxt "52fb9322-c6a0-4197-b640-dfaf52d5789b"
msgid ""
"{n}The halfling drops to his knees and prostrates himself before you.{/n} \"I"
" beg you, just a moment of your time! Give this poor soul a chance to "
"perform a sacred duty, which I owe to my brothers in faith!\""
msgstr ""
"{n}하플링이 무릎을 꿇고 당신에게 절을 합니다. {/n} \"잠시만 시간을 주실 것을 간청드립니다! 신앙의 벗들이 맡긴 이 신성한 "
"의무를 수행할 기회를 불쌍한 영혼에게 주십시요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0011_Text
msgctxt "29d0d056-f870-4990-baf6-7eeacb2e5170"
msgid ""
"\"The messengers of Abraxas informed us that a ruler of a faraway land had "
"become the keeper of knowledge, bestowed upon {mf|him|her} by the Master of "
"the Final Incantation himself. We know that your mind has become a vessel, "
"but understanding all that is stored within it – this would require "
"ciphers... and the will of Abraxas...\""
msgstr ""
"\"아브라삭스의 전령들이 먼 땅의 통치자가 최후의 주문의 지배자께서 직접 지명한 지식의 관리자가 되었다고 전해왔습니다. "
"{mf|영주님|영주님|전하|전하}의 정신이 그릇이 되었다는 것을 알고 있습니다만, 그 그릇에 담긴 것을 이해하는 것은 해독자를 필요로 "
"합니다... 아브라삭스의 의지도 마찬가집니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0012_Text
msgctxt "d5a3ee9b-d05e-49a9-8167-9320fa8785fd"
msgid ""
"\"I was sent to propose to you...\" {n}The halfling pulls out a roll of "
"leather.{/n} \"These are the blueprints of a vault, similar to the one in "
"Quantium. Its special chambers are designed to explore the forbidden... and "
"summon those who can help decode signs and symbols which our limited mind "
"has no power over. The servants of Abraxas are cruel, but they open doors to "
"places which the weak of spirit and mind cannot reach.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}께 제안을 하려고 보내졌습니다.\" {n}하플링이 가죽 두루마리를 꺼냅니다.{/n} \"이건 볼트의 "
"청사진입니다. 콴티움의 도서관하고 유사하지요. 이 볼트는 잊혀진 자를 탐구하기 위해서 고안된 특수 시설입니다... 그리고 우리의 미천한 "
"정신으로 이해할수 없는 징조와 상징들을 해독할 수 있는 자들을 소환하도록 고안되었죠. 아브라삭스의 하수인들은 잔혹하지만, 그들은 약한 "
"영혼과 정신이 닿지 못하는 곳에 문을 엽니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0017_Text
msgctxt "2b7db5c2-af22-431b-9184-042019d7decc"
msgid ""
"\"We... that is, you will have a chance to comprehend the essence of the "
"gift that was bestowed upon you by Abraxas. The demon lord selected you for "
"a reason: your very being is similar to his own. The only thing that remains "
"is to extract his knowledge... line by line, image by image... and "
"comprehend what has been hidden from mortal eyes for ages! Just imagine the "
"power that awaits you!\""
msgstr ""
"\"우리는... 이겁니다. {mf|영주님|영주님|전하|전하}께선 아브라삭스께서 주신 선물의 정수를 이해하실수 있게 될 겁니다. 데몬 "
"군주께서 당신을 택한 이유는: 당신의 존재 자체가 아브라삭스님과 유사하기 때문입니다. 남은 일은 그의 지식을 뽑아내는 것 뿐입니다... "
"구절 하나하나, 형상 하나하나... 그리고 필멸자에게 오랫동안 감춰져왔던 지식을 이해하는 겁니다! 어떤 힘이 당신을 기다릴지 상상해 "
"보십시요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0018_Text
msgctxt "841e487a-b6b0-44da-a509-cfb6a89d0047"
msgid ""
"\"Oh, I assure you, {mf|Your Illustrious Grace|Your Illustrious Grace| Your "
"Resplendent Highness|Your Resplendent Highness}! Each of us will deem it a "
"great honor to serve the Named in this matter! I will give the blueprints to "
"your advisors, and set off immediately to Quantium with the good news.\""
msgstr ""
"\"오, 확언드립니다, {mf|찬란한 영주님|찬란한 영주님|찬란한 전하|찬란한 전하}! 우리 일원 모두가 이름 지어진 자의 문제를 "
"해결하는 것을 고귀한 영광으로 여기고 있습니다! {mf|영주님|영주님|전하|전하}의 보좌관에게 이 청사진을 주고 곧바로 콴티움에 이 기쁜 "
"소식을 전하러 가겠습니다..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0019_Text
msgctxt "0a3eb903-4d79-480f-9b61-d8fd9306cc6e"
msgid ""
"\"But how... How?! If you decline, no one... no one will be able to unseal "
"this box of ancient mysteries!\" {n}The halfling is almost crying.{/n} \"You "
"will thwart so much effort... So many deaths – all in vain!\""
msgstr ""
"\"하지만 어째서... 어째서?! {mf|영주님|영주님|전하|전하}께서 거절하시면, 누구도... 그 누구도 이 고대의 비밀을 풀어헤칠수 "
"없습니다!\" {n}하플링은 거의 울부짖고있습니다.{/n} \"수많은 노력을 좌절시키실겁니다... 그 많던 죽음이, 모두 허사로 "
"돌아갈겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0020_Text
msgctxt "2bba0e4b-67e0-4303-b9a8-7a2388551339"
msgid ""
"\"I will depart from your lands... but I will leave you the blueprints. "
"Perhaps one day, the thirst for knowledge will possess you once more. — As "
"it did when you first agreed to become a vessel for the mysteries of "
"Abraxas. I will pray for this day to arrive as soon as possible, and will be "
"the first to come to your call!\" {n}The halfling bows deeply and takes a "
"few steps back.{/n}"
msgstr ""
"\"{mf|영주님|영주님|전하|전하}의 땅을 떠나겠습니다... 하지만 청사진은 남기겠습니다. 언젠가, 지식의 대한 목마름이 "
"{mf|영주님|영주님|전하|전하}을 다시 사로잡을지도 모릅니다. 아브라삭스님의 신비를 품고 있는 그릇이 되기로 처음 동의했을때 "
"{mf|영주님|영주님|전하|전하}이 그러셨던 것처럼 말입니다. 그 날이 가능한 빨리 오기를 기도하겠습니다. 그리고 당신의 부름에 가장 "
"먼저 달려오겠습니다!\" {n}하플링이 깊게 조아립니다. 그리고 몇 발자국 물러섭니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0021_Text
msgctxt "62fc004e-045e-44e6-9780-8a07f0b68009"
msgid ""
"\"I look forward to the moment when the vault is completed and ready to "
"summon demons. We will do everything in our power to solve the mysteries "
"stored in your head!\" {n}The halfling bows deeply and takes a few steps "
"back.{/n}"
msgstr ""
"\"볼트가 완공되고 데몬 소환이 준비되는 순간을 고대하고 있겠습니다. {mf|영주님|영주님|전하|전하}의 머리속 신비를 풀어내기 위해, "
"저희가 가진 모든 힘을 쏟아 붓겠습니다. \" {n}하플링이 깊게 조아립니다. 그리고 몇 발자국 물러섭니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0023_Text
msgctxt "f5b044bc-9ac2-4df0-9aaf-c22cd0fd16a0"
msgid ""
"\"No offense was intended, {mf|Your Illustrious Grace|Your Illustrious Grace|"
"Your Resplendent Highness|Your Resplendent Highness}... but it will take "
"years of diligent work to understand the essence of Abraxas' knowledge. Such "
"is its nature. – And I mean knowledge laid out on paper, not hidden inside "
"someone's head!\""
msgstr ""
"\"무례하게 굴려고 했던 것은 아닙니다, {mf|찬란한 영주님|찬란한 영주님|찬란한 전하|찬란한 전하}... 하지만 아브라삭스님의 지식에 "
"담긴 정수를 이해하기 위한 작업은 빡빡한 수년이 걸릴겁니다. 자연스러운 일 입니다. 그리고 여기서 수년은 종이위의 지식을 의미하는 "
"겁니다. 누군가의 머리속에 감춰진 지식이 아니라요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CE_DarkerThanBlack/Ep3_KTC/Cue_0024_Text
msgctxt "e044799c-6cfe-4bae-9bd8-55e2a084edd5"
msgid ""
"\"You won't be able to make full use of the gift you've received the Master "
"of the Final Incantation – until you comprehend the very essence of this "
"forbidden knowledge. You could greatly benefit from us — for we have devoted "
"all our lives to the secrets of the magical sciences. You will require "
"servants of Abraxas — demons capable of lifting the veil in return for "
"sacrifice. And it will take you many years to fully embrace the powers that "
"have been bestowed upon you. You are yet far from the heights of your powers."
"\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}께선 최후의 주문의 지배자께 받은 선물을 완전하게 사용하지 못하실겁니다. 잊혀진 지식 그 자체를 "
"당신께서 이해하기 전까지는 말입니다. {mf|영주님|영주님|전하|전하}께서는 저희로부터 큰 이익을 얻으실수 있습니다. 저희는 삶을 마법 "
"과학의 비밀에 바쳤기 때문이지요. {mf|영주님|영주님|전하|전하}께서는 아브라삭스님의 하수인들도 필요로 하실겁니다. 희생을 대가로 "
"감춰진 베일을 걷어 낼수 있는 능력의 데몬들 말입니다. 그리고 당신께 주어진 힘을 모두 받아들이는 데는 많은 시간이 걸릴겁니다. "
"{mf|영주님|영주님|전하|전하}께서는 아직 그 힘의 정점과는 거리가 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Answer_0005_Text
msgctxt "7b4ab1d9-008e-4749-8518-2c9be61a5fe3"
msgid "\"Where are you from, Jase?\""
msgstr "\"어디에서 왔나, 제이스?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Answer_0007_Text
msgctxt "fe4568ec-e9a8-4ca9-ba4d-307efd5f4b49"
msgid "\"What good are shrines if we already have pubs and taverns?\""
msgstr "\"선술집과 여관이 있는데 신전이 무슨 소용이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Answer_0010_Text
msgctxt "b8916e65-f03c-4e5f-be52-fb8933cdd470"
msgid "\"Why do you propose this to me?\""
msgstr "\"이 것을 내게 왜 제안하는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Answer_0012_AlignmentShift.Description
msgctxt "a194120f-f222-4f32-b12e-f8397578b4e7"
msgid "Refused to build shrines to Desna on grounds of greed."
msgstr "탐욕을 근거로 데즈나 사원을 짓는 것을 거절했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Answer_0012_Text
msgctxt "6526539b-84c4-4e76-aba0-59fd01406719"
msgid "\"I've no wish to waste money on such nonsense.\""
msgstr "\"이런 말도 안되는 일에 돈을 낭비하기는 싫다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Answer_0013_AlignmentShift.Description
msgctxt "aae8d1cc-9f17-4b26-91e9-c33a9046c7fd"
msgid "Allowed the building of shrines to Desna."
msgstr "데즈나 사원을 짓는 것을 허락했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Answer_0013_Text
msgctxt "9f7b95c5-bd9a-42b8-8ef0-a96ae1e6db8e"
msgid "\"Building shrines is a fine idea! Of course I will help you!\""
msgstr "\"사원을 짓는 것은 좋은 생각이다! 물론 돕도록 하지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Answer_0014_AlignmentShift.Description
msgctxt "61a8167b-e0c4-4b9e-8a3d-1852873da234"
msgid ""
"Allowed the building of shrines to Desna – on the condition that their "
"visitors abiding by the law."
msgstr "방문자가 법을 준수하는 것을 조건으로 데즈나 사원을 짓는 것을 허락했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Answer_0014_Text
msgctxt "b3fe176a-2855-4308-bd5e-f1f4e7486a87"
msgid ""
"\"I will help to build these shrines, but only if those they welcome will "
"abide by my laws.\""
msgstr "\"이 사원을 짓는 것을 돕는다. 하지만 내 법을 준수하는 이만 환영받을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Answer_0015_AlignmentShift.Description
msgctxt "098975f1-ca92-4e43-a290-1fad9d89eafa"
msgid "Remained indifferent to the ideas of Desna cleric's."
msgstr "데즈나 성직자의 생각을 무시했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Answer_0015_Text
msgctxt "273b428f-ebee-4ee0-89c6-3e19699d3a14"
msgid ""
"\"I've no wish to interfere in Desna's matters. I'm sorry but I will not "
"help you.\""
msgstr "\"데즈나의 문제에 간섭할 생각은 없다. 미안하지만 돕지 않을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Cue_0001_Text
msgctxt "b5cfb1ed-02dd-423a-a8cf-9debec35a25b"
msgid ""
"{n}A middle-aged halfling woman in tattered traveling clothes bows before "
"you.{/n} \"Greetings, {mf|Your Grace|Your Grace|Your Highness|Your Highness}"
"! Thank you for agreeing to see and hear me out!\""
msgstr ""
"{n}낡아빠진 옷을 입은 중년의 하플링 여자가 당신 앞에서 조아립니다.{/n} \"반갑습니다, {mf|영주님|영주님|전하|전하}! 알현을 "
"허락해주셔서 감사드립니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Cue_0002_Text
msgctxt "c552cc25-9022-477f-8608-ea9d4a6816ac"
msgid ""
"\"My name is Jase. I am a priestess of {g|Desna}Desna{/g}, goddess of "
"travelers and luck, who accompanies us on our journeys. The fame of your "
"lands has called me to your door – with a request.\""
msgstr ""
"\"제 이름은 제이스입니다. 여행자와 여행자의 행운을 관장하는 여신,{g|Desna}데즈나{/g}님의 사제입니다. "
"{mf|영주님|영주님|전하|전하} 땅의 명성이 저의 요청과 함께 저를 부르셨지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Cue_0003_Text
msgctxt "f227e370-a3d8-470a-8553-5437ee87305e"
msgid ""
"{n}Jase folds her arms across her chest.{/n} \"{g|Desna}Desna{/g} protects "
"those who spend their night out in the open. Please help me and my "
"associates create shelters for such travelers – roadside shrines to the "
"goddess! It will not take much, but the hundreds of travelers who pass "
"through your lands will thank you in their prayers!\""
msgstr ""
"{n}제이스가 그녀의 팔을 가슴에 얹습니다.{/n} \"{g|Desna}데즈나{/g}께서 밤을 거니는 자들을 보호하십니다. 부디 저와 제 "
"동료들이 여행자들을 위한 성소를 짓는 것을 도와주세요. 길 옆의 여신의 성소지요! 엄청난 수고가 들어가는 건 아니지만, "
"{mf|영주님|영주님|전하|전하}의 영토를 지나는 수백명의 여행자들이 기도하면서 {mf|영주님|영주님|전하|전하}께 감사드릴겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Cue_0008_Text
msgctxt "cd8820bb-18a3-48ef-a616-5851ee5d344d"
msgid ""
"{n}Jase shakes her head.{/n} \"And what if the seeker has no coin? Or the "
"owner refused him entry because he had no means to wash? No, a shrine of "
"{g|Desna}Desna{/g} is more than just a hotel. It's a place where every tramp "
"is welcome, for the mistress of the shrine makes no distinction between rich "
"and poor!\""
msgstr ""
"{n}제이스가 고개를 젓습니다.{/n} \"필요로 하는 사람이 돈이 없으면요? 혹은 주인이 입구에서 씻지 않았다고 거절한다면? 안돼요, "
"{g|Desna}데즈나{/g}님의 사원은 호텔같은 곳이 아닙니다. 데즈나님의 사원은 모든 떠돌이가 환영받는 장소입니다. 여신님의 "
"사원에서는 부자와 빈자가 똑같아요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Cue_0009_Text
msgctxt "d5b5631f-9aa8-4eae-94d9-ccd02e8a1dc3"
msgid ""
"\"Making a shrine is easy, of course. — We'll build an altar, pull out some "
"stumps, clear the area — and we're done! But the unseen presence of "
"{g|Desna}Desna{/g} will remain, protecting every corner of your lands. None "
"will dare attack anyone sleeping in the shade of such a shrine!\""
msgstr ""
"\"사원을 짓는 것은 물론 쉽지요. 제단을 만들고, 그루터기 몇개를 뽑아내고, 주변을 정리하면 끝이에요! 하지만 보이지 않는 "
"{g|Desna}데즈나{/g}님의 존재는 계속 남아서 영주님의 영토 구석구석을 지켜주실겁니다. 그 누구도 사원의 그늘 밑에서 자는 사람을 "
"감히 공격하지 못해요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Cue_0011_Text
msgctxt "5d1cf309-a437-482e-80c4-049370bcc80f"
msgid ""
"{n}Jase looks at you in surprise.{/n} \"Because everyone in these lands "
"knows you are a good {mf|baron|baroness|King|Queen}! One who will protect "
"every soul, and who will not simply leave the poor and sick to fight their "
"fates alone! Your subjects follow your example, and are likewise kind and "
"hospitable. I have no doubt that {g|Desna}Desna{/g} loves you — and all "
"those who travel in your lands!\""
msgstr ""
"{n}제이스가 놀라워 하면서 당신을 봅니다.{/n} \"이 땅의 모든 이가 당신을 좋은 {mf|남작|여남작|왕|여왕}으로 여기기 "
"때문이죠! 모든 영혼을 지켜주고 빈자들과 병자들이 홀로 싸우도록 내버려두지 않는 사람! {mf|영주님|영주님|전하|전하}의 백성들은 "
"당신의 모범을 따라서 상냥하고 친절하지요. {g|Desna}데즈나{/g}께서 당신을 사랑하심은 의심의 여지가 없습니다. "
"{mf|영주님|영주님|전하|전하}의 땅을 여행하는 모든이도요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Cue_0016_Text
msgctxt "0369c7ef-d8b3-4dd8-bf70-f5bd41ab28dc"
msgid ""
"{n}Jase can't help but clap her hands joyfully.{/n} \"I knew it! I knew you "
"would agree! May {g|Desna}Desna{/g} keep you and your loved ones safe!\""
msgstr ""
"{n}제이스는 기쁘게 박수를 치지 않을 수 없습니다.{/n} \"그러실줄 알았어요! 동의하실 줄 알았다고요! {g|Desna}데즈나{/g}"
"께서 당신과 당신이 사랑하는 모든 이를 지켜주시길!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Cue_0017_Text
msgctxt "f2392473-4751-49e3-9915-b2400875af03"
msgid ""
"\"My companions and I will await your news. When you are ready, we'll begin "
"right away. You'll have shrines in all every corner of your state!\""
msgstr ""
"\"저는 동료와 연락을 기다리고 있을게요. 준비가 되면 바로 시작하죠. {mf|영주님|영주님|전하|전하}의 나라 구석구석에 사원이 "
"생기겠군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Cue_0018_Text
msgctxt "472038df-0298-4cfe-9392-12e1837cd026"
msgid ""
"{n}Jase nods seriously.{/n} \"The road tempts all kinds of travelers. But "
"are a few lost sheep reason to deny care and protection to everyone? I do "
"share your hope that evil-doers will steer clear of these lands.\""
msgstr ""
"{n}제이스가 심각하게 끄덕입니다.{/n} \"길은 모든 여행자들을 유혹하지요. 하지만 모두를 돌보고 지키는 것을 길 잃은 양 몇이 "
"거부하지요? 저도 악한자들이 이 땅에서 사라지길 당신만큼 바라고 있어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Cue_0019_Text
msgctxt "a200d12f-3b42-401f-a2d7-6e93b91371e7"
msgid ""
"{n}Jase sighs.{/n} \"Well then I won't waste any more of your time, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}. Farewell!\""
msgstr ""
"{n}제이스가 탄식합니다.{/n} \"그렇다면 더이상 {mf|영주님|영주님|전하|전하}의 시간을 낭비하지 않겠어요.작별입니다, "
"{mf|영주님|영주님|전하|전하}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep1_KTC/Cue_YazeOrigins_Text
msgctxt "a749755c-2ee9-4553-a812-c1e29f028c4e"
msgid ""
"\"From far away, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. "
"There was once a time that I, like my ancestors, served a noble family in "
"{g|Cheliax}Cheliax{/g}. But, praise {g|Desna}Desna{/g}, I escaped, and was "
"picked up by a caravan of {g|Varisia}Varisians{/g}. Ever since then, fate "
"has led me along many roads in many lands — both bad and glorious ones. And "
"truth be told, I've no wish to recollect my 'homeland'.\""
msgstr ""
"\"먼곳에서 말입니다, {mf|영주님|영주님|전하|전하}. 저도 제 선조들처럼 {g|Cheliax}첼리악스{/g}에서 귀족 가문을 섬겼던 "
"적이 있어요. 하지만, {g|Desna}데즈나{/g}를 찬앙하라, 저는 도망쳤고, {g|Varisia}바리시아{/g} 대상단에게 "
"거둬들어졌지요. 그 이후로 운명이 저로 하여금 많은 땅의 많은 길로 이끌었습니다. 나쁜 것과 영광스러운 것 모두요. 그리고 솔직히 "
"말해서, 제 '고향'에 대해서 다시 기억해내고 싶지는 않군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0004_Text
msgctxt "255c8a5e-3fa5-4a4c-b32b-20a9bd0f2df3"
msgid "\"Who are you and what caravan is this?\""
msgstr "\"자네는 누구고, 이 대상은 뭔가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0005_Text
msgctxt "2d832e6d-1f88-4c95-84e3-09ecfc9c879b"
msgid ""
"\"I've no need of dirty tramps in my {mf|barony|barony|kingdom|kingdom}. Get "
"out!\""
msgstr "\"내 {mf|남작령|남작령|왕국|왕국}에 부랑자는 필요 없다. 썩 꺼져라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0007_AlignmentShift.Description
msgctxt "1943e40f-f1d0-46ed-98f2-127943ea0615"
msgid "Drove the Varisian traveling caravan from the Stolen lands."
msgstr "바리시아 대상단을 도둑맞은 땅에서 쫓아냈습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0007_Text
msgctxt "540a859f-ed47-4b1e-b688-faee3f1c5c51"
msgid ""
"\"It doesn't matter what I thought. Your kind only brings trouble. Get out "
"of my lands!\""
msgstr "\"내가 뭘 생각했는지는 중요하지 않다. 너희 같은 족속은 문제만 일으킬 뿐이다. 내 땅에서 나가라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0008_Text
msgctxt "12ff17b0-8482-4669-a632-5780b33661e5"
msgid "\"You're right. Forgive me.\""
msgstr "\"자네 말이 맞네. 용서해 주게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0011_AlignmentShift.Description
msgctxt "b8c7efd9-8b79-4dc0-96bf-4e2aed2df48b"
msgid "Killed everyone in the Varisian traveling caravan."
msgstr "바리시아 대상단 전원을 죽였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0011_Text
msgctxt "0dd2567d-2def-4899-ac68-2c468cf7631c"
msgid "[Attack] \"Death to thieves and vagabonds!\""
msgstr "[공격] \"도적떼와 부랑자들에게 죽음을!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0012_Text
msgctxt "1af20e88-b121-49ac-b770-e4a036ff9d10"
msgid ""
"\"I'm looking for a thief who robbed a few of my subjects. The evidence says "
"he's one of yours.\""
msgstr "\"나는 내 백성들에게 강도짓을 한 범인을 찾고 있네. 자네 무리 중 한명이 그랬다는 증거가 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0015_Text
msgctxt "9c48e270-67f5-4cf6-8819-36b7bd142b79"
msgid "\"Don't mess with me, Zandu. That usually ends badly.\""
msgstr "\"날 건드리지 않는게 좋을걸세, 잔두. 좋게 끝나진 않을 테니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0016_Text
msgctxt "9ca1d364-7e1b-4a1d-ab21-d1a1e9607d6c"
msgid ""
"\"Listen, I have no wish to be your enemy. But one of your companions stole "
"something, and is now hiding in your camp!\""
msgstr "\"들어, 네 적이 되고 싶지는 않아. 하지만 네 동료 중 하나가 뭔가를 훔쳤고, 지금 네 야영지에 숨어 있다고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0017_AlignmentShift.Description
msgctxt "3a3cbe97-32af-41a4-ad0b-157610e003da"
msgid "Killed everyone in the Varisian traveling caravan."
msgstr "여행중인 바리시아 대상단 전원을 죽였다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0017_Text
msgctxt "73df73f5-a770-47b9-b552-b94f448b7292"
msgid ""
"[Attack] \"If I'm not going to get any answers — then I'll just kill you all!"
"\""
msgstr "[공격한다] \"그 누구도 답하지 않겠다면, 너희 모두를 죽이는 수밖에!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0024_Text
msgctxt "27846597-0182-44fb-9ef0-5578c6072f50"
msgid "\"Fine, don't tell me if you don't want to.\""
msgstr "\"좋아, 말 하기 싫다면 말 하지 마.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0027_AlignmentShift.Description
msgctxt "6cfe594f-5013-49d7-aa05-7286a181e1e8"
msgid "Allowed the Varisians to deal with the thief themselves."
msgstr "바리시아 인들이 도둑을 스스로 처리하게 끔 허락했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0027_Text
msgctxt "2d3cec2a-3190-4e39-bb29-296b428950c1"
msgid "\"Fine. Deal with your black sheep as you see fit.\""
msgstr "\"좋아. 너희 검은 양을 너희 식으로 처리해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0029_AlignmentShift.Description
msgctxt "5de92187-17a7-4126-add1-7bcc3d9df3c3"
msgid "Put the thief on trial."
msgstr "도둑을 재판대에 세웠다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0029_Text
msgctxt "e9dbdcd2-00bc-4892-a348-566cb8c14e64"
msgid ""
"\"I have no reason to trust you. Tell me where this hiding place is. Lorre "
"will be given a fair trial.\""
msgstr "\"널 믿을 이유가 없군. 은신처가 어딘지 말해. 로르는 공정한 재판을 받을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0032_Text
msgctxt "8f69cfac-0c16-4f50-bcb0-63b81d3b3fd8"
msgid "\"Your family includes elves and halflings?\""
msgstr "\"가족중에 엘프랑 하플링도 있나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0040_Text
msgctxt "79a51cec-6bcc-4c1b-8ad6-f1aec09b04d7"
msgid "\"So you're traveling... and where have you been?\""
msgstr "\"그러니까 자네는 여행 중이군... 어느 곳에 다녀왔었나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0044_Text
msgctxt "567b679a-6dae-481b-977d-8fc98fe91a28"
msgid "\"Numeria is not the most hospitable place, is it?\""
msgstr "\"누메리아는 살기 좋은곳은 아니지, 그렇지 않나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0045_Text
msgctxt "849a33dd-a92b-4090-ba55-6bdeb4640587"
msgid "\"What the hell did you do in Cheliax?\""
msgstr "\"첼리악스에서는 대체 뭘 했나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0046_Text
msgctxt "89e6c8a6-2eed-4e01-91f5-d29cf6d136b9"
msgid "\"Why did the Starlings leave their homeland of Varisia?\""
msgstr "\"스탈링 가문이 고향 바리시아를 떠는 이유는 뭔가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0047_Text
msgctxt "0b433b8f-3a52-4a07-bf8e-2765b0b09588"
msgid "\"Enough about your travels.\""
msgstr "\"자네 여행 얘기는 이제 됐네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0052_Text
msgctxt "e9b6f15f-52ea-4937-bade-187eef3f3bda"
msgid ""
"\"Wait... so the Starlings are the same caravan who picked up Jase when she "
"escaped?\""
msgstr "\"잠깐... 그러니까 제이스가 도망쳤을 때 받아준 대상단이 스탈링이란 말인가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0054_Text
msgctxt "3de04bff-3ee6-4430-816f-4085822395b4"
msgid "\"You have interesting tattoos...\""
msgstr "\"흥미로운 문신이군...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Answer_0056_Text
msgctxt "f199d827-29fb-4b45-9a5e-9b99cb4acbd5"
msgid "\"I must go.\""
msgstr "\"가봐야겠네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0001_Text
msgctxt "08990a6f-76dd-4e71-b62a-669c4d558910"
msgid ""
"{n}A dark-haired, dark-skinned {g|Varisia}Varisian{/g} stands before you, "
"wearing an expensive but rather road-worn doublet, a leather belt, and dusty "
"baggy pants. Tattoos that look like cuneiform writing wander up the man's "
"neck and onto his cheeks. The Varisian is holding a deck of cards, springing "
"them from one hand to the other with a faint rustling sound.{/n}"
msgstr ""
"{n}검은 머리, 어두운 피부색의 {g|Varisia}바리시아인{/g}이 당신 앞에 서있습니다. 비싸지만 닳아버린 더블렛, 가죽 허리띠, "
"그리고 먼지투성이인 헐렁한 바지를 착용하고 있습니다. 마치 설형 문자처럼 보이는 문신이 그의 목과 뺨까지 새겨져 있습니다. 그가 카드 한 "
"뭉치를 한 손에서 다른 손으로 튕겨 옮기고 있으니 희미하게 바스락거리는 소리가 들립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0002_Text
msgctxt "27c6ea32-dbe3-41cb-be25-4b552513893f"
msgid ""
"{n}The stranger looks at you askance, squinting and sneering with a corner "
"of his mouth.{/n} \"Look who we have here! My regards, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}, join our circle! Call me Zandu Starling."
"\""
msgstr ""
"{n}낯선이가 눈을 가늘게 뜨고 조소하는 입매를 한채, 당신을 의심의 눈초리로 봅니다.{/n} \"이게 누구신가? 영광입니다, "
"{mf|영주님|영주님|전하|전하}, 불가로 오세요! 잔두 스탈링이라고 부르시면 됩니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0006_Text
msgctxt "62e3589c-6974-4d7d-8f8c-f6776fc83b35"
msgid ""
"{n}Zandu's brows fly up.{/n} \"Really? Then why did you build shrines of our "
"patroness along all your roads? You hoped they would bring travelers with "
"deep pockets?\""
msgstr ""
"{n}잔두의 이마가 솟아오릅니다.{/n} \"정말입니까? 그렇다면 왜 우리 여성 후원자의 사원을 모든 길을 따라서 짓는 거죠? 여행자들이 "
"주머니 두둑하게 찾아오기를 바라는 겁니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0009_Text
msgctxt "fd80b8c9-3376-403e-8420-f56676789e3a"
msgid ""
"\"Ha, {mf|Your Grace|Your Grace|Your Highness|Your Highness}, if you only "
"knew what I have heard in my travels, you would not apologize for this small "
"matter. Consider it forgotten.\""
msgstr ""
"\"하, {mf|영주님|영주님|전하|전하}, 제가 여행에서 뭘 들었는지 당신이 알기만 한다면, 이런 작은 일에 사과하지 않을겁니다. "
"잊었다고 생각 하십쇼.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0010_Text
msgctxt "1c3eb396-1889-40e6-ab6d-5476d3327a05"
msgid ""
"\"Why should I want to remain? To quarrel with the likes of you? I've no "
"interest in this. — Honest people are welcome in many places. Hey, "
"Starlings! We're leaving!\""
msgstr ""
"\"왜 내가 남길 원한다고 생각하지? 당신같은 사람과 말다툼 하면서? 별 생각 없어. 정직한 사람은 많은 곳에서 환영받는 법이지. 이봐, "
"스탈링들! 우리는 떠난다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0013_Text
msgctxt "bf0003b0-2d62-49f8-96d7-49207f6550bd"
msgid ""
"\"I have... we have a little brother. His name is Lorre. A halfling. He came "
"to us six months ago. He's a smart fellow, but willful. He's good with his "
"hands, and thinks fast. But he decided to put his talents to ill use. We "
"caught him stealing back in {g|Galt}Galt{/g} — and almost lost our heads "
"because of the little rat!\""
msgstr ""
"\"난... 우리는 남동생이 있어요. 이름은 로르지요. 하플링이구요. 로르는 여섯달 전에 우리에게 왔어요. 똑똑한 친구이지만, "
"괴팍합니다. 로르는 손재주가 좋아요, 그리고 머리 회전이 빠르고. 하지만 로르는 재능을 나쁜 일에 쓰려고 결심했습니다. 우리는 "
"{g|Galt}갈트{/g}에서 물건을 훔치는 로르를 붙잡았어요. 그리고 많은 사람이 그 쥐새끼때문에 머리가 달아나버렸구요! \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0014_Text
msgctxt "49513074-68bf-4f28-ba24-d485c82c1e61"
msgid ""
"{n}Zandu examines you with his eyes.{/n} \"So, {mf|Your Grace|Your Grace|"
"Your Highness|Your Highness}. We're nomads, so it's all right to blame all "
"the evil in your lands on us?\""
msgstr ""
"{n}잔두가 당신을 살핍니다.{/n} \"그래,{mf|영주님|영주님|전하|전하}. 우리는 떠돌아다닙니다. 그렇다고 당신네 땅의 모든 악을 "
"우리에게 뒤집어 씌워도 괜찮은 거요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0019_Text
msgctxt "b090771f-2297-46b2-a4cb-ff300472eb15"
msgid ""
"{n}The man's glance becomes heavy.{/n} \"Let the test begin then, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}. Perhaps this time "
"{g|Desna}Desna{/g} will smile upon someone other than you.\""
msgstr ""
"{n}남자의 시선이 무거워집니다.{/n} \"그럼 시험을 시작합니다, {mf|영주님|영주님|전하|전하}. 이번엔 "
"{g|Desna}데즈나{/g}가 당신에게 미소를 더 지어주실지도 모르겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0021_Text
msgctxt "1269f302-221a-42d7-a8a8-4c4d1a4979d9"
msgid "{n}Zandu gives you a long look and then sighs sadly.{/n} \"Fine.\""
msgstr "{n}잔두가 당신을 길게 쳐다보다가 슬프게 탄식합니다.{/n} \"좋습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0022_Text
msgctxt "5f458409-48be-4f5e-80c2-d38e167d6594"
msgid ""
"{n}Zandu starts whistling carelessly, looking at the cards in his hands.{/n}"
msgstr "{n}잔두가 손패를 보면서 태평하게 휘파람을 붑니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0023_Text
msgctxt "69af8982-2a55-45cb-ae0a-bad7f3f5df9a"
msgid ""
"{n}Zandu casts a glance at the other members of the caravan.{/n} \"So be it, "
"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, you win. Just don't "
"harm the others, they have nothing to do with it.\""
msgstr ""
"{n}잔두가 상단의 다른 인원들에게 시선을 던집니다.{/n} \"그렇게 될 겁니다, {mf|영주님|영주님|전하|전하}, 댁이 이겼어요. "
"그저 다른 사람들을 해치지는 마세요, 그들은 이 일과 아무 관련이 없으니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0025_Text
msgctxt "36c82945-3065-4090-a865-d844d4c1b4c9"
msgid "{n}Zandu turns away, but you notice a smug smile on his face.{/n}"
msgstr "{n}잔두가 뒤돌아 섭니다. 하지만 당신은 그의 얼굴에 떠오른 의기양양한 미소를 눈치챕니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0026_Text
msgctxt "d95c33b9-463f-4fd7-9083-d164794599e0"
msgid ""
"\"I told him last time: we Starlings don't do such things. We may not much "
"respect the law, but we live by our consciences. Lorre just nodded, like he "
"was agreeing. But your presence here means he's up to his old tricks. That "
"must be why I haven't seen him around lately! I'm sorry I didn't tell you "
"right away — I was hoping I was wrong to suspect him. But truth be told, "
"none of ours would do these things. And I'm not his mother to cover for him "
"his whole life!\""
msgstr ""
"\"그놈에게 마지막으로 말했습니다: 우리 스탈링들은 그딴 짓 안한다고. 우리가 법을 철저하게 지키는 건 아니지만, 우리는 우리 양심에 "
"따라 산다고. 로르는 무슨 말을 알겠다는 뜻인양, 그저 끄덕일 뿐이었습니다. 하지만 당신이 여기왔다는건, 그놈이 옛날 장난질을 쳤다는 "
"뜻이지요. 내가 그 녀석을 한동안 주변에서 못 봤던 이유이기도 하고! 곧바로 말하지 않았던 건 미안하게 생각합니다. 나는 그 녀석을 "
"의심하는 것이 잘못이길 바라고 있었어요. 하지만 솔직히 말해서, 우리 중 그 누구도 그런 짓을 하지 않을 겁니다. 저는 그놈의 인생을 "
"평생 봐줄 엄마도 아니구요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0028_Text
msgctxt "dbfffbba-ab96-4fb7-a660-8548ab76738d"
msgid ""
"{n}Zandu stands up straight.{/n} \"Listen, {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}. I know where he might have a hiding place. — He "
"hinted at such a place but I pretended I didn't understand. But it's... our "
"business. Family business. Don't send your soldiers after Lorre. The "
"Starlings will deal with him, and we'll return what he stole. I give you my "
"word — there won't be any more thefts here. The Starlings will track down "
"rotten rascal ourselves!\""
msgstr ""
"{n}잔두가 똑바로 섭니다.{/n} \"사실은 말입니다, {mf|영주님|영주님|전하|전하}. 그 녀석이 숨어있을만한 장소를 알고있습니다. "
"그 녀석이 그 장소에 대한 언급을 했었어요. 내가 못 알아들은 척 했지만 말입니다. 하지만 이건...우리 일입니다. 가족일이라구요. "
"당신네 병사들이 로르를 뒤쫓도록 보내지 말아주세요. 스탈링이 그 녀석을 처리하고 , 훔친 물건을 되찾아 오겠습니다. 약속드리겠습니다. 더 "
"이상의 도둑은 없을 거라고. 스탈링 스스로 그 썩은 악한을 추적하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0030_Text
msgctxt "ed2ce62f-5b78-4b3f-bd19-0e3c72a53f3c"
msgid ""
"\"Thank you, {mf|Baron|Baroness|King|Queen} {name}. I still hope Lorre can "
"be reformed. He is a good lad. He just got some bad ideas about easy money "
"when he was a kid.\""
msgstr ""
"\"감사드립니다, {mf|남작|여남작|왕|여왕} {name}. 로르가 개과천선하면 좋겠군요. 그 녀석은 좋은 놈이에요. 그저 돈을 쉽게 "
"버는 방법을 어릴 때 잘 못 배운것 뿐입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0031_Text
msgctxt "da370ea4-c064-4d3e-84ba-e52a8e0f02cb"
msgid ""
"{n}Zandu frowns.{/n} \"You don't trust me? Or the Starlings? Or anyone who's "
"not to your liking? Too bad you tar everyone with the same brush, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}... Lorre might have made a "
"mistake, but it seems you're treating others just as poorly.\""
msgstr ""
"{n}잔두가 얼굴을 찌푸립니다.{/n} \"저를 못믿는 겁니까? 아니면 스탈링을 못밉는 겁니까? 혹은 당신네 족속이 아닌 모두를 못믿는 "
"겁니까?, {mf|영주님|영주님|전하|전하}... 로르가 실수를 저질렀을지는 모르지만, 당신이 다른 사람을 취급하는 방법도 로르만큼이나 "
"좀스럽군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0033_Text
msgctxt "7cc3b50a-eb90-4187-abad-4596d987acbf"
msgid ""
"\"One's family is not just the ones you share blood with. Yes, I have "
"sisters and brothers, but Starling recruits are not kin by parentage, but by "
"spirit and conscience. Every one of our caravan is as good as family. And if "
"someone has pointy ears or hairy feet — why should I care?\""
msgstr ""
"\"그저 피를 나눈 사람만 가족인건 아니에요. 물론, 나도 여자 형제와 남자 형제들이 있습니다. 하지만 스탈링이 혈통만 뽑는건 아니에요. "
"영혼과 양심에 따라서 뽑지요. 우리 상단원 각각은 전부 가족이나 다름없습니다. 누군가가 뾰족귀를 가지고 있건 털많은 발을 가지고 있건, "
"내가 왜 신경써야 하죠?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0039_Text
msgctxt "d9a62613-58e2-432e-a2be-14f20c51e0c1"
msgid ""
"{n}The man runs his finger along the lines on his neck.{/n} \"Yes... In case "
"you don't know, it's a hereditary trait. Some {g|Varisia}Varisians{/g} have "
"tattoos even in birth. No one knows why. My mother told me that I was born "
"with only small streaks on my skin. And now look – I am covered in wisdom "
"that no one has yet been able to decipher.\""
msgstr ""
"{n}남자가 손가락을 목선에 올려놓습니다.{/n} \"맞습니다... 당신이 모른다면, 이건 유전적인 형질이지요. 몇몇 "
"{g|Varisia}바리시아{/g}인은 태어날 때부터 문신이 있습니다. 그 누구도 이유는 모릅니다. 어머니께선 제가 태어났을때 오직 "
"조그마한 줄이 피부에 있었다고 말씀하셨죠. 지금 전 그 누구도 해독하지 못한 지혜로 뒤덮여 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0041_Text
msgctxt "414f1014-9b71-4b97-8067-cb4d702af1de"
msgid ""
"\"And you, {mf|Your Grace|Your Grace|Your Highness|Your Highness} – you "
"really are just like the people say. You're not torturing people for no good "
"reason, and leave them free to live by their wits. Who would ever guess I'd "
"say this, but I like this {mf|baron|baroness|king|queen}!\""
msgstr ""
"\"그리고, {mf|영주님|영주님|전하|전하}. 당신은 정말 사람들이 말하던 그대로의 사람이군요. 아무 이유 없이 사람들을 괴롭히지 "
"않고, 사람들 스스로의 지혜로 자유롭게 살게끔 하시는군요. 아무도 내가 이런 말을 할 거라고 생각하지도 않았겠죠, 하지만 전 "
"{mf|남작|여남작|왕|여왕}님이 맘에 드는군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0042_Text
msgctxt "2158af8a-cc8b-44e8-a79b-dd15fc567376"
msgid ""
"{n}Zandu lets out a brief laugh.{/n} \"It's easier to say where we haven't "
"been. From {g|Cheliax}Cheliax{/g} to {g|Numeria}Numeria{/g}, {mf|Your Grace|"
"Your Grace|Your Highness|Your Highness}. We've walked all of "
"{g|Avistan}Avistan{/g}.\""
msgstr ""
"{n}잔두가 잠시 웃습니다.{/n} \"우리가 안 가본 곳을 찾는게 더 쉬울 겁니다. {g|Cheliax}첼리악스{/g}부터 "
"{g|Numeria}누메리아{/g}까지지요, {mf|영주님|영주님|전하|전하}. 우리는 {g|Avistan}아비스탄{/g} 전역을 "
"돌아다녔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0048_Text
msgctxt "a47d0b36-4044-4d59-9a20-054ccb5ccb2b"
msgid ""
"\"As you say.\" {n}Zandu throws his cards skillfully into the air and "
"catches them with one smooth movement.{/n}"
msgstr "\"당신 말대로 하지요.\" {n}잔두가 능숙하게 카드를 위로 던지고 부드러운 한번의 손짓으로 붙잡습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0049_Text
msgctxt "6f546e46-f07f-45de-a5c7-72a92bb2a041"
msgid ""
"{n}Zandu wrinkles his nose.{/n} \"Truth be told, it was not what, but whom. "
"You see, the Starlings stand for freedom. So sometimes we visit the lands "
"where this freedom is being trampled. We pick up fugitive slaves, and when "
"we can, we get down to business and free someone.\""
msgstr ""
"{n}잔두가 코를 벌름거립니다.{/n} \"솔직히 말해서, 무엇이 아니라, 누구입니다. 보시다시피, 스탈링은 자유를 지지합니다. 따라서 "
"자유가 유린되는 땅에 가면. 탈주 노예를 거둬들이죠, 할 수 있으면, 사업을 접고 누군가를 풀어주기도 합니다. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0050_Text
msgctxt "0e7e0596-cdbf-48ef-b683-12df55ce72de"
msgid ""
"\"We walked all the roads there many times, and eventually became bored. And "
"so we decided to look farther afield, to see what's going on out in the "
"world... and we got carried away.\""
msgstr ""
"\"우리는 수많은 길을 수없이 걸었습니다만, 결국에는 지겨워졌지요. 그래서 좀 더 나아가기로 결심했습니다, 세상에 무슨 일이 벌어지는 지 "
"보기로요... 그리고 우리는 그렇게 해왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0051_Text
msgctxt "9321240e-80ce-4805-94f6-34202bcfe3c3"
msgid ""
"\"You are right about that.\" {n}The man scratches the back of his head.{/n} "
"\"I've been to many places, seen many things... but I saw such things in "
"{g|Numeria}Numeria{/g} as cannot be believed. The Starlings have no business "
"there.\""
msgstr ""
"\"그 말이 맞습니다.\" {n}그가 뒷머리를 매만집니다.{/n} \"나는 많은 장소에 가봤고, 많은 것을 봤습니다... 하지만 "
"{g|Numeria}누메리아{/g}에선 믿지 못할 것을 봤지요. 스탈링은 누메리아에선 볼일이 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0053_Text
msgctxt "94daa644-2d98-4b9b-8dc4-5dc82c08f9b2"
msgid ""
"\"Are you talking about my family?\" {n}Zandu nods at the others.{/n} \"We "
"are the Starlings, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. "
"We are from {g|Varisia}Varisia{/g}. We live on the road, traveling the "
"world. We heard that life here is easy, so we decided to come see.\""
msgstr ""
"\"내 가족에 대해 말하는 겁니까?\" {n}잔두가 다른 이에게 끄덕입니다.{/n} \"우리는 스탈링입니다, "
"{mf|영주님|영주님|전하|전하}. 우리는 {g|Varisia}바리시아{/g}에서 왔어요. 우리는 세계를 여행하고, 길 위에서 살고 "
"있지요. 우리는 이 땅에서의 삶이 괜찮다고 들었고, 이 땅을 들러보기로 결정했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0055_Text
msgctxt "160bcf14-ca94-4f67-b8f9-323a42af6d96"
msgid ""
"\"Lorre spoke of a ravine where the river is shallow. Send your dogs there. "
"Meanwhile I will prepare to leave – before you begin to hunt any of my other "
"people.\""
msgstr ""
"\"로르가 강이 흐르는 계곡을 얘기했습니다. 당신네 개를 거기에 보내세요. 그 동안 우리는 떠날 준비를 할테니. 당신이 우리를 사냥하기 "
"전에요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0057_Text
msgctxt "976c5420-7cc0-4519-9aa8-0d4585014a31"
msgid ""
"{n}Zandu salutes you jauntily.{/n} \"May {g|Desna}Desna{/g} keep you safe, "
"{mf|Your Grace|Your Grace|Your Highness|Your Highness}! And thank you for "
"not keeping your distance! With such a {mf|baron|baroness|king|queen} I "
"could even start to believe in law and order! And don't worry about "
"scoundrels like Lorre: we road people keep a watchful eye on our brothers!\""
msgstr ""
"{n}잔두가 명랑하게 경례합니다.{/n} \"{g|Desna}데즈나{/g}가 당신을 굽어 살피기를, {mf|영주님|영주님|전하|전하}! "
"거리를 두지 않는 것도 감사드립니다! 이런 {mf|남작|여남작|왕|여왕}이라면, 저도 법과 질서를 믿을 수 있을 것 같습니다! 로르같은 "
"불한당은 신경쓰지 마십시요: 우리 길사람들이 우리 형제를 잘 감시할테니! \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CG_ByDesnasPaths/Ep3_Encounter/Cue_0059_Text
msgctxt "4260709c-949d-4e6d-bbd7-ae9b42c056a5"
msgid ""
"{n}Zandu nods, pleased.{/n} \"That's right! The poor thing had it tough on "
"the run – with shackles on her feet! But we nursed her back to health. And "
"so she turned to {g|Desna}Desna{/g}. — She believes it was the goddess who "
"sent us to her!\""
msgstr ""
"{n}잔두가 기쁜듯이 끄덕입니다.{/n} \"맞습니다! 불쌍한 제이스는 발목에 족쇄가 채워져서 달아나기 어려웠습니다! 하지만 우리가 "
"그녀가 괜찮아지도록 돌봤죠. 그리고 그녀는{g|Desna}데즈나{/g}에게 귀의했지요. 제이스는 여신이 우리를 보냈다고 믿습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Answer_0002_Text
msgctxt "bb2e98a3-5f19-4efe-858e-c6f77834548d"
msgid "\"Who was your son? Did he have any enemies?\""
msgstr "\"당신 아들이 누구지? 아들에게 적이 있었나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Answer_0006_Text
msgctxt "e00ee62e-fad4-456a-987a-de3316a44ae5"
msgid "\"How did your son die?\""
msgstr "\"어쩌다가 아들이 죽었지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Answer_0007_Text
msgctxt "b09d02ec-ae7b-4978-8a40-8ee738009a1c"
msgid "\"What mysterious deaths are you talking about?\""
msgstr "\"어떤 의문스러운 죽음을 말하는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Answer_0017_AlignmentShift.Description
msgctxt "e74041a5-c7a6-4f5d-93ff-6a9955d708bc"
msgid "Promised to investigate the suspicious death personally."
msgstr "의문사를 개인적으로 조사하기로 약속했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Answer_0017_Text
msgctxt "1d220cb9-3a1d-4b30-a5ad-f91557ed09f8"
msgid "\"I will try to get to the bottom of this.\""
msgstr "\"사건의 진상을 밝히도록 하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Answer_0018_AlignmentShift.Description
msgctxt "5b99147e-ae7c-47ca-b84a-388fab743126"
msgid "Let the guards perform their duties."
msgstr "경비대가 그들의 의무를 행하도록 했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Answer_0018_Text
msgctxt "e55fba50-5061-4502-b5ee-8367bda4df03"
msgid "\"I'll leave the guards to their duty.\""
msgstr "\"경비대에게 맡기겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Answer_0019_AlignmentShift.Description
msgctxt "6a4db9c5-e11b-43d6-8425-ac78bc49dd24"
msgid "Threw the Alnavi family in prison for trying to flee the country."
msgstr "국외로 도망치려고 한 죄를 물어 알나비 가문을 수감했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Answer_0019_Text
msgctxt "62715a58-2889-4f3e-834d-1d2f1023f5dc"
msgid ""
"\"You're not going anywhere. Guards! Place this witch and her kin in chains!"
"\""
msgstr "\"너는 어디에도 가지 못한다. 경비! 이 마녀와 그 가족들을 묶어라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Cue_0001_Text
msgctxt "e91e8370-07a5-45a2-9691-56a2e894ee72"
msgid ""
"{n}The woman standing before you isn't young. Her irreproachable poise and "
"velvet attire attest to her wealth and nobility. But the creases on her face "
"bear witness to a secret grief.{/n} \"Greetings, {mf|Your Grace|Your Grace|"
"Your Highness|Your Highness}. Let me introduce myself. I am Jaronna Al'navi, "
"head of the Al'navi family.\" {n}She sighs deeply.{/n} \"But my name is of "
"no importance. My family and I are to leave your domain today.\""
msgstr ""
"{n}당신 앞에 선 여자는 젊지 않습니다. 그녀의 나무랄데 없는 자세와 벨벳 의상은 그녀의 고귀함과 부를 증명하고 있습니다.{/n} "
"\"반갑습니다, {mf|영주님|영주님|전하|전하}. 제 소개를 하도록 하지요. 저는 자로나 알나비, 알나비 가문의 수장입니다. \" {n}"
"그녀가 깊게 탄식합니다.{/n} \"하지만 제 이름이 중요한 것은 아닙니다. 제 가족과 저는 {mf|영주님|영주님|전하|전하}의 영토를 "
"오늘 떠나려고 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Cue_0003_Text
msgctxt "e6edf005-7ecb-484a-aa67-eea68e52a34e"
msgid ""
"{n}The woman eyes you solemnly, but without affront.{/n} \"My son "
"mysteriously died a week ago. His body was examined; the death appeared to "
"be natural. But it's obvious to any reasonable person that a man in his "
"prime can't just drop dead.\""
msgstr ""
"{n}그녀가 당신을 엄숙하게 바라보지만, 그곳에 모욕의 의사는 없습니다.{/n} \"제 아들이 일주일 전에 의문스럽게 죽었습니다. 그의 "
"시체를 부검해봤습니다; 자연사라고 하더군요. 하지만 제 아들처럼 뛰어나고 합리적인 사람이 그저 그렇게 죽지는 않습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Cue_0004_Text
msgctxt "dda8b582-2c52-42ef-95e3-e931ece8b509"
msgid ""
"\"Your subjects have failed to show me mercy or understanding. Now I fear "
"that such 'sudden death' may find my other relatives as well. – Especially "
"now that mysterious and inexplicable deaths are growing more common in your "
"lands. My departure is a settled matter, but I still believe in law and "
"justice. Perhaps now you may choose to step in and protect those who are "
"relying on you.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}의 종복들은 저에게 자비나 이해심을 보여주지 못했습니다. 그런 '급사'에서 다른 연관점들도 발견하게 "
"될까봐 두렵군요. 특히 지금 의문스럽고 불가해한 죽음들이 {mf|영주님|영주님|전하|전하}의 영토에서 점점 늘고 있습니다. 제 이주는 "
"결정된 사안이지만, 아직까지도 전 법과 정의가 남아있다고 생각하고 있어요. 지금이라도 {mf|영주님|영주님|전하|전하}께서 이 일에 "
"관여하셔서 {mf|영주님을|영주님을|전하를|전하를} 의지하고 있는 사람들을 지킬수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Cue_0009_Text
msgctxt "653e9fd0-cefc-4903-a318-f4093b98c701"
msgid ""
"\"My son was a lawyer. He promoted various interests and handled the affairs "
"of several merchants. He could hardly practice his profession without making "
"some enemies. However, I'm not sure I could point to anyone in particular.\""
msgstr ""
"\"제 아들은 변호사였습니다. 여러 관심사들을 홍보하고 상인들간의 사안을 조절했지요. 그가 적을 만들지 않으면서 일을 했다고는 생각하지 "
"않습니다만. 특정인을 짚어서 말씀드릴 수가 없군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Cue_0011_Text
msgctxt "6642d1e5-0286-4a57-8210-aff92b00fb95"
msgid ""
"\"During a hunt, surrounded by friends. They say they found my poor son in "
"the morning. His body had was already in rigor, and his face... his face was "
"frozen in the last expression he had – terror. There wasn't a single mark on "
"his body, and his food and wine had been shared with the others.\""
msgstr ""
"\"친구들에게 둘러싸여서 사냥중이었습니다. 아침에 제 불쌍한 아들을 발견했다고 말하더군요 아들의 몸은 이미 딱딱해져 있었고, 그리고 그의 "
"얼굴은... 마지막 감정 그대로 얼어붙어 있었습니다. 공포로요. 아들의 몸에는 그 어떤 자국도 없었습니다. 그리고 음식과 와인은 다른 "
"사람들도 먹었던 것이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Cue_0012_Text
msgctxt "2dccc741-ee47-472b-a2d9-3d8e5fb7bd1d"
msgid ""
"{n}Jaronna purses her lips.{/n} \"There's no containing gossip, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}. Over the past few weeks, many "
"fine ladies and gentlemen have died under mysterious circumstances.\""
msgstr ""
"{n}자로나가 입술을 오므립니다.{/n} \"소문이 계속 퍼지고 있습니다 {mf|영주님|영주님|전하|전하}. 몇 주 동안, 멀쩡한 "
"숙녀들과 신사들이 의문스러운 상황속에서 죽었어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Cue_0020_Text
msgctxt "77fa2b1d-70af-4e54-89a3-6373c5e2bd0b"
msgid ""
"\"You... Filthy tyrant! I should never have sought justice from you! I curse "
"you!\""
msgstr "\"이... 더러운 독재자! 네놈에게 정의를 찾아볼수가 없군! 당신을 저주해!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Cue_0021_Text
msgctxt "35feeac4-2b23-41b6-8993-d7271dc5752d"
msgid ""
"\"As you wish. But from now on I will put my life in the hands of more "
"competent law enforcers than yours. Farewell, {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}.\""
msgstr ""
"\"원하는대로 하십시오, 하지만 지금부터는 {mf|영주님|영주님|전하|전하}보다 더 괜찮은 법치자에게 제 삶을 맡길겁니다. 안녕히, "
"{mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Cue_0022_Text
msgctxt "ee1d9100-2498-4cbf-add1-1308c46a5189"
msgid ""
"{n}Jaronna's expression softens.{/n} \"I was hoping to see justice done "
"after I spoke with you. Thank you, {mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}. May {g|Abadar}Abadar{/g} be with you!\""
msgstr ""
"{n}자로나의 표정이 부드러워집니다.{/n} \"{mf|영주님과|영주님과|전하와|전하와} 얘기하고 정의가 이루어지길 바라고 있었어요. "
"감사드립니다, {mf|영주님|영주님|전하|전하}! {g|Abadar}아바다르{/g}께서 당신과 함께하기를!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep1_KTC/Cue_0023_Text
msgctxt "2f118e18-c1de-43cd-bd6e-d538159b638b"
msgid ""
"\"The guards declared that all cases were but mishaps. I find it quite "
"suspicious that experienced riders fall from their horses and break their "
"necks, or young beauties die from minor cuts they get on a promenade.\""
msgstr ""
"\"경비대는 모든 사건이 그저 사고일 뿐이라고 발표했어요. 저는 숙련된 기수가 말에서 떨어져서 목이 부러졌다는 것이 매우 의심스럽다고 "
"생각했죠, 혹은 젊은 여자들이 산책로에서 작은 부상으로 죽는것도요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0004_Text_1
msgctxt "d8d7f7f1-d7a3-4850-8eb2-88a195c694cd"
msgid "\"Who are you?\""
msgstr "\"넌 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0005_Text_1
msgctxt "5bae2b19-e650-4f94-8a5a-87e102821bee"
msgid ""
"\"You won't confuse me with your shallow courtesy, Invri. I'm looking for "
"murderers – and I believe I've just found one.\""
msgstr "\"얕은 예절로 나를 혼란스럽게 하지는 않겠지, 인브리. 살인자를 찾아보도록 하겠다. 그리고 지금 하나 찾은 것 같군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0006_AlignmentShift.Description_1
msgctxt "348ddc83-6f8c-4379-a81a-71c7e78e0a2a"
msgid "Destroyed a band of rogue Calistrians on the spot."
msgstr "칼리스트리아 도적떼를 즉시 파괴했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0006_Text_1
msgctxt "4af6e376-66f7-43ad-8641-e4c23bc81aed"
msgid "[Attack] \"I've got nothing to discuss with a bunch of thugs.\""
msgstr "[공격한다] \"도적떼랑은 얘기할 것도 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0012_Text_1
msgctxt "795eb4f3-aa88-4df8-8e13-012a95ba8fcf"
msgid "\"What are you doing in my domain?\""
msgstr "\"내 영지에서 무엇을 하는 겁니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0013_Text_1
msgctxt "99d4ff52-24f1-48b3-b403-19f21a4c1942"
msgid ""
"\"Given your 'craft', I'd expect you to be worshipping Norgorber, not "
"Calistria.\""
msgstr "\"당신의 '공예품'을 보고, 나는 당신이 칼리스트리아가 아니라 노르고버를 숭배한다고 생각했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0014_Text_1
msgctxt "f6ff6505-3881-4941-81b0-0ccd343ef5b7"
msgid ""
"\"The guards in charge of the investigation, and even the priests, failed to "
"identify them as murders at first.\""
msgstr "\"수사를 담당하는 경비들, 그리고 심지어 사제들조차도, 처음에 그들을 살인자라고 판명하지 못했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0015_AlignmentShift.Description
msgctxt "e5811c66-562b-4f13-8118-5aafe4453d6f"
msgid "Convinced the Calistrians to leave peacefully."
msgstr "독실한 칼리스트리아 교도들이 평화로이 떠나가도록 설득하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0015_Text_1
msgctxt "6a445207-2083-45a9-b109-57164c029c19"
msgid ""
"\"I don't need any new deaths, you included. Leave my lands immediately, and "
"I will let you go in peace.\""
msgstr "\"당신을 포함해서 어떤 이의 죽음도 필요하지 않다. 즉시 내 영토를 떠나라, 너희를 평화로이 보내주겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0016_AlignmentShift.Description
msgctxt "2ca21c50-a7d3-4066-ad71-59b15ed73a67"
msgid "Struck a deal with the Calistrian hunters."
msgstr "칼리스트리아 헌터들과 타협하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0016_Text_1
msgctxt "a6e616a9-de4b-4d4c-b6f2-e7434f7e06b0"
msgid ""
"\"You know what... Stay in my lands, do your jobs, and I'll see to it that "
"you're left alone. It will cost you seventy percent of your profit.\""
msgstr ""
"\"알다시피...내 영지에 머무르며, 너의 일을 하면, 나는 내가 홀로 있을 수 있게 지켜줄 것이다. 그 댓가는 너의 이익의 70%이다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0017_AlignmentShift.Description
msgctxt "0f1826c3-d17c-477c-9f0f-abe9b0415bd8"
msgid "Killed the Calistrian hunters on the spot."
msgstr "즉석에서 칼리스트리아 사냥꾼들을 죽였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0017_Text_1
msgctxt "94f520e7-5883-4caf-bf11-16ea0cf5648d"
msgid "[Attack] \"I will rid the world of you and your vile 'religion'!\""
msgstr "[공격한다] \"네 세계를 제거하고 네 비도덕적인 '종교'도 없애주마!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0030_AlignmentShift.Description
msgctxt "03600dc2-2bfd-45ad-af0d-681265d4df04"
msgid "Tried to arrest the Calistrian hunters."
msgstr "칼리스트리아 헌터들을 체포하려고 시도했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0030_Text
msgctxt "5a12f19f-ec5c-454f-af24-872a8dce6713"
msgid "\"You committed a crime you must be punished. Drop your weapons.\""
msgstr "\"넌 반드시 처벌받아야 하는 죄를 저질렀다. 무기를 내려라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Answer_0033_Text
msgctxt "79400e5d-4d0d-45ad-a28a-5ffa55335369"
msgid ""
"\"{g|Calistria}Calistrian{/g} hunters, killing for revenge? Is this how you "
"make sacrifices to your goddess?\""
msgstr "\"복수를 위해 살인하는 {g|Calistria}칼리스트리아{/g} 사냥꾼들? 이게 당신네 여신에게 제물을 바치는 방법인가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0001_Text_1
msgctxt "b314e3c6-3561-48a6-8421-a4d536e27e33"
msgid ""
"{n}A tall and well-built half-elf with a scar under his left eye is watching "
"you with great interest.{/n} \"What a surprise. The "
"{mf|baron|baroness|King|Queen} {mf|him|her}self! That's someone you'd never "
"expect to meet you in the middle of nowhere...\""
msgstr ""
"{n}왼쪽 눈에 흉터가 있는 키크고 체격 좋은 하프엘프가 당신을 매우 흥미롭게 지켜봅니다.{/n} \"이거 놀랍군. "
"{mf|남작|여남작|왕|여왕}이 몸소 오시다니! 당신 같은 사람을 이런곳에서 만날줄이야...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0002_Text_1
msgctxt "6a8579bf-223a-4161-b522-99329641291b"
msgid ""
"\"Allow me to introduce myself, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. My name is Invri.\" {n}The half-elf bows to you, touching his "
"weapon and keeping his eyes fixed on you.{/n} \"I suspect I already know the "
"answer, but still: to what do I owe the pleasure?\""
msgstr ""
"\"제 소개를 하지요, {mf|영주님|영주님|전하|전하}. 제 이름은 인브리입니다.\" {n}하프엘프는 시선은 당신에게 두고 무기를 "
"매만지면서 당신에게 숙입니다.{/n} \"제가 그 답을 알고 있다고 생각은 합니다만, 그래도 물어보겠습니다: 제가 도와드릴 일이라도 "
"있으신지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0007_Text_1
msgctxt "8af839e1-d164-458d-af0c-8955a7770503"
msgid ""
"\"Allow me to introduce my comrades by the campfire. They are followers of "
"the goddess who respects freedom and pleasure, free from rules and "
"hypocrisy, from excessive regulations and outdated attitudes. I'm sure you "
"know who I'm talking about. We are the {g|Calistria}Calistrian{/g} hunters, "
"the favoured of the Savored Sting.\""
msgstr ""
"\"야영지의 제 동료들을 소개해드리지요. 자유와 기쁨을 존경하는 여신의 추종자들입니다. 규칙과 위선으로부터 자유로우며, 지나친 규제와 "
"낡아 빠진 사고방식으로부터 자유로운 사람들입니다. 어떤 집단을 말하는 지 분명 아실테죠. 우리는 {g|Calistria}칼리스트리아{/g}"
"의 사냥꾼이며, 감미로운 독침의 총애를 받는 자들입니다. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0008_Text_1
msgctxt "2048b964-7bb2-4a42-99fc-e0bb101f90e3"
msgid ""
"{n}Invri lifts his hand in a conciliatory gesture.{/n} \"Allow me, if you "
"please, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. We are still "
"talking, not fighting – which means we might yet find a common language. "
"Clearly, we've gotten off on the wrong foot.\""
msgstr ""
"{n}인브리가 달래는 듯이 손을 올립니다..{/n} \"괜찮다면, 제가 좀 말하겠습니다, {mf|영주님|영주님|전하|전하}. 우리는 "
"여전히 대화하는 중이지요. 싸우는게 아니라. 그 말인즉슨 우리가 타협점을 찾을 수 있다는 말입니다. 분명히 우리는 갑작스럽게 시작했습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0009_Text_1
msgctxt "52673675-a305-44b9-b0c1-69447080a108"
msgid ""
"{n}Invri lets out a disappointed groan.{/n} \"I expected better of you, {mf|"
"Your Grace|Your Grace|Your Highness|Your Highness}.\" {n}The half-elf draws "
"his weapon in one smooth and swift motion.{/n} \"Oh Savored Sting, accept "
"this offering!\""
msgstr ""
"{n}인브리가 실망스러운 탄식을 내뱉습니다.{/n} \"당신이 좀 더 나은 사람이기를 바랬는데, {mf|영주|영주|전하|전하}.\" {n}"
"하프엘프가 무기를 부드럽고 빠른 자세로 꺼냅니다..{/n} \"오, 감미로운 독침이시여, 이 제물을 받아주소서!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0010_Text_1
msgctxt "e491de7b-14f4-4c87-80bf-51241edf8a6a"
msgid ""
"\"We are here for a reason, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. I've heard much about your country's morals... so I thought the "
"likes of us might find shelter here – and some work to do. Very well-paid "
"work.\""
msgstr ""
"\"우리는 이유가 있어서 여기 온겁니다, {mf|영주님|영주님|전하|전하}. 당신 영토의 필멸자들에 대해 꽤 많이 들었지요... 때문에 "
"여기서 우리도 보금자리를 찾을 수 있겠다고 생각한겁니다. 할 일 몇개도요. 아주 비싼 일.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0018_Text_1
msgctxt "27378d37-a0bc-4379-99c2-6642636fd8ca"
msgid ""
"{n}Invri squints one eye.{/n} \"You clearly know what you're doing, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}. Bargaining with you is not "
"just risky, it's plain dangerous. Very well, we'll do it your way.\""
msgstr ""
"{n}인브리가 한쪽 눈을 가늘게 뜹니다..{/n} \"지금 뭘 하고 있는지 명확히 알고 계시겠죠, {mf|영주님|영주님|전하|전하}. "
"당신하고 협상하는 건 위험부담만 큰 것이 아니라, 평범하게 위험하군요. 뭐 좋아요, 당신 방법대로 하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0020_Text_1
msgctxt "877b00b9-85a2-40bd-8ff5-9676822a8516"
msgid ""
"{n}Invri tut-tuts.{/n} \"No, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. Religious ecstasy is one thing, but I'm also fond of material "
"things. Equal shares is only fair.\""
msgstr ""
"{n}인브리가 쯧쯧합니다.{/n} \"아니요, {mf|영주님|영주님|전하|전하}. 종교적 환희는 기쁨 중 하나에 불과합니다. 저는 "
"물질적인 것도 좋아하지요. 반으로 나누는게 공정합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0021_Text
msgctxt "0560db3f-9967-45d3-ad2b-a0db6cd05a7f"
msgid ""
"\"Let's discuss something else. You're a rational ruler, so you must refrain "
"from openly mingling with assassins. That's your business, it concerns me "
"not. Just be sure to call off your watchdogs when we ask. Your guards are "
"not very clever, but they're persistent. Sooner or later, they will hunt us "
"down and drive us out. That is when I'll remind you of our deal. I'll be "
"relying on your assistance.\""
msgstr ""
"\"다른 것도 얘기해볼까요. 당신은 합리적인 통치자입니다, 따라서 당신은 공공연하게 암살자들과 엮여서는 안되지요. 물론 그건 당신의 "
"일이어서, 제가 신경쓰지는 않습니다만. 우리가 요구할 때 감시하는 개들은 물려주시길 바랍니다. 당신네 경비들이 그렇게 똑똑하지는 "
"않더군요, 하지만 집요합니다. 빠르건 늦건간에, 경비는 우리를 찾아내서 사냥하고 몰아낼겁니다. 이게 제가 제안하는 우리의 협상 "
"조건이었습니다. {mf|영주님|영주님|전하|전하}의 지원을 기대하도록 하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0022_Text_1
msgctxt "3287f299-693a-4255-8dca-11312dc1cc2b"
msgid ""
"\"Well! If we're done here...\" {n}Invri makes another bow.{/n} \"It's time "
"for us to go. We may have become friends today, but let's remain distant "
"friends for now. You know what they say, separation makes the heart grow "
"fonder.\""
msgstr ""
"\"자! 다 정리됐다면...\" {n}인브리가 다시 몸을 숙입니다.{/n} \"우리는 가야할 시간이군요. 오늘 우리가 친구가 됐을지는 "
"모르지만, 지금 당장은 거리있는 친구로 남읍시다. 다들 이렇게 말하지 않습니까, 떨어져있어야 비로소 소중함을 느낀다고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0026_Text
msgctxt "a5d7e97b-8247-46c4-96ff-c4c9289a4388"
msgid ""
"\"But like any ruler, you can't do without your law enforcers. These dumb "
"officers are the reason we stay away off the streets during the day.\""
msgstr ""
"\"하지만 다른 통치자와 비슷하게, 당신은 법 집행자가 없으면 아무것도 못하는 군요. 이 덜떨어진 공무원이야말로 오늘날 우리가 거리에서 "
"멀어진 이유입니다..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0027_Text
msgctxt "06014d16-35d2-4302-947e-2d6d35f118c3"
msgid ""
"\"The narrow-minded might think us mercenaries, killers, thugs... but "
"believe me, we're far from ordinary criminals. We're paid for our work, much "
"like executioners carrying out sentences. We are, so to speak, wish-"
"fulfillment agents.\""
msgstr ""
"\"편협한 사람들이 우리를 용병, 살인 청부업자, 깡패로 생각하지요... 하지만 단언하건데, 우리는 그런 일상적인 범죄로부터 거리가 먼 "
"사람들입니다. 우리는 판결문을 받은 사형 집행인처럼 일하고 돈을 받습니다. 우리는, 말하자면, 소원 청부업자라 할 수 있지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0028_Text
msgctxt "8f0c67f0-ea9e-401a-905b-0243c48d4bef"
msgid ""
"{n}Invri winces.{/n} \"Not at all, {mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}. Our delightful and gracious goddess couldn't be compared to "
"that moody loner. {g|Calistria}Calistria{/g} gives pleasure in exchange for "
"carrying out retribution. Is that not a pure and noble cause?\""
msgstr ""
"{n}인브리가 찡긋합니다.{/n} \"전혀 아닙니다, {mf|영주님|영주님|전하|전하}. 우리 명랑하고 우아한 여신은 침울한 외톨이하고는 "
"비할바가 못되지요. {g|Calistria}칼리스트리아{/g}는 징벌 수행에 대한 대가로 즐거움을 제공합니다. 순수하고 고귀한 "
"이유아닙니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0029_Text
msgctxt "e48807d4-edfa-49f2-8987-4f5230a48ac9"
msgid ""
"\"I admit, I wasn't planning on getting to know you any better. But as it "
"turns out... well, I underestimated you. So, you've found us. What are you "
"going to do now?\" {n}Invri's smile is polite and almost gentle, but he "
"keeps his relaxed hand on the hilt of his blade.{/n}"
msgstr ""
"\"인정하겠습니다, 원래 이정도까지 당신에 대해 더 알게되는 것을 계획하진 않았습니다. 하지만 밝혀진 바로는... 글쎄, 제가 당신을 "
"과소평가했던 것 같군요. 자, 당신은 우리를 발견했습니다. 이제 어떻게 할 겁니까?\" {n}인브리의 미소는 공손하고 거진 온화합니다. "
"하지만 긴장풀린 손은 계속해서 칼자루쪽에 가있습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0031_Text
msgctxt "e240095c-c891-43ce-9e80-257f4a39c786"
msgid ""
"\"Is that a compliment? Thank you, {mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}! I confess we do like to think of ourselves as artists. But "
"if you expect me to reveal our secrets...\" {n}Invri shakes his head and "
"smiles.{/n}"
msgstr ""
"\"그거 칭찬입니까? 고맙군요, {mf|영주님|영주님|전하|전하}! 우리 스스로를 예술가로 여기는 것을 좋아한다는 것은 고백해야 "
"겠습니다. 하지만 당신이 만약 우리 비밀을 드러내는 걸 바란다면...\" {n}인브리가 머리를 흔들고 미소 짓습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0032_Text
msgctxt "8265a0a7-21b2-4708-b304-2dcb50fed605"
msgid ""
"{n}Invri keeps watching you for a while. Then he makes a decision, sighs and "
"removes his hand from his weapon.{/n} \"Such a shame, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}. You seemed so... promising. At least you "
"didn't begin our conversation by swinging your weapon. And now I'll take my "
"leave.\""
msgstr ""
"{n}인브리가 한동안 계속 당신을 봅니다. 그러다 갑자기 그가 결정을 내립니다. 탄식하더니 무기로부터 손을 떼어놓습니다.{/n} "
"\"아쉽습니다, {mf|영주님|영주님|전하|전하}. 당신은 무척... 느낌이 좋군요. 최소한 당신은 우리 대화를 무기를 휘두르면서 "
"시작하지는 않았죠. 그건 그렇고 전 이제 가겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0034_Text
msgctxt "e01c48aa-c676-4b1a-927d-609b7b62bccb"
msgid ""
"\"Not exactly, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. But "
"since you asked...\" {n}Invri takes a deep breath.{/n} \"My goddess favors "
"those who embrace passion, whether spiritual or intimate. It is common for "
"the narrow-minded to reduce it to sexual pleasure... but "
"{g|Calistria}Calistria{/g} is mistress of all manner of passions.\""
msgstr ""
"\"정확히는 아닙니다, {mf|영주님|영주님|전하|전하}. 하지만 당신이 묻는다면...\" {n}인브리가 숨을 깊게 들이마십니다.{/n} "
"\"제 여신은 영적인 것 혹은 성적인 열정을 받아들인 자들을 총애합니다. 편협한 사고가 성적인 즐거움을 감소시키는 것은 매우 흔한 "
"일입니다. 하지만 {g|Calistria}칼리스트리아{/g}는 모든 열정을 관장하는 여신입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/CN_OnTheEdge/Ep2_Encounter/Cue_0035_Text
msgctxt "2924c548-2838-4aa7-a4e4-70794928448c"
msgid ""
"{n}Invri slides a finger across his lips.{/n} \"Tell me, what can compare to "
"the feeling when an abuser is given their due? When someone who has crossed "
"you lies choking on their own blood? The blood hammers in your temples, your "
"heart bursts from your chest, a cry of joy escapes your lips...\" {n}The "
"half-elf bites his lip passionately.{/n} \"If you've never allowed yourself "
"to take revenge... then you simply don't know true joy and divine rapture. "
"We bring our... clients a taste of this joy, and they entrust us with their "
"vengeance.\""
msgstr ""
"{n}인브리가 그의 입술을 손가락으로 훑습니다..{/n} \"말해보세요... 약쟁이가 자신분의 약을 받았을 때의 기분을 무엇과 비교할 수 "
"있을까요? 당신에게 걸거치는 사람이 말뚝박혀서 피를 흘리고 있을때는요? 당신 신전의 피로 젖은 망치, 당신 가슴에서 요동치는 심장, 당신 "
"입술에서 빠져나가는 환희의 울부짖음...\" {n}하프엘프가 입술을 열정적으로 깨뭅니다.{/n} \"당신 스스로 복수하는 것을 절대 "
"허락하지 않는다... 그렇다면 당신은 그저 진정한 즐거움과 신성한 황홀감을 모르는겁니다. 우리는... 고객들을 환희의 맛으로 인도하지요, "
"그리고 복수함으로써 우리를 믿게됩니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Answer_0005_Text
msgctxt "c0264179-46f8-4262-a248-b4e366f43eaa"
msgid "\"What's going on here?\""
msgstr "\"여기서 무슨 일이 벌어지는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Answer_0006_Text
msgctxt "6ce3a18d-e4f7-447c-b8bf-9af353781d0b"
msgid ""
"\"I would recognize that armor anywhere. What is a hellknight doing in my "
"lands?\""
msgstr "\"저 갑옷은 어디에서든 알아 볼수 있지. 헬나이트가 내 땅에서 뭘하는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Answer_0007_Text
msgctxt "fbcb33d6-a3b3-4d23-8f30-a5e2e5138f15"
msgid "\"Why did you attack this knight?\""
msgstr "\"왜 이 기사분을 공격한 것이오?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Answer_0012_Text
msgctxt "fa115b15-82f1-426b-a04d-b3b081982cd4"
msgid "\"Stranger, identify yourself!\""
msgstr "\"수상한 놈, 정체를 밝혀라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Answer_0013_Text
msgctxt "b2b4de44-0cdf-4cb1-9454-5dd28c3ebacf"
msgid ""
"[Attack the peasants] \"You broke the law by attacking this knight. The "
"sentence is death!\""
msgstr "[농민을 공격한다] \"이 기사를 공격함으로써 넌 법을 어겼다. 판결은 사영이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Answer_0014_Text
msgctxt "7eaf255f-c1bd-4160-b098-a7148d5e15ff"
msgid ""
"[Attack the hellknight] \"Fellows, let's show this hellknight how we handle "
"his filth in the Stolen Lands!\""
msgstr "[헬나이트를 공격한다] \"동지들, 이 도둑맞은 땅에서 우리가 오물을 어떻게 처리하는지 이 헬나이트에게 보여주자!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Answer_0015_Text
msgctxt "76d36ec3-e8a2-4e5e-af95-62ec67187776"
msgid "\"I have no wish to interfere. Deal with this yourself.\""
msgstr "\"나는 간섭하고 싶지 않소. 당신들끼리 해결하시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Barks/Attacked_Hellknight_String
msgctxt "29910452-8486-4332-8d9a-c4f7d72dfee3"
msgid "\"Glory to the Order of the Nail!\""
msgstr "\"대못 기사단에 영광을!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Barks/Attacked_Peasant_String
msgctxt "e36098f0-dcb8-4730-ac2a-14102f609475"
msgid "\"Look out lads!\""
msgstr "\"조심하라, 제군들!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Barks/Entrance_01_Peasant1_String
msgctxt "8abab428-61d3-4292-a3d4-f2b1b77f463d"
msgid "\"He's wounded. Come on, lads, give me a hand!\""
msgstr "\"그는 부상당했다. 이리, 손을 내밀게, 친구!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Barks/Entrance_02_Peasant2_String
msgctxt "e405fba1-1d78-44c1-aae7-ffd07ba4ec80"
msgid "\"What's the matter, you scoundrel? Don't like our hospitality?\""
msgstr "\"무엇이 문제냐, 이 건달놈! 우리의 호의가 맘에 들지 않더냐?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Barks/Entrance_03_Hellknight_String
msgctxt "433c67db-7583-4f3c-ad0c-c62b85a35c20"
msgid "\"Dirty, cowardly dogs...\""
msgstr "\"더럽고 비열한 새끼들...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Barks/Hellknight_bark01_String
msgctxt "ce98f4c1-f038-4d3d-83a9-c5023251c033"
msgid ""
"\"Thank you, {mf|baron|baroness|king|queen}. It's a pity we had to meet like "
"this. But all can still be mended.\""
msgstr "\"감사드립니다, {mf|남작|여남작|왕|여왕}. 이런 식으로 만나다니 안타깝습니다. 하지만 모든 일은 바로잡을수 있지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Barks/Hellknight_bark02_String
msgctxt "d51176f3-a929-41be-baa6-0716fa8d9918"
msgid ""
"\"I shall pay you an official visit in the nearest future. We will soon meet "
"again, under less chaotic circumstances.\""
msgstr "\"조만간에 공식적으로 찾아뵙겠습니다. 우리는 다시 만날겁니다, 좀 덜 혼란한 상황속에서.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Barks/Peasant_bark2_String
msgctxt "a9b51c4f-4ec3-4364-877b-9aa68e765a72"
msgid "[Spit on the body of the hellknight]"
msgstr "[헬나이트의 몸에 침을 뱉는다.]"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Barks/Peasant_bark_String
msgctxt "eeb32693-5058-45db-ae4c-26213a95da06"
msgid "\"Go to your Hell, scumbag! Serves you right!\""
msgstr "\"지옥에나 떨어져라, 쓰레기 같은놈! 꼴 좋구만!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0001_Text
#. Speaker : Peasant_Speaker1
msgctxt "c37b0fd3-5cda-44e5-b94a-af2b0d39e9db"
msgid ""
"{n}One of the peasants, who is armed with a weapon, jumps up in alarm as you "
"approach.{/n} \"{mf|Your Grace|Your Grace|Your Highness|Your Highness}!\""
msgstr "{n}농민들 가운데 무장한 자가, 당신이 다가오자 놀라서 펄쩍 뛰었습니다. {/n} \"전하!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0002_Text
#. Speaker : Hellknight
msgctxt "b475b258-1071-4f87-b1bd-cf40eb62f82b"
msgid ""
"{n}You look upon knight in pitch black armor, a monstrous snarling snout "
"emblazoned on his breastplate. He doesn't turn to you — all his attention is "
"taken by multiple adversaries. Nonetheless, you hear a muffled voice from "
"under the visor.{/n} \"Praise {g|Asmodeus}Asmodeus{/g}! "
"{mf|Baron|Baroness|King|Queen} {name}, I presume? My regards. Please accept "
"my apologies for not greeting you as the etiquette requires. I'm a little... "
"busy.\""
msgstr ""
"{n}당신은 칠흑의 갑주를 입은 기사를 보았습니다, 그의 흉갑에는 선명하게 흉측하게 으르렁대는 주둥아리가 새겨져 있었다. 그는 당신을 "
"돌아보지 않았습니다. 그의 관심은 오직 여럿의 적들에게 쏠려 있었습니다. 그렇지만, 당신은 그의 투구 가리개 아래에서 흘러나오는 그의 "
"소리 죽인 목소리를 들을 수 있었습니다. {/n} \"{g|Asmodeus}아스모데우스(Asmodeus){/g}를 경배하라! {name} "
"{mf|남작|여남작|왕|여왕} 각하 이신지요? 평안하셨는지요. 예의에 맞게 인사드리지 못함을 용서해 주십시오. 조금 겨를이...없습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0003_Text
#. Speaker : Peasant_Speaker2
msgctxt "56d98985-bdf8-4bc2-81f0-db61049c0452"
msgid ""
"{n}Another peasant takes a moment to quickly wipe the sweat from his "
"forehead.{/n} \"You're just in time! Look... Look who we've caught here! "
"Look at the disgusting creature. He isn't afraid of anything!\""
msgstr ""
"{n}또 다른 농민이 잽싸게 그의 이마에 난 땀을 닦아 내렸습니다.{/n} \"제 때에 와주셨군요! 보...보십시오 저희가 누굴 "
"잡았는지! 이 역겨운 놈을 보십시오. 이놈은 어떤 것도 두려워 하질 않습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0008_Text
#. Speaker : Hellknight
msgctxt "762ec3db-3825-43a3-a2dd-ff32eea47c3b"
msgid ""
"{n}You hear a chuckle from under the visor.{/n} \"I intended to come "
"directly to your court, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. Unfortunately, I was detained.\""
msgstr ""
"{n}당신은 투구가리개 아래서 나는 웃음소리를 들었습니다. {/n} \"저는 곧장 여러분의 법정으로 가려 했습니다, 전하. 불행히도, "
"저는 구금되었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0009_Text
#. Speaker : Peasant_Speaker1
msgctxt "760158cd-ae7c-459c-962e-8cf06a6571f2"
msgid ""
"\"These degenerates have never before set foot in the {g|Stolen Lands}Stolen "
"Lands{/g}. — But there, this devil's spawn was walking right in the middle "
"of the road. And we became so angry...\""
msgstr ""
"\"이런 타락한 자들이 {g|Stolen Lands}도둑맞은 땅{/g}에 발을 들여 놓은 적이 없습니다. -그런데, 이 데블의 자식이 길 "
"한 가운데로 걸어들어오다니요. 그래서 우리는 화가 난 것입니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0010_Text
#. Speaker : Peasant_Speaker2
msgctxt "de45db32-bdc0-485a-944c-5e7658a4d665"
msgid ""
"\"Right, we figured we could gang up on him... But you could help, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}! We're shedding blood for your "
"lands, after all!\""
msgstr ""
"\"맞습니다, 저희는 저놈에게 힘을 합쳐 대항할 수 있을 거라 여겼습니다...그런데 전하, 당신께서 도우실 수 있습니다! 저희는 당신의 "
"땅을 위해 피흘릴 수 있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0011_Text
#. Speaker : Peasant_Speaker2
msgctxt "3fdd0bed-7004-4941-8f48-07fa3c2c99b3"
msgid ""
"\"This is a {g|Hellknights}hellknight{/g}! These wretches have dealings with "
"devils!\""
msgstr "\"이 자는 {g|Hellknights}헬나이트{/g}입니다! 이런 비열한 놈들은 데블과 거래하는 자들입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0016_Text
#. Speaker : Peasant_Speaker1
msgctxt "c607a30f-29cc-4882-8165-987e57c20eb2"
msgid ""
"\"Well... you know... they trample everyone whose lands they visit! Wherever "
"there's one, there will soon be a hundred – in a blink of an eye! They crawl "
"like locusts, with their executions and their laws!\""
msgstr ""
"\"그게...아시다시피...그들은 그들이 방문하는 곳의 모든이들의 짖밟았습니다! 처음에는 한 놈이었다가도, 눈 깜짝할 새에 백여명으로 "
"늘어납니다! 그들은 그들의 사형집행과 법률을 가지고선 마치 메뚜기떼처럼 짓쳐듭니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0017_Text
#. Speaker : Hellknight
msgctxt "a5cc1e82-4789-48f0-8858-e1abfcdceb92"
msgid ""
"{n}The {g|Hellknights}hellknight{/g} laughs dryly.{/n} \"Of course. Savages "
"like these fear laws even more than fire or sword. Listen, "
"{mf|baron|baroness|king|queen}, isn't it time to put this bandit trash in "
"its place? You are too soft for such a savage land as this.\""
msgstr ""
"{n}{g|Hellknights}헬나이트{/g}가 무미건조하게 웃었습니다.{/n} \"당연히. 이와 같은 야만인들은 불이나 검보다 더 "
"법률을 무서워하겠지. 들어주십시오, {mf|남작|여남작|왕|여왕} 전하, 이 도적 쓰레기들을 제 자리로 밀어넣을 때가 아닌지요? 당신께선 "
"이토록 야만스런 땅에 대해 너무 무르십니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0018_Text
#. Speaker : Hellknight
msgctxt "21815e5e-f8d3-493e-b5fa-8fcc25b65f52"
msgid ""
"\"Kayse Berro, maralictor of the {g|Order of the Nail}Order of the Nail{/g} "
"of {g|Hellknights}hellknights{/g}.\" {n}The warrior pauses.{/n} \"I hail "
"from {g|Varisia}Varisia{/g}, if {mf|Your Grace| Your Grace|Your Highness|"
"Your Highness} cares to know. I've come under direct orders of the "
"paralictor, in order to hold negotiations.\""
msgstr ""
"\"케이스 베로, {g|Hellknights}헬나이트{/g} {g|Order of the Nail}대못 기사단{/g}의 말랄릭터입니다.\""
" {n}그 전사는 잠시 멈추었습니다.{/n} \"전하께서 만약 궁금하시다면, 저는 {g|Varisia}바리시아{/g}의 출신입니다. 저는 "
"파랄릭터의 명을 직접 받고, 교섭을 하기 위해 왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0019_HellknightAttacks_String
#. Speaker : Hellknight
msgctxt "08253fa9-6b88-4dbf-a4e7-8e16d1c54bf7"
msgid ""
"{n}The knight clenches his weapon.{/n} \"My commander made a mistake in "
"evaluating your potential, {mf|baron|baroness|king|queen}. "
"{g|Asmodeus}Asmodeus{/g}, give me the strength to stand against these "
"savages!\""
msgstr ""
"{n}그 기사는 그의 무기를 힘껏 쥐었습니다.{n} \"제 지휘관께서는 전하의 가능성에 대해 잘못 판단하셨습니다. "
"{g|Asmodeus}아스모데우스{/g}신이시여, 제게 이 야만인들 앞에 굳게 설 힘을 주소서!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0020_Text
#. Speaker : Hellknight
msgctxt "cad5fcf1-8b3c-4582-934e-b8a0a7ca0c2e"
msgid ""
"{n}The {g|Hellknights}hellknight{/g} clenches his weapon.{/n} \"Not the "
"fairest trial, but it's acceptable. Please allow me to help, {mf|Your Grace|"
"Your Grace|Your Highness|Your Highness}. Weeding is our job.\""
msgstr ""
"{n}그 {g|Hellknights}헬나이트{/g}는 그의 무기를 굳게 쥐었습니다.{/n} \"가장 공정한 재판은 아니었습니다만, "
"받아들일 수 있습니다. 제가 도울 수 있도록 허락해 주십시오, 전하. 잡초를 제거하는 것은 저희의 일입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0021_Text
#. Speaker : Peasant_Speaker1
msgctxt "95c8bb05-d479-4338-a504-3f6e6c6fd3b3"
msgid "\"So... so you're just going to stand there and watch us die?!\""
msgstr "\"그...그래서 당신께선 그저 우리가 죽는 것을 거기서 보고만 계실 겁니까?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0022_Text
#. Speaker : Peasant_Speaker2
msgctxt "a4c726bb-d53e-4c08-8745-e02ba19c46d8"
msgid ""
"\"Let's beat {mf|him|her} up for abandoning {mf|his|her} subjects when "
"they're in trouble!\""
msgstr ""
"\"Let's beat {mf|그|그녀} up for abandoning {mf|그의|그녀의} subjects when they're "
"in trouble!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0023_Text
#. Speaker : Peasant_Speaker1
msgctxt "9b71d3f2-bb09-4a08-9398-cf7a963a9c12"
msgid ""
"\"Yeah, right, keep listening to him! These scoundrels mean to conquer us. "
"That's why they're nosing about! That's why!\""
msgstr ""
"\"그래, 맞소, 그의 이야기를 계속 들어봅시다! 이 건달들은 우리를 정복하려는 겁니다. 그러니 저들이 빈정거리는 것이지요! 그래서!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep1_Encounter/Cue_0024_Text
#. Speaker : Hellknight
msgctxt "48521687-74af-493d-bfc8-dd37cf2a5312"
msgid ""
"{n}The {g|Hellknights}hellknight{/g} seems to not hear his adversaries.{/n} "
"\"I ran into some unexpectedly aggressive local fauna. Luckily, I was "
"prepared for such a turn of events. The {g|Stolen Lands}Stolen Lands{/g} are "
"said to be full of surprises.\""
msgstr ""
"{n}{g|Hellknights}헬나이트{/g}는 상대방의 말을 듣지 않는 것 같습니다.{/n} \"예상치 못하게 공격적인 지역 "
"동물상에게 뛰쳐 들어갔습니다. 운좋게도, 저는 이런 사건이 계속되는 것에 준비되어 있었습니다. {g|Stolen Lands}도둑맞은 "
"땅{/g}은 놀라움으로 가득차있다고 애기되더군요..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0005_Text
msgctxt "1e370749-3ce1-4bcf-a8db-4975dc10266d"
msgid "\"What does your help imply?\""
msgstr "\"어떤 도움을 의미하는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0008_Text
msgctxt "f6ae0bc4-b9be-4f6d-8d73-2c5e7f2a0ae5"
msgid "\"How would you benefit from an alliance with me?\""
msgstr "\"동맹이 나한테 어떻게 이득이 된다는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0011_Text
msgctxt "f284b981-dd0e-409f-a989-d5fb2013a3a1"
msgid "\"I want to know more about your Order.\""
msgstr "\"당신 기사단에 대해 좀 더 알고 싶군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0013_Text
msgctxt "82a78de3-99b1-4d26-8f44-52a6e5d9c5f8"
msgid "\"Do Hellknights obey demons, like others in Cheliax?\""
msgstr "\"첼리악스의 다른 이들처럼, 헬나이트들도 데블에 순종합니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0014_Text
msgctxt "d5013638-7de5-4d03-a193-0142031f9788"
msgid ""
"\"But you associate with Hell and its denizens? Aren't you afraid to draw "
"the wrath of those who would confuse you with devil worshipers?\""
msgstr ""
"\"그러나 당신은 지옥과 그곳의 거주자들과 연관되지 않습니까? 당신은 데블숭배자와 당신을 혼동하는 사람들의 분노를 두려워하지 않습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0019_Text
msgctxt "b41394ae-81b0-4c9c-a0df-83a8f3f731b0"
msgid "\"Why did you become a knight?\""
msgstr "\"어째서 기사가 된 것입니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0021_Text
msgctxt "ff24b325-181f-4553-8a3a-916b533ae722"
msgid "\"How does one become a hellknight?\""
msgstr "\"어떻게 해서 헬나이트가 될 수 있습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0022_Text
msgctxt "4fb5b407-cc27-4a5a-85e1-809068126f2b"
msgid "\"Enough. Let's return to discussing your proposal.\""
msgstr "\"충분합니다. 다시 당신의 제안에 대해 논해봅시다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0026_AlignmentShift.Description
msgctxt "48e3e19b-ba33-4a64-a224-1ae2558bc183"
msgid ""
"Refused to enter an alliance with the Order of the Nail, because of their "
"brutal methods."
msgstr "그들의 잔인한 방법 때문에, 대못 기사단과의 연합에 합류하는 것을 거부했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0026_Text
msgctxt "a38af2b7-77f1-4b69-b391-9c9092294b24"
msgid ""
"\"Thank you for your offer, but I cannot embrace your radical methods. The "
"Order of the Nail has no place in my lands.\""
msgstr "\"제안에 감사하지만, 당신들의 급진적인 방법을 받아들일 수 없습니다. 나의 땅에는 대못 기사단을 위한 곳이 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0027_AlignmentShift.Description
msgctxt "f064088f-cba5-4582-9c19-b40b5ac962f8"
msgid "Refused to ally with the Order of the Nail on moral grounds."
msgstr "도덕적 근거에 의해 대못 기사단과 동맹을 맺기를 거부했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0027_Text
msgctxt "a16c9ba1-5df9-446e-a2b3-5a6a807114e5"
msgid ""
"\"Your Order is a nest of tyranny and cruelty. Leave my lands at once and "
"forget the way here.\""
msgstr "\"당신네 기사단은 폭정과 잔학의 둥지일 따름입니다. 나의 땅을 떠나 이곳을 찾아오는 길을 잊어버리시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0029_AlignmentShift.Description
msgctxt "2c2910d2-c0a1-43d2-b99c-6b1cf76a55a2"
msgid "Entered an alliance with the Order of the Nail."
msgstr "대못 기사단과의 동맹에 합류하였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0029_Text
msgctxt "c4f3d0ed-03f7-4747-bfb4-fd34af3f0e93"
msgid ""
"\"I will accept the Order of the Nail's proposal. Together we will bring "
"these lands to heel!\""
msgstr "\"나는 대못 기사단의 제안을 받아들이겠다. 우리가 함께 이 땅을 복종시킬 것이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Answer_0030_Text
msgctxt "9d544f27-e83c-4cd9-8447-976a6e3a5291"
msgid ""
"\"I don't like the idea of inviting an order onto my lands, if it refuses to "
"obey my commands.\""
msgstr "\"내 명령에 따르지 않을 것이라면, 내 땅에 기사단을 초대하고 싶지 않다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0001_Text
msgctxt "6f255cc4-fc78-49af-9005-d231fd277d64"
msgid ""
"{n}A dignified half-elf wearing familiar black armor bows to you "
"ceremoniously. This time his armor is clean of dirt and blood, and he holds "
"his helmet at his side. It is the first time you see the "
"{g|Hellknights}hellknight's{/g} face. Your guest has light hair, transparent "
"blue eyes, and scars from three claws that once disfigured his face.{/n}"
msgstr ""
"{n}친숙한 검은 갑주를 걸친 품위있는 하프엘프가 당신에 엄숙히 허리를 숙여보였습니다. 이번에는 그의 갑옷이 먼지와 피가 깨끗이 "
"씻겨있었고, 그는 그의 헬멧을 그의 옆구리에 잡고 있었습니다. 당신이 {g|Hellknights}헬나이트{/g}의 얼굴을 처음으로 보는 "
"것이었습니다. 당신의 손님은 밝은 머리결과, 투명한 푸른 눈동자에, 얼굴에는 세 개의 발톱자국으로 인한 상처가 나 있었습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0002_Text
msgctxt "1c43ff02-a360-426e-8dc6-4a284fa90941"
msgid ""
"\"Greetings on behalf of the {g|Order of the Nail}Order of the Nail{/g}, {mf|"
"Your Grace|Your Grace|Your Highness|Your Highness}. Our first encounter was "
"most improper, and I dare recommence our acquaintance.\" {n}The half-elf "
"lowers his head.{/n} \"My name is Kayse Berro, and I am here under official "
"orders of my commanding paralictor. We have heard much of you and your "
"method of rule. — It is most unusual for this region.\""
msgstr ""
"\"{g|Order of the Nail}대못 기사단{/g}을 대신하여 인사드립니다, {mf|영주님|영주님|전하|전하}. 저희의 첫 "
"만남은 가장 부적절했지만, 저는 감히 저희의 친분을 재개하고자 합니다.\"{n}그 하프엘프는 그의 고개를 숙였습니다.{/n}\"제 이름은 "
"카이스 베로입니다, 저는 제 파랄릭터의 공식적인 명을 받고 왔습니다. 저희는 당신과 당신의 통치 방식에 대한 많은 것들을 들었습니다 — "
"그것이 이 지역에선 가장 생소하다는 것을 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0003_Text
msgctxt "ed1704b6-40c1-46c7-a5c7-b23c0bdbe7f1"
msgid ""
"\"The {g|Order of the Nail}Order of the Nail{/g} knows about your service to "
"law and order. We also know the integrity that imbues all your deeds and "
"orders. Our order greatly values such rulers as you. — Especially those who "
"are not afraid to weed out barbarity even in dangerous borderlands like the "
"{g|Stolen Lands}Stolen Lands{/g}. With our deepest respect, I, maralictor of "
"the Order of the Nail, offer you our aid. Together, by fire and sword, we "
"can tame this land and bring it under the law.\""
msgstr ""
"\"{g|Order of the Nail}대못 기사단{/g}은 당신의 법과 질서에 대한 봉사에 대해 알고 있습니다. 저희는 또한 당신의 "
"모든 행동과 명령을 담은 진실함을 알고 있습니다. 저희 기사단은 당신과 같은 통치자를 매우 높이 평가하고 있습니다. — 특히 {g|"
"Stolen Lands}도둑맞은 땅{/g}과 같은 위험한 변방에서조차 야만의 싹을 자르는 것을 두려워 하지 않는 이들을 높이 평가하고 "
"있습니다. 저희의 깊은 존경과 함께, 저, 대못 기사단의 말랄릭터는, 당신께 저희의 원조를 제공하고자 합니다. 불과 검으로, 함께, "
"우리는 이 땅을 길들이고 법 아래에 둘 수 있을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0006_Text
msgctxt "8e66bf56-386b-4661-b184-9fd527a740aa"
msgid ""
"\"We will deploy our own garrison in your capital. We will gather a squad – "
"train new recruits if necessary. We will make the "
"{g|Hellknights}Hellknights{/g} a symbol of power and law in your "
"{mf|barony|barony|kingdom|kingdom}. Believe me, such an alliance will "
"increase your power a hundred times over. Public punishments and executions "
"instill respect in the law, even among the dumbest members of the society.\""
msgstr ""
"\"우리는 당신의 수도에 우리의 수비대를 배치할 것입니다. 필요하다면 새롭게 모집한 이들을 훈련시켜 분대를 구성할 것입니다. 저희는 "
"당신의 {mf|남작령|남작령|왕국|왕국}의 권력과 법의 상징으로 {g|Hellknights}헬나이트{/g}들을 자리매김시킬 것입니다. "
"저를 믿어주시길, 이와 같은 연합은 당신의 권력을 백 배는 넘게 증가시킬 것입니다. 이 사회에서 가장 멍청한 이들에게조차도, 공공 처벌과 "
"사형집행은 법에 대한 존중을 심어 줄 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0007_Text
msgctxt "cd960bc3-cd30-488e-9183-32f0281511c0"
msgid ""
"{n}A half-smile appears on Kayse's face.{/n} \"But know this: the {g|Order "
"of the Nail}Order{/g} will never swear fealty to you. We are united by "
"common goals — to stamp out the vestiges of barbarity in the {g|Stolen Lands}"
"Stolen Lands{/g}. Our methods are similar and we don't expect any "
"disagreement. But we do not wish to complicate this alliance with oaths of "
"fealty.\""
msgstr ""
"{n}카이스의 입꼬리 한쪽이 올라갔습니다.{/n} \"그러나 이를 아십시오. 저희 {g|Order of the Nail}기사단{/g}은 "
"결코 당신에게 충성을 서약하지 않을 것입니다. 당신과 저희는 이 {g|Stolen Lands}도둑맞은 땅{/g}에 야만의 흔적을 모두 "
"지워내겠다는 공통된 목표로 단결한 것입니다. 당신과 저희의 방식은 매우 흡사하며, 저희는 어떠한 의견차이도 없을 것이라 기대합니다. "
"그러나 저희는 이 동맹을 충성의 서약으로 복잡하게 만들고 싶지 않습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0009_Text
msgctxt "62621c75-3b6a-4b6d-a378-5637b7b4bdbe"
msgid ""
"{n}Kayse considers the answer for a while.{/n} \"'Savagery must be quelled, "
"across the land, at home, and in one's own mind.' It's a beautiful motto, "
"isn't it? I've lived my greatest years by it. My brothers live by it. The "
"goal of my {g|Order of the Nail}Order{/g} is to destroy all threats to "
"civilization, order and law. We need no divine guidance to serve this "
"mission faithfully: our minds and our consciences guide us, and they have "
"brought us here to you.\""
msgstr ""
"{n}카이스는 잠시동안 대답을 생각했습니다.{/n} \"야만적인 행위들은 진압되어야만 합니다, 여러 땅에서, 집에서, 그리고 개인의 머릿 "
"속에서조차. 아름다운 모토가 아니겠습니까? 저는 제 많은 삶의 기간동안 이를 품고 살아왔습니다. 제 형제들도 그러했습니다. 제 {g|"
"Order of the Nail}기사단{/g}의 목표는 문명과 질서와 법을 위협하는 모든 위협을 분쇄하는 것입니다. 저희에겐 이 사명을 "
"충실히 수행하기 위한 신성한 인도가 필요하지 않습니다. 저희의 마음과 저희의 이성이 저희를 이끌며, 저희를 당신에게로 데려다 준 것입니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0010_Text
msgctxt "083635b0-6879-4532-b695-670d19dfa1e8"
msgid ""
"\"You are a beacon of order in lands where once only chaos reigned. I do not "
"know how, but you managed to crush all the forces that opposed you, and you "
"have since then ruled with an iron hand, with no concern that your actions "
"might seem willful or over-zealous. The {g|Order of the Nail}Order{/g} "
"values such powerful allies. Give us the right to enforce the laws in your "
"lands — and you can forget about such uncontrollable beasts as those who "
"attacked me on the road.\""
msgstr ""
"\"오직 혼돈만이 지배했던 이 땅의 유일한 질서의 봉화십니다, {mf|영주님|영주님|전하|전하}. 그 방법은 모르겠으나, "
"{mf|영주님|영주님|전하|전하}께 맞서는 모든 힘들을 분쇄하셨습니다. 그 이후로 {mf|영주님|영주님|전하|전하}은(는) 철권으로 이 "
"땅을 다스리셨습니다, 괴팍스럽거나 지나치게 열성적으로 보일지는 몰라도 말입니다. {g|Order of the Nail}대못 기사단은{/g}"
" 그런 강력한 힘의 동맹을 높게 평가합니다. 저희에게 {mf|영주님|영주님|전하|전하} 땅의 법을 지행할 권리를 부여해주십시오. 그렇게 "
"하면 길에서 저를 공격하는 통제불가능한 야수들에 대해서는 잊으실 수 있을겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0012_Text
msgctxt "e16be58c-1f32-4180-b754-5bb8f271c476"
msgid ""
"\"The {g|Order of the Nail}Order of the Nail{/g} is one of the oldest among "
"the {g|Hellknights}Hellknights{/g}. Like many others, our order traces its "
"roots to {g|Cheliax}Cheliax{/g}. The glory of our knights is so great that "
"the rulers of the lawless and savage {g|Varisia}Varisia{/g} once begged for "
"our help — and we crossed half the continent for an opportunity to suppress "
"barbarity and bring the savages under law.\""
msgstr ""
"\"The {g|Order of the Nail}대못 기사단은{/g} {g|Hellknights}헬나이츠{/g}에서 가장 어려운 기사단 "
"중 하나입니다. 다른 기사단들과 마찬가지로 , 저희 기사단은 {g|Cheliax}첼리악스{/g}에서 그 뿌리를 찾을 수 있습니다. 저희 "
"기사단의 영광은 위대해서 무법하고 야만적인 {g|Varisia}바리시아{/g}의 권력자가 도움을 구걸 한 적이 있습니다. 그리고 저희는 "
"대륙 절반을 횡단했습니다. 야만성을 진압하고 야만인들에게 법을 가져다 주기 위해서 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0015_Text
msgctxt "072ccd45-60b8-4400-a721-1cb87e84c5cc"
msgid ""
"{n}Kayse's cheek twitches, but his voice is calm and measured.{/n} \"I will "
"not unburden you of your other delusions about {g|Cheliax}Cheliax{/g}, but I "
"will clarify one thing. The only power we answer to is the leader of our "
"order – be he a lictor or a vicar. And the order itself serves only one "
"master — the law.\""
msgstr ""
"{n}카이스의 볼이 씰룩거립니다. 하지만 그의 목소리는 차분하고 신중합니다.{/n} \"{g|Cheliax}첼리악스{/g}에 대한 "
"{mf|영주님|영주님|전하|전하}의 또 다른 망상을 덜어드릴 생각은 없습니다. 다만 한 가지만 명확하게 하겠습니다. 저희는 릭토르건 "
"비카르건 간에 저희 기사단 지도자의 명령에만 복종합니다. 그리고 기사단 그 자체는 단 하나의 주인만 섬깁니다. '법'입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0016_Text
msgctxt "a9d67b5b-375b-45e1-b2c1-84c3ea1703f3"
msgid ""
"\"Yes, we draw much inspiration from {g|Hell}Hell{/g}. Why not? In the "
"entire world, there are no greater rules than those created by the Dark "
"Prince and enforced in his kingdom.\" {n}Kayse raises his brows.{/n} \"I "
"myself venerate {g|Asmodeus}Asmodeus{/g}, but my faith is a personal choice, "
"and not the reflection of my membership in the {g|Order of the "
"Nail}Order{/g}.\""
msgstr ""
"\"네, 우리는 {g|Hell}지옥{/g}에서 영감을 이끌어냅니다. 그래서 뭐 어떻습니까? 세상 전체에서, 암흑 대공과 그가 다스리는 "
"왕국에서 만들어진 법보다 더 위대한 법은 없습니다.\" {n}카이스가 눈썹을 치켜올립니다.{/n} \"저 개인적으로는 "
"{g|Asmodeus}아스모데우스{/g}를 공경합니다. 하지만 제 신념은 제 개인적 선택일 뿐이고, 그게 {g|Order of the "
"Nail}대못 기사단{/g}의 단원들을 반영하지는 않습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0018_Text
msgctxt "41eb1d5b-eff8-4218-a069-0defa04cc395"
msgid ""
"\"The fears of the peasants do not concern a ruler — I'm sure you know this "
"well. To fear philosophy is the natural lot of narrow-minded simpletons. All "
"we do is turn theory into reality, but it is only a means to an end, and "
"justified by a higher purpose.\""
msgstr ""
"\"평민들의 공포는 통치자가 고려할 대상이 아닙니다. 이걸 아시는 게 좋을 겁니다. 철학을 무서워 하는것은 편협한 얼간이들의 본성입니다. "
"우리가 해야하는 모든 것은 이론을 현실로 가져오는 것입니다. 하지만 이건 오직 목표만을 의미하며 더 높은 의도에 의해 정당화 됩니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0020_Text
msgctxt "157f25ac-2108-4e7b-8394-768ac5b1a5b6"
msgid ""
"\"I was seeking... order. Calmness. Reliability. Those who raise their "
"voices to freedom have rarely seen its ugly side.\" {n}The half-elf squints, "
"and an angry sneer crosses his lips.{/n} \"A half-blood learns to deafen his "
"ears to the witty insults of those who imagine themselves pure. But the "
"fools fall mute when they see a half-blood wearing black armor with the face "
"of a devil on the breastplate.\""
msgstr ""
"\"제가 추구했던건... 질서입니다. 평온함. 신뢰성. 자유를 부르짖는 자들은 자유의 추한면을 잘 보지 않습니다.\" {n}하프엘프가 "
"눈을 가늘게 뜨고 그의 입술로 화난 조소를 그립니다.{/n} \"혼혈아는 자기들이 순수하다고 생각하는 사람들의 재치있는 모욕을 못들은 척 "
"하는 법을 배웁니다. 하지만 그 멍청이들은 흉갑에 데블이 그려진 검은 갑옷의 하프 엘프를 보면 입을 다물기 시작합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0023_Text
msgctxt "b4417d04-7716-4f57-8bfc-60a332157b2e"
msgid ""
"\"Through sweat and blood. Anyone who wishes to be worthy of the armor must "
"sacrifice everything that stands in the way of this goal — weaknesses, "
"attachments, pity to himself and others. I trained like mad, rubbed my hands "
"sore on sword handles. I studied the laws and rules at night, and every day "
"I carved my mind and body to become perfect instruments of the {g|Order of "
"the Nail}Order{/g}.\""
msgstr ""
"\"땀과 피를 통해서 입니다. 검은 갑옷에 어울리는 사람이 되고 싶은 모든 사람은 '어떤 요소'를 제거하기 위해서 무엇이든 "
"희생해야합니다. 바로 약함, 애착, 그 스스로와 모든 이에 대한 동정심입니다. 저는 미친놈처럼 훈련했습니다, 검 손잡이에 문대져서 제 "
"손바닥이 빨개질 정도였죠. 밤에는 법과 규칙을 공부했습니다. 그리고 {g|Order of the Nail}대못 기사단{/g}의 완벽한 "
"도구가 되기 위해서 매일 제 마음과 몸을 닦았습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0024_Text
msgctxt "022432ed-437f-4d7a-9e4e-81e27f66929b"
msgid ""
"{n}Kayse runs his hand over his face, and his fingers linger for a moment on "
"his terrible scars.{/n} \"I earned my knighting into the "
"{g|Hellknights}Hellknights{/g} in a ceremonial battle against a barbazu, one "
"of the denizens of {g|Hell}Hell{/g}. Everyone worthy of wearing the armor "
"undergoes this ritual. The others become toys for devils, and a disgrace to "
"their families.\""
msgstr ""
"{n}카이스는 손으로 얼구을 가립니다. 그리고 그의 손가락은 잠시 그의 끔찍한 흉터들을 매만집니다.{/n} \"저는 "
"{g|Hell}지옥{/g}의 주민 중 하나인 바르바즈에 대항한 기념비 적인 전투에서 {g|Hellknights}헬나이트{/g} 작위를 "
"받았습니다. 갑옷을 입을 자격이 있는 모든이는 이 의식을 겪습니다. 다른이는 데블들의 장난감이 됩니다. 그리고 가족들에게 망신을 줍니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0025_Text
msgctxt "dbfcbbfd-667b-4477-aa60-59b76e707f49"
msgid "\"As you wish.\""
msgstr "\"분부대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0031_Text
msgctxt "5a2bc665-8b50-4fe2-8523-8c79f937814a"
msgid ""
"{n}Kayse smiles thinly.{/n} \"I understand. But we cannot take the risk of "
"submitting to someone outside the {g|Order of the Nail}Order{/g}. Mortal "
"flesh is weak, and the mind even weaker. What will become of us if we stray "
"from our destined path? We serve a higher purpose and cannot risk it for "
"your convenience.\""
msgstr ""
"{n}카이스가 얆은 미소를 짓습니다.{/n} \"이해합니다. 하지만 저희는 {g|Order of the Nail}대못 기사단{/g}이 "
"아닌 사람에게 털어놓는 위험부담을 질수는 없습니다. 필멸자의 육체는 약하고 정신은 더욱 약합니다. 만약 우리의 길이 갈라지게 되면 어떻게 "
"합니까? 저희는 더 높은 목표를 섬기고 당신의 편의 때문에 이를 위험에 빠뜨릴 수 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0032_Text
msgctxt "bf39ad2e-e525-4023-b066-4c4496747472"
msgid ""
"{n}The eyes of the {g|Hellknights}hellknight{/g} grow cold, and he bows "
"ceremoniously.{/n} \"Then there is nothing keeping me in your lands. "
"Farewell, {mf|baron|baroness|king|queen}.\""
msgstr ""
"{n}{g|Hellknights}헬나이트{/g}의 눈빛이 차가워집니다. 그리고 딱딱하게 숙입니다.{/n} \"그렇다면 제가 "
"{mf|영주님|영주님|전하|전하}의 땅에 더이상 있을 필요는 없군요. 작별입니다, {mf|남작|여남작|왕|여왕}. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0033_Text
msgctxt "8d326b21-7ad8-45d6-8fb5-986f76b3e332"
msgid ""
"{n}The eyes of the {g|Hellknights}hellknight{/g} grow cold, and he shakes "
"his head.{/n} \"Oh, really? I will obey only half of this order. I will keep "
"the memory of how to get to you. I expect I shall see you again, along with "
"the rest of the {g|Order of the Nail}Order{/g}. Farewell, "
"{mf|baron|baroness|king|queen}.\""
msgstr ""
"{n}{g|Hellknights}헬나이트{/g}의 시선이 차가워집니다. 그리고 머리를 흔듭니다.{/n} \"오, 정말입니까? 저는 이 "
"명령에 절반만 따르도록 하겠습니다. 그리고 당신에게 오는 길을 기억하겠습니다. 당신을 다시 보길 고대하겠습니다, {g|Order of "
"the Nail}대못 기사단{/g}들과 말입니다. 안녕히 계시길, {mf|남작|여남작|왕|여왕}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0034_Text
msgctxt "799ae8dc-8752-4b26-acf1-eebd97b02bd0"
msgid ""
"{n}Kayse lowers his head.{/n} \"So be it. My commanders will rejoice in your "
"wisdom!\""
msgstr "{n}카이스가 고개를 숙입니다.{/n} \"그렇게 하겠습니다. 제 지휘관이 당신의 지혜에 매우 기뻐할겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LE_FeastOfNails/Ep2_KTC/Cue_0035_Text
msgctxt "44f91738-91ac-490e-a38c-8ce452fe1170"
msgid ""
"\"I will immediately return to {g|Cheliax}Cheliax{/g} with this news. We "
"already have a reserve at the ready. I will return to the {g|Stolen Lands}"
"Stolen Lands{/g} with a garrison of {g|Hellknights}Hellknights{/g}, and our "
"mission will commence as soon as we enter your lands. My regards, "
"{mf|Baron|Baroness|King|Queen} {name}. I will not be gone for long.\""
msgstr ""
"\"{g|Cheliax}첼리악스{/g}에 이 소식을 가지고 곧바로 귀환하겠습니다 . 이미 준비는 마쳐뒀습니다. {g|Stolen "
"Lands}도둑맞은 땅{/g}으로{g|Hellknights}헬나이트{/g} 부대와 함께 돌아오겠습니다. 그리고 우리가 "
"{mf|영주님|영주님|전하|전하}의 땅에 들어오자마자 임무를 시작하도록 하겠습니다. 안녕히, {mf|남작|여남작|왕|여왕} {name}. "
"오래 걸리진 않을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Answer_0005_Text
msgctxt "a4c1bec5-00c6-4dcf-ac8c-b57d5939af54"
msgid "\"What is it?\""
msgstr "\"이게 뭐요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Answer_0006_Text
msgctxt "fa9c58b2-8dee-4767-b357-60d053546ffc"
msgid "\"You are wasting my time.\""
msgstr "\"내 시간을 낭비하는 군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Answer_0007_Text
msgctxt "2538f77f-d6f4-4cfc-a2b1-481de35a5b0d"
msgid "[Attack] \"You forget you place, rabble!\""
msgstr "[공격한다] \"네 주제를 잊었구나, 평민아!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Answer_0010_Text
msgctxt "6183e526-b217-40c7-9d0b-cbd4219f4ca0"
msgid "\"What people from Mendev? What are you talking about?\""
msgstr "\"멘데브의 어떤 사람? 지금 무슨 얘기 하는거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Answer_0011_Text
msgctxt "e01669f2-d413-4959-97a5-e609072a732a"
msgid "\"Volunteers go to Mendev of their own free will.\""
msgstr "\"자원자들은 멘데브에 자기 의지로 간다..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Answer_0012_AlignmentShift.Description
msgctxt "8cb9cab9-5125-4fb9-a7aa-e0584d3bd875"
msgid ""
"Agreed to expel the Mendevian Crusaders from the Stolen Lands, because of "
"your subjects' pleas."
msgstr "당신 백성의 간청을 이유로 멘데브 십자군의 도둑맞은 땅 추방을 동의했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Answer_0012_Text
msgctxt "2f580c86-5a03-4c90-931a-3837d94c85ad"
msgid ""
"\"I understand your concerns, and I share them. I will order the agents of "
"Mendev to leave my lands.\""
msgstr "\"네 걱정을 잘 알고 있고, 나 또한 같은 걱정을 하고 있다. 멘데브 사절에게 내 땅을 떠나도록 지시하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Answer_0013_AlignmentShift.Description
msgctxt "379c460c-5256-45b5-8632-46af97428bb8"
msgid "Refused to expel the Mendevian Crusaders from the Stolen Lands."
msgstr "멘데브 십자군의 도둑맞은 땅 추방을 거절했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Answer_0013_Text
msgctxt "7438041c-4ed9-49af-8178-d7015a92c5b9"
msgid ""
"\"I will not stand against the missionaries of Mendev. They protect the "
"whole world, putting themselves on the line for all others!\""
msgstr ""
"\"맨데브의 선교단과 맞서지 않을 것이다. 그들 모두가 다른 이들을 위해서 최전선에서 몸을 던지고, 그리하여 전세계를 지키고 있다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Answer_0015_Text
msgctxt "a17d6714-de72-4e7d-9f6d-4dc63fcc3d69"
msgid "\"And who are you?\""
msgstr "\"그리고 너는 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Answer_0020_AlignmentShift.Description
msgctxt "3f5b1baa-141f-4c99-b604-540e7a1aae96"
msgid "Refused to share your 'cannon fodder' with the Mendevian Crusaders."
msgstr "멘데브 십자군에게 당신의 '화살받이'들을 나눠주기를 거부했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Answer_0020_Text
msgctxt "85ced0f1-9f5c-46b6-96ae-30f3e736df2c"
msgid ""
"\"My subjects will die for no one but me. I will immediately drive the "
"henchmen of Mendev from my lands.\""
msgstr "\"내 백성들은 오직 나를 위해서만 죽는다. 즉시 맨데브의 하수인들을 내 영토에서 몰아내도록 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Answer_0021_AlignmentShift.Description
msgctxt "7ceab023-f317-4837-b10a-5b591f36442e"
msgid "Refused to intervene in the affairs of the Mendevian Crusaders."
msgstr "맨데브 성전사들 문제에 관여하기를 거부했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Answer_0021_Text
msgctxt "146edbb4-1fe5-47c7-bc4a-62b2a31587a8"
msgid ""
"\"Let the missionaries from Mendev do what they've come for, and let the "
"volunteers do as their conscience demands. I will not interfere.\""
msgstr ""
"\"맨데브 선교사들이 자기들 할 일을 하게끔 하라, 자원자들에게도 그들의 양심에 따라 행동하게끔 하라. 나는 관여하지 않는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Barks/Peasant_Attack01_String
msgctxt "200b3321-3c25-40e7-a8de-773cb33c2b65"
msgid "\"Hit {mf|him|her}!\""
msgstr "\"{mf|저놈을|저년을} 쳐라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Barks/Peasant_Attack02_String
msgctxt "49c09bcc-e347-43b2-bb33-87612dc60ca6"
msgid "\"What a wretch! Away with the {mf|baron|baroness|King|Queen}!\""
msgstr "\"악마같으니! {mf|남작|여남작|왕|여왕}을 죽여!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Barks/Peasant_Attack03_String
msgctxt "b5c6fd89-cad8-465b-8962-14c876148fb5"
msgid "\"Sold us to strangers, like cattle! Hit the scumbag!\""
msgstr "\"이방인에게 우리를 가축처럼 팔아넘기다니! 이 쓰레기를 쳐라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Barks/Peasant_Grateful_01_String
msgctxt "443c6a60-3104-48fd-bc4f-0d6cd46047db"
msgid "\"Thank you, {mf|Your Grace|Your Grace|Your Highness|Your Highness}!\""
msgstr "\"감사드립니다, {mf|영주님|영주님|전하|전하}!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Barks/Peasant_Grateful_02_String
msgctxt "b0edaccf-3a0d-4309-a57c-52229e8ceb7e"
msgid "\"Praise your name! Our protector!\""
msgstr "\"찬양하라! 우리의 수호자시여!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Barks/Peasant_Grateful_03_String
msgctxt "5ccc9acc-5458-4f46-90ac-19765bb3b8f0"
msgid "\"Right, these scoundrels can go on back to Mendev! Get out of here!\""
msgstr "\"맞아, 이 악당놈들이 맨데브로 돌아갈수도 있어! 여기서 꺼져!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Cue_0001_Text
msgctxt "15261533-71f8-424b-bf52-e0d1e458b5de"
msgid ""
"{n}A angry crowd of peasants is in uproar, and its leader, a rugged young "
"man, takes a few steps forward and speaks up.{/n} \"{mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}, wait! We need to talk to you!\""
msgstr ""
"{n}화난 농민들의 군중은 소란에 빠져있습니다. 그리고 그들의 지도자, 다부지게 생긴 젊은이는 몇 발자국 앞으로 나와서 소리를 "
"높입니다.{/n} \"{mf|영주님|영주님|전하|전하}, 기다려주십시요! 저희 말을 들어주시길 바랍니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Cue_0002_Text
msgctxt "e3e4ec0c-40f5-49cf-810d-8845f1a07ab3"
msgid ""
"\"Forgive us for... ambushing you like this. But your guards and advisors "
"wouldn't let us talk to you at the castle. So we had to wait here until you "
"walked past.\""
msgstr ""
"\"저흴 용서해주십시요... 이렇게 당신을 숨어 기다린 것을요. 하지만 경비대와 보좌관들이 성에서 당신에게 얘기하게끔 하지 않았습니다. "
"저희는 여기서 당신이 지나가기를 기다려야만 했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Cue_0003_Text
msgctxt "650fef54-af7b-4e66-ac7a-985c4346a187"
msgid ""
"{n}The man turns gloomy.{/n} \"And you are wasting lives! It wouldn't hurt "
"you to hear us out!\""
msgstr ""
"{n}남자가 우울한 표정이 됩니다.{/n} \"그리고 당신은 인명을 낭비하고 있습니다! 저희 말을 듣는게 해가 되진 않을겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Cue_0008_Text
msgctxt "086af565-9730-47e3-83ae-957245160d41"
msgid ""
"\"Here's what I wanted to ask you about... It's about those people from "
"Mendev you love so much... why don't you have mercy on your people, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}!? They're dragging our "
"children into someone else's war! And you just go along with it!\""
msgstr ""
"\"저희가 여쭙고 싶은건... {mf|영주님|영주님|전하|전하}께서 그토록 사랑하시는 이 맨데브 사람들에 대해서 입니다... 왜 당신의 "
"백성에게 그만한 자비를 베푸시지 않는겁니까, {mf|영주님|영주님|전하|전하}?!. 맨데브놈들은 우리 아이들을 우리와 상관없는 전쟁으로 "
"끌여들이고 있다구요! 그리고 당신은 그저 맨데브놈들한테 찬동할 뿐이었죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Cue_0014_Text
msgctxt "a9baceb1-d9db-4727-af9c-c631c24c69d8"
msgid ""
"{n}A peasant draws a weapon from under his clothes.{/n} \"Abyss take you, if "
"you won't listen! We'll slaughter you first, and then those kindhearted "
"Mendev creeps! Hail to the demon lords! Hail to Baphomet! Hail to Deskari!\""
msgstr ""
"{n}농민이 옷 속에서 무기를 꺼냅니다.{/n} \"그럼 지옥에 떨어질 거야, 우리 말을 들을 생각이 없다면 말야! 널 도살한 다음엔 "
"마음씨 따뜻한 멘데브 병신들을 쳐죽여주지. 데몬로드를 찬양하라! 바포메트를 찬양하라! 데스카리를 찬양하라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Cue_0016_Text
msgctxt "bdc4cc27-e95f-421e-9d2e-8e9b6d56471d"
msgid ""
"{n}The man shakes his head.{/n} \"Oh, so you've already forgotten about it! "
"The recruiters you supported not long ago — you said it's all right for our "
"boys to go off to Mendev, and die from demon's claws and teeth! They haven't "
"left. They're still walking around villages, telling tales of heroism and "
"duty.\""
msgstr ""
"{n}남자가 고개를 흔듭니다.{/n} \"오, 당신 그럼 벌써 그걸 잊었군요! 당신이 얼마전에 지원했던 그 신병모집자들 말이에요. 당신이 "
"말했지요, 우리 아이들이 맨데브에게 가도 괜찮을 거라고, 데몬들의 손톱과 이빨에 죽어도 괜찮다고요! 그놈들은 아직 안떠났습니다. "
"아직까지도 마을 주변을 돌아다니면서, 영웅심과 의무에 대해 얘기하고 있다구요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Cue_0017_Text
msgctxt "f5469afd-bcbc-4ca8-8bb6-992fcf88722d"
msgid ""
"\"Do you know who listens to their stories the most? Children! Young lads "
"and lasses – as soon as they hear about battle glory, they abandon their "
"families and their work, and run off to Mendev... To die for nothing!\""
msgstr ""
"\"그 놈들 얘기를 누가 제일 많이 듣는지 아십니까? 아이들입니다! 젋은 남자와 처녀들이지요. 그들은 전투의 영광에 대해 듣자마자, "
"가족과 직장을 버리고 맨데브한테 달려갔습니다... 의미없이 죽기 위해서요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Cue_0018_Text
msgctxt "88332cb3-775d-46f4-acce-c1b6922e61d7"
msgid ""
"\"We are your subjects, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}! The ones who live here, plow your land, bow to you when you pass! "
"We just can't take it anymore, those people from Mendev! So we decided to "
"join together... And come to see you...\""
msgstr ""
"\"우린 당신의 백성들입니다, {mf|영주님|영주님|전하|전하}! 여기 살고 있는 사람들이고, 당신 땅을 일구는 사람들이며, 당신이 "
"지나갈때 숙이는 사람들이라고요! 이 맨데브 놈들을 더이상 참을수 없습니다! 그래서 우리는 모이기로 결심했고... 당신을 보러 온겁니다..."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Cue_0019_Text
msgctxt "55565270-8285-4672-a1d8-845c73b2c47c"
msgid ""
"\"Come, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. What free "
"will? Our foolish youth are so naive — just call them, and they'll come "
"running, even into a demon's maw! No, their deaths are on your conscience, "
"not their own!\""
msgstr ""
"\"이봐요, {mf|영주님|영주님|전하|전하}. 무슨 자유 의지입니까? 우리 바보같은 젋은이들은 너무 순진해서. 그저 부르기만 하면, "
"뛰어서 올 애들입니다. 심지어 그게 데몬의 입이라고 해도요! 아니요, 그들의 죽음은 당신 책임입니다, 그들이 자초한 게 아니라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Cue_0022_Text
msgctxt "671047c1-2920-493d-99d1-03cd2a9ceab6"
msgid ""
"{n}The man winces.{/n} \"Thank you for this, {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}. It's better to lose your head for your own lands "
"than for a stranger's!\""
msgstr ""
"{n}남자가 움찔하고 놀랍니다.{/n} \"감사드립니다,{mf|영주님|영주님|전하|전하}. 당신 땅을 위해서 당신의 목숨을 잃는 것이 "
"낫습니다. 이방인을 위해 죽는것보다는요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Cue_0023_Text
msgctxt "d2757309-dadc-4949-8fac-36d3db69cf54"
msgid ""
"{n}The man bows, and the crowd behind him roars approvingly.{/n} \"Thank "
"you, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. I just knew we "
"only had to talk to you in person, and not through your advisors! Believe "
"me, our children will have better lives without those bloodthirsty do-"
"gooders!\""
msgstr ""
"{n}남자가 몸을 숙입니다. 그리고 남자 뒤의 군중이 만족한듯이 소리지릅니다.{/n} \"감사드립니다, {mf|영주님|영주님|전하|전하}"
". 당신하고 직접 얘기하는 것밖에 수가 없다는 걸 알고 있었습니다. 당신의 보좌관을 통해서가 아니라! 장담드립니다, 우리 아이들은 이 "
"피에 굶주린 공상주의자들 없이 더 나은 삶은 살겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Items/MessageDemon_Name_String
msgctxt "f4c86ef3-1a9f-4222-960f-11f650dd3c13"
msgid "A faded letter, smelling of smoke"
msgstr "빛바랜 편지에서 연기냄새가 납니다"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep2_Encounter/Items/MessageDemon_String
msgctxt "dbb7d3c0-7cc0-4c7f-bd57-fd4ba3368d2d"
msgid ""
"\"Scouts report the adversary sent troops to recruit help in nearby "
"countries. The General demands they be stopped before they find allies. Your "
"group is in the Stolen Lands. Do not allow the Mendevians to recruit new "
"forces there. Do whatever it takes.\n"
"Remember: another mistake — and both of us will be given to the vrocks and "
"ripped to pieces.\n"
"Do not fail me.\""
msgstr ""
"\"적이 도움을 받기 위해 근처 국가들에 부대를 보냈다고 정찰병들이 보고합니다. 장군은 적이 동맹들을 찾기 전에 멈춰야만 한다고 요구하고 "
"있습니다. 우리 집단은 도둑맞은 땅에 있습니다. 멘데브인들이 주변 국가에서 새 병력을 징집하지 못하게 해야 합니다. 무슨 수를 쓰더라도."
"\n"
"기억하세요:한번의 실수에 우리 모두 브록스에게 내던져져서 갈기갈기 찢어질 겁니다.\n"
"절 실망시키지 마세요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Answer_0005_Text
msgctxt "6374f41f-476b-4363-91f1-34d7e70c1b31"
msgid "\"Thank you, Fes. Your gift will be very useful.\""
msgstr "\"고맙네, 페스. 자네 선물은 매우 유용할거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Answer_0006_Text
msgctxt "88b4f14d-f115-4a97-bb91-13fe19fd13a0"
msgid "\"I don't need your veterans or their wisdom.\""
msgstr "\"난 너의 퇴역군인들도 그들의 지혜도 필요 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Answer_0007_Text
msgctxt "574107b2-f688-4d59-a8a7-4bdadde5438a"
msgid "\"How are things on the front?\""
msgstr "\"전선은 어떻지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Answer_0008_Text
msgctxt "4cee45f1-9cd9-4392-add1-1eeeaebe20e4"
msgid "\"You send me cripples and old men as a sign of gratitude?!\""
msgstr "\"당신은 감사함의 표시로 불구자와 늙은이들을 네게로 보낸 건가?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Answer_0009_Text
msgctxt "6d85f5cc-bda9-4cdf-b65e-cdff3d4397fc"
msgid ""
"\"Agents of the Worldwound come to my lands — and they even attacked me!\""
msgstr "\"월드운드의 첩보요원들이 내 땅으로 왔네.  심지어 나를 공격하기까지 했지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Answer_0015_Text
msgctxt "08802829-8867-4e5a-8639-9ac22ae7bc1c"
msgid ""
"\"The leader of cultists who ambushed me on the road mentioned two names: "
"Areelu and Deskari.\""
msgstr "\"도로 위에서 나를 기습했던 광신자들의 우두머리는 두 이름을 언급했다. 아릴루와 그리고 데스카리.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Answer_0017_Text
msgctxt "5b8ab69a-eb6f-4393-9f88-51bb5881efeb"
msgid "\"A crusading aasimar. Sounds like a life's calling.\""
msgstr "\"성전의 아시마르라. 인생의 소명처럼 들리는군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Cue_0001_Text
msgctxt "0560f49a-a099-4d19-96ce-0fd3891915be"
msgid ""
"{n}The aasimar before you is wearing armor regaled in the colors of Mendev, "
"and {g|Iomedae}Iomedae's{/g} symbol upon his breastplate. The visor of his "
"helmet is up, and you remark the unusual lips and eyes of the messenger, "
"that appear as though cast in metal. The aasimar salutes you in military "
"style.{/n} \"Greetings, {mf|Baron|Baroness|King|Queen} {name}! Allow me to "
"introduce myself: Fes Aldragem, commander of the Mendev army. I have come "
"here on behalf of my knightly order, with an official acknowledgement.\""
msgstr ""
"{n}당신 앞의 아시마르는 멘데브의 빛깔로 치장되고, 흉부에는 {g|Iomedae}이오메데의{/g} 상징이 그려져 있는 갑옷을 차려 입고 "
"있습니다. 그의 투구 가리개는 올라가 있고, 당신은 전령의 범상치 않은 입술과 눈동자를 눈여겨 봅니다. 그것은 마치 강철로 벼려진 것 "
"같이 눈에 띕니다. 그 아시마르는 군대식으로 당신에게 경례를 올립니다.{/n} \"반갑습니다, {mf|남작|여남작|왕|여왕} {name}"
"이시여! 제 소개를 하도록 허락해 주십시오. 페스 알드라젬, 멘데브 군대의 사령관입니다. 저는 여기 공적인 용무로 기사단을 대신하여 "
"왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Cue_0002_Text
msgctxt "c604d7e5-f3f5-4b96-b5a9-08fa2a46f5b4"
msgid ""
"\"Not long ago, our missionaries entered your lands to find brave men and "
"women, ready to challenge the {g|Abyss}Abyss{/g} itself. You did everything "
"you could to reinforce the ranks of Golarion's defenders, and many of your "
"people stood ready to serve a higher goal. Our missionaries visited many "
"lands, and few if any have done as much as you, for our common good. You "
"have acted nobly, {name}, and have proven yourself a loyal ally of Mendev.\""
msgstr ""
"\"얼마 전에, 우리 선교사들이 {mf|영주님|영주님|전하|전하}의 영토에 들어가 {g|Abyss}심연{/g}에 도전할 준비가 되어있는 "
"용감한 남녀들을 찾아다녔습니다. 당신께서는 골라리온 수호자들을 강화하기 위한 모든 일을 해주셨습니다. 그리고 당신의 많은 백성들은 더 "
"높은 목표를 섬길 채비가 갖추었습니다. 우리 선교사들은 수많은 땅들은 방문했습니다만, 우리의 공공의 선을 위하여 당신만큼 해주신 이들은 "
"거의 없었습니다. 당신은 고귀하게 행동하셨습니다, {name}, 그리고 당신 자신이 멘데브의 충성된 동맹이란 것을 증명하셨습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Cue_0003_Text
msgctxt "dc137996-016f-4c32-81c8-8af638ff767c"
msgid ""
"\"We value every soul who serves to protect {g|Golarion}Golarion{/g} from "
"the demon hordes. However, we felt we simply must thank you specially for "
"showing such valor and nobleness. I have something for you: a few veterans "
"from Mendev have come with me. They are ready to remain here and train your "
"soldiers in military skills. Any country could benefit from the knowledge "
"these worthy officers possess. They only left the battlefield to make room "
"for soldiers stronger and younger.\""
msgstr ""
"\"우리는 {g|Golarion}골라리온{/g}을 데몬의 군세로부터 지켜내기 위해 봉사하려는 모든 영혼을 가치있게 여깁니다. 하지만 "
"우리는 용맹과 고귀함을 보여주신 당신께 특별히 감사드려야 된다고 느꼈습니다. 당신께 제안드릴게 있습니다. 멘데브의 퇴역군인 몇몇이 저와 "
"함께 동행했습니다. 그들은 여기 남아서 병사들에게 군사 기술을 가르칠 준비가 되어 있습니다. 이 사관들로부터의 지식은 어느 국가라도 득이 "
"될 수 있을 겁니다. 그들은 단지 자신들보다 더 강하고 어린 병사들에게 전장에서의 자리를 양보하기 위해서 떠난 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Cue_0010_Text
msgctxt "092702cd-2a36-4308-a134-badc1fb5d962"
msgid ""
"{n}Fes smiles, but his eyes are tired.{/n} \"Our forces need aid. Every day, "
"new hordes of demons come to the {g|Worldwound}Worldwound{/g}, ready to rip "
"to pieces anyone who stands in their way. This is why we value every "
"volunteer who is ready to stand under Mendev's flag.\""
msgstr ""
"{n}페스가 미소를 짓습니다. 하지만 그의 두 눈은 지쳐 보입니다.{/n} \"우리 병력은 지원이 필요합니다. 매일매일, 새로운 데몬의 "
"군세가 {g|Worldwound}세계의 상처{/g}에서 몰려옵니다. 그놈들을 막는 모든 사람을 고깃조각으로 만들 준비가 된 상태로 "
"말입니다. 이것이 바로 우리가 멘데브의 깃발아래서 싸울 준비가 된 모든 자원자를 가치있게 여기는 이유입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Cue_0011_Text
msgctxt "03a38f5a-4af5-41da-8be7-a202d52a4953"
msgid ""
"{n}Fes shakes his head.{/n} \"The {g|Abyss}Abyss{/g} reaches its tentacles "
"far and wide. We recently lost two recruitment teams who were supposed to "
"return to Mendev with help. I'm glad you didn't suffer their fate. The {g|"
"Stolen Lands}Stolen Lands{/g} would be unlikely to survive such a loss.\""
msgstr ""
"{n}페스가 머리를 가로 젖습니다.{/n} \"{g|Abyss}심연{/g}이 그 촉수를 멀리 넓게 뻗치고 있습니다. 최근에 우리는 "
"자원자들과 함께 맨데브로 돌아왔어야 하는 두 개의 징집팀을 잃었습니다. 당신이 그들과 같은 운명을 겪지 않아서 다행입니다. 그런 "
"손실이라면, {g|Stolen Lands}도둑맞은 땅{/g}은 버티지 못할겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Cue_0012_Text
msgctxt "eece4636-f935-4472-822b-72cf35c9cfd0"
msgid ""
"{n}Fes knits his brows.{/n} \"Your reproach is groundless, "
"{mf|baron|baroness|king|queen}. Each of these warriors have been through "
"everything one can face of the field. They have seen terrors enough for ten "
"mortals. Many warlords would pay any amount for such trainers. Their "
"experience is truly priceless.\""
msgstr ""
"{n}페스가 이맛살을 찌푸립니다.{/n} \"근거없는 비난을 하시고 있습니다, {mf|남작|여남작|왕|여왕}님. 이 전사들 각각이 "
"전장에서 마주칠 수 있는 모든 아수라장을 헤쳐왔습니다. 그들은 필멸자 열 명이 해당할만한 공포들을 봤습니다. 이런 훈련가들을 위해서라면 "
"많은 전쟁군주들이 비용을 마다하지 않을겁니다. 전사들의 경험이 정말로 귀중하기 때문입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Cue_0013_Text
msgctxt "2ab07cde-49f2-4c9d-8d5d-12965eb918bd"
msgid ""
"{n}Fes bows.{/n} \"My regards. Now it is time for me to return to Mendev. I "
"shall go with a light heart, in hopes that the alliance of our states will "
"remain strong, no matter what our enemy plots. Farewell!\""
msgstr ""
"{n}페스가 몸을 숙여 절합니다.{/n} \"이만 가보겠습니다. 멘데브로 돌아갈 시간입니다. 적들이 무엇을 꾸미건 간에 우리 동맹의 "
"도시들이 강하게 남을 거라는 희망과 함께 가벼운 마음으로 돌아갈수 있겠습니다. 안녕히!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Cue_0014_Text
msgctxt "dfb3b44a-42d1-4f49-83a5-676b5405fd2d"
msgid ""
"\"Hmm. I am sorry to hear that. Nonetheless, my companions will enjoy the "
"hospitality of the locals and remain in these lands — just in case you "
"change your mind and decide to take advantage of their knowledge.\""
msgstr ""
"\"흠. 유감입니다. 그래도 제 동료들은 지역주민들의 환대와 이 땅에 남아있는 것에 즐거워 할 겁니다. 당신께서 마음을 바꾸셔서 저희 "
"지식을 이용하기로 하시기를 결정하실때를 대비해서 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Cue_0016_Text
msgctxt "53e32825-b12d-406e-8490-d474da31ba05"
msgid ""
"\"Those filthy names are known to everyone in Mendev. Deskari is the demon "
"lord who stands behind the {g|Worldwound}Worldwound{/g} – one of the "
"greatest spawns of the {g|Abyss}Abyss{/g}. The vile lech Areelu Vorlesh is a "
"corrupt witch, one of the most celebrated denizens of the Worldwound. I've "
"heard of the atrocities she commits upon her prisoners and even her own "
"slaves...\" {n}Fes shudders.{/n} \"The sooner this evil is destroyed, the "
"better.\""
msgstr ""
"\"이 오물들의 이름은 멘데브 사람 모두가 알고 있습니다. 데스카리는 {g|Worldwound}세계의 상처{/g}의 배후에 있는 데몬 "
"군주입니다. {g|Abyss}심연{/g}이 낳은 가장 강력한 존재 중 하나입니다. 비열한 발톱 아릴루 볼리쉬는 타락한 마녀입니다. 세계의 "
"상처의 가장 유명한 생물 중 하나입니다. 그녀가 죄수들에게 저지른 잔혹한 행위를 들어본 적이 있습니다. 심지어 그녀의 노예들에게도 "
"저질렀다고 하는군요... \" {n}페스가 몸서리칩니다.{/n} \"이 악이 없어지는게 빠르면 빠를 수록 더 좋겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LG_HonorAndDuty/Ep3_KTC/Cue_0018_Text
msgctxt "f25c74ce-0d1c-4fe0-8d47-e28cc4e6b03c"
msgid ""
"{n}Fes curves his metallic lips in a smile.{/n} \"You could say so. Blood "
"seethes in my veins when I anticipate a fight against the spawns of evil. "
"I'm happy I've managed to direct my passions in the right direction.\""
msgstr ""
"{n}페스가 강철같은 입술을 구부려서 미소를 짓습니다.{/n} \"그렇게 말할 수도 있습니다. 악의 종자들과 싸울때 제 혈관의 피가 "
"끓어오릅니다. 제 열정을 올바른 곳에 쏟을 수 있어서 다행입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Answer_0005_Text
msgctxt "ea9311de-30be-4003-a181-b936e7085e9a"
msgid "\"Tell me about yourself and your crew.\""
msgstr "\"당신과 당신 동료에 대해 말해보시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Answer_0006_AlignmentShift.Description
msgctxt "a3f67e8f-c9c7-4456-b1bb-eb987d0ccd05"
msgid ""
"Allowed the mining brigade to camp and prospect in the "
"{mf|barony|barony|kingdom|kingdom}."
msgstr "{mf|남작령|남작령|왕국|왕국}에서. 광부 단체가 캠프를 만드는 것과 탐광을 허락했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Answer_0006_Text
msgctxt "bde94e16-e0a4-40f6-8ff0-5e6fad4609f1"
msgid ""
"\"I've no reason to prohibit you anything. Respect the local laws, and you "
"will be welcome anywhere in my {mf|barony|barony|kingdom|kingdom}.\""
msgstr "\"금지할 이유가 하나도 없군. 지역 법을 준수하면 내 {mf|남작령|남작령|왕국|왕국} 어디에서든 환영받을 걸세.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Answer_0008_AlignmentShift.Description
msgctxt "8b51bcf1-74e2-4bda-90fd-dccc48f49f6e"
msgid ""
"Demanded an impossible cost for prospecting in the "
"{mf|barony|barony|kingdom|kingdom}."
msgstr "{mf|남작령|남작령|왕국|왕국} 탐광에 불가능한 비용을 요구했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Answer_0008_Text
msgctxt "33311365-d6bf-476f-b0cb-b1be123b7d2b"
msgid ""
"\"You can stay only if I have my cut. I require three quarters of your "
"profits.\""
msgstr "\"당신은 제 몫을 제공할 경우에만 머무를 수 있습니다. 나는 당신의 이익의 4의 3을 요구합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Answer_0009_AlignmentShift.Description
msgctxt "a8e0d8bb-29ad-4f39-8ced-5b67c0eb0cb2"
msgid "Sheltered the mining brigade in the {mf|barony|barony|kingdom|kingdom}."
msgstr "{mf|남작령|남작령|왕국|왕국}안에 광부 단체의 쉼터를 제공했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Answer_0009_Text
msgctxt "e940e22e-53b1-4597-bf1c-ce4956bf0915"
msgid "\"I'm glad to give shelter to travelers seeking a new home!\""
msgstr "\"새 보금자리를 찾는 여행자들에게 기쁘게 쉼터를 제공하지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Answer_0010_Text
msgctxt "33f3f096-acc7-4dd4-a5da-3a85e7b6dbc5"
msgid "\"What's wrong with the River Kingdoms?\""
msgstr "\"강의 왕국들과 무슨 문제가 있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Answer_0012_Text
msgctxt "87583a2a-abc8-458b-b9f6-33fed1482ac8"
msgid "\"What are you looking for in the Stolen Lands?\""
msgstr "\"도둑맞은 땅에서 뭘 찾고있나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Answer_0014_AlignmentShift.Description
msgctxt "f87021d0-c58f-4a42-8186-29ccdb08ce07"
msgid ""
"Forbid the mining brigade to prospect in the "
"{mf|barony|barony|kingdom|kingdom}."
msgstr "{mf|남작령|남작령|왕국|왕국}내 광부 단체의 조사 행위를 금지했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Answer_0014_Text
msgctxt "81af23e3-009b-46ce-909e-6d02286c5722"
msgid ""
"\"You will not be allowed to set up camp on my lands. Take yourself "
"elsewhere.\""
msgstr "\"너희들이 내 왕국에 캠프를 설치하도록 허락하지 않겠다. 다른 왕국을 알아보도록.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Cue_0001_Text
msgctxt "117228f2-0c2a-4c62-905e-c1445ee7cf11"
msgid ""
"{n}A dwarf in worn clothes and a dusty cloak clears her throat before she "
"speaks.{/n} \"Your Honor! I am so happy to be allowed to speak to the "
"{mf|baron|baroness|King|Queen} in person! I'm sorry if I sound clumsy. I'm "
"just a common woman, don't know no courtesies. I'm Dri Stinvag, head of a "
"mining crew. I only troubled you to make you a business offer.\""
msgstr ""
"{n}낡고 더러운 망토를 두른 드워프가 말하기 위해 목을 가다듬습니다다.{/n} \"감사합니다! 저는 {mf|남작|여남작|왕|여왕}과 "
"직접 이야기 할 수 있도록 허락받아 매우 기쁩니다! 제 말이 조금 서투르다면 죄송합니다. 저는 단순한 평민 여성이고, 궁내 예절같은건 "
"모르니까요. 저는 한 광부 단체의 수장인 드리 스틴바그입니다. 저는 당신께 사업 제안을 드리기위해 찾아왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Cue_0002_Text
msgctxt "1de973a6-f379-4be0-815b-1a6722db1125"
msgid ""
"\"We're good at finding ore. We've been hoping to dig for ore in the {g|"
"River Kingdoms}River Kingdoms{/g}, but there are local laws...\" {n}The "
"dwarf waves her hand in frustration.{/n} \"It hasn't been easy, you could "
"say. We were about to head out north, but then we heard about {mf|Your Grace|"
"Your Grace|Your Highness|Your Highness}. Aren't we lucky? The most criminal "
"lands of the River Kingdoms are now full of order and peace. So I decided to "
"try my luck out here.\""
msgstr ""
"\"저희에겐 광맥을 찾는 뛰어난 기술이 있습니다. 저희는 {g|River Kingdoms}강의 왕국들{/g}에서 광부로서 살고싶습니다만, "
"그 지방의 법이 있죠...\" {n}드워프는 좌절감으로 머리를 흔들었다.{/n} \"쉽지 않았죠. 저희는 더 북쪽으로 이동하려 했습니다. "
"하지만 그 때 {mf|영주님|영주님|전하|전하}의 이야기를 들었습니다. 행운이지 않나요? 강의 왕국들 중에서도 가장 위험한 땅이었던 곳에 "
"이제 평화와 질서가 세워졌습니다. 그래서 저희는 여기서 저의 운을 시험해보기로 한겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Cue_0003_Text
msgctxt "4b0c1036-329f-48e4-9d0f-e131417b5ca3"
msgid ""
"{n}Dri hesitates and then bows clumsily.{/n} \"{mf|Your Grace|Your Grace|"
"Your Highness|Your Highness}, allow us to set up a camp in your domain! "
"It'll be safer under your protection. And you'll benefit from it, too! If we "
"discover an ore deposit, we can start mining! Just help us find a spot of "
"land. We're no cheats! We'll do the right thing and sign whatever agreements "
"you got! What do you say? Is it a yes?\""
msgstr ""
"{n}드리는 망설이다가 서투르게 경례합니다. {/n} \"{mf|영주님|영주님|전하|전하}, 당신의 땅에 정착할 수 있도록 허락해 "
"주십시오! 당신의 보호하에서라면 안전할겁니다. 또한 저희들로부터 이익도 얻으실 수 있을겁니다! 만약 저희가 광맥을 찾아낸다면, 즉시 "
"채광을 시작할 수 있습니다. 저희가 적절한 장소만 찾을 수 있도록 도와만 주십시오. 절대 속이려 들지 않겠습니다! 저희는 정직하게 "
"일할것이며, 당신이 요구하는 어떤것이라도 서명하겠습니다! 허락해주시겠습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Cue_0007_Text
msgctxt "04e53c6b-3b43-4fbc-8c4d-65e905c458a4"
msgid ""
"\"There's nothing much to tell, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}! I come from Brunderton, east of {g|Rostland}Rostland{/g}. Half my "
"crew comes from there too. The others are just a mixed lot – "
"{g|Torag}Torag{/g} knows where from. But you know what's good about us? "
"Every one of us is a true master of their craft. We're a great team of "
"miners, dowsers, and mages – you couldn't find another like it!\""
msgstr ""
"\"말씀드릴 수 있는게 많지는 않습니다, {mf|영주님|영주님|전하|전하}! 저는 {g|Rostland}로스틀랜드{/g} 동부에 있는 "
"브룬더튼에서 왔습니다. 저희들 절반이 그 곳 출신이죠. 다른 이들은 여기저기서 합류했죠. – {g|Torag}토락{/g}께선 그들 모두의 "
"고향을 알 겁니다. 하지만 저희에게 어떤 재주가 있는지 물으신다면? 저희 구성원들 하나하나가 각자의 분야에서 진정한 장인들입니다. 광부, "
"수맥 탐사원, 그리고 마법사들로 이루어진 위대한 팀이죠. – 다시는 이런 집단을 찾을 수 없으실 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Cue_0011_Text
msgctxt "0feaefa5-4a1d-40f7-acd0-30bd5ff54f92"
msgid ""
"{n}Dri cringes.{/n} \"You never know if you'll even survive through the day! "
"One kingdom bans religion. Another declared that the local king was a god. A "
"third one is under water! No way, thank you. Their lands seem promising, but "
"I'm not risking the heads of my crew. We can stand up for ourselves, but "
"we're not warriors, you know. We're miners.\""
msgstr ""
"{n}드리는 민망해합니다.{/n} \"당신께서 거기서 하루라도 살아보지 않으셨다면, 모르시는게 당연합니다! 한 왕국은 종교를 "
"금지했습니다. 다른 왕국에선 왕을 신이라고 선포하죠. 또 다른곳은 아예 물 밑에 있어요! 이건 말도 안되죠. 그곳이 유망하긴 하지만, "
"저는 저희 모두의 위험을 무릅쓸 수 없었습니다. 저희가 자립할 수는 있겠지만, 아시죠, 저희는 전사가 아니라 광부니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Cue_0013_Text
msgctxt "c00da296-988b-42fe-bd84-7cb1f127fd27"
msgid ""
"\"Well...\" {n}The dwarf crosses her arms and stares at the ceiling "
"pensively.{/n} \"We've got to dig in before we know for sure, but I expect "
"we'll find anthracite and iron ore here... Besides, {g|Numeria}Numeria's{/g} "
"not far away! Who knows what could have fallen from the skies long ago! We "
"could even strike adamantine and be rich!\""
msgstr ""
"\"그러면..\"{n}드워프는 팔짱을 끼고 천장을 보며 생각에 잠깁니다.{/n} \"확실히 알기 위해서는 일단 파봐야 합니다. 그렇지만 "
"저희는 이곳에서 무연탄과 철광석을 찾을 수 있을거라 예상합니다. 게다가 {g|Numeria}누메리아{/g}가 멀지 않죠! 옛날에 하늘에서 "
"뭐가 떨어졌는지 누가 알겠습니까? 아다만틴이라도 발견하는 날엔 떼부자가 될겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Cue_0015_Text
msgctxt "48ab54c1-325f-426b-adb7-37dc871e8e06"
msgid ""
"\"Thank you, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. It "
"won't be any trouble for you to assign us a location! After that, there's "
"nothing to worry about – our bookkeeper will work out all the details with "
"your advisors!\""
msgstr ""
"\"감사합니다, {mf|영주님|영주님|전하|전하}. 저희 구역을 지정해주시는게 문제가 되진 않을 거라고 생각합니다! 그러면 이제 걱정할게 "
"없군요 – 저희 회계사가 당신의 보좌관과 상세한 논의를 시작할 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Cue_0016_Text
msgctxt "ac7c1ef6-0dcd-4de2-8dc5-45dbd2459773"
msgid ""
"\"It's a deal.\" {n}Dri shuffles her feet.{/n} \"I'll be on my way then. "
"Thank you again, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! "
"We'll set off to work as soon as we finish the camp. Well, take care now.\""
msgstr ""
"\"거래가 성사되었군요.\" {n}드리는 그녀의 발을 이리저리 움직였다.{/n} \"그러면 바로 출발하겠습니다, "
"{mf|영주님|영주님|전하|전하}. 정착지를 건설하자마자 작업을 시작하겠습니다. 평안하시길 빕니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Cue_0017_Text
msgctxt "d6d2e45e-4211-417b-84cf-b5c09a0b2e59"
msgid ""
"{n}Dri cringes.{/n} \"Well, that's a nice trick. What shall we live on? "
"Charity?\" {n}The dwarf falls silent for a while and then utters a sigh.{/n} "
"\"No, {mf|Your Grace|Your Grace|Your Highness|Your Highness}, it won't do. "
"We'll have to find ourselves another place. You can do whatever you want.\""
msgstr ""
"{n}드리는 뭄을 움츠립니다.{/n} \"훌륭한 트릭이시군요. 저희가 무엇을 위해 살고 있겠습니까? 자선사업?\" {n}드워프가 잠시 "
"침묵했다가 한숨을 내쉽니다.{/n}\"아니요, {mf|영주님|영주님|전하|전하}, 그럴 순 없습니다. 저희는 다른 곳을 찾아 "
"떠나겠습니다.당신의 마음대로죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep1_KTC/Cue_0018_Text
msgctxt "1e144029-0762-4af3-a45e-44beb53b0981"
msgid ""
"\"That's... not good. Ah, whatever. We'll find ourselves something else. "
"Goodbye, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. I won't "
"annoy you any further.\""
msgstr ""
"\"좋...지는 않지만요. 아, 어찌되었든. 저희는 또 다른곳을 찾아보겠습니다. 안녕히 계십시오, {mf|영주님|영주님|전하|전하}. "
"더이상 당신을 화나게 하지 않겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0003_Text
msgctxt "cdf3a99f-100a-4ef1-82d8-a380143cd9fe"
msgid "\"Stop yelling and explain what 'greedy mob' you're talking about.\""
msgstr "\"난리법석은 그만두고 네가 언급한 '탐욕스러운 무리'에 대해 설명해봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0005_AlignmentShift.Description
msgctxt "4f7fab67-71b4-4df8-bfae-ca7720c2d40d"
msgid "Killed the druids without even giving them a chance."
msgstr "드루이드에게 말할 기회조차 주지 않고 죽였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0005_Text
msgctxt "701e18cb-ae4d-4d6b-93f3-cb1b7ff8ed2c"
msgid "[Attack] \"What makes you think I'm here to talk?\""
msgstr "[공격한다] \"뭘 믿고 내가 대화하러 왔다고 생각하지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0012_Text
msgctxt "fccb9482-c46f-446d-a137-1235b9bd31cd"
msgid "\"Who are you?\""
msgstr "\"너는 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0013_Text
msgctxt "37ffe2be-1735-432f-9d86-eef95b02a6f1"
msgid "\"The dwarven miners can hardly be causing as much damage as you say.\""
msgstr "\"드워프 광부들이 네가 말하는 것만큼 큰 피해를 줄 수는 없을것 같은데.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0014_AlignmentShift.Description
msgctxt "b18e1b68-85ad-4c96-a44f-fd22dcd9ef71"
msgid "Protected the miners' right to prospect and mine minerals."
msgstr "광물 자원을 조사하고 채광할 수 있도록 광부들의 권리를 보호했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0014_Text
msgctxt "24266a21-86f2-4f17-bee8-a06b0bc64c44"
msgid ""
"\"I'm sorry, but the miners will keep working. They have my consent, and the "
"right to work.\""
msgstr "\"미안하지만, 광부들은 작업을 계속할거야. 그들은 내 동의를 얻었으니, 일할 권리가 있다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0015_AlignmentShift.Description
msgctxt "0730b0e4-6f36-474f-845d-2957642fd103"
msgid "Prohibited prospecting and mining because local druids were against it."
msgstr "지역 드루이드의 반대를 이유로 조사와 채광 작업을 금지했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0015_Text
msgctxt "335373f7-1726-4e28-9116-a3255105809e"
msgid "\"If it makes you so upset, I'll send the miners on their way.\""
msgstr "\"그게 널 화나게 한 이유라면 광부들을 쫓아내겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0016_Text
msgctxt "f6ef27e0-be98-453e-a966-27706ea0b27d"
msgid "\"What has the mining crew done to you?\""
msgstr "\"광부들에게 무슨 짓을 했지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0017_AlignmentShift.Description
msgctxt "55969046-2c8d-457f-9f73-f5b14c7c5f33"
msgid "Threatened the druids with execution."
msgstr "드루이드를 처형할 거라고 협박했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0017_Text
msgctxt "e0a651a7-6c45-4103-b0c7-95cf2ddcd3a6"
msgid ""
"\"Enough with this nonsense. Leave my lands before I change my mind and send "
"you to the scaffold.\""
msgstr "\"이런 비논리는 이제 질렸다. 너를 단두대로 보내기 전에 내 땅에서 사라져라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0021_AlignmentShift.Description
msgctxt "0a859a93-1d1f-43e5-b926-2237feddf64b"
msgid ""
"Prohibited local prospecting and mining because of the damage it would cause "
"nature."
msgstr "환경 파괴를 이유로 조사와 채광 작업을 금지했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0021_Text
msgctxt "25af7513-d2bd-48c1-b3d2-5b7f7ff789a2"
msgid ""
"\"The things you're saying… It's awful. I shall immediately prohibit this "
"devastation of my lands.\""
msgstr "\"네가 말한것들은... 끔찍하군. 즉시 내 땅을 파괴하는 행위를 금지하겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0022_Text
msgctxt "f104bbea-904a-4381-a521-5439797c8feb"
msgid ""
"\"What shall the people of the Stolen Lands do? We can't live without metal!"
"\""
msgstr "\"도둑맞은 땅의 사람들이 뭘 해야 하지? 우리는 강철 없이 살 수 없어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0023_AlignmentShift.Description
msgctxt "2ff7141d-74b6-421e-98e4-a01ada67d9f8"
msgid "Killed the druids without even giving them a chance."
msgstr "드루이드에게 기회를 주지 않고 죽였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0023_Text
msgctxt "1d180f34-d712-44e0-a06a-0e7325d6fa81"
msgid "[Attack] \"Are you done whining? It's time to die!\""
msgstr "[공격한다] \"개소리는 다 했나? 이제 죽을 시간이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0024_Text
msgctxt "956ed20c-6e9f-48ee-ae53-cd86a080b477"
msgid "\"What have you done to the lost miners?\""
msgstr "\"사라진 광부들에게 무슨 짓을 헀지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Answer_0032_Text
msgctxt "80ff62f1-93fb-4495-90cb-373999a3a0f6"
msgid "\"You're... not very polite.\""
msgstr "\"너는... 매우 무례하군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Barks/DruidHelper_01_String
msgctxt "56627444-88eb-4042-b022-b96f8bf55567"
msgid "\"You can't stop nature's wrath!\""
msgstr "\"너는 자연의 분노를 막을 수 없으리라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Barks/DruidHelper_02_String
msgctxt "8f75f182-81eb-4e28-9be1-a9da155e4d66"
msgid "\"Death to the invaders!\""
msgstr "\"침략자에게 죽음을!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Cue_0001_Text
msgctxt "841daa0a-8504-4e31-a440-33745b62bc6a"
msgid ""
"{n}A girl in a dusty robe is staring at you with clenched fists.{/n} \"You! "
"You're the one who thinks they're the ruler of these lands! Why are you "
"here? Did you want to head a greedy mob and clear yourselves a road to "
"bounty?\""
msgstr ""
"{n}더러운 로브를 입은 한 소녀가 주먹을 꽉 쥐고 당신을 노려봅니다.{/n} \"너! 네가 이 땅의 지배자라고 생각하는 사람이구나! "
"여긴 왜 왔지? 네가 그 탐욕스러운 무리를 보내서 보물 사냥을 시킨건가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Cue_0007_Text
msgctxt "b46eb5ad-07b4-4bf3-92ca-6bba106addea"
msgid ""
"{n}The girl tries to catch a breath, but gasps with rage at your words.{/n} "
"\"I'm talking about the mob you let onto these lands! The little bearded men "
"who think they can grab whatever they want!\""
msgstr ""
"{n}소녀는 숨을 고르려고 했지만, 당신의 말에 호흡이 거칠어집니다.{/n} \"나는 네가 이 땅으로 들여보낸 폭도들 얘기를 하는거야! "
"자기들이 원하는건 뭐든지 얻을 수 있다고 생각하는 키 작고 수염난 것들!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Cue_0009_Text
msgctxt "8ac01326-fb9d-4062-b12c-0c36b36b267e"
msgid ""
"\"The dwarves that came to you... Didn't you think to wonder why they'd walk "
"such a long way? I'll tell you why. They're locusts! They come to an "
"innocent land and rip it apart like a dead body! They rip up the mountains, "
"mutilate the fields, cut down the forests! And all for profit – for the "
"unborn children that the earth was carrying under its covers!\""
msgstr ""
"\"당신을 찾아온 드워프들... 왜 그리 먼 길을 이동했나 생각도 안해봤지? 왜 그랬는지 내가 말해주지. 그것들은 메뚜기떼야! 놈들은 "
"순결한 땅으로 찾아와서는 시체마냥 찢어발기지! 산을 찢고, 들판을 황폐화하고, 숲을 베어내고! 그리곤 모두 팔아제껴 – 대지가 그 아래에 "
"숨겨뒀던 태어나지 못한 아이들을 전부!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Cue_0011_Text
msgctxt "c8101513-fb6f-49d6-8778-d8bf4bafd896"
msgid ""
"{n}She sobs.{/n} \"Is it not enough what the earth freely gives? The ores "
"and gold that lie on the ground? Why would your subjects want to completely "
"consume all our natural resources? They wound the earth so deeply, it will "
"take centuries to heal!\""
msgstr ""
"{n}그녀는 흐느낍니다.{/n} \"대지가 대가 없이 주는 것들로는 충분하지 않은 거야? 지표면에 드러난 금과 광석들로도? 왜 너의 "
"사람들은 반드시 모든 천연 자원들을 소모해야 하는건데? 그것들은 땅 깊숙한 곳에 자리잡고있고, 회복되려면 몇 세기는 필요해!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Cue_0018_Text
msgctxt "8540bfeb-a398-4524-a76c-39339420c163"
msgid ""
"\"They have come from other lands they've devastated, only to mutilate this "
"country, too! They use their contracts with the authorities to gut the "
"bowels of the earth, and destroy anything that stands in their way – and "
"they get away with it!\""
msgstr ""
"\"그놈들은 그렇게 그들이 파괴한 땅으로부터 왔어. 오직 이 나라를 같은 방식으로 훼손하려고! 그놈들은 대지의 내장을 절개하기 위해 "
"권력자에게 빌붙고, 그러고 나면 그 앞을 막는 모든것을 파괴하지 – 그 뒤엔 다른곳으로 도망쳐버리는 거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Cue_0019_Text
msgctxt "3acaa521-0906-4aeb-85b2-9f4235408e48"
msgid ""
"{n}The girl shakes her head.{/n} \"When the earth is torn apart, it suffers "
"greatly. Once it loses its strength, water and wind finish the job. Did you "
"know that the dwarves uncovered an acidic stream that poisoned several "
"nearby creeks? Did you know that their ore-rinsing elixirs burn the grass "
"and turn good, rich soil into lye?\""
msgstr ""
"{n}소녀는 그녀의 머리를 가로젓습니다.{/n} \"찢어지고 갈라질 때마다, 대지는 몹시 괴로워해. 언젠가 그 힘을 소진하고 나면, 물과 "
"바람도 자기 몫을 해낼 수 없겠지. 그 드워프들이 주변의 작은 개울들을 오염시키는 산성 호수를 방류한 건 알아? 광석을 씻는 용도로 "
"사용하는 액체가 초목을 녹이고 기름진 땅을 잿더미처럼 만들 수 있다는 건?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Cue_0020_Text
msgctxt "7b146734-fb10-4f42-82f0-40924143d816"
msgid ""
"\"I'm sure you didn't. All that people like you can see is the gold they pay "
"for their mountain treasures. Just think about it for a minute. What's to "
"become of your land when your children's children inherit it? What will they "
"be getting? A green country that's full of life – or a dead wasteland that's "
"empty like an eggshell?\""
msgstr ""
"\"물론 알지 못했다는 걸 알아. 너같은 작자들은 그들이 산에서 캔 보물들에만 관심이 있지. 거기서 몇 걸음만 더 나아가봐. 네 손자들 "
"에게 물려줘야 할 대지는 어떻게 될까? 그들은 뭘 물려받을까? 생명으로 가득찬 푸르른 땅일까 – 아니면 계란 껍데기마냥 아무것도 남지않은 "
"죽은 황무지일까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Cue_0025_Text
msgctxt "6ee8fe6e-bd10-4646-b446-2e4a24d892a9"
msgid ""
"\"We're the ones who protect the land against vandals like you and your "
"dwarves. We are followers of {g|Gozreh}Gozreh{/g}. We hear the whispers of "
"the sky and the rivers. We protect our lands against all intruders.\""
msgstr ""
"\"우리는 너와 네 드워프들같은 파괴자들로부터 자연을 수호하는 사람들이다. 우리는 {g|Gozreh}고즈레이{/g}의 추종자지. 우리는 "
"하늘과 강의 속삭임을 들을 수 있어. 우리는 모든 침략자들로부터 우리의 대지를 수호해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Cue_0026_Text
msgctxt "ad9b01e1-9192-455d-aa59-4689bc923ac9"
msgid ""
"{n}Girl's face turns dark.{/n} \"They came to deliver pain, and it's the "
"pain that they shall receive. An eye for an eye. A tooth for a tooth.\""
msgstr "{n}소녀의 표정이 어두워집니다{/n} \"그들이 고통을 가져왔어.그리고 그대로 되돌려받을 거야. 눈에는 눈, 이에는 이로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Cue_0027_Text
msgctxt "1b1a3826-314e-4dc5-b656-c3b67eefc6a3"
msgid ""
"{n}The girl clasps her hands.{/n} \"Aren't the hillside deposits enough? Why "
"gut the earth, while other sources of ore which it uncovered freely have yet "
"to be depleted? There's already more than enough for your and for all your "
"{mf|barony|barony|kingdom|kingdom}!\""
msgstr ""
"{n}소녀는 양 손을 움켜쥡니다.{/n} \"비탈 위에 있는 것들로는 만족을 못하겠어? 아직 건드리지도 못한 광맥들이 지상에 남아도는데, "
"어째서 기어이 대지를 째고 기어들어가는 거야? 이미 너와 네 {mf|남작령|남작령|왕국|왕국} 전체가 쓸 수 있는 충분한 자원이 있잖아!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Cue_0028_Text
msgctxt "603d8898-d63c-456b-baf4-1571e184af75"
msgid ""
"{n}The girl looks at you in astonishment.{/n} \"R-really?\" {n}Her clumsy "
"smile makes her look even younger.{/n} \"I didn't... We didn't know we "
"could... just ask! Thank you, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. Believe me, you're doing the right thing by listening to us. "
"Those... those vandals – they do not belong here!\""
msgstr ""
"{n}소녀는 놀란 눈으로 당신을 바라봅니다.{/n} \"지...진짜?\"{n}그녀의 서투른 미소는 그녀를 더욱 어려 보이게 "
"만듭니다.{/n} \"나는... 그냥 부탁 한 마디로 해결될 줄은.. 몰랐는데! 고마워, {mf|영주님|영주님|전하|전하}! 날 믿어, "
"네가 우리 말을 들어준건 올바른 일이야. 저... 저 파괴자들은 – 저들은 이 땅에 속하지 않아!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Cue_0030_Text
msgctxt "79c388a8-743f-4e26-9a33-5ea2ce81d369"
msgid ""
"{n}Her eyes fill with tears, and she gasps and turns away.{/n} \"I'm ready "
"to die... but I can't risk the lives of my brothers and sisters. You and "
"your dwarves can burn in hell.\""
msgstr ""
"{n}그녀의 눈에 눈물이 고이고, 주먹을 꽉 쥔 채 돌아섭니다.{/n} \"나는 죽을 준비가 됐어... 하지만 내 형제자매들의 목숨은 "
"아니지. 너와 네 드워프들은 지옥에 떨어질거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Cue_0031_Text
msgctxt "54e719df-e69d-41c2-9374-2ddda07502a5"
msgid ""
"{n}The girl lowers her head. You can almost hear her gritting her teeth.{/n} "
"\"It means... we're fighting to the end.\""
msgstr ""
"{n}소녀는 고개를 떨굽니다. 당신은 그녀의 이빨이 갈리는 소리를 간신히 들을 수 있습니다{/n} \"그 말은... 우리가 결국 싸워야 "
"한다는 얘기네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/LN_GozrehsWrath/Ep3_Encounter/Cue_0033_Text
msgctxt "62056c26-0e0f-4fb8-9fd1-2e47a0745a67"
msgid ""
"\"Polite? You and your minions bring only pain and misery to these lands. "
"You decided to come in person and crush us, so you and your gang can "
"continue injuring the earth and the mountains! Shameless, vile, disgusting "
"murderers – that's what you are!\""
msgstr ""
"\"예의? 너와 네 하수인들은 이 땅에 고통과 절망만 주고 있어. 넌 나를 직접 만나서 응징하겠다고 결정을 내렸고, 너와 네 강도들은 "
"계속 대지와 산을 상처낼 거라고! 염치없고, 사악하고, 끔찍한 살인자놈들 – 그게 바로 너희들이야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0004_Text
msgctxt "d6d71617-a4e1-45a6-b7f0-e0423aeceac1"
msgid "\"Who are you?\""
msgstr "\"너는 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0005_Text
msgctxt "2f14a49c-aa8b-4a8b-91d0-7b02405e946e"
msgid ""
"\"I am the {mf|baron|baroness|King|Queen} of these lands. Apologize "
"immediately!\""
msgstr "\"나는 이 땅의 {mf|남작|여남작|왕|여왕}이다. 즉시 사과해라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0006_AlignmentShift.Description
msgctxt "cb79090c-d5fe-4bd8-9b8f-bae155108211"
msgid "Killed the travelers in the camp."
msgstr "캠프의 여행자들을 죽였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0006_Text
msgctxt "b11f0408-4ac7-4295-9020-5f398eb26534"
msgid "[Attack] \"You should watch your language.\""
msgstr "[공격한다] \"말을 조심했어야지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0010_Text
msgctxt "eaa429da-6af7-43eb-83a0-4ae2c03ce21b"
msgid ""
"\"I know who you are, Kaleena. I'm here to kill you and report your death to "
"Areena Korvosh.\""
msgstr "\"난 네가 누군지 안다, 칼리나. 나는 널 죽이고 아리나 코르보시에게 보고하러 왔다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0011_Text
msgctxt "b4f2d2f3-7c8f-4ffd-9c67-3dd78e821068"
msgid ""
"\"I know who you are. Your head is worth a lot of money. Care to make a "
"counter-offer?\""
msgstr "\"나는 네가 누군지 안다. 네 목에 상당한 현상금이 걸려있더군. 살기 위해 제안할 게 있나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0012_AlignmentShift.Description
msgctxt "ee35a678-f509-49d4-a63a-0e4af17016e4"
msgid "Killed the travelers in the camp."
msgstr "캠프의 여행자들을 죽였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0012_Text
msgctxt "11343a82-464b-4e9e-99fc-cabdf83ae1a6"
msgid "[Attack] \"Enough of this drama!\""
msgstr "[공격한다] \"연극은 끝이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0013_Text
msgctxt "c495d7f6-8bf6-432a-98ec-34bd73c5471c"
msgid "\"I'm going my way.\""
msgstr "\"내 갈 길 가겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0021_Text
msgctxt "627a8d67-f98a-4c52-a34c-3216b96957d9"
msgid ""
"\"Jadwiga? The White Witches? I don't understand half of what you're saying."
"\""
msgstr "\"야드위가? 하얀 마녀? 나는 네 이야기의 절반도 채 알아듣질 못하겠는데.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0022_AlignmentShift.Description
msgctxt "b75bd1a0-8ae5-49a4-b832-eb0acb1a5ba4"
msgid "Let Kaleena Jadwiga go without any harm."
msgstr "칼리나 야드위가를 그냥 보냈습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0022_Text
msgctxt "38af7412-fcba-4972-86f9-419b37112e7f"
msgid ""
"\"I'm letting you go, but I won't help you in your scheming against your "
"sister.\""
msgstr "\"너를 그냥 보내주겠다, 그러나 네 자매와의 일은 도와주지 않을거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0023_Text
msgctxt "1f460dcd-8a2a-4e9b-b5f6-b90b829f259d"
msgid "\"I'll help you get rid of your sister. What am I to do?\""
msgstr "\"네 자매를 제거해주마. 내가 뭘 하면 되지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0024_Text
msgctxt "a6d0473b-64aa-4d87-944f-00287f6e8c0f"
msgid ""
"\"I don't care about your family feud. However, I do care about the trade "
"contract Areena offered me.\""
msgstr "\"너희 가족 사이의 불화에는 관심 없어. 하지만, 아리나가 내게 제안한 계약에는 관심있지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0025_AlignmentShift.Description
msgctxt "a57900dc-bc38-4fd2-8724-8f6e970608cd"
msgid "Refused to betray Areena Jadwiga."
msgstr "아리나 야드위가를 배신하길 거절했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0025_Text
msgctxt "5d5ffd8d-3479-47c0-ab3d-3f1a24ee780d"
msgid "\"I promised to help Areena, and I'll not go back on my word.\""
msgstr "\"나는 아리나를 돕기로 약속했고, 난 내가 한 말을 지킬 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0033_Text
msgctxt "d7d8e23b-49e4-4f75-93f4-ac4a5745f0df"
msgid ""
"\"It's your life we're talking about, remember? How about a better offer in "
"exchange for my cooperation?\""
msgstr "\"지금 네 목숨 얘기를 하고 있었지, 기억하나? 내 협력을 얻기 위해 더 좋은 조건을 제시할 수는 없나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0037_AlignmentShift.Description
msgctxt "7be116fe-bd50-4cc1-a01d-dcd5f1825dac"
msgid "Betrayed Areena Jadwiga for her sister."
msgstr "칼리나를 위해 아리나 야드위가를 배신했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0038_AlignmentShift.Description
msgctxt "6536f84b-8547-4501-aa2e-0c515863f265"
msgid "Refused to betray Areena Jadwiga."
msgstr "아리나 야드위가를 배신하길 거절했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0038_Text
msgctxt "3279cfcc-3537-4323-bd2c-ad9f42b2bfe6"
msgid "\"I changed my mind. No deal.\""
msgstr "\"생각을 바꿨어. 거래는 취소다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_0040_Text
msgctxt "fcd16778-feac-4e17-b305-8d0612cff399"
msgid ""
"\"You do realize that if you try to cheat me, I'll contact your beloved "
"sister's grieving friends?\""
msgstr "\"네가 날 속이려고 한다면, 네 사랑받는 자매의 총애받는 친구들에게 찾아갈 거라는 걸 알겠지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_Deal!_AlignmentShift.Description
msgctxt "8fe0a332-3637-47de-a8cb-e67fe474faea"
msgid "Betrayed Areena Jadwiga for her sister."
msgstr "칼리나를 위해 아리나 야드위가를 배신했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Answer_Deal!_Text_String
msgctxt "453b437a-81e3-480e-a011-4ba72550eb7f"
msgid "\"Deal. I'll order my advisor to inform Areena of your death.\""
msgstr "\"좋아. 내 보좌관에게 지시해서 아리나에게 네가 죽었다고 말하게 하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Barks/Kaleena_Leave_01_String
msgctxt "14472dd4-3a02-4b2f-b213-631ddeb0674c"
msgid ""
"\"Don't worry, we won't tarry long. We'll head north as soon as we break "
"camp.\""
msgstr "\"걱정마, 우리는 지체하지 않을거야. 캠프를 철거하자마자 북쪽으로 갈게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0001_Text
msgctxt "f6de69ae-71f0-4bef-80d1-a83ad28e839f"
msgid "\"What are you doing here? Get lost before I lose my temper!\""
msgstr "\"뭐하는거야? 나 열받기 전에 사라져!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0002_Text
msgctxt "2a5847e5-6bd4-449c-ab08-e9087a3048e7"
msgid ""
"{n}A thin, pale woman with an upright posture looks at you with the eyes of "
"an angry cougar, blue as ice. Her bright ginger hair rustles like quiet fire "
"over her white skin.{/n}"
msgstr ""
"{n}호리호리하고 창백한 여성이 얼음처럼 푸른, 화난 쿠거같은 눈으로 당신을 마주봅니다. 그녀의 밝은 적갈색 머리칼은 그녀의 피부에서 "
"조용히 타오르는 것처럼 바스락거리는 소리를 냅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0007_Text
msgctxt "fb2d6c18-cee1-4d81-90cb-cc510a68f9c7"
msgid ""
"{n}Your words make the woman cower. She shrivels, fear in her eyes.{/n} \"I "
"beg your forgiveness, {mf|Your Grace|Your Grace|Your Highness|Your Highness}"
". We've been troubled quite a lot of late. It's made me a little... edgy. We "
"must rest and regain our strength before we head south. We've a long road "
"ahead, but don't worry, we'll be on our way soon.\""
msgstr ""
"{n}당신의 말에 여성이 겁을 먹습니다. 몸을 움츠리고, 공포감이 그녀의 눈에 드러납니다.{/n} \"용서를 구할게, "
"{mf|영주님|영주님|전하|전하}. 우리가 꽤 많은 문제를 겪는 중이라서, 그 모든 것들이 나를 좀... 날카롭게 만든 것 같아. 우리는 "
"남쪽으로 이동하기 위해 휴식을 취해야만 해. 긴 여행이 될 것 같지만, 곧 떠날 테니 걱정하지 마.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0008_Text
msgctxt "affe2c84-f2f9-48dc-bc23-6a414fe908e7"
msgid ""
"\"Why do you care?\" {n}The woman looks you up and down and continues in a "
"calmer tone.{/n} \"Just travelers, {race}. We've been troubled a lot lately. "
"I just want to be left alone. We need to rest and regain our strength before "
"we head south.\""
msgstr ""
"\"왜 신경쓰는 거야?\" {n}여성은 당신을 위아래로 훑어보고는 침착한 톤으로 말을 잇습니다.{/n} \"우리는 평범한 여행자야, "
"{race}. 우리는 꽤 많은 문제들을 겪고 있어. 우릴 그냥 내버려둬 줬으면 해. 남쪽으로 이동할 힘을 회복하려면 휴식이 필요하거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0014_Text
msgctxt "5e196d1b-6b75-436a-9afc-4f7f92a9d063"
msgid "\"What is it?\""
msgstr "\"그게 뭐야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0015_Text
msgctxt "6f7578c8-096f-4dac-bf8b-73109ce572c5"
msgid ""
"{n}Kaleena licks her lips.{/n} \"Oh, really? Then why aren't you attacking "
"me? It seems you're in no rush to obey the tramp's orders. Very good – "
"that's the right thing to do!\""
msgstr ""
"{n}칼리나는 그녀의 입술을 핥습니다.{/n} \"오, 정말로? 그러면 왜 날 공격하지 않는거야? 아마도 그 부랑자의 명령을 따르지 "
"않으려는거 같네. 좋아, 그게 옳은 일이야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0016_Text
msgctxt "d26a5ea9-67e7-4ea6-833d-9b5498cbdc4a"
msgid ""
"{n}Kaleena blinks, then squints.{/n} \"So that's how it is. I see you have a "
"good head for business! Straight to the point. It's a good thing I decided "
"to hide out in the {g|Stolen Lands}Stolen Lands{/g}!\""
msgstr ""
"{n}칼리나는 눈을 깜빡인 뒤, 다시 눈을 가늘게 뜹니다.{/n} \"그럼 이걸로 됐어. 당신 사업 수완이 참 뛰어나다는 건 알겠네! "
"바로 본론으로 들어가자. 내가 {g|Stolen Lands}도둑맞은 땅{/g}에 숨기로 한 결정은 옳은 선택이었어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0017_Text
msgctxt "983a3501-7a6a-480f-9ac0-2682b86ca9ba"
msgid ""
"\"I don't know what lies Areena told you, but I bet she didn't tell you I'm "
"Jadwiga as well. I'll tell you more – I'm Korvosh. We're sisters, falling "
"out over our inheritance. An old story, yes? As soon as our dear mother "
"departed, my deceitful sister announced that I had joined the Heralds of "
"Summer's Return – traitors who look to overthrow not only the Queen herself, "
"but the White Witches altogether!\""
msgstr ""
"\"아리나가 당신에게 어떤 거짓말을 했는진 모르겠지만, 그녀가 나 또한 야드위가라는 건 안 알려줬을 거라는 데 돈도 걸 수 있어. "
"부연설명하자면 – 나는 코르보시야. 우리는 자매고, 유산 상속에 관한 문제 때문에 사이가 틀어졌지. 오래된 이야기야. 그렇지? 우리 "
"어머니가 세상을 떠난 뒤에, 속임수 쓰길 좋아하는 내 자매는 내가 여름의 귀환의 전령단 – 여왕과 하얀 마녀들 모두를 전복하려 하는 "
"반역자 모임의 일원이라고 공표했지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0018_Text
msgctxt "b9a621f8-34d7-47fe-be9b-927df3d8763d"
msgid ""
"\"I care nothing about those madmen, but in {g|Irrisen}Irrisen{/g}, the "
"accusation of being involved with the Heralds is certain death. They let the "
"winter wolves loose upon me. Luckily, I had some money, so I bought the "
"loyalty of a few mercenaries.\" {n}Kaleena looks you up and down.{/n} \"I'm "
"sure I can repay you for your assistance. But it will take more than simply "
"releasing me.\""
msgstr ""
"\"난 그 미치광이들과는 아무 상관도 없지만, {g|Irrisen}이리센{/g}에선 전령단과 얽힌 비난만으로도 사형이니까. 그들은 "
"겨울늑대들을 풀어 나를 추격했지. 운좋게도 내 수중에 돈이 조금 있었고, 그걸로 용병 몇 명을 고용할 수 있었어.\" {n}칼리나는 "
"당신을 위아래로 훑어봅니다.{/n} \"난 당신의 도움을 받기 위해 돈을 지불할 용의가 있어. 하지만 단순히 내 도주를 돕는 걸로 끝날 "
"일은 아니야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0019_Text
msgctxt "732f1f29-61ca-4008-8b5e-5e9baa10f944"
msgid ""
"\"I'm no wealthier than a beggar now, but if you help me get rid of "
"Areena... I can tell you this: I'll outbid her offer by half. Whatever she "
"offered, money, slaves, trade interest... it doesn't matter. You'll getting "
"it all, plus another half. I'll need lots of resources. Areena has many "
"friends, who will be furious if she dies. I must be prepared.\""
msgstr ""
"\"지금의 나는 거지들과 비교해도 딱히 나을 게 없는 형편이지만, 당신이 나를 도와 아리나를 제거해준다면... 하나는 확실히 말할게: "
"그녀가 부른 값에 더해 절반을 더 얹어주지. 돈, 노예, 무역 이자... 그녀가 뭘 제안했더라도 상관없어. 당신은 그 모두를 받을 수 "
"있고, 거기에 절반을 추가로 받을거야. 내겐 많은 자원이 필요해. 아리나에겐 그녀가 죽으면 분노할 친구들이 많으니까. 나도 만반의 준비를 "
"갖춰야해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0026_Text
msgctxt "e26a56e6-425e-463e-aafe-4b0ea9ffb60c"
msgid ""
"\"I bet it's for the grain... Your soil is more fertile here than we have "
"back home.\" {n}Her tone turns from musing to pleading.{/n} \"Don't be "
"hasty. I promise the same contract if you help me. – No, an even better one. "
"I'm bargaining for my life, you know.\""
msgstr ""
"\"곡물 때문이겠지... 당신의 영토가 우리 고향보다 비옥하니까.\" {n}그녀의 목소리가 묵념조에서 애원하는 목소리로 변합니다.{/n} "
"\"서두르지마. 날 도와준다면 동일한 보상을 약속할게. – 아니, 더 많이 줘야겠지. 당신도 알듯이, 나는 내 목숨을 거래하고 있으니까."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0027_Text
msgctxt "0af23165-9436-4cac-a1e8-c4f7a9c307fa"
msgid ""
"\"Must I explain every little thing?! The Jadwiga are the nobles of "
"{g|Irrisen}Irrisen{/g}, the cream of their society, the blue bloods. The "
"White Witches are the Jadwiga supremes: they stand by the throne of Queen "
"Elvanna, they enforce the law in Irrisen and they are the vilest bitches in "
"all the lands, from the Crown of the World to the Kodar Mountains!\""
msgstr ""
"\"그런 소소한것들까지 전부 설명해야 돼?! 야드위가는 {g|Irrisen}이리센{/g}의 귀족들이자, 그들 사회의 크림이고, 푸른 "
"핏줄이지. 하얀 마녀들은 야드위가의 고위층이야: 그들은 여왕 엘반나의 옥좌를 지키는 자들이고, 이리센의 법을 집행하고, 세계의 왕관에서 "
"코다르 산맥까지 통틀어서 세상에서 가장 사악한 창녀들이지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0028_Text
msgctxt "077ccf92-2e12-495d-81a6-c8f9e0daf441"
msgid ""
"\"Phew... All right, thanks for that at least! I won't try your temper "
"further. Farewell!\""
msgstr "\"휴... 좋아, 최소한 그 점은 감사하지! 더이상 당신을 화나게 하지 않겠어. 잘 있길!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0029_Text
msgctxt "19b429e8-8064-479c-805a-0c54903bd169"
msgid "\"Oh you vile creature... Die!\""
msgstr "\"이런 못돼먹은... 죽어라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0030_Text
msgctxt "373f5106-edfd-48bc-9add-71dd36f8a430"
msgid ""
"{n}Kaleena curls her lips in a cold smile.{/n} \"Wonderful. There's only I "
"thing I need from you. Write Areena a letter – tell her I'm dead. Tell her "
"you've sent my body with a sentry, but there's been a delay along the way. "
"She's an arrogant fool. She'll assume it's all over and call off her dogs. "
"In the meantime, I'll sneak back to {g|Irrisen}Irrisen{/g} and strike back!\""
msgstr ""
"{n}칼리나는 그녀의 입술을 오므리고 차가운 미소를 짓습니다.{/n} \"완벽해. 내가 당신에게 필요로 했던게 바로 그거야. 아리나에게 "
"편지를 써 – 그녀에게 내가 죽었다고 말해줘. 당신이 경비를 붙여서 내 시신을 보냈지만 도착하기까지는 약간 지연될 거라고 말이야. 그녀는 "
"오만한 멍청이니까, 다 끝났을거라 생각하고 그녀의 개들을 물릴거야. 동시에, 나는 {g|Irrisen}이리센{/g}으로 숨어 돌아가서 등 "
"뒤를 찌르는거지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0035_Text
msgctxt "b180a4d6-ab31-4abe-bdd7-cd286b4d9280"
msgid ""
"{n}Kaleena grits her teeth.{/n} \"Very well. I'll double Areena's offer. I "
"only hope she didn't offer half of our family's realm...\""
msgstr ""
"{n}칼리나는 이를 갈고 말합니다.{/n} \"좋아, 아리나의 제안한 두 배를 쳐주지. 그녀가 우리 가문의 재산 절반을 주기로 한게 "
"아니길 바라야겠어...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0036_Text
msgctxt "5ddfddb1-dd44-4091-88d0-0016f811182c"
msgid ""
"{n}Kaleena stares firmly at you.{/n} \"I've given you my offer. I'm not "
"changing it.\""
msgstr "{n}칼리나가 당신을 뚫어져라 쳐다봅니다.{/n} \"난 이미 내 제안을 당신에게 말했어. 더 이상 바꾸지 않을거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0039_Text
msgctxt "a57aee6b-14e7-41dd-bbb6-0e9ce03d1733"
msgid ""
"{n}Kaleena rubs her hands together.{/n} \"Then I should get moving. My "
"beloved sister must be missing me terribly. Oh, she'll be so surprised to "
"see me!\" {n}The woman salutes you and calls out to the others.{/n} \"Let's "
"pack it up. We're heading home.\""
msgstr ""
"{n}칼리나는 그녀의 양손을 비빕니다.{/n} \"그러면 나도 움직여야겠어. 내 사랑하는 자매는 날 몹시 그리워하고 있을거야. 오, "
"그녀가 날 보면 소스라치게 놀랄걸!\"{n}여성은 당신에게 경례를 한 뒤 다른 용병들을 부릅니다.{/n} \"짐 싸. 고향에 돌아갈 "
"시간이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep2_Encounter/Cue_0041_Text
msgctxt "5f2321aa-9745-4302-a55a-85781703ac91"
msgid ""
"{n}Kaleena groans, annoyed.{/n} \"Of course, I understand. But I'd place "
"more trust in strangers than my own people. At least I know you won't be "
"talking. My death will profit you nothing.\""
msgstr ""
"{n}칼리나가 낮은 소리로 짜증냅니다.{/n} \"물론 이해하고 있어. 하지만 나는 고향 사람들보다 외지인들을 더 신뢰하지. 적어도 내가 "
"아는 한, 당신이 내 얘기를 하진 않을 거야. 내 죽음은 당신에게 아무 이득도 없으니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Answer_0007_Text
msgctxt "5c02be8e-997a-423a-8765-9785ef7ef0cd"
msgid ""
"\"That's highway robbery! I'll be subject to Areena's whim without getting "
"anything in return!\""
msgstr "\"완전 노상강도 아니야! 내가 돌아가봤자 아무것도 못 얻고 아리나의 변덕에 희생만 당할거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Answer_0008_Text
msgctxt "d8ed8879-cba2-4e2b-a3ce-b6223a2aea70"
msgid "[Continue listening to the ambassador]"
msgstr "[대사의 말을 계속 듣는다]"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Answer_0010_Text
msgctxt "8a48e199-48dd-4ae5-a78e-0820fd1c23cc"
msgid "\"All right, go on.\""
msgstr "\"좋아, 계속해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Answer_0011_Text_String
msgctxt "690b16d8-f5a3-4dae-bef5-4744ce2dd483"
msgid "\"No. I refuse.\""
msgstr "\"아니, 거절하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Answer_0014_Text
msgctxt "d64d930d-ff40-40bc-a0f6-67f01da90547"
msgid ""
"\"I'm not sitting around listening to insults. Throw this frosty worm into "
"prison!\""
msgstr "\"나는 모욕을 들어주려고 이 자리에 앉아있는게 아니다. 저 서리 낀 벌레들을 감옥에 쳐넣어라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Answer_0017_Text_String
msgctxt "f442de95-3df2-484b-825e-419c873b2d42"
msgid "\"I agree.\""
msgstr "\"동의한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Answer_0018_Text
msgctxt "ccc00850-ce81-4cb1-ab64-1d7f3d922549"
msgid ""
"\"Have our special arrangements with Kaleena been included in the contract?\""
msgstr "\"계약서에 칼리나와 합의된 특별조항도 포함되어 있나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Answer_0021_Text
msgctxt "b413260b-f607-45bf-8e39-e3437859020b"
msgid "[Continue listening to the ambassador]"
msgstr "[대사의 말을 계속 듣는다]"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Answer_0023_Text
msgctxt "5b4f5a50-0ee0-4886-98a6-74568e6c1579"
msgid "\"I'm not signing a trade agreement with Irrisen. Leave my lands.\""
msgstr "\"이리센과의 무역 협의에 서명하지 않겠다. 내 땅을 떠나라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Answer_0029_Text
msgctxt "49688d67-e6e2-4168-a378-8cc81df5e92e"
msgid "\"In that case, there won't be a deal.\""
msgstr "\"이 경우에는, 거래가 성립되지 않겠군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Cue_0001_Text
msgctxt "39eca811-9b7d-49a9-b027-312eb13b357f"
msgid ""
"{n}A blond man dressed in furs and brocade bows ceremoniously.{/n} \"{mf|"
"Your Grace|Your Grace|Your Highness|Your Highness}, I am happy to greet you "
"on behalf of her Excellency Duchess Korvosh.\""
msgstr ""
"{n}털가죽을 입고 양단 활을 장비한 금발 남성이 격식있게 인사합니다.{/n} \"{mf|영주님|영주님|전하|전하}, 코르보시 공작 "
"부인을 대신해 제가 뵐 수 있게 되어 기쁩니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Cue_0002_Text
msgctxt "b2153b30-901f-45ab-a772-fe4ecb870f7c"
msgid ""
"\"I am honored to represent Areena Korvosh, the head of the noble house of "
"Hoarwood. My mistress rose to power after her poor mother died and her "
"ungrateful sister fell from grace – may her name be blotted from the history "
"of the house.\""
msgstr ""
"\"호어우드의 고귀한 가문 가주이신 아리나 코르보시를 대변하게 되어 영광입니다. 저의 주인께서는 어머니가 타계하시고 배은망덕한 자매가 "
"명예를 실추한 뒤 권력을 잡으셨습니다 – 아마도 자매의 이름은 족보에서 지워지겠죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Cue_0003_Text
msgctxt "b66b9278-0640-49d0-8c68-1d27c82ff551"
msgid ""
"\"I am honored to represent the interests of Kaleena Korvosh, the head of "
"the noble house of Hoarwood. My mistress courageously took the position left "
"to her after the deaths of her mother and sister. You supported her "
"Excellency in her hour of need, and now may enjoy a special honor.\""
msgstr ""
"\"호어우드의 고귀한 가문 가주인 칼리나 코르보시의 이익을 대변하게 되어 영광입니다. 저의 주인께서는 어머니와 자매의 사후에 용기를 내어 "
"그 자리를 차지하셨습니다. 당신은 가주께서 도움을 청할때 그녀를 도우셨으며, 지금은 그로 인한 특별한 명예를 누리실 때입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Cue_0004_Text_String
msgctxt "bb809134-f54e-49d2-89f7-c97ffb42ab32"
msgid ""
"{n}The ambassador retrieves a scroll from the folds of his luxurious attire, "
"opens it and clears his throat.{/n} \"As arranged, my mistress grants you a "
"trade contract, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. Very "
"well...\""
msgstr ""
"{n}대사는 호화로운 복장의 주머니에서 스크롤을 꺼냈고, 그것을 펼친 뒤 큰 소리로 읽습니다.{/n} \"예정된 대로, 저의 주인님께서 "
"무역 계약서를 하사하셨습니다. {mf|영주님|영주님|전하|전하}. 아주 좋습니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Cue_0009_Text
msgctxt "652db449-2da6-4ee4-b465-98cbe5b36500"
msgid ""
"{n}The ambassador's clear dark eyes go to you.{/n} \"I don't think you heard "
"me correctly, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. My "
"mistress grants you the honor of trading with her family, the noble house of "
"{g|Irrisen}Irrisen{/g}. This privilege is offered to very, very few. I "
"didn't come here to negotiate the terms. I'm merely informing you. If "
"they're not good enough for you, it is none of my concern.\""
msgstr ""
"{n}대사의 맑은 검은색 눈이 당신을 향합니다.{/n} \"제 말을 제대로 듣지 않으셨군요, {mf|영주님|영주님|전하|전하}. 제 "
"주인님께서 당신께 그녀의 가문이기도 한 {g|Irrisen}이리센{/g}의 고귀한 가문과 거래할 기회를 하사하셨습니다. 이러한 특권은 "
"매우, 매우 드문일이죠. 저는 조건 협상을 하러 찾아온 것이 아닙니다. 단지 당신에게 통지하기 위함일 뿐입니다. 이 제안에 당신께서 "
"만족하지 않는다 해도, 제가 상관할 일은 아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Cue_0012_Text
msgctxt "ca62dab7-69ed-4bfb-bdd3-822c6969f6b2"
msgid ""
"{n}The ambassador grins, rolls the scroll and makes a bow.{/n} \"As you "
"wish, {mf|Your Grace|Your Grace|Your Highness|Your Highness}. Your rejection "
"will hardly affect my mistress.\""
msgstr ""
"{n}대사는 낄낄대고는, 스크롤을 다시 말아올리고 경례합니다.{/n} \"당신의 뜻대로 하십시오, {mf|영주님|영주님|전하|전하}. "
"당신의 거절은 제 주인님께 어떤 영향도 없을것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Cue_0013_Text
msgctxt "5d22d679-aed7-4a69-bba8-07313fffca01"
msgid ""
"\"Where was I? Oh yes. Special privileges for the ambassadors of "
"{g|Irrisen}Irrisen{/g} in your lands...\""
msgstr ""
"\"제가 어디까지 말씀드렸습니까? 아, 맞습니다. 당신 영지의 {g|Irrisen}이리센{/g}의 대사를 위한 특별한 특권에 대해서 "
"얘기중이었지요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Cue_0015_Text
msgctxt "b7b48347-088d-44ef-8d18-7cae8247abe8"
msgid ""
"{n}The ambassador utters an angry shriek.{/n} \"You're going to be sorry! My "
"mistress will learn of this, I swear it!\""
msgstr ""
"{n}대사는 분노에 찬 비명을 지릅니다.{/n} \"당신은 후회하게 될 겁니다! 내 주인님께선 이 일을 기억할 겁니다, 반드시!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Cue_0016_Text_String
msgctxt "3af5d330-3d63-49ce-b339-82935799eaee"
msgid ""
"{n}He finishes reading the scroll, rolls it up and turns to you.{/n} \"Well, "
"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, do you agree to "
"commence commercial relations with the noble house of Her Excellency?\""
msgstr ""
"{n}그는 스크롤을 끝까지 읽고, 그것을 말아올린 뒤 당신을 봅니다.{/n} \"좋습니다. {mf|영주님|영주님|전하|전하}, 당신은 "
"각하의 고귀한 가문과 경제적인 관계를 맺는 것에 동의하십니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Cue_0020_Text
msgctxt "9957d820-b53a-47b8-acb7-62043cc5ad80"
msgid ""
"{n}The ambassador's chilly smile barely conceals his discontent with being "
"interrupted.{/n} \"Of course. My mistress remembers perfectly well about "
"your... merits, and your power to jeopardize her. Everything has been "
"arranged.\""
msgstr ""
"{n}대사는 감정없는 웃음으로 그가 방해받았다는데 대한 불만을 간신히 감춥니다.{/n} \"물론입니다. 저의 주인님께서는 당신이 "
"얻을... 이득과 당신이 그녀에게 얼마나 위협이 되는지 완벽히 기억하고 계십니다. 모든 사항은 적절히 조율되었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Cue_0026_Text
msgctxt "630bfced-71c9-4284-8178-f0218f438a34"
msgid ""
"\"Congratulations to you and to your {mf|barony|barony|kingdom|kingdom} on "
"your new trade ally. May the relationship between our lands be eternal.\" {n}"
"The ambassador bows deeply.{/n}"
msgstr ""
"\"당신과 당신의{mf|남작령|남작령|왕국|왕국}이 새로운 무역 동맹을 얻었다는 사실을 축하드립니다. 저희와의 관계가 영원히 이어지길 "
"바랍니다.\" {n}대사는 깊이 숙여 인사합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Cue_0027_Text
msgctxt "ff71cf30-e2de-41dd-b14a-1e258fdc1f0b"
msgid ""
"\"According to the terms, you shall deliver a monthly load of vegetables and "
"grain to {g|Irrisen}Irrisen{/g} in a timely fashion. Failing this, you will "
"be penalized. Your merchants shall pay all fees associated with Hoarwood "
"trading rights. Otherwise, a prison sentence is due. The cargo shall be paid "
"for within an eighteen-month timeframe...\""
msgstr ""
"\"제안서에 따르면, 당신은 한 달마다 일정량의 제철 채소 및 곡물들을 {g|Irrisen}이리센{/g}으로 보내셔야 합니다. 이를 어길 "
"경우 벌칙이 부과될 수 있습니다. 당신 왕국의 상인들은 호어우드의 거래권과 관련된 모든 수수료를 지불해야 합니다. 그렇지 않다면, 징역이 "
"선고될 겁니다. 화물의 값은 18개월 이내에 지불될 것이며...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NE_ColdDiplomacy/Ep3_KTC/Cue_0028_Text
msgctxt "f473a9c0-3e04-4f1a-b364-00fc985c45c1"
msgid ""
"\"The noble house offers you special terms of trade, including tax exemption "
"and assistance in delivery to the place of destination. According to the "
"agreement...\" {n}The ambassador dives into numerous clauses and items of "
"the trade agreement. He doesn't seem to care if you're listening or not.{/n}"
msgstr ""
"\"고귀한 가문은 당신에게 세금 면제와 화물을 목적지까지 운반해주는 등의 항목을 포함한 특별한 거래 조건을 제시합니다. 동의서에 "
"따르면...\"{n}대사는 무역 동의서에 기재된 수많은 조항과 거래 품목들로 넘어갑니다. 당신이 듣고 있는지 아닌지는 더 이상 신경쓰지 "
"않는 것 같습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0003_Text
msgctxt "c07b908c-003f-4ee6-9185-588f2db75827"
msgid "\"Who are you?\""
msgstr "\"너는 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0004_Text
msgctxt "015def25-71ef-4f8c-beb7-86f121122b45"
msgid ""
"\"Let me guess — you're the hero who's been knocking heads together in my "
"lands?\""
msgstr "\"내가 한 번 맞춰보지 — 당신이 내 땅에 머리를 맞댄 영웅인가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0007_AlignmentShift.Description
msgctxt "44bb262b-90b3-45ea-b268-23344b9b49cd"
msgid "Killed the masked hero."
msgstr "가면 쓴 영웅을 죽였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0007_Text
msgctxt "0cc69a62-da4e-41fb-a473-cd0ac032a603"
msgid "[Attack] \"First impressions can be deceiving.\""
msgstr "[공격] \"첫인상은 얼마든지 속일 수 있지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0009_Text
msgctxt "84e5e044-cecc-4b71-ace8-63a93a232f4c"
msgid "\"Why are you wearing this weird costume?\""
msgstr "\"어째서 그런 이상한 옷을 입고 다니는 거야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0010_Text
msgctxt "5e834a9c-f4c6-47cf-b915-b6cbf7411164"
msgid ""
"\"You're dressed in strange clothes, hunting bandits... an odd thing to do.\""
msgstr "\"당신은 괴상한 옷을 차려입고, 산적들을 사냥하고... 이상한 사람이군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0011_Text
msgctxt "f370aeff-cecd-470b-b385-de377edc1866"
msgid "\"Who attacked you?\""
msgstr "\"누구에게 공격당했지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0017_Text
msgctxt "c37be44a-0f98-47ff-90cc-f03d62509a0d"
msgid ""
"\"You must be one of the locals. Otherwise, why perform such feats in my "
"lands?\""
msgstr "\"당신은 지역 주민중 하나인가? 그렇지 않다면, 왜 나의 땅에서 그런 일을 하고 있는거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0019_AlignmentShift.Description
msgctxt "d6941474-3b10-43b5-a602-44c2672a021f"
msgid "Praised Osprey for his deeds."
msgstr "오스프리의 업적을 찬양했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0019_Text
msgctxt "1d60f2a6-a346-4da7-a3d6-322e5d7a3b9b"
msgid ""
"\"I like what you're doing. I hope the Stolen Lands will change for the "
"better thanks to you.\""
msgstr "\"당신이 한 일들이 마음에 든다. 당신 덕분에 도둑맞은 땅이 더 나은곳이 될 것 같군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0020_AlignmentShift.Description
msgctxt "e41cb6d4-ea9e-4691-bcd8-5c825485ba8b"
msgid "Neither supported Osprey nor turned him away."
msgstr "오스프리를 지지하지도, 무시하지도 않았습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0020_Text
msgctxt "8d61217f-8ab9-4020-852c-c0700b858bfb"
msgid ""
"\"I won't interfere, but don't expect any help either. I don't know your "
"motives, so I'm wary of you.\""
msgstr "\"방해하려는 건 아니지만, 그렇다고 도와줄 거라고 생각하지도 마. 당신의 동기가 무엇인지 모르니까 경계할 수밖에 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0021_AlignmentShift.Description
msgctxt "8bd5b935-305d-4fe6-a7cf-b771c49e6fa2"
msgid ""
"Kicked Osprey out of the {mf|barony|barony|kingdom|kingdom} for being too "
"uncontrollable."
msgstr "통제 불가능한 오스프리를 {mf|남작령|남작령|왕국|왕국}에서 쫓아냈습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0021_Text
msgctxt "cdc49572-dae6-4332-a9b6-9b0975f060e4"
msgid ""
"\"You make my guards and I look like helpless children. I don't need "
"amateurs working to preserve law and order.\""
msgstr "\"너는 우리 경비병과 나를 쓸모없는 애새끼로 보이게 만들었다. 법과 정의를 집행하는데 아마추어는 필요없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0022_AlignmentShift.Description
msgctxt "82f5ebeb-6670-4524-8551-6b1ba8fd7080"
msgid "Killed the masked hero."
msgstr "가면 쓴 영웅을 죽였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0022_Text
msgctxt "89fd61e4-6ee1-4730-aa72-4446f3ce4d7c"
msgid ""
"[Attack] \"It's time to put an end to the story of the little hero bird.\""
msgstr "[공격한다] \"작은 새 영웅의 이야기를 끝낼 시간이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Answer_0026_Text
msgctxt "dd79073b-eae2-4206-a8df-47ada0352b47"
msgid "\"I can't help asking... 'Osprey'? Why?\""
msgstr "\"안 물어볼 수가 없군... '물수리'? 왜 하필?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Barks/Bandit_01_String
msgctxt "f48440f8-794a-4a25-92be-eb7dc58e9560"
msgid "\"Get him! Get him before he flees!\""
msgstr "\"잡아! 도망치기 전에 체포해!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Barks/Bandit_02_String
msgctxt "babf5e8d-b2e5-4598-8728-3e2a0301553d"
msgid "\"End of the road, Osprey! You've really done it now!\""
msgstr "\"막다른 길이다, 오스프리! 이젠 정말로 끝이야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Barks/Osprey_afterAttack_String
msgctxt "4a70ef92-c6e3-4ea8-9b26-fbc88500547f"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, thank you! My luck "
"nearly ran out today!\""
msgstr "\"{mf|영주님|영주님|전하|전하}, 감사합니다! 오늘 제 운이 다한 줄 알았어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Cue_0001_Text
msgctxt "64144eb1-1e56-4159-ab3f-f91a19342ac9"
msgid ""
"{n}The tall man bows to you politely, face hidden behind an iron helmet.{/n} "
"\"The rumors are true, {mf|Your Grace|Your Grace|Your Highness|Your Highness}"
". You're as noble as they say!\""
msgstr ""
"{n}강철 투구로 얼굴을 가린 키 큰 남자가 예의 바르게 경례합니다.{/n} \"소문이 사실이었군요, {mf|영주님|영주님|전하|전하}. "
"당신은 그들의 말처럼 고귀하십니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Cue_0005_Text
msgctxt "59729ac6-9faa-49fa-bfaa-5d89e745e59e"
msgid "\"You may call me Osprey, {mf|Baron|Baroness|King|Queen} {name}.\""
msgstr "\"오스프리라고 부르시면 됩니다, {mf|남작|여남작|왕|여왕} {name}님.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Cue_0006_Text
msgctxt "dcfee714-4862-4f6d-bbd1-0ce0261044f8"
msgid ""
"{n}The man laughs out loud.{/n} \"You could say that! Although I hope my "
"efforts resulted in more than just a few headaches.\""
msgstr ""
"{n}남자는 크게 웃습니다.{/n}\"그리 말씀하실 줄 알았습니다! 제 모든 노력들이 몇 가지 작은 골칫덩이가 되지 않길 바랐는데 말이죠."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Cue_0012_Text
msgctxt "fc727a23-9ee4-4aa4-80e3-c361be2160fe"
msgid ""
"{n}Osprey looks at his attire and shrugs helplessly.{/n} \"Believe it or "
"not, I'm not the last remaining member of high society. I could hardly do "
"what I do without changing my appearance.\""
msgstr ""
"{n}오스프리가 자신의 옷을 보며 어깨를 으쓱거립니다.{/n} \"믿거나 말거나지만, 저는 상류 사회의 마지막 구성원 같은 게 아닙니다. "
"제 외모를 바꾸지 않고는 할 수 있는 일들이 거의 없었을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Cue_0013_Text
msgctxt "064ff6e6-dd66-4bd1-bd5e-2691168c0ac3"
msgid ""
"{n}Osprey grins.{/n} \"Not the first time I've heard those words! I might "
"look odd to a stranger. Or even crazy. But still...\""
msgstr ""
"{n}오스프리가 낄낄댑니다.{/n} \"그런 얘기를 처음 듣는 게 아닙니다! 외지인들에겐 특이한 사람으로 보이겠죠. 아니면 그냥 "
"미친놈이라던가. 하지만 여전히...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Cue_0014_Text
msgctxt "689b9b8d-d4d6-451d-91eb-a3c1d66d037a"
msgid ""
"\"Common cutthroats sell their conscience for a handful of coins. I'm sure "
"the local merchants hate that the common folk have their own man who can't "
"be bribed.\""
msgstr ""
"\"평범한 살인자들은 그들의 양심을 한 줌의 금화에 팔아치우죠. 민간인들의 편에 매수되지 않는 힘이 있다는 사실 때문에 지역 상인들이 절 "
"싫어하는것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Cue_0015_Text
msgctxt "2bfe9a96-9d35-44ca-b0dd-ffc0c77193e2"
msgid ""
"\"{g|Golarion}Golarion{/g} is full of injustice. There are those who take "
"advantage of oppression. There are those who overlook evil right in front of "
"them. And then there are those who commit their time and effort to making "
"this world a better place. I think I'm the latter, regardless if I'm "
"considered weird or mad.\""
msgstr ""
"\"{g|Golarion}골라리온{/g}에는 불공정이 만연합니다. 타인을 억압함으로써 이익을 챙기는 자들도 존재하고, 눈앞에서 벌어지는 "
"불의를 못본체하는 자들도 있습니다. 그리고 그곳엔 세상을 더 나은 곳으로 만들기 위해 시간과 노력을 쏟아붓는 사람도 있죠. 누군가 저를 "
"기인, 혹은 광인이라 취급한다해도, 저 스스로는 제가 가장 마지막 범주에 속한다고 생각합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Cue_0016_Text
msgctxt "f5823089-befa-4a58-9a5b-6dd6376e14a8"
msgid ""
"\"Besides, as you can see, my profession can be dangerous.\" {n}Osprey "
"points at the robbers' bodies.{/n} \"I don't want my most active enemies "
"paying a visit to my friends or family. Let them hunt me instead, if they so "
"desire.\""
msgstr ""
"\"게다가, 보시는대로, 저의 직업은 위험할 수 있어요.\"{n}오스프리는 도둑의 시체를 가리킵니다.{/n} \"저는 가장 활동적인 저의 "
"적들이 제 친구나 가족들에게 들이닥치는 꼴을 보고 싶지 않습니다. 대신 저를 공격하도록 만들어야죠, 그들이 원하는대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Cue_0018_Text
msgctxt "004940b5-9dd3-40de-8b43-674d622dfdea"
msgid ""
"\"Let's put it this way: you rule these lands better than dozens of other "
"{mf|kings|queens} could. But like any other mortal, you're not almighty. And "
"you're not alone. Osprey circles high in the sky, deadly and invisible. I "
"can see in the distance what you don't. I'm the hand of your people, ready "
"to help our just ruler.\""
msgstr ""
"\"이야기를 옮겨보죠: 당신은 이 영토를 수많은 다른 {mf|왕|여왕}들이 하는 것보다 훨씬 잘 통치하고 계십니다. 하지만 다른 "
"필멸자들과 마찬가지로, 당신은 전능하지 않죠. 또한 당신은 혼자도 아닙니다. 물수리는 높은 하늘에서 원을 그리며 비행합니다. 보이지도 "
"않고, 치명적이죠. 저는 당신께서 볼 수 없는 먼 거리에 있는 것도 볼 수 있습니다. 저는 당신 시민들의 일꾼이며, 우리의 정당한 "
"지도자를 도울 준비가 되었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Cue_0023_Text
msgctxt "c8f4924c-c6ea-436d-a35d-b975c6ef710d"
msgid ""
"{n}Osprey looks you up and down.{/n} \"Ambition and power corrupt even the "
"purest souls. I'll take my leave, but don't expect me to stop helping and "
"protecting those in need. Farewell.\""
msgstr ""
"{n}오스프리가 당신을 위아래로 훑어봅니다.{/n} \"권력과 야망은 가장 굳건한 영혼조차도 타락시키지요. 저는 이곳을 떠나겠지만,필요한 "
"사람들을 돕고 보호하는 일을 멈출 거라고 생각하지는 마십시오. 그럼 이만.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Cue_0024_Text
msgctxt "5ab6699d-3011-4651-9eaa-95d831449319"
msgid ""
"{n}The man nods.{/n} \"I understand. It isn't easy to trust someone who "
"won't reveal their face, is it? I do, however, hope my deeds speak louder "
"than my words. Farewell.\""
msgstr ""
"{n}남자는 고개를 끄덕였다.{/n} \"이해합니다. 자기 얼굴을 드러내지 않는 사람을 믿는게 쉬운 일은 아니니까요, 그렇죠? 하지만, "
"저는 말보다는 제 행동으로 보여주는 사람이 되고 싶습니다. 그럼 이만.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Cue_0025_Text
msgctxt "030315cc-ae8d-4329-a8ce-d84599ff7cde"
msgid ""
"{n}Osprey bows, this time sincerely.{/n} \"{mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}, if it is so, it will be thanks to our combined "
"deeds. You set a fine example and give hope that the whole "
"{mf|barony|barony|kingdom|kingdom} can live guided by conscience rather than "
"heartless legislation. It was a pleasure meeting you, {name}. And now... I "
"must go.\""
msgstr ""
"{n}이번에는 오스프리가 진심을 담아 인사합니다.{/n} \"{mf|영주님|영주님|전하|전하}, 그렇다면, 저희가 같이 해낸 일들에 대해 "
"감사드립니다. 당신은 솔선수범하셨으며, 또한 {mf|남작령|남작령|왕국|왕국}의 모든 시민들에게 가차없는 법치보다 양심이 이끄는대로 "
"살아갈 수 있다는 희망을 보여주셨습니다. 만나뵙게 되어 행복합니다, {name}님. 그리고 이제... 갈 시간이로군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep2_Encounter/Cue_0027_Text
msgctxt "f29b2678-691e-49ac-9e31-383046de255d"
msgid ""
"{n}You hear a muffled chuckle from behind the visor.{/n} \"A good bird. "
"Sharp-eyed. Swift. Proud. Can't stand bad people.\""
msgstr ""
"{n}당신은 가면의 뒤에서 나는 소리죽인 웃음소리를 듣습니다.{/n} \"훌륭한 새입니다. 날카로운 눈에. 재빠르고. 긍지있으며. 악인의 "
"편에 서지 않죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Answer_0004_Text
msgctxt "f50deda6-8e54-4acb-9c25-2f17fc963c1c"
msgid "\"I'd like to know more.\""
msgstr "\"너에 대해서 더 알고 싶다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Answer_0005_Text
msgctxt "09c594e6-b2ac-45ee-a0f5-103dc93fb51d"
msgid "\"Tell me about Andoran.\""
msgstr "\"안도란에 대해 이야기해봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Answer_0007_Text
msgctxt "23a85a31-9f16-4e45-8ac2-0fad3233b14b"
msgid "\"Why my {mf|barony|barony|kingdom|kingdom}?\""
msgstr "\"왜 나의 {mf|남작령|남작령|왕국|왕국}이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Answer_0008_Text
msgctxt "97154a2a-a08c-45c7-9de2-f42f58dc6ce8"
msgid "\"What profit do I get from your bank?\""
msgstr "\"네 은행에서 어떤 이익을 얻을 수 있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Answer_0009_Text
msgctxt "eeaab8cd-def5-43ae-95f6-8ceca6663c35"
msgid "\"A family bank, you say?\""
msgstr "\"네 말은, 가족 은행 말인가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Answer_0010_Text
msgctxt "e0ba98c1-e84b-4ad7-8e30-a739ae5986b9"
msgid "\"That's all that I need to know.\""
msgstr "\"필요한 정보는 모두 얻었다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Answer_0017_Text
msgctxt "16d6ba03-29e1-408b-b534-c7567864e7d5"
msgid "\"I agree to open a bank in the capital.\""
msgstr "\"나는 수도에 은행을 건설하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Answer_0020_Text
msgctxt "5b7cf576-51d4-4754-9d00-4faea4f9aa68"
msgid "\"If I remember correctly, Andoran was once a colony of Cheliax.\""
msgstr "\"내가 제대로 기억하고 있다면, 안도란은 한 때 첼리악스의 식민지였던 곳 같은데.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Answer_0022_Text
msgctxt "63a94c60-6336-4f4b-abc8-be6c417d919c"
msgid "\"Tell me about these opportunities you mentioned.\""
msgstr "\"네가 언급한 기회에 대해 자세히 말해보라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Answer_0023_Text
msgctxt "2ae34029-7b96-426a-8ce8-8daa8affc9a2"
msgid ""
"\"I don't like you or your Andoran propaganda. Take yourself from my lands.\""
msgstr "\"너나 네 안도란 프로파간다나 마음에 들지 않는군. 내 땅에서 떠나라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Answer_0024_Text
msgctxt "a933de05-2e0f-45aa-86d1-495c1f03098e"
msgid "\"What is this lifestyle?\""
msgstr "\"이 생활 방식이란 뭐지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Answer_0027_Text
msgctxt "11131042-224b-4435-9ef0-dee8657afa2b"
msgid "\"This is very interesting, but I'd like to go over other issues.\""
msgstr "\"매우 흥미롭긴 하다만, 먼저 처리해야 할 다른 문제들이 더 많군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Answer_0032_Text
msgctxt "45ba6baa-2b8f-4090-b7a0-9bfea927f20c"
msgid "\"I need time. I can't say yes right now.\""
msgstr "\"시간이 필요하다. 당장 결정하기는 어렵겠군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0001_Text
msgctxt "65fd7c7e-2bfd-46e4-9e2e-6c18174ba98c"
msgid ""
"{n}An exquisitely dressed man flips the pinned cape off his shoulder and "
"bows deeply.{/n} \"Greetings, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}! My name is Alex Covenorb. I traveled a difficult road from "
"{g|Andoran}Andoran{/g} just to meet you in person.\""
msgstr ""
"{n}정교하게 차려입은 남자가 그의 어깨에 핀으로 걸어둔 케이프를 벗은 뒤 길게 인사합니다.{/n} \"안녕하십니까, "
"{mf|영주님|영주님|전하|전하}! 제 이름은 알렉스 코버노브입니다. 당신을 뵙기 위해 {g|Andoran}안도란{/g}으로부터 위험한 "
"길을 여행했죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0002_Text
msgctxt "e65cfa90-c497-434e-ac88-0e84ee7411b4"
msgid ""
"{n}Alex shows you a heavy folder full of papers.{/n} \"I am the official "
"representative of the family bank called 'Heritage and Honor'. It is based "
"in Augustana, but we do business well beyond the borders of "
"{g|Andoran}Andoran{/g}. I'd like to open an office of our bank in your "
"capital.\""
msgstr ""
"{n}알렉스는 당신에게 서류로 가득찬 무거운 서류철을 보여줍니다.{/n} \"저는 '유산과 명예'라는 가족은행의 공식 대변인입니다. "
"본점은 어거스타나에 있지만, {g|Andoran}안도란{/g}의 국경 너머에서도 사업을 하고 있죠. 저희는 당신의 수도에 은행을 건설하려 "
"합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0006_Text
msgctxt "6e67502c-f2dd-4364-a102-b7c27c0c8da0"
msgid ""
"\"Absolutely! However...\" {n}Alex weighs his folder thoughtfully.{/n} \"I "
"don't wish to bother you with boring figures and terminology. I'd rather "
"hand the papers to your Treasurer, who can confirm everything I say. Please, "
"ask about any concerns you may have!\""
msgstr ""
"\"물론입니다! 하지만...\" {n}알렉스는 생각에 잠겨 그의 서류 무게를 확인합니다.{/n} \"저는 수치나 용어들 따위로 당신이 "
"짜증내게 하고 싶진 않습니다. 대신 제가 언급한 모든 것을 확인시켜드릴 수 있는 당신의 재무관에게 이 서류를 넘기겠습니다. 걱정스러운 "
"부분이 있다면 뭐든지 말씀해주십시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0011_Text
msgctxt "fb3d4171-3251-423f-b70d-e06315418ffa"
msgid ""
"{n}Alex eyes you for a few seconds before answering.{/n} \"If you think I've "
"made a random choice, perhaps you should think again. I've put much effort "
"into making sure you're following my people's principles.\""
msgstr ""
"{n}대답하기 전에 알렉스는 몇 초간 당신을 응시합니다.{/n} \"제가 주사위 놀이나 하는 거라고 생각하셨다면, 아마 다시 한 번 "
"생각해보셔야 할겁니다. 저는 당신께서 저희들의 법칙에 동의하실 수 있도록 심혈을 기울여왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0012_Text
msgctxt "817de430-54ec-40f3-8aed-97cb4905f90f"
msgid ""
"\"We don't just store your money, but put it into use to make more money! We "
"make it work for you. We make it bring profit. Such promises might at first "
"sound like sweet lies to the locals, but I'm prepared to wait patiently "
"while people change their attitudes.\""
msgstr ""
"\"단지 당신의 돈을 저장하는 것만이 아닙니다. 오히려 예금해두면 돈이 점점 불어나죠! 우리는 당신을 위해 이 체계를 만들었습니다. "
"우리는 이익을 가져오기 위해 이 체계를 만들었습니다. 이런 약속들을 처음 듣는 사람들은 달콤한 거짓말로 치부하겠지만, 저는 사람들이 "
"태도를 완전히 바꿀 때까지 기다릴 준비도 되어있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0013_Text
msgctxt "8c9e0aac-966c-4074-a07f-0cf87ac243da"
msgid ""
"\"The bank was founded by my father, a respected man, a wise accountant and "
"a perspicacious businessman. Father let me take over the business, now that "
"he's resting on his laurels. He didn't merely raise my sisters and me – he "
"passed on his spirit of enterprise, a gift I will never be able to repay.\""
msgstr ""
"\"은행은 제 아버지께서 설립하셨습니다. 존경받는 사람이었고, 현명한 회계사이자 통찰력있는 사업가셨죠. 아버지께서 이 사업을 저에게 "
"물려주셨고, 지금은 성공한 사람으로서 은퇴하셨습니다. 저와 제 자매를 거의 돌보지 못하셨습니다만 – 그래도 무엇과도 바꿀 수 없는 선물인 "
"당신의 경영 철학을 물려주셨습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0014_Text
msgctxt "e0d4afc3-ff8a-4a50-92cc-c016bf2068eb"
msgid ""
"\"I hope you've liked what you heard. Well, {mf|Your Grace|Your Grace|Your "
"Highness|Your Highness}, are you ready to sign our contract?\""
msgstr ""
"\"당신이 이 이야기들을 좋아하셨으면 좋겠습니다. {mf|영주님|영주님|전하|전하}, 이제 우리 계약서에 서명할 준비가 되셨습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0016_Text
msgctxt "7462a44b-ab30-4354-a617-5ff6d8c01038"
msgid ""
"\"I don't mean doctrine or legislation. I mean human values, which my "
"country got through our revolution, and which we strive to preserve, "
"whatever it takes. Honor. Nobility. Equality. All these notions fit with "
"your {mf|barony|barony|kingdom|kingdom} very well.\""
msgstr ""
"\"저는 교리나 입법 절차를 의미한 게 아닙니다. 제가 말한 것은 사람의 가치입니다. 제 나라가 혁명을 거치는 동안 배운 것이며, 우리가 "
"어떤 대가를 치르더라도 지키기 위해 노력하는 것이죠. 명예, 고결함. 평등. 이 모든 개념들은 당신의 {mf|남작령|남작령|왕국|왕국}"
"에도 잘 맞을겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0018_Text
msgctxt "dfeb8c94-b22b-41b2-9323-7fcac0de8bba"
msgid ""
"{n}The banker rubs his chin.{/n} \"In a nutshell, {mf|Your Grace|Your Grace|"
"Your Highness|Your Highness}, it's my motherland. It's where I grew up and "
"learned the principles that I live up to even today. It's a beautiful "
"country, always happy to welcome good travelers. It offers many "
"opportunities for a hard-working person.\""
msgstr ""
"{n}은행원은 그의 턱를 문지릅니다.{/n} \"짧게 말씀드리겠습니다, {mf|영주님|영주님|전하|전하}. 그곳은 제 고향입니다. 제가 "
"자란 곳이며 제가 오늘날까지 간직해온 법칙들을 배운 곳이죠. 선량한 여행자들을 언제나 반기는 아름다운 나라이기도 하고, 또한 열심히 "
"일하는 사람에게 많은 기회를 주는 곳이기도 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0021_Text
msgctxt "07915c80-7533-49a6-a4fc-4a979fc098e8"
msgid ""
"\"It was a part of {g|Taldor}Taldor{/g} before. Yes, {g|Andoran}Andoran{/g} "
"kept changing rulers over the centuries. Luckily, the people managed to "
"break the cycle and opted for independence. Revolution brought us new "
"problems, but at the same time, a unique social order.\""
msgstr ""
"\"이전에는 {g|Taldor}탈도르{/g}의 영토였죠. 맞습니다, {g|Andoran}안도란{/g}은 수세기동안 지배자가 "
"변화해왔습니다. 운좋게도, 사람들은 그 굴레를 부수는데 성공했고 독립을 선택했습니다. 혁명은 저희에게 새로운 문제를 안겨주었지만, 동시에 "
"독특한 사회 질서도 얻을 수 있었죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0025_Text
msgctxt "839b1a62-0b4a-4196-98fa-4b225ae761cb"
msgid ""
"\"With all due respect, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}, the very essence of the modern governance in "
"{g|Avistan}Avistan{/g} is wrong. It allows some to rise above the others, to "
"force their will upon them, to determine their fate. {g|Andoran}Andoran{/g} "
"is free from such tyranny. It's not the king or the emperor who rules the "
"country, it's the people!\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 외람된 말씀입니다만, 현대 {g|Avistan}아비스탄{/g}의 정부 체계는 근본부터 틀렸습니다. "
"일부 사람들에게 다른 사람 보다 우월한 위상을 부여하고, 그들의 사상을 민중들에게 강요하고, 그들의 운명을 결정하는 행위 모두를 "
"허락하죠. {g|Andoran}안도란{/g}은 그런 폭군에게서 자유롭습니다. 국가의 통치자는 왕이나 황제가 아닙니다, 바로 민중들이죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0026_Text
msgctxt "b8c0e208-e9d2-45fe-ae99-5b98a40420fa"
msgid ""
"\"The People's Council runs the country. It consists of three hundred and "
"fifty advisors elected by the citizens. Among them are former aristocrats "
"and regular craftsmen, wealthy merchants and respected mayors. The People's "
"Council appoints the Supreme Elect, the official head of state, along with "
"ministers, governors and advisors. There are no privileges or patronage. "
"Everyone gets what they deserve.\""
msgstr ""
"\"민중의 의회가 국가를 다스립니다. 항상 시민들 중에서 선출된 350명의 조언자들을 구성하죠. 그들 중에는 과거 귀족이던 사람들도 "
"있고, 평범한 장인과 부유한 상인, 그리고 존경받는 시장도 있습니다. 민중의 의회는 장관들, 주지사들, 의회원들과 함께 최고 통수권자인 "
"최고 의장을 임명합니다. 특권 계층도 후원자도 없습니다. 모든 사람들이 그들이 받아 마땅한 대우를 받습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0028_Text
msgctxt "44b84ebf-c823-4334-998d-bf39e2007501"
msgid ""
"\"Do you know how our family became bankers and took our place in society? "
"We didn't possess titles or family heirlooms. My grandfather worked as an "
"ordinary falconer for the rich aristocracy. But we had fire running through "
"our veins! We decided to take a crazy risk and invested in our own business. "
"As you can see, it paid off.\""
msgstr ""
"\"저희 가족이 어떻게 은행원이 되었고 사회에서 중요한 위치로 올라섰는지 궁금하십니까? 저희는 자랑할 만한 가문도 가보도 없었습니다. 제 "
"할아버지는 한 부유한 귀족 밑에서 일하던 매 사냥꾼이셨고요. 하지만 우리 혈관에는 불꽃이 흐르고 있었죠! 우리는 말도 안되는 위험을 "
"무릅쓰기로 결정했고 저희 사업에 투자했습니다. 지금 보시는 대로, 그 보답을 받았습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0029_Text
msgctxt "5f8a8bef-10e9-4774-a245-163fabb84178"
msgid ""
"\"If you roll up your sleeves and get to work, and earn a good reputation, "
"you can do anything. {g|Andoran}Andoran{/g} appreciates the noble and bold "
"of spirit.\""
msgstr ""
"\"소매를 걷어붙이고 일을 해서, 그걸로 좋은 명성을 얻을 수만 있다면, 그를 통해 뭐든지 할 수 있습니다. "
"{g|Andoran}안도란{/g}은 고귀하고 용감한 사람들을 환영합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0030_Text
msgctxt "1829712e-6933-4f70-957d-164bc9027fa0"
msgid ""
"{n}Alex turns pale.{/n} \"I'm afraid you misunderstood my words, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}. I may sing the praises of my "
"motherland, but {g|Abadar}Abadar{/g} forbid if I ever engage in cheap "
"propaganda! I will not trouble you with my presence any further, but please "
"allow me to leave these papers with one of your advisors! I hope you will "
"consider all the benefits after your temper settles.\" {n}The man bows "
"politely.{/n}"
msgstr ""
"{n}알렉스의 얼굴이 창백해집니다.{/n} \"{mf|영주님|영주님|전하|전하}, 제 말을 오해하신 것 같아 두렵군요. 저는 제 고향에 "
"대해 미사여구를 노래할 수는 있습니다만, 제가 허접한 프로파간다나 지껄이고 다닌다면 {g|Abadar}아바다르{/g}께서 금하실겁니다! "
"더이상 제 존재로 인해 문제가 생기지 않도록 하겠습니다. 하지만 모든 서류를 당신의 보좌관에게 전달하는 것을 허락해주십시오! 당신의 화가 "
"가라앉고 나서, 이 사업이 가져다줄 모든 이익에 대해 깊이 고민해주셨으면 좋겠습니다.\"{n}남자는 예의있게 인사합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0031_Text
msgctxt "08278085-25f3-4404-938c-3d5701e491b2"
msgid "{n}Alex nods.{/n}"
msgstr "{n}알렉스가 고개를 끄덕였입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0033_Text
msgctxt "81406380-7e81-4ba7-bbe6-c965f27c13f6"
msgid ""
"\"Reasonable care never hurt anyone. I'll pass the papers to one of your "
"advisors. If you decide to accept this offer from the 'Heritage and Honor' "
"bank, we'll return to this issue.\" {n}Alex bows politely.{/n}"
msgstr ""
"\"합리적인 도움은 아무도 해치지 않습니다. 이 서류들을 보좌관 중 한 명에게 전달하겠습니다. 당신이 '유산과 명예' 은행의 제안에 "
"동의하기로 결정하신다면, 저희가 다시 찾아뵙도록 하겠습니다.\" {n}알렉스는 예의있게 인사합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/NG_TalonsOfOsprey/Ep3_KTC/Cue_0034_Text
msgctxt "0a0044c3-0cfb-43d0-a832-0aba32d3212d"
msgid ""
"\"Thank you for your trust, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. Rest assured, your subjects will appreciate the opportunities our "
"bank has to offer! I won't waste any more of your time. The final details "
"can be discussed with your advisors.\" {n}Alex bows politely.{/n}"
msgstr ""
"\"{mf|영주님|영주님|전하|전하}께서 믿어주셔서 감사합니다. 단언하건데, 저희 은행이 제안하는 기회를 주민들 모두 환영할겁니다! "
"더이상 당신의 시간을 낭비시키지 않겠습니다. 최종 사항은 당신의 보좌관과도 토론할 수 있으니까요.\" {n}알렉스는 예의있게 "
"인사합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0003_Text
msgctxt "50d0a013-772a-48a1-a2e7-48d7b61bd9eb"
msgid "\"Where did such a monster come from?\""
msgstr "\"이 괴물들은 전부 어디서 몰려오는거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0004_Text
msgctxt "512e181c-3c78-4367-9157-31fd4c10224a"
msgid "\"And who are you?\""
msgstr "\"그래서 당신은 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0005_AlignmentShift.Description
msgctxt "acb72bf5-e354-407f-ad12-e465c6127307"
msgid "Killed a group of travelers."
msgstr "여행자들을 죽였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0005_Text
msgctxt "99011b1e-7d69-40d0-be76-9c93b9cf44dd"
msgid "[Attack] \"I was only getting warmed up!\""
msgstr "[공격한다] \"이제야 몸을 좀 덥힐 수 있겠군!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0008_Text
msgctxt "97e1c350-a47c-4861-8949-293523732d5a"
msgid "\"I have to go.\""
msgstr "\"가봐야겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0011_Text
msgctxt "fac65258-d5ba-499c-ba69-795128a865c9"
msgid "\"I am {mf|Baron|Baroness|King|Queen} {name}, ruler of this land!\""
msgstr "\"나는 이 땅의 {mf|남작|여남작|왕|여왕}인 {name}이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0012_Text
msgctxt "0c0e8bc3-8b33-4fd4-9d0c-a2550a523a67"
msgid "\"What exactly are you doing here?\""
msgstr "\"여기서 정확히 뭘 하고 있는거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0013_Text
msgctxt "d398fd87-1cc6-475f-95ae-97827de66b2c"
msgid "\"What society are you talking about?\""
msgstr "\"네가 말하는 협회란 어떤 것이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0016_Text
msgctxt "a9920302-70e8-4afc-aa34-ba09fdaa9151"
msgid "\"Well, it was nice to chat, but I have to go.\""
msgstr "\"그래, 대화하게되어 즐거웠다. 하지만 나는 떠나야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0017_Text
msgctxt "ab62ee00-abbf-4c11-9288-cdaf06388666"
msgid "\"Could you use any assistance?\""
msgstr "\"도움이 필요한가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0018_AlignmentShift.Description
msgctxt "dc3338a3-fa0f-4c34-922d-9361d92eda47"
msgid "Expelled the Pathfinders from the Stolen Lands on suspicion of spying."
msgstr "간첩 혐의가 있는 패스파인더들을 도둑맞은 땅에서 쫓아냈습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0018_Text
msgctxt "f6efc3ec-d462-454d-a802-dc78c31fb481"
msgid ""
"\"I don't need spies from some society sneaking around here. Get out of my "
"lands immediately!\""
msgstr "\"내게 이곳저곳 숨어다니는 단체의 첩자는 필요없다. 당장 내 땅에서 사라져라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0019_AlignmentShift.Description
msgctxt "146c386a-844e-4fcc-9982-b4ec251b850d"
msgid "Killed a group of Pathfinders."
msgstr "패스파인더 무리를 죽였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0019_Text
msgctxt "d574a9f5-fe06-4db8-97cd-c57a140fd14e"
msgid "[Attack] \"I'm tired of you!\""
msgstr "[공격한다] \"이제 질렸다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Answer_0028_Text
msgctxt "a20c619a-81c8-4fb0-9a1f-d06b1af58c66"
msgid "\"The tomb?\""
msgstr "\"무덤?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Barks/Pathfinder_1_String
msgctxt "04233a94-cd8f-46da-a15c-fe4d1e85abad"
msgid "\"Hit him!\""
msgstr "\"공격해!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Barks/Pathfinder_2_String
msgctxt "25809894-d655-4748-a52e-0b5b191f0381"
msgid "\"Go for it!\""
msgstr "\"어서 가!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Barks/Pathfinder_3_String
msgctxt "1082e85d-8133-47c5-bfc6-ee9e95a1741d"
msgid "\"Careful!\""
msgstr "\"조심해!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Barks/Pathfinder_After_1_String
msgctxt "c26b8e20-07e5-4a2c-8d46-84f872c81887"
msgid "\"Thank you so much, traveler!\""
msgstr "\"고마워, 여행자님!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Barks/Pathfinder_After_2_String
msgctxt "6c8847ca-9c2a-473c-b44d-a04da4dc1b1a"
msgid "\"Ugh... a good fight!\""
msgstr "\"윽... 좋은 싸움이었다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0001_Text
#. Speaker : Pathfinder_Bard
msgctxt "e6998341-c6e3-4c9a-abe5-7970c1ac9036"
msgid ""
"{n}A half-orc is wiping the sweat from her brow with a bright jacket "
"decorated with many badges and patches.{/n} \"U-u-ugh, that handsome lad "
"gave it to us good! Almost slaughtered us all! Good thing you came by!\""
msgstr ""
"{n}수많은 배지와 누비 조각으로 장식된 밝은색 재킷을 입은 하프오크가 이마에 흐르는 땀을 닦습니다.{/n} \"허-허-헉, 잘생긴 "
"청년이 우리에게 선행을 베풀어줬군! 거의 몰살당할 위기였는데, 마침 잘 오셨습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0006_Text
#. Speaker : Pathfinder_Bard
msgctxt "4ae4778e-2abd-41b6-adc2-17a0b91c69dd"
msgid ""
"\"Us? We're a group of Pathfinders from the {g|Pathfinder Society}Society{/g}"
". We're here on special orders from the Grand Lodge to explore this "
"godforsaken land!\""
msgstr ""
"\"저희요? {g|Pathfinder Society}협회{/g}에서 파견된 패스파인더들입니다. 총괄 본부로부터 신들조차 버리신 이 땅을 "
"탐사하라는 특별한 명령을 받고 왔지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0007_Text
#. Speaker : Pathfinder_Bard
msgctxt "d9040152-b030-40e3-8d28-d98b040e07f9"
msgid "\"Yeah... I guess it followed us... walked with us from the tomb!\""
msgstr "\"음... 제 추측으로는 이것들이... 무덤에서부터 따라온 것 같습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0009_Text
#. Speaker : Pathfinder_Bard
msgctxt "6bc51df8-35c5-477d-9fc4-1955cd3cbaf9"
msgid ""
"{n}The half-orc stretches out her hand.{/n} \"Wait! I didn't even thank you! "
"I don't know who you are, but thank you for your help. I've never met "
"monsters like this one before, though it's not my first year in the {g|"
"Pathfinder Society}Society{/g}!\""
msgstr ""
"{n}하프오크는 그녀의 손을 풉니다.{/n} \"잠깐! 감사 인사도 안했잖아! 당신이 누구인지는 모르겠지만, 우릴 도와줘서 정말 "
"고마워요. {g|Pathfinder Society}협회{/g}에 몸담은지 수 년이 지났는데도, 이런 괴물들은 처음 봤어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0014_Text
#. Speaker : Pathfinder_Bard
msgctxt "299c2b5c-51fd-40ad-9c48-dbfc9ff11d6e"
msgid ""
"{n}The half-orc freezes for a moment, and then begins to speak again, "
"choosing her words more carefully.{/n} \"I didn't mean to offend you, "
"Your... {mf|Your Grace|Your Grace|Your Highness|Your Highness}? I've been to "
"many countries, and they address rulers differently everywhere — forgive me "
"if I've made a mistake!\""
msgstr ""
"{n}하프오크는 순간 얼어붙었습니다. 잠시 뒤, 단어 하나하나를 신중히 고르며 다시 말하기 시작합니다.{/n} \"당신께 뭘 어떻게 "
"하려는게 아니었습니다, 음... {mf|영주님|영주님|전하|전하}? 저는 많은 나라들을 돌아다녔었고, 그들 모두가 지배자를 다른 방식으로 "
"불렀으니까요 — 제가 실수를 했다면 용서해 주십시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0015_Text
#. Speaker : Pathfinder_Bard
msgctxt "8b127f51-5b64-4e84-a7f8-658cc30a8967"
msgid ""
"\"We've come from afar — from {g|Absalom}Absalom{/g}, to be specific. We've "
"heard many interesting tales about the {g|Stolen Lands}Stolen Lands{/g}... "
"so the {g|Pathfinder Society}Society{/g} decided we should update our maps "
"and surveys! We've no wish to harm or indeed, to bother anyone. We thought "
"it might be easiest if we just came here and performed our duties without "
"getting into all the fuss of an official visit!\""
msgstr ""
"\"저희는 머나먼 곳에서 왔습니다 — 바로 {g|Absalom}압살롬{/g}이죠. 저희들도 {g|Stolen Lands}도둑맞은 땅{/g}"
"에 대한 흥미로운 이야기들을 많이 들었습니다... 그렇기 때문에 {g|Pathfinder Society}협회{/g}에서는 이 지역의 "
"지도를 수정하고 추가 조사를 진행하기로 결정한 것입니다! 저희는 어떤 위해도 가할 생각이 없습니다. 사실, 어느 누구도 짜증나게 만들고 "
"싶은 것 또한 아니죠. 저희는 공식 방문같은 호들갑을 떨지 않고, 조용하게 임무를 수행하는 것이 가장 쉬울 거라고 생각했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0020_Text
#. Speaker : Pathfinder_Bard
msgctxt "406cbd81-cddf-4911-9c4c-7ff6584d3bb1"
msgid ""
"{n}The half-orc waves her hand vaguely.{/n} \"There's this one place, not "
"far from here. It's labeled with a question mark on all our old maps. So we "
"decided to see what's there.\""
msgstr ""
"{n}하프오크는 그녀의 손을 모호하게 흔듭니다.{/n} \"여기서 멀지 않은곳에 한 군데 있습니다. 저희가 가진 구형 지도에는 물음표로 "
"표시되어있죠. 그래서 거기 뭐가 있는지 찾아보기로 결정한 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0021_Text
#. Speaker : Pathfinder_Bard
msgctxt "9cae613e-1ce7-48aa-94d7-eb241dda251f"
msgid ""
"{n}The Pathfinder laughs joyfully.{/n} \"And just imagine — we didn't find "
"anything. Just the ruins of some old building, and signs of an ancient "
"portal... It appears to be one of the places where the border between worlds "
"is particularly thin. The beast must have smelled us and leapt out to have "
"itself a snack!\""
msgstr ""
"{n}패스파인더는 즐거운듯 웃습니다.{/n} \"그리고 상상해보세요 — 저희는 아무것도 찾지 못했어요. 몇몇 옛 건물들의 유해와 고대의 "
"포탈이 열렸던 흔적만이 남아있었죠... 그곳은 세계 사이의 경계가 특히 희미했던 지역 중 하나로 보입니다. 괴수 하나가 냄새를 맡고 "
"간식거리를 찾아 뛰어들었을 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0022_Text
#. Speaker : Pathfinder_Bard
msgctxt "42286c04-e52b-47b2-a55d-1ccf8693a0f8"
msgid ""
"\"Don't tell me you've never heard of the {g|Pathfinder Society}Pathfinder "
"Society{/g}! We stand at the helm of civilization! We cut the paths to the "
"unknown and unveil even the gloomiest secrets, from which the weak of heart "
"shy away in fear! We...\""
msgstr ""
"\"{g|Pathfinder Society}패스파인더 협회{/g}에 대해 한번도 들어보지 못했다는 말씀은 아니시겠죠! 저희는 문명 사회의 "
"조타수입니다! 저희는 미지의 길을 개척하고 그 어떤 끔찍한 비밀이라도 파헤치죠, 심장이 약한 사람은 겁에 질려 도망갈 만한 것들이요! "
"저희는...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0023_Text
#. Speaker : Pathfinder_Bard
msgctxt "70351199-533d-4723-9bc2-cc2b0839bf27"
msgid ""
"\"But never mind all that. Enough accolades. Here's the truth: the {g|"
"Pathfinder Society}Pathfinder Society{/g} explores {g|Golarion}Golarion{/g}, "
"seeking to reveal its greatest secrets. And we — Pathfinders, lovers of "
"travel and adventure — are the ones who do it.\""
msgstr ""
"\"하지만 다 잊으시죠. 충분히 꾸며낸 것 같군요. 진실을 애기하겠습니다: {g|Pathfinder Society}패스파인더 협회{/g}"
"는 {g|Golarion}골라리온{/g}의 가장 커다란 비밀들을 파헤치기 위해 탐험합니다. 그리고 저희들 — 여행과 모험을 좋아하는 "
"패스파인더들 — 은 그걸 해내는 사람들입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0024_Text
#. Speaker : Pathfinder_Bard
msgctxt "e1320e5f-38fa-4e5a-b3d7-64232d8ca5d4"
msgid ""
"\"No, no, don't worry yourself! We'll just catch our breath and go... The "
"bruises will be gone by sun up!\""
msgstr "\"아뇨, 아뇨, 걱정하지마세요! 잠깐 숨 좀 고르고 나면 바로 출발할 겁니다. 이런 멍은 해가 뜨고나면 금방 나아요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0025_Text
msgctxt "8743abde-ab88-48a0-947e-2e7fee0e874a"
msgid ""
"{n}The half-orc looks around and purses her lips.{/n} \"You shouldn't "
"bother... of course, it'll take some time to drag our unlucky friends to the "
"temple... but it's fine — it won't be the first time!\""
msgstr ""
"{n}하프오크는 주변을 돌아보며 입술을 오므립니다.{/n} \"당신께 방해되지 않는다면... 물론이죠, 우리 불쌍한 친구들을 신전에 "
"데려가는데는 시간이 좀 걸리겠지만, 괜찮아요 — 늘상 있는 일이니까!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0026_Text
#. Speaker : Pathfinder_Bard
msgctxt "a15c31ee-2f79-43e1-9273-53ec2c57c91a"
msgid ""
"{n}The half-orc bows to you ceremoniously.{/n} \"My regards! If it's "
"{g|Desna}Desna's{/g} will, we will meet again!\""
msgstr ""
"{n}하프오크는 경쾌하게 인사합니다.{/n} \"감사합니다! {g|Desna}데스나{/g}님의 뜻이 있다면, 분명 다시 만날 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0027_Text
#. Speaker : Pathfinder_Bard
msgctxt "f901ce62-a0d6-4e8e-ba56-fc870391b74e"
msgid ""
"{n}The half-orc becomes gloomy.{/n} \"How could you! To accuse the agents of "
"the {g|Pathfinder Society}Society{/g} of espionage?! We'll not set foot in "
"your backwards country ever again!\""
msgstr ""
"{n}하프오크는 우울해진 것 같습니다.{/n} \"당신이 어떻게! {g|Pathfinder Society}협회{/g}의 일원을 간첩이라고 "
"비난하시다니?! 다시는 이 땅에 찾아오지 않을 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0029_Text
#. Speaker : Pathfinder_Bard
msgctxt "e23c2da9-a88d-4754-96e8-3169aafc60e8"
msgid ""
"\"Well, yeah, the tomb! It's right there!\" {n}The half-orc waves her hand "
"vaguely.{/n} \"Anyway, there's nothing interesting in there. Don't waste "
"your time.\""
msgstr ""
"\"뭐, 그렇죠, 무덤이요! 바로 여기에 있어요!\" {n}하프오크는 그녀의 손을 모호하게 흔듭니다.{/n} \"아무튼, 여기에 흥미로운 "
"건 아무것도 없어요. 시간 낭비하지 마시길.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep1_Encounter/Cue_0030_Text
#. Speaker : Pathfinder_Bard
msgctxt "ea13c806-7d0b-4340-ae33-e5830bf321a6"
msgid ""
"{n}The half-orc is wearing a bright jacket decorated with many badges and "
"patches. She looks around and sighs.{/n} \"Heh, we suffered some losses... "
"Oh well, on the other hand we got the beast! Thank you!\""
msgstr ""
"{n}수많은 배지와 누비 조각으로 장식된 밝은색 재킷을 입은 하프오크가 이마에 흐르는 땀을 닦습니다. 그녀는 주변을 둘러보고난 뒤 한숨을 "
"내쉽니다.{/n} \"하, 또 손실이네... 아 그렇지, 반대로 얘기하면 저희가 그 괴물을 처리했단 뜻이죠! 감사합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0005_Text
msgctxt "b62554dc-d9f2-4fa6-b08e-f83ed8aab8bd"
msgid "\"Anoriel, is that you? I hardly recognize you!\""
msgstr "\"아노리엘, 당신인가? 거의 못 알아볼 뻔했는데!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0006_AlignmentShift.Description
msgctxt "1c02af37-f748-46a2-b519-8f18696b60e9"
msgid ""
"Allowed the venture-captain to found a Pathfinder Society lodge in the "
"Stolen Lands."
msgstr "모험단의 대장이 도둑맞은 땅에 패스파인더 지부를 설치할 수 있도록 허락했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0006_Text
msgctxt "3603e30e-47a3-4c67-af29-7fd88c1b294a"
msgid ""
"\"I will be happy to see the Pathfinders in these lands. I will allow you to "
"found a lodge.\""
msgstr "\"이 땅에서 패스파인더들을 볼 수 있다니 기쁘군. 지부 설립을 허가하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0008_Text
msgctxt "69880e49-70f0-411b-b5df-279c270b91d3"
msgid "\"And who exactly will be the Society's representative here?\""
msgstr "\"여기 있는 자들 중 협회의 대표는 정확히 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0009_AlignmentShift.Description
msgctxt "0de7acb5-bc4e-4953-b306-d15301c8eea6"
msgid "Ordered the venture-captain to leave on suspicion of espionage."
msgstr "모험단의 대장에게 간첩 혐의를 빌미로 떠나도록 명령했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0009_Text
msgctxt "9c666cbe-d310-4a42-9036-37b842216ac3"
msgid ""
"\"I trust neither you nor your Society. The Pathfinders are not welcome in "
"my lands.\""
msgstr "\"당신이나 당신의 협회나 믿음이 가질 않는군. 패스파인더들은 내 영토에서 환영받지 못할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0010_Text
msgctxt "029d892b-dba1-4915-a646-e80c5109d932"
msgid ""
"\"How can you guarantee that if I let you in, I won't be letting a wolf "
"among the sheep? Perhaps Absalom is seeking to place a spy in the Stolen "
"Lands?\""
msgstr ""
"\"나는 양 떼 사이에 늑대를 풀어둘 생각이 없는데, 왜 내가 너를 받아들일 거라 생각하지? 압살롬이 도둑맞은 땅에 간첩을 풀 장소를 "
"찾는 모양이로군?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0017_AlignmentShift.Description
msgctxt "f6f419e3-6586-48cd-a243-bd2ca2882afa"
msgid "Expressed a desire to become a Pathfinder."
msgstr "패스파인더가 되고자 하는 뜻을 밝혔습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0017_Text
msgctxt "9ba0cfe0-4655-4423-aef2-6ea18ef6f4c0"
msgid "\"I also want to be a Pathfinder. How do I join the Society?\""
msgstr "\"나 또한 패스파인더가 되고 싶은데, 협회에 가입할 방법이 있나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0018_Text
msgctxt "2a60fd0c-c15d-4ea1-9595-e64c70558462"
msgid "\"Tell me about the Pathfinder Society.\""
msgstr "\"패스파인더 협회에 대해 얘기해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0021_Text
msgctxt "b9ce474e-c2a0-47e3-a73b-f197b7d7b51c"
msgid "\"What exactly is this Lodge you want to found?\""
msgstr "\"당신이 설립하고자 하는 지부란 정확히 뭐지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0025_AlignmentShift.Description
msgctxt "7fc31739-5fd3-4c1d-a836-355ac91a2b7a"
msgid ""
"Didn't allow the venture-captain to found a Pathfinder Society lodge in the "
"Stolen Lands, because of the dangerous methods of the Pathfinders."
msgstr ""
"패스파인더들이 행하는 위험한 방식들을 이유로, 모험단 대장이 도둑맞은 땅에 패스파인더 협회 지부를 설립하는 것을 허가하지 않았습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0025_Text
msgctxt "1f6bf072-d90e-412e-9f01-c0b40f1b3151"
msgid ""
"\"I can't put my subjects at risk. If the Pathfinders make another mistake, "
"and set another affliction loose upon the population, innocent lives might "
"be lost. The Society must accept my refusal.\""
msgstr ""
"\"나는 내 주민들에게 위험을 강요하지 않을것이다. 만약 패스파인더들이 또 다른 실수를 저지르거나 민중들 사이에 또다른 위협을 "
"방류한다면, 무고한 생명들만 잃게 된다. 협회는 나의 거절 사유를 받아들여야 할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0028_Text
msgctxt "0818ebaf-81d0-4eb1-bede-20ddb8690136"
msgid ""
"\"So members of your Society go to strange lands and make trouble by "
"interfering with things that are none of their concern?\""
msgstr "\"그래서, 네 협회의 구성원들은 낯선 땅을 탐험하다 문제를 터뜨리고는 나몰라라 한다는 건가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Answer_0029_Text
msgctxt "c07d29fc-5843-4046-8dd7-73f85a706422"
msgid "\"Enough.\""
msgstr "\"충분해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0001_Text
msgctxt "0758f84e-ce9b-422a-abf0-bd444c085576"
msgid ""
"{n}An elf dressed in a neat but somewhat worn doublet stands at attention, "
"then bows to you — his movements precisely measured.{/n} \"Greetings, {mf|"
"Your Grace|Your Grace|Your Highness|Your Highness}! My name is Anoriel Eight "
"Eyes.\""
msgstr ""
"{n}단정해보이지만 약간 헤진 더블릿을 입은 엘프가 알현을 청한 뒤, 인사합니다 — 그의 행동은 정교히 계산된듯 합니다.{/n} "
"\"안녕하십니까, {mf|영주님|영주님|전하|전하}! 저는 여덟 눈의 아노리엘입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0002_Text
msgctxt "1452aacf-4c2e-4bbb-b872-ba572bdd0ebb"
msgid ""
"\"I am here as an official representative of the {g|Pathfinder Society}"
"Pathfinder Society{/g}, {mf|Your Grace|Your Grace|Your Highness|Your "
"Highness}. It's become known in {g|Absalom}Absalom{/g} that certain members "
"of the Society were bothering you of late — or, to be more precise, you were "
"troubled by the consequences of their indiscretion. I formally apologize to "
"you and your subjects, and would like to extend to you, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}, an offer that will be of benefit to all "
"interested parties.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 저는 {g|Pathfinder Society}패스파인더 협회{/g}의 공식 대변인으로써 이 자리에 "
"왔습니다. {g|Absalom}압살롬{/g}에도 최근 몇몇 회원들이 — 아니면, 더 정확히 말해 그들의 무책임한 행동으로 인한 결과로 "
"인해 당신께 심려를 끼쳤다는 사실이 알려졌습니다. 저는 공식적으로 당신과 당신의 백성들에게 사과드리는 바이며, 또한 저는 "
"{mf|영주님|영주님|전하|전하}께 이해 당사자들 모두에게 이득이 될 제안을 받아들일 용의가 있으신지 여쭤보기 위해 찾아왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0003_Text
msgctxt "3203a395-ccd9-4e1f-aa9f-733f5c8cb8e0"
msgid ""
"\"Please allow a representative of the {g|Pathfinder Society}Pathfinder "
"Society{/g} to remain in the city and lead a local Lodge, to coordinate with "
"other ordinary Pathfinders. We would prefer not to act in this region "
"without the support of the local ruler. The goal of the society is to "
"explore the world we live in, not cause unwanted conflict.\""
msgstr ""
"\"다른 평범한 패스파인더들과 협력하기 위해, {g|Pathfinder Society}패스파인더 협회{/g}의 대변인이 당신의 수도에 "
"남아 지부를 운영할 수 있도록 허락해주십시오. 저희는 지역 통치자의 도움 없이 행동하기를 원치 않습니다. 협회의 목적은 우리가 사는 "
"세계를 탐험하는 것이지, 불필요한 분쟁을 일으키는것이 아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0007_Text
msgctxt "c0a1422e-6751-41a5-8635-05e6d98f8400"
msgid ""
"{n}Anoriel giggles and sheds the put-on formality.{/n} \"Forgive me, but I'm "
"on a mission from the {g|Pathfinder Society}Society{/g}, {mf|Your Grace|Your "
"Grace|Your Highness|Your Highness}! After those simpletons in the {g|Valley "
"of the Dead}Valley of the Dead{/g} brought trouble to your door, the Society "
"decided to found a Lodge here — and someone remembered about me!\""
msgstr ""
"{n}아노리엘은 피식 웃었다가 곧바로 공무 자세로 돌아갑니다.{/n} \"용서해주십시오, {mf|영주님|영주님|전하|전하}! 하지만 저는 "
"지금 {g|Pathfinder Society}협회{/g}의 임무를 수행중입니다. 그 머저리들이 {g|Valley of the Dead}"
"죽은 자의 계곡{/g}에서 당신의 눈 앞까지 문제를 끌고왔던 일 뒤에, 협회는 이 땅에 지부를 설치하기로 결정했습니다 — 그리고 그 곳의 "
"몇 명이 저를 기억하고 있더군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0011_Text
msgctxt "26ac19a8-a472-46ff-8f46-390a94e72523"
msgid ""
"{n}The elf clears her throat.{/n} \"I am ready to begin my duties the moment "
"you give your consent. I have been a Pathfinder for many years myself, and "
"have seen many things — things far scarier than what the {g|Stolen Lands}"
"Stolen Lands{/g} can boast, if I may say so. I'm more than capable of taking "
"care of any newcomers.\""
msgstr ""
"{n}엘프는 그녀의 목을 가다듬습니다.{/n} \"저는 당신이 승낙하시는 순간부터 제 업무를 시작할겁니다. 저는 패스파인더로서 오랜 "
"시간을 활동해왔고, 그동안 많은 것을 목격했습니다 — 말씀드리건대, {g|Stolen Lands}도둑맞은 땅{/g}이 자랑하는 것들보다 "
"훨씬 더 무서운 것들도 있죠. 저라면 새 회원들을 더 잘 이끌 수 있을겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0013_Text
msgctxt "ab9d43d1-e201-4518-b20a-d843362b6f05"
msgid ""
"{n}Anoriel lowers her head pensively.{/n} \"The {g|Pathfinder Society}"
"Pathfinder Society{/g} has upheld a fragile but working truce with dozens of "
"countries for many years. Our reputation guarantees that we will not "
"interfere in your internal affairs.\""
msgstr ""
"{n}아노리엘은 수심에 잠겨 머리를 숙입니다.{/n} \"{g|Pathfinder Society}패스파인더 협회{/g}는 많은 국가들의 "
"위태로운 휴전을 지속하기 위해 수 년간 노력해왔습니다. 당신의 내부 사정에 간섭하지 않을 것이라는 건 저희의 명성이 증명합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0014_Text
msgctxt "fb22576f-7572-41cc-bf28-9f83eb03a87f"
msgid ""
"{n}The light in Anoriel's eyes fades, she lowers her shoulders as if an "
"invisible burden lay heavily upon them.{/n} \"I... will convey your answer "
"to the Grand Lodge. Forgive my intrusion.\""
msgstr ""
"{n}아노리엘의 눈동자가 희미해집니다. 그녀는 보이지 않는 짐에 짓눌리는 듯 어깨를 축 늘어뜨립니다.{/n} \"저는... 총괄 본부에 "
"당신의 답을 전하겠습니다. 제 무례를 용서해주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0015_Text
msgctxt "93948f65-6543-4093-a7b0-a730217e6c2e"
msgid ""
"{n}Anoriel lights up.{/n} \"Thank you! If I may, I will say goodbye for now, "
"and proceed immediately to my duties as venture-captain!\""
msgstr ""
"{n}아노리엘에게 화색이 돕니다.{/n} \"감사합니다! 허락하신다면, 당장 이 자리에서 물러나고, 즉시 모험단 대장으로서의 임무를 "
"시작하겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0019_Text
msgctxt "75c77c3a-b8b9-4e9d-a0e6-f832e58c416b"
msgid ""
"{n}Anoriel opens her mouth in astonishment.{/n} \"But...\" {n}Her expression "
"of surprise is replaced with a mischievous grimace.{/n} \"You know, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}, I would be very happy to have "
"a colleague like you. But you would hardly be able to venture across all the "
"world while you're also ruling an entire country. But when you grow tired of "
"sitting on the throne — then come to me, and we'll talk!\""
msgstr ""
"{n}아노리엘은 깜짝 놀라 입을 엽니다.{/n} \"하지만...\" {n}그녀의 얼굴은 놀람에서 짖궂게 찡그린 표정으로 변합니다.{/n} "
"\"{mf|영주님|영주님|전하|전하}, 아시겠지만, 당신같은 동료가 있다면 저 또한 매우 행복할 겁니다. 하지만, 당신의 땅을 통치하면서 "
"동시에 전세계를 모험하시는 건 매우 어려울 것 같군요. 하지만 당신께서 왕좌에 앉아있는데 질리시는 날엔 — 그 땐 저에게 찾아와주십시오. "
"얘기를 해 보도록 하지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0020_Text
msgctxt "4ccf07be-9a2e-456b-84dc-4d5213d45873"
msgid ""
"\"Pathfinders are those who can't live at peace in a world full of secrets "
"and riddles. Curiosity drives us from our warm homes, and beyond the rivers "
"and seas, even to the end of the world – and sometimes even beyond! There "
"are plenty of mysteries in the {g|Stolen Lands}Stolen Lands{/g} — and for "
"the Pathfinders determined to solve them, we should open a local lodge."
msgstr ""
"\"패스파인더들이란 비밀과 수수께끼로 가득 찬 세상에서 평화롭게 살지 못하는 사람들이죠. 호기심 때문에 따뜻한 고향을 떠나, 강과 바다를 "
"건너고, 세계의 끝까지 – 때론, 심지어 그 너머를 향해가죠! {g|Stolen Lands}도둑맞은 땅{/g}에는 수많은 미스터리가 "
"널려있습니다 — 그들 모두가 바로 패스파인더들이 풀어내기로 결심한 것들이죠! 저희는 지부를 설립하고 싶습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0022_Text
msgctxt "ca5f6a84-1131-4520-ab1d-f1e9ee99d492"
msgid ""
"\"A sanctuary for Pathfinders. A quiet byway, where any member of the {g|"
"Pathfinder Society}Society{/g} can find shelter, protection and a good "
"company. Besides, we'll have a small library devoted to these lands — the "
"flora, fauna, geographic and climatic peculiarities, history and traditions —"
" all of this knowledge will be stored at the lodge.\""
msgstr ""
"\"패스파인더들의 성지입니다. {g|Pathfinder Society}협회{/g}의 모든 일원들이 휴식하고, 보호받고, 좋은 동료를 구할 "
"수 있는 외진 곳이죠. 게다가, 그 땅에 대한 책이 가득한 작은 도서관도 있습니다. — 식물 도감, 동물 도감, 지리학과 기상학, 역사와 "
"전통에 관한 것까지 — 이 모든 지식들을 지부에 보관할 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0030_Text
msgctxt "7978d3f9-9257-4d35-9ca5-f58d5d6cacd6"
msgid "\"As you wish.\""
msgstr "\"원하시는대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0031_Text
msgctxt "63a89d03-34ec-4c89-a900-3f2d968251de"
msgid ""
"\"Events related to... um... oh yes, the {g|Valley of the Dead}Valley of the "
"Dead{/g}… That was a tragic accident no mortal could escape. Sometimes, evil "
"lurks in the depths, and bursts upon us from nowhere. Though it's true that "
"some Pathfinders are not so concerned about the safety of others...\""
msgstr ""
"\"그...어... 예, {g|Valley of the Dead}죽은 자의 계곡{/g}과 관련된 일은... 어떤 필멸자도 피할 수 없을 "
"사고였습니다. 때때로, 사악한 것이 지하 깊숙히 숨어있다가, 아무 징조도 없이 저희를 향해 튀어나오곤 하죠. 비록 몇몇 패스파인더들은 "
"다른 이들의 안전에 대해 깊이 생각하지 않는다는 게 사실입니다만...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0032_Text
msgctxt "8f30058e-05ec-4705-9d73-650dd1deadd3"
msgid ""
"{n}Anoriel Eight Eyes looks unusually neat: her hair is clean and brushed, "
"her clothes spotless, and her elven face is lit with unusual enthusiasm. "
"When she speaks, it becomes clear that she's choosing her words much more "
"carefully than usual.{/n}"
msgstr ""
"{n}여덟 눈의 아노리엘은 전에 없이 단정해 보입니다. 머리를 깔끔하게 빗어 넘겼고, 의복에는 먼지 한 톨 없으며, 얼굴에 좀처럼 보기 "
"힘든 생기가 떠오릅니다. 아노리엘은 평소보다 신중하게 단어를 고르며 말을 잇습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0033_Text
msgctxt "1a2d2539-82ff-4e9f-a2c6-9c4055aae919"
msgid ""
"\"I received a message from the Society just yesterday. If you agree, I will "
"become the local venture-captain!\" {n}The elf shakes her hair.{/n} \"And "
"you know what? I've idled about enough. You can't undo what's done, and I'm "
"no good as a Pathfinder any more. But at least I can serve others. I learned "
"a lot about the Stolen Lands in the years I spent here — enough for a couple "
"of textbooks! So if you agree to the Lodge...\""
msgstr ""
"\"바로 어제 협회로부터 공문을 받았습니다. 당신이 동의하신다면, 제가 지역의 모험단 대장이 될겁니다!\" {n}엘프는 그녀의 머리카락을 "
"흔듭니다.{/n} \"그리고 그걸 아십니까? 저는 항상 이걸 꿈꿔왔습니다. 당신은 결정하신 것을 물리지 않으실 테고, 저는 더이상 좋은 "
"패스파인더도 아닙니다. 하지만 최소한 다른 사람들을 도울 수 있지요. 저는 도둑맞은 땅에서 보낸 지난 몇 년간 많은걸 배웠습니다 — "
"책으로 두 권은 나올겁니다! 그러니 당신이 지부 설립을 허락하신다면...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/KingdomAsCompanion/N_TippingTheScales/Ep3_KTC/Cue_0034_Text
msgctxt "157ae67e-0d40-40e6-9bd5-5ef4d26ac8a1"
msgid ""
"\"But the {g|Pathfinder Society}Society{/g} is what it is. It accepts any "
"applicant who wishes to become a Pathfinder, and sends its followers to all "
"the corners of Golarion. — That's the only way to preserve balance. And "
"without balance, the Society would have become advocates of this or that "
"idea a long time ago.\""
msgstr ""
"\"하지만 {g|Pathfinder Society}협회{/g}는 협회죠. 패스파인더가 되고 싶어하는 지원자는 모두 받아들이고, 그들을 "
"골라리온의 구석구석에 보냅니다 — 균형을 유지할 유일한 방법이죠. 또 균형이 없다면 협회는 오래전에 단순한 단체나 사상을 좆는 추종자 "
"집단이 되었을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Villages/Village_Cleric/Answer_0005_Text
msgctxt "939f39c9-667a-4c8e-9320-27ebdeefda5e"
msgid "\"I have to go.\""
msgstr "\"이만 가보겠다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Villages/Village_Cleric/Cue_0001_Text
msgctxt "c38ad5a1-2e11-43a7-8545-f80d251a79b6"
msgid ""
"\"Your {mf|grace|grace|highness|highness}! Thank you for finding time to "
"visit this humble corner of your gods-blessed "
"{mf|barony|barony|kingdom|kingdom}! How can I be of service?\""
msgstr ""
"\"{mf|영주님|영주님|영주님|영주님}! 이 신의 축복을 받은 {mf|남작령|남작령|왕국|왕국} 구석에 있는 저를 찾아와 주시다니 "
"감사합니다! 어떻게 도와드릴까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomDevelopment/Villages/Village_Cleric/Cue_0007_Text
msgctxt "9dca56d1-5a0c-40ac-91bd-135a06eeafa0"
msgid "\"May the gods never abandon you in their mercy!\""
msgstr "\"신들께서 당신을 저버리지 않으시길!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Answer_0005_Text
msgctxt "a6e47720-e843-4a49-9ab2-edaba74dec34"
msgid "\"What is this place? Where is it?\""
msgstr "\"이 장소의 정체는 무엇이고 어디에 있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Answer_0006_Text
msgctxt "19f468fb-c0e4-493b-bd30-9aab3660886a"
msgid "\"I will go there as soon as I am able.\""
msgstr "\"되도록 빨리 가겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Answer_0007_Text
msgctxt "c549e4a5-be2f-437d-95d2-0806e8c3f8ed"
msgid "\"Well, what do you suggest?\""
msgstr "\"음, 제안할 것이 있나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Answer_0008_Text
msgctxt "de392d28-db71-47dc-b047-83798113d93f"
msgid "\"I'm not interested.\""
msgstr "\"흥미 없는 일이다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "19be5e35-9438-417c-a39b-caf5b71a5236"
msgid ""
"\"Your Grace! Allow me to congratulate you on receiving the title of "
"baron{mf||ess}! I am confident that you will be able to bring order to these "
"troubled lands.\""
msgstr ""
"\"영주님! {mf||여}남작 칭호를 받으셨다니, 축하드립니다! 당신이라면 분명 이 문제 많은 땅에 질서를 가져올 수 있겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Cue_0002_Text
#. Speaker : Capital_Jhod
msgctxt "773d848f-9065-469e-921a-5662d1204dd9"
msgid ""
"{n}Jhod stumbles slightly.{/n} \"Though to be honest, that isn't exactly "
"what we wanted to speak to you about. Tristian and I have been talking a "
"great deal about what happened at the Temple of the Elk. It doesn't all make "
"sense to us yet, but one thing is clear — there's a powerful curse at work. "
"It corrupted the very essence of that sacred place, steeping it with "
"putrescence. Ugh! I am disgusted with whoever could do this.\""
msgstr ""
"{n}조드는 약간 비틀거립니다.{/n} \"솔직히 말해, 저것은 우리가 영주님과 이야기하고 싶었던 것과 정확히 같지는 않습니다. "
"트리스티안과 저는 엘크 성전에서 일어난 일에 관해 많은 이야기를하고 있습니다. 아직 우리 모두에게 이해가되지는 않지만, 한 가지는 "
"분명합니다. 거기에 강력한 저주가 작용한다는 겁니다. 이 저주가 썩은 냄새를 풍기며 성스러운 곳의 본질을 타락시키는 것입니다. 으윽! "
"역겹군요. 이걸 했던 사람이 누군지 간에.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Cue_0003_Text
#. Speaker : Capital_Jhod
msgctxt "4aca7af7-19ed-4638-be24-dc9bc1bf8f6f"
msgid ""
"{n}Jhod exhales loudly, catching his breath.{/n} \"And now there is a new "
"woe! Tristian and I believe the curse did not simply disperse of its own "
"accord! There is a place near the capital rumored by the locals to be "
"cursed. Tristian and I visited this dreadful place, and we felt the same "
"putrescence as at the Temple of the Elk!\""
msgstr ""
"{n}조드는 크게 숨을 쉬며 호흡을 고릅니다.{/n} \"그리고 이제는 그곳에 새로운 문제가 있습니다! 트리스티안과 저는 그 저주가 "
"단순히 저절로 흩어지지 않았다고 믿습니다! 현지 주민들에게 저주받았다는 소문이 도는 곳이 수도 근처에 있습니다. 트리스티안과 제가 이 "
"끔찍한 곳을 방문했고, 엘크 성전에서와 같은 부패를 느꼈습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Cue_0009_Text
#. Speaker : Tristian_Companion
msgctxt "604440fc-76f0-46da-9886-4d41e5deeda8"
msgid ""
"\"I would be happy to accompany you, but I would not expect to see anything "
"new there at present.\""
msgstr "\"그대와 함께하게 되어 기쁩니다만, 당장 뭔가 새로운 것이 있을 거라 기대하지는 않습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Cue_0010_Text
#. Speaker : Tristian_Companion
msgctxt "aca77cb7-78e0-4721-8560-3117b00368c2"
msgid ""
"\"There is a Bald Hilltop not far from here, to the north of the capital. "
"Its crown is entirely barren of life. The locals believe that rituals "
"glorifying the dark gods were held there, back in ancient times. There is no "
"longer any trace of such rituals, but the air around the hilltop is heavy to "
"the point of stifling. This place is like a rotting wound, closed but not "
"healed.\""
msgstr ""
"\"수도의 북쪽에서 멀지 않은 곳에 민둥 언덕마루가 있습니다. 그곳의 정상엔 생기가 전혀 없지요. 그 지역 주민들은 옛날, 어둠의 신들을 "
"찬양하는 의식이 그 곳에서 행해졌다고 믿습니다. 그러한 의식의 흔적은 더 이상 남아있지 않습니다만, 언덕 위의 공기는 숨이 막힐 정도로 "
"무겁습니다. 이곳은 마치 치유되지 않은채 봉합되어 썩어가고 있는 상처와도 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Cue_0011_Text
#. Speaker : Capital_Jhod
msgctxt "5a9cbed4-7016-45b8-b0ac-880f311809fc"
msgid ""
"\"And this wound will undoubtedly open again! Tristian and I felt something "
"approaching... Something ominous. The curse will soon return to plague us "
"once more – I swear by {g|Erastil}Erastil{/g}!\""
msgstr ""
"\"그리고 이 상처는 의심의 여지없이 다시 터지게 될겁니다! 트리스티안과 저는 무언가 가까이 오고 있음을 느꼈습니다... 불길한 무언가 "
"말이죠. 저주는 곧 다시 한 번 우리를 고통받게 할 겁니다. {g|Erastil}에라스틸{/g}에게 맹세코!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Cue_0012_Text
#. Speaker : Tristian_Companion
msgctxt "02301d0c-904f-4ad9-b4c4-b654f4289847"
msgid ""
"{n}Tristian looks at you, confused.{/n} \"Are you sure? The threat could be "
"even more serious than we imagine.\""
msgstr ""
"{n}트리스티안은 혼란스럽다는듯이 당신을 바라봅니다.{/n} \"정말이십니까? 위협은 우리가 상상하는 것보다 훨씬 더 심각할 수 있습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Cue_0013_Text
#. Speaker : Capital_Jhod
msgctxt "d3300265-aeb3-4a46-97e1-8dddd8b75fe0"
msgid ""
"\"In any case, we can't do anything right now anyway. Tristian and I have "
"been to this hilltop. There's nothing there!\""
msgstr "\"어쨌든 우리가 지금 당장 할 수 있는 일은 없습니다. 트리스티안과 제가 언덕마루에 가봤지만 그곳에는 아무것도 없었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Cue_0014_Text
#. Speaker : Capital_Jhod
msgctxt "44648bff-4317-4493-95d5-7df285e9fcd4"
msgid ""
"\"I agree with Tristian! We have been to this hilltop. It's barren, but "
"filled with a dense atmosphere of unease!\""
msgstr ""
"\"트리스트안에게 동의합니다! 우린 이 언덕 꼭대기까지 가보았었습니다. 그 곳은 황량하지만 불안한 분위기로 가득 차 있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Cue_0015_Text
#. Speaker : Capital_Jhod
msgctxt "91ed19b7-6fbc-4c5b-ae6e-0c57cde64487"
msgid ""
"\"The curse will grow in strength, and we predict it will reach the peak of "
"its strength in about one month. That's when we should visit the Bald "
"Hilltop and resolve this issue.\""
msgstr ""
"\"저주는 점점 강해질 것이며 약 한 달 뒤에 절정에 달할 것으로 예상됩니다. 그때가 바로 민둥 언덕마루로 가서 문제를 해결해야 하는 "
"때입니다. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Cue_0016_Text
#. Speaker : Tristian_Companion
msgctxt "20d40806-d737-4454-a566-c5d11aa7501d"
msgid "\"For now we can only wait. And prepare.\""
msgstr "\"지금으로서는 기다릴 수밖에 없습니다. 그리고 대비해야겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon1/Cue_0017_Text
#. Speaker : Capital_Jhod
msgctxt "02931bcf-5fef-4cd1-a690-c24d7d30a1b7"
msgid ""
"\"We beg your pardon, Your Grace, for intervening with you getting the grasp "
"of your barony. I'm sure you have even more pressing matters at hand right "
"now.\""
msgstr ""
"\"영주님. 영지의 중대사를 결정 중이신데 이렇게 불쑥 찾아뵙게 되어 죄송합니다. 영주님께 지금 더 긴급한 문제가 있음을 확신합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Answer_0009_Text
msgctxt "3ecaeb81-3632-4b97-8a7d-bb2919fabcb8"
msgid "\"What? Again?!\""
msgstr "\"뭐? 또?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Answer_0010_Text
msgctxt "4bcc95ca-ff58-4f38-a55e-68f3e2af5d70"
msgid "\"How much time do we have?\""
msgstr "\"시간이 얼마나 남았지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Answer_0011_Text
msgctxt "96ca607b-8568-453f-99c5-54eaf67b94f7"
msgid "\"Well, let's prepare for the next attack.\""
msgstr "\"자, 그럼 다음 공격을 대비하자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Answer_0016_Text
msgctxt "c009a0d0-91e2-4bc6-8905-55c8bc170ba7"
msgid ""
"\"I want to deal with this problem once and for all. What do you recommend?\""
msgstr "\"난 이 문제를 완전히 해결하길 원해. 뭔가 추천할만한 거라도?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "0f1d6f22-60f3-42c8-8822-8ee4a61c4706"
msgid ""
"\"Your Grace, we are victorious! We fought off the spider invasion, and "
"defeated the strange dryad who led them! As a sign of gratitude, your "
"subjects have a special reward for you!\""
msgstr ""
"\"영주님, 우리가 승리했습니다! 거미의 침공을 물리치고 그들을 이끌었던 이상한 드라이어드를 물리쳤습니다! 사의의 표시로, 신하들이 "
"영주님의 업적에 대한 특별 보상을 모았습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Cue_0002_Text
#. Speaker : Capital_Jhod
msgctxt "29d66635-bdf6-4a58-b6ab-da7822a51a5d"
msgid ""
"\"Your Grace, we've finally cleared all of the spiders from the barony – "
"though it wasn't easy. Several people died, poisoned by spiders. Some cattle "
"perished... But for the most part, everything worked out.\""
msgstr ""
"\"영주님, 마침내 우리는 영지에서 모든 거미를 소탕했습니다. 쉽지는 않았지요. 몇몇 사람들은 거미에 의해 독살당했고 소 몇 마리가 "
"비명횡사했지요. 그러나 대부분은, 모두 잘 풀렸습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Cue_0003_Text
#. Speaker : Capital_Jhod
msgctxt "22a0510f-78ca-4c96-8f46-e5a3ea81fb09"
msgid ""
"\"Your Grace! The barony suffered huge losses during the spider invasion. "
"Their poison killed everything – people, and livestock alike. Thank the gods "
"that the spiders suddenly disappeared a few days ago, as if they had never "
"been here at all. I don't even know how we managed to survive this invasion. "
"But I do know this – a great many of your subjects will henceforth recoil in "
"fear whenever they see a spider.\""
msgstr ""
"\"영주님! 거미의 침략 동안 영지는 엄청난 손실에 고통받았습니다. 사람, 가축 할 것 없이 중독되어 죽었습니다. 거미들이 며칠 전 여기 "
"온 적도 없는 듯이 갑작스레 사라져버렸다는 것을 신께 감사드리는 바입니다. 우리가 이 침략에서 어떻게 살아남을 수 있었는지조차 알지 "
"못하지만, 이건 알지요. 이 사태를 겪은 당신의 백성 대부분은 이후로 거미를 볼 때마다 겁에 질려 뒷걸음질칠테지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Cue_0004_Text
#. Speaker : Linzi_Companion
msgctxt "8beb46f9-76e9-4650-9b12-0e7c24cd7ed2"
msgid ""
"\"I wonder – was this flood of spiders truly caused by that curse? I mean, "
"the curse must be ancient and very ominous. The spiders were definitely "
"scary as well, but they weren't ancient and ominous.\""
msgstr ""
"\"좀 - 의아스럽네요. 진짜로 저주가 거미의 범람을 초래했을까요? 그니까 내 말은, 저주는 오래되고 매우 불길한 거라는 거예요. 거미도 "
"확실히 무서웠지만, 그건 오래되고 불길함은 아니잖아요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Cue_0005_Text
#. Speaker : Capital_Jhod
msgctxt "e8522c05-a0d6-4979-90ff-4497f1610643"
msgid ""
"\"I agree with Linzi. This does seem strange. Seems more like the plot of an "
"insane dryad than a true curse.\""
msgstr "\"린지의 의견에 동의합니다. 아무래도 이상해 보이는군요. 진짜 저주라기보단 미치광이 드라이어드의 음모처럼 보이는군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Cue_0006_Text
#. Speaker : Tristian_Companion
msgctxt "a2397197-71a2-40b4-af49-781bb1c6fa84"
msgid ""
"\"Then how can we explain the dismal atmosphere on the Bald Hilltop? The "
"pressure both of us felt there, Jhod? Maybe the curse drove the poor dryad "
"insane, causing her to lead this spider invasion into the barony?\""
msgstr ""
"\"그렇다면 민둥 언덕마루의 음산한 분위기는 어떻게 설명할 수 있겠습니까? 우리 둘 다 거기서 느낀 압력이 있었지요, 조드? 어쩌면 "
"저주가 이 불쌍한 드라이어드를 미치게 해서 거미들을 이끌고 저희 영지로 공격해오게 만들었을지도 모릅니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Cue_0007_Text
#. Speaker : Tristian_Companion
msgctxt "fbc1858b-a5ba-4815-8746-f8ece36e05a3"
msgid ""
"{n}Tristian shakes his head incredulously.{/n} \"In any case, I have "
"alarming news. As soon as the spider invasion was over, I visited the Bald "
"Hilltop again. It's grown quiet once more... and just as gloomy as before. I "
"don't think the curse is broken, just laying low — like a monster that rests "
"before it feeds again.\""
msgstr ""
"{n}트리스티안은 믿을 수 없다는 듯이 머리를 흔듭니다.{/n} \"어쨌든 우려해야 할 소식이 있습니다. 거미 침공이 끝나고 얼마 안 "
"돼서 다시 민둥 언덕마루를 다시 방문했습니다. 다시 조용해졌더군요.. 그저 예전처럼 우울합니다. 아무래도 저주가 깨졌다고는 생각하지 "
"않습니다. 마치 먹이를 먹기 전에 쉬고 있는 괴물처럼 잠시 누그러든 것만 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Cue_0012_Text
#. Speaker : Tristian_Companion
msgctxt "94aa26d6-4240-4fbf-946c-760a04d9d40e"
msgid ""
"\"I... am sorry for bringing the bad news. Unfortunately, we failed to "
"defeat this curse for good.\""
msgstr "\"저는... 나쁜 소식을 전하게 되어 유감스럽게 생각합니다. 불행히도, 우린 저주를 영원히 물리치는데 실패했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Cue_0013_Text
#. Speaker : Tristian_Companion
msgctxt "5b13c586-f591-4445-91de-a9cfb6669964"
msgid ""
"{n}Tristian nods.{/n} \"Very wise. If only we knew more about the curse – we "
"might figure out some way to fight it.\""
msgstr ""
"{n}트리스티안은 끄덕입니다.{/n} \"현명하십니다. 우리가 저주에 대해 더 많이 알아간다면, 우리가 싸울 수있는 방법을 더 찾아낼 수 "
"있을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Cue_0014_Text
#. Speaker : Linzi_Companion
msgctxt "0508d165-0e19-44d5-a709-a43b9093a6d1"
msgid ""
"{n}Linzi frowns.{/n} \"I don't understand. I spoke to the locals — they "
"never had any spider invasions before. And nothing ever happened on the Bald "
"Hilltop before, either. Now both spiders and the curse — right when the new "
"barony appeared in the Stolen Lands. All of this seems highly coincidental!\""
msgstr ""
"{n}린지가 눈살을 찌푸립니다.{/n} \"난 이해가 안가요. 주민들하고 이야기했는데.. 이전에는 어떤 거미 침략도 없었고, 민둥 "
"언덕마루에서도 아무 일도 일어나지 않았대요. 이 도둑맞은 땅에 새로운 영주가 나타나자마자 거미떼와 저주가 둘다 나타나기 시작한 거예요. "
"이 모든 게 엄청난 우연의 일치인 것처럼 보인다구요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Cue_0015_Text
#. Speaker : Tristian_Companion
msgctxt "1a5b4a85-5fe6-4fa2-a1f6-44558547253e"
msgid ""
"\"Oh, a fair amount! I'd say half a year, or even more. Now that the Bald "
"Hilltop is quiet again, I can barely feel its evil will. I'm sure we will "
"have enough time to prepare for the next attack.\""
msgstr ""
"\"아, 충분히 시간은 있습니다. 저는 반 년 또는 그 이상이라고 말하고 싶습니다. 지금은 민둥 언덕마루가 다시 조용해졌기에 그 악한 "
"의지가 매우 약하게 느껴집니다. 다음 공격에 대비할 시간은 충분할 것으로 확신합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Cue_0017_Text
#. Speaker : Linzi_Companion
msgctxt "403cffeb-d83d-4edd-899a-f2502e75a65f"
msgid ""
"\"Yes, let's level the Bald Hilltop to the ground and put an end to the "
"curse!\""
msgstr "\"그래요, 민둥 언덕마루를 평평하게 밀어버리고, 저주에 종지부를 찍는거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Cue_0018_Text
#. Speaker : Tristian_Companion
msgctxt "8d10307b-05b2-4334-905f-33054ddcd953"
msgid ""
"\"I doubt we will be able to defeat it in such a... straightforward fashion. "
"The heart of the curse is undoubtedly centered on the Bald Hilltop, but the "
"spiders appeared all throughout the barony. I don't think we are going to do "
"any damage to the curse by destroying the hilltop. I would expect exactly "
"the opposite — we'd only provoke it into attacking again, immediately on the "
"heels of the last. No, the best we can do for now is make sure we're "
"prepared for the next attack.\""
msgstr ""
"\"어.. 그런.. 단순한 방법으로 이길 수 있을지 의심스럽군요. 저주의 핵심은 의심할 여지없이 민둥 언덕마루를 중심으로 하고 있지만, "
"거미들은 영지의 모든 곳에서 등장했습니다. 언덕 꼭대기를 파괴하는 것으로 저주를 망가트릴 수 있다곤 생각되지 않는군요. 제 예상은 "
"정반대입니다. 오히려 저들에게 다시 공격하도록 자극하는 것이라고 생각됩니다. 그 방법으로는 안됩니다. 지금 우리가 할 수 있는 최선은 "
"다음 공격에 대비하는것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon2/Cue_0019_Text
#. Speaker : Capital_Jhod
msgctxt "3274ef2f-5ae2-4264-a00d-5c74689c4d77"
msgid ""
"\"Don't be such a pessimist, Tristian! We might truly be able to overcome "
"the curse — but only by studying it thoroughly. Your Grace, I will gather "
"all the information available on this situation and get to work.\""
msgstr ""
"\"그렇게 비관적으로 굴 건 없네, 트리스티안! 우린 분명 그 저주를 극복할 수 있을걸세, 그걸 철저하게 연구만 한다면 말이네만.. "
"영주님, 저는 이 상황에서 가능한 모든 정보를 모으고 일을 착수하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Answer_0004_Text
msgctxt "7a7f66af-336c-47c3-904f-20c8536eb0d6"
msgid "\"Do we still know nothing about this curse?\""
msgstr "\"우린 아직 이 저주에 대해 아무것도 모르나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Answer_0009_Text
msgctxt "65ae87ae-8c8e-440f-a97a-840464d729b6"
msgid ""
"\"Looks like we don't have a choice, then. We'll wait and prepare for the "
"next attack.\""
msgstr "\"선택의 여지가 없어 보이는군. 우리는 다음 공격을 기다리고 대비할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Answer_0011_AlignmentShift.Description
msgctxt "5cbe9768-3e16-4d11-87ec-174f7cb2cd97"
msgid "Supported Tristian."
msgstr "트리스티안을 지지했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Answer_0011_Text
msgctxt "84420d5b-23b3-433a-85f3-b9217c8ce963"
msgid "\"Linzi is right. You're too hard on yourself, Tristian.\""
msgstr "\"린지가 옳아. 너 자신을 너무 가혹하게 대하는거야, 트리스티안.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Answer_0013_AlignmentShift.Description
msgctxt "02364389-2617-4009-a3c6-095aa4d95c81"
msgid "Asked Tristian to focus on finding a solution to the curse."
msgstr "트리스티안에게 저주의 해결책을 찾는데 집중하라고 했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Answer_0013_Text
msgctxt "30b42fdb-c49a-49e9-84f0-a41ca004db69"
msgid ""
"\"You should focus on solving the problem, Tristian, rather than blaming "
"yourself.\""
msgstr "\"자신을 탓하기보다는 문제를 해결하는 데 집중해야 해, 트리스티안.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Answer_0015_AlignmentShift.Description
msgctxt "3924fbd6-7f8d-4e34-bc95-be9759defba7"
msgid "Accused Tristian of laziness in handling the curse."
msgstr "트리스티안이 저주를 다루는데 게으름을 피웠다고 비난했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Answer_0015_Text
msgctxt "077d2ce6-8436-4779-a10c-89f4ded853f6"
msgid ""
"\"You're idling, Tristian. Your negligence is only helping the curse defeat "
"us.\""
msgstr "\"트리스티안, 빈둥거리고 있군. 태만은 저주가 우리를 이기도록 도와주는거나 다름없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Cue_0001_Text
#. Speaker : Tristian_Companion
msgctxt "96b2f47c-ebdd-47e9-9df9-bff12a2f7b46"
msgid ""
"{n}Tristian's face glows with happiness.{/n} \"We made it! The second cursed "
"attack was repelled, and the grateful citizens of the barony have a special "
"reward for you!\""
msgstr ""
"{n}트리스탄의 얼굴은 기쁨으로 달아오릅니다.{/n} \"저희가 해냈습니다! 두번째 저주를 막아냈어요.게다가 감사를 느끼는 남작령의 "
"시민들이 기부금을 전달했습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Cue_0002_Text
#. Speaker : Tristian_Companion
msgctxt "307ed4f7-3c47-4c58-b1f9-47f0b5c8ff35"
msgid ""
"\"The second attack is over. It wasn't easy, but the barony endured it – "
"thanks in great part to the strength and bravery of your subjects. After "
"surviving this cycle of assaults, they are not easily caught off guard. It's "
"a relief, but I don't think it's something we should necessarily be "
"celebrating."
msgstr ""
"\"두번째 공격은 끝났습니다. 쉽지는 않았지만 남작령은 이겨냈습니다. 영주님의 백성들이 용감하게 싸운 덕분이죠. 이 공격에서 "
"살아남았으니, 백성들은 이제 쉽게 당하지 않을 겁니다. 안심이 되지만 마냥 기뻐할 일도 아닙니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Cue_0003_Text
#. Speaker : Tristian_Companion
msgctxt "f74556bf-c68d-46f8-a84d-b0eae4a6152b"
msgid ""
"\"The second attack was especially brutal. With great difficulty, your "
"subjects managed to fight off the invasion of wild beasts. Many perished... "
"I pray Sarenrae accepts their souls.\""
msgstr ""
"\"이 두번째 공격은 특히나 참혹했습니다. 크나큰 어려움 끝에, 영주님의 백성들은 야생동물들을 막아냈습니다. 많은 이들이 목숨을 "
"잃었죠... 서렌레이께서 그들의 영혼을 거두어 주셨기를.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Cue_0005_Text
#. Speaker : Tristian_Companion
msgctxt "d72e7fbd-2376-4870-8909-32a07b619625"
msgid ""
"{n}Tristian looks at you thoughtfully and sighs.{/n} \"Unfortunately, I must "
"bring you bad news again. The Bald Hilltop lays silent for the moment, but "
"another attack is certain to come soon."
msgstr ""
"{n}트리스티안은 당신을 골똘히 바라보고는 한숨을 내쉽니다.{/n} \"불행히도, 저는 또 나쁜 소식을 전해드려야 합니다. 민둥 "
"언덕머리는 한동안 잠잠하겠지만, 또다른 공격이 곧 닥칠 겁니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Cue_0007_Text
#. Speaker : Tristian_Companion
msgctxt "8ab129a1-9701-4a7f-861b-293a8f5feab6"
msgid ""
"Well, nothing that can help us contain it. Once every few months it drives "
"nearby animals, monsters, and other beasts insane, sending them into a "
"bloodthirsty rampage. I... don't know what action we can take on this. The "
"only way I can help is by roughly predicting when the next attack will "
"begin. Forgive me, {name}.\""
msgstr ""
"으음, 지금으로선 방도가 없습니다. 한번 시작되면 근처의 동물,괴물,짐승들을 피에 굶주리게 만들고 있어요. 어...떤 행동을 취해야 할지 "
"전혀 모르겠습니다. 대충 언제쯤 이 저주가 시작될지 알려드리는 게 고작입니다. 용서해 주십시오, {name}님.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Cue_0008_Text
#. Speaker : Linzi_Companion
msgctxt "51cc6acf-3e44-4a86-a650-d59e10127fd5"
msgid ""
"\"Don't be so hard on yourself, Tristian! Even knowing when to get ready is "
"an important thing to know! I don't know how we'd handle these attacks if "
"they happened without warning.\""
msgstr ""
"\"너무 자책하지 마요, 트리스티안! 준비해야 할 때를 아는 것도 중요한 일이니까요! 조짐을 알아보지 못했다면 달리 손쓰기도 어려웠을 "
"거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Cue_0010_Text
#. Speaker : Tristian_Companion
msgctxt "10a23adb-d81b-478a-9750-092242271249"
msgid "{n}Tristian just nods, looking down gloomily.{/n}"
msgstr "{n}트리스티안은 우울하게 아래를 보며 고개를 끄덕일 뿐입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Cue_0012_Text
#. Speaker : Tristian_Companion
msgctxt "abdb10c0-f705-4365-9199-712817cb1e91"
msgid ""
"{n}Tristian lowers his head.{/n} \"Thank you. Your support means much to me."
"\""
msgstr "{n}트리스티안이 고개를 숙입니다.{/n} \"감사합니다. 당신의 지지는 제게 큰 의미가 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Cue_0014_Text
#. Speaker : Tristian_Companion
msgctxt "2da30448-d867-44a1-a866-25e3dc0ab6bf"
msgid ""
"\"I will do everything in my power to free these lands from the curse. – I "
"promise!\""
msgstr "\"이 땅에서 저주를 몰아내기 위해 모든 힘을 다하겠습니다. 약속드리죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Cue_0016_Text
#. Speaker : Tristian_Companion
msgctxt "3b45eac1-d5be-4a1d-91f9-a948c8a618e7"
msgid ""
"{n}Tristian winces and takes a step back.{/n} \"I... forgive me. Please "
"forgive me.\""
msgstr "{n}트리스티안이 주춤거리며 뒤로 물러납니다.{/n} \"저는... 죄송합니다. 제발 용서해주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon3/Cue_0017_Text
#. Speaker : Linzi_Companion
msgctxt "2ebb1ccd-9dd0-44b5-821c-479eb68a9d80"
msgid ""
"\"I don't have anything useful to add. The locals are either oblivious to "
"the curse's origins, or they're too scared to talk. I'd be better off "
"reading ancient books on curses...\""
msgstr ""
"\"더이상 쓸만한 정보가 없어요. 지역 주민들은 정말 저주의 기원을 망각하고 있거나, 아니면 너무 무서워서 말을 못하는것 같아요. 차라리 "
"저주에 관한 고서를 읽는 게 낫겠어요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Answer_0009_Text
msgctxt "1954c011-fafb-4869-b631-b781b0225eda"
msgid "\"If this isn't a curse — then what could it be?\""
msgstr "\"저주가 아니라면 무엇이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Answer_0010_Text
msgctxt "af3ee414-1e3a-4e5a-916a-b72dd574997e"
msgid "\"I'm more interested in defeating it than understanding it.\""
msgstr "\"나는 이것에 대해 이해하기보단 극복할 방법에 흥미가 있다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Answer_0011_Text
msgctxt "b88531a4-40b4-4ca6-a25c-1af6e3df538f"
msgid ""
"\"Whoever or whatever caused these attacks, I am sure they will continue. We "
"must be ready to repel the next one.\""
msgstr "\"누구든 뭐든 공격을 했고, 또 올거라는 확신이 든다. 우리는 다음 공격을 대비해야 한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "fea6ef94-2b28-4d7c-9f88-d279ee040b58"
msgid ""
"\"Hooray! We did it! Another attack has been repelled, and the barony is "
"stronger than ever! Your grateful subjects even brought you a gift to honor "
"this outstanding success!\""
msgstr ""
"\"만세! 우리가 해냈어요! 또 다른 공격을 막아내고 영지가 더 굳건해졌어요! 신하들이 감사를 담아서 이 훌륭한 성공에 대한 선물을 "
"가져왔어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0002_Text
#. Speaker : Linzi_Companion
msgctxt "d464471f-6b3f-45a7-867f-28bc90781cf3"
msgid ""
"\"Alas, despite our best efforts, the latest assault rolled through the "
"barony like an invading empire. We did fight it off eventually, but at a "
"cost. Let's prepare better next time.\""
msgstr ""
"\"아아, 그 많은 노력들이 있었지만, 남작령에 대한 이번 공격은 마치 제국의 침공같았어요. 결국에는 우리가 이겼지만, 대가를 치뤄야 "
"했죠. 다음에는 더 단단하게 준비하자구요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0003_Text
#. Speaker : Linzi_Companion
msgctxt "e18b2e8a-d65c-4a61-b75f-7fc78f7ed7ba"
msgid ""
"\"This curse and its attacks — they're getting more and more vicious! The "
"monsters ravaged many villages and slaughtered scores of subjects. To be "
"honest, I'm not sure we'll be able to endure another one.\""
msgstr ""
"\"저주와 공격들 — 그것들이 점점 더 악화되고 있어요! 괴물들이 많은 마을들을 파괴했고 백성들을 살해했죠. 사실대로 말하자면, 다음 "
"공격이 왔을 때 우리가 버틸 수 있을지 모르겠어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0004_Text
#. Speaker : Linzi_Companion
msgctxt "bee6d9a0-8b52-46a7-af0c-3d9ce8536f81"
msgid ""
"\"Unfortunately, now is no time to rest. While everyone was preparing for "
"the last attack, I was looking for a way to overcome the curse. I read some "
"ancient books, talked to the locals... and then I had a word with our "
"Storyteller. And we decided that... Well, he'll tell it better.\""
msgstr ""
"\"유감이지만, 지금은 쉴 때가 아니에요. 지난 공격을 준비하던 동안 전 저주를 풀 방법을 찾아봤거든요. 고대의 책을 뒤져보고, 현지 사람들과도 이야기"
"해보고, 이야기꾼이랑도 얘기했죠. 그리고 우리가 내린 결론은... 음, 그가 직접 말하는 게 더 낫겠네요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0005_Text
#. Speaker : Capital_Collector
msgctxt "fc4fef12-f831-4a18-999d-3391a9ac0ce8"
msgid ""
"{n}The Storyteller clears his throat.{/n} \"I am a keeper of stories, Your "
"Grace, and I have amassed a respectable collection over my long life. There "
"are, of course, stories of curses among them — ancient and dark, having "
"taken thousands of lives, destroyed kingdoms and brought down...\""
msgstr ""
"{n}이야기꾼이 목을 가다듬습니다.{/n} \"저는 이야기의 관리자입니다. 일생동안 상당한 수집품을 모아왔습니다. 물론 그중에는 수천의 "
"목숨을 앗아가고 왕국들을 멸망시킨 고대의 어두운 저주에 관한 이야기도 있습니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0006_Text
#. Speaker : Tristian_Companion
msgctxt "7bdec1d9-5dc3-4e6f-97ef-6e8aff3b0661"
msgid "{n}Tristian turns pale.{/n} \"It's not a curse? Then what is it?!\""
msgstr "{n}트리스티안은 창백해집니다.{/n} \"저주가 아니란 말입니까? 그렇다면 이건 뭐죠?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0008_Text
#. Speaker : Linzi_Companion
msgctxt "5f8e85c7-69d4-40a6-97b8-ecbfb68d388d"
msgid ""
"\"Well, our curse isn't exactly a real curse. We think there is someone "
"specific behind these attacks! Oh, I'm sorry.\" {n}Realizing she interrupted "
"the Storyteller, Linzi turns bright red.{/n}"
msgstr ""
"\"글쎄요, 우리의 저주는 진짜 저주가 아니에요. 아마 공격 뒤에 배후가 있을거라 생각해요! 오, 죄송해요.\" {n}이야기꾼의 말을 "
"끊은 것을 깨달은 린지의 얼굴이 빨개졌습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0012_Text
#. Speaker : Linzi_Companion
msgctxt "ffcabb9b-be7b-41aa-aa45-7b11ea71f9d1"
msgid ""
"\"We don't know yet! But that part doesn't matter!\" {n}Linzi waves her hand "
"carelessly.{/n} \"What's important is that we're finally making some real "
"progress!\""
msgstr ""
"\"아직 모르겠어요! 하지만 상관없어요!\" {n}린지가 손을 마구 흔듭니다.{/n} \"중요한건 우리가 마침내 실질적인 성과를 냈다는 "
"거죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0013_Text
#. Speaker : Capital_Collector
msgctxt "3feac68e-3286-4469-8ea5-23113f60e85d"
msgid ""
"\"I would imagine that the person behind these attacks is someone harboring "
"great evil against you and your barony. I would not be surprised if it's the "
"same adversary who was behind the Bloom.\""
msgstr ""
"\"저는 이 공격의 배후가 당신과 영지에 맞서 거대한 악을 숨겨두고 있다고 추측합니다. 개화 현상의 배후와 같은 사람이라고 해도 놀랍지 "
"않을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0014_Text
#. Speaker : Linzi_Companion
msgctxt "f98cca1a-9483-4a0a-8b28-27ef871543d0"
msgid ""
"\"Pff! With swords and spells, of course! You can't chop an ancient curse to "
"bits, but I'm sure the villain behind the attacks would suffice!\""
msgstr "\"푸우! 우리 검과 마법이 있는데, 당연하죠! 우리가 저주를 없애진 못해도 뒤에 숨어있는 악당정돈 충분히 무찌를 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0015_Text
#. Speaker : Capital_Collector
msgctxt "6c692605-363e-485b-81f8-2eef5c420143"
msgid ""
"\"Linzi, I think the baron{mf||ess} is asking whether we yet know the name "
"of our adversary. Alas, the answer to that question is no, at least for now. "
"Personally, I believe it is the work of some fey. – I recognize their hand, "
"so to speak.\""
msgstr ""
"\"린지, 내 생각엔 영주님이 뒤에 숨어있는 악당이 누구인지, 우리가 알고 있는가 물어보시는 것 같구나. 아아, 그 질문에 대답은 "
"아닙니다, 적어도 지금은 말입니다. 개인적으로 페이의 소행이라고 생각됩니다. 그들의 손길이 느껴집니다, 굳이 말씀드리자면 말이지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0016_Text
#. Speaker : Linzi_Companion
msgctxt "069a80a4-4c2b-4fc8-a1c8-20c651effaff"
msgid ""
"\"That's exactly what we'll do! Sooner or later, the villain will show "
"himself. Once he slips up, we can finally punish him for all the trouble "
"he's caused!\" {n}Linzi frowns belligerently.{/n}"
msgstr ""
"\"그게 바로 우리가 해야 할 일이죠! 늦든 빠르든 악당은 모습을 드러낼 거예요. 그가 미끄러지기라도 하면, 저주로 생긴 문제에 대한 "
"책임을 물어 혼내줄 수 있을거에요!\" {n}린지가 호전적으로 찌푸립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0017_Text
#. Speaker : Tristian_Companion
msgctxt "cb84dcd0-39f3-448b-8100-6fa099d82412"
msgid ""
"{n}Tristian chuckles faintly.{/n} \"I didn't expect such vitriol from you, "
"Linzi. In any case, I would advise hearing this villain out before punishing "
"him. We still have no idea why this unknown enemy is targeting us in "
"particular.\""
msgstr ""
"{n}트리스티안은 작게 웃습니다.{/n} \"그런 독설을 할거라곤 생각도 못했는데요, 린지. 어쨌든 악당을 혼내기 전에 말을 들어볼 것을 "
"권합니다. 우리는 이 정체불명의 적이 왜 특별히 우리를 노리는지도 모르고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0018_Text
#. Speaker : Linzi_Companion
msgctxt "bc18d2a4-40a4-4212-816c-b07f1ba649e8"
msgid ""
"\"I'm sure we'll know our foe's face soon enough. We've repelled his attacks "
"three times now. He must be reaching the limits of his patience! He won't "
"get away with this forever!\""
msgstr ""
"\"우린 곧 적의 얼굴을 알게 될 거라고 확신해요. 우린 세 번이나 공격을 막아냈어요. 그는 아마 머리 끝까지 화났을 거예요! 평생 "
"도망치진 않겠죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon4/Cue_0019_Text
#. Speaker : Linzi_Companion
msgctxt "e20d2274-ccd3-4dae-8c0b-5ed2b39e076d"
msgid ""
"\"I agree! After the last attack, I got the feeling that the owlbears and "
"manticores came here as revenge for what we did to the Everblooming Flower.\""
msgstr "\"맞아요! 마지막 공격 뒤에는, 아울베어랑 만티코어가 영원히 피는 꽃의 복수를 하러 온 줄 알았다니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Answer_0014_Text
msgctxt "ccb0dea3-5756-4585-9166-9d39fdd37e57"
msgid "\"The attacks will continue?\""
msgstr "\"공격이 계속 올까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Answer_0017_TristianTruth_AlignmentShift.Description
msgctxt "9a8bf1ad-ae24-4f0f-aced-47ee13a397c6"
msgid "Assured Tristian of your support."
msgstr "트리스티안에게 당신이 도울것을 약속했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Answer_0017_TristianTruth_Text_String
msgctxt "dcbc9e67-f039-43bd-8889-53c2ba719056"
msgid ""
"\"Tristian, I will help you earn forgiveness. Together we will defeat "
"Nyrissa.\""
msgstr "\"트리스티안, 속죄를 하도록 도와줄게. 우린 함께 나이리사를 물리칠 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Answer_0018_TristianTruth_AlignmentShift.Description
msgctxt "921eeca4-605f-411c-8078-abc5113c0e99"
msgid "Advised Tristian to let go of his past mistakes."
msgstr "트리스티안이 과거의 실수를 털어버리도록 조언했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Answer_0018_TristianTruth_Text_String
msgctxt "6676f715-d10e-47be-bdf7-d1a5df9a9f6d"
msgid "\"Forget about your past mistakes, Tristian. Focus on your future!\""
msgstr "\"과거의 실수는 잊어버려, 트리스티안. 미래에 집중해!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Answer_0019_TristianTruth_AlignmentShift.Description
msgctxt "b03f6f73-ae61-46da-a7da-723feb6078d9"
msgid "Threatened Tristian with execution if he fails to redeem himself."
msgstr "트리스티안이 스스로를 용서할 수 없다면 처형할 것이라 위협했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Answer_0019_TristianTruth_Text_String
msgctxt "9609f7b3-68ea-4319-abcb-a553927c4148"
msgid ""
"\"You'd better work hard to atone for your mistakes, Tristian – unless you "
"want to beg for my executioner's forgiveness.\""
msgstr "\"내 사형집행인이 직접 속죄를 도와주기 전에 열심히 일을 해야 할거야, 트리스티안.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Answer_0020_Text
msgctxt "f66bbf92-277e-4ff2-a3b3-1c9f7e7384e0"
msgid ""
"\"We will prepare for the next attack. It doesn't matter who's behind it. We "
"won't let them win.\""
msgstr "\"누가 배후에 있든 간에 우리는 다음 공격을 대비할 것이다. 마음대로 하게 둘 수는 없지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0001_Text
#. Speaker : Capital_Collector
msgctxt "c61c9d54-bb58-451d-9032-1bc702a6eb33"
msgid ""
"\"A new day, and a fresh victory, {mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}! Another attack has been repelled, and your grateful subjects "
"have a special reward for you.\""
msgstr ""
"\"새로운 하루, 새로운 승리로군요, 전하! 공격을 또 다시 막아냈습니다. 게다가 백성들이 고마움의 표시로 선물을 보내왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "9b8a7889-3a37-4f7c-9081-a74474dece39"
msgid ""
"\"The fey who attacked you did significant damage to your "
"{mf|barony|barony|kingdom|kingdom}, {mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}. Through the great efforts of yourself and your subjects, the "
"attackers were defeated. Those who were not killed on the battlefield fled "
"to shelter in the nearby forests. We've earned a well-deserved respite.\""
msgstr ""
"\"당신을 공격한 페이는 분명 당신의 {mf|남작령|남작령|왕국|왕국}에 큰 피해를 입혔습니다, {mf|영주님|영주님|전하|전하}. "
"당신과 백성들 모두 최대한의 노력을 기울였고, 격퇴할 수 있었습니다. 전장에서 죽이지 못한 것들은 근처의 숲으로 도망쳐 들어갔습니다. "
"이제 한숨 돌리실 수 있으실 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0003_Text
#. Speaker : Capital_Collector
msgctxt "9b403382-d88b-4b64-8734-f0d561e11fdf"
msgid ""
"\"The fey who attacked you did significant damage to your "
"{mf|barony|barony|kingdom|kingdom}, {mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}. Your subjects were left to fend for themselves or flee, and "
"some of the villages have been reduced to rubble. In others there are "
"nothing but empty houses. Entire families have abandoned the "
"{mf|barony|barony|kingdom|kingdom} for safer lands.\""
msgstr ""
"\"당신을 공격한 페이는 분명 당신의 {mf|남작령|남작령|왕국|왕국}에 큰 피해를 입혔습니다, {mf|영주님|영주님|전하|전하}. "
"당신의 남겨진 백성들은 스스로를 지키거나 도망치는데 급급했고, 몇몇 마을은 산산조각났습니다. 몇몇 마을에는 빈 집밖에 남지 않았습니다. "
"주민들이 전부 더 안전한 땅을 찾아 {mf|남작령|남작령|왕국|왕국}을 떠난겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0004_Text
#. Speaker : Linzi_Companion
msgctxt "e7c71411-94c8-4f64-a447-1840521c1aab"
msgid ""
"{n}Linzi gives you an oddly serious look.{/n} \"Well, we know who was behind "
"the attacks. It was Tristian, wasn't it?\""
msgstr ""
"{n}린지가 당신에게 이상하게 진지한 눈길을 향합니다.{/n} \"음, 우리 모두 공격의 배후가 누구인지 잘 알죠. 트리스티안이죠, "
"그렇죠?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0005_TristianTruth_Text_String
#. Speaker : Linzi_Companion
msgctxt "c3a5e511-aad5-46d3-8f7f-61c28bd5de9e"
msgid ""
"{n}Linzi gives Tristian an oddly serious look.{/n} \"It was you who was "
"behind the attacks, wasn't it? But... why?\""
msgstr "{n}린지가 트리스티안을 진지한 눈길로 바라봅니다.{/n} \"공격의 배후는 바로 당신이었죠, 안그래요? 그치만...어째서?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0006_Text
#. Speaker : Linzi_Companion
msgctxt "c4b6040b-cc20-4217-99b6-5013d81ac98a"
msgid ""
"\"I can't wait to see Tristian again – and ask him all the questions that "
"are swimming in my head. Why did he betray us? He was so gentle and kind. We "
"were friends!\""
msgstr ""
"\"트리스티안을 만날 날이 기대되네요. 제 머리를 뱅뱅 도는 의문을 쏟아 내고 싶어 죽겠어요. 왜 우리를 배신한 걸까요? 그렇게나 "
"친절하고 상냥했는데. 우린 친구였다고요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0007_Text
#. Speaker : Linzi_Companion
msgctxt "278944de-b977-498a-b9ea-52df0d1c41a7"
msgid ""
"\"He was so soft and kind... He was our friend. My mind is telling me he's a "
"traitor, and we did the right thing to get rid of him. But my heart doesn't "
"want to believe it. I... I miss him.\""
msgstr ""
"\"트리스티안은 부드럽고 온화했어요. 우리의 친구였다고요. 머리로는 트리스티안이 배신자니까 제거하는 것이 옳은 일이라고는 생각해요. "
"하지만 마음으로는 그 사실을 믿고 싶지 않아요. 트리스티안이 그... 그리워요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0008_Text
#. Speaker : Capital_Collector
msgctxt "062e8e94-695b-460d-bb8c-b3d0e2a8c064"
msgid ""
"{n}The Storyteller's voice is quiet but firm.{/n} \"In any case, I doubt "
"that Tristian's absence will in any way prevent the next attack.\""
msgstr ""
"{n}이야기꾼의 말은 조용하지만 힘이 들어가 있습니다.{/n} \"어찌됐든, 트리스티안의 부재가 이 상황을 해결할 것이라는 생각은 들지 "
"않는군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0009_TristianTruth_Text_String
#. Speaker : Tristian_Companion
msgctxt "1d261e1b-b466-4458-8ffd-2905073ea38b"
msgid ""
"{n}Tristian drops his head limply.{/n} \"Yes. At least, to a certain extent. "
"My... lady...\" {n}Tristian's lips curve scornfully.{/n} \"Nyrissa ordered "
"me to open the way for creatures from the {g|First World}First World{/g}. "
"I've often traveled between worlds, so it was not a difficult thing to do.\""
msgstr ""
"{n}트리스티안이 고개를 푹 떨굽니다.{/n} \"맞습니다. 적어도 어느 정도는 맞는 말입니다. 그... 분은...\" {n}트리스티안의 "
"말투가 경멸적으로 변합니다.{/n} \"나이리사는 {g|First World}태초 세계{/g}의 포탈을 열도록 저에게 명령을 내렸습니다. "
"괴물들을 보내기 위해서 말이죠. 차원간의 이동은 저의 특기였으니, 그다지 어려운 일은 아니었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0011_TristianTruth_Text_String
#. Speaker : Tristian_Companion
msgctxt "245e160a-2987-4edf-a903-487ede67c05a"
msgid ""
"\"{g|Golarion}Golarion{/g} is closely connected to the First World. "
"Spontaneous portals between the two worlds are not uncommon. – All I did was "
"give one such portal some extra stability. Once every few months it opened "
"wide enough to allow Nyrissa's creatures to come charging through.\""
msgstr ""
"\"{g|Golarion}골라리온{/g}은 태초 세계와 가장 밀접한 차원입니다. 가끔 자연적으로 두 차원 사이에 포탈이 열리는 경우도 "
"있습니다. 제가 살짝 손을 대기만 해도 충분했지요. 몇달이 지나자, 나이리사의 괴물들이 뚫고 나올만큼 커다란 포탈이 대규모로 "
"생성되었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0012_TristianTruth_Text_String
#. Speaker : Tristian_Companion
msgctxt "e6164efc-3cda-4046-b8f4-7ffc014d3cb0"
msgid ""
"\"What I did was terrible. People were dying all the time – because of me! "
"And I could do nothing but warn them of the next attack. I mourn the losses "
"every day. My only hope is that one day I will be able to make up for these "
"evil acts.\""
msgstr ""
"\"제가 한 짓은 끔찍했습니다. 저 때문에 사람들이 계속 죽어나갔죠! 제가 할 수 있는 일이라고는 경고밖에 없었습니다. 매일 죽은 이들을 "
"위해 애도했습니다. 이 사악한 행위에 대한 속죄를 하루 빨리 갚아 나갈 수 있기만을 바랄뿐입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0013_Text
#. Speaker : Capital_Collector
msgctxt "46578834-411b-4a8f-ac41-b9a9a4956f4b"
msgid ""
"{n}The Storyteller's voice is quiet but firm.{/n} \"In any case, I doubt "
"that Tristian's repentance will somehow prevent the next attack.\""
msgstr ""
"{n}이야기꾼의 말은 조용하지만 힘이 들어가 있습니다.{/n} \"어찌됐든, 트리스티안의 후회가 이 상황을 바꿀 것이라는 생각은 들지 "
"않는군요..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0015_Text
#. Speaker : Tristian_Companion
msgctxt "1ceb0e65-5c6a-49ab-8480-9aaa9bc7b7e7"
msgid ""
"\"As with the Everblooming Flower, I only helped Nyrissa open a portal from "
"the First World to Golarion. I am not the one leading her armies.\""
msgstr "\"저는 영원히 피는 꽃과 포탈에 관련해서만 힘을 빌려줬습니다. 나이리사의 군대를 이끌고 있는 자는 제가 아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0016_Text
#. Speaker : Capital_Collector
msgctxt "15290d76-ca62-4b98-8bef-a92093cb62f6"
msgid ""
"\"I seriously doubt that Tristian was the one behind the attacks. I said "
"before that I detected the magic of the fey, and I remain sure of it. I "
"think Tristian was only an accessory to our true foe.\""
msgstr ""
"\"저는 트리스티안이 공격의 배후에 있는 자들 중 하나였다고 확신합니다. 페이의 마법을 발견하기 전에도 한 번 말했었고, 지금도 그 "
"생각은 변함이 없습니다. 트리스티안은 우리의 숙적에게 놀아난 것으로 보입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0021_TristianTruth_Text_String
#. Speaker : Tristian_Companion
msgctxt "6c7d282e-eeb6-42ad-9602-f06fa9b16da1"
msgid ""
"\"I don't deserve your help… But as Sarenrae is my witness, I am eternally "
"grateful to you!\""
msgstr "\"저한테 당신의 도움을 받을 자격이 있을지 모르겠군요... 하지만 서렌레이께서 함께해주시는 한, 영광으로 여기겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0022_TristianTruth_Text_String
#. Speaker : Tristian_Companion
msgctxt "8ebc6e7e-31ee-455c-b87c-eee879629433"
msgid ""
"{n}Tristian chuckles joylessly.{/n} \"That is not as easy as it seems. My "
"mistakes will stay with me to the end of my days. But I refuse to spend my "
"time wallowing in despair. — I will dedicate myself to repairing what I've "
"done!\""
msgstr ""
"{n}트리스티안은 감정없이 웃습니다.{/n} \"보셨던 대로 쉬운 일이 아니었습니다. 제 실수는 제가 죽을때까지 따라다니겠죠. 하지만 "
"저는 절망에 빠져있는데 시간을 허비하고 싶지 않습니다. — 저는 제 실수를 바로잡겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0023_TristianTruth_Text_String
#. Speaker : Tristian_Companion
msgctxt "b9bfde4f-60e7-4672-a46a-92bf429745e9"
msgid "{n}Tristian turns even paler, but answers with a determined nod.{/n}"
msgstr "{n}트리스티안은 훨씬 더 창백해졌지만, 결심한듯 고개를 끄덕입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon5/Cue_0024_Text
#. Speaker : Capital_Collector
msgctxt "bbc4cb1f-dc0e-46fb-97fe-892a84537ffc"
msgid ""
"{n}The Storyteller nods.{/n} \"I am sure of it. Your "
"{mf|barony|barony|kingdom|kingdom} is far stronger than your enemies "
"imagine. – As you remind them from time to time.\""
msgstr ""
"{n}이야기꾼이 끄덕인다.{/n} \"물론이지요. 전하의 영지는 적의 상상보다 훨씬 강대합니다. 차차 놈들도 깨닫게 되겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Answer_0010_Text
msgctxt "7bb67c5c-a048-417f-96fc-11e5588efb83"
msgid ""
"\"How soon until Nyrissa is able to bring the full power of her army down "
"upon us?\""
msgstr "\"나이리사가 언제쯤 우리한테 총력을 쏟을까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Answer_0011_AlignmentShift.Description
msgctxt "6e19a8d5-3be6-4746-8400-7ca3bf7b9092"
msgid "Assured Tristian of your support."
msgstr "트리스티안에게 당신이 도울것을 약속했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Answer_0012_AlignmentShift.Description
msgctxt "44b9ece2-d8dd-4b0f-b442-b7f6405ea97a"
msgid "Advised Tristian to let go of his past mistakes."
msgstr "트리스티안이 과거의 실수를 털어버리도록 조언했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Answer_0013_AlignmentShift.Description
msgctxt "188c63c7-f8c3-446e-a624-533a6b1fd93f"
msgid "Threatened Tristian with execution if he fails to redeem himself."
msgstr "트리스티안이 스스로를 용서할 수 없다면 처형할 것이라 위협했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Answer_0014_Text
msgctxt "4ce5b05f-8af7-4b43-87e6-05a38fe915a6"
msgid "\"We must prepare for Nyrissa's next attack.\""
msgstr "\"우리는 나이리사의 다음 공격을 대비해야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Answer_0021_Text
msgctxt "bd40b47d-850a-449c-863f-3a55b84ffede"
msgid "\"Why do you think the attacks keep getting more dangerous?\""
msgstr "\"왜 이 사태가 더 위험해질 거라 생각하지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Answer_0025_Text
msgctxt "582eafee-66b9-491b-9246-b73994871089"
msgid ""
"\"Can we use the portal on the Bald Hilltop to get to the First World and "
"battle Nyrissa?\""
msgstr "\"민둥 언덕마루의 포탈을 이용해서 태초세계로 넘어가 나이리사와 싸울 수 있을까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Cue_0001_Text
#. Speaker : Capital_Collector
msgctxt "faf47551-3b10-462d-950d-8e51c4bead87"
msgid ""
"\"No matter what curses the denizens of the First World cast upon you, no "
"matter what cruel tactics they use, you repel them all with valor! Bravo, "
"Your Highness. Accept this humble gift as a sign of gratitude from your "
"subjects.\""
msgstr ""
"\"태초 세계 생물들의 전략이나 저주에도 상관없이, 또 다시 이들을 용맹스럽게 격퇴하셨습니다! 전하, 백성들이 모아온 이 선물을 "
"받아주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "63644296-0e5b-4c25-88cf-9b0e28a9a05e"
msgid ""
"\"The attacks on your kingdom grow more and more brutal, and increasingly "
"harder to repel. Fortunately we stood our ground again, but will we be able "
"to keep it up?\""
msgstr ""
"\"왕국을 향한 공격이 점점 더 거세지고, 격퇴도 어려워지고 있습니다. 다행히도 우리는 또 한 번 견뎌냈지만, 그게 언제까지고 계속될 수 "
"있겠습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Cue_0003_Text
#. Speaker : Capital_Collector
msgctxt "d56ddfca-7fe3-411b-bdfa-950b3a955ac2"
msgid ""
"\"The attacks on your kingdom grow more and more brutal, and increasingly "
"harder to repel. I have a feeling that we're just biding our time until the "
"end.\""
msgstr ""
"\"왕국을 향한 공격이 점점 더 거세지며, 격퇴도 어려워지고 있습니다. 저는 저희 모두가 끝장날 때까지 버티기만 하고 있다는 느낌이 "
"듭니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Cue_0004_Text
#. Speaker : Linzi_Companion
msgctxt "866fa257-2145-4ab8-b34a-cd23592a1d44"
msgid ""
"{n}Linzi chuckles carelessly.{/n} \"Whatever Nyrissa has planned, I'm sure "
"we can handle it. Each of her attacks is stronger than the last, but we're "
"getting stronger too!\""
msgstr ""
"{n}린지가 격식없이 싱긋 웃습니다.{/n} \"나이리사가 무엇을 계획하던, 우리가 이겨낼 거라 확신해요, 그녀의 공격이 전보다 계속 "
"강해지고 있지만, 우리도 점점 강해지고 있잖아요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Cue_0018_Text
#. Speaker : Capital_Collector
msgctxt "ca4db7f0-634f-4105-9134-30f7469f16b7"
msgid ""
"\"I'd assume her strength has nearly reached its peak. We might not be there "
"yet, but the next assault will surely be especially dangerous.\""
msgstr "\"제 식견으로는 현재 나이리사의 힘은 거의 절정에 달했습니다. 아직 완전하지는 않지만 다음 공격은 특히나 더 위험하겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Cue_0019_Text
#. Speaker : Linzi_Companion
msgctxt "31d5e3d7-75c2-4407-a421-495c5ac648d1"
msgid ""
"\"We will prepare well! Just let her try to come at us again! — We'll beat "
"her back to where she came from! I'll cap our victory by writing a song "
"about her, a really funny and embarrassing one! Everyone in the First World "
"will be singing it for her!\""
msgstr ""
"\"만반의 준비를 했으니, 공격할 테면 해보라고 해요! 우리가 한방 먹여줄 테니까! 이기면 나이리사에 관한 노래를 한 곡 지어야겠어요! "
"아주 웃기고 굴욕적인 내용이 될 거예요. 나이리사의 패배를 축하하는 노래가 온 태초 세계에 울려 퍼지겠죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Cue_0020_Text
#. Speaker : Tristian_Companion
msgctxt "f07520f2-81ae-4e8e-91a1-25223d024ff8"
msgid ""
"{n}Tristian's whisper is barely audible.{/n} \"In any case, it won't be "
"long...\""
msgstr "{n}트리스티안은 작은 목소리로 말합니다.{/n} \"어찌되었든, 이 사태는 오래가지 못할 겁니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Cue_0022_Text
#. Speaker : Linzi_Companion
msgctxt "9c5b449c-bc1e-4837-8855-11cc7a8fa707"
msgid ""
"\"I think Nyrissa has been playing with us! If she attacked at full strength "
"a few years ago, when the barony of {kingdomname} was still in the cradle, "
"we couldn't possibly have endured. I bet she still needed to keep us alive "
"for something. But now that we've lost our usefulness, she's decided to "
"finish us off.\""
msgstr ""
"\"제 생각에는 나이리사가 우릴 갖고 논 것 같아요! {kingdomname} 남작령이 막 생겼을 때 전력으로 쳐들어 왔다면, 우린 "
"버티지 못했을 거예요. 그동안은 우릴 살려둘 필요가 있었나 봐요. 더 이상 필요하지 않으니, 이제 끝장을 내려는 거죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Cue_0023_Text
#. Speaker : Capital_Collector
msgctxt "6a02e19e-5294-4b78-b8c5-d4b38039a715"
msgid ""
"\"I have a different theory. This 'curse' from the Bald Hilltop is an "
"unstable portal, a bridge between {g|Golarion}Golarion{/g} and the {g|First "
"World}First World{/g}. And the more it is used, the more firmly anchored it "
"becomes, which allows Nyrissa to send through more and more powerful armies."
"\""
msgstr ""
"\"제 의견은 조금 다릅니다. 민둥머리 언덕의 '저주'는 {g|Golarion}골라리온{/g}과 {g|First World}태초 "
"세계{/g}를 연결하는 불안정한 포탈입니다. 쓰면 쓸수록 안정됨으로써 나이리사가 점점 강력한 대군을 많이 보낼 수 있게 된 것이죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Cue_0024_Text
#. Speaker : Tristian_Companion
msgctxt "532118d9-09c6-41e5-9907-5e853b443c73"
msgid ""
"\"I think both of you are right. The stability of the portal does play an "
"important role in the increasing power of Nyrissa's attacks. However, it is "
"true that she allowed the barony of {kingdomname} to get on its feet — at "
"least when it was newly formed.\""
msgstr ""
"\"아마 두 분 다 맞으실 겁니다. 포탈의 안정성은 나이리사의 공격에 중요한 역할을 합니다. 그러나, 나이리사가 {kingdomname} "
"남작령이 막 생겼을 때 자립하도록 내버려 두었다는 것도 사실이지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Cue_0026_Text
#. Speaker : Capital_Collector
msgctxt "70ebcb75-0ffa-4ed0-bdb9-c0abaff36075"
msgid ""
"\"Alas, not yet. The passage between worlds is not reliable. We can't be "
"sure of where it will take us, or if it will activate at all. Such is the "
"nature of unstable First World portals.\""
msgstr ""
"\"아뇨, 아직입니다. 그 포탈은 신뢰할 수 없습니다. 잘 작동할지도, 어디로 갈지도 장담할 수 없습니다. 자연적으로 생겼기 때문인지, "
"태초 세계의 포탈은 아주 불안정합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Cue_0027_Text
#. Speaker : Tristian_Companion
msgctxt "2bc69ae0-7671-4aec-a656-fb7f6f418e93"
msgid ""
"\"Such a portal is unreliable even for denizens of the First World. We only "
"see a small portion of the hordes that Nyrissa sends through the portal to "
"attack us. Nyrissa... doesn't care what happens to the countless who go "
"missing.\""
msgstr ""
"\"그러한 포탈은 태초 세계의 주민들에게도 신뢰할 수 없는 통로입니다. 나이리사가 공격을 명령한 병력들 중 극히 일부만이 골라리온에 "
"도착합니다. 나이리사는... 얼마나 많은 병력이 차원 틈사이로 사라져도 개의치 않죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon6/Cue_0028_Text
#. Speaker : Capital_Collector
msgctxt "012c2f33-ea8d-4abe-8166-b721ba43539e"
msgid ""
"\"However, with each attack the portal becomes more and more stable. I would "
"imagine that soon the passage will become a steady bridge between Golarion "
"and the First World. We only need to wait for that moment to attack.\""
msgstr ""
"\"그렇다고는 하지만, 공격을 해올 때마다 점점 포탈이 안정되고 있습니다. 머지 않아 그 포탈은 골라리온과 태초 세계를 잇는 튼튼한 "
"다리가 되어 주겠지요. 저희가 할 수 있는 일이라곤 그 순간이 올 때까지 기다리는 것뿐입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Answer_0008_Text
msgctxt "93ee04a5-ab07-4745-9439-1bfb6642384f"
msgid ""
"\"Can we use the portal on the Bald Hilltop to get to the First World?\""
msgstr "\"민둥 언덕마루의 포탈을 이용해서 태초 세계로 갈 수 있을까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Answer_0011_Text
msgctxt "dc489a82-5a80-4d6e-9ff7-15b4bd7b59bc"
msgid "\"In any case, first we will have to repel the attack.\""
msgstr "\"어찌됐든, 우리가 먼저 할 것은 공격을 막아내는 일이군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Answer_0013_Text
msgctxt "45aaae2a-0916-4353-afb9-7fcd8bda4d62"
msgid "\"Do you think Nyrissa will appear personally to command the attack?\""
msgstr "\"나이리사가 공격을 전두지휘하기 위해 나타날거라 생각하나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Answer_0015_Text
msgctxt "7a2376ab-95e5-4cef-9116-4a42f7c9f05c"
msgid "\"Are you sure this attack will be the Last?\""
msgstr "\"이번 공격이 마지막일 거라 확신하나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Cue_0001_Text
#. Speaker : Capital_Collector
msgctxt "25541b1d-a453-4d94-abbd-515cf42573ad"
msgid ""
"\"Your Highness, the Wild Hunt has been defeated! Your quick and effective "
"actions left the attackers no hope. Your grateful subjects would like to "
"present you with this humble gift.\""
msgstr ""
"\"전하, 와일드 헌트를 물리쳤습니다! 당신의 빠르고 효과적인 판단은 공격자들에게 어떤 희망도 주지 않았습니다. 백성들이 고마움의 표시로 "
"자그마한 선물을 보내왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "acea2fe3-7595-46f1-ace2-0e37f62ca827"
msgid ""
"\"Your Highness, after sustained fighting, the Wild Hunt has finally "
"retreated. We were successfully able to protect the kingdom, but the price "
"we paid was dear. Still, our victory gives me hope.\""
msgstr ""
"\"전하, 지속되는 전투 끝에, 와일드 헌트가 끝내 물러났습니다. 우리는 왕국을 보호하는데 성공했지만, 지불된 대가 또한 만만치 "
"않습니다. 그래도, 우리 승리는 제게 희망을 보여줍니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Cue_0003_Text
#. Speaker : Capital_Collector
msgctxt "18ccc901-3b2c-400a-859e-23ff802fb770"
msgid ""
"\"Your Highness, the Wild Hunt ravaged your kingdom with fire and sword. "
"With great difficulty we managed to repel them, but the losses we suffered "
"were tremendous. I shudder to imagine what the next attack might bring.\""
msgstr ""
"\"전하, 와일드 헌트 무리가 당신의 왕국을 불과 칼로 파괴했습니다. 공격을 저지하기 위한 저희 노력은 결코 작은것이 아니었지만, 이 "
"패배로 인해 매우 큰 손실을 겪게 되었습니다. 다음 번 공격은 얼마나 끔찍할지 상상하니 몸서리가 쳐지는군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Cue_0004_Text
#. Speaker : Capital_Collector
msgctxt "41e8e272-a0d1-4378-bdc3-de8f45015373"
msgid ""
"\"Another attack awaits, though I doubt it will come soon. I have a feeling "
"that Nyrissa won't hold back this time. It will be the most terrible blow "
"yet. I only hope we can survive it!\""
msgstr ""
"\"가까운 시일 내로 또 다른 공격이 기다리고 있습니다. 이번에는 나이리사가 가만히 있지 않을거란 느낌이 듭니다. 이제껏 왔던 것 중 "
"가장 강한 공격일거라 예상됩니다. 견뎌낼 수 있으면 좋겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Cue_0005_Text
#. Speaker : Tristian_Companion
msgctxt "a6c95304-f7e2-4d2e-a9a4-e2b17451035f"
msgid ""
"\"I agree with the Storyteller. I've visited the Bald Hilltop, and the "
"portal to the First World is almost stable. It appears that by the time of "
"the next attack, it will be steady enough to become a permanent bridge "
"between Golarion and the First World.\""
msgstr ""
"\"이야기꾼에게 동의합니다. 지속적으로 민둥 언덕마루에 방문해온 결과, 태초 세계와 연결된 포탈이 거의 안정화된 것으로 보입니다. 다음 "
"공격이 시작될 쯤이면 충분히 안정되어 영구히 골라리온과 태초 세계를 잇는 다리가 될겁니다. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Cue_0006_Text
#. Speaker : Linzi_Companion
msgctxt "f5b233dd-5dd4-41ca-ad2a-d327468fcfbc"
msgid ""
"\"The way I see it, we've had enough of being afraid of her! If Nyrissa "
"wants to attack us herself — then let her come! But she won't, will she? "
"She's going to hide from us, tucked away in the First World until the bitter "
"end! I suggest we deal with her army here, and then move immediately to "
"counter-attack! – Before she musters the strength for another invasion!\""
msgstr ""
"\"제가 보기엔, 우리가 이제 그녀의 공포를 끝낼 때가 된 것 같아요! 나이리사가 이 공격을 스스로 원한다면 — 오게 두세요! 하지만 "
"그녀는 오지 않겠죠, 그렇지 않나요? 그녀는 우리에게서 도망치겠죠, 씁쓸하게 최후를 맞는 날까지 태초 세계에 숨기나 하면서요! 저는 "
"여기서 그녀의 군대를 처리한 다음, 곧장 반격을 개시하는 게 좋을 것 같아요! – 다음 공격을 위해 힘을 모으기 전에요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Cue_0009_Text
#. Speaker : Capital_Collector
msgctxt "6eed18ff-ded3-4bf8-9508-faccc5325acd"
msgid ""
"\"I suppose so. The portal used to snap shut after every attack, but by now "
"it should be a reliable passage to the First World. It probably leads "
"directly to Nyrissa's lair, wherever that may be!\""
msgstr ""
"\"저도 동의합니다. 이제껏 모든 공격 뒤에 포탈이 닫혀왔지만, 이제는 태초 세계로 도달하는 안정적인 경로가 되었습니다. 태초 세계 "
"어디에 있던지, 나이리사의 소굴로 곧장 이어질겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Cue_0010_Text
#. Speaker : Tristian_Companion
msgctxt "43a7d690-fb51-4a76-9dfc-6248e284e426"
msgid ""
"{n}Tristian's face is determined.{/n} \"I agree with your plan. We will "
"enter the portal I helped create, and end the war I helped begin.\""
msgstr ""
"{n}트리스티안의 표정에서 결의가 보입니다.{/n} \"당신의 계획에 동의합니다. 저희는 제가 관여한 포탈을 통해 들어가서, 제가 시작을 "
"도운 전쟁을 끝낼겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Cue_0012_Text
#. Speaker : Capital_Collector
msgctxt "84120e5e-3096-4c31-80af-18e4d799693d"
msgid ""
"{n}The Storyteller nods gravely.{/n} \"This will be a difficult battle. We "
"shouldn't underestimate the enemy — especially one as cunning as Nyrissa.\""
msgstr ""
"{n}이야기꾼이 엄숙히 동의합니다.{/n} \"힘든 싸움이 될겁니다. 적들을 과소평가하셔서는 안됩니다 — 나이리사같이 간악한 자라면 특히 "
"그렇죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Cue_0014_Text
#. Speaker : Linzi_Companion
msgctxt "4fb2f55e-c6d1-463b-9bf8-f1e474535040"
msgid ""
"\"I bet she won't. It isn't her style. She likes just watching from a "
"distance while she plans her next insidious trick. But I think she's just "
"plain afraid of us!\""
msgstr ""
"\"그러진 않을 거예요. 그건 그녀 방식이 아니니까요. 그녀는 다음에 쓸 음흉한 속임수를 계획하면서 거리를 두고 지켜보는걸 선호해요. "
"하지만 그녀도 이젠 우리를 제대로 무서워할걸요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Cue_0016_Text
#. Speaker : Capital_Collector
msgctxt "3be652f4-7143-4499-9571-2739e2b5734f"
msgid ""
"\"When you deal with the fey, you can't be sure of anything. My guess, "
"however, is based more in fact than speculation. Never before has there been "
"a portal to the First World that is so stable…\""
msgstr ""
"\"페이의 문제를 처리하는 동안, 당신은 아무것도 확신할 수 없었을 겁니다. 하지만, 제 추론은 예측보다는 사실에 더 기반을 두고 "
"있습니다. 태초 세계로의 포탈이 이만큼이나 안정되었던 적은 지금껏 없었습니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon7/Cue_0017_Text
#. Speaker : Linzi_Companion
msgctxt "67a1ebfe-5edf-421c-a42e-e4abab9049a9"
msgid ""
"\"We've also cornered Nyrissa like never before! I'm bet she's absolutely "
"beside herself!\""
msgstr "\"나이리사도 더 이상 걱정할 필요가 없겠죠! 그녀도 완전 제정신이 아닐테니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Answer_0008_Text
msgctxt "f2a891a4-c14b-40fd-a77a-2ef8678fb54e"
msgid ""
"\"Tristian, you helped Nyrissa open portals to Golarion. Can you open a "
"portal to the First World?\""
msgstr ""
"\"트리스티안, 너는 나이리사가 골라리온으로 통하는 포탈을 열 수 있도록 도왔지. 너도 태초 세계로 향하는 포탈을 열 수 있나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Answer_0010_Text
msgctxt "b81fbba0-fd8b-4375-8156-2ef1f740cc84"
msgid ""
"\"Nyrissa deserves a thousand executions after all she's done to my kingdom. "
"And I will be there to carry out her sentence personally.\""
msgstr ""
"\"나이리사가 나의 왕국에 한 짓을 생각한다면 천 번을 죽여도 모자라다. 그러니 난 그녀의 형벌을 집행하기 위해 찾아갈 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Answer_0011_Text
msgctxt "27c1b96e-f50f-4960-9f22-dc33b5d8f321"
msgid ""
"\"Creating a portal, hiding behind the myth of a nonexistent ancient "
"curse... Nyrissa is cunning! I would applaud her, if we weren't sworn "
"enemies.\""
msgstr ""
"\"포탈을 만들고, 존재하지도 않는 고대의 저주같은 이야기 뒤에 숨고... 나이리사는 교활하구나! 나의 적이 아니었다면 그녀에게 찬사를 "
"보냈을 것 같군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Answer_0012_Text
msgctxt "4e236b89-63d4-4e9a-935c-56b48a83589f"
msgid ""
"\"Ha! All the forces she sent to challenge me have failed. I can't wait to "
"meet her. – I'll see her bathing in her own blood."
msgstr ""
"\"하! 그녀가 내게 도전하려고 시도한 모든 공격들이 실패했다. 더는 그녀를 만나는 걸 기다릴 수가 없군. – 제 피에 잠긴 그녀의 "
"모습을 보고 말것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Answer_0013_BloodMoon_AlignmentShift.Description_String
msgctxt "d83c1ad4-eabc-4d4a-b369-818d7b344f76"
msgid ""
"Expressed your opinion about the destruction of the portal on the Bald "
"Hilltop."
msgstr "민둥 언덕마루의 포탈을 부수고자 하는 당신의 의견을 말했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Answer_0013_Text
msgctxt "fed49a07-6961-4e2c-8f2e-963ff7bbc151"
msgid ""
"\"Nyrissa won't escape justice! We repelled her attacks – this time it's her "
"turn to repel ours!\""
msgstr ""
"\"나이리사는 정의로부터 달아날 수 없다! 우리는 그녀의 모든 공격을 견뎌냈다 – 이제는 그녀가 우리의 공격을 받을 차례이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Answer_0014_Text
msgctxt "c2951c11-c158-460c-8630-9f60f08a2b27"
msgid ""
"\"Nyrissa failed to push her advantage, and made a strategic mistake. You "
"shouldn't attack if you're unsure of victory.\""
msgstr ""
"\"나이리사는 그녀의 이점을 살리는데 실패했고, 전략적인 실수를 저질렀다. 승리에 대한 확신이 없다면 공격도 하지 말았어야지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Cue_0001_Text
#. Speaker : Capital_Collector
msgctxt "01b66513-a28e-4a24-ad43-9d06043d404c"
msgid ""
"\"Your Highness, Nyrissa's army has been crushed! Even their Jabberwock was "
"slain! This victory is a major triumph for your subjects, and they have a "
"special gift for you.\""
msgstr ""
"\"전하, 나이리사의 군대가 완전히 분쇄되었습니다! 심지어 그 재버워크들 조차 끝장냈습니다. 이번 승리는 국민들에게도 커다란 업적이었고, "
"승리를 축하하기 위해 그들이 특별한 선물을 보내왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "91689d81-3f3a-4bb5-b6f7-45fe60a6c231"
msgid ""
"\"Your Highness, we protected the kingdom! Nyrissa's Jabberwock-led army was "
"powerful, and the battle was grim. Nevertheless, our foe was defeated, and "
"the portal on the Bald Hilltop was destroyed.\""
msgstr ""
"\"전하, 또다시 왕국을 지켜냈습니다! 재버워크를 앞세운 나이리사의 군대는 강력했고, 전투는 끔찍했습니다. 그럼에도 불구하고, 우리 "
"적들은 패퇴했으며 민둥 언덕마루의 포탈은 파괴되었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Cue_0003_Text
#. Speaker : Capital_Collector
msgctxt "a11bcbdc-a61f-4996-885d-5e3cf079a5e3"
msgid ""
"\"Your Highness! Nyrissa's attack was devastating. I... I don't know how we "
"managed to survive. And I don't know if we'll ever fully recover. Only the "
"death of the Jabberwock finally broke the resolve of her forces.\""
msgstr ""
"\"전하! 나이리사의 공세는 파괴적이었습니다. 저는... 저는 우리가 어떻게 살아남았는지도 모르겠습니다. 또한 피해를 완벽한 복구가 "
"가능할지도 모르겠습니다. 재버워크를 죽이지 못했다면 그녀의 군세를 막기 어려웠을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Cue_0004_Text
#. Speaker : Linzi_Companion
msgctxt "d7d496b6-b73f-4b97-9c3e-d956551bc48e"
msgid ""
"\"It's a pity the portal to the First World was destroyed! I wish I could go "
"there right now and look that witch in the eye myself! I bet she was so "
"terrified of us that she destroyed the portal herself.\""
msgstr ""
"\"태초 세계로 가는 포탈이 무너졌다니 아까워요! 그 길로 직행해서 마녀를 직접 보고싶었는데 말이죠! 그녀가 우릴 너무나 두려워해서 "
"포탈을 직접 부숴버린 게 분명해요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Cue_0005_Text
#. Speaker : Tristian_Companion
msgctxt "c1f58f92-a32c-453a-b407-37b553bf96c2"
msgid ""
"\"Or perhaps the death of the Jabberwock caused the portal's destruction. "
"It's unlikely we'll ever find out.\" {n}Tristian's voice fills with "
"resolution.{/n} \"It's all right. We will find another path to Nyrissa's "
"lair. She won't be able to avoid retribution forever.\""
msgstr ""
"\"아니면 재버워크의 죽음으로 인해 포탈이 부숴졌을 수도 있습니다. 하지만 그 원인에 대해 알아낼 기회는 더이상 없을 것 같습니다.\" "
"{n}트리스티안의 목소리는 결의로 가득 차있습니다.{/n} \"그래도 괜찮습니다. 나이리사의 은신처로 가는 또 다른 길을 찾을 수 "
"있을겁니다. 그녀도 영원히 응징을 피할 수는 없을테니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Cue_0007_Text
#. Speaker : Tristian_Companion
msgctxt "9540afa9-af7c-451d-bc6d-15f62b1255bb"
msgid ""
"\"Portals to the First World are complicated and unpredictable. I managed to "
"open two with some degree of success — for the Everblooming Flower and at "
"the Bald Hilltop. However, those were the only two cases of success among "
"dozens of failures. Besides, the task would require much more time than we "
"have. I prepared both of these portals a long time ago, then waited for the "
"right time to use them.\""
msgstr ""
"\"태초 세계로 향하는 포탈은 복잡하고 예측할 수 없습니다. 제가 포탈을 여는데 성공했던 사례는 두 가지입니다 — 영원히 피는 꽃과 민둥 "
"언덕마루 말이죠. 하지만, 수많은 실패 끝에 성공한 두가지 경우일 뿐이죠. 게다가, 그 작업에 걸리는 시간은 저희가 가진 것보다 훨씬 "
"많이 필요합니다. 저는 그 포탈들을 오래 전부터 준비해왔고, 또 적절한 때에 맞춰 사용하기 위해 오랜 시간을 기다렸습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Cue_0009_Text
#. Speaker : Tristian_Companion
msgctxt "08ef72fc-67df-4fe0-b046-ee76729b8421"
msgid ""
"{n}Tristian sighs.{/n} \"Also, I just don't feel comfortable doing it. "
"Portals to the First World are dangerous, and I've caused enough harm to "
"give me pause before attempting another dangerous move. I'm sure there must "
"be another way to the First World.\""
msgstr ""
"{n}트리스티안이 한숨쉽니다.{/n} \"또, 저는 그 작업을 마음놓고 할 수도 없습니다. 태초 세계와 연결되는 포탈은 위험하기 때문에, "
"한 계단씩 위태롭게 올라갈 때 마다, 저를 강제로 멈추게 만든 상처들을 많이도 받았었습니다. 저는 태초 세계로 통하는 또 다른 길이 있을 "
"거라고 확신합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Cue_0015_Text
#. Speaker : Linzi_Companion
msgctxt "0824410a-4ee8-4c79-89bf-0e6131a314d9"
msgid ""
"\"I agree! I couldn't have said it better myself! Let's show that villain "
"she picked a fight she couldn't win!\""
msgstr "\"동의해요! 제가 뭘 더 첨언할 수는 없겠지만요! 그녀에게 자기가 이길 수 없는 적을 선택했다는걸 보여주자구요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Cue_0016_Text
#. Speaker : Linzi_Companion
msgctxt "eeacc08c-2d26-4e78-a0fe-943921f7ab37"
msgid ""
"\"I would put it differently, but I support the sentiment! Let's show that "
"villain she picked a fight she couldn't win!\""
msgstr "\"저는 생각이 좀 다르지만, 아무튼 그 감상을 지지해요! 그녀에게 자기가 이길수 없는 적을 선택했다는 걸 보여주자구요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/BloodMoon8Final/Cue_0017_Text
#. Speaker : Linzi_Companion
msgctxt "f6e08d8f-f5d1-44b6-a7f8-247c5ee98117"
msgid ""
"\"Hey, what's wrong with you? Don't applaud her! Villains don't deserve "
"praise! She deserves a beating for all the trouble she's caused – and the "
"sooner the better!\""
msgstr ""
"\"에이, 무슨 말이예요? 그녀를 칭찬하지 마세요! 악당은 칭찬받아선 안돼요! 그녀가 일으켰던 모든 문제를 생각해보면 당장 때려눕혀야 "
"한다구요 – 빠르면 빠를수록 더 좋겠죠! \""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/MiscTexts/ActivePortal_forMinimap_String
msgctxt "045c8915-42ad-43ec-9b06-27a233370629"
msgid "Unstable portal"
msgstr "불안정한 포탈"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/MiscTexts/DestroyedPortal_String
msgctxt "8ed0e9a5-eff6-4cd5-abd2-04f27d04e128"
msgid ""
"The portal to the First World was destroyed. It will probably never operate "
"again."
msgstr "태초 세계와 연결된 포탈은 파괴되었습니다. 다시는 작동하지 않을 것입니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/BloodMoon/MiscTexts/GhostStonesBark_String
msgctxt "d3c1c392-e552-4131-8e5f-64a5dc0ff5b1"
msgid ""
"A fragment of an ancient pillar, covered with eroded letters of an unknown "
"language."
msgstr "고대 기둥의 조각입니다. 알 수 없는 언어로 쓰인 침식된 문자들로 덮여 있습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Amiri/ktc22-Amiri_Q1_Fail/Cue_0001_Text
msgctxt "2e910ad8-14a4-4d60-9576-7cc78b8b10ed"
msgid ""
"\"Remember this Tuskgutter I wanted to slay? I mean that big boar. Well, "
"forget about it. Some hunters have got him already. And… Never mind, it "
"doesn't matter anymore.\" {n}With a sour face, the barbarian waves her "
"hand.{/n}"
msgstr ""
"\"이 터스크거터를 죽이길 원했다는 걸 기억해? 내가 의미하는건, 저 큰 멧돼지 말이야. 글쎄, 잊어버려. 어떤 사냥꾼이 이미 그를 "
"잡았군. 그리고... 신경 쓰지 마. 더 이상 중요하지 않아.\" {n}못마땅한 얼굴로, 바바리안은 손을 흔듭니다.{/n}\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Amiri/ktc22-Amiri_Q2_Start/Cue_0001_Text
msgctxt "d98f5858-f5db-43bf-a25d-8d0f6e6c516a"
msgid ""
"{n}Amiri looks unusually grim today.{/n} \"Listen… We need to talk. But not "
"in front of everyone. After the council ends — come to the tavern. It's "
"about my tribe. My old one from before.\""
msgstr ""
"{n}아미리의 얼굴은 오늘따라 더 험악해 보입니다.{/n} \"잠깐...내 말좀 들어봐. 다른 놈들 없는 곳에서. 이 회의가 끝나면 "
"선술집으로 와. 내 예전 부족 얘기야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Amiri/ktc41-Amiri_Q2_Fail/Cue_0001_Text
msgctxt "bf4a21a2-07f8-4793-ad38-c73d5971e962"
msgid ""
"\"I kind of... I wanted to ask you something about my tribe... It's — forget "
"it, it doesn't matter anymore. They're gone now — so hell with them! We have "
"enough to do without those scums, right?\" {n}Amiri tries to force a grin, "
"but fails. You can see that she's upset, but not inclined to talk about "
"it.{/n}"
msgstr ""
"\"나는 좀... 내 부족에 대해 물어보고 싶었어. 그건.. 잊어버려. 이제는 더 이상 중요하지 않아. 그들은 이제 가버렸어. 그 놈들은 "
"될대로 되라지! 우리는 그 쓰레기들 아니어도 할 일이 많아, 그렇지?\" {n}아미리는 억지로 웃음 지으려 하지만 실패합니다. 당신은 "
"그녀가 화는 났지만 그에 대해 얘기할 경향이 없음을 눈치챕니다.{/n}\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Amiri/ktc51-Amiri_Q3_Fail/Cue_0001_Text
msgctxt "ed449e48-1bc9-4e05-9ee3-7c564541550e"
msgid ""
"\"About my tribe... Forget it, it doesn't matter any more. They're gone now. "
"To hell with them — I don't want to see them anyway!\""
msgstr ""
"\"내 부족말이야... 잊어버려, 이제 더 이상 중요하지 않아. 그들은 이제 가버렸어. 그 녀석들은 될대로 되라지. - 난 그 놈들을 "
"어디서도 보고 싶지 않아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Amiri/ktc51-Amiri_Q4_Start/Cue_0001_Text
msgctxt "d5bab3fb-0d19-4224-a0ed-db855f65f5a5"
msgid ""
"\"Come to the tavern after the council. We need to talk. About my damn "
"tribe, and {d|Nilak}Nilak{/d}. And about the ghost. Will you come? I will "
"wait. I will try not to get drunk, but I really want to.\""
msgstr ""
"\"평의회가 끝나면 선술집으로 와. 우리 이야기 좀 해. 내 빌어먹을 부족과 {d|Nilak}닐락{/d}에 대해서 말이야. 그리고 그 "
"유령놈에 관해서도. 올거야? 난 기다릴 거야. 술에 취하지 않게 노력은 하겠지만, 그래도 정말 취하고 싶은 기분인데.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Answer_0004_AlignmentShift.Description
msgctxt "61af482e-11de-462c-b285-32e1a3a5a721"
msgid ""
"Agreed that throwing a party to cheer up Ekun is your duty as his comrade-in-"
"arms."
msgstr "에쿤을 위해 응원하기 위해 잔치를 여는 것이 그의 동지로서의 의무라고 동의했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Answer_0004_Text
msgctxt "258e5b39-b98a-49b8-8c64-a7791a8b7441"
msgid ""
"\"Helping Ekun is our comradely duty. And if we need to throw a feast to do "
"that — then that's what we're going to do!\""
msgstr "\"에쿤을 도와주는 건 동료인 우리의 의무야. 만약 파티를 열 필요가 있다면 기꺼이 열지 뭐!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Answer_0005_Text
msgctxt "cb1f04ae-dd61-4640-8884-7a5f56770213"
msgid "\"What are you getting at?\""
msgstr "\"무슨 방법이라도 있어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Answer_0006_Text
msgctxt "8f8dbf3a-d021-4a08-8dbe-0598064da3a4"
msgid "\"Wonderful. What does this have to do with me?\""
msgstr "\"훌륭한 생각이야. 근데 이게 나랑 무슨 상관이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Answer_0012_AlignmentShift.Description
msgctxt "25b948dd-67d1-41bd-b788-a193df49a7d4"
msgid "Refused to help cheer up Ekun."
msgstr "에쿤을 격려하기를 거절했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Answer_0012_Text
msgctxt "9166762a-0c10-43a2-a94f-d2470baeebd0"
msgid ""
"\"No. My responsibilities do not include consoling or entertaining any of "
"you.\""
msgstr "\"안돼. 내 책무에는 너희를 위로하거나 즐겁게 해주는 것까지 포함되어 있지 않아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Answer_0013_AlignmentShift.Description
msgctxt "d1d81333-f862-491e-a03e-060b2818f6a3"
msgid "Agreed to throw a party to cheer up Ekun."
msgstr "에쿤을 응원하기 위해 파티를 열 것을 동의했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Answer_0013_Text
msgctxt "87db5ad9-c62b-4a0b-8360-7b1b815a10ec"
msgid ""
"\"You are right. I can't stand looking at Ekun's glum face any longer — time "
"to cheer him up!\""
msgstr "\"네 말이 맞아. 에쿤의 우울한 표정은 더이상 못 보겠어. 다 같이 기운을 복돋아 주자!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Answer_0019_AlignmentShift.Description
msgctxt "5c1cbbd0-c64c-470a-b323-f49f29a88558"
msgid "Agreed to throw a party for Ekun to help him restore emotional balance."
msgstr "에쿤이 감정적인 균형을 회복하도록 돕기위해 파티를 여는 것에 동의했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Answer_0019_Text
msgctxt "248ea128-9952-4705-8496-d8f3c5bd6a65"
msgid ""
"\"Neither grief nor joy should be excessive. I think you've got a point.\""
msgstr "\"슬픔도 기쁨도 지나쳐서는 안 된다는거지? 린지, 네 말이 일리 있는것 같아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Answer_0020_Text
msgctxt "23937a51-5587-47f6-bd79-aff8c711083b"
msgid "\"I don't have time for this.\""
msgstr "\"난 그런걸 할 시간이 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Answer_0021_AlignmentShift.Description
msgctxt "a84d52d3-4265-4ca6-9f17-a4b1ecf4fabb"
msgid "Agreed to organize a feast for Ekun, but purely for your own reasons."
msgstr "순전히 당신을 위한 이유로, 에쿤을 위한 파티를 준비하기로 동의했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Answer_0021_Text
msgctxt "e4440b5d-28d2-4c12-bf06-42d193fa5b1e"
msgid ""
"\"I don't care about Ekun's inner turmoil, but that's no reason to turn down "
"a good party.\""
msgstr "\"에쿤의 심정이 어떻든 알 바 아니지만, 좋은 파티를 거절할 이유야 없지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "8a8defe4-ed0c-42f7-97ff-8ff84d876cce"
msgid ""
"\"Hello, Your Grace! ...Hmm, feels strange! It's amazing I can just go and "
"have a chat with an actual baron{mf||ess}...\""
msgstr "\"안녕하세요, 영주님! ...으음, 기분 참 이상하네요! 진짜 남작님한테 마음껏 와서 수다를 나눌 수 있다니 말이에요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Cue_0002_Text
#. Speaker : Linzi_Companion
msgctxt "5d86c824-6ffd-4984-be26-09ac8e3f7efa"
msgid ""
"\"I wanted to talk about Ekun. I'm worried about him lately... Although "
"'worried' might be too strong a word. He is way too gloomy — even more so "
"than usual, if that's possible. Life without a family must be hard for him..."
"\""
msgstr ""
"\"에쿤씨 얘기를 하고 싶었어요. 요즘 좀 걱정이 되서요... '걱정'은 너무 과장일지도 모르지만요. 그는 요즘 평소보다 더 우울해 "
"보여요. 가족없이 삶을 살아간다는게 아무래도 힘들겠죠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Cue_0007_Text
#. Speaker : Linzi_Companion
msgctxt "846bc14f-f907-4ac6-a8b5-b3aced3fa451"
msgid "\"I'm not sure I'd put it like that... but I'm glad you agreed!\""
msgstr "\"그 표현이 맞는건지 모르겠지만... 동의해줘서 기뻐요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Cue_0009_Text
#. Speaker : Linzi_Companion
msgctxt "8771eca6-fcd0-4882-9cd9-6597781d75b8"
msgid ""
"\"Well, for one, he is your companion! Second, I can't abide him scowling "
"another instant! Lastly? I want to know that when my ally is fighting beside "
"me, they won't break — and Ekun feels too close to it already.\""
msgstr ""
"\"음, 첫번째로 그는 당신의 동료에요! 둘째, 저는 더이상 그가 인상을 푹푹 쓰고있는걸 참을 수가 없어요! 마지막은? 저는 동료들이 내 "
"옆에서 싸우고 있을 때, 그들이 정신적으로 무너지지 않을 것이라는 것을 확신하고 싶어요. 그치만 에쿤은 이미 무너지기 일보직전으로 "
"느껴진다구요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Cue_0010_Text
#. Speaker : Linzi_Companion
msgctxt "5a413b10-2287-42f4-b5ab-521664b21de2"
msgid ""
"\"But he is not completely alone! He has us! I know we can't replace what he "
"lost, but we must remind him that we are here and he can talk to us!\""
msgstr ""
"\"하지만 에쿤씨가 완전히 혼자는 아니잖아요! 우리가 있잖아요! 우리가 에쿤씨의 가족분들을 대신할 수는 없다는 건 알지만, 그에겐 우리가 "
"있고, 우리와 같이 대화할 수 있다는 것을 깨닫게 해줘야 해요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Cue_0014_Text
#. Speaker : Linzi_Companion
msgctxt "ebaa9aab-9df2-4d2c-afcf-201c644159f1"
msgid ""
"\"What I'm getting at is that we should hold a merry revelry and use the "
"opportunity to talk to him, heart to heart! If we just invite him for a "
"drink, he'll no doubt refuse. So we must organize everything in secret! "
"We'll gather guests, prepare food and drink, bring Ekun — and have so-o-o "
"much fun! I'll even bring my lute! What do you say?\""
msgstr ""
"\"제 말은, 흥청대며 연회를 즐긴 뒤에 기회를 봐서 에쿤과 터놓고 얘기를 나누자는 거예요! 그냥 술 마시자고 하면 거절할 게 "
"분명하니까, 비밀스럽게 말이죠. 손님을 모으고 먹을 것과 음료를 준비한 다음, 자연스럽게 에쿤을 데려오면 돼요. 그리고 아주 즐거운 "
"시간을 보내는 거죠! 제 류트도 가져올게요! 어떻게 하실래요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Cue_0015_Text
#. Speaker : Linzi_Companion
msgctxt "fac4a1ea-decd-42fd-a620-bc51bb37d970"
msgid ""
"\"I've talked to Elina the innkeeper and she's happy to help us. Although… "
"between us, I'm not sure what made her so enthusiastic... Anyway, you should "
"talk to her. And I should go and think what I'm going to play!\""
msgstr ""
"\"여관주인 엘리나한테 말했는데 기꺼이 도와주겠다네요. 그런데... 저희끼리 얘기지만, 엘리나가 그렇게 의욕이 넘치는 이유를 "
"모르겠어요... 어쨌든, 엘리나와 한번 얘기해보세요. 저는 그동안 일을 진행시키고 있을게요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Cue_0016_Text
#. Speaker : Linzi_Companion
msgctxt "58e5b9b8-c40c-4038-9734-f889023a73c5"
msgid ""
"{n}Linzi's face brightens with a smile. {/n} \"Wonderful! As we know, great "
"minds think alike!\""
msgstr "{n}린지 얼굴은 미소로 밝아졌습니다.{/n} \"좋았어! 역시 우리같은 위대한 정신의 소유자는 생각도 같다니깐요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Cue_0017_Text
#. Speaker : Linzi_Companion
msgctxt "5982e3d3-40de-4c92-b6e3-92fc6eed05a8"
msgid ""
"{n}Linzi looks away, and her voice falters a bit.{/n} \"Well, if... if "
"that's how you feel about us...\""
msgstr "{n}린지는 눈길을 돌리며, 목소리가 살짝 떨립니다.{/n} \"음, 저..저희를 그렇게 느끼신다면 어쩔 수 없죠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Cue_0018_Text
#. Speaker : Linzi_Companion
msgctxt "cde9ad85-4715-4b10-9f0e-06da4884c5ad"
msgid ""
"\"And one more thing, don't be late! I fear if we don't pull Ekun out of his "
"mood now, it'll be too late!\""
msgstr "\"아, 그리고 한가지 더! 늦으면 안돼요! 지금 에쿤의 상태는 심각해요, 더 늦으면 돌이킬 수 없을지도 몰라요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Cue_0022_Text
#. Speaker : Linzi_Companion
msgctxt "f381ea14-9c65-4b44-9581-c8095454cd1c"
msgid "{n}Linzi shakes her head, displeased.{/n}"
msgstr "{n}린지는 못마땅해하며 고개를 가로젓습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc22-Ekun_Q1_Start/Cue_0023_Text
#. Speaker : Linzi_Companion
msgctxt "87876f12-3d99-4d32-a2fa-09902fe27d76"
msgid "\"Pity. Well, I did what I could...\""
msgstr "\"안타깝네요. 그럼, 제가 할수 있는걸 해볼께요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc31-Ekun_Q1_Fail/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "2ea59275-19fe-4103-9e9c-6cb15144a08b"
msgid ""
"{n}Linzi is trying not to look at you.{/n} \"I'm... well... it's about "
"Ekun's {d|Ekun Feast Ok}party{/d}. Of course, now's not the time... and I'm "
"sure you have other things on your mind... so let's just forget about this, "
"all right?\""
msgstr ""
"{n}린지는 당신을 쳐다보지 않으려고 애씁니다.{/n} \"저는...음...이건 에쿤을 위한 {d|Ekun Feast Ok}파티{/d}를 "
"열자는 거였는데.. 물론 지금은 그럴때가 아니죠...생각하시는 다른게 있으실꺼에요...그러니 이 일은 그냥 잊어버리자구요, 알겠죠?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Fail/Cue_0001_Text
#. Speaker : Ekun_Companion
msgctxt "931791f7-b451-445f-ab49-ed190ba07f15"
msgid ""
"{n}Ekun barely looks at you.{/n} \"I am back, {name}. Forgive me if you were "
"worried. I needed to... rest. From everything. And say farewell to Ntavi.\""
msgstr ""
"{n}에쿤은 당신을 거의 보지 않습니다.{/n} \"돌아왔다, {name}. 걱정하게 만들었다면 미안하다. 나는... 휴식이 필요하다. "
"모든 것으로부터. 그리고 은타비에게 작별 인사를 해야 한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Answer_0004_Text
msgctxt "bbf1fec2-34bc-4372-9355-3019350dca7a"
msgid "\"What do you mean 'missing'?\""
msgstr "\"사라졌다니'?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Answer_0005_AlignmentShift.Description
msgctxt "13033b90-caa9-4f21-914b-23bdd30130a7"
msgid ""
"Thanked Elina for staying vigilant and promised to search for Ekun straight "
"away."
msgstr "경계를 늦추지 않은 엘리나에게 감사를 전하며 즉시 에쿤을 찾으러 가겠다고 약속했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Answer_0005_Text
msgctxt "fddcad3a-68bd-4698-9cb8-0f6a622dd600"
msgid ""
"\"You did your duty by warning me, and I'm grateful. I'll set off to find "
"them immediately.\""
msgstr "\"이렇게 경고해주어 고맙다. 바로 수색하러 떠나지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Answer_0006_Text
msgctxt "8ba25aca-ea4e-4758-922e-ed08fd3412ba"
msgid "\"Where do you think they may have gone?\""
msgstr "\"어디로 향했을 것같나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Answer_0010_AlignmentShift.Description
msgctxt "1f3564fd-2469-468d-82b8-6e7d94768929"
msgid "Decided to look for Ekun to not miss any of the fun."
msgstr "함께 사냥을 즐기기 위해 에쿤을 찾으러 갑니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Answer_0010_Text
msgctxt "3216542c-7b59-40a8-af40-1ed43edf64b2"
msgid ""
"\"Hmm... what if they got into a battle without me. Can't let them have all "
"the fun — let's go find them.\""
msgstr "\"흐음... 만약 나 빼고 전투를 즐길 셈인가. 내가 가서 찾아보지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Answer_0011_AlignmentShift.Description
msgctxt "134c1e8e-210b-42b8-8fcd-5f95b29e5b98"
msgid "Refused to search for Ekun and Ntavi."
msgstr "에쿤과 은타비를 찾으러 가길 거절했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Answer_0011_Text
msgctxt "0ba99b7e-02b8-4112-bf6e-1d5609dca427"
msgid "\"They can fall into Rovagug's jaws for all I care. Get out of here!\""
msgstr "\"로바거그께서 녀석들을 씹어먹어 줬으면 좋겠군. 꺼져라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Answer_0012_AlignmentShift.Description
msgctxt "d50bd513-d2e9-449b-a10b-85390af25662"
msgid ""
"Explained to Elina that a ruler cannot abandon their responsibilities to "
"search for their subjects."
msgstr "엘리나에게 백성 하나하나를 쫓아다니기 위해 통치자로서의 책무를 버려둘 수 없다고 설명했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Answer_0012_Text
msgctxt "1a2e4fbf-cb78-4cad-9598-e2ab55ea126b"
msgid ""
"\"They will have to deal with it themselves, I can't leave my "
"responsibilities here to chase Ekun.\""
msgstr "\"알아서 해결하라고 해라, 에쿤을 쫓아다니느라 내 의무를 소홀히 할 수는 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Answer_0014_Text
msgctxt "966596e4-00bf-4fa0-8812-0a60fd52430d"
msgid "\"I'll see what can be done.\""
msgstr "\"해결해 보도록 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Cue_0001_Text
#. Speaker : Elina
msgctxt "5ba44c15-25f9-4787-94ff-6feef41f4715"
msgid ""
"{n}Elina's face is pale, and her red hair is a mess.{/n} \"It's awful, Your "
"Grace! Ekun is missing, and {d|Ntavi}Ntavi{/d} too!\""
msgstr ""
"{n}엘리나의 얼굴은 창백하고 머리는 헝클어져 있다.{/n} \"끔찍한 일이에요, 전하! 에쿤이랑 {d|Ntavi}은타비{/d}가 "
"사라졌어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Cue_0002_Text
#. Speaker : Elina
msgctxt "2de78c92-20be-4b3c-8bc1-05b55bf2ca75"
msgid ""
"\"He was happy for a while after our fest. Things were going well... but "
"then he started feeling down — restless. His thoughts may have turned to his "
"family again. And then this... {d|Ntavi}Ntavi{/d} kept turning up.\""
msgstr ""
"\"에쿤은 연회 덕분인지 기분이 좋아 보였어요. 그렇게 일이 잘 풀리는 줄 알았는데... 어느샌가 에쿤이 침울해하더라구요. 가족들한테 "
"돌아가고 싶은가 봐요. 그런 와중에... {d|Ntavi}은타비{/d}라는 사람이 계속 찾아왔고요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Cue_0007_Text
#. Speaker : Elina
msgctxt "ac64952e-682d-48fd-8473-9900e9ea6846"
msgid "{n}Elina looks surprised.{/n} \"A-As Your Grace wishes... thank you!\""
msgstr "{n}엘리나는 놀란 기색이다. {/n} \"마...마음대로 하셔요, 전하... 감사합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Cue_0008_Text
#. Speaker : Elina
msgctxt "f8f659d4-5d8a-4c42-804f-010bf38a96c2"
msgid "\"Praise {g|Erastil}Erastil{/g}! Thank you, Your Grace!\""
msgstr "\"{g|Erastil}에라스틸{/g}이시여! 감사합니다, 전하!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Cue_0009_Text
#. Speaker : Elina
msgctxt "71fc8c02-03bd-4523-82c2-337a47e88c33"
msgid ""
"\"If only we knew for sure, Your Grace! There is one spot though — a bridge "
"over the {g|Gudrin River}Gudrin River{/g}... travelers have gone missing "
"there, they say it might be the work of giants. Ntavi was close when some "
"woodcutter told me about it. And I'm thinking, maybe this woman dragged Ekun "
"there?\""
msgstr ""
"\"알 수만 있다면 다행이죠! 그리고보니 {g|Gudrin River}구드린 강{/g} 다리가 마음에 좀 걸리네요... 여행자들이 자주 "
"실종되는 곳인데, 원인은 거인때문이라는 소문이에요. 왠 나무꾼이 말하기를 은타비도 그 근처에 있었데요. 어쩌면 이 년이 에쿤을 그쪽으로 "
"데려간게 아닐까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Cue_0013_Text
#. Speaker : Elina
msgctxt "f8c0380c-c50d-4a79-9333-0c5e1c343ceb"
msgid ""
"\"And the more he talked to Ntavi, the worse he got. She was whispering "
"something in his ear, and he kept ordering more and more wine... then last "
"night they left the inn, armed to the teeth! I tried to stop them, but I "
"couldn't... they haven't been back since!\""
msgstr ""
"\"그 년이랑 얘기를 나눌 수록 에쿤의 표정이 안 좋아졌어요. 에쿤의 귀에다 뭐라고 속삭이면 항상 술을 더 주문해오고... 그런데 어제 "
"갑자기 단 둘이 여행채비를 갖춘 구색으로 선술집을 나간 거 있죠! 막아보려고 했지만, 역부족이었어요... 그 이후로는 코빼기도 안보이고요!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Cue_0015_Text
#. Speaker : Elina
msgctxt "ba563ecb-021a-49c6-be72-2b73275c4de0"
msgid ""
"\"In {g|Erastil}Erastil{/g}'s name, Your Grace, please find Ekun! My heart "
"says this won't end well.\""
msgstr "\"{g|Erastil}에라스틸{/g}의 이름으로, 전하, 제발 에쿤을 찾아주세요! 좋게 끝날 것 같지가 않아요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Cue_0016_Text
#. Speaker : Elina
msgctxt "a22c77f7-69a8-4439-90aa-ac4711c0a404"
msgid ""
"{n}Elina looks at you, terrified.{/n} \"F-Forgive me, Your Grace... I'm "
"leaving...\""
msgstr "{n}엘리나는 두려움에 찬 눈으로 당신을 봅니다.{/n} \"전하, 요-용서해주세요... 이만 가보겠습니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Ekun/ktc41-Ekun_Q2_Starts/Cue_0017_Text
#. Speaker : Elina
msgctxt "0287ca0d-8908-4f04-8e59-c0b00aecfac7"
msgid "\"I... I see, Your Grace. Oh, I hope nothing bad happened to them...\""
msgstr "\"마..맞습니다, 전하. 오, 그들에게 나쁜 일이 일어나지 않았기를...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc21_Harrim_Q1_Start/Answer_0005_Text
msgctxt "843b8e26-b487-4300-ad1d-91e6b6f0bf1c"
msgid "\"Why do you ask this?\""
msgstr "\"왜 이런 질문을 하는거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc21_Harrim_Q1_Start/Answer_0006_Text
msgctxt "e3ce660b-9af5-447e-9287-1edfdf599ff9"
msgid ""
"\"Of course, Harrim. If I find any dwarven ruins, I'll take you to them.\""
msgstr "\"물론이다, 하림. 드워프 유적을 발견하면, 널 데려가도록 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc21_Harrim_Q1_Start/Answer_0007_Text
msgctxt "af3d5494-274c-4ccc-8af8-898e438ff7e4"
msgid "\"Don't, Harrim. It will bring you nothing but pain.\""
msgstr "\"관둬라, 하림. 그건 네게 고통만을 가져다 줄 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc21_Harrim_Q1_Start/Cue_0001_Text
#. Speaker : Harrim_Companion
msgctxt "ff428ce2-b02f-4968-ab1a-453b1429c87b"
msgid ""
"{n}Harrim looks embarrassed. He runs his fingers through his beard and "
"clears his throat a few times, then speaks at last.{/n} \"I heard... Not "
"that it is important, but... Well...\""
msgstr ""
"{n}하림은 당황한 표정입니다. 손으로 턱수염을 헤치고 몇 번 헛기침을 한 뒤 마침내 말을 꺼내기 시작합니다.{/n} \"어... 들은 "
"것이 있네... 별로 중요한 건 아니지만... 흠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc21_Harrim_Q1_Start/Cue_0002_Text
#. Speaker : Harrim_Companion
msgctxt "fe810be7-5f4d-4b61-996c-f82cf8342fae"
msgid ""
"{n}He clears his throat again.{/n} \"I heard that an ancient trade road "
"built by the dwarves of {g|Five Kings Mountains}the Five Kings Mountains{/g} "
"runs through these lands. I don't know what happened to them, or where they "
"went. Unforgiving time spares no one... But the road itself is still here. "
"And possibly not only the road.\""
msgstr ""
"{n}그는 다시 가다듬습니다.{/n} \"{g|Five Kings Mountains}다섯 왕의 산맥{/g}의 드워프들에 의해 건설된 고대 "
"무역로가 이 땅을 관통하고 있다는 얘기를 들었네. 그 드워프들에게 무슨 일이 있었는지, 어디로 사라졌는지는 모르겠네. 고난의 시대의 "
"드워프들은 아무도 남지 않았지만... 길은 남아 그 자리를 지키고 있네. 혹시 길뿐만이 아닐지도 모르지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc21_Harrim_Q1_Start/Cue_0003_Text
#. Speaker : Harrim_Companion
msgctxt "45df7714-5573-4e0a-b24a-54f45024d49d"
msgid ""
"{n}Harrim holds his beard in his fist.{/n} \"Well... {Name}, I have a "
"request. If you find any dwarven ruins in the area, I'd like to see them "
"with my own eyes.\""
msgstr ""
"{n}하림은 그의 수염을 그의 손으로 꾹 쥐었습니다.{/n}\"음... {Name}, 부탁할 것이 있네. 만일 이 지역에서 드워프 유적을 "
"찾는다면, 내 두 눈으로 보고 싶다네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc21_Harrim_Q1_Start/Cue_0008_Text
#. Speaker : Harrim_Companion
msgctxt "f14c8e68-159f-4acf-aa6c-bf1a9f250086"
msgid ""
"{n}Harrim fiddles with his beard again.{/n} \"I shouldn't, probably. But "
"it's like a wound that's never healed. You know it will only hurt more, but "
"you still need to scratch it... Of course it's foolish, foolish and vain... "
"But still I wish to look at them.\""
msgstr ""
"{n}하림은 다시금 그의 수염을 만지작거렸습니다.{/n}\"그래선 안되겠지, 아마도. 하지만 이건 꼭 치유되지 않는 상처와 같다네. 더 "
"다칠뿐이라는 것을 알면서도 긁어내리기만 하는 것처럼 말이야...물론 그건 멍청한 짓이지. 멍청하고 헛된 일이지만... 그래도 나는 "
"그것들을 보고 싶다네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc21_Harrim_Q1_Start/Cue_0009_Text
#. Speaker : Harrim_Companion
msgctxt "ff34fc4c-f7e8-440c-ae20-1e8fe8283cc5"
msgid "\"Thank you, {Name}. I, well... Ahem! Thank you.\""
msgstr "\"고맙네, {Name}. 나는, 그.... 흠! 고맙네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc21_Harrim_Q1_Start/Cue_0010_Text
#. Speaker : Harrim_Companion
msgctxt "6a8046b8-3dc2-42fb-85bf-d44c267b6f4b"
msgid ""
"\"You are right, {Name}, I know you're right... And yet I want to go there.\""
msgstr "\"맞는 말이야, {Name}, 맞는 말이라는 것은 알고 있다네...그럼에도 나는 그곳에 가고 싶다네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q1_Fail/Cue_0001_Text
#. Speaker : Harrim_Companion
msgctxt "93da6096-8dcc-4570-b046-a78e3c346356"
msgid ""
"\"About the dwarven ruins... Do you recall that I wanted to see them? I have "
"thought about it for a while and realized that I shouldn't. It's all "
"nonsense, dust and ashes, vain and pointless. Why look to ruins for purpose, "
"if the whole world is soon to join them?\""
msgstr ""
"\"드워프 유적에 대해서...내가 보고 싶다고 했던 것이 기억나는가? 그에 대해 생각해보니 그래선 안된다는 것을 깨달았네. 말도 안 되는 "
"일이지, 먼지와 재같이 공허하고 의미 없는 일이고말고. 온 세상이 곧 그와 같이 될 것인데 유적 따윌 볼 이유가 무어란 말인가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Answer_0004_Text
msgctxt "2dbad44d-3d6d-45a3-bc07-ad2e9f8d4a91"
msgid "\"I'm not going to help you. Get out!\""
msgstr "\"너를 돕지 않겠다. 나가!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Answer_0005_AlignmentShift.Description
msgctxt "176cd3a0-a1bb-43a3-93df-a3e17aa09f49"
msgid "Executed the Skjegge clan's emissary."
msgstr "셰게 부족의 사절을 처형했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Answer_0005_Text
msgctxt "460618ac-c610-4bf7-916f-a4ab4c528e33"
msgid "\"I think you're a spy. Guards! Hang her!\""
msgstr "\"네 년이 첩자라 생각한다. 경비병! 이 자를 매달아라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Answer_0009_Text
msgctxt "a6d23f68-0612-4578-83e1-6b35edca96c9"
msgid "\"So what's this trouble you've gotten yourselves into?\""
msgstr "\"그래서 당신들이 빠진 곤경이라는 게 무엇인가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Answer_0018_Text
msgctxt "7b755dcb-2cb3-4e52-a920-5f217cfba2b3"
msgid "\"All right, I'll help you.\""
msgstr "\"알겠다, 당신들을 돕지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0006_Text
#. Speaker : Dwarf_FighterF_HarrimQ2
msgctxt "bb82230a-318b-4c02-93e8-0f044ae09031"
msgid ""
"\"What? No! I swear I'm not a spy! Don't!\" {n}Ignoring the dwarf's screams, "
"the guards drag her away.{/n}"
msgstr ""
"\"뭐? 아니야! 맹세코 난 첩자가 아닙니다! 제발!\" {n}드워프의 외침을 무시하고, 경비병들은 그녀를 끌고 갔습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0007_Text
#. Speaker : Dwarf_FighterF_HarrimQ2
msgctxt "2cacc3f9-84a7-456b-9b9c-c10723a5c653"
msgid "\"Your Grace, I beg you...\""
msgstr "\"나리, 간청드립니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0008_Text
#. Speaker : Harrim_Companion
msgctxt "9c10ce65-aa4f-4ded-a76c-b39791e81de0"
msgid "\"Serves her right.\""
msgstr "\"그녀를 제대로 대접하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0010_Text
#. Speaker : Dwarf_FighterF_HarrimQ2
msgctxt "95508936-4b51-4908-a0a5-0cd68988267b"
msgid ""
"\"Many ages ago, our ancestors, together with the other clans, built a road "
"here, and a chain of fortresses along it. Unfortunately they were forced to "
"leave these lands. But now that you've established order here, we decided to "
"return, to rekindle our clan's legacy. We found the entrance to the "
"Adamantine Shield Fortress, but when we tried to enter...\" {n}Rudrin winces "
"and touches her bandaged arm.{/n}"
msgstr ""
"\"수십여년 전, 우리 조상님들은 다른 클랜들과 함께 이 곳에 도로를 건설하고 이를 따라 요새들을 건설했습니다. 불행히도 그들은 이 땅을 "
"떠나야만 했었지요. 그러나 이제 당신께서 여기에 다시 질서를 바로 세웠기에, 저희는 우리 클랜의 유산을 다시 되살리기 위해 돌아오기로 "
"결심했습니다. 저희는 아다만틴 방패 요새의 입구를 찾았지만 저희가 들어가려고 할 때...\"{n}루드린은 눈을 깜빡이며 그녀의 붕대감은 "
"팔을 만졌습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0011_Text
#. Speaker : Dwarf_FighterF_HarrimQ2
msgctxt "1ef1943e-a47a-470f-a216-9545b7cbf0c2"
msgid ""
"\"When our ancestors left, they charmed the gate of the fortress and locked "
"it with a key – which has long been kept safe by our clan as a relic. We "
"brought it with us, but when we inserted it into the lock and turned, "
"something incredible happened! The gate fell to ashes, and we saw that the "
"lock was upon the chest of a huge golem – which attacked us immediately!\""
msgstr ""
"\"우리 조상들이 떠났을 때, 요새의 관문에 마법을 걸고 오랫동안 우리 클랜의 유물로서 보관되어 온 열쇠로 이를 잠갔습니다. 저희는 이 "
"열쇠를 가져와서 이를 잠금장치에 넣고 돌리자, 엄청난 일이 벌어진 겁니다! 관문이 재로 흩어지고 그 잠금장치는 거대한 골렘의 가슴에 달려 "
"있었습니다. 그리고 그 골렘이 우리를 공격했습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0013_Text
#. Speaker : Harrim_Companion
msgctxt "0c5c8d0f-fc71-4cac-be17-b6d694c2f8c5"
msgid ""
"{n}Harrim snorts.{/n} \"I'm sure the creator of this golem prayed devoutly "
"to {g|Torag}Torag{/g} while he made it... Never thinking for a moment that "
"this piece of iron might someday turn on his own. How dwarvish!\""
msgstr ""
"{n}하림은 코웃음칩니다.{/n} \"이 골렘의 창조자는 이것을 만드는 동안 {g|Torag}토락{/g}에게 경건히 기도했겠지... 이 "
"골렘이 언젠가 스스로 공격하리라곤 생각도 못 했을 게야. 정말 드워프답군!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0015_Text
#. Speaker : Dwarf_FighterF_HarrimQ2
msgctxt "c0d56711-7877-494c-b9f1-6019d3592b93"
msgid ""
"\"We managed to hide up on a hill, but we'd backed ourselves into a trap: "
"the golem just stood below, waiting for us to come down. Two of us "
"sacrificed their lives, distracting it to give me a chance to escape and "
"find help... Please, save them! You are our only hope!\""
msgstr ""
"\"저희는 언덕으로 가까스로 도망쳤습니다만, 돌아보니 골렘이 그대로 우뚝 서있고 저희를 기다리고 있더군요. 두 명이 희생을 해서 골렘의 "
"눈길을 끌고 저만 도움을 요청하기 위해 빠져나왔습니다... 제발 부탁드립니다! 제 동료들을 구해 주십시오! 영주님이 저희의 유일한 "
"희망이십니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0016_Text
#. Speaker : Harrim_Companion
msgctxt "32890058-70ee-43ae-8d47-00ba392a7472"
msgid ""
"{n}Harrim interrupts her sternly.{/n} \"We told you no! Now leave! You and "
"your clan are not welcome here.\""
msgstr "{n}하림이 단호히 그녀를 제지합니다.{/n} \"안된다고 말했지 않나! 떠나라! 너와 네 부족은 이곳에서 환영받지 못한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0017_Text
#. Speaker : Dwarf_FighterF_HarrimQ2
msgctxt "8412dd4d-dbab-499a-a15c-0d151dcd1b77"
msgid "\"As you say. Forgive me for troubling you.\""
msgstr "\"네 말대로, 널 괴롭힌걸 용서해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0019_Text
#. Speaker : Dwarf_FighterF_HarrimQ2
msgctxt "47799653-f064-44fd-8cb0-929dfab704f1"
msgid ""
"\"Thank you, Your Grace! The Skjegge clan owes you. Here's a map. It shows "
"where to find the fortress...\""
msgstr "\"감사합니다. 전하! 셰게 가문은 당신께 빚을 졌습니다. 여기 요새를 찾을 수 있는 지도가 있습니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0020_Text
#. Speaker : Harrim_Companion
msgctxt "d4e67ecd-39b3-4453-825b-f5c5bc99be04"
msgid ""
"{n}Harrim fiddles with his beard pensively.{/n} \"I would ask you – if you "
"go to help them, take me with you. I know it's folly to gloat, but I would "
"see with my own eyes our proud guests from {g|Five Kings Mountains}the Five "
"Kings Mountains{/g} caught in such a mess... – And then send them home with "
"my own tongue. I hope you will allow me this small pleasure...\""
msgstr ""
"{n}하림은 가만히 턱수염을 만지작 거린다.{/n} \"물어볼게 있네 – 만약 그들을 도우러 간다면, 날 데려가게. 나도 어리석은 "
"일이란건 알아, 하지만 {g|Five Kings Mountains}다섯 왕의 산맥{/g}에서 온 우리의 자부심 가득한 손님들이 그 "
"난장판에 걸린걸 내 눈으로 봐야 겠네... 그리고 내가 설득해서 그들을 집으로 보내도록. 내 작은 소망을 들어줬으면 하네...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0021_Text
#. Speaker : Dwarf_FighterF_HarrimQ2
msgctxt "4b12943f-dad6-4c27-86bb-57b7c1be27c0"
msgid ""
"\"Your Grace, I must warn you... This is no ordinary golem. He's made of "
"adamantine. He's almost impossible to destroy, even with magical weapons. "
"But if you wear it out for long enough in battle, it will collapse for a "
"while to restore its strength. At that moment, you'll need to pull the key "
"from its chest. If I know anything about mechanics, that should switch it "
"off!\""
msgstr ""
"\"전하, 경고해야만 하겠습니다... 그건 평범한 골렘이 아닙니다. 놈은 아다만틴으로 만들어졌습니다. 마법무기로도 파괴하는 건 거의 "
"불가능합니다. 하지만 전투에서 충분히 오래 손상시키면, 놈은 힘을 회복하기 위해 잠시 붕괴될 것입니다. 그 순간, 놈의 가슴에서 열쇠를 "
"꺼내야 할 것입니다. 기계학은 잘 모르지만, 기계인 이상 전원을 내리면 멈추겠지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0022_Text
#. Speaker : Harrim_Companion
msgctxt "9dc57ebb-78f3-4908-86dc-bc8c036cff7f"
msgid ""
"\"And if you don't?\" {n}Harrim's gloomy question hovers unanswered in the "
"silence.{/n}"
msgstr "\"그렇지 않다면?\" {n}침묵 속에 하림의 음울한 질문이 답없이 맴돌았다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0024_Text
#. Speaker : Harrim_Companion
msgctxt "06e1dd6f-32ad-4574-8137-42f0b92f2894"
msgid ""
"{n}Harrim appears in the doorway, loudly shouting down the corridor, and "
"trying to block a visitor's way. However, they don't budge, and finally the "
"priest is pushed backwards into the room, shouting all the while.{/n} \"Away"
"! Go away, I'm telling you! The baron{mf||ess} isn't seeing anyone! "
"{mf|He's|She's} busy! And isn't here!\""
msgstr ""
"{n}하림은 출입구에 나타나 복도에 큰 함성을 지르고, 방문자의 앞길을 막으려 합니다. 허나, 소리치는 와중에도 그들은 동요 없이 사제를 "
"밀치고 방안으로 들어가려 합니다.{/n} \"저리 꺼져! 너희들에게 말하는거야! 남작님은 누구도 만나고 싶지 않으셔! 바쁘시다고! 여기 "
"없어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0025_Text
#. Speaker : Dwarf_FighterF_HarrimQ2
msgctxt "14a75bb6-5d92-416e-a6a6-57727787d848"
msgid ""
"\"Forgive me, respected Harrim, but I must speak to the baron{mf||ess}!\" {n}"
"A young dwarf limps into the room. She doesn't look well: her face is "
"bruised, her armor crumpled, and her arm is dressed with rags, brown from "
"dried blood. Nevertheless, she begins with a ceremonious bow.{/n} \"Your "
"Grace! My name is Rudrin, of the Skjegge clan, and I've come to beg your "
"help. My kin are in grave...\""
msgstr ""
"\"용서하십시오 하림 공, 하지만 난 남작님께 이야기 해야만 합니다.!\" {n}젊은 드워프는 방안으로 절뚝이며 들어온다. 그녀의 상태가 "
"좋아보이지 않는다. 얼굴은 멍들고, 갑옷은 꼬깃꼬깃하며 팔의 옷은 말라붙은 피가 갈색으로 변해 누더기가 되어 있었다. 그럼에도 불구하고, "
"그녀는 격식을 갖춰 인사했다.{/n} \"전하! 저는 셰게 가문의 루드린 입니다, 전하의 도움을 청하러 왔습니다. 제 일족은 심각한..."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0026_Text
#. Speaker : Harrim_Companion
msgctxt "2c3d8f5d-2574-4f9a-8c41-06ab2258b705"
msgid ""
"{n}Harrim interrupts her with indignation.{/n} \"How do you know my name?!\""
msgstr "{n}하림은 분노와 함께 그녀를 방해한다.{/n} \"어떻게 내 이름을 알고 있지?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0027_Text
#. Speaker : Dwarf_FighterF_HarrimQ2
msgctxt "cab76781-27df-4c79-bfdf-4aef66791fe5"
msgid ""
"\"I was told of you by our leader – the revered Jarmuld, {g|Torag}Torag's{/g}"
" paladin. He is hoping to meet you in person. He has so many questions for "
"you! A dwarf who rejected Torag, became a priest of {g|Groetus}Groetus{/g}, "
"and now sits in an important position at the court of a baron{mf||ess} – "
"such tales are rare!\""
msgstr ""
"\"나는 우리의 존경받는 지도자인 {g|Torag}토락{/g}의 팔라딘, 야르물드님을 대신하여 말씀을 전달하려 합니다. 그분께서는 당신을 "
"직접 뵙기를 원하십니다. 그분은 당신께 많은 질문을 하고자 합니다! 토락을 거부해 {g|Groetus}그로투스{/g} 의 사제가된 "
"드워프는 이제 {mf||여}남작님의 궁정에 중요한 위치를 차지하고 있죠, 매우 드문 경우죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc31_Harrim_Q2_Start/Cue_0028_Text
#. Speaker : Harrim_Companion
msgctxt "1e4c838c-502e-4d27-a9be-df0109fadeb9"
msgid ""
"{n}Harrim's face is exploding with red and white spots. He furiously grabs "
"his beard.{/n} \"{g|Torag}Torag's{/g} paladin?! And he wants to talk to me?! "
"What impudence, what shameless... Brazen... Although...\" {n}Harrim turns to "
"you.{/n} \"You know, perhaps we should help them! I want to see this paladin "
"with my own eyes – and the trap he walked his congregation into!\""
msgstr ""
"{n}하림의 얼굴은 폭발할듯 붉으락푸르락 해졌다. 그는 몹시 거칠게 수염을 잡아챘다.{/n} \"{g|Torag}토락{/g} 의 "
"팔라딘?! 나와 이야기를 하고 싶다고?! 이 무슨 무례하고 염치없는... 뻔뻔하... 지만...\" {n}하림은 당신에게로 "
"돌아선다.{/n} \"알다시피, 아마도 우린 놈들을 도와야 할꺼 같네! 난 이 팔라딘을 내 두 눈으로 직접 보고 싶군, 놈과 그의 "
"신도들이 걸어들어간 덫이 어떤 건지도 말야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q2_Fail/Cue_0001_Text
#. Speaker : Harrim_Companion
msgctxt "02ed26ae-c3da-4310-89c8-254a2f1fc624"
msgid ""
"{n}Harrim fiddles with his beard pensively.{/n} \"Do you remember the "
"Skjegge clan who came to us, begging us to save them? You agreed to help "
"them back then, but we never got around to it. Sometimes I wonder what "
"happened to them...\""
msgstr ""
"{n}하림은 가만히 턱수염을 만지작 거린다.{/n} \"우리에게 와서 살려달라고 애원하던 셰게 가문을 기억해? 너는 그때 돕기로 "
"동의했지만, 우린 그럴 여유가 없었어. 가끔 그들이 어떻게 됐을지 궁금해...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q2_Fail/Cue_0002_Text
#. Speaker : Harrim_Companion
msgctxt "9b7fb679-5cee-4c27-b8ff-46699e39ea96"
msgid ""
"\"They probably died. Or returned home in disgrace... But what's the "
"difference? There's a lesson for all of us, {Name}: don't go after the "
"treasures of the dead, unless you are ready to join them. It was their pride "
"that unmade them. Pride and greed...\""
msgstr ""
"\"아마 죽거나, 불명예스럽게 집으로 돌아갔겠지... 그게 무슨 차이가 있겠어? 우리에겐 모두 교훈이 됐지, {Name}: 죽은자의 "
"보물을 쫓지 말라, 그것과 함께 할 것이 아니라면. 그들을 망친건 놈들의 오만함이야. 오만과 탐욕...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q3_Reward/Cue_0001_Text
msgctxt "26e8b6c7-49b3-4e3f-b073-9561dae21b99"
msgid ""
"{n}Rudrin Skjegge looks much better than she did on your first meeting. Back "
"then she could barely stand for the wounds she'd received fighting the "
"golem. Now the dwarf stands proudly at attention before you in polished "
"armor.{/n}"
msgstr ""
"{n}루드린은 처음 그녀를 만났을 때보다 더 나아보였다. 그 때 그녀는 골렘과 싸운 상처를 간신히 견디고 있었다. 이제 그 드워프는 "
"윤기나는 갑옷을 입고 당신 앞에 당당히 서 있다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q3_Reward/Cue_0002_Text
#. Speaker : Dwarf_FighterF_HarrimQ2
msgctxt "0448fa85-7daf-4e6f-84f1-d548c33b1794"
msgid ""
"\"Your Highness! My dear Sir Harrim, deeply respected servant of "
"{g|Groetus}Groetus{/g}! The Skjegge clan has sent me to you to express our "
"gratitude for everything you have done for us, and present you with this "
"humble gift. We crafted this for Sir Harrim personally, from the metal of "
"artifacts unmade by him.\" {n}Rudrin hands a small but heavy chest to Harrim "
"and bows.{/n}"
msgstr ""
"\"{g|Groetus}그로투스{/g}의 충실한 하인인 친애하는 하림 경! 셰게 가문은 당신이 우리에게 해준 모든 것에 대해 감사를 "
"표하기 위해 이 변변치 않은 선물과 함께 저를 보냈습니다. 우리는 하림 경에 의해 파괴된 아티팩트의 금속으로 부터 당신을 위해 직접 "
"만들었습니다.\" {n}루드린은 작지만 묵직한 상자를 하림에게 숙이며 전한다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q3_Reward/Cue_0003_Text
#. Speaker : Harrim_Companion
msgctxt "1ca0b3b3-866a-493c-a878-c4e33668f82a"
msgid ""
"{n}Harrim frowns, trying to hide his confusion, then nods and accepts the "
"gift.{/n} \"Well... I'm glad you're all right. It's nice to see someone "
"managed to make something useful out of those worthless scraps.\""
msgstr ""
"{n}하림은 눈살을 찌푸리며, 자신의 복잡한 심경을 감추려 애쓴다. 그리곤 목례하며 선물을 받았다.{/n} \"음... 기쁘게 받지. "
"누군가 그 쓸모없는 찌꺼기로 유용한 것을 만들어 낸 것을 보니 반갑군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q3_Start/Answer_0006_Text
msgctxt "2c6f4f99-8b6a-4eff-aa3b-e3cb701d4ff6"
msgid "\"Yes, we need to go and check on them.\""
msgstr "\"맞아, 우리는 가서 확인해야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q3_Start/Answer_0007_Text
msgctxt "0e4b5cee-d625-48d6-a262-7cb6fea39528"
msgid ""
"\"I'm sick and tired of these Skjegge. They may as well fall into the Abyss. "
"– I'm not helping them any more!\""
msgstr "\"셰게 놈들에게 아주 질려버렸어. 놈들은 지옥에나 빠지라 그래. – 난 놈들을 절대 돕지 않겠어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q3_Start/Answer_0011_Text
msgctxt "c1abff9d-ebbb-4b5a-ba62-c6bcb82a7e3b"
msgid "\"You are right. Let's go and see what happened.\""
msgstr "\"네가 옳아. 무슨일이 있었는지 보러 가자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q3_Start/Answer_0012_Text
msgctxt "b424db6a-4b20-460b-b5d9-7eb774fd362a"
msgid "\"I don't think it's anything serious.\""
msgstr "\"난 그게 심각하다고 생각하지 않아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q3_Start/Cue_0001_Text
#. Speaker : AdamantineGolemHarrimQ3
msgctxt "101f6340-6659-4a0c-9231-0aa4ed2df5dc"
msgid ""
"{n}A strange golem enters your throne room. It is seriously hurt, barely "
"moving its legs and swaying as if it's drunk.{/n} \"Help... Us... H-Help... "
"H-Help...\""
msgstr ""
"{n}기괴한 골렘이 왕좌의 방으로 들어온다. 그것은 마치 술에 취한듯 휘청이며, 간신히 다리를 움직이고 있다.{/n} \"도와줘... "
"우릴... 도-와줘... 도-와줘...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q3_Start/Cue_0002_Text
#. Speaker : Harrim_Companion
msgctxt "8e5c783d-ba3b-4c4e-b86b-d2c90e4505f4"
msgid ""
"{n}A frowning Harrim quickly responds.{/n} \"How do you like that? Again, "
"someone needs our help, and again it has to do with golems... Does any of "
"this seem familiar, {Name}? Those simpletons from the Skjegge clan must have "
"dug up something else. And got themselves into trouble again...\""
msgstr ""
"{n}하림은 얼굴을 찡그린채 재빨리 대답했습니다.{/n}\"어찌 좋아할 수 있겠나? 또 다시, 누군가가 우리의 도움을 필요로 하는데다, "
"또 다시 골렘들과 관련이 있네...익숙한 일이 아닌가, {Name}? 셰게 클랜의 이 모지리들이 또 다른 것을 파낸 모양이네. 그리고는 "
"또 다시 곤경에 처한 게지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q3_Start/Cue_0003_Text
msgctxt "08016da5-cfb7-486d-9ce6-b3f0fa04e104"
msgid ""
"{n}The priest's remarks are punctuated by a terrible clanging sound as the "
"golem collapses on the floor in pieces.{/n}"
msgstr "{n}사제의 말은 그 골렘이 바닥에 여러조각으로 무너지며 나는 커다란 쾅 소리에 막혀버렸습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q3_Start/Cue_0004_Text
#. Speaker : Harrim_Companion
msgctxt "cb400e4f-18d6-47a2-a194-cd4554ae1b1d"
msgid ""
"\"And I warned them they were wooing death. I warned them... Let's return to "
"that little fortress that they couldn't get inside, and see what's happened "
"to them this time!\""
msgstr ""
"\"그리고 나는 그들에게 비참한 죽음을 경고했네. 내가 경고했어...그들이 들어가지 못했던 그 작은 요세로 돌아가보자구. 이번엔 무슨 "
"일이 그들에게 일어난 것인지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q3_Start/Cue_0008_Text
#. Speaker : Harrim_Companion
msgctxt "6f9085d9-fbb1-4b91-87a7-c598d204bd39"
msgid ""
"\"Just don't go without me, all right? I want to see with my own eyes what "
"catastrophe they've wrought this time, all the while praying to their "
"{g|Torag}Torag{/g}.\""
msgstr ""
"\"단지 나를 두고는 가지 말게, 괜찮나? 내 두 눈으로 그들이 이번엔 {g|Torag}토락{/g}에게 기도하는 동안 어떤 재앙을 "
"불러일으켰는지 보고 싶네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q3_Start/Cue_0009_Text
#. Speaker : Harrim_Companion
msgctxt "93660b3f-e243-45a7-97d0-2a734639fa29"
msgid ""
"\"Yes, quite right... But on the other hand, you do know these treasure "
"hunters were looking for trouble. What if they dug up some new golem as tall "
"as a tower, and it's already on its way to destroy the capital? We should go "
"and see. These are your lands, after all!\""
msgstr ""
"\"그렇소, 맞는 말이네...허나 다른 한편으론, 이 보물 사냥꾼들이 문젯거리를 찾고 있다는 것을 알거요. 만약 그들이 탑 만큼이나 "
"커다란 골렘을 파낸다면, 그게 수도를 파괴하려 오고 있다면 어쩌겠나? 우리는 가서 보아야 하네. 모든 게 당신 영지의 일이라네!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Harrim/ktc51_Harrim_Q3_Start/Cue_0013_Text
#. Speaker : Harrim_Companion
msgctxt "4c4791b2-98d6-4b5e-ac5a-97cf76aae480"
msgid "\"Hmm... Well, as you say, as you say.\""
msgstr "\"흐음...그럼, 당신이 말한 데로네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Answer_0005_Text
msgctxt "63c1def0-16e6-4310-8fa7-a77269c6ae4f"
msgid "\"I don't care to waste my time on this.\""
msgstr "\"난 이런 일에 시간 낭비하고 싶지 않아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Answer_0006_Text
msgctxt "ccbf92e8-33ca-47d4-b266-abb4e8a28b04"
msgid "\"Let him speak, Jaethal. Anger will not help us learn the truth.\""
msgstr "\"그가 말하게 해줘, 제이탈. 분노는 우리가 진실을 알게 하는데 도움이 안돼.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Answer_0007_Text
msgctxt "c4b8b56d-cdf4-4909-b98e-ef8ae2fb720e"
msgid ""
"\"Jaethal, listen to reason. If Enneo was involved in your death, he "
"wouldn't be openly offering your dagger for sale.\""
msgstr "\"제이탈, 이성을 찾아. 에네오가 만일 너의 죽음에 관계되어 있다면, 그가 공개적으로 너의 단검을 판매하지는 않았을거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Answer_0012_Text
msgctxt "94905eec-ce1d-4b7a-a43e-c9087eea5982"
msgid ""
"\"We will investigate this matter further. Let's start by checking Enneo's "
"story, and seek out this unfortunate boar.\""
msgstr "\"우리는 이 문제를 더 조사할 것이다. 우선 에네오의 이야기부터 확인하고, 이 불쌍한 멧돼지를 찾아보자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Answer_0014_Text
msgctxt "72a7baeb-dc84-4654-b746-c40004dcf199"
msgid "\"Where exactly did you find this carcass and dagger?\""
msgstr "\"이 사체와 단검은 정확히 어디서 찾았지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Answer_0016_Text
msgctxt "e80ddcdb-590d-464c-9216-127938040bb9"
msgid ""
"\"Enneo, you face serious accusations. Are you sure you can say nothing more "
"in your defense?\""
msgstr "\"에네오, 당신은 지금 심각한 혐의를 받고있어. 더 이상 변호를 위해 할 말이 없는게 확실해?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Cue_0001_Text
#. Speaker : Enneo_Vendor
msgctxt "bd3fbcc1-daf3-4e5c-98e2-c625c43f67d0"
msgid ""
"{n}Enneo, a half-elf merchant who recently appeared in the capital, falls to "
"the floor in front of you. Jaethal stands beside him, looking quite unlike "
"her normal self. Usually cold and stiff, the face of the undead elf now "
"burns with rage. Despite his nearness to his furious undead captor, Enneo "
"looks concerned but unafraid.{/n} \"If you allow me to speak, I can explain "
"everything.\""
msgstr ""
"{n}수도에 최근 모습을 보인 하프 엘프 상인 에네오가 바닥에 내동댕이쳐져서는 당신 앞에 놓였습니다. 제이탈은 평소의 그녀 답지 않은 "
"모습으로 그의 옆에 서있습니다. 평소엔 차갑고 무표정한 언데드 엘프의 얼굴이 지금은 분노에 타 오르고 있습니다. 그를 잡아온 분노에 찬 "
"언데드가 바로 옆에 있음에도, 에네오는 걱정되지만 두려워하지는 않는 표정입니다.{/n} \"제 이야기를 허락해주신다면, 모든 것을 "
"설명드리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Cue_0002_Text
#. Speaker : Jaethal_Companion
msgctxt "59f69e25-42de-4f0a-881b-53bcdf262dd3"
msgid ""
"\"Was it poison? Magic? Illness? Whatever stole my life away, it left no "
"trace. I thought this mystery would haunt me forever. But then I entered the "
"shop of this half-blood... Seeking some reminder of {g|Kyonin}Kyonin{/g}... "
"and what did I discover there? My very own dagger!\" {n} Jaethal shows you "
"an elven-crafted dagger with a chipped blade and empty sockets, where once "
"gemstones adorned the handle.{/n} \"This dagger disappeared the same night I "
"was taken by death. How could this half-blood have obtained it?!\""
msgstr ""
"\"독? 마법? 질병? 내 삶을 앗아간 것이 무엇이었든, 흔적조차 남기지 않았어. 난 이 수수께끼가 날 영원히 붙잡아 둘 것이라 "
"생각했지. 그런데 그후 난 {g|Kyonin}쿄닌{/g}을 다시 상기 시켜줄만한 물건을 좀 볼까해서 이 잡종의 가게에 들어갔는데..거기서 "
"내가 뭘 발견했는지 알아? 예전 내 단검이었어! {n}제이탈은 당신에게 금이 가고 손잡이 보석 자리는 텅 비어버린 엘프제 단검을 "
"보여주었습니다.{/n} 이 단검은 내가 죽던 날 밤에 사라져버렸었지. 어떻게 이 잡종이 이걸 가지고 있을 수 있는거지?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "f089ac47-f94f-434b-9977-63a40155ef3e"
msgid ""
"\"I hope you can, half-blood, otherwise...\" {n}Jaethal hisses and turns to "
"you.{/n} \"Have I told you the sad story of my death? It is sad most of all "
"because I do not remember how my life ended. I wandered, exhausted, through "
"the wastelands beyond the borders of {g|Kyonin}Kyonin{/g}, until I could "
"barely see my path. I stopped to rest, or perhaps I lost consciousness... "
"When I came to my senses, I heard the call of my goddess, returning me from "
"the dead.\""
msgstr ""
"\"할 수 있었으면 좋겠군, 잡종, 그렇지 않으면...\"{n}제이탈은 쏘아붙이고는 당신을 향했습니다.{/n} \"내 죽음에 얽힌 슬픈 "
"이야기를 들려주었던가? 내 삶이 어떻게 끝나버렸는지 기억할 수 없다는 게 가장 슬픈 일이거든. 난 길을 겨우 볼수 있을 정도로 탈진한 채 "
"{g|Kyonin}쿄닌{/g}의 국경 너머 황무지를 헤메고 있었어. 잠시 쉬기위해 멈춰섰고, 아니 어쩌면 정신을 잃었거나.. 그리고 다시 "
"정신이 들었을때 난 나의 여신께서 죽음에서 나를 되돌리려는 부르심을 들었어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Cue_0008_Text
#. Speaker : Jaethal_Companion
msgctxt "eeb6677e-fd8a-4ab4-83a1-b5af331fc266"
msgid ""
"\"That is why...\" {n}Jaethal pauses.{/n} \"Respecting your authority, I "
"have brought this pathetic huckster here, rather than getting the truth out "
"of him by my own methods...\""
msgstr ""
"\"그것이 이유야...\"{n}제이탈은 잠시 멈추었다.{/n} \"네 권위를 존중하기 때문에, 나만의 방식으로 진실을 캐내지 않고 이 "
"한심한 장사꾼을 이곳에 데려온거야...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Cue_0009_Text
#. Speaker : Enneo_Vendor
msgctxt "99ee69dc-ce51-4617-9c5b-1c7a1a11cac8"
msgid ""
"{n}The half-elf rises to his feet and sighs, putting his clothes in "
"order.{/n} \"Thank you for allowing me to speak, Your Grace. The story is "
"not very exciting, certainly not as exciting as my tale of the drunken "
"regatta within the Eye of Abendego! ... Yesterday, north of the city, I "
"stumbled upon a dead boar. There was no one around, but the dagger was "
"protruding from the miserable beast's neck. I don't know why the owner would "
"have left it in the carcass. Perhaps the beast escaped from the hunter, "
"taking along the weapon that had injured it? So I... inadvertently decided "
"to keep the item I'd found, thanking my luck — and never suspecting the "
"price I'd pay for it.\""
msgstr ""
"{n}하프 엘프는 옷매무새를 정리하며 일어나 한숨을 내쉬었습니다.{/n} \"이야기하게 해 주셔서 감사합니다, "
"{mf|영주님|영주님|전하|전하}. 이 이야기는 제가 아벤데고의 눈 한 가운데서 술마시기 경주를 했던 이야기 만큼 흥미진진하진 "
"않습니다...어제, 도시 북쪽에서 저는 죽은 멧돼지를 우연히 발견했습니다. 주위엔 아무도 없었지만, 이 비참하게 죽은 짐승 목에 단검이 "
"튀어 나와있었습니다. 단검 주인이 왜 시체 곁에 두고 갔는지는 모르겠습니다. 어쩌면 사냥꾼에게 이 무기로 상처입고는 단검이 꼽힌 채로 "
"도망친 것일지도요? 그래서 저는...제 운에 감사하며 단검을 무심코 챙겼던 것입니다. 제가 어떤 댓가를 치루게 될지는 전혀 의심 못하고 "
"말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Cue_0010_Text
#. Speaker : Jaethal_Companion
msgctxt "0ac97fd4-85ed-4d16-b989-787ce57df8b8"
msgid ""
"\"You are very attentive to the troubles and needs of your faithful "
"companions.\" {n}You detect poisonous notes in Jaethal's voice, but she "
"restrains herself quickly.{/n} \"Very well, let's not distract the "
"{mf|baron|baroness}, half-blood. Let's go and talk somewhere alone!\""
msgstr ""
"\"너는 충실한 동료들의 골칫거리와 필요한 것들에 매우 신경을 쓰는군.\"{n}당신은 제이탈의 목소리에서 독기가 어렸음을 발견했습니다. "
"그러나 그녀는 재빨리 이를 억눌렀습니다.{/n}\"좋아, {mf|남작|남작}을 방해하지 말자고, 잡종. 다른곳으로 가서 이야기 하자고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Cue_0011_Text
#. Speaker : Jaethal_Companion
msgctxt "95b50a23-2c47-4da8-ad55-4534ca9a41a0"
msgid ""
"{n}Your words set Jaethal on her heels. She frowns, but calms down.{/n} "
"\"Perhaps that's logical. This one would have to be a useless fool to do "
"such a thing, and useless fools do not easily survive the road. Still, his "
"story should be verified. It must be. And in any case, the dagger may "
"lead... to my killer.\""
msgstr ""
"{n}당신의 말이 제이탈을 궁지에 몰아넣습니다. 그녀는 눈살을 찌푸렸지만 이내 진정했습니다.{/n} \"아마도 그 말이 이치에 맞을지도. "
"이런짓을 하려면 이 녀석은 쓸모없는 바보라는 거고, 쓸모없는 바보는 쉽게 살아남지 못하거든. 그렇지만 그의 이야기가 진실인지 밝혀져야 "
"해. 반드시. 분명 이 단검은 날 죽인 살인자에게 인도해 줄테니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Cue_0013_Text
#. Speaker : Enneo_Vendor
msgctxt "45dd3a50-28f6-4980-8ad2-13860000293f"
msgid ""
"\"In the vicinity of the Old Sycamore. Of course I'm sure you know where "
"that tree grows. I found the boar to the west of the Sycamore, in the "
"direction of the {g|Thorn River}Thorn River{/g}.\""
msgstr ""
"\"올드 시카모어 근처에서 입니다. 물론 그 나무가 자란 곳을 알고 계실 겁니다. 저는 그 시카모어 서쪽, {g|Thorn River}"
"가시 강{/g}쪽 방향에서 멧돼지를 찾았습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Cue_0015_Text
#. Speaker : Jaethal_Companion
msgctxt "eac52667-c759-43e7-b6ee-a35432353c7b"
msgid ""
"{n}Jaethal bows gracefully.{/n} \"I am... grateful. It's important to me. "
"And you, half-blood, should pray for our success. If you are lying, I shall "
"find a surer way to get the truth from you!\""
msgstr ""
"{n}제이탈이 기품있게 인사했습니다.{/n}\"나는...고마워. 이건 내게 중요한 일이야. 그리고 너, 잡종, 우리가 성공하기를 기도해야 "
"할 거야. 네가 거짓말을 한 거라면, 나는 진실을 알아낼 더 확실한 방법을 찾아낼 테니까!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc21-Jaethal_Q1_start/Cue_0017_Text
#. Speaker : Enneo_Vendor
msgctxt "804e654e-35de-4b4a-a13b-64336c62802c"
msgid ""
"\"I would be glad if I could, but alas.\" {n}The bright yellow-green eyes of "
"the half-elf are calm.{/n} \"The dead boar is my only witness. But I believe "
"in your justice, {mf|baron|baroness}. I have faith that you will investigate "
"my story and sort everything out.\""
msgstr ""
"\"더 할 수만 있다면 좋겠습니다만..\"{n}하프 엘프의 밝은 황록색 눈이 차분했습니다.{/n}\"그 죽은 멧돼지가 저의 유일한 "
"목격자입니다. 그러나 전 당신의 공정성을 믿습니다, {mf|남작|남작}님. 당신께서 제 이야기를 조사하시고 모든 것을 밝혀주시리라 "
"믿습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc22-Jaethal_Q1_fail/Cue_0001_Text
#. Speaker : Jaethal_Companion
msgctxt "f185ea7f-973d-4e66-866f-b468d862b248"
msgid ""
"\"It's a pity you couldn't find time to investigate my murder. Our primary "
"piece of evidence — the wild boar's carcass in the Old Sycamore — was torn "
"to pieces, either by local wildlife or starving peasants. Enneo the merchant "
"managed to flee, as well. All the clues have been lost. Now we may as well "
"forget about it.\""
msgstr ""
"\"나를 살해한 것에 대해 조사할 시간이 없다니 유감스럽네. 우리의 첫 단서의 조각이었던 올드 시카모어의 야생 맷돼지의 사체는 그곳의 "
"야생동물이나 배고픈 농민들에 의해 조각조각 나 버렸지. 상인 에네오는 도망쳤고 말야. 모든 단서들이 사라져 버렸군. 이제 잊는 수 밖에 "
"없겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc22-Jaethal_Q1_fail/Cue_0002_Text
#. Speaker : Jaethal_Companion
msgctxt "74117b64-3022-42b9-9418-49fb950d4669"
msgid ""
"\"It's a pity you couldn't find time to continue investigating my murder. "
"I've learned that a group of travelers visited the bank of the {g|Thorn "
"River}Thorn River{/g}, exactly where the boar appeared before the Old "
"Sycamore. But now the travelers are gone. Enneo the merchant managed to "
"flee, as well. All the clues are lost.\""
msgstr ""
"\"나를 살해한 것에 대해 조사를 계속할 시간이 없다니 유감스럽네. 난 그 맷돼지가 올드 시카모어에 나타나기 전에 있었다던 {g|"
"Thorn River}가시 강{/g} 강둑을 방문한 한 무리의 여행자들을 찾아냈어. 그런데 이제는 그 여행자들도 떠나버렸지. 물론 상인 "
"에네오도 도망쳐버렸고 말야. 모든 단서가 사라졌네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc22-Jaethal_Q1_fail/Cue_0003_Text
#. Speaker : Jaethal_Companion
msgctxt "d5c7301f-cff4-4975-b6ff-cae4d8291707"
msgid ""
"\"It's a pity you couldn't find time to visit Enneo the merchant. He managed "
"to escape, and his possessions were stolen by some petty thieves. All the "
"clues are lost now.\""
msgstr ""
"\"상인 에네오를 방문할 시간이 없다니 유감스럽네. 그는 도망쳤고, 그의 재산들은 별볼일 없는 도둑들이 도둑질해갔지. 모든 단서가 "
"사라졌어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc41-Jaethal_Q2_Start/Answer_0003_Text
msgctxt "376d8d3f-6dec-458c-84d1-1447e508baf2"
msgid "\"So, where is he?\""
msgstr "\"그래서, 그는 어디 있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc41-Jaethal_Q2_Start/Answer_0004_Text
msgctxt "efff3920-6e1e-48f4-951d-d77016d76e9a"
msgid "\"I don't want to get involved in all this.\""
msgstr "\"나는 이 모든 일에 대해 관여하고 싶지 않습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc41-Jaethal_Q2_Start/Answer_0010_Text
msgctxt "f922b077-8885-48b3-a4a6-50f4df10dff6"
msgid ""
"\"Fine. As soon as the opportunity arises, we'll visit the Valley of the "
"Dead.\""
msgstr "\"좋아. 기회가 있다면 곧 우리는 죽은 자의 계곡을 방문거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc41-Jaethal_Q2_Start/Answer_0011_Text
msgctxt "639b72c1-d6ab-4b7d-875a-9a9261ee7543"
msgid "\"I will not help you in this.\""
msgstr "\"난 이 일에 대해 널 돕지 않겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc41-Jaethal_Q2_Start/Cue_0001_Text
#. Speaker : Jaethal_Companion
msgctxt "58ff0b39-2f87-4576-a164-9db62bffa968"
msgid ""
"{n}Jaethal crosses the throne room, her gait determined and confident. It "
"seems clear that the inquisitor has something pressing on her mind.{/n} "
"\"Finally I have news about the half-blood. I expected him to seek shelter "
"somewhere far from your lands, but no — he was spotted not far away.\""
msgstr ""
"{n}제이탈이 단호하고 자신만만한 걸음걸이로 알현실을 가로지릅니다. 이단심문관은 급히 전할 소식이 있어 보입니다.{/n}\"마침내. 그 "
"잡종에 대한 소식을 입수했어. 우리 영토에서 멀리 떨어진 곳에 숨었을 거라 생각했는데, 아니더군. 가까운 곳에 있었어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc41-Jaethal_Q2_Start/Cue_0005_Text
#. Speaker : Jaethal_Companion
msgctxt "6f36cf3e-7e14-4fd6-8b41-e16765c05512"
msgid ""
"\"Not far from the {g|Valley of the Dead}Valley of the Dead{/g}. What a "
"fitting place for a Pharasmite, desperately trying to rid this world of the "
"undead. Such determination might have been an asset in dealing with "
"Vordakai... But I wish to discuss something else. The half-blood was spotted "
"chasing some pauper pilgrim woman. Judging by the things my agent managed to "
"find out, the woman herself may turn out to be quite interesting.\""
msgstr ""
"\"{g|Valley of the Dead}죽은 자의 계곡{/g}에서 멀지 않은 곳에 있었지. 언데드를 이 세상에서 지워버리려 필사적인 "
"파라스마 교도들에게 딱 들어맞는 장소로군. 이런 결정은 어쩌면 보다카이를 처리하기 위한 것이었겠지만...난 좀 다른걸 의논해 보고 싶군. "
"이 잡종이 어떤 가난한 순례자 여성을 추격하는 것이 목격되었어. 내 수하들이 찾아낸 것으로 판단해 보자면, 그녀에 대해 알아내는 것은 "
"꽤나 흥미로울 것 같더군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc41-Jaethal_Q2_Start/Cue_0006_Text
#. Speaker : Jaethal_Companion
msgctxt "49898c89-395c-42a9-8225-b5e61fd32d1d"
msgid ""
"\"How could this be, after all he's done to fool you and drag you into his "
"schemes?\" {n}Jaethal can't hide her disappointment.{/n} \"Very well, as you "
"wish. But this is a short-sighted decision. Very short-sighted.\""
msgstr ""
"\"어떻게 이럴 수 있지, 그 녀석이 널 속이고 자기의 계획에 끌여들였는데도?\"{n}제이탈은 실망감을 숨기지 못했습니다.{/n}\"좋아"
", 원하는 데로 해. 그러나 이건 근시안적인 결정이야. 아주 근시안적이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc41-Jaethal_Q2_Start/Cue_0007_Text
#. Speaker : Jaethal_Companion
msgctxt "865070d3-5a85-49d4-a155-c7e8d84ab71d"
msgid ""
"\"To track down the half-blood, I had to deal with a whole range of scum — "
"thieves, vagabonds, grave-robbers. One of them located Enneo, but then "
"preyed upon the pauper woman — couldn't miss a chance to rob her blind. In "
"her handbag the thief found some ominous writings. Thinking the papers were "
"cursed, he decided to rid himself of them by giving them to me. Do you know "
"what they turned out to be? Excerpts from \"Serving Your Hunger\", the "
"sacred text of {g|Urgathoa}Urgathoa's{/g} followers.\""
msgstr ""
"\"이 잡종을 추격하기 위해서, 나는 도둑들, 부랑아들, 도굴꾼들 같은 모든 종류의 쓰레기들을 다루어야 했어. 그 중 하나가 에네오의 "
"위치를 찾아냈고, 그 가난한 여성에게 사기칠 기회를 놓치지 않고 그녈 등쳐먹었지. 그녀의 손가방에서 이 도둑은 몇몇 불길한 글들을 "
"찾아냈어. 그 글들이 적힌 종이들이 저주받았다고 생각하곤, 그는 자신에게서 그것들을 떼어놓을 요량으로 그걸 내게 주었지. 그것들이 "
"무엇이었는지 알아? {g|Urgathoa}우르가쏘아{/g}의 추종자들의 신성한 책인 \"굶주림을 받들라\"의 발췌본이었어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc41-Jaethal_Q2_Start/Cue_0008_Text
#. Speaker : Jaethal_Companion
msgctxt "45f44f4e-86fc-40d4-9296-4c17ed40159c"
msgid ""
"\"I've examined the stolen papers closely, and now I believe that their "
"owner is a high-ranking priestess of {g|Urgathoa}Urgathoa{/g}. It seems this "
"half-blood persists in his desire to rid the world of all my goddess' "
"followers. He's skilled at covering his tracks, but now we have a chance to "
"intercept him. Let's go to the {g|Valley of the Dead}Valley of the Dead{/g} "
"and find this priestess before he acts. Then, when he comes for her... well, "
"the servants of any deity should be able to stand up for their faith, is it "
"not so?\""
msgstr ""
"\"난 그 훔친 서류들을 자세히 살펴보았지, 그 문서의 원래 주인은 {g|Urgathoa}우르가쏘아{/g}의 고위 여사제인 것 같아. 이 "
"잡종은 나의 여신의 모든 추종자를 세상에서 박멸하려는 중이야. 놈은 흔적을 지우는데 능하지만 드디어 놈을 잡을 기회가 왔어. {g|"
"Valley of the Dead}죽은 자의 계곡{/g}으로 가서 놈이 여사제를 죽이기 전에 찾아내자. 그리고 놈이 여사제를 "
"찾아오면... 글쎄, 신의 종이라면 응당 행동으로 믿음을 증명해야 하는 게 아닐까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc41-Jaethal_Q2_Start/Cue_0012_Text
#. Speaker : Jaethal_Companion
msgctxt "685346aa-134e-4928-b98f-a888635b60a5"
msgid ""
"\"Thank you. I want to say — this... this is important to me. I've grown "
"tired of drowning in silence, hearing never a word from my goddess. I wish "
"to speak with this priestess, and try to discover what "
"{g|Urgathoa}Urgathoa{/g} may be expecting from me. I want answers. — Answers "
"from my murderer, among others.\""
msgstr ""
"\"고마워. 이건...이건 내게 중요한 일이야. 그걸 말하고 싶었어. 나의 여신님으로부터 아무 말도 듣지 못하는 고요 속에 잠겨있다는 "
"것에 지쳐가고 있었어. 이 여사제와 이야기해봄으로써 {g|Urgathoa}우르가쏘아{/g}께서 내게 바라시는 게 무엇인지 찾아내고 싶어. "
"난 해답을 원해. 다른 이들 가운데 누가 나를 죽인 사람인지를.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc51-Jaethal_Q2_fail/Cue_0001_Text
#. Speaker : Jaethal_Companion
msgctxt "c6703c71-22b2-490d-aaf5-9bc063504056"
msgid ""
"\"It appears that we've hopelessly lost the opportunity to hunt down the "
"half-blood. My agents discovered the dead body of a priestess of "
"{g|Urgathoa}Urgathoa{/g}, who he'd been chasing. As for Enneo himself, he's "
"disappeared without a trace, just like last time.\""
msgstr ""
"\"그 잡종을 잡을 기회를 우리가 절망적으로 놓쳤다는게 드러났군. 내 수하들은 그 녀석이 쫓던 {g|Urgathoa}우르가쏘아{/g}의 "
"여사제의 시체를 발견했어. 지난 번처럼 에네오 그 녀석은 그 흔적을 감추었지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc51-Jaethal_Q3_start/Answer_0005_Text
msgctxt "9bc7b898-c64e-46c5-a874-0dc9258aec04"
msgid "\"Fine. We'll meet with these elves.\""
msgstr "\"좋아. 우리는 엘프들을 만나게 될꺼야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc51-Jaethal_Q3_start/Answer_0006_Text
msgctxt "6ae1fd3a-f318-4a52-b20f-bc729cd45ca4"
msgid ""
"\"It's not my concern. I've already had enough trouble because of this story."
"\""
msgstr "\"그건 내 관심사가 아니야. 나는 이미 그 때문에 충분히 어려움을 겪었어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc51-Jaethal_Q3_start/Answer_0009_Text
msgctxt "e98a3e5a-008e-4940-8142-63e08462fa1c"
msgid "\"Does this situation somehow threaten me or my kingdom?\""
msgstr "\"이 상황이 어떤 식으로 나나 나의 왕국을 위협한다는 것이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc51-Jaethal_Q3_start/Answer_0012_Text
msgctxt "671b483f-e350-47eb-9091-f1d750e1b009"
msgid "\"Fine. We'll meet with these elves if circumstances permit.\""
msgstr "\"좋아. 상황이 허락한다면 우린 그 엘프들을 만나러 갈꺼야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc51-Jaethal_Q3_start/Answer_0013_Text
msgctxt "075ecdd8-6d61-488f-bffb-d74409fadbb5"
msgid ""
"\"I'm not going to meddle in your affairs with the elves. This is my final "
"decision.\""
msgstr "\"난 엘프들과 당신의 일에 간섭하지 않겠어. 내 최종 결정이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc51-Jaethal_Q3_start/Cue_0001_Text
#. Speaker : Jaethal_Companion
msgctxt "e8213bdc-6e1a-44c5-b975-73110db9de24"
msgid ""
"\"I bring news,\" {n}Jaethal reports abruptly.{/n} \"Not unexpected. A "
"sizable group of elves from {g|Kyonin}Kyonin{/g} has crossed the border into "
"your kingdom. They send {g|JaethalQ3}a message{/g} to you. You may read it, "
"if you wish, but I can state the substance in a few words: \"We demand you "
"turn over the murderer. We await your response.\""
msgstr ""
"\"소식을 가져왔어,\" {n} 제이탈이 느닷없이 찾아옵니다.{/n} \"예상한대로야. 상당한 규모의 {g|Kyonin}쿄닌{/g} 엘프 "
"무리가 네 왕국의 국경을 넘어왔어. 그들은 너에게 {g|JaethalQ3}편지{/g}를 보냈고. 아마 읽어봐야 할거야. 하지만, 네가 "
"원한다면 그 구구절절한 문장들을 몇 단어로 요약할 수도 있겠지: \"우리는 살인자의 송환을 요구한다. 당신의 대답을 기다리겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc51-Jaethal_Q3_start/Cue_0002_Text
#. Speaker : Jaethal_Companion
msgctxt "242b1a08-3937-46a4-9729-59a9a7cfec60"
msgid ""
"{n}Jaethal stares at you closely, as if trying to assess something. Is she "
"studying you, or considering the larger situation?{/n} \"I... suppose we "
"should meet with them. Back then, near the {g|Thorn River}Thorn River{/g}, "
"after the battle with the elven youngsters, I felt {g|Urgathoa}Urgathoa's{/g}"
" presence again — for the first time since I was reborn. Now I feel "
"something similar. A command. Or the shadow of one. Besides, I don't like to "
"leave my affairs unfinished. Let us put an end to this.\""
msgstr ""
"{n}제이탈은 무언가를 평가하려는 듯이 당신을 빤히 쳐다봤습니다. 그녀가 당신을 고려해서일까요? 아니면 더 큰 상황을 생각하는 "
"걸까요?{/n}\"나는...우리가 그들을 만나봐야 한다고 생각해. 일전에, {g|Thorn River}가시 강{/g}가 근처에서 어린 "
"엘프들과의 전투 후에, 나는 {g|Urgathoa}우르가쏘아{/g}의 존재감을 다시 한번 느꼈어. 내가 다시 태어난 이후 처음이었지. "
"지금도 비슷한 것이 느껴져. 명령. 아니면 그 그림자가. 게다가, 난 내 일을 끝나지 않은 채로 내버려 두는 걸 좋아하지 않아. 이 일을 "
"끝마치자고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc51-Jaethal_Q3_start/Cue_0007_Text
#. Speaker : Jaethal_Companion
msgctxt "4f7e7afb-b91f-480f-9ad7-239b013e759f"
msgid ""
"\"Is there a chance I might change your mind? I can't see any reason for you "
"to say no. This mission is extremely important to me. We'll both win if we "
"resolve the situation — one way or another.\""
msgstr ""
"\"마음을 바꿀 수는 없는거야? 왜 안된다고 하는지 알 수가 없어. 이 임무는 엄청나게 나에겐 중요한 것이야. 이 상황을 해결한다면 우리 "
"둘 다 승리하는 거야. 어떻게 해서든지 말이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc51-Jaethal_Q3_start/Cue_0008_Text
#. Speaker : Jaethal_Companion
msgctxt "1a65e653-b705-4107-afbf-a7bafa63f190"
msgid "\"I am ready to strike out at a moment's notice.\""
msgstr "\"당장이라도 출발할 준비가 되어 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc51-Jaethal_Q3_start/Cue_0010_Text
#. Speaker : Jaethal_Companion
msgctxt "45af26e2-1897-4160-90e3-7eb451ccd9eb"
msgid ""
"\"I doubt it. They are not official emissaries from {g|Kyonin}Kyonin{/g}. — "
"If they were, then their interference would look quite different. Most "
"likely these are the families of those foolish youngsters from the camp near "
"the {g|Thorn River}Thorn River{/g}. I assume they're inclined to fight, but "
"they won't set ambushes or try to stab you in the back. First, they will "
"surely try to negotiate. Elves, you know...\" {n}Jaethal allows herself a "
"sarcastic smirk.{/n}"
msgstr ""
"\"글쎄. 저들은 {g|Kyonin}쿄닌{/g}의 공식 사절단이 아니야. — 진짜 사절단이라면, 끼어드는 방식이 많이 달랐을거야. 이들은 "
"아마 {g|Thorn River}가시 강{/g} 근처 정착지에 있던 불쌍한 애들의 가족인것 같아. 싸우기로 마음먹은 것 같지만, "
"매복하거나 등 뒤를 기습할 생각은 없었고. 우선, 협상을 해보려 했겠지. 알다시피, 엘프니까...\" {n}제이탈은 비꼬듯이 "
"웃습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jaethal/ktc51-Jaethal_Q3_start/Cue_0014_Text
#. Speaker : Jaethal_Companion
msgctxt "c8a150d4-fedd-4799-b401-e0bf15111c19"
msgid "\"As you wish… I don't dare to distract Your Highness any further.\""
msgstr "\"원하는대로... 감히 전하의 주의를 분산시킬 생각은 없으니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Answer_0005_Text
msgctxt "f9094103-72dd-4e0f-8197-5ddfd9e7a6de"
msgid ""
"\"You want to use this opportunity to find out why the gnomes left the First "
"World – and how they might return. Right?\""
msgstr "\"너는 이 기회를 이용해서 노움들이 태초 세계를 떠난 이유를 – 그리고 어떻게 돌아갈 수 있을지를 알고싶군, 그렇지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Answer_0006_Text
msgctxt "7d543b45-a860-4171-bea5-9c6fb436faa7"
msgid "\"I don't. Tell me.\""
msgstr "\"그렇지 않아. 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Answer_0007_Text
msgctxt "61b6a2c8-fbf2-48a0-a174-5e82491a1302"
msgid "\"I don't know and I don't care. I'm not doing this.\""
msgstr "\"그게 뭔지 모르겠고 관심도 없어. 안 할 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Answer_0012_Text
msgctxt "2677ee15-6d15-48ce-bf29-ea682a20fa14"
msgid "\"Any information about the First World would be useful.\""
msgstr "\"태초 세계에 대한 어떤 정보라도 유용할거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Answer_0012_Text_1
msgctxt "7a37e514-919e-40aa-b4bb-838bdc42b233"
msgid "\"The Inconsequent Debates? What's that?\""
msgstr "\"비논리 토론회? 그게 뭐지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Answer_0013_Text
msgctxt "39dfd8e6-d2ac-43e2-b4cb-e1093db8ee4f"
msgid ""
"\"Do you know anything about these debates? Or are we completely in the dark "
"here?\""
msgstr "\"이 토론회에 대해 아는 게 있어? 우린 문외한인 건가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Answer_0014_Text
msgctxt "ba44d404-bc97-40b1-b576-d5323e8f8c16"
msgid "\"Can participating be dangerous?\""
msgstr "\"참가하면 위험할까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Answer_0015_Text
msgctxt "0438448a-ac62-4607-8c70-21c4cdc1725b"
msgid "\"We can't pass up such an opportunity. I agree to participate.\""
msgstr "\"이 기회를 놓칠 순 없지. 참가에 동의한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Answer_0016_Text
msgctxt "e976014b-11db-4234-a927-e645b8db7484"
msgid "\"I see no point in this.\""
msgstr "\"그건 아무 의미도 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Answer_0021_Text
msgctxt "964beb5e-fe03-460b-9cc3-cd126a4c2245"
msgid ""
"\"I've heard about them. Strange entertainments, held on Golarion by fey "
"lords from the First World. Strange tests with various unique rewards...\""
msgstr ""
"\"들어본 적이 있어. 태초 세계의 페이 로드에 의해 골라리온에서 개최되는 기묘한 여흥이지. 기묘한 시험들에 다양하고 독특한 보상들이 "
"있다고 들었는데...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Answer_0022_Text
msgctxt "5b0c73d2-bbb9-44d2-9b67-85705ba78fc0"
msgid "\"Keep your riddles to yourself. I'm not interested.\""
msgstr "\"네 수수께끼는 너만 알고 있어. 나는 관심이 없으니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Answer_0024_Text
msgctxt "d4a2d915-5421-4e68-928d-0caf8a333f94"
msgid "\"Who do you think we should take as our third?\""
msgstr "\"세 번째로 누굴 데려갈까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Answer_0028_Text
msgctxt "2dfdb3f4-7e6c-412c-8b01-16f024e5187f"
msgid "\"Fine, tell me about the debates.\""
msgstr "\"좋아, 그 토론에 대해 말해봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Answer_0029_Text
msgctxt "c4ac831f-14f0-4d07-92a4-4ea8b7a8c6c8"
msgid "\"And yet, I don't care.\""
msgstr "\"근데, 난 신경 안 써.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Cue_0001_Text
msgctxt "be1d4cd2-4412-41e0-9d32-47a4760063a9"
msgid ""
"\"Amazing. You managed to save your barony from an invasion of monsters from "
"{g|First World}the First World{/g}. But you were not able to protect it from "
"the attention of the First World's more powerful denizens. Believe it or "
"not, but {kingdomname} has been chosen as the next location for the "
"Inconsequent Debates!\""
msgstr ""
"\"놀랍군. {g|First World}태초 세계{/g}로부터의 괴물들의 침공에서 남작령을 구해내었어. 하지만 태초 세계의 더 강력한 "
"존재들의 관심으로부터 보호할 수는 없는 것이지. 믿거나 말거나, {kingdomname} 나라는 비논리 토론회의 다음 개최지로 "
"선정되었다네!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Cue_0002_Text
msgctxt "d3b073f9-bccf-4932-82e6-636b2c84c085"
msgid ""
"\"A curious phenomenon that isn't very well known. They say it's based on a "
"bet made by the {g|Eldest}Eldest{/g}, the rulers of {g|First World}the First "
"World{/g}, quite a long time ago. One day one of them sent a delegation of "
"fey to {g|Golarion}Golarion{/g}. They announced where the competition would "
"take place.\n"
"Don't let the name fool you, it's anything but debates. The contests begin "
"as soon as they have enough participants.\""
msgstr ""
"\"잘 알려지지 않은 기묘한 현상이지. 꽤나 오랜 시간 전에, {g|First World}태초 세계{/g}의 지배자들인 "
"{g|Eldest}원로{/g}가 만든 내기에 근거한 것이라고 말들 하지. 어느 날 그들 중 하나가 {g|Golarion}골라리온{/g}에 "
"그들을 대리할 페이를 보냈어. 그들은 경쟁을 치룰 장소를 발표했지.\n"
"명칭에 속지 말게, 그건 결국 논쟁일 뿐이니까. 충분한 참가자가 확보되자마자 대회가 시작될 걸세.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Cue_0003_Text
msgctxt "da762970-5e51-45e1-bf45-7d5d808bfaa7"
msgid ""
"\"The contests and the reward are different every time. Although 'every "
"time' is a stretch — only three such occasions are known over thousands of "
"years. Anyway, it's happened again! And this time the reward is a chance to "
"ask any question whatsoever of the Host, the competition's mastermind. This "
"creature, whoever it is, speaks on behalf of the {g|Eldest}Eldest{/g}. Do "
"you see why we can't miss such a chance?\""
msgstr ""
"\"대회와 그 보상은 매번 달랐지. '매 번'이라는 건 좀 비약이긴 하지, 천여 년 동안 고작 세 번 개최가 알려졌으니까. 어쨌든, 또 "
"다시 열린 걸세! 그리고 이번의 보상은 주최자나 대회의 우승자가 누구던 간에 어떠한 질문이든 할 수 있는 기회라네. 이 주최자가 어떤 "
"생명체인지 간에, 그는 {g|Eldest}원로{/g}를 대표해서 말하는 것이지. 이런 기회를 놓칠 수 없는 이유를 잘 알겠나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Cue_0008_Text
msgctxt "2a95f9b8-0ecd-4a4f-9e37-bc3f1c0d9072"
msgid ""
"\"But...\" {n}Jubilost loses his usual confidence for a moment.{/n} \"It's a "
"chance to gain new unique knowledge! What could be more important? Anyway, "
"I'm obviously talking to the wrong person. Waste your time playing at war "
"and running around swamps if that's all you care about.\""
msgstr ""
"\"그러나...\"{n}주빌로스트는 평소의 자신감을 잠시간 잃어버렸습니다.{/n}\"이건 새롭고 특별한 지식을 얻을 수 있는 기회라네! "
"이보다 중요한 것이 무엇이 있겠나? 어쨌든, 내가 사람을 잘못 붙잡고 말했군. 자네가 신경쓰는게 전쟁놀이와 늪지를 뛰어다니는 거라면 "
"거기에나 시간을 낭비하게나.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Cue_0009_Text
msgctxt "5b077422-e665-41e8-94d3-c692b3a248ed"
msgid ""
"\"Nice to see our association has left a mark on you. Yes, of course! I'm "
"none too happy that we'll have to play by the {g|Eldest}Eldest's{/g} rules. "
"You know my opinion of the fey lords isn't very high. But if that's what the "
"truth requires, then so be it. In the end, who would best know the answer to "
"my question, if not the self-appointed deities of {g|First World}the First "
"World{/g}?\""
msgstr ""
"\"우리의 유대가 자네에게 영향을 미친 것이 기쁘구만. 그래, 물론이지! {g|Eldest}원로{/g}의 규칙에 따라서 행해야 한다는 "
"것에 나는 조금도 기쁘지 않네. 내가 페이 군주들에 대해 높게 평가하지 않는 것을 알지 않나. 그러나 진실이 이를 요구하는 것이라면, "
"해야겠지. 결국, {g|First World}태초 세계{/g}의 이 자칭 신들이 아니라면, 누가 내 질문에 가장 잘 대답할 수 있겠나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Cue_0011_Text
msgctxt "bcad88e3-23c6-414b-9be7-15f294ba8656"
msgid ""
"\"Just think! We have an opportunity to ask a question of the Host — the "
"messenger of the self-appointed deities of {g|First World}the First World{/g}"
" — and demand an answer! The gnomes originally ventured from the First "
"World, lost their immortality because of it, and received our curse in "
"exchange. — the {g|Bleaching}Bleaching{/g}. No one has discovered the "
"reasons for it — and none can stave off its consequences. But if we managed "
"to win the competition...\""
msgstr ""
"\"생각해봐! {g|First World}태초 세계{/g}의 자칭 신들이 보낸 전령인 주최자에게 우리는 질문을 하고 답변을 요구할 수 "
"있는 기회가 있는거야! 노움들은 태초 세계로부터 모험을 떠나왔고, 그 때문에 그들의 불멸성을 잃고, 그 댓가로 "
"{g|Bleaching}백화{/g}라는 우리의 저주를 받았지. 어느 누구도 그 원인을 알아내지 못했고, 어느 누구도 그 결과를 피하지 "
"못했어. 그러나 우리가 경쟁에서 이길 수만 있다면...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Cue_0017_Text
msgctxt "c175b454-c879-40f1-a0cb-55029a7f041c"
msgid ""
"\"You never know what mad ideas the fey might have cooked up. I only know "
"one condition: only teams of three are allowed to participate.\""
msgstr ""
"\"그 페이가 어떤 미친 생각을 꾸며 냈는지 절대 알지 못할 걸세. 난 단 한가지 조건만 알고 있지. 3명으로 이루어진 팀만 참가할 수 "
"있다는 것을.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Cue_0018_Text
msgctxt "eb3975f2-fbb9-4c65-986b-8f95da0b4e79"
msgid ""
"\"Considering that the fey are involved — absolutely. But if the chronicles "
"are true, no one has died in any previous debate.\""
msgstr ""
"\"페이가 연관되어 있다는 걸 고려해보면, 그렇겠지. 그러나 그 연대기가 사실이라면, 앞서의 여느 논쟁에서도 죽은 사람은 없다네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Cue_0019_Text
msgctxt "47a35210-aecc-4cd3-8497-e3a7d68a60d4"
msgid ""
"\"Great! I'll mark the spot on the map where the competition will take "
"place. The sooner we arrive there, the better. The fey lords won't wait "
"forever!\""
msgstr ""
"\"훌륭하군! 이 경쟁이 벌어질 곳을 지도에 표시해 두겠네. 더 빨리 그곳에 도착하는 것이 더 좋겠지. 페이 군주가 영영 기다리지는 "
"않을테니!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Cue_0023_Text
msgctxt "c8385683-019b-4ae2-a1d9-ed54f57bdfe5"
msgid ""
"\"Your knowledge is — well, pleasantly surprising! It's true, the "
"Inconsequent Debates are anything but debates. They say that the "
"{g|Eldest}Eldest{/g} once made a bet. No one knows what it was, but "
"sometimes one or another of them sends a delegation of fey to "
"{g|Golarion}Golarion{/g}. Here they hold insane competitions for those who "
"volunteer to enter, and present the winners with whimsical awards.\""
msgstr ""
"\"네 지식은 음, 꽤나 놀랍군! 사실일세, 비논리 토론회는 그저 논쟁일 뿐일세. 한 때 {g|Eldest}원로{/g}들이 내기를 "
"했었다지. 아무도 그것이 무엇인지는 모르지만, 때때로 그들 중 누구 하나가 {g|Golarion}골라리온{/g}으로 대리자인 페이를 "
"보낸다네. 이곳에서 그들은 정신나간 자발적으로 참여하려는 이를 위한 경쟁을 개최하고, 기묘한 상을 승자에게 수여하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Cue_0025_Text
msgctxt "4a14c915-84d0-44c6-840a-7ed7afab1ed5"
msgid ""
"I think we should take Linzi. Something tells me fey are not likely to hold "
"competitions in rope pulling or beer drinking. But the skills of a bard "
"might come in handy. Besides, we should give the young lady a chance to "
"channel some of that energy!\""
msgstr ""
"\"린지를 데려가야겠군. 페이가 개최하는 경쟁이 줄다리기나 맥주 마시기 같은 것이 아니라는 거지. 그러나 음유시인의 기술들은 유용할 "
"걸세. 게다가, 젊은 숙녀에게 그 활기를 전달할 기회를 주어야 하지 않겠나!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc31-Jubilost_Q1_start/Cue_0026_Text
msgctxt "b39d1bb4-23c7-40ae-8ade-0a617ac10cdb"
msgid ""
"\"I insist that we take this chance. It's an opportunity to learn the "
"secrets of the fey, and possibly alter the fate of an entire race.\""
msgstr ""
"\"우리는 이 기회를 잡아야만 하네. 페이의 비밀을 알 수 있는 기회이자, 한 종족 전체의 운명을 변화시킬 수 있는 기회이네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc41-Jubilost_Q1_fail/Cue_0001_Text
msgctxt "17da6360-fdda-45ed-a576-2cde01e3f428"
msgid ""
"{n}Jubilost looks very irritated.{/n} \"Great! While we were busy with "
"needless and unsophisticated pastimes like chasing an ancient cyclops, the "
"Inconsequent Debates have ended! The Host has returned to {g|First World}the "
"First World{/g}. We're left with nothing! Congratulations.\""
msgstr ""
"{n}주빌로스트는 매우 짜증난 듯 보였습니다.{/n}\"훌륭하군! 우리가 고대의 싸이클롭스를 쫓는 따위의 필요없고 세련되지 않은 "
"오락거리로 바쁜 동안, 비논리 토론회는 끝나 버렸네! 주최자는 {g|First World}태초세계{/g}로 돌아가 버렸지. 우리에게 남은 "
"건 아무것도 없네! 축하하네.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc51-Jubilost_Q2_start/Answer_0006_Text
msgctxt "2b18c280-eab4-499a-9e09-55e5b263c12b"
msgid ""
"\"Obviously that part about 'he who is born twice, will twice be defeated' "
"referred to Armag...\""
msgstr "\"확실히 '두 번 태어난 자가, 두 번 패배할 것이니'라는 부분은 아르막을 의미하는 것 같군...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc51-Jubilost_Q2_start/Answer_0007_Text
msgctxt "b50a34c8-01a8-4127-ab01-8b85c372149e"
msgid "\"I'm sorry but I don't have the time or interest for this.\""
msgstr "\"미안하지만 난 시간이 없고, 이 건에 대해 관심도 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc51-Jubilost_Q2_start/Answer_0011_Text
msgctxt "cbe37f8a-db04-4cb3-a8f0-1fe2dac02b8c"
msgid ""
"\"All right. I will look for Gunderson's books and try to make some sense of "
"them.\""
msgstr "\"알겠어. 난 건더슨의 책을 찾고, 그걸 이해해 보기 위해 노력하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc51-Jubilost_Q2_start/Answer_0014_Text
msgctxt "531d2148-cd55-4b12-b59f-0f395895dc48"
msgid ""
"\"Do you think 'a dozen times in a dozen' is about something that happens "
"every month? There's a twenty-fourth day in every month – and there are "
"twelve of them in a year.\""
msgstr "\"매달 생기는 '열둘 속의 열두번\"이 뭐라고 생각하나? 매달 24일이 있지, 그리고 일년에 12번이 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc51-Jubilost_Q2_start/Cue_0001_Text
msgctxt "22b5e85b-1738-43b5-b252-553655df1154"
msgid ""
"\"You do remember our little adventure with the fey lords and their "
"Inconsequent Debates, damn them? Before you ask, by 'damn them' I meant both "
"the debates and the lords. Anyway, I've been thinking about that dreadful "
"verbiage we received as a 'reward' for the trials – the answer to the "
"question about the fate of the gnome race. Allow me to remind you of the "
"text...\""
msgstr ""
"\"페이 군주들과 비논리 토론회, 그 빌어먹을 것들과 함께한 우리의 작은 모험 기억해? 질문하기 전에, '빌어먹을 것들'은 이 논쟁과 "
"군주들 둘 다를 말한 거야. 어쨌든, 난 우리가 시험의 '보상'으로 받았던 노움 종족의 운명에 대한 질문의 해답이었던 그 끔찍한 장광설에 "
"대해 생각해보고 있었어. 그 글을 상기시켜보자면...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc51-Jubilost_Q2_start/Cue_0002_Riddle_Text_String
msgctxt "62884ddc-2c0c-4938-bfd8-fc49b7123fdd"
msgid ""
"\"Numbers will help you on your way,\n"
"One of them is fifth in ten,\n"
"It will be easy to find if you read\n"
"Who opened the road for the ancient dead man\n"
"And his black-feathered messenger.\n"
"The second is a dozen times in a dozen\n"
"And is thrice the number of those who lost their faces.\n"
"Don't try to guess it now – it's not yet time.\n"
"Wait until he who is born twice,\n"
"Will twice be defeated.\n"
"Put the two numbers together.\n"
"When the Moon leaves her path,\n"
"Near the waters of the {g|Candlemere}Candlemere{/g}\n"
"Find the one who will open the secret.\""
msgstr ""
"\"숫자들이 당신을 도울 것이니,\n"
"그 중 하나는 열 속의 다섯,\n"
"읽는다면 쉽게 찾아낼 것이도다.\n"
"고대의 죽은자 그리고 그의 검은 깃털의 전령,\n"
"이들을 위해 길을 연 자\n"
"두 번째는 열둘 속의 열두 번.\n"
"그리고 그 얼굴 잃은 자들의 수의 세 배.\n"
"지금 알려하지 마라, 아직은 때가 아니니.\n"
"그를 기다릴 지어다 두 번 태어난 자가,\n"
"두 번 패배할 것이니\n"
"두 숫자를 합하여.\n"
"달이 그녀의 길을 떠날 때,\n"
"{g|Candlemere}캔들미어{/g}의 물 가까이에서\n"
"비밀을 열 자를 찾으라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc51-Jubilost_Q2_start/Cue_0004_Text
msgctxt "11f8c42f-8660-4df8-abdf-416b2d90b914"
msgid ""
"\"Not a single reasonable creature would spend valuable time solving this "
"sort of phrase-mince. If only someone knew how much effort it required to "
"treat the matter seriously! But it paid off! It's obvious that the part "
"about 'opened the road for the ancient dead man and his black-feathered "
"messenger' refers to {d|Willas}Willas Gunderson{/d}, who awakened Vordakai. "
"This guess led me to think...\""
msgstr ""
"\"어느 이성적인 생명체라도 이런 종류의 구절 조각들을 맞추느라 소중한 시간을 쓰지 않겠지. 그 문제를 심각하게 다루기 위해 얼마나 많은 "
"노력이 필요한지 아는 이가 있다면 말야! 하지만 풀었지! '고대의 죽은자 그리고 그의 검은 깃털의 전령, 이들을 위해 길을 연 자'라는 "
"부분은 분명히 보다카이를 깨운 {d|Willas}윌라스 건더슨{/d}을 의미하는 걸세. 이 추축으로 미루어 보면...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc51-Jubilost_Q2_start/Cue_0008_Text
msgctxt "4676503f-c587-40ee-b9f7-2cfb5b962ca1"
msgid ""
"\"Exactly! We couldn't have known that at the time of the debates, because "
"we hadn't even met Armag yet. Which makes me wonder who this respected Host "
"might be... But that's neither here nor there.\""
msgstr ""
"\"정확해! 그 논쟁이 있을 때는 아직 아르막을 만나기 전이었으니 우린 알 수가 없었지. 이건 이 존경받을 주최자가 누구인지 궁금하게 "
"하는군...하지만 어디에도 없을테지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc51-Jubilost_Q2_start/Cue_0009_Text
msgctxt "452102a1-ad71-48c6-b0dd-b7abbf5b1bbc"
msgid ""
"\"So, what do we know? The riddle recommends we start looking after the "
"twice-born is twice defeated, and that's happened. The other part – 'thrice "
"the number of those who lost their faces' – that's also only clear now. It's "
"twenty four – three times the number of the Defaced Sisters there were! But "
"the rest... What does it mean, 'when the Moon leaves her path'? And how does "
"a dozen times in a dozen equate to twenty four? I'll have to study some "
"astronomy reference books and write to some priests of {g|Desna}Desna{/g} "
"that I'm acquainted with. It's probably about some rare celestial phenomenon."
"\""
msgstr ""
"\"그래, 우리가 아는게 무엇이지? 수수께끼는 두 번 태어난 자가 두 번 패배한 뒤에, 찾기를 시작하라 했고, 그대로 되었지. 다른 "
"부분인 '얼굴 없는 자들의 숫자의 세 배' 또한 이제 확실해 졌어. 얼굴 잃은 자매들의 숫자를 세 배로 한 숫자, 24이지! 그러나 "
"나머지는...'달이 그녀의 길을 떠날 때'가 무슨 뜻일까? 그리고 열 둘 속의 열둘이 어떻게 24와 같을 수 있지? 천문학 참고서를 좀 "
"공부하고 나와 안면있는 {g|Desna}데즈나{/g}의 사제들에게 편지를 써야겠군. 아마도 희귀한 천문 현상에 대한 것을 의미할거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc51-Jubilost_Q2_start/Cue_0010_Text
msgctxt "af28fef4-ef3e-499d-b759-27978c8bc288"
msgid ""
"\"I meant to ask you to deal with the first part of the riddle – the one "
"about {d|Willas}Willas Gunderson{/d}. Remember the riddle – we don't need to "
"find him or talk to him, just read him. Here is what I think it means: I "
"discovered that the poor fellow wrote and published a few horrendous books. "
"Perhaps the answer is hidden in one of them? The very thought of digging "
"through that parody of literature is disgusting. I'd very much appreciate – "
"yes, appreciate – some help. Perhaps some book-lover in this city will have "
"a volume or two of his 'work'?\""
msgstr ""
"\"수수께끼의 첫부분, {d|Willas}윌라스 건더슨{/d}에 관한 것을 처리해보자고 한 걸세. 수수께끼를 기억하나, 우리는 그를 찾을 "
"필요도 그와 이야기할 필요도 없지, 단지 그를 읽어내기만 하면 돼. 내가 생각한 것은 이걸세. 그 불쌍한 친구가 몇 권의 끔찍한 책을 "
"쓰고 출간했다는 사실을 발견했네. 어쩌면 해답이 그들 가운데 숨겨져 있지 않겠나? 형편없는 놀림감 같은 이 문학 속 생각들을 파헤쳐봐야 "
"한다는 것은 역겨운 일이지. 하지만 나는 매우 고맙게 생각한다네, 그래, 조금 도움이 되서 고맙지. 어쩌면 몇몇 이 도시의 몇몇 책을 "
"사랑하는 이들이 그의 '저작' 한 두권쯤 가지고 있지 않겠나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc51-Jubilost_Q2_start/Cue_0012_Text
msgctxt "882b16ce-2f39-4b1d-85a8-ce6791fc5712"
msgid ""
"\"Good luck on this difficult quest! I remind you: the riddle says we need "
"to find something 'fifth in ten' – and somehow related to Gunderson's "
"writing. We put it together with the number 'twenty four' and go to the "
"{g|Candlemere}Candlemere{/g}, 'when the Moon leaves her path'. I hope this "
"isn't some elaborate fey prank. Because if it is... I won't have to do any "
"more research to understand what made the gnomes leave {g|First World}the "
"First World{/g}. It was the stinking neighbors!\""
msgstr ""
"\"이 임무에 행운이 있기를! 정리해보자: 수수께끼는 우리가 '10개 중 5'와 관련된 무언가를 찾아야만 한다고 알려줬어. 그건 어떤 "
"식으로든 건더슨의 저작과 관련되어 있고. 그 뒤엔, 그 단서와 '24'라는 숫자를 조합해서 {g|Candlemere}캔들미어{/g}로 "
"가야해. '달이 그녀의 길을 떠날 때' 말이야. 이게 페이의 정교한 장난이 아니길 바래. 만약 그렇다면... 노움들이 {g|First "
"World}태초 세계{/g}를 떠나게 만든 것이 무엇이었는지에 대한 내 연구는 더 이상 진행될 수 없을 테니까. 아주 고약한 이웃들 "
"때문이었다 쳐야지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc51-Jubilost_Q2_start/Cue_0013_Text
msgctxt "b0ed37b7-2d86-4ef9-9e59-91a1d3c28c41"
msgid ""
"\"Of course. How dare I distract {mf|His|Her} Highness from such obviously "
"important things! Well, I think I'll manage without you. When ever have I "
"not?\""
msgstr ""
"\"당연하지. 어떻게 감히 내가 그런 명백히 중요한 것들로부터 당신의 관심을 딴 데로 돌리겠어! 그래, 나 혼자 할 수 있을 거야. "
"언제는 아니었나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Jubilost/ktc51-Jubilost_Q2_start/Cue_0015_Text
msgctxt "15226290-272b-40ca-918a-ee99135ec3a1"
msgid ""
"{n}Jubilost looks at you with suspicion.{/n} \"Everything can't be that "
"simple. Or can it? With the fey you never know! Well, it's a good guess, but "
"it still doesn't spare us the need to look at the dreadful books.\""
msgstr ""
"{n}주빌로스트가 당신을 의심의 눈초리로 바라봤습니다.{/n}\"모든 것들이 그렇게 단순하지 않을 수도 그럴 수도 있겠지. 자네가 페이에 "
"대해 아무것도 모른다면 말야! 그래, 좋은 생각이네, 그러나 그렇다고 해서 우리가 여전히 그 무서운 책을 볼 필요를 없애는게 아닐세.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc21-Linzi_Q1_Start/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "f5d8ab80-9f2b-44dc-9aae-5072665ec5e7"
msgid ""
"\"Bad news, Your Grace: there is a thief within your close circle. A "
"significant shortage has been discovered within the treasure. An "
"investigation is already underway — the guilty party will soon be brought "
"before you for judgment.\""
msgstr ""
"\"나쁜 소식입니다, 영주님. {mf|영주님|영주님|전하|전하}의 측근 중에 도둑이 있습니다. 국고가 상당히 부족해진 것을 "
"발견하였습니다. 조사가 이미 진행 중입니다. 영주님께 판결 받을 수 있도록 곧 대령시키겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc21-Linzi_Q1_Start/Cue_0002_Text
#. Speaker : Capital_Shandra
msgctxt "22a63872-f14f-4c1c-a27c-1259614643fe"
msgid ""
"\"Unpleasant but, alas, expected news: someone with access to the treasury "
"seems to have appropriated a large sum from it. The circle of suspects is "
"not particularly wide — I believe we will soon discover who was responsible."
"\""
msgstr ""
"\"불행하지만, 예상되었던 소식입니다. 누군가 국고에 접근해서 많은 돈을 착복한 것 같습니다. 용의자의 범위는 특별히 넓지 않습니다. "
"누구의 책임인지 곧 밝혀지리라 생각합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc21-Linzi_Q1_Start/Cue_0003_Text
#. Speaker : Capital_Lander
msgctxt "17601e66-9596-4dd1-8ed8-84fb6992a480"
msgid ""
"\"I'm sure it's unthinkable to you, but someone from your court has sticky "
"fingers! A large sum has vanished from the treasury. I've already started "
"looking for the responsible party.\""
msgstr ""
"\"상상할 수도 없는 일이라 생각됩니다만, 궁전의 누군가가 나쁜 손버릇을 가지고 있습니다! 국고에서 상당량이 사라져버렸습니다. 이미 "
"책임당사자들을 찾기 시작했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc21-Linzi_Q1_Start/Cue_0004_Text
#. Speaker : Linzi_Companion
msgctxt "35b4dc3d-c724-42be-b075-485526435409"
msgid ""
"\"I... Umm... I think I might know something about this, um, sad — no, "
"shocking! — most shocking event. Can we discuss it one-on-one, maybe? I'll "
"wait for you at the inn after council!\" {n}Without waiting for your reply, "
"Linzi runs out of the throne room.{/n}"
msgstr ""
"\"저....음...제가 이 일에 대해 뭔가 알고 있는 것 같아요, 음, 슬프게도, 아니, 충격적이네요! 가장 충격적인 사건이에요. "
"혹시, 일대일로 상담할 수 있을까요? 평의회 이후에 선술집에서 기다리고 있을게요!\" {n}당신의 답을 기다리지도 않고, 린지는 알현실을 "
"빠져나갔습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc21-Linzi_Q1_Start/Cue_0005_Text
#. Speaker : Capital_Kassil
msgctxt "cfd6bcfc-6275-44ae-82ef-ae13b77c9c90"
msgid ""
"{n}Kassil stares after the bard, surprised.{/n} \"I'd have never imagined "
"she would find herself connected to such a crime...\""
msgstr "{n}카실은 놀란 듯, 바드를 바라봅니다.{/n} \"그녀가 이런 범죄에 연관되어 있을 거라고는 상상조차 못했습니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc21-Linzi_Q1_Start/Cue_0006_Text
#. Speaker : Capital_Shandra
msgctxt "37a0cc59-dc3e-451d-8358-8bd3a2e46c58"
msgid ""
"{n}Shandra silently raises an eyebrow, but she refrains from commenting.{/n}"
msgstr "{n}샨드라는 조용히 눈썹을 치켜올렸지만, 언급하는 것을 자제했습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc21-Linzi_Q1_Start/Cue_0007_Text
#. Speaker : Capital_Lander
msgctxt "c91462af-979b-42f7-b7b0-f35b6320c6cf"
msgid "\"Oh? Perhaps this investigation will be quicker than I thought!\""
msgstr "\"오? 어쩌면 이 조사는 내가 생각했던 것보단 빨리 되겠군!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q1_Fail/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "5b980491-a66a-4e1d-a3ba-e4cf93e3bcfb"
msgid ""
"\"Remember how I wanted to talk to you about... well, about... No. No, "
"forget it. It's been a while, so it's probably not that important now.\""
msgstr ""
"\"제가 그 얘기 정말 하고 싶었던 거 아시죠... 그러니까, 무슨 얘기냐면... 아니다. 아니에요, 잊어버려요. 이제 와서 보니 그렇게 "
"중요한 문제는 아닌 것 같네요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Answer_0007_Text
msgctxt "ec692d45-4996-49f1-8a42-06817ddf3ce1"
msgid "\"Who's Eobald the Insightful?\""
msgstr "\"신통한 자 이오발드가 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Answer_0010_Text
msgctxt "37ea223e-8f40-4af1-95fb-912f8d283e1a"
msgid "\"Why did you run from Irovetti?\""
msgstr "\"이로베티로부터 도망친 이유가 뭐지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Answer_0012_Text
msgctxt "ed709f64-ff69-46fb-94f3-2efec2b2a8ec"
msgid "\"Why didn't you send word in advance?\""
msgstr "\"왜 미리 말하지 않았지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Answer_0014_Text
msgctxt "e1d39e8b-951c-459a-ac93-9d8c8a822a39"
msgid "\"Is something wrong, Linzi?\""
msgstr "\"뭔가 잘못된거야, 린지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Answer_0016_Text
msgctxt "8245eff0-70dd-40a3-af35-9c66292e1fee"
msgid "\"Where will we find Eobald and his students?\""
msgstr "\"이오발드와 그의 학생들을 어디서 찾을 수 있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Answer_0018_Text
msgctxt "de6bac68-6426-4e33-a51f-91b6e44d3db6"
msgid "\"Fine, we'll help your teacher.\""
msgstr "\"좋아, 우린 너의 선생을 도울거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Answer_0019_Text
msgctxt "b30d24df-fde0-4fd9-8023-589876af0ae8"
msgid "\"Get out. I don't care about you, or your teacher!\""
msgstr "\"나가, 너나 너의 선생에 신경쓰지 않을테니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Answer_0020_Text
msgctxt "a2f0e8e1-f4e6-4831-989b-47a0df6fda47"
msgid "\"I said no.\""
msgstr "\"안된다고 말했어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Answer_0025_Text
msgctxt "c0623a3e-2a6e-4d22-bc49-7afa5a7b35b1"
msgid "\"Why come to my lands?\""
msgstr "\"왜 나의 영지로 온 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0002_Text
#. Speaker : C31-Alondi
msgctxt "c970dd92-1b32-4307-aefa-3dd56afbe340"
msgid ""
"{n}A young man runs into the throne room. His clothes, formerly stylish and "
"sophisticated, are torn and muddy.{/n} \"Your Grace! Praise "
"{g|Shelyn}Shelyn{/g} I made it here alive. I beg you, please help us!\""
msgstr ""
"{n}한 젊은 남자가 왕좌의 방으로 뛰어 들어왔습니다. 전에는 우아하고 세련되었을 그의 옷은 찢기고 더러워져 있습니다.{/n}\"영주님! "
"살아서 이곳까지 온 것에 {g|Shelyn}셸린{/g}을 찬양할지라. 제발 부탁드립니다. 우릴 도와주십시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0003_Text
#. Speaker : Linzi_Companion
msgctxt "5bbc1aeb-e039-4d8f-8909-d13eefeb3954"
msgid ""
"\"Alondi? What... what in the Hells are you doing here?\" {n}Linzi blurts "
"out angrily.{/n}"
msgstr "\"알론디? 도대체...도대체 여긴 어쩐 일이야?\" {n}린지 화가 나 불쑥 말을 꺼냈습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0004_Text
#. Speaker : C31-Alondi
msgctxt "3244a045-d629-4fa2-b6a2-632e79d023d9"
msgid ""
"\"Oh, Linzi! I'm so glad to see you... Forgive me, Your Grace, for my lack "
"of decorum. My name is Alondi — I attended the {g|Pitax}Pitaxian{/g} {g|"
"Academy of Grand Arts}Academy of Grand Arts{/g} with Linzi. Our teacher, "
"Eobald the Insightful, has been forced to flee the wrath of King Irovetti "
"along with a group of his students. We almost made it to the capital, but we "
"were caught. Only I managed to escape to find help!\""
msgstr ""
"\"오, 린지! 널 보게 되서 기뻐...예의를 차리지 못한 점 용서해주세요, 전하. 제 이름은 알론디, "
"{g|pitax}피탁스{/g}의{g|Academy of Grand Arts}대 예술 아카데미{/g}에서 린지와 동문수학했습니다. 우리의 "
"선생님, 신통한 자 이오발드는 이로베티 왕의 분노를 사 그의 학생들과 함께 도망치게 되었습니다. 수도에 거의 다다를 뻔 했지만, 붙잡히고 "
"말았답니다. 오직 저만이 빠져나와서 이렇게 도움을 구합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0006_Text
#. Speaker : Linzi_Companion
msgctxt "3c4bb60c-c3df-4a51-8977-a3e573b13b0f"
msgid ""
"{n}Linzi opens her mouth, about to say something harsh, but she realizes the "
"gravity of Alondi's words and interrupts herself.{/n} \"You... What do you "
"mean? Professor Eobald is in trouble? {Name}, we have to help!\""
msgstr ""
"{n}린지는 입을 열고는 무언가 쏘아붙이려고 했지만, 알론디가 전하는 말의 무게를 느끼고는 끼어들었습니다.{/n} \"너...무슨 "
"뜻이야? 이오발드 교수가 위험에 처했다고? {Name}, 우리가 도와줘야 해요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0008_Text
#. Speaker : C31-Alondi
msgctxt "fefb38fd-828f-45cc-8694-88b32da2093e"
msgid ""
"\"He's a prominent researcher — a gatherer of myths and legends, author of "
"many essays on history and literary theory... Any cultured ruler would be "
"glad to welcome such a beacon of learning!\""
msgstr ""
"\"저명한 연구가예요. 신화와 전설을 수집하고, 역사와 문학 이론에도 많은 기여를 한 작가라고 알고 있어요. 교양을 쌓을 생각이라면, "
"이분의 가르침이 마음에 드실 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0009_Text
#. Speaker : Linzi_Companion
msgctxt "8572bcd8-981a-4d71-8080-1ea72de9e5d8"
msgid ""
"\"Professor Eobald was one of the wisest people in the whole {g|Academy of "
"Grand Arts}Academy{/g}... maybe in all the {g|River Kingdoms}River "
"Kingdoms{/g}! I knew the king would kick him out sooner or later. Like I "
"told you, Irovetti isn't interested in sages and scientists — he just wants "
"bootlickers and toadies!\""
msgstr ""
"\"이오발드 교수는 {g|Academy of Grand Arts}아카데미{/g} 전체에서 가장 현명한 사람들 가운데 "
"한명이었어요...어쩌면 {g|River Kingdoms}강의 왕국들{/g} 전체에서도요! 언젠가 그 왕이 그를 내쫓을 거라고는 생각했어요. "
"제가 말했듯이, 이로베티는 현자나 과학자들에게 관심을 두지 않아요. 그는 간신과 아첨꾼들만을 원하죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0011_Text
#. Speaker : C31-Alondi
msgctxt "e7e758e8-7951-45ff-8b72-9dec85a5cc62"
msgid ""
"\"King Irovetti's a jealous ruler — he doesn't intend to hand the title of "
"the region's cultural capital over to anyone. He may have thrown our teacher "
"out of the {g|Academy of Grand Arts}Academy{/g}, but he would rather see "
"Eobald dead than working for any of Pitax's neighbors. And if the refugees "
"return to {g|Pitax}Pitax{/g}, they won't be spared the chopping block!\""
msgstr ""
"\"이로베티 왕은 질투심이 많아요. 다른 통치자에게 '문화의 본거지'라는 칭호를 넘길 생각이 없답니다. 이로베티 왕이 {g|Academy "
"of Grand Arts}아카데미{/g}에서 이오발드를 쫓아내야 한다면, 차라리 교수님을 죽이지, 이웃 국가에 넘겨줄 생각은 없을 "
"거예요. 아카데미에서 가까스로 도망쳐 나온 사람들도, {g|pitax}피탁스{/g}에 돌아가면 교수형을 면치 못하겠죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0013_Text
#. Speaker : C31-Alondi
msgctxt "6d8b3318-454f-4de3-8654-9240a39ff453"
msgid ""
"\"Irovetti has spies everywhere. If our teacher had tried to contact you, we "
"wouldn't have made it out of {g|Pitax}Pitax{/g} at all.\""
msgstr ""
"\"이로베티는 어디에나 간자들이 있죠. 우리 선생이 당신과 연락하려 했다면, {g|pitax}피탁스{/g}를 빠져나올 수 없었을 겁니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0015_Text
#. Speaker : Linzi_Companion
msgctxt "c368c74b-8e56-46d9-9d50-7aa785da688b"
msgid ""
"\"No. Yes. Not important right now! We need to save Professor Eobald as soon "
"as possible!\""
msgstr "\"아니요, 맞아요. 지금 당장은 중요하지 않아요! 이오발드 교수를 가능한 빨리 구해내야만 해요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0017_Text
#. Speaker : C31-Alondi
msgctxt "f42b4dfd-b695-4088-973b-40c23c127ace"
msgid ""
"\"Irovetti's thugs caught up with us near a giant tree — a sycamore, I "
"think. If you go immediately, you should have time to intercept them!\""
msgstr ""
"\"이로베티의 폭력배들은 거대한 나무, 플라타너스 나무 근처에서 저희를 따라잡았습니다. 그 근처에서 우리를 따라잡았습니다. 지금 즉시 "
"간다면, 그들을 막을 수 있을 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0021_Text
#. Speaker : Linzi_Companion
msgctxt "fddd35c0-9ffc-4458-b6dd-43d7394f2bc4"
msgid ""
"\"Please don't let Irovetti get Professor Eobald! He's a shining beacon, "
"you'll see!\""
msgstr "\"이로베티가 이오발드 교수를 붙잡아가지 못하게 해주세요! 아시다시피, 그는 빛나는 등불이에요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0022_Text
#. Speaker : Linzi_Companion
msgctxt "5e098d8a-bbea-435d-91be-4edeeafda0c4"
msgid "{n}Sniffling, Linzi runs out of the throne room.{/n}"
msgstr "{n}훌쩍거리며, 린지는 왕좌의 방을 뛰쳐 나갔습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0023_Text
#. Speaker : C31-Alondi
msgctxt "5e4b208d-f7b1-425f-b941-39f93f85dc59"
msgid ""
"\"Thank you, Your Grace! You won't regret it! I'll hurry back to the tree.\""
msgstr "\"고맙습니다, 영주님! 후회하지 않으실 거예요! 저는 그 나무가 있는 곳으로 서둘러 돌아가겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0024_Text
#. Speaker : Linzi_Companion
msgctxt "18a5e5dc-bf18-41a4-9c39-e1eee0b79f51"
msgid ""
"\"I can't believe Irovetti actually kicked out Professor Eobald... Well, "
"it's his loss! We'll save him! Just don't go without me — I miss my old "
"teacher terribly!\""
msgstr ""
"\"이로베티가 정말로 이오발드 교수님을 내쫓다니 믿기지 않네요... 왜 손해 볼 짓을 하는지! 우리는 이오발드 교수님을 구하러 가요! 저 "
"없이 출발하진 마세요. 교수님이 정말 그립거든요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0026_Text
#. Speaker : C31-Alondi
msgctxt "b10c4ad4-f193-4d5d-b863-ea9658e0a1dd"
msgid ""
"\"One of the {g|Academy of Grand Arts}Academy's{/g} most talented students "
"already found shelter here after fleeing the tyrant's wrath.\" {n}Alondi "
"bows politely to Linzi.{/n} \"Your books are quite popular in "
"{g|Pitax}Pitax{/g} — they're a living reminder that culture yet blooms "
"beyond Irovetti's reach! We had hoped, Your Grace, that you would take us "
"under your protection as well.\""
msgstr ""
"\"{g|Academy of Grand Arts}아카데미{/g}의 가장 재능있는 학생 중 하나가 폭군의 분노로부터 도망쳐 이미 이곳에서 "
"안식처를 찾았지요.\"{n}알론디가 정중하게 린지에게 인사했습니다.{/n}\"{g|pitax}피탁스{/g}에서 네 책은 꽤 인기가 있어. "
"문화가 아직 이로베티의 손 안에 들지 않았다는 살아있는 증거지! 저희가 바라는 것은, 영주님. 당신께서 저희를 받아주시고 그 보호 아래 "
"두시는 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc31-Linzi_Q2_Start/Cue_0027_Text
#. Speaker : Linzi_Companion
msgctxt "86492930-442a-4ce7-8627-75369907b5e5"
msgid "{n}Linzi winces but says nothing.{/n}"
msgstr "{n}린지가 움찍했지만 아무 말도 하지 않았습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc41-Linzi_Q2_Fail/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "8eeaefb4-760a-4a3e-8ac5-51a5d658b930"
msgid ""
"\"I just heard... King Irovetti caught Professor Eobald and... and... "
"executed him. We were too late. Forgive me, Teacher...\" {n}Linzi sniffles "
"loudly, covering her face.{/n}"
msgstr ""
"\"제가 듣기로는...이로베티 왕이 이오발드 교수를 잡아서는...잡고는...그를 처형시켰대요. 우리가 너무 늦었어요. 용서해주세요, "
"선생님...\"{n}린지가 크게 훌쩍이며, 그녀의 얼굴을 감싸쥐었습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc51-Linzi_Q3_BookDone/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "0f27f378-8a18-45a8-a6c7-409bb79c5f6e"
msgid ""
"\"So, King Irovetti invited you for a visit? I have the perfect gift for him!"
"\" {n}With a smug look, Linzi shows you a thin paperback.{/n}"
msgstr ""
"\"그럼, 이로베티 왕이 방문해 달라 초대를 한 건가요? 저는 그를 위한 완벽한 선물을 가지고 있어요!\"{n}우쭐대는 표정으로, 린지는 "
"당신에게 얇은 책 한권을 보였습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc51-Linzi_Q3_BookDone/Cue_0002_Text
#. Speaker : Linzi_Companion
msgctxt "479e046e-e7ae-424f-a377-3892ff8c8778"
msgid ""
"\"Look through it when you have the time. The entire truth of the {g|Academy "
"of Grand Arts}Academy of Grand Arts{/g} and its so-called patron, Irovetti. "
"I hope it gives him a stroke when he reads it — then all your problems will "
"have solved themselves!\""
msgstr ""
"\"시간이 날 때 한번 살펴봐 주세요. {g|Academy of Grand Arts}대 예술 아카데미{/g}와 소위 그 후원자라 불리는 "
"이로베티에 관한 진실들이 담겨 있어요. 그가 이걸 읽을 때 두통에 쓰러졌으면 좋겠어요. 그러면 모든 문제가 저절로 해결될테지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc51-Linzi_Q3_BookDone/Cue_0003_Text
#. Speaker : Linzi_Companion
msgctxt "79635421-7333-4b8d-9e3d-5fa0d8e0e01d"
msgid ""
"\"Look through it when you have the time. The entire {d|Linzi Book "
"True}truth{/d} of the {g|Academy of Grand Arts}Academy of Grand Arts{/g} — "
"the truth about what the students, teachers, headmaster, and their great "
"patron Irovetti himself are doing behind their pretty facade!\""
msgstr ""
"\"시간이 날 때 한번 살펴봐 주세요. {g|Academy of Grand Arts}대 예술 아카데미{/g}의 {d|Linzi Book "
"True}진실{/d}이 담겨있어요. 학생들, 선생들, 교장 그리고 그들의 가장 큰 후원자인 이로베티가 그 멋진 허울 뒤에서 한 짓들의 "
"진실 말이죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Linzi/ktc51-Linzi_Q3_BookDone/Cue_0004_Text
#. Speaker : Linzi_Companion
msgctxt "c85960a9-501c-49a3-99f1-ce565a8e866b"
msgid ""
"\"The first press run is already on its way to {g|Pitax}Pitax{/g}. When you "
"go, don't forget to take me with you — I want to see the effects of the book "
"Professor Eobald and I wrote with my own eyes. I'm sure it'll be explosive!\""
msgstr ""
"\"{g|pitax}피탁스{/g}로 보낼 첫번째 인쇄가 이미 진행 중이에요. 가실때에 절 데려가는 걸 잊지 마세요. 이오발드 교수와 제가 "
"쓴 이 책이 어떤 영향을 미칠 지 제 두 눈으로 보고 싶어요. 그건 폭발적일거라 확신해요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0004_AlignmentShift.Description
msgctxt "28f0ab2b-6aa1-4dd0-aa8e-a3bee79060f7"
msgid "Agreed to listen to Nok-Nok's plea."
msgstr "녹-녹이 청원하는 것을 듣기로 하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0004_Text
msgctxt "203cf607-fb33-4bd1-966c-5d59d575bdcc"
msgid ""
"\"He helped us against the goblin tribes... I think I should return the "
"favor.\""
msgstr "\"그는 우릴 도와 고블린 부족과 맞섰습니다...그 호의를 이제 되갚아야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0005_Text
msgctxt "5ad4f632-679d-4f20-9244-a44b35db19ff"
msgid "\"I'll hear what he has to say. Send him in.\""
msgstr "\"그가 하는 이야기를 듣겠습니다. 그를 들여보내십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0006_AlignmentShift.Description
msgctxt "2d2eebec-03fd-45a7-a8fc-4b2b54ea1337"
msgid "Ordered to trick Nok-Nok and chain him in the dungeon."
msgstr "녹-녹을 속여 그를 사슬로 묶어 지하감옥으로 보내라 명령하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0006_Text
msgctxt "59ece8df-02b4-4522-a781-f3475a4d3c7c"
msgid ""
"\"Tell him I await him in the dungeon, and when he enters a cell, shackle "
"him there.\""
msgstr "\"그에게 내가 지하감옥에서 기다린다 전하고, 그가 감방에 들어오면 그에게 족쇄를 채우십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0007_AlignmentShift.Description
msgctxt "9b4e6ff7-aee6-48e7-b266-dd828cabf3fc"
msgid "Ordered Nok-Nok's execution."
msgstr "녹-녹을 처형하라 명하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0007_Text
msgctxt "3f21c3a3-604d-4e50-8ea3-1158bfa5df47"
msgid ""
"\"He has served his purpose. Have the guards take him and execute him.\""
msgstr "\"그는 그 목적을 다하였다. 경비병들이 그를 끌고가 처형하게끔 하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0008_Text
msgctxt "1063031b-a822-47c1-bb06-c81a5a8edb82"
msgid "\"Turn him away, I don't have time for him right now. Or ever.\""
msgstr "\"그를 돌려보내라, 그에게 내줄 시간은 지금도 없고 앞으로도 없을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0019_Text
msgctxt "7e2b743c-dc58-4974-ab5d-e02aca09c012"
msgid "\"How can you help?\""
msgstr "\"어떻게 도와줄까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0020_AlignmentShift.Description
msgctxt "77a913f9-d624-4376-8d8f-333ff6789d73"
msgid "Ordered to chain Nok-Nok."
msgstr "녹-녹을 사슬로 묶으라 명하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0020_Text
msgctxt "a4b33db1-6d96-4f05-8db6-0eb0bf1d5ee9"
msgid "\"Guards, have this creature thrown in chains.\""
msgstr "\"경비병, 이 생물체를 사슬로 묶어라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0021_AlignmentShift.Description
msgctxt "19d82252-1851-49de-ade8-6c86a41fcfaf"
msgid "Ordered Nok-Nok's execution."
msgstr "녹-녹을 처형하라 명하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0021_Text
msgctxt "743e7aac-71ad-4aad-92d2-5cbc83f276b7"
msgid "\"Guards, have this creature executed.\""
msgstr "\"경비병, 이 생물체를 처형하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0032_Text
msgctxt "edbe09cd-09a9-4610-8d5c-dbd560a69b83"
msgid "\"Very well. We'll travel to Oleg's soon.\""
msgstr "\"좋아. 올렉에게로 빨리 가도록 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0033_Text
msgctxt "662c7721-f3c8-4c37-a8ec-f243363c7aed"
msgid "\"Very well. I have instructions on how I want you to handle it.\""
msgstr "\"좋아. 네가 어떻게 처리했으면 하는지 설명을 해주지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0034_Text
msgctxt "3b3d686b-df26-4fdb-97d9-ae5e54fb9328"
msgid "\"If it keeps you out of here, go attend to it.\""
msgstr "\"그게 널 가게끔 한다면, 가보도록 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0035_Text
msgctxt "d0107104-37e2-4724-9a47-46482a539a70"
msgid "\"I'm not doing it.\""
msgstr "\"난 하지 않을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0039_Warden_Text
msgctxt "32a54d15-570d-46b7-b344-561fa0ca7ebd"
msgid ""
"\"I'll make you my specially-designated Warden, drive them out. By force, if "
"necessary.\""
msgstr "\"내가 널 나의 특별 지정 감시관으로 지정해서, 그들을 몰아낼거다. 필요하다면, 힘으로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0040_Councilor_Text
msgctxt "e2c03f14-49c2-4909-8ec4-eb9bdfa47d5a"
msgid ""
"\"Tell them you are my Councilor. Ask them, politely, to move elsewhere – I "
"don't want any bloodshed.\""
msgstr "\"그들에게 네가 나의 평의원이라 이야기해. 그들에게 물어봐, 교양있게, 어딘가로 이동하라고. 난 피를 흘리고 싶지 않아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0041_Diplomat_Text
msgctxt "5808d433-316f-424b-a6d0-6e183350be6f"
msgid ""
"\"Represent them as my Grand Dipl- er, Diplomat. Tell them they can set up a "
"new tribe, but at least twenty leagues from Oleg's. Downwind.\""
msgstr ""
"\"나의 수석 외교...어, 외교관으로서 그들을 대변하도록 해. 그들에게 새로운 부족을 새울 수 있다고 전해줘, 다만 적어도 올렉의 "
"교역소에서 20 리그 떨어진 곳으로. 바람이 부는 방향으로 해서.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0042_Text
msgctxt "f0987c88-92d3-418a-9657-2db7b1188ad5"
msgid "\"Not today, it's not worth our time.\""
msgstr "\"오늘은 아니야, 우리 시간을 쓸 만큼 가치가 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0045_Text
msgctxt "74ccb407-6719-469d-85f0-257c76c412ba"
msgid "\"'We'? No, this is a mission for you.\""
msgstr "\"'우리'? 아니야, 이건 너의 임무야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0046_Text
msgctxt "d07977d5-8774-41e4-b387-9041805698c9"
msgid "\"A Hero grows on his own – and through his accomplishments.\""
msgstr "\"영웅은 그 자신이 이룩한 업적을 통해 스스로 성장하는거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0047_Text
msgctxt "8930ee7e-986c-4997-a4a3-94053ecfca4a"
msgid "\"It may be wise if I shepherded... er, accompanied... you.\""
msgstr "\"그들을 이주시키는게 가장 현명한 해결책 같군... 어, 너도... 함께 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0048_Text
msgctxt "6ea61291-2f64-4c0e-8aa1-82e7dddea163"
msgid "\"Yes, let's resolve this quickly.\""
msgstr "\"그래, 빨리 해결하러 가자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0049_Text
msgctxt "2f8c1a93-e9b1-432b-82e7-a64dfd447ebf"
msgid "\"We'll depart when I say.\""
msgstr "\"내가 준비되면 출발하자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Answer_0050_Text
msgctxt "768c74cb-4519-4df7-8870-cd6e0bd02fd5"
msgid "\"No, I have other things to attend to.\""
msgstr "\"아니, 나는 다른 일들을 처리해야 한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0001_Text
#. Speaker : Capital_Kesten
msgctxt "465a071f-01a7-43b9-a508-48852bcde870"
msgid ""
"\"Your Grace...\" {n}Kesten coughs politely.{/n} \"The goblin... the one you "
"found, has asked to see you. He claims you are in need of... training. I "
"think he is rather in need of a bath. Several.\""
msgstr ""
"\"남작님...\"{n}케스턴이 정중히 기침합니다.{/n} \"당신이 찾은 고블린...이 알현을 요청합니다. 그는 당신이... 훈련이 "
"필요하다고 주장합니다. 제 생각엔 그에게 목욕이 필요한것 같습니다. 여러번.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0002_Text
#. Speaker : Capital_Jhod
msgctxt "dcd8e334-af71-466d-ab0e-2fa6e5334758"
msgid ""
"\"Your Grace...\" {n}Jhod coughs politely.{/n} \"The goblin... the one you "
"found, has asked to see you. He claims you are in need of... training. I "
"think he is rather in need of a bath. Several.\""
msgstr ""
"\"전하...\" {n}조드는 기품있게 기침을 한다.{/n} \"전하께서 데려 오신 그 고블린이...한번 만나자는 군요. 훈련을 하셔야 "
"한다고. 제 생각에는 먼저 그 고블린이 목욕부터 해야 할 것 같습니다만.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0009_Text
#. Speaker : Capital_Kesten
msgctxt "985fc0e3-11aa-4fba-980c-a6242daf10ee"
msgid ""
"\"Your Grace.\" {n}Kesten gives a nod, then nods to the guards, who file out "
"of the room.{/n}"
msgstr "\"예, 전하.\" {n}케스턴은 당신을 보고 고개를 끄덕였고, 줄지어 나오는 경비병들을 향해 고개를 까딱입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0010_Text
#. Speaker : Capital_Jhod
msgctxt "e4854b0a-533d-430b-b20d-b6a44d5c4f99"
msgid ""
"\"Your Grace.\" {n}Jhod gives a nod, then nods to the guards, who file out "
"of the room.{/n}"
msgstr "\"영주님.\"{n}조드가 고개를 끄덕이더니, 방에서 줄지어 나오는 경비병들에게 고개를 끄덕였습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0011_Text
msgctxt "138175a2-527d-44ef-9e7b-c7c35fefcafe"
msgid ""
"{n}You hear the sounds of weapons being drawn, a plaintive screech, and a "
"crash of metal, then silence. After a moment, a guard returns, nods, then "
"resumes his stance. After another moment, there is another screech, a loud "
"clang, then silence... then nothing.{/n}"
msgstr ""
"{n}당신은 무기를 뽑는 소리를 듣습니다. 애처로운 비명소리, 철끼리 부딪히는 소리, 그리고 정적. 그 다음 순간, 경비병이 돌아와서 "
"고개를 끄덕이고, 자세를 고쳐잡습니다. 또 다음 순간, 또다른 비명, 커다란 쇳소리, 그리고 정적... 뒤로는 아무것도 들리지 "
"않습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0012_Text_String
#. Speaker : Capital_Kesten
msgctxt "f2808284-ab3d-43e3-8fb3-2d63982464eb"
msgid "{n}You hear Kesten give a sigh of relief.{/n}"
msgstr "{n}케스턴이 안도의 한숨을 내쉬는 것을 들었습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0013_Text_String
#. Speaker : Capital_Jhod
msgctxt "54cae58e-9397-4fb0-b2ec-868148b7419f"
msgid "{n}You hear Jhod give a sigh of relief.{/n}"
msgstr "{n}조드가 안도의 한숨을 내쉬는 것을 들었습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0014_Text
#. Speaker : NokNok_Companion
msgctxt "3441965e-7849-4116-b7c0-c18b845f3604"
msgid ""
"{n}Nok-Nok strides in, as best as his short legs can manage, then his gait "
"slows, then stops as he takes in the throne room – his eyes and ears swivel "
"independently, as if trying to take every direction in at once – after "
"scanning the area around him, he looks upward, and squints, as if uncertain "
"if there's a ceiling above him or not. He stands still, swaying slightly, "
"eyes affixed on the ceiling.\n"
"Others in the throne room are disdainfully silent, some wrinkle their nose "
"and take a step back. Some of the guard's hands fall to the hilt of their "
"blades.{/n}"
msgstr ""
"{n}녹-녹이 다리를 최대한 벌려 성큼성큼 걸어왔습니다. 그의 걸음걸이가 느려지더니 알현실에서 멈춥니다. 주변의 모든 방향을 한번에 "
"탐색하기 위해 눈과 귀가 제각기 회전합니다. 위를 보고 곁눈질 합니다. 마치 그의 위에 무언가 있는지 확인하려는 것처럼말이죠. 그는 "
"여전히 멈춰있고 눈은 천장에 고정되어 있습니다.\n"
"알현실의 다른 편에는 조용하게 경멸적인 공기가 느껴집니다. 몇몇은 그들의 코를 잡고 뒤로 물러섭니다. 어떤 경비병들은 칼 손잡이로 손을 "
"향합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0015_Text
#. Speaker : NokNok_Companion
msgctxt "58959dd4-0a7a-4d3e-b358-b35132d935a2"
msgid ""
"{n}Nok-Nok's head snaps down, then seeing you, he gives a sickle-grin, his "
"eyes gleaming.{/n} \"Sidekick? Almost didn't see among all longshanks.\" {n}"
"He frowns at your throne, then cocks his head, confused.{/n} \"Why in my "
"chair?\""
msgstr ""
"{n}녹-녹이 머리를 내리고 당신을 쳐다봅니다. 그는 히죽 웃으며 반짝이는 눈빛을 보냅니다.{/n} \"조수? 꺽다리들 둘러봐도 안 "
"보였다.\" {n}그는 당신의 왕관을 보고 눈살을 찌푸렸습니다. 그리곤 혼란스러워 고개를 뒤로 젖혔습니다.{/n} \"왜 내 의자 위에 "
"있어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0016_Text
msgctxt "c23b1c78-015a-480d-a3c9-f794c17e9671"
msgid ""
"{n}There is a light chuckle from someone in the room, quickly silenced.{/n}"
msgstr "{n}방 안에 가볍게 킬킬대는 소리가 들리더니 곧 조용해집니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0017_Text
#. Speaker : NokNok_Companion
msgctxt "25448da9-d27e-45a6-a1a8-f177fcacc955"
msgid ""
"\"Took a while to find way here...\" {n}Nok-Nok glances around.{/n} \"...but "
"now here to take rightful place, be a Hero – and show you how to be a Hero.\""
" {n}He nods sharply, and hooks his fingers in his belt.{/n} \"I can help, "
"like before, side by side, Big Hero...\" {n}He points to himself.{/n} \""
"...and not Big Hero.\" {n}He pauses.{/n} \"You need it.\""
msgstr ""
"\"이쪽으로 오는 길 찾아다녔다...\" {n}녹-녹은 주변을 힐끗 봅니다.{/n} \"...그런데 영웅이 되기 딱맞는 곳 찾았다. "
"너에게 영웅이 되는 법 알려준다.\" {n}그는 빠르게 끄덕이더니 벨트에서 손가락을 구부립니다{/n} \"나 전처럼 도와줄 수 있다. "
"옆에서, 큰 영웅...\"{n}그는 자신을 가리킵니다.{/n} \"...난 큰 영웅 아니다.\" {n}그는 멈춥니다.{/n} \"너 이거 "
"필요하다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0022_Text
#. Speaker : Capital_Kesten
msgctxt "ee8e1ab7-5cbf-4b1a-af02-60547155ebde"
msgid ""
"{n}Kesten frown.{/n} \"Actually, Your Grace, if you are considering "
"accepting assistance from this... this...\""
msgstr "{n}케스턴이 찌푸립니다.{/n} \"사실 남작님. 이것... 이것으로부터 도움을 받을 지 고민중이시면\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0023_Text
#. Speaker : Capital_Jhod
msgctxt "5c6bc420-16ed-4c48-b636-062846041807"
msgid ""
"{n}Jhod frown.{/n} \"Actually, Your Grace, if you are considering accepting "
"assistance from this... this...\""
msgstr "{n}조드가 찌푸립니다.{/n} \"사실 남작님. 이것...이것으로부터 도움을 받을지 고민중이시면.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0024_Text
#. Speaker : NokNok_Companion
msgctxt "c5912bfb-05b8-45cf-8c2e-370df2c9ea4d"
msgid ""
"\"Nok-Nok.\" {n}Nok-Nok raps the ground with his heel twice for emphasis, "
"then winces.{/n}"
msgstr "\"녹-녹.\" {n}녹-녹이 바닥을 두 번 강조해 두드리더니 움찔합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0025_Text
#. Speaker : Capital_Kesten
msgctxt "f9b91403-d1db-45ed-9db8-bc137029b4b6"
msgid ""
"{n}Kesten's frown deepens.{/n} \"If this 'Nok-Nok' TRULY wishes to be of "
"help and is one goblins might listen to, there have been sightings of "
"goblins near Oleg's... possibly dispossessed by our recent encounter-\""
msgstr ""
"{n}케스턴의 주름이 깊어집니다.{/n} \"만약 '녹-녹'이 정-말로 도움을 주기를 원하고, 말이 통하는 유일한 고블린이라면, 올렉의 "
"교역소 근처에서 고블린들이 목격되었습니다... 최근의 소동으로 인해 빼앗긴 모양이더군요-\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0026_Text
#. Speaker : Capital_Jhod
msgctxt "221bacf1-5d47-45cc-9abc-aaee7bd31a56"
msgid ""
"{n}Jhod's frown deepens.{/n} \"If this 'Nok-Nok' TRULY wishes to be of help "
"and is one goblins might listen to, there have been sightings of goblins "
"near Oleg's... possibly dispossessed by our recent encounter-\""
msgstr ""
"{n}조드의 주름이 깊어집니다.{/n} \"만약 '녹-녹'이 정-말로 도움 주기를 원하고, 말이 통하는 유일한 고블린이라면, 올렉의 "
"교역소 근처에서 고블린들이 목격되었습니다... 최근의 소동으로 인해 빼앗긴 모양이더군요-\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0027_Text
#. Speaker : NokNok_Companion
msgctxt "38d8e217-bce4-4cab-857f-5cb6c025ec36"
msgid ""
"\"Massacre,\" {n}Nok-Nok corrects brightly.{/n} \"Chopped them all up except "
"those who ran fast. New tribe probably have very long legs, very hard to "
"catch.\" {n}His eyes alight, and he grins.{/n} \"But not for me, I can round "
"them up!\""
msgstr ""
"\"학살이다,\" {n}녹-녹이 똑똑히 정정합니다.{/n} \"모두 죽었다. 빨리 도망간 녀석들만 빼고. 새로운 부족은 다리가 엄청 "
"길거다, 잡기 매우 어렵다.\" {n}그의 눈에 불이 붙고, 낄낄대기 시작합니다.{/n} \"하지만 나보다는 아니다. 나는 녀석들을 잡을 "
"수 있다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0028_Text
#. Speaker : NokNok_Companion
msgctxt "7525d6a0-8c8c-4112-b616-0979e2b437f8"
msgid ""
"\"But...\" {n}He frowns again.{/n} \"But unless they were still being "
"chased, it's not like them to keep moving. Tires one out. They'd better stay "
"in the capital, like Nok-Nok, even if...\" {n}He wrinkles his nose.{/n} \""
"...it smell bad here.\""
msgstr ""
"\"하지만...\" {n}그는 또 얼굴을 찌푸립니다.{/n} \"하지만 녀석들이 여전히 쫓기는게 아니면, 다시 움직이지도 않을거다. "
"지쳤을거다. 차라리 그들도 녹-녹처럼 수도에 사는게 좋을 수도 있겠다. 여기서...\" {n}그는 코를 찌뿌립니다.{/n} \"여기에 "
"안좋은 냄새가 나겠지만.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0029_Text
#. Speaker : Capital_Kesten
msgctxt "ce712f8b-d36f-4f79-ba2f-0182e136da54"
msgid ""
"\"Ah... yes. Oleg has sent word of these goblins via courier, but he has "
"been reluctant to leave in case they raid the Post in his absence. "
"Apparently, they've been quite diligent in trying to raid his storeroom. If "
"your goblin ally could deal with them...\""
msgstr ""
"\"어... 그렇습니다. 올렉은 짐꾼을 통해 이 고블린들에 대한 이야기를 전달했습니다, 하지만 그는 고블린들이 습격할 가능성 때문에 "
"교역소를 떠나는 게 내키지 않는 모양입니다. 확실히, 녀석들은 그의 상점을 습격하려고 열심이었습니다. 당신의 고블린 동맹이 그들과 거래할 "
"수 있다면...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0030_Text
#. Speaker : Capital_Jhod
msgctxt "7115df90-7ae5-4f9f-bba0-27c18ac3c15d"
msgid ""
"\"Ah... yes. Oleg has sent word of these goblins via courier, but he has "
"been reluctant to leave in case they raid the Post in his absence. "
"Apparently, they've been quite diligent in trying to raid his storeroom. If "
"your goblin ally could deal with them...\""
msgstr ""
"\"어... 그렇습니다. 올렉은 짐꾼을 통해 이 고블린들에 대한 이야기를 전달했습니다, 하지만 그는 고블린들이 습격할 가능성 때문에 "
"교역소를 떠나는 게 내키지 않는 모양입니다. 확실히, 녀석들은 그의 상점을 습격하려고 열심이었습니다. 당신의 고블린 동맹이 그들과 거래할 "
"수 있다면...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0036_Text
#. Speaker : NokNok_Companion
msgctxt "972ccce4-8df8-4cc9-bb8c-2052dcb3627a"
msgid ""
"{n}Nok-Nok nods, then pauses as he sees you remaining seated.{/n} \"Do... we "
"go now?\""
msgstr "{n}녹-녹이 고개를 끄덕입니다. 그러더니 당신이 일어나는지 쳐다보려는듯 멈춥니다.{/n} \"그러면... 지금 가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0037_Text
#. Speaker : NokNok_Companion
msgctxt "38a365ec-0ada-4af3-bc61-a9f981753cbc"
msgid "{n}Nok-Nok's ears perk up in your direction.{/n}"
msgstr "{n}녹-녹의 귀가 당신 쪽으로 쫑긋거립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0043_Text
#. Speaker : NokNok_Companion
msgctxt "61d8bdd4-0219-47d7-b2f0-760a766a7284"
msgid ""
"{n}Nok-Nok nods, standing proudly. He makes what might be a ragged salute, "
"interrupted by him noticing something on his wrist, which he rubs away with "
"a frown.{/n} \"As you command, as a Hero w-\" {n}He rubs his wrist again, "
"then grunts.{/n} \"...will go. Lead to post, Nok-Nok follow!\""
msgstr ""
"{n}녹-녹은 자랑스럽게 서서 고개를 끄덕입니다. 그는 뻣뻣하게 경례 비슷한 것을 하려 했지만, 그가 항상 얼굴을 찡그린 채 문지르는, "
"손목에 있는 어떤 것에 정신이 팔리는 바람에 스스로 멈춥니다.{/n} \"명령대로 한다, 영웅이-\"{n} 그는 다시 손목을 문대더니, "
"이렇게 외칩니다.{/n} \"...간다. 교역소로 안내해라, 녹-녹이 따라간다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc31_GolbinTrouble_Start/Cue_0051_Text
#. Speaker : NokNok_Companion
msgctxt "59b9dc24-49eb-446a-9a26-37f3fae44588"
msgid ""
"{n}Nok-Nok shrugs.{/n} \"Might want to go quick-quick, goblins not known for "
"staying in a place for too long when longshanks around.\" {n}He makes what "
"might be a ragged salute.{/n} \"When longshanks good to go, Nok-Nok ready.\""
msgstr ""
"{n}녹-녹은 어깨를 으쓱댑니다.{/n} \"아마 빨리빨리 가야 할거다, 고블린들은 주위에 꺾다리가 있으면 한 곳에 오래 머무르지 않는다."
"\" {n}그는 뻣뻣하게 경례같은 것을 합니다.{/n} \"꺾다리가 준비되면 가자, 녹-녹은 준비됐다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc41_GoblinTrouble_Fail/Cue_0001_Text
msgctxt "0ea55c74-f0b3-4ee6-a720-918b2e4a386f"
msgid "\"No need to save Oleg's post anymore! Goblins left.\""
msgstr "\"더이상 올렉의 교역소를 도와줄 필요가 없다! 고블린들은 이미 떠났다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc41_GoblinTrouble_Fail/Cue_0002_Text
msgctxt "9a8bbf67-4e1e-48d5-ab60-d919bf20fb68"
msgid ""
"\"When you do nothing, and heroics happen themselves — is one still a Hero?\""
" {n}Nok-Nok scratches his head, lost in thought.{/n}"
msgstr ""
"\"너는 아무것도 안했는데, 영웅이 필요한 일이 저절로 끝났다 — 나는 아직 영웅이 맞나?\" {n}녹-녹은 머리를 긁어대며 생각에 "
"잠깁니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc41_LamashtuShrines_Start/Cue_0001_Text_String
#. Speaker : Capital_Jhod
msgctxt "b7150006-25ac-498a-9f52-1ed06dddd7b1"
msgid ""
"\"Your Grace, there is one small matter... a series of small matters, "
"actually, that's growing into a larger problem... your goblin... ally... "
"seems to have invited more of his tribe to the capital, and they are acting "
"as if… as if it is their home.\""
msgstr ""
"\"전하, 조금 문제가 생겼사옵니다. 사실, 점점 더 큰 문제로 발전해 가고 있지요. 전하의 고블린들이... 수도에 동족들을 더 초대하고 "
"있습니다. 그리고는 자기네 땅인양 코가 높아졌습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc41_LamashtuShrines_Start/Cue_0003_Text
#. Speaker : Capital_Kesten
msgctxt "5ae13589-579d-46c2-825e-7f096a0b0273"
msgid ""
"\"It seems your goblin ally and his tribe have been industrious – they are "
"erecting statues to {g|Lamashtu}Lamashtu{/g}, the Mother of Beasts right "
"outside the capital. Do... they do this with your leave?\""
msgstr ""
"\"그 녀석들은 신앙심이 너무 깊었는지 지금 수도 바깥에서 괴물들의 어머니 {g|Lamashtu}라마슈투{/g}의 조각상을 만들고 "
"있습니다. 이대로... 내버려 두지 않으시겠지요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc41_LamashtuShrines_Start/Cue_0004_Text
#. Speaker : Capital_Jhod
msgctxt "56c9a53f-2181-4329-9487-a4caaafc0f0c"
msgid ""
"\"It seems your goblin friend and his allies have been industrious in their "
"latest blasphemy – they are erecting statues to {g|Lamashtu}Lamashtu{/g}, "
"the Mother of Beasts right outside the capital. It's heresy, and it is "
"spreading fear and panic among the people.\""
msgstr ""
"\"그 녀석들은 신앙심이 너무 깊었는지 지금 수도 바깥에서 괴물들의 어머니 {g|Lamashtu}라마슈투{/g}의 조각상을 만들고 "
"있습니다. 이것은 저희에 대한 신성모독이며 사람들에게 공포심과 혼란을 불러 일으키고 있습니다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc41_LamashtuShrines_Start/Cue_0005_Text_String
#. Speaker : Capital_Jhod
msgctxt "8a004d96-c665-42d6-a3eb-5b5218a90baa"
msgid ""
"\"Could you please look into the matter? The guards are hesitant to deal "
"with the one close to you personally.\""
msgstr "\"부디 이 문제를 해결해 주시겠습니까? 경비병들은 전하와 가까운 자들인 고블린들을 어떻게 대할지 망설이고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0003_Text
msgctxt "a45001f2-c12a-44a6-9f1f-5baa0744b573"
msgid "\"I take it this is yours?\""
msgstr "\"네 작품이야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0004_AlignmentShift.Description
msgctxt "d36a8dd6-abd3-4540-a254-8e3791bfa556"
msgid "Made fun of Nok-Nok."
msgstr "녹-녹을 웃겼습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0004_Text
msgctxt "524bd29b-64bd-4910-880d-b40522bce99f"
msgid ""
"\"So you've finally decided to show me your favorite piece of underwear?\""
msgstr "\"그래서 네가 가장 좋아하는 속옷이 뭔지 보여주기로 한거야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0005_Text
msgctxt "b665aba2-ecbf-40c2-a87a-680727794d6a"
msgid "\"Take this trash away from me!\""
msgstr "\"내 앞에서 이 쓰레기들 좀 치워!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0009_Text
msgctxt "1e4bfbd2-8395-4880-b90d-843557397b67"
msgid "\"What's it doing here?\""
msgstr "\"여기서 뭐하는거야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0010_Text
msgctxt "de2eae11-b069-4631-9c0f-687ec7c05392"
msgid "\"Well, get rid of this excuse of a codpiece.\""
msgstr "\"좋아, 복장을 빌미삼아 저 녀석을 제거하자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0011_Text
msgctxt "7a48c988-3cff-446c-a550-d4a0a2046cd0"
msgid "\"Good for you, you got your cap back.\""
msgstr "\"잘됐네. 네 모자를 돌려받을 수 있겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0014_Text
msgctxt "20949f7c-ea06-48bd-8083-3cc06f06b60a"
msgid "\"What do you mean, challenge?\""
msgstr "\"도전이라니, 무슨 뜻이야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0015_Text
msgctxt "67a6f89f-9c0e-4429-bcce-12c270306d1b"
msgid "\"The King has returned? Why would he humiliate himself?\""
msgstr "\"왕이 돌아왔다고? 그가 왜 스스로 웃음거리가 되려 하는건데?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0019_Text
msgctxt "3839aed4-d1e2-4d43-8aee-46d060338fec"
msgid "\"Then we need to stop him.\""
msgstr "\"그러면 우리가 그를 막아야겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0020_Text
msgctxt "0248ea5e-f264-4cad-bde8-0c6090904994"
msgid "\"Then you need to stop him.\""
msgstr "\"그러면 네가 그를 막아야겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0021_Text
msgctxt "b3222d0e-e925-4a82-a5e4-f9f866b9d931"
msgid ""
"\"If you can lead me to him, I'll go with you – but the fight must be yours."
"\""
msgstr "\"네가 나를 데려가준다면, 나도 너와 함께 할게 – 하지만 싸움은 네 몫이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0022_Text
msgctxt "1dacb551-caa1-4c01-b183-0570e04b7773"
msgid ""
"\"I don't have time for goblin politics. This is your mess, you deal with it."
"\""
msgstr "\"나는 고블린들 정치에 쓸 시간이 없어. 너와 관련된 일이니, 네가 처리해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0025_Text
msgctxt "cd75c92b-a669-4dd2-a2c6-61505c467316"
msgid "\"You wanted to be a Big Hero, so this is it. Go, prove yourself.\""
msgstr "\"너는 큰 영웅이 되고싶어했지, 그건 바로 지금이야. 가, 스스로를 증명할 기회야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0026_Text
msgctxt "fb729ea8-b255-48bd-98aa-5ab36127562d"
msgid "\"All right, I'll help you, but we have to be quick.\""
msgstr "\"좋아, 내가 널 도울게, 하지만 재빨리 끝내야해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0032_Text
msgctxt "34636990-3fdf-4d37-a36e-b06de301c3d5"
msgid "\"That's... not ominous.\""
msgstr "\"이건... 딱히 불길하진 않은데.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0033_Text
msgctxt "c729e641-624b-43f9-b873-1f43c925cd55"
msgid "\"An enchantment? This may be Nyrissa's work.\""
msgstr "\"주술인가? 나이리사의 작품일 수도 있겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Answer_0034_Text
msgctxt "85066978-ba7e-4ea6-a84c-ed55a65bac2c"
msgid "\"Did your tribe ever deal with demons?\""
msgstr "\"네 부족이 악마와 거래하기라도 했어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Cue_0001_Text
msgctxt "5114f2cc-4bc6-4a51-b7ec-88cbba5a5354"
msgid ""
"{n}Nok-Nok seems confused. You notice what seems to be a leather rag in his "
"hands. It smells faintly of... sulfur.{/n}"
msgstr ""
"{n}녹-녹은 혼란에 빠진것 같습니다. 당신은 그의 손에 들린 누더기 가죽처럼 보이는 무언가를 알아차립니다. 거기서 희미하게... 유황 "
"냄새가 납니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Cue_0006_Text
msgctxt "08fccdcd-23b5-434f-aa97-23cd4f50eacc"
msgid ""
"{n}Nok-Nok remains frozen as he stares at the cap in hands – he seems "
"surprised and uneasy.{/n} \"Was once mine, wore in the village. "
"{d|GoblinKing}King{/d} once rip it off my head, beat me across skull and "
"face with it... then use as wiperag, and hit me again. Thought was lost, "
"long ago.\""
msgstr ""
"{n}녹-녹은 그의 손에 들린 모자를 봤을 때부터 쭉 얼어붙어 있었습니다 – 그는 놀라움, 그리고 불안정한 상태로 보입니다.{/n} \"한"
" 때 내꺼였고, 마을에서 썼었다. {d|GoblinKing}왕{/d}이 내 머리에서 벗겨갔고, 날 때려눕히고 나서, 내 앞에서 "
"흔들어대더니... 걸레로 사용했다. 그리고 또 때렸다. 기억 안난다, 오래된 일이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Cue_0007_Text
msgctxt "241bf3b6-9323-4dec-83ae-8e337ed3f5ff"
msgid ""
"{n}A series of light chuckles travel across the room. The startled goblin, "
"however, doesn't react to your joke.{/n}"
msgstr "{n}가벼운 웃음소리가 방 전체에 퍼집니다. 하지만, 놀란 고블린은 당신의 장난에도 반응하지 않습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Cue_0012_Text
msgctxt "42aaa6ba-e382-45bd-b85e-0349e2c672c1"
msgid ""
"{n}Nok-Nok looks uneasy.{/n} \"It's a challenge, for ruler of tribe. The "
"King... has come back for me. But... cap look strange, smell strange. Why "
"now?\" {n}He glances around.{/n} \"Where it come from? Goblin come here, "
"drop it off?\""
msgstr ""
"{n}녹-녹은 불안해보입니다.{/n} \"족장에 대한 도전이다. 왕이... 내 앞에 돌아왔다. 하지만... 모자는 이상하다. 냄새도 "
"이상하다. 왜 지금이지?\"{n} 그는 주변을 훑어봤습니다.{/n} \"어디서 가져온 거야? 여기 있는 고블린들이 떨어뜨렸나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Cue_0016_Text
msgctxt "49401065-1ac6-4b9a-bc55-71b655523955"
msgid ""
"{n}Nok-Nok takes a deep breath.{/n} \"When goblins in Steal Lands fight for "
"tribes, they fight over big, best hat. Hat like crown, but not ugly and "
"shiny like yours – this is a challenge, another tribe.\""
msgstr ""
"{n}녹-녹은 깊게 숨을 쉽니다.{/n} \"도둑질 땅의 고블린 부족이 서로 싸울 때는, 크고 훌륭한 모자를 위해서다. 왕관같은 모자, "
"네 것 처럼 잘생기고 반짝이는 것을 위해 싸운다 – 이건, 다른 부족의 도전이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Cue_0017_Text
msgctxt "9153a393-7d44-46ce-b652-5bae4961592a"
msgid ""
"{n}He swallows.{/n} \"Maybe he hear of our allying. Think he can get back "
"crown by fighting me.\" {n}Nok-Nok looks confused – well, more so than usual "
"– and one of his ears begins to twitch.{/n} \"But how he get power back?\" "
"{n}He finally shrugs.{/n} \"If in kingdom now, probably cause a lot of "
"trouble.\""
msgstr ""
"{n}그는 침을 삼킵니다.{/n} \"놈이 우리의 동맹을 들은 것 같다. 나와 싸워서 자기 왕관을 되찾을 수 있다고 생각한다. \" {n}"
"녹-녹은 당황한 걸로 보입니다 – 물론, 평소보다 훨씬 더요 – 또한 그의 한쪽 귀가 떨리기 시작합니다.{/n} \"하지만 어떻게 힘을 "
"되찾았지?\" {n}그는 마침내 으쓱했습니다.{/n} \"만약 지금 왕국 안이었다면, 많은 문제가 생겼을거다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Cue_0023_Text
msgctxt "b83f04a5-eacd-4ab1-92e7-ecc244aac38a"
msgid ""
"{n}Nok-Nok shakes head, worried.{/n} \"Not sure can do on own. If he back, "
"he's ready for me.\""
msgstr ""
"{n}녹-녹은 불안해져서 머리를 흔듭니다.{/n} \"혼자 해낼 수 있을지 모르겠다. 그가 돌아왔다면, 나와 싸울 준비도 됐을거다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Cue_0027_Text
msgctxt "4f2c39c8-a15f-4ff1-9d3e-f999b9ccb7b6"
msgid ""
"{n}Nok-Nok nods, then leans down, then with a shaking finger, turns the cap "
"over... on the inside, you see a map scrawled in red.{/n} \"He show us the "
"way... we meet him where {g|Lamashtu}Lamashtu{/g} Shrines are. We need to "
"come together, you and me. Rules of challenge.\""
msgstr ""
"{n}녹-녹은 고개를 끄덕였고, 이내 몸을 웅크렸습니다. 그리고 떨리는 손으로 모자를 눌러씁니다... 거꾸로요, 당신은 빨간색으로 휘갈긴 "
"지도를 볼 수 있습니다.{/n} \"그는 방법을 알려줬다. 우리는 {g|Lamashtu}라마슈투{/g}의 동상으로 가서 그를 만나야 "
"한다. 우리는 함께 가야한다, 너와 내가 함께. 도전의 규칙이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Cue_0028_Text
msgctxt "cec6d56b-8f53-4a98-9728-282c4952450d"
msgid ""
"{n}As you glance at the map, you both are surprised as the leather cap "
"suddenly alights, burning brightly... then crumbles to ash on the floor.{/n}"
msgstr ""
"{n}당신이 지도를 쳐다보자, 가죽 모자에 갑자기 불이 붙었고, 밝게 빛나더니... 잿더미가 되어 바닥으로 바스라지고, 둘 모두 깜짝 "
"놀랍니다. {/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Cue_0029_Text
msgctxt "47a48465-94be-469d-a191-6ed14671fbbf"
msgid ""
"{n}Nok-Nok's face collapses as he leaves you. You slightly wonder if he will "
"actually take up this challenge at all.{/n}"
msgstr "{n}나가면서 녹-녹의 표정이 어두워집니다. 당신은 그가 정말로 이 도전을 받아들일지 살짝 궁금해집니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Cue_0031_Text
msgctxt "eafb698c-2d11-43e3-9840-2bb168b0ffda"
msgid ""
"{n}Nok-Nok nods, then leans down, then with a shaking finger, turns the cap "
"over... on the inside, you see a map scrawled in red.{/n} \"He show us the "
"way... we meet him where {g|Lamashtu}Lamashtu{/g} Shrines were. We need to "
"come together, you and me. Rules of challenge.\""
msgstr ""
"{n}녹-녹은 고개를 끄덕였고, 이내 몸을 웅크립니다. 그리고 떨리는 손으로 모자를 눌러씁니다... 거꾸로요, 당신은 빨간색으로 휘갈긴 "
"지도를 볼 수 있습니다.{/n} \"그는 방법을 보여줬다. 우리는 {g|Lamashtu}라마슈투{/g}의 동상 터로 가서 그를 만나야 "
"한다. 우리는 함께 가야 한다, 너와 내가 함께. 도전의 규칙이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_KingRevege_Start/Cue_0035_Text
msgctxt "a66f24f3-dd92-4ef7-8503-0020458f0e43"
msgid ""
"{n}Nok-Nok is silent, staring at the ash – he says nothing. You've never "
"seen him this worried. You decide to give him space, but keep the challenge "
"in the back of your mind.{/n}"
msgstr ""
"{n}녹-녹은 조용히 – 아무 말도 하지 않고 잿더미를 쳐다봅니다. 당신은 그가 이토록 걱정하는걸 본 적이 없습니다. 당신은 그에게 "
"시간을 주기로 결정했지만, 도전에 대한 것을 잊지 않았습니다.\"{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_LamashtuShrine_Fail/Cue_0001_Text_String
msgctxt "4a28cc0e-fb98-49c8-bddd-d5f617372d39"
msgid ""
"\"Your Highness, it seems the goblin tribe has left the kingdom. Good "
"riddance, if you ask me! Everyone seems happy… except your goblin ally, "
"perhaps.\""
msgstr ""
"\"전하, 고블린 부족이 왕국을 떠났습니다. 제 생각엔, 좋은 일입니다! 모든 사람들이 즐거워합니다... 아마 당신의 고블린 친구만 "
"뺀다면 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc51_Statue/Cue_0001_Text_String
msgctxt "d7327e4e-9f27-4332-927e-7fb0a95233a0"
msgid ""
"\"Your Highness, there is something transpiring outside the city. You may "
"want to go yourself – it seems your goblin... ally... has been industrious "
"again and fashioned some sort of... something.\" {n}He sighs.{/n} \"It may "
"be best you go see for yourself.\""
msgstr ""
"\"전하, 도시 외곽에서 이상한 일이 발생했습니다. 아무래도 가보셔야할 것 같습니다 – 당신의 고블린...동맹...들이 또 다시 "
"바빠져서는 어떤...뭔가를 준비하는 것 같습니다.\" {n}그는 한숨을 내쉽니다.{/n} \"직접 보셔야 할 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc_NokIsBack/Answer_0004_Text
msgctxt "f27acd15-f61f-4c8d-afa6-80066260590b"
msgid "\"Yes… you anticipated my test. Of course. Well done.\""
msgstr "\"그래... 내 시험이라고 생각했잖아. 물론, 아주 잘했어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc_NokIsBack/Answer_0005_Text
msgctxt "2dbc7a3e-f899-4027-9fa8-7b3bb8967a39"
msgid ""
"\"Not yet. Stay here while I figure out the next... more confining... "
"challenge.\""
msgstr "\"아직 아니야. 내가 다음... 더 어려운... 도전을 준비할 때까지 여기서 기다려.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc_NokIsBack/Answer_0006_Text
msgctxt "7c3d1f05-0f45-48c5-9a34-e96a5c9b110e"
msgid "[Attack] \"I'm tire of your antics, creature. I'll silence you now.\""
msgstr "[공격한다] \"너희들의 익살도 이제 질렸다. 모조리 침묵시켜주마.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc_NokIsBack/Answer_0010_Text
msgctxt "cd377f19-c3ec-47bd-8ffd-7e1d57c99f83"
msgid "\"How did you escape execution?\""
msgstr "\"어떻게 처형대에서 탈출했지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc_NokIsBack/Cue_0001_Text
msgctxt "c009df7c-eba5-4981-9ead-46a10ee442ac"
msgid ""
"{n}From out of nowhere, Nok-Nok is standing before you, trying to whistle, "
"but it comes out more of a warbling of the tongue. When he sees you, his "
"eyes gleam in delight.{/n} \"You start Nok-Nok's {d|Nok Prison}training{/d} "
"early! Very clever, longshanks keep Nok-Nok almost thinking they try to "
"chain him up like all goblin children.\""
msgstr ""
"{n}쥐도 새도 모르게, 녹-녹이 당신의 뒤에 서있었습니다. 그는 휘파람을 불려고 했지만, 소리는 혓바닥이 갈리는 것에 더 가깝습니다. "
"그가 당신을 봤을 때, 그의 눈은 기쁨으로 빛납니다.{/n} \"너는 녹-녹의 {d|Nok Prison}훈련{/d}을 벌써 시작했다! "
"엄청 똑똑하다, 꺾다리는 다른 모든 고블린 아이들처럼 녹-녹도 묶어둘거라고 생각했다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc_NokIsBack/Cue_0002_Text
msgctxt "f28f259c-380e-4c33-97c4-cded02f7c890"
msgid ""
"\"But Nok-Nok knows better, be slipping out of cage when little countless "
"times!\" {n}He holds up a long link of chain, then dumps it on the ground "
"where it lies like a black iron snake.{/n} \"Training done!\" {n}He "
"pauses.{/n} \"Am I Hero now?\""
msgstr ""
"\"하지만 녹-녹은 더 좋은 방법을 안다, 저런 감옥쯤은 순식간에 탈출할 수 있다!\" {n}그는 긴 사슬을 들고 있다가, 검은 강철 "
"뱀처럼 보이도록 땅바닥에 던집니다.{/n} \"훈련은 끝났다!\" {n}그는 잠시 멈춥니다.{/n} \"나도 이제 영웅이야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc_NokIsBack/Cue_0007_Text
msgctxt "354e9fb5-5b88-43ec-b1e2-ec9ec1adb976"
msgid "\"Another test so soon!\""
msgstr "\"곧 또 다른 시험을 치를거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc_NokIsBack/Cue_0008_Text
msgctxt "b13112f0-cf8a-4fa6-a16d-015e1590efdc"
msgid ""
"{n}From out of nowhere, Nok-Nok is standing before you, looking slightly "
"confused. When he sees you, he grins, his eyes gleaming in delight.{/n}"
msgstr ""
"{n}쥐도 새도 모르게, 녹-녹이 살짝 당황한 채로 당신의 뒤에 서있었습니다. 그가 당신을 보자, 그는 활짝 웃고, 그의 눈동자는 "
"기쁨으로 반짝입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc_NokIsBack/Cue_0009_Text
msgctxt "671c5803-a983-46da-a413-d08d43a9b738"
msgid ""
"\"You start Nok-Nok's {d|Nok Executed}training{/d} early! Very clever, Nok-"
"Nok almost thinking longshanks try to kill him. But Nok-Nok know better!\" "
"{n}He raps his head twice, winces, then his slow smile returns.{/n}"
msgstr ""
"\"너는 녹-녹의 {d|Nok Executed}훈련{/d}을 벌써 시작했다! 엄청 똑똑하다, 녹-녹은 정말로 꺾다리가 녹-녹을 죽이려는 "
"줄 알았다. 하지만 녹-녹은 더 잘 안다!\" {n}그는 머리를 두 번 두드리고, 움찔했다가, 천천히 그의 미소를 되찾습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc_NokIsBack/Cue_0011_Text
msgctxt "2676018c-7e61-4b73-b979-1dee3c23a693"
msgid ""
"{n}Nok-Nok pulls down the collar of his ragged vest, revealing huge bruises "
"on his neck – and then removes his cap, showing his head, which looks to "
"have a few more lumps than before.{/n} \"Neck tough.\""
msgstr ""
"{n}녹-녹은 그의 너덜더덜한 가슴팍까지 목줄을 당겼고, 그의 목에 난 커다란 멍자국을 보여줍니다 – 그리고 나서 모자를 벗고, 이전보다 "
"더 울퉁불퉁해 보이는 머리를 보여줍니다. {/n} \"목 아파.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc_NokIsBack/Cue_0012_Text
msgctxt "78017726-7252-4ab2-be2a-3628a07bf915"
msgid ""
"\"Also, when guard not looking, loosen axe head – axe fall off, guard hit me "
"in head with handle, but Nok-Nok head too tough for that... guard so "
"surprised, Nok-Nok bite him in leg, then grab teeth with keys...\" {n}He "
"pauses, thinking, rubbing his head.{/n} \"No... keys. With teeth.\""
msgstr ""
"\"게다가, 경비병이 안보일 때 도끼 머리를 느슨하게 만들었다 – 도끼가 떨어졌을 때, 경비병은 도끼 자루로 내 머리를 때렸다, 하지만 "
"녹-녹의 머리는 그것보다 훨씬 단단했다... 경비병이 놀랐을 때, 녹-녹은 그의 다리를 물었다, 그리고 열쇠로 이빨을 잡았다...\" "
"{n}그는 말을 멈춘 뒤, 생각하다가, 머리를 문지릅니다.{/n} \"아니다... 열쇠를. 이빨로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc_NokIsBack/Cue_0013_Text
msgctxt "2b4b75b2-da13-4332-b9af-caadd6bad2be"
msgid ""
"{n}He smiles again.{/n} \"Guard chase, hit Nok-Nok a few times in head, but "
"can't follow in sewer. Now Nok-Nok free again. Am I Hero now?\""
msgstr ""
"{n}그는 다시 웃습니다.{/n} \"경비가 쫓아와서, 녹-녹의 머리를 몇 번 때렸다. 하지만 하수구까지 쫓아오지는 못했다. 녹-녹은 다시 "
"자유가 됐다. 이제 나도 영웅이야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/NokNok/ktc_NokIsBack/Cue_0014_Text
msgctxt "0e5190cc-6338-4458-a2bf-b9e7ad064b1d"
msgid ""
"\"I Hero now! Hero better than... all other heroes!\" {n}He doesn't seem to "
"hear you.{/n}"
msgstr ""
"\"나는 이제 영웅이야! 다른 모든 영웅들보다... 더 나은 영웅!\" {n}그는 더이상 당신의 말을 듣고있는 것 같지 않습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Answer_0007_Text
msgctxt "dcd0eee1-d0fa-4051-8125-491049fe0d62"
msgid "\"How do you know they're from the Technic League?\""
msgstr "\"그들이 기술연맹인 걸 어떻게 알았지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Answer_0010_Text
msgctxt "3caa92d7-80e0-4624-84a1-b2d04430d299"
msgid "\"What are you planning?\""
msgstr "\"계획이 무엇이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Answer_0015_Text
msgctxt "8a0ab2e2-d842-4d8d-b48c-c819932bd466"
msgid "\"All right. Let's go find out what the Technic League's doing here.\""
msgstr "\"좋아. 기술연맹이 뭘 하려는지 보러가자\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Answer_0016_Text
msgctxt "59358409-db01-41b5-914d-217ecf555d6a"
msgid ""
"\"I have trouble enough without any Numerian wizards. Guards! Get down to "
"the tavern and throw this spy out of the city.\""
msgstr ""
"\"난 누메리아의 마법사 따위 없이도 넘치도록 문제를 가지고 있다. 경비병! 주점에 내려가 그 스파이를 도시 밖으로 쫓아내라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Answer_0022_Text
msgctxt "bbf4fe6b-b0fb-4171-9728-3b08147ed015"
msgid ""
"\"If they return, the guards will just throw them out again. Leave the past "
"in the past — we have more urgent problems.\""
msgstr "\"만약 놈들이 돌아온다면, 경비병은 즉시 제차 쫓아낼 것이다. 과거는 과게 나겨둬라 - 더 긴급한 문제가 있다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0001_Text
msgctxt "abc1dacc-a49c-4ec3-9349-9fd7cf8726d0"
msgid ""
"{n}Octavia and Regongar exchange a look and both start talking at the same "
"time.{/n}"
msgstr "{n}옥타비아와 레콘가르는 시선을 교환하고 동시에 입을 떼었다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0002_Text
#. Speaker : Octavia_Companion
msgctxt "ebede17d-3f6b-4796-b4ff-9a0997865fb1"
msgid "\"Do you think...\""
msgstr "\"네 생각은...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0003_Text
#. Speaker : Regongar_Companion
msgctxt "dd67a5e5-74c9-4a3e-91f2-b6cd36a40797"
msgid "\"We...\""
msgstr "\"우린...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0004_Text
#. Speaker : Octavia_Companion
msgctxt "ca3c033c-68ed-4b2d-8150-f4a5f20a98bd"
msgid ""
"\"We knew the {g|Technic League}Technic League{/g} wouldn't just let us go!\""
msgstr "\"{g|Technic League}기술 연맹{/g}이 우리를 가만히 놓아주지 않겠구나 싶었어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0005_Text
#. Speaker : Regongar_Companion
msgctxt "353e0860-0ab1-48ae-b279-948b6e01f2d0"
msgid ""
"\"And they sent their agent right here to the capital! Now that's impudence!"
"\""
msgstr "\"그리고 그들은 바로 이곳 수도에 그들의 요원들을 보냈어! 뻔뻔하긴!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0008_Text
#. Speaker : Octavia_Companion
msgctxt "51c91e1f-bd8c-458e-a733-f33aaa0ac932"
msgid ""
"\"He's sitting in a tavern, paying with {g|Numeria}Numerian{/g} gold, and "
"asking around about Reg and me all day. Even if he's not spying for the {g|"
"Technic League}Technic League{/g}, we sure have a few questions for him!\""
msgstr ""
"\"그는 선술집에 앉아, {g|Numeria}누메리아{/g}의 금화로 지불하고, 나와 레그에 대해 하루종일 묻고 다녔어요. 그가 "
"{g|Technic League}기술 연맹{/g}의 첩보원이 아니더라도 몇 가지 물어볼 게 있어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0009_Text
#. Speaker : Regongar_Companion
msgctxt "09fbf732-a6dc-4b4c-8430-f7daac826e7b"
msgid ""
"\"It's Kalannah — the wretch you {d|OctReg Kalannah Alive}let go{/d} after "
"you saved us from her! She's sitting in the tavern drinking beer like "
"nothing ever happened! Does she think no one will recognize her?\""
msgstr ""
"\"바로 칼라나였다 — 그 년 손아귀에서 우리를 구해주던 날 {d|OctReg Kalannah Alive}목숨을 부지한{/d} 떨거지! "
"아무일도 없었던 것마냥 선술집에 앉아선 맥주를 퍼마시고 있어! 정말 아무도 못알아볼거라고 생각한건가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0011_Text
#. Speaker : Octavia_Companion
msgctxt "dfee8315-3206-4c60-a249-d1159b9641ee"
msgid ""
"\"Or maybe she expects someone to. Either way, we have to talk to her.\""
msgstr "\"아니면 누가 알아보길 기대했을지도. 어쨌든, 그녀와 만나 얘기해봐야겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0012_Text
#. Speaker : Regongar_Companion
msgctxt "0dec0da1-2efe-4b90-9330-2b9db2302606"
msgid ""
"\"What do you think? Once you get someone outside, it's not that hard to "
"beat some information out of them...\""
msgstr "\"어떻게 생각하지? 네가 사람을 보낸다면 그들한테 정보를 빼내기 어렵지 않을 것 같은데...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0013_Text
#. Speaker : Octavia_Companion
msgctxt "51c4d4fe-1959-4bc4-9a93-09b480b2ebc7"
msgid ""
"\"Reg, that can wait. I'd like to start with a chat, try to find out what "
"exactly they have planned. They wouldn't just send one agent in. And "
"wherever the cronies are hidden...\""
msgstr ""
"\"레그, 잠시 기다려봐. 우선 대화부터 나누고, 정확히 그들이 뭘 계획하는지 알아보고 싶어. 아마 한 명만 보낸 게 아닐거야. "
"만약 동료가 숨어있기라도 하면...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0014_Text
#. Speaker : Regongar_Companion
msgctxt "f0802ab0-6ea7-4af5-aabb-d03fb4aaace5"
msgid ""
"\"That's where we'll find the big fish!\" {n}Regongar slams his fist into "
"his palm with a grin.{/n}"
msgstr "\"우리가 대어를 낚을 시점이지!\" {n}레곤가르가 히죽 웃으며 그의 손바닥을 주먹으로 쳤습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0017_Text
#. Speaker : Regongar_Companion
msgctxt "efae37b4-80ed-49c7-8780-3acfb480a3b8"
msgid ""
"\"Wait, don't you understand? They came here for a reason — for us! And that "
"means...\" {n}Regongar clenches his fists.{/n} \"Maestro Janush must be "
"here, too! This is our chance for revenge!\""
msgstr ""
"\"잠깐, 이 상황이 이해가 안돼? 그들은 볼 일이 있어 찾아온거야 — 바로 우리에게! 그리고 그 말은...\" {n}레곤가르는 주먹을 "
"쥐었습니다.{/n} \"마에스트로 자누쉬도 같이 왔다는 소리겠지! 복수의 시간이 왔다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0018_Text
#. Speaker : Octavia_Companion
msgctxt "444edd62-00d7-4a61-af76-e48a54437dfa"
msgid ""
"\"Regongar's right — they're here for us. Even if we were to suddenly "
"forgive Janush and forget about revenge, the {g|Technic League}Technic "
"League{/g} won't ever leave us be. They'll keep coming, again and again, "
"attacking us and those we care about. Let's just deal with them once and for "
"all!\""
msgstr ""
"\"레곤가르 말이 맞아 — 그들은 우리를 찾으러 왔어. 설사 우리가 갑자기 복수를 포기하고 자누쉬를 용서한다고 해도, {g|Technic "
"League}기술 연맹{/g}은 결코 우리를 가만 놔두지 않을거야.우리와 우리 친구들을 공격하러 계속, 계속 찾아오겠지. 친구들을 "
"위해서라도 다시 한 번 무찔러주자!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0019_Text
#. Speaker : Octavia_Companion
msgctxt "68bda455-c3f0-4ba1-a086-35240f3bbfbf"
msgid "\"Great!\""
msgstr "\"좋아!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0020_Text
#. Speaker : Regongar_Companion
msgctxt "76d8c5e2-9378-45f9-9109-a2a6611ce7cc"
msgid "\"We'll wait for you in the tavern.\""
msgstr "\"선술집에서 기다리지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0023_Text
msgctxt "98a0eddc-d5bf-4bc7-8fc5-8961010b5039"
msgid ""
"{n}Regongar stares angrily for a long moment before turning and storming out "
"of the room.{/n}"
msgstr "{n}레곤가르는 잔뜩 화난채로 긴 시간 노려보다가 쾅 소리를 내며 떠납니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc31-Q2_Start/Cue_0024_Text
#. Speaker : Octavia_Companion
msgctxt "dc4518ad-691f-4b89-924b-9129bbf0456d"
msgid ""
"\"You may be right... but I'm afraid it's not so easy to let go of a past "
"like ours. And it definitely won't let go of us...\""
msgstr ""
"\"네 말이 맞을수도 있어... 하지만 우리의 과거를 그냥 잊어버리는 건 쉽지 않아. 게다가 그 과거가 우릴 놓아주려 하지도 않겠지..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc51-Q2_Fail/Cue_0001_Text
msgctxt "02bce14b-217b-4c26-9b49-ee309257cec8"
msgid "{n}Octavia and Regongar exchange gloomy looks.{/n}"
msgstr "{n}옥타비아와 레곤가르는 우울한듯 서로 시선을 주고받습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc51-Q2_Fail/Cue_0002_Text
#. Speaker : Regongar_Companion
msgctxt "041aece4-2c54-4ab3-8409-d8edb234e7a6"
msgid ""
"\"Remember when we said we saw a spy from the {g|Technic League}Technic "
"League{/g} in the capital? We should have hustled. While we were packing, "
"the scum up and vanished.\""
msgstr ""
"\"우리가 수도에서 {g|Technic League}기술 연맹{/g}의 첩자를 찾았다고 했던 것 기억해? 그 때 서둘러야 했어. 우리가 "
"짐을 싸는 동안, 그 찌꺼기 녀석이 떠나버렸어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc51-Q2_Fail/Cue_0003_Text
#. Speaker : Regongar_Companion
msgctxt "7ee38289-be30-48cc-b64e-35b7513533a3"
msgid ""
"\"Remember how we found out about that {g|Technic League}Technic League{/g} "
"lair, where Janush had dug in? Scouts report the wretches left the kingdom. "
"It's too late to catch them — they're probably already in "
"{g|Numeria}Numeria{/g} by now.\""
msgstr ""
"\"우리가 자누쉬가 숨어있는 {g|Technic League}기술 연맹{/g}의 은신처를 찾았다고 한 것 기억하나? 정찰병들에게 그 "
"쓰레기들이 왕국을 떠났다는 보고를 받았다. 이제와서 따라잡긴 너무 늦었어 — 아마 지금쯤이면 {g|Numeria}누메리아{/g}에 있겠지."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc51-Q2_Fail/Cue_0004_Text
#. Speaker : Octavia_Companion
msgctxt "dd987899-704f-46f9-8189-5477ac7aa4ca"
msgid ""
"\"I guess we'll never know what the {g|Technic League}Technic League{/g} "
"wanted... Now if only they'd never come back. I don't think for a minute "
"they'll just leave us alone — but we'll probably never get such a lucky "
"chance to take them unawares again.\""
msgstr ""
"\"우리는 더이상 {g|Technic League}기술 연맹{/g}의 의도를 알 수 없을거야... 지금 녀석들이 다시 돌아오지 않는다면. "
"난 그들이 절대로 우릴 가만 놔두지 않을거라고 생각해 — 하지만, 이번처럼 그들이 방심했을때 제압할 수 있는 기회는 두 번 다시 찾아오지 "
"않을걸.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc51-Q3_Start/Cue_0001_Text
#. Speaker : Octavia_Companion
msgctxt "bd72a601-8c66-492f-a2ca-3f31c249df51"
msgid ""
"\"Remember those books from Maestro Janush's study? We'd hoped to find "
"something about our past in them...\""
msgstr "\"자누쉬의 연구실에서 발견한 책을 기억해? 여기서 우리의 과거에 대해 뭔가 찾아 봤는데...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc51-Q3_Start/Cue_0002_Text
#. Speaker : Regongar_Companion
msgctxt "e8381aed-7e37-4238-b52a-ddcf77774c35"
msgid "\"Well... we did. And I'm kind of sorry we looked.\""
msgstr "\"음... 찾긴 찾았는데, 좀 아쉽게 되었어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Octavia_Regongar/ktc51-Q3_Start/Cue_0003_Text
#. Speaker : Octavia_Companion
msgctxt "0e85d26f-2005-4489-8c14-b08c17824105"
msgid ""
"\"We actually found something, but it's... a sensitive conversation. We'll "
"wait for you in the palace garden, near the viewing point.\""
msgstr "\"단서를 찾긴 했는데... 좀 민감한 내용이야. 전망대 근처 정원에서 기다리고 있을게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Fail/Cue_0001_Text
msgctxt "ebdbe047-d2b4-46f2-a0c1-1b71fd08259a"
msgid ""
"\"Looks like we missed our chance to find these strange cultists, discussing "
"their goddess. Let's hope we don't regret it...\""
msgstr "\"그들의 여신에 대해 토론하는 이상한 광신도들을 잡을 기회를 놓친 것 같습니다. 후회할 일이 되지 않기를...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Answer_0005_Text
msgctxt "afedd18a-ea24-4932-bd5d-1cfd3f52afb8"
msgid "\"That insane old man, Remus — he also spoke of some Goddess...\""
msgstr "\"그 미친 노인 레무스도 여신을 언급했지...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Answer_0006_Text
msgctxt "e9012f29-17ad-494f-a3ba-3f3d6606a7be"
msgid "\"What is this 'kingdom' the prophet is building?\""
msgstr "\"이 예언이 언급하고 있는 '왕국'이란 무슨 의미지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Answer_0007_AlignmentShift.Description
msgctxt "ff5c77fa-d03d-46f2-8dea-9e42cae49481"
msgid "Decided to remove dangerous fanatics from the streets."
msgstr "위험천만한 광신도들을 거리에서 몰아내기로 결정했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Answer_0007_Text
msgctxt "07d0fa8d-62f3-448c-8239-6a768acf208b"
msgid ""
"\"I cannot allow my subject to be taken in by such nonsense! I shall deal "
"with these provocations immediately.\""
msgstr "\"내 백성들이 이런 말도 안 되는 얘기에 감화되다니 용납할 수 없다! 이런 도발 행위에 즉시 대처하겠어\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Answer_0008_Text
msgctxt "060f57e9-0e50-4700-8604-ff9fb5e69ed4"
msgid ""
"\"The people will believe whatever they want to believe. Leave the poor "
"souls be.\""
msgstr "\"백성들은 믿고 싶은 것은 그게 뭐가됐든 믿고야 말겠지. 가엾은 영혼들은 그대로 둬.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Answer_0009_AlignmentShift.Description
msgctxt "c69aabf4-7a51-4e6b-b93a-a21aadfd548f"
msgid "Decided to protect your subjects from malicious beliefs."
msgstr "악의적인 믿음으로부터 백성들을 보호하기로 결정했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Answer_0009_Text
msgctxt "72396400-c543-4ba8-8ea2-664576e5433c"
msgid ""
"\"It's absurd, and dangerous, for the people to consider death a blessing. "
"We must get to the bottom of this.\""
msgstr "사람들이 죽음을 축복으로 여기는 것은 터무니 없을 뿐더러 위험한 생각이다. 우리는 이 문제의 진상을 규명해야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Answer_0010_Text
msgctxt "eaa3ca26-21b0-434e-a908-e90fef39b207"
msgid "\"I'm not going to waste my time on this.\""
msgstr "\"이런 일에 시간낭비 하지 않겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Answer_0014_Text
msgctxt "4c635988-d32f-476d-8496-9fd283f79e19"
msgid ""
"\"Troubling news indeed. We must find out who or what is behind this Goddess "
"and her faith.\""
msgstr "\"이건 정말 곤란한 소식이군. 우리는 이 여신을 향한 신앙심의 배후에 누가 있고 또 무엇이 있는지 알아내야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Answer_0018_Text
msgctxt "b32d6f99-9635-4c72-943f-31bb804e97df"
msgid "\"Fine, I'm convinced. Let's look into this matter.\""
msgstr "\"좋아, 결심했다. 다른 방식으로 풀어보지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Answer_0019_AlignmentShift.Description
msgctxt "3ff10661-fb9f-4c93-8e09-e480629c576f"
msgid ""
"Threw Tristian out of the throne room when he asked to solve the mystery of "
"the dangerous cultists."
msgstr "위험한 광신도들에 대한 미스터리를 풀어달라 요청한 트리스티안을 알현실에서 쫓아냈습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Answer_0019_Text
msgctxt "671c4bde-bbba-4d7c-ba5f-4f1794f9f245"
msgid "\"You're beginning to annoy me. Get out!\""
msgstr "\"나를 화나게 하는군. 당장 나가!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Answer_0022_Text
msgctxt "df8ba3fc-1a29-4fec-a493-4bd39c41ee4c"
msgid "\"I said, enough!\""
msgstr "\"그만!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Cue_0001_Text
msgctxt "9f33d821-f514-427e-9983-1d1598ac980f"
msgid ""
"\"{name}, spare me a few minutes. You are the ruler of these lands and I "
"don't dare tell you what to do, but I just can't stand silently and watch "
"what's happening behind your back!\""
msgstr ""
"\"{name}, 잠시만 시간을 내주세요. 당신은 이 땅의 통치자이고 저는 감히 당신께 무엇을 하라고 말씀드릴 수 없지만, 이렇게 조용히 "
"서서 당신 등 뒤에서 일어나는 일들을 바라만 보고 있을 수는 없습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Cue_0002_Text
msgctxt "766e1dbc-96d4-469c-a90a-57aec16b37aa"
msgid ""
"\"There are rumors on the streets of a savage Goddess, enraged by your "
"appearance in her lands. They say she cursed you, and now you bring woe and "
"death to everyone around you. This used to be just idle talk. But now, when "
"we're surrounded by so much death and suffering, the people are ready to "
"truly believe it. And it seems that someone is playing upon your subjects' "
"fears.\""
msgstr ""
"\"지금 거리에는 한 야만적인 여신에 대한 소문이 나돌고 있습니다. 이 여신은 당신이 그녀에 땅에 나타난것에 진노하고 있다고 합니다. "
"사람들이 말하길, 그녀가 당신을 저주하여 당신 주변의 모든 이들에게 비통함과 죽음을 가져온다고 합니다. 이전까지 이런 소문들은 흔하게 "
"나도는 이야기들에 불과했습니다. 그러나 지금처럼 우리 주변에 이토록 많은 죽음과 고통에 둘러싸여 있을 때는, 사람들은 그것을 진실로 "
"받아들일 것입니다. 아무래도 누군가가 백성들의 공포를 이용하고 있는 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Cue_0003_Text
msgctxt "1348a55f-16b3-466f-b51c-12b7969c0c39"
msgid ""
"\"I saw barkers in the streets telling citizens of a prophet who is building "
"his own kingdom. According to them, the Goddess stands ready to grant "
"forgiveness to any who cleanse themselves of the curse... But this cleansing "
"is accomplished through a terribly cruel death.\" {n}Tristian gulps "
"heavily.{/n} \"These horrific deaths involve a wild beast appearing from "
"inside the body... and they think it's a blessing!\""
msgstr ""
"\" 저는 거리에서 '자신만의 왕국을 세우고자 하는 예언자'에 대한 이야기를 시민들에게 외치고있는 포교자들을 보았습니다. 그들의 말에 "
"따르면, 여신은 스스로 저주를 정화하는 자들을 용서할 준비가 되어 있다고 하더군요.. 그러나 이 정화란 것이 오직 지독하게 잔인한 죽음을 "
"통해 이루어집니다.\" {n}트리스티안은 힘들게 침을 삼켰습니다.{/n} \"이 끔찍한 죽음들은 그 시체에서 모습을 드러내는 사나운 "
"야수들과 관계되어 있습니다...그리고 그들은 이를 축복이라 여기고 있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Cue_0011_Text
msgctxt "700bf9d3-975f-4ad3-83fb-78660576bca4"
msgid ""
"\"True... Jhod told me of that preacher. Who knows, perhaps his words "
"touched people more deeply than anyone imagined.\""
msgstr ""
"\"사실입니다...조드가 그 설교자에 대해 말해주었습니다. 누가 알겠습니까, 어쩌면 그의 말들은 상상 이상으로 사람들을 깊이 "
"감동시켰는지도 모릅니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Cue_0012_Text
msgctxt "bb9f5371-0b0b-4275-97a0-87b144f4e356"
msgid ""
"{n}Tristian shrugs.{/n} \"I only heard fragments of conversation. I think "
"it's not a 'kingdom' exactly. More like a community. — Or a cult. I'm afraid "
"that we'll need to find one of their barkers and ask them, if we wish to "
"find out more.\""
msgstr ""
"{n}트리스티안은 어깨를 으쓱합니다.{/n} \"대화의 일부밖에 듣질 못했습니다. 생각컨데 정확히 \"왕국\"은 아닌 것 같습니다. "
"공동체에 가깝거나, 종교 집단에 더 가까운 것 같습니다. 우리가 좀 더 알아내려면, 우리는 그 포교인들 중 하나를 찾아내어 물어봐야 할 "
"것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Cue_0013_Text
msgctxt "31f0a766-98fc-4f1e-b339-e7a5f9f13bb8"
msgid ""
"\"How could you mean this?! Innocent people are accepting a magical "
"affliction for the mercy of an unknown deity! Even worse — they are prepared "
"to start worshipping her! I'm afraid to even imagine where this might lead.\""
" {n}Tristian frowns.{/n} \"As I said, I can't just stand idly by as this "
"unfolds.\""
msgstr ""
"\"어찌 이럴 수 있습니까? 순진한 사람들이 이름조차 알려지지 않은 신의 자비를 위해 마법적인 고통을 감내하다니! 더욱 나쁜 것은 그들이 "
"그녀를 숭배하고자 준비한다는 것입니다! 이 일이 어디로 이어질지 상상조차 할 수 없습니다.\" {n}트리스티안은 얼굴을 "
"찌푸렸습니다.{/n} \"제가 말씀드린데로, 저는 이 일을 수수방관할 수 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Cue_0015_Text
msgctxt "d7f5afbc-a55e-4d9a-a6f6-6980e9ce467f"
msgid ""
"{n}Tristian nods enthusiastically.{/n} \"Good! Perhaps after uncovering this "
"mystery we will find out more about the nature of the curses hanging over "
"the {g|Stolen Lands}Stolen Lands{/g}. I mean, there must be a reason that "
"these cultists shout about you receiving the Goddess' punishment! If we wish "
"to understand, we must find one of those barkers and learn from them all we "
"can.\""
msgstr ""
"{n}트리스티안은 열렬히 고개를 끄덕입니다. {/n}\"좋습니다! 아마도 이 미스터리를 밝혀낸다면 {g|Stolen Lands}도둑맞은 "
"땅{/g} 전역에서 창궐하는 이 저주의 본질에 대해 더 많은 것을 알게 될 것입니다. 제 말은, 당신이 여신의 징벌을 받았다고 외치는 이 "
"사교도들에게는 어떤 이유가 반드시 있을 것이란 겁니다! 이것을 밝혀내려면, 그 포교자들 중 한 명을 찾아내어 그들로부터 최대한 알아내야 "
"합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Cue_0016_Text
msgctxt "90f19447-775e-45c7-a88f-bd739db13f62"
msgid ""
"{n}Tristian looks confused, almost surprised.{/n} \"But it's your subjects "
"we're talking about! Aren't you sworn to protect them — and not only from "
"sword and fire, but from a faith that would eat away at their souls and lead "
"them to their deaths?\""
msgstr ""
"{n}트리스티안은 혼라스러워 보여서, 거의 놀란것 같았습니다.{/n} \"그러나 우리가 말하는 것은 당신의 백성들입니다! 그들을 단지 "
"칼과 불에서부터 뿐만 아니라, 그들을 먹어치우고 그들의 죽음으로 이끌 수 있는 믿음으로부터도 보호하겠다 맹세하시지 않으셨습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Cue_0017_Text
msgctxt "22ed0328-f326-4f70-986d-d900657aed7f"
msgid ""
"\"Who knows? Could the land itself spawn a malicious power that strengthens "
"evil words, and gives them special potency? I hope we will find an answer!\" "
"{n}Tristian nods at you and looks away.{/n}"
msgstr ""
"\"누가 알겠습니까? 이 땅 자체가 사악한 말들을 강하게 하는 악의적인 힘을 품고있고, 그것들에 특별한 능력을 주는지를요? 저는 우리가 "
"해답을 찾기를 바랍니다!\" {n}트리스티안은 당신에게 고개를 끄덕이고는 시선을 돌렸습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Cue_0020_Text
msgctxt "12b4a0d0-2162-4fc4-904f-dbbae1c18087"
msgid ""
"{n}The priest thinks intensely for a few moments, then sighs and shakes his "
"head.{/n} \"If you are untouched by this frightening news, then I doubt I "
"can make you change your mind. So be it.\""
msgstr ""
"{n}사제는 잠시동안 깊이 생각을 하더니, 한숨과 함께 그의 머리를 흔들었다.{/n}\"당신이 이 무서운 소식을 접하지 않았다면, 저는 "
"제가 당신의 생각을 바꿀 수 있을지 의심스럽습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Cue_0021_Text
msgctxt "1520ca9d-2aa2-44f1-a908-9335e9ac07bb"
msgid ""
"\"Sadly, these street preachers scare quite easily and avoid our guards. "
"I'll begin my search without delay. When you find time, look for me on the "
"streets of the capital. I hope that when we meet I will have already found "
"someone who can tell us more about this strange Goddess and her followers.\""
msgstr ""
"\"애석하게도 거리의 이 포교자들은 상당히 쉽게 겁을 먹고 우리 경비병들을 피해 다니고 있습니다. 저는 지체없이 탐색을 시작하겠습니다. "
"시간이 되실 때, 수도의 거리에서 저를 찾아주십시오. 우리가 만났을 때는 이 이상한 여신과 그 추종자들에 대해 이야기 해 줄 수 있는 "
"누군가를 이미 찾았기를 바라겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc22-Tristian_Q1_Start/Cue_0023_Text
msgctxt "1c7d8f44-cc83-46c4-96c2-7d72c2c2246e"
msgid ""
"{n}Tristian opens his mouth, but changes his mind and turns silently "
"away.{/n}"
msgstr "{n}트리스티안은 입을 열려 했지만, 이내 그의 마음을 바꾸어 조용히 돌아나갔습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc51-Tristian_Q2_Start/Cue_0001_Text
msgctxt "d0f837cb-019b-4a00-b652-d2b608d103c5"
msgid ""
"{n}Tristian remains silent for a long time. When he finally opens his mouth, "
"his voice is hoarse and tired.{/n} \"I won't take much of your time, {name}."
"\""
msgstr ""
"{n}트리스티안은 오랜 시간 동안 침묵했습니다. 마침내 그가 그의 입을 열었을 때, 그의 목소리는 쉬고 피곤에 차 있었습니다.{/n} "
"\"당신의 시간을 많이 뺏지 않을 겁니다, {name}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc51-Tristian_Q2_Start/Cue_0002_Text
msgctxt "d12ab423-033b-4d96-ad00-79b6d225c3ad"
msgid ""
"\"I've been meaning to ask you about something. This might seem stupid. Or "
"arrogant. Or just insolent...\" {n}Tristian stumbles and catches his "
"breath.{/n} \"I want to talk to you.\""
msgstr ""
"\"당신에게 부탁드리고 싶은게 있습니다. 이것은 바보같을 수도. 어쩌면 오만해 보일수도. 어쩌면 불손해 보일수도 있습니다...\"{n}"
"트리스티안은 비틀거리며 그의 숨을 돌렸습니다.{/n} \"당신과 이야기하고 싶습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Tristian/ktc51-Tristian_Q2_Start/Cue_0003_Text
msgctxt "d3d274d4-79a3-48d6-aefb-06e037a3c680"
msgid ""
"\"I think you know what it's about. It's — it's what I've done. And what I "
"haven't done.\" {n}The priest lowers his head and grows quiet.{/n} \"But "
"let's speak in private, far from curious ears. I will be at the viewing "
"point, in the palace garden. Please come as soon as you can.\""
msgstr ""
"\"무엇에 관한 일인지 아시리라 생각합니다. 이건...이건 제가 한 짓에 대한 것입니다. 그리고 제가 하지 않은 일에 대한 것이지요.\" "
"{n}사제는 고개를 숙이고는 잠자코 있었습니다.{/n}\"궁금해하는 귀들을 피해 개인적으로 이야기하시지요. 궁전 정원에 있는 전망대에 "
"있겠습니다. 가능한 빨리 와주시길 바랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc21-Valerie_Q1_Fail/Cue_0001_Text
msgctxt "bf478ea9-e13d-4438-b714-34f378a14fe9"
msgid ""
"{n}Valerie looks gloomy.{/n} \"I heard rumors that my old mentor, Fredero "
"Sinnet, assembled his entourage and left the boundaries of the {g|Stolen "
"Lands}Stolen Lands{/g}. It looks like we didn't make it to the trading post "
"before his patience was exhausted.\""
msgstr ""
"{n}발레리는 우울해 보입니다.{/n} \"제 오래된 스승인 프레데로 신넷이 그의 수행원을 소집해서 {g|Stolen Lands}도둑맞은 "
"땅{/g}의 경계를 떠나갔다는 소문을 들었습니다. 그의 인내심이 한계에 달하기 전에 우리는 교역소까지 도달하지 못한 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc21-Valerie_Q1_Fail/Cue_0002_Text
msgctxt "0f0fa160-8bcb-4206-b6f8-0faa622a51c4"
msgid ""
"{n}The girl waves carelessly.{/n} \"It might be for the best. I'm sure you "
"have enough problems without a fanatic paladin claiming rights to me as "
"property of the Order of the {g|Shelyn}Eternal Rose{/g}. Pff!\""
msgstr ""
"{n}소녀는 무력하게 손을 흔듭니다.{/n} \"그렇게 하는게 최선일지도 모르겠군요. 저를 {g|Shelyn}영원한 장미{/g}의 "
"기사단의 소유물로 여기고 권리를 요구하는 광신적인 팔라딘 말고도 처리해야 할 문제가 많으실테니까요. 후우!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc21-Valerie_Q1_Fail/Cue_0003_Text
msgctxt "df47705d-d477-49cf-939b-5052595e9672"
msgid ""
"{n}Valerie looks at you from under her eyebrows.{/n} \"I heard a rumors that "
"Fredero Sinnet, a paladin from the Order of the {g|Shelyn}Eternal Rose{/g} "
"was killed at the trading post. Slaughtered with his entire entourage. Oleg "
"and Svetlana are keeping silent about it, like they're afraid of snitching "
"on someone.\""
msgstr ""
"{n}발레리가 심각한 표정으로 당신을 쳐다본다.{/n} \"프레드로 시넷에 대한 소문을 들었습니다. {g|Shelyn}영원한 장미{/g}"
"의 기사단 소속의 팔라딘이 교역소에서 살해당했으며, 같이 있던 수행원들도 모두 학살당했다고. 올렉과 스베틀라나는 이에 대해 입을 다물고 "
"있는데, 마치 누가 그랬는지 밀고하는 걸 두려워하는 듯이 보였습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc21-Valerie_Q1_Fail/Cue_0004_Text
msgctxt "eb9cf33e-8970-489a-b2fa-2ef1e89cbcd7"
msgid ""
"\"We need to guard your lands more carefully, {name}. It's unlikely you'll "
"ever create a proper state here if such unpunished atrocities keep happening."
"\""
msgstr ""
"\"{name}, 저희는 영지를 더 철저하게 방비하여야합니다. 만약 이러한 잔학 행위가 처벌받지 않고 계속 자행된다면 영지의 안전을 "
"유지하기 힘들 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc21-Valerie_Q1_Start/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "6106f64e-f589-40ad-a763-b0cd424d744a"
msgid ""
"\"Your Grace, today a {g|ValerieQ1}letter{/g} from {g|Brevoy}Brevoy{/g} was "
"delivered to the castle. It was written by Fredero Sinnet, a paladin from "
"the Order of the {g|Shelyn}Eternal Rose{/g}. It appears that Sir Sinnet is "
"claiming right to one of your companions, who was brought up in his "
"custody... Well, I'll leave it to you to handle this delicate matter.\""
msgstr ""
"\"영주님, 오늘 {g|ValerieQ1}편지{/g}가 {g|Brevoy}브레보이{/g}에서 도착했습니다. 보낸 이는 {g|Shelyn}"
"영원의 장미{/g} 기사단 소속 팔라딘인 프레데로 신넷입니다. 아무래도 신넷 경은 자신의 옛 부하를 돌려달라는 것 같습니다... 음, "
"이런 민감한 사안은 영주님께 맡기겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc21-Valerie_Q1_Start/Cue_0002_Text
#. Speaker : Capital_Shandra
msgctxt "77db2101-76cc-4d0a-b6a3-6981aea00d57"
msgid ""
"\"A {g|ValerieQ1}letter{/g} from {g|Brevoy}Brevoy{/g}, Your Grace. Fredero "
"Sinnet, a paladin and mentor of the Order of the {g|Shelyn}Eternal Rose{/g}, "
"has come to your lands to retrieve your companion, Valerie. It seems he's "
"going on some sort of pilgrimage, and he hopes his former disciple will come "
"with him. It's a rather unexpected request, but you'll have to deal with it. "
"Here's the letter from Sinnet.\""
msgstr ""
"\"{g|Brevoy}브레보이{/g}에서 {g|ValerieQ1}서한{/g}이 도착하였습니다, 전하. {g|Shelyn}영원한 장미{/g}"
" 기사단의 팔라딘이자 멘토인 프레데로 시넷이 전하의 동료인 발레리를 데려가기 위해 전하의 영지에 왔다고 합니다. 그는 일종의 순례를 하고 "
"있는 것으로 보이며, 옛 제자가 여기에 동참하기를 바라는듯 합니다. 이는 상당히 갑작스러운 요청입니다만, 전하께서 다루셔야 할 "
"문제입니다. 여기 시넷의 서한입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc21-Valerie_Q1_Start/Cue_0003_Text
#. Speaker : Capital_Lander
msgctxt "50fbe76c-d67f-47c2-9424-d202d712b5c4"
msgid ""
"\"I have an intriguing {g|ValerieQ1}letter{/g} for you, Your Grace. A "
"certain Fredero Sinnet, a paladin of {g|Shelyn}Shelyn{/g} from "
"{g|Brevoy}Brevoy{/g}, is claiming right to our charming Valerie! Not in the "
"sense that the entire population of the capital is trying to, but as her "
"teacher and mentor! Here's the letter – see for yourself!\""
msgstr ""
"\"아주 흥미로운 {g|ValerieQ1}편지{/g}를 가지고 왔습니다, 전하. {g|Brevoy}브레보이{/g}에서 활동하는 "
"{g|Shelyn}셸린{/g} 의 팔라딘인 프레데로 시넷 본인이 우리의 아름다운 발레리에 대한 권한을 주장하고 있습니다! 수도의 전 "
"백성이 요구해서가 아니라, 단지 그녀의 스승이자 멘토로서 요구하고 있는 것입니다! 여기 그 편지가 있습니다. 직접 읽어보시지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc21-Valerie_Q1_Start/Items/FrederoLetter_Name_String
msgctxt "4a6efa26-9187-42d0-b262-8df0f814c071"
msgid "Letter from Fredero Sinnet"
msgstr "프레데로 신넷(Fredero Sinnet)으로부터의 편지"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc21-Valerie_Q1_Start/Items/FrederoLetter_String
msgctxt "2b9000c2-e5d5-488b-9d42-c58c9a6cbee6"
msgid ""
"The expensive monogrammed paper has a faint, tangy smell. The lines, in "
"steady delicate handwriting, are decorated by whimsical curves.\n"
"\"My dear {mf|Baron|Baroness} {name}!\n"
"I write these words with a heavy heart. The reason I take up my quill today "
"will most likely upset you. Quite recently I heard rumor that a lost soul, "
"once blessed with the mercy of my goddess, has found shelter in your "
"service. I'm speaking of the daughter of one of the most worthy and generous "
"patrons of the Order of the Eternal Rose, who once made the mistake of "
"leaving our ranks. I am deeply convinced that now is the time for her to "
"return to the path destined her by divine will.\n"
"I am now traveling to the west, to the place that's been chosen for the new "
"Temple of Shelyn that will be occupied by one of the young congregations of "
"our church. I deemed it necessary to diverge slightly from our path with but "
"one purpose: to arrive in your lands and collect Valerie. May this journey "
"be a cleansing pilgrimage for Shelyn's chosen, whose judgment was clouded by "
"the impulsiveness of youth.\n"
"I request that you free Valerie of her vows of service to you, for fate has "
"destined her to serve one who is above us all. Direct the girl to the "
"trading post that's on the border between your barony and Brevoy. There I "
"will be expecting her with my comrades.\n"
"I pray for your wisdom and mercy.\n"
"With deep respect and regards, Fredero Sinnet\""
msgstr ""
"비싼 재질의 종이에 희미하지만 강렬한 잉크냄새가 납니다. 손수 친필로 작성된 글귀는 이리저리 곡선을 그리고 있습니다.\n"
"\"친애하는 {mf|남작|여남작} {name}!\n"
"혹여나 제가 그대를 불편하게 만들지도 모르지만 무거운 마음으로 이 편지를 씁니다. 최근에 떠도는 소문을 들었습니다. 한때 여신의 축복을 "
"받던 길잃은 어린 양을 남작님께서 거두어 주셨다더군요. 영원한 장미의 기사단의 든든한 후원자의 딸이자, 우리 기사단의 탈주자를 말하는 "
"것입니다. 이제 슬슬 그녀가 다시 신의 뜻에 따라 올바른 길로 돌아갈 때가 되었습니다.\n"
"현재 저는 새로운 셸린의 신전으로 선정된 곳을 향해 서쪽으로 이동 중니다. 이 신전에는 저희 교회의 젊은 신도가 거주할 예정이기 "
"때문이죠. 하지만 발레리를 반환받기 위해 조금 일정을 늦추고 그대의 영토를 방문할 생각입니다. 부디 우리가 젊은 날의 과오를 범한 셸린의 "
"선택받은 어린 양을 구제할 수 있기를.\n"
"발레리를 당신의 휘하에서 자유롭게 풀어줄 것을 정식으로 요청합니다. 여신을 섬기는 것이 그녀의 운명입니다. 그대의 남작령과 브레보이 "
"사이에 있는 교역소에서 발레리를 넘기십시오. 그곳에서 제 동료들과 기다리고 있겠습니다.\n"
"그대가 자비로운 마음과 지혜가 있기를 기도하겠습니다.\n"
"크나큰 경의를 표하며, 프레데로 신넷 올림\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Fail/Cue_0001_Text
msgctxt "e1b7e2ca-144c-4399-b86a-55c8123ea6ec"
msgid ""
"\"Good news, Your Grace. Valerie seems to have stopped behaving like a "
"furious wildcat! I don't think we need to worry any more about innocent "
"citizens meeting her when she's on the war path.\""
msgstr ""
"\"좋은 소식입니다, 전하. 발레리가 열받은 살쾡이처럼 구는 걸 멈춘 것으로 보입니다. 더 이상 무고한 시민들이 그녀가 화가 났을 때 "
"마주치지는 않을까 노심초사할 필요는 없어 보입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0004_Text
msgctxt "2a279c1f-e692-4b3a-9336-c723a3d0195a"
msgid "\"Valerie, explain yourself!\""
msgstr "\"발레리, 해명해라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0005_Text
msgctxt "dfc1055a-92a9-47c1-a976-da657fc9678e"
msgid "\"Eveld? Is that the character next to you?\""
msgstr "\"이벨드? 옆에 있는 이 사람을 말하는건가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0006_Text
msgctxt "631e0b14-85d6-4c71-b064-0a042a0226f2"
msgid "\"You can't handle some row without me?\""
msgstr "\"나 없이는 아무 것도 못하나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0015_Text
msgctxt "998d0deb-4643-4c78-b8e0-68f8454949ac"
msgid "\"Valerie, you overreacted. Apologize to Eveld.\""
msgstr "\"발레리, 너무 과민반응했군. 이벨드에게 사과하게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0016_Text
msgctxt "49ebbb16-80ce-4d13-9451-eeff02501395"
msgid "\"Eveld, apologize to Valerie immediately.\""
msgstr "\"이벨드, 지금 당장 발레리에게 사과하게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0017_Text
msgctxt "e0ac643b-8cbe-4b5f-b8f9-b51f3d2a7ead"
msgid "\"You. Both of you. Figure this out someplace else.\""
msgstr "\"너희 둘. 딴 데 가서 마무리 짓게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0021_Text
msgctxt "8d2d4c72-1374-4b71-83fa-b32b13b2fac1"
msgid ""
"\"I don't care who said what to whom. You're going to make peace now, right "
"here in front of me.\""
msgstr "\"누가 무엇을 누구에게 말했는지는 관심없네. 너희 둘은 지금 화해할거니까, 바로 여기 내 앞에서.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0033_Text
msgctxt "0bffd020-de95-4ce6-8900-433df1c08e90"
msgid "\"What do you mean, 'hasn't been herself'?\""
msgstr "\"'그녀답지 않다'니, 그게 무슨 말이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0035_Text
msgctxt "b622bdaf-80b4-4162-b66a-7c7041e0d10c"
msgid "\"You think Valerie could hurt someone?\""
msgstr "\"발레리가 누굴 해칠 사람으로 보이나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0036_AlignmentShift.Description
msgctxt "ea893f7b-5e57-422d-8b9b-173df8213144"
msgid "Promised to help Valerie."
msgstr "발레리를 돕겠다고 약속함."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0036_Text
msgctxt "3310512d-71dc-4577-bf19-0f5102f867f7"
msgid "\"Thank you for bringing this to my attention. I'll try to help her.\""
msgstr "\"내게 알려줘서 고맙네. 그녀를 도울 수 있도록 노력하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0037_AlignmentShift.Description
msgctxt "5ab53ae4-f396-42f1-8465-6a1f9a33f5fd"
msgid "Waved away the captain's concerns about Valerie."
msgstr "발레리에 대한 경비대장의 염려를 일축한다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0037_Text
msgctxt "0c489d00-584a-4f64-8d42-494fd76b60d2"
msgid ""
"\"I don't have time to deal with Valerie's behavior. Keeping peace on the "
"streets is your responsibility.\""
msgstr "\"발레리의 행동거지가 어떤지 신경 쓸 시간 없다. 거리의 질서를 유지하는 것은 너의 몫이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0038_Text
msgctxt "f70455da-fac2-4b80-bea8-9e87ac8bac95"
msgid "\"I will talk to Valerie when I get a chance.\""
msgstr "\"기회가 생기면 발레리와 얘기해 보도록 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Answer_0044_Text
msgctxt "ef64a023-2b8e-4ead-bae1-1552d0a6bcc7"
msgid "\"Eveld, did you really write a pasquinade about Valerie?\""
msgstr "\"이벨드, 발레리에 대한 풍자문을 쓴게 사실인가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Barks/01Eveld_String
msgctxt "afd44567-fcb5-47e7-b46e-c2b46280c157"
msgid ""
"\"I was taken from an important affair! Embarrassed in public! And all "
"because some lady decided she can do whatever she pleases!\""
msgstr ""
"\"저는 중대한 범죄를 당했습니다! 공공연하게 모욕을 당했단 말입니다! 그리고 그건 어떤 여자가 자기 하고 싶은대로 뭐든지 다 해도 "
"된다고 생각했기 때문이고요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Barks/02Valerie_String
msgctxt "800f7d31-cb03-4ae4-989c-f2c89bf338ad"
msgid ""
"\"Would you please behave at least in front of {mf|His|Her} Grace! We've had "
"quite enough of this manner you allow yourself with the peasantry!\""
msgstr ""
"\"제발 전하의 안전에서는 좀 얌전히 굴어주시겠습니까! 당신이 다른 백성들에게 하는 것과 똑같은 무례한 행동을 봐드리는 것도 지친단 "
"말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0001_Text
#. Speaker : Capital_GuardCaptain
msgctxt "de577c34-2511-4a6c-9bc2-c3f4217d8957"
msgid ""
"{n}The captain's usually untroubled face is dark with rage.{/n} \"{mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}! Please forgive me for "
"distracting you from important matters, but you're the only one who can talk "
"some sense into these hotheads!\""
msgstr ""
"{n}경비대장의 흐트러지지 않던 얼굴은 평소와는 달리 노기로 어두워 보인다..{/n} \"{mf|영주님|영주님|전하|전하}! 중요한 "
"공무에 방해를 해드려 죄송합니다. 그렇지만 당신께서 이 다혈질들을 진정시켜 주실 수 있는 유일한 분이십니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0002_Text
#. Speaker : Capital_GuardCaptain
msgctxt "4da1222b-db5b-4e7b-827b-2a812df8b4e6"
msgid ""
"\"They had an argument in the middle of the street! Yelled so much your "
"subjects called the guards... but what can they do about Lady Valerie? Plus, "
"Eveld hasn't done anything illegal... it's not like I can put them in jail!\""
msgstr ""
"\"이 놈들이 길 한복판에서 말싸움을 하지 뭡니까! 어찌나 큰 소리던지 사람들이 제 부하들에게 신고를 했습니다만... 발레리 아씨에게 "
"저희가 뭘 어떻게 하겠습니까? 더욱이 이벨드가 딱히 불법적인 것을 한 것도 아니고... 감옥에 잡아 넣을 일은 아닌 것 같습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0007_Text
#. Speaker : Capital_GuardCaptain
msgctxt "97381ea0-eed3-467e-bdb3-8fd5f1d1ec11"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, Valerie is your "
"companion, so she gets special treatment. She doesn't take orders from me, "
"besides it would be wrong...\" {n}The captain rubs his temple.{/n} \"We "
"fought together, protected the capital together... so what am I going to do "
"now? Arrest her?\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 발레리님은 당신의 동료이기 때문에 특별대우를 받고 있습니다. 그녀는 저의 명령을 들어주지 "
"않습니다, 게다가 상황은 더 나빠지고 있죠...\" {n}경비대장은 그의 관자놀이께를 문지릅니다.{/n} \"저희는 함께 싸웠고, 함께 "
"수도를 지켜냈습니다... 제가 어찌해야겠습니까? 그녀를 구속해야 할까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0008_Text
#. Speaker : EveldSilverTongued
msgctxt "b7de9295-a65f-4f2f-8dbf-c6883cb28aaf"
msgid ""
"{n}A short, rugged man in a sophisticated garment bows ceremoniously.{/n} "
"\"In my own person, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! "
"Eveld the Silver-Tongued, who once served as court bard at the best houses "
"of {g|Brevoy}Brevoy{/g}, and has now traded in his golden cage for the free "
"winds of travel. But I digress...\""
msgstr ""
"{n}세련된 의복을 입은, 키는 작지만 강인한 인상의 남성이 예법에 맞추어 인사합니다.{/n} \"제 소개를 드립니다, "
"{mf|영주님|영주님|전하|전하}! 저는 은 혓바닥 이벨드이며, 한 때 {g|Brevoy}브레보이{/g}의 유력 가문에서 궁전 악사로 "
"일했습죠. 그리고 지금은 저의 순금으로 된 감옥을 자유로운 여정의 바람과 맞바꾸었습니다. 하지만 다른 말로는...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0010_Text
#. Speaker : EveldSilverTongued
msgctxt "ef3ce511-aa36-492a-a6b4-5e2dec68b0e0"
msgid ""
"\"This, so to speak, sweet lady insulted me, if you please, in front of my "
"audience! Halted my performance and embarrassed me in front of the entire "
"tavern! Would you please be so kind as to rein this lady in!\""
msgstr ""
"\"말하자면, 이 아름다운 숙녀분이 관중들 앞에서 저를 모욕했습니다! 공연을 중단시키고, 선술집 모든 이들 앞에서 제게 망신을 줬습니다! "
"저에게 자비를 베푸시어 숙녀분을 제지해 주실 수 있겠습니까!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0011_Text
#. Speaker : Valerie_Companion
msgctxt "77ac72e4-048b-4494-b999-a6847bb24e2d"
msgid ""
"{n}Valerie is apparently trying to control herself, but telltale red spots "
"flare on her face.{/n} \"I noticed that someone pinned a disgusting "
"pasquinade next to the tavern entrance. Something about a bright bird who "
"lost its feathers. That's... abominable insolence! Yes, I won't deny I'm "
"guilty. I lost my temper, but who wouldn't have?\""
msgstr ""
"{n}발레리는 감정을 내비치지 않으려고 노력하지만 얼굴이 붉어지는 것을 막을 순 없었다.{/n} \"저는 누군가 여관 출입문 옆에 "
"붙여놓은 역겨운 풍자문을 발견했습니다. 깃털을 잃은 눈부신 새에 대한 것이었죠. 그건... 이루 말로 형용못 할  오만 그 자체였습니다! "
"그래요, 제가 잘못했다는 것은 부인하지 않겠습니다. 저는 이성을 잃었죠, 그러나 누군들 그러지 않았겠습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0012_Text
#. Speaker : EveldSilverTongued
msgctxt "e93adedf-3c0c-4dd3-a509-f1e9cd59c43f"
msgid ""
"{n}Eveld gasps with indignation.{/n} \"Is that so? When I smothered this "
"lady with exquisite compliments, I received only insults and jokes in "
"return! When I came to her with gifts, begging her to become the muse for my "
"greatest work – I was ridiculed and sent away like a snotty boy! And now, "
"the moment I start to pursue my art away from this good lady, she seeks me "
"out and says I'm guilty of spiteful slander! What shall I do? I'm but a "
"slave to my inspiration, which is sent to me from above!\" {n}Eveld smoothes "
"down his hair and adds.{/n} \"And while we're on the subject of my poetry, "
"it's really not that bad...\""
msgstr ""
"{n}이벨드는 화가나서 숨을 헐떡입니다.{/n} \"그런가요? 제가 이 아가씨를 질식시킬 정도로 수많은 찬사를 쏟아냈지만, 돌아온 건 "
"모욕과 비웃음 뿐이었습니다! 선물을 건네며 제 위대한 작품의 뮤즈가 되어달라고 애원했을 때에도, 코흘리개 애취급하여 조롱했습니다! 그리고 "
"이제, 이 아름다운 아가씨로부터 벗어나 작품을 창작하려고 하자, 저를 먼저 찾아서는 악의적인 비방을 했다며 죄인 취급 하는군요! 제가 "
"대체 어떻게 해야 하나요? 저는 그저 영감이 떠오르면 하는 하수인에 불과합니다! {n}이벨드는 머리를 매만지며 덧붙입니다.{/n} "
"\"그리고 주제를 다시 돌려 제 시에 대해 말씀드리자면, 그렇게 나쁘지 않은 시입니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0013_Text
msgctxt "fe058bf1-06e2-43ff-b2a1-a38e58b69e51"
msgid ""
"{n}Valerie looks down, ashamed.{/n} \"I humbly beg your forgiveness, {name}. "
"I failed to control my temper and besmirched not only myself, but you as my "
"leader.\" {n}The girl casts a burning glance at the man in sophisticated "
"attire, standing beside her.{/n} \"Unfortunately, I was provoked.\""
msgstr ""
"{n}발레리는 부끄러운 듯이 고개를 떨구었다.{/n} \"정말로 면목이 없습니다, {name}님. 그만 이성을 잃어 버리고 말아 제 "
"자신뿐만 아니라 주군의 얼굴에도 먹칠을 해버렸군요.\" {n}발레리는 바로 옆에 서 있는 초랑한 행색을 한 남자를 쏘아보았다. {/n} "
"\"안타깝게도 도발에 넘어 가버리고 말았습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0014_Text
#. Speaker : EveldSilverTongued
msgctxt "420ffc84-96fa-491d-ac57-ae701baa689b"
msgid ""
"{n}The man catches Valerie's glance and gasps with indignation.{/n} \"Is "
"that so?! So it's ah... Ah, forgive my manners, {mf|Your Grace|Your Grace|"
"Your Highness|Your Highness}! Allow me to introduce myself — Eveld the "
"Silver-Tongued, from {g|Brevoy}Brevoy{/g}. It's a pity we meet under such "
"circumstances, but...\""
msgstr ""
"{n}남자는 분노로 가득찬 발레리의 시선을 알아차립니다.{n} \"그랬습니까?! 그렇다면 그건... 아, 제 무례를 용서해주십시오, "
"{mf|영주님|영주님|전하|전하}! 저에 대해 설명하라 하신다면 — 저는 {g|Brevoy}브레보이{/g}에서 온 은혓바닥 이벨드입니다. "
"이런 상황에서 만났다는 게 유감스럽군요. 하지만...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0018_Text
#. Speaker : EveldSilverTongued
msgctxt "8ca1ecaf-04e1-4c0e-9697-b350c0b7c438"
msgid ""
"\"Hell no, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! If this "
"rude dolt brought me here and since I'm already taking up your time, I need "
"to make sure this lady is reined in. I need protection!\""
msgstr ""
"\"절대로 아닙니다, {mf|영주님|영주님|전하|전하}! 이 무례한 얼간이가 저를 당신 앞까지 끌고 왔고, 제가 이미 의도치 않게 당신의 "
"시간을 뺏는 상황이라면, 제게는 우선 목줄을 쥐고 있는 숙녀분이 해를 끼치지 않을거라는 확신이 필요합니다. 저는 보호가 필요합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0019_Text
#. Speaker : Valerie_Companion
msgctxt "3070b38c-efe1-4ae4-a174-93fed1710bfb"
msgid ""
"{n}Valerie's voice rings with rage.{/n} \"I swear, another word from this "
"lowly scribbler, and anything could happen!\""
msgstr "{n}발레리의 목소리가 분노에 차 떨립니다.{/n} \"맹세컨데, 뭐든 지껄여대는 허접한 낙서꾼에게서 나온 말일 뿐입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0020_Text
#. Speaker : EveldSilverTongued
msgctxt "63145afe-b384-4cad-8b11-785da0578dc3"
msgid ""
"{n}Eveld opens his mouth but says nothing. Finally he starts enunciating "
"words, one by one.{/n} \"My only transgression is loyally serving my "
"patroness, the beautiful {g|Shelyn}Shelyn{/g} who sends me inspiration, and "
"never hiding from this world a single word that's born in my heart. But "
"since my honesty and openness are so offensive to this good lady, then so be "
"it – I apologize for insulting you, with all my heart!\""
msgstr ""
"{n}이벨드는 그의 입을 뻐끔거렸으나 아무런 말도 하지 않았습니다. 그리고 마침내, 단어 하나하나씩 또렷하게 말하기 시작합니다.{/n} "
"\"제가 저지른 유일한 범죄라면 제 여주인, 제게 영감을 내려주신 아름다운 {g|Shelyn}셸린{/g}님을 충성스럽게 섬겼다는 "
"것뿐이며, 제 마음대로 쓴 글은 이 세상에 단 한 단어도 존재하지 않습니다. 하지만 저의 정직함과 개방성이 숙녀분께 너무 공격적이었다면, "
"받아들이겠습니다 – 제 모든 진심을 담아, 당신을 모욕한 것을 사과드립니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0022_Text
#. Speaker : Valerie_Companion
msgctxt "a908b445-ea90-425f-8bdc-e3e4856de0ed"
msgid ""
"{n}Valerie grows pale, and her lips tremble. Gathering her strength, she "
"almost pushes the words from her mouth.{/n} \"My deepest apologies, Eveld.\""
msgstr ""
"{n}발레리의 안색이 창백해졌고, 그녀의 입술이 떨립니다. 그녀는 모든 힘을 모아 간신히 말을 내뱉습니다.{/n} \"진심으로 사과한다, "
"이벨드.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0023_Text
#. Speaker : EveldSilverTongued
msgctxt "47a36675-448e-4b1c-8e2b-f0259421f39c"
msgid ""
"{n}Eveld turns to the girl with a triumphant look, about to say something, "
"but stops when he sees her face.{/n} \"I... I'm fully satisfied, {mf|Your "
"Grace|Your Grace|Your Highness|Your Highness}. I have no more complaints "
"about Valerie.\""
msgstr ""
"{n}이벨드는 만족스러운 표정으로 그녀를 돌아봅니다. 뭐라고 말하려 했지만, 발레리의 표정을 보고는 멈춥니다.{/n} \"저...저는 "
"만족했습니다, {mf|영주님|영주님|전하|전하}. 발레리님에 대해 더이상 아무말도 하지 않겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0024_Text
#. Speaker : Valerie_Companion
msgctxt "81cb496e-7a5e-410b-8763-8c72f9543bfd"
msgid ""
"{n}Valerie purses her lips. She seems to want to reply to Eveld's monologue, "
"but in the end she changes her mind and just nods.{/n}"
msgstr ""
"{n}발레리는 입술을 삐죽 내밀었습니다. 그녀는 이벨드의 독백을 다시 듣고 싶은 모양이었지만, 마침내 생각을 바꾸고 고개를 "
"끄덕입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0025_Text
#. Speaker : EveldSilverTongued
msgctxt "63121ff6-fff9-463f-91d6-eda9ce6b4d31"
msgid ""
"\"Your tongue befits your beauty, my sweet! Truly, what is a beautiful "
"flower's bud worth, if it's worm-eaten and empty on the inside?\""
msgstr ""
"\"당신의 언행이 당신의 아름다움과 잘 맞는군요, 숙녀분! 사실, 아름다운 꽃의 봉오리라 할지라도 그 속을 벌레가 파먹어 텅텅 비었다면 "
"어찌 가치있겠습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0026_Text
#. Speaker : Valerie_Companion
msgctxt "1574f0dc-bf5e-43c3-8d60-3ce7a75b6f6e"
msgid ""
"{n}Valerie almost screams.{/n} \"I'm not going to make peace with this... "
"this... worthless paper-stainer! Let him spend his useless time insulting "
"his other bootlickers!\""
msgstr ""
"{n}발레리는 거의 비명을 지르듯 말합니다.{/n} \"저는 더 이상 저...저... 쓸모없는 종이 낭비꾼과 화해하고 싶지 않습니다! "
"그가 다른 아첨꾼들이나 모욕하며 남은 생을 낭비하도록 놔주십시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0027_Text
#. Speaker : Capital_GuardCaptain
msgctxt "6e82ab69-c5dd-411e-841c-13e3b001d3aa"
msgid ""
"\"Enough, both of you! First you scared everybody at the tavern, and now "
"you're embarrassing yourselves in front of the {mf|baron|baroness|King|Queen}"
"! Apologize at once – if not to each other, then at least to {mf|His Grace|"
"Her Grace|His Highness|Her Highness}!\""
msgstr ""
"\"두 분 모두 그만하십시오! 먼저 당신은 선술집의 모든 사람에게 공포를 심었고, 지금은 {mf|남작|여남작|왕|여왕} 면전에서 스스로를 "
"모욕하고 있습니다! 즉시 사과하십시오 – 서로에게 할 수 없다면, 최소한 {mf|남작|여남작|왕|여왕}님께라도 하십시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0028_Text
#. Speaker : EveldSilverTongued
msgctxt "02b75542-99c1-41c6-b8f2-16662d5c3fca"
msgid ""
"\"I... don't know what got into me, {mf|Your Grace|Your Grace|Your Highness|"
"Your Highness}. Forgive me this scene.\""
msgstr ""
"\"저는... 어떤 상황이 닥칠지 전혀 몰랐습니다, {mf|영주님|영주님|전하|전하}. 못 볼 꼴을 보여드린 것을 용서해주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0029_Text
#. Speaker : Valerie_Companion
msgctxt "3cb12efe-509c-49fe-9bb5-ea02d608a404"
msgid ""
"\"Please forgive me, {name}. Perhaps I should leave, to calm down and come "
"to my senses.\""
msgstr "\"용서해주십시오, {name}. 잠깐 나가서, 진정하고 정신 좀 차리고 오겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0030_Text
#. Speaker : Capital_GuardCaptain
msgctxt "0a765b14-a585-4036-af77-6b6aedab899f"
msgid ""
"\"That's nice. You let some steam off, and worked some things out. At least "
"now I can let you go, hoping you won't scare our good people any more!\""
msgstr ""
"\"좋습니다. 당신은 화를 좀 식히시고, 남은 문제를 마저 처리하죠. 지금은 당신을 보내드리겠지만, 다시는 선량한 시민들을 위협하지 "
"말아주십시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0031_Text
#. Speaker : Capital_GuardCaptain
msgctxt "2584039d-328f-449b-b09b-a68bfdfffe67"
msgid ""
"\"{mf|Your Grace|Your Grace|Your Highness|Your Highness}, I'll go too, "
"but... please keep an eye on Valerie. I don't know what demon has got into "
"her, but she's not herself lately. At first she'd just snap, then she "
"started getting into fights with everyone about stupid things, and now she's "
"dragged this bard out of the tavern by his collar. I'm afraid it might come "
"to real violence!\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 저도 가보겠습니다만... 발레리님께 신경 좀 써주십시오. 무슨 악마라도 씌였는지 모르겠지만, "
"요즘은 저희가 알던 그녀가 아닌 것 같습니다. 처음엔 그냥 말로만 화낼 뿐이었지만, 어느 순간 보니까 다른 모든 사람들과 바보같은 이유로 "
"싸우기 시작했고, 오늘은 선술집에서 저 음유시인에게 목줄을 채워 끌고왔습니다. 저 또한 그녀의 폭력이 점점 더 심해질까 걱정됩니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0039_Text
#. Speaker : Capital_GuardCaptain
msgctxt "ff78a046-ea37-4ccd-adde-5c4f7c5c7781"
msgid ""
"\"Forgive me, {mf|Your Grace|Your Grace|Your Highness|Your Highness}! Of "
"course! I promise – you won't hear about Valerie from me!\""
msgstr "\"용서해주십시오, {mf|영주님|영주님|전하|전하}! 물론입니다! 단언컨데 – 저는 발레리에 대해 드릴 말씀이 없습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0040_Text
#. Speaker : Capital_GuardCaptain
msgctxt "7e3d1a93-84b4-45d6-afe4-3122db0b7eb2"
msgid ""
"\"If I were you, I would talk to the Storyteller. One of my lads saw Valerie "
"arguing with him. I have no idea how anyone can have a fight with such a "
"harmless elf... but she did!\" {n}The captain bows, finishing the "
"conversation.{/n}"
msgstr ""
"\"제가 당신이라면, 이야기꾼과 얘기해보겠습니다. 제 부하들 중 한 명이 발레리가 그와 언쟁하는걸 봤다고 했었습니다. 그 누가 저렇게 "
"착한 엘프와 싸울 일이 있는지는 모르겠지만... 어쨌든 그녀가 해냈다고 들었습니다!\" {n}경비 대장은 대화를 마무리지으며 "
"인사합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0041_Text
#. Speaker : Capital_GuardCaptain
msgctxt "253739ee-e900-48bb-bde8-946c24843cc9"
msgid ""
"\"Well, I wouldn't say that... the Valerie I used to know would never harm "
"anyone without good reason. But the old Valerie seems to be gone. So I don't "
"know what to expect from her.\""
msgstr ""
"\"뭐, 제가 말씀드릴건 없지만... 제가 알고 있던 발레리는 충분한 이유가 없으면 어떤 사람에게도 해를 끼치지 않았습니다. 하지만 "
"옛날의 발레리는 어디론가 사라진것 같습니다. 그래서 저로선 어느 쪽이 진짜 그녀인지 알 수가 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0043_Text
#. Speaker : Capital_GuardCaptain
msgctxt "d87f12cc-69e1-492a-bec2-dc940664afee"
msgid ""
"\"She got defensive. Can't say a word to her. We've been careful around her, "
"since she...\" {n}The captain runs a finger across his face meaningfully.{/n}"
" \"I'm close to ordering my lads to keep an eye out for her in the streets, "
"to make the common people's lives a little calmer.\""
msgstr ""
"\"그녀는 매우 방어적으로 바뀌었습니다. 그녀에게 어떤 말도 할 수가 없었습니다. 그녀 주변에선 엄청 조심스럽게 행동해야 했죠, "
"그녀에게...\" {n}경비 대장이 표현을 위해 그의 손가락 하나로 얼굴에 일 자를 그립니다.{/n} \"평민들의 삶이 좀 진정되도록, "
"거리에 그녀가 나타나면 눈길을 떼지 말도록 부하들에게 조용히 명령해뒀습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0045_Text
#. Speaker : EveldSilverTongued
msgctxt "7967eae1-9393-4d4f-9ba5-3ae72705c866"
msgid ""
"{n}Eveld clasps his hand to his chest ostentatiously.{/n} \"Forgive me! Who "
"would I be, if I stooped to such low attacks! I won't deny that the "
"cautionary tale of this lady could inspire me...\""
msgstr ""
"{n}이벨드가 과장되게 손을 맞잡습니다.{/n} \"용서해주십시오! 이런 저열한 폭력에 고개를 숙여야 한다면, 제가 누구던 무슨 "
"상관이겠습니까! 저는 저 숙녀분께 영감을 받아 만든 이야기를 도저히 무시할 수 없었을 뿐입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0046_Text
#. Speaker : Valerie_Companion
msgctxt "476cbf31-6a49-4be5-a11b-cf13bb15115e"
msgid ""
"\"How can you listen to this featherbrain? Of course, in the face of justice "
"he's ready to disown his own parents!\""
msgstr "\"왜 이 바보 천치의 이야기를 들어주는 겁니까? 당연히, 정의에 따라 부모님과 연을 끊을 준비는 했을 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0047_Text
#. Speaker : Capital_GuardCaptain
msgctxt "0f2edfec-29d7-4134-b92b-06fb89c5af85"
msgid ""
"{n}The captain shakes his head sadly.{/n} \"Don't even try, {mf|Your Grace|"
"Your Grace|Your Highness|Your Highness}. I'm afraid even {g|Abadar}Abadar{/g}"
" couldn't get to the bottom of this ball of accusations.\""
msgstr ""
"{n}경비 대장은 슬픈듯 고개를 가로젓습니다.{/n} \"그러지 말아주십시오, {mf|영주님|영주님|전하|전하}. "
"{g|Abadar}아바다르{/g}조차 이 비난전의 진상을 알지 못하실까 두렵습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc31-Valerie_Q2_Start/Cue_0048_Text
#. Speaker : EveldSilverTongued
msgctxt "d0ac925f-0b8f-4344-9604-830bb676f8e3"
msgid ""
"\"...and if I'm allowed to continue, let me say what this pasquinade was "
"devoted to: the sad position of the arts in these lands, forgive my "
"frankness. Anyway, the good lady is unlikely to understand what allegory and "
"poetic hyperbole are!\""
msgstr ""
"\"...그리고 계속하라 허락하신다면, 무엇을 위해 이 풍자문을 작성했는지 설명하게 해주십시오: 이 땅에서 예술의 위상이 얼마나 바닥을 "
"쳤는가를 표현한 것입니다, 제 직언을 용서해주십시오. 아무튼, 저 아리따운 숙녀분께서 풍자와 시적 과장에 대해 이해하지 못하셨을수도 "
"있으니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc41-Valerie_Q3_Start/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "7b14ff24-308e-4b17-bbcc-73adaf6db6ef"
msgid ""
"\"Bad news! We've heard that visitors have lately been spreading unfavorable "
"rumors about your {mf|barony|barony|kingdom|kingdom}. It's as if "
"{kingdomname} is a stronghold of barbarism and feeble-mindedness, where "
"people of arts are rare and endangered! Our artists are alleged by these "
"rumors to be considered our least valued citizens! Such rumors can't but "
"affect our reputation. I'm afraid you'll have to entrust one of your "
"advisors with this matter!\""
msgstr ""
"\"나쁜 소식이에요! 우리 영지에 왔었던 사람들이 전하의 영지에 대해 안 좋은 소문을 퍼트리고 있어요. {kingdomname}이(가) "
"바바리안의 요새라는 둥, 예술이 설 자리가 없을 만큼 무지하다는 둥! 이러다가 이 소문들 때문에 우리 예술가들이 신용을 잃을 수도 "
"있어요! 명성에 먹칠을 하는 것이죠. 되도록 빨리 이 문제를 보좌관에게 맡겨 주세요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/Companions/Valerie/ktc41-Valerie_Q3_Start/Cue_0002_Text
#. Speaker : Linzi_Companion
msgctxt "90a6df78-edc8-4ff5-b6d6-8872eb58303f"
msgid ""
"\"An antique vendor, told me that that the Order of Prisms has been "
"spreading nasty rumors. – They're one of the branches of "
"{g|Shelyn}Shelyn's{/g} church.\" {n}Linzi scratches her chin "
"thoughtfully.{/n} \"Here's what I've been thinking... A couple weeks ago I "
"saw Valerie tear up some letter. She was so terribly angry! – Just like she "
"was back when her former mentor came for her... Anyway, I didn't ask her "
"about it – that would be more trouble than it's worth. But you'll probably "
"be able to find out what happened, and if this has any connection to Shelyn!"
"\""
msgstr ""
"\"골동품 상인한테 들은 건데, 프리즘 기사단이 이 더러운 소문을 퍼트린 범인이래요. 프리즘 기사단은 {g|Shelyn}셸린{/g}의 "
"교회에서 분파된 기사단이에요.\" {n}린지는 골똘히 생각에 잠겨 턱을 매만진다.{/n} \"실은 짐작 가는 게 있어요... 몇 주 전에 "
"발레리가 어떤 편지를 찢어버리는 모습을 봤어요. 엄청 화가 나 있었죠! 예전 스승이 찾아왔을 때처럼요. 잠자는 호랑이를 건드리는 꼴이라 "
"무슨 일인지 물어보지는 않았어요. 아마 폐하라면 알아낼 수 있을 거예요. 이 일이 셸린과 무슨 연관이 있는지 알아봐 주세요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0035_Text
msgctxt "21247271-907e-4c01-9511-1090fb9dafd3"
msgid "\"Who are you?\""
msgstr "\"당신은 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0036_Text
msgctxt "aa3cef14-1ed0-4b11-bcc9-4cc01f1204e9"
msgid "\"Tell me about those who tricked you.\""
msgstr "\"당신을 속였다는 사람에 대해 말해봐.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0037_Text
msgctxt "5e04cbec-ba42-42da-b6b4-c813c350e3ad"
msgid ""
"\"You don't seem like a local. Why would you keep these possessions of yours "
"on the island in the middle of Candlemere Lake?\""
msgstr "\"당신은 이 지역사람처럼 보이지 않는군. 왜 당신 소유물들을 캔들미어 호수 한가운데 있는 섬에 보관하려 하는거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0038_Text
msgctxt "ba53a5b5-da85-4f1d-81c7-67aff8f79096"
msgid "\"Fine, I'll try to figure it out.\""
msgstr "\"좋아. 한번 조사해보도록 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0039_Text
msgctxt "d5b513ac-b1d0-4900-b514-a6de3a384764"
msgid ""
"\"I'll need someone to show me the way. Would you go to the island with me?\""
msgstr "\"내게 길 안내를 할 사람이 필요해. 나와 함께 섬에 가지 않겠나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0040_Text
msgctxt "7f9c9f78-7c5a-4766-b402-3ce36e51d6d4"
msgid ""
"\"This whole story sounds strange. I don't really want to get involved.\""
msgstr "\"하는 이야기 전체가 이상합니다. 저는 관련되고 싶지 않습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0041_Text
msgctxt "64d0a178-eb11-478e-926e-9fff4a89e148"
msgid ""
"\"I visited the cursed island. It's swarming with monsters, the whole crew "
"is dead, and the ruins are empty — except for some ancient magic in the "
"tower walls.\""
msgstr ""
"\"나는 이 저주받은 섬을 방문했었습니다. 단지 탑의 벽면에 고대의 마법이 있었을 뿐, 괴물들이 우글거리고 모든 선원들이 죽었으며 유적은 "
"텅 비어 있었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0042_Text
msgctxt "8d2115fe-cccd-4f07-a592-93b58e044f92"
msgid "\"I have to go.\""
msgstr "\"나는 가야합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0064_Text
msgctxt "5b45f2b3-f190-4108-90e9-b8d929d8084d"
msgid "\"Can you tell me more about them?\""
msgstr "\"그들에 대해서 좀 더 말해 보겠어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0065_Text
msgctxt "1d69901a-9d77-4017-a1d0-7327a3e774e6"
msgid ""
"\"A paladin and a cleric who willingly took a job running errands for you? "
"Sounds strange, if you ask me.\""
msgstr "\"팔라딘과 사제가 당신을 위해 심부름하는 일을 맡았다고? 나에게는 이상하게 들리는군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0066_Text
msgctxt "60e5edaa-199f-48f3-abf8-784978dc683c"
msgid "\"Let's go back to my other questions.\""
msgstr "\"다른 것들을 질문해 보겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0076_Text
msgctxt "a6d914a3-f659-4e09-b484-8786b389eba9"
msgid "\"Which deity was this temple dedicated to?\""
msgstr "\"그 신전은 어느 신에게 바쳐진 것이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0077_Text
msgctxt "3d11688a-042c-430b-854a-e536c2cfec4b"
msgid ""
"\"Correct me if I'm wrong, but you believe that some sacred relics from the "
"temple of an unknown deity belong to you? By what right?\""
msgstr ""
"\"내 말이 틀렸다면 정정해 주겠어? 그러니까 그 이름모를 신전에 있는 어떤 성스러운 유물이 당신의 소유라는 건가? 무슨 권리로?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0084_Text
msgctxt "7f484b75-3fe6-4803-908a-7bc3a94e60d7"
msgid ""
"\"Someone offered sacrifices there — and I suppose we're not talking about "
"animal sacrifices?\""
msgstr "\"누군가 그곳에서 제물을 바친다고 했는데, 그건 동물을 바치는 제물 얘기가 아니겠지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0085_Text
msgctxt "8fb2d6a3-df30-4cd7-bb51-a1a5d9107933"
msgid "\"What ghostly lights are you talking about?\""
msgstr "\"무슨 유령같은 불빛을 말하는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0086_Text
msgctxt "1c2a9c36-c857-4e9f-af67-dd3224f698a9"
msgid ""
"\"You mentioned a flash of light over the ruins. Did you see it with your "
"own eyes, or just hear about it from someone else?\""
msgstr "\"폐허 넘어로 불빛이 번쩍였다고 했었지. 두 눈으로 직접 본 건가, 아니면 단지 누군가가 한 말을 들은건가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0090_Text
msgctxt "eb72df85-7823-4eeb-ac9d-4761250b9a5d"
msgid "\"I guess that's all I need to know about the island.\""
msgstr "\"그 섬에 대해서는 충분히 알게된거 같군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0099_AlignmentShift.Description
msgctxt "c0d726ac-5456-447c-8ca7-36922895158f"
msgid ""
"Confirmed the curse of Candlemere's island as the result of past evil deeds."
msgstr "과거의 악행의 결과로 인한 캔들미어 섬의 저주를 확인하였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0099_Text
msgctxt "e8c22472-0bf3-46a5-a485-301af92c5fcb"
msgid ""
"\"Of course, it exists. This island has seen too much sorrow and suffering — "
"now any living creature who sets a foot there is doomed. The locals should "
"stay away from the place to avoid the dormant evil within the tower.\""
msgstr ""
"\"물론 저주는 존재하지. 이 섬은 너무 많은 슬픔과 고통을 겪었어. 이제 어떤 생명체도 그곳에 발을 들이면 파멸할 것이다. 탑 안에 "
"잠재해 있는 악을 피하려면 주민들은 그곳에서 멀리 떨어져있어야만 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0100_AlignmentShift.Description
msgctxt "0e4387c4-8de2-431e-bda7-b8eec7e3ce00"
msgid ""
"Denied the existence of the curse on Candlemere's island, which can affect a "
"person's destiny."
msgstr "개인의 운명에 영향을 미칠 수 있다는 캔들미어 섬의 저주가 존재하지 않는다고 부정했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0100_Text
msgctxt "d29a5b85-7d6f-40b6-b2e8-3515c9dea856"
msgid ""
"\"There is no curse. Bad things just happen to people sometimes — it's as "
"simple as that. These three went somewhere dangerous and failed to overcome "
"its dangers. It's sad, but hardly supernatural.\""
msgstr ""
"\"그곳에는 어떤 저주도 없다. 사람들에게 때때로 나쁜 일이 일어나는 것처럼 단순한 일인거야. 그 세사람은 위험한 곳으로 갔고 그 위기를 "
"극복하는데 실패한 것 뿐이다. 슬픈일이지만, 초자연적인 현상은 아니야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0101_Text
msgctxt "0be65f7f-cbd8-4bba-903e-436326d18836"
msgid ""
"\"You know, it just occurred to me... You sent those poor sods to the "
"island, right? So it was you who doomed them and sent them to certain death —"
" and then you sent me there, as well. So now I'll have to spend my own "
"resources paying for a purification ritual, and you're just going to leave "
"like nothing happened?\""
msgstr ""
"\"있잖아, 막 떠오른 생각인데말야... 너는 그 불쌍한 세 친구들을 섬으로 보냈다고 했지? 결국 네가 그들에게 불운을 안기고 확실한 "
"죽음으로 내몬 거야. 그리고 너는 나까지 그 곳으로 가게 만들었지. 그래서 이제 나는 정화 의식을 치르느라 내 자원들을 써야 할 텐데, "
"너는 그저 아무일도 없었던 것처럼 그냥 떠나겠다는 거야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0115_Text
msgctxt "d411a5c0-a79e-44cf-8f6b-56cf528788b4"
msgid ""
"\"I visited the cursed island. It swarms with monsters, the ranger and the "
"paladin are dead, and the cleric of Nethys left in voluntary exile. The "
"ruins are completely empty — no treasures.\""
msgstr ""
"\"그 저주받은 섬에 가보았었어. 괴물들이 우굴거리고, 레인저와 팔라딘은 죽었고, 네서스의 사제는 스스로 유배 길에 올랐지 . 폐허는 "
"완전히 비어있었고 보물 같은건 없었다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0121_AlignmentShift.Description
msgctxt "dd7a12de-a77f-4d26-a06d-6c60b40d4b93"
msgid "Scoffed at the ill fate of the explorers on Candlemere's island."
msgstr "캔들미어 섬의 탐험가들이 맞이한 불운한 운명을 조롱했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0121_Text
msgctxt "05debc84-17e0-4d92-9bde-23d24d9fb967"
msgid ""
"\"Why should I care? Three idiots dead, end of story. What about my reward?\""
msgstr "\"왜 내가 신경써야하지? 세 멍청이가 죽었고, 이야기는 끝났어. 내 보상은 어디있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0123_AlignmentShift.Description
msgctxt "77b87f12-f41c-49a8-a456-a80250b5f416"
msgid ""
"Declared to Willas Gunderson that destiny, fate, and curses have no hold "
"over a person's life."
msgstr "운명이나 저주가 사람의 삶을 지배하지 못한다고 윌라스 건더슨에게 분명하게 말했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Answer_0123_Text
msgctxt "eed6bace-32e7-4013-a67e-99f0f9cc5c86"
msgid ""
"\"Whether it exists or not — are you going to spout nonsense about fate and "
"doom now? The world's full of strange things, and looking for logic and "
"consistency is a waste of time — people just do what they like. Some people "
"sacrifice victims on an altar, others search for treasure among ruins, and "
"some just grow sick and tired of listening to some boring idiot — so let's "
"switch topics to something more interesting, like the reward for my work.\""
msgstr ""
"\"저주가 존재하든 아니든, 지금 운명이나 파멸 같은 허튼 소리를 계속할건가? 세상은 온갖 신기한 것들로 가득차 있고 논리와 일관성을 "
"찾는 것은 시간낭비지. 사람들은 자신이 원하는 일을 할 뿐이야. 어떤 사람은 제단에 희생자들을 제물로 바치고, 어떤 사람은 폐허 속에서 "
"보물을 찾고, 어떤 사람은 지루한 멍청이의 이야기를 듣는 것에 지겨워하고 있어. 그러니 이제 좀 더 흥미로운 주제로 넘어가 보자고, 내가 "
"한 일의 보상 같은걸로 말야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0001_Text
#. Speaker : WillasGunderson
msgctxt "49ef5003-d97d-4c7e-bce7-5eb905101687"
msgid ""
"{n}A plump man in his thirties approaches you. His hair's untidy, road dust "
"covers his worn clothes, and his boots have seen better days. The stranger "
"speaks to you in unusually high-pitched voice.{/n} \"Your Grace! I demand "
"justice!\""
msgstr ""
"{n}한 통통한 30대의 남성이 당신에게 다가옵니다. 그의 머리는 정돈되지 않았고 길의 흙먼지가 옷가지를 온통 덮고 있었으며, 신발은 "
"오래 사용하여 낡았습니다.이 낯선 이는 당신에게 비정상적일 정도로 높은 목소리로 이야기 합니다.{/n} \""
"{mf|영주님|영주님|전하|전하}! 저는 정의를 요구합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0004_Text
#. Speaker : WillasGunderson
msgctxt "2ee65b1a-9cb2-42c1-ac5e-888bf317c4ef"
msgid ""
"{n}Willas raises his eyes, and his face lights up.{/n} \"{mf|My baron|My "
"baroness}! Have you changed your mind?\""
msgstr "{n}윌라스는 눈을 치켜뜨며 얼굴에는 화색이 돕니다.{/n} \"{mf|남작님|여남작님}! 생각을 바꾸신 겁니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0008_Text
#. Speaker : WillasGunderson
msgctxt "1fbbea69-83bf-4c80-a8b7-f0bd3639c669"
msgid ""
"\"Crime in the barony is on the rise!\" {n}The man shakes his clenched "
"fists, then drops his hands helplessly.{/n} \"In open daylight I was "
"tricked, robbed, and if that weren't enough, humiliated!\""
msgstr ""
"\"남작령에서 범죄가 늘어나고 있습니다!\" {n}그 남자는 그의 꽉 쥔 주먹을 휘두르고는 힘없이 그의 손을 떨굽니다.{/n} \"저는 "
"벌건 대낮에 속임수를 당해, 강도질을 당하고, 그것도 모자라 굴욕까지 당했습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0031_Text
#. Speaker : WillasGunderson
msgctxt "4bbff448-8323-4d0e-9098-93c4558c58ed"
msgid ""
"{n}Willas raises his head and gives you a nervous smile.{/n} \"{mf|My baron|"
"My baroness}! I was waiting for you! Any news?\""
msgstr ""
"{n}윌라스는 고개를 들고 당신에게 신경질적인 미소를 짓습니다.{/n} \"{mf|남작님|여남작님}! 당신을 기다렸습니다! 새로운 "
"소식이라도?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0032_Text
#. Speaker : WillasGunderson
msgctxt "85849c63-4867-4c9c-b4a9-0fce96556564"
msgid ""
"\"A gang of local thugs tricked me into trusting them. They found out about "
"my possessions and disappeared with my treasures! I sent them to the island "
"on {g|Candlemere}Candlemere{/g} some time ago, and they just vanished into "
"thin air!\""
msgstr ""
"\"이 지역의 폭력배 무리들이 저를 속여 자신들을 믿게 만들었습니다. 그들은 제 소유물들을 찾아주겠다하고는 제 보물들과 함께 "
"사라졌습니다! 저는 그들을 {g|Candlemere}캔들미어{/g}에 있는 섬으로 3일 전에 보냈었는데, 흔적도 없이 사라져버린 겁니다!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0033_Text
#. Speaker : WillasGunderson
msgctxt "f2d29cb3-56ba-4fac-a14d-2d6515c6f13d"
msgid ""
"\"I beg you — find these scoundrels and retrieve my treasure! I'll pay a "
"handsome sum to be sure these villains are brought to justice!\""
msgstr ""
"\"이렇게 간청합니다. 이 악당들을 찾아내서 제 보물들을 돌려주십시오! 이 악당들에게 정의를 가르쳐줄 수 있다면 거액을 지불하겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0043_Text
#. Speaker : WillasGunderson
msgctxt "7d26a042-e884-43f1-b248-4e7680579815"
msgid ""
"\"Willas Gunderson, Your Grace! I'm a scientist, an explorer, an adventurer, "
"and a renowned expert in treasures and artifacts of virtually every era and "
"culture.\""
msgstr ""
"\"윌라스 건더슨입니다. {mf|영주님|영주님|전하|전하}! 저는 과학자이자, 탐험가이자, 모험가이자 사실상 모든 시대와 문화의 보물들, "
"유물들에 대한 저명한 전문가입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0045_Text
#. Speaker : Jubilost_Companion
msgctxt "61d63a6c-cc34-4ea2-88c0-04bfd4e759e5"
msgid ""
"{n}Jubilost eyes Willas up and down.{/n} \"So many titles for a single piece "
"of mediocrity.\""
msgstr ""
"{n}주빌로스트는 윌라스를 위 아래로 쳐다봅니다.{/n} \"한 줌꺼리밖에 안되는 보통 사람에게 너무나 많은 타이틀이 붙어있군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0047_Text
#. Speaker : WillasGunderson
msgctxt "860abbfa-142a-40d9-9491-cac5079e6e09"
msgid ""
"{n}Willas blushes and pretends that he just noticed the gnome.{/n} \"S-sir "
"Narthropple! Y-you're here! What a nice s-surprise!\""
msgstr ""
"{n}윌라스는 얼굴을 붉히며 이제 막 그 노움을 알아차렸다는 양 굴었습니다.{/n} \"나트로플 경! 여, 여기 계셨군요! 굉장히 반, "
"반갑습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0048_Text
#. Speaker : Jubilost_Companion
msgctxt "d1dc5c43-57be-4cbe-9a37-7c6e522a399d"
msgid ""
"\"Oh really? In case you hadn't noticed, I've been here from the start. Or "
"perhaps after the open lecture in the Forae Logos in {g|Absalom}Absalom{/g}, "
"you've lost not only the rest of your mind, but also your eyesight?\""
msgstr ""
"\"오, 그래? 혹시 날 못알아볼까봐 난 처음부터 여기 있었다네. 아니면 {g|Absalom}압살롬{/g}의 포래 로고스에서 열렸던 공개 "
"강의 이후로, 자네는 정신머리 뿐만이 아니라 시력도 잃어버린건가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0049_Text
#. Speaker : WillasGunderson
msgctxt "d8e563c3-6b6c-4c4d-bce1-e3996bdd1f86"
msgid ""
"{n}Willas straightens his jacket indignantly and lifts his chin.{/n} \"I see "
"your manners haven't improved since last we met! Well, happily, I no longer "
"consider you the beacon of knowledge you once were. You can joke however you "
"like — I'm above such discourse!\""
msgstr ""
"{n}윌라스는 분개한 듯 재킷을 곧게 펴고 턱을 들어 올립니다.{/n} \"마지막으로 우리가 만난 이후로 당신의 예절은 조금도 나아지지 "
"않았군요! 뭐, 행복하게도 저는 더 이상 당신을 지식의 등불로 여기지 않습니다. 마음껏 농담하시지요. 난 그런 대화보단 수준이 높으니!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0050_Text
#. Speaker : Jubilost_Companion
msgctxt "0a943408-cca5-4632-82ac-0980b49308a0"
msgid ""
"{n}Jubilost grins.{/n} \"The only thing that puts you above me is your size, "
"Willas. And even that isn't so impressive for a human.\""
msgstr ""
"{n}주빌로스트는 활짝 웃음 짓습니다.{/n} \"자네가 나보다 더 위에 있는건 자네 사이즈 뿐일세. 윌라스. 심지어 인간치고는 그렇게 "
"인상적인 수준도 아니야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0051_Text
#. Speaker : WillasGunderson
msgctxt "46ec9ec2-f7e3-406b-8cc7-88c868e7ad19"
msgid ""
"{n}Willas face turns dark red and his eye starts to twitch. Pressing his "
"lips tightly he turns back to you.{/n}"
msgstr "{n}윌라스의 얼굴이 검붉게 변하고 눈이 경련을 일으키기 시작합니다. 그는 입술을 꾹 닫은채, 당신을 향해 돌아섭니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0060_Text
#. Speaker : WillasGunderson
msgctxt "022797fb-6d62-4d2f-9837-fafa36390e72"
msgid ""
"\"They were a trio I hired to retrieve my possessions from "
"{g|Candlemere}Candlemere{/g}'s island turned out to be a bunch of "
"tricksters. You must know the place — in the center of the lake, with the "
"ancient temple ruins. So they took my money, jumped into the boat, and — "
"whoosh! — gone with the wind. So many days have passed, and not a single "
"word from them! And they had the nerve to call themselves a paladin and a "
"cleric! Scum is what they really are!\" {n}Willas stamps the ground in "
"anger.{/n}"
msgstr ""
"\"그들은 {g|Candlemere}캔들미어{/g} 섬에서 제 소유물들을 회수해오라고 제가 고용한 삼인조 였습니다. 결국 그들은 "
"사기꾼들로 밝혀졌습니다. 호수 중앙에 있는, 고대의 신전 폐허가 있는 곳을 아실 겁니다. 그곳에서 그들은 제게서 돈을 챙기더니 보트에 "
"올라타서는 쌩! 하고 바람과 같이 사라졌습니다. 여러 날이 지났지만 그들로부터는 어떤 소식도 없습니다! 그리고는 배짱 좋게도 자신들을 "
"팔라딘과 클레릭이라고 부르고 있습니다. 정말이지 인간 쓰레기들이 따로 없습니다!\" {n}윌라스는 분노에 바닥에 발을 구릅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0067_Text
#. Speaker : WillasGunderson
msgctxt "f21a5fd7-e623-49f4-969a-ef9ddeee527d"
msgid ""
"\"A ranger, a paladin of {g|Irori}Irori{/g}, and a cleric of "
"{g|Nethys}Nethys{/g} — you know, that two-faced god. Frankly speaking, that "
"one gave me creeps from the very beginning — half of those servants of "
"Nethys are real psychos. Today they agree to help you, and tomorrow they "
"change their minds at the drop of a hat. And this one played his tricks on "
"me, too.\" {n}Willas sighs.{/n}"
msgstr ""
"\"레인저 한명, {g|Irori}이로리{/g}의 팔라딘 한명, 그리고 {g|Nethys}네서스{/g}의 사제 한 명입니다. 아시겠지만 "
"네서스는 두얼굴의 신이죠. 솔직히 말해서, 그 사제는 저를 처음부터 소름끼치게 했습니다. 네서스의 하인들 절반은 정말 정신병자들이니까요. "
"오늘 당신을 돕겠다고 하고는, 내일이면 단번에 마음을 바꾸는 자들입니다. 그렇게 그 사제도 저를 가지고 놀았습니다.\"{n}윌라스가 "
"한숨을 쉽니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0068_Text
#. Speaker : WillasGunderson
msgctxt "b74deaa7-85bb-40aa-b640-91dcebc569d3"
msgid ""
"{n}Willas mulls over your words for some time.{/n} \"You know, Your Grace... "
"When I mentioned the old temple, they exchanged a glance — like I was "
"talking about some hidden treasure... I was such a fool! I should have "
"realized from the start that they had their own agenda!\""
msgstr ""
"{n}윌라스는 한동안 당신의 말을 곰곰히 생각해봅니다.{/n}\"저기요, {mf|영주님|영주님|전하|전하}...제가 오래된 신전을 "
"언급했을 때, 그들은 서로 눈빛을 교환했습니다. 마치 제가 어떤 숨겨진 보물에 대해 말하는 것처럼요...제가 정말 바보였습니다! 처음부터 "
"그들이 뭔가를 계획한다는 것을 깨달았어야 하는건데!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0069_Text
#. Speaker : WillasGunderson
msgctxt "ade20e50-489b-47ed-983b-9bcae567cead"
msgid ""
"{n}Willas bites his lip, as if caught doing something wrong.{/n} \"Well... "
"ahem... You see, these aren't EXACTLY my possessions right now. It's just... "
"I learned from the locals about the ruins of an ancient temple on the "
"island. And everyone knows, where there's a temple, there's always the hope "
"of some treasure.\" {n}Willas rubs his palms.{/n}"
msgstr ""
"{n}윌라스는 무슨 잘못을 저지르다 들킨 듯 입술을 깨물었습니다.{/n} \"그게... 아, 그러니까... 지금 당장은 정확히 제 "
"소유물은 아닙니다. 단지..저는 그 섬에 있는 고대 신전의 폐허에 대해 이곳 현지 주민에게서 알아냈습니다. 그리고 모두가 알다시피, "
"신전이 있는 곳이라면, 보물들도 있기를 바라는 법이죠.\" {n}윌라스는 손바닥을 문질러대고 있습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0070_Text
#. Speaker : WillasGunderson
msgctxt "d6b0aae3-0345-4d61-8d93-dd5b159c53c8"
msgid ""
"{n}Willas looks around, scared.{/n} \"Wait, me? Come with you? No way! Three "
"armed men went and never came back! And I can't even swing a sword, or cast "
"the simplest spell... Oh no, You Grace, you'll need to find someone more "
"experienced for that!\""
msgstr ""
"{n}윌라스는 겁을 먹고는 주변을 둘러보았습니다.{/n}\"잠시만, 저말입니까? 함께 간다고요? 안됩니다! 세 명의 무장한 사람들이 "
"가서는 돌아오지 않았습니다! 게다가 저는 검을 휘두르지도, 간단한 주문조차 시전하지도 못합니다...오, 안됩니다, 영주님. 보다 숙련된 "
"사람을 찾으셔야만 합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0071_Text
#. Speaker : WillasGunderson
msgctxt "fcbed2a1-f646-4946-83f4-d48f8581c08d"
msgid "\"As you wish — whatever you need to catch these thieves!\""
msgstr "\"이 도둑들을 잡기 위해서라면 무엇이든, 바라시는데로!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0078_Text
#. Speaker : WillasGunderson
msgctxt "2aba5381-cbd6-4ab5-a7c3-9826a5a60a95"
msgid ""
"\"Who cares...\" {n}Willas interrupts himself and sighs.{/n} \"I don't know! "
"I never asked! All I heard is that long ago the locals used to perform some "
"rituals there, dedicated to some ancient deity.\""
msgstr ""
"\"누가 신경이나 쓸지...\"{n}윌라스는 한숨을 쉬며 이야기를 잠시 멈추었습니다.{/n} \"모르겠습니다! 물어본 적도 없지요! 제가 "
"들은 것이라곤 옛날에는 그곳에서 어떤 고대의 신에게 바치는 어떤 의식을 행했다는 것뿐입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0079_Text
#. Speaker : WillasGunderson
msgctxt "c771f3d9-e311-4474-826f-7fbc5b68d275"
msgid ""
"\"By the right of finding! I dug up all the stories about the temple! I "
"hired the crew! I pointed out where to start the search! Besides, no harm "
"done. No one ever really goes there anyway — there aren't many volunteers "
"willing to visit a cursed island!\""
msgstr ""
"\"발견한 것에 대한 권리로서! 신전에 관한 모든 이야기를 알아냈습니다! 일꾼들을 고용했지요! 어디서부터 탐색해야 할지도 지정해 "
"주었습니다! 게다가, 아무런 해도 끼치지 않았어요. 아무도 실제로 그곳에 가는 사람은 없습니다. 저주받은 섬에 기꺼이 자원해서 가려는 "
"사람은 많지 않거든요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0087_Text
#. Speaker : WillasGunderson
msgctxt "e0d60e57-ab1c-4a75-b39e-b4672a6d363f"
msgid ""
"{n}Willas shrugs reluctantly.{/n} \"The locals say… things… Something about "
"that being why the place is cursed.\""
msgstr ""
"{n}윌라스는 마지못해 어깨를 으쓱거렸습니다.{/n}\"주민들이 말하길.. 그 장소가 저주받은..어떤..이유 때문이라고 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0088_Text
#. Speaker : WillasGunderson
msgctxt "153e73dc-2108-483a-9fbc-bd13e7f7b3bc"
msgid ""
"\"The lights were strange, you know?\" {n}Willas frowns, as if recalling "
"something.{/n} \"They were brighter than fireflies, and different colors. "
"You can see them even from the shore. During the day, they're barely "
"visible, but at night... People say they're the restless souls of those who "
"met their deaths on the island.\""
msgstr ""
"\"그 불빛은 이상했습니다.\"{n}윌라스는 마치 무엇을 떠올리려는 듯 얼굴을 찌푸렸습니다.{/n} \"그것들은 반딧불보다 밝고 또 "
"색깔도 달랐습니다. 심지어 강가에서도 그 불빛들을 볼 수 있습니다. 한낮에는 거의 보이지 않았지만, 밤이되면...사람들은 그것들이 섬에서 "
"죽음을 맞이한 자들의 쉬지 못하는 영혼이라 말들 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0089_Text
#. Speaker : WillasGunderson
msgctxt "e1fac804-07db-4ff8-9845-19364ee87f9b"
msgid ""
"\"I saw it with my own eyes, and just recently! Almost blinded me — like "
"half the island suddenly burst into flames! When the locals saw it, they "
"fell to their knees and started to pray — they said that the old god had "
"returned.\" {n}Willas scoffs.{/n} \"Dimwits — what else would you expect "
"from them.\""
msgstr ""
"\"제 두 눈으로 똑똑히 보았습니다. 그것도 최근에 말이지요! 거의 제 눈이 멀뻔 했지요, 마치 섬의 절반이 갑자기 불길에 휩싸인 듯 "
"했습니다! 주민들이 이를 보곤, 무릎을 꿇고 기도를 하기 시작했습니다. 그들이 말하길 오래된 신이 되돌아 왔다고 하더군요.\"{n}"
"윌라스가 비웃습니다.{/n} \"멍청이들. 제가 그들에게 뭘 기대하겠습니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0091_Text
#. Speaker : WillasGunderson
msgctxt "dfc1286a-a3ba-4e6a-9882-d244a899eebe"
msgid "\"Whatever you say, {mf|my baron|my baroness}.\""
msgstr "\"예. 여부가 있겠습니까. {mf|남작님|남작님}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0092_Text
#. Speaker : WillasGunderson
msgctxt "f44a9a06-66bc-40a9-90f3-f6b9d43fc0d2"
msgid ""
"{n}Willas sighs, relieved.{/n} \"Praise {g|Desna}Desna{/g}! Don't let those "
"scoundrels leave with my treasure!\""
msgstr ""
"{n}윌라스는 한숨을 내쉬며 안도했습니다.{/n} \"{g|Desna}데즈나{/g}를 찬양하라! 제 보물과 함께 그 도적놈들이 도망가지 "
"못하게 해 주십시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0095_Text
#. Speaker : WillasGunderson
msgctxt "738ae8a0-308a-4f8c-b41b-080f787ec3e8"
msgid ""
"{n}Willas's jaw drops in surprise — it seems he was sure you'd help him. "
"After a moment, his face falls, almost like that of a wronged child.{/n} \""
"{mf|My baron|My baroness}! Don't turn away from my pleas! Don't leave me "
"helpless! I have no one here — no friends or relatives! Your Grace is my "
"only hope!\""
msgstr ""
"{n}윌라스는 놀라 입을 떡 벌렸습니다. 그는 마치 당신이 그를 도와줄 것을 확신했었던 것 같습니다. 잠시 후, 마치 잘못한 아이의 "
"그것처럼 그의 고개가 푹 숙여집니다.{/n}\"{mf|남작님|남작님}! 저의 간청을 외면하지 말아주십시오! 저를 내버려두지 말아주십시오! "
"저는 이곳에 친구도 친척도 없습니다! 영주님이 오직 제 희망입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0097_Text
#. Speaker : WillasGunderson
msgctxt "73330c8d-7ce5-4f22-9ffa-646504a325b0"
msgid ""
"{n}For several moments, Willas is silent, trying to wrap his head around "
"what you said. He finally shudders and hugs himself, as though he suddenly "
"grew cold.{/n} \"That means...\" {n}He gulps.{/n} \"That means the curse "
"really exists...\" {n}His eyes meet yours.{/n} \"Right?\""
msgstr ""
"{n}잠시동안, 윌라스는 조용히 당신이 한 말을 이해하려고 애썼습니다. 그는 갑자기 한기가 느껴진 듯 부들부들떨더니 양팔을 "
"감싸안았습니다.{/n} \"그 말은...\"{n}그가 침을 꿀꺽 삼킵니다.{/n} \"그 말은 실제로 저주가 있었다는 뜻이군요...\""
"{n}그의 눈이 당신과 마주쳤습니다.{/n}\"그렇죠?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0102_Text
#. Speaker : WillasGunderson
msgctxt "4bda4123-f86d-4cdd-acee-c0eaae1577e0"
msgid ""
"{n}Willas shakes his head.{/n} \"If a cleric and a paladin together were "
"unable to put an end to this curse, it would truly be unwise to try and go "
"there again... Too bad, too bad! Well, here's your reward, as promised.\" {n}"
"Willas gives you a pouch of coins.{/n}"
msgstr ""
"{n}윌라스는 그의 머리를 흔들었습니다. {/n}\"그 클레릭과 팔라딘이 함께해도 이 저주를 끝낼 수 없었다면, 그곳에 다시 가려고 하는 "
"것은 정말로 현명하지 못한 것일 겁니다....아주 안됐군요. 아주 안됐어요! 자, 여기 약속하였듯 보상금입니다.\" {n}윌라스는 "
"당신에게 동전 주머니를 건냈습니다..{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0103_Text
#. Speaker : WillasGunderson
msgctxt "cee82ecf-c605-422e-8a9c-2a38ea9cca9c"
msgid ""
"{n}Willas stares at you in admiration.{/n} \"You're so strong, Your Grace! "
"Tough and strong! Praise be to {g|Desna}Desna{/g}, you managed to come back "
"to your subjects alive and well! Please accept your reward!\" {n}Willas "
"presents you with a pouch of coins.{/n}"
msgstr ""
"{n}윌라스는 당신을 존경의 눈길로 바라봅니다..{/n} \"당신은 정말로 강하시군요, 나리! 굳세고 강하십니다! "
"{g|Desna}데즈나{/g}를 찬미할지어다, 당신의 백성들에게 살아서 돌아오시게 하였도다! 제 보상을 받아주십시오!\" "
"{n}윌라스는 동전 주머니를 선물했습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0113_Text
#. Speaker : WillasGunderson
msgctxt "7844eb39-c1a1-46d2-8a7e-7cbc35d8a778"
msgid ""
"\"If you manage to learn something new — please let me know! I'm staying at "
"the tavern in the center of town — that's where I'll wait for good news!\" "
"{n}Willas bows and steps back from you without straightening back up.{/n}"
msgstr ""
"\"무언가 새롭게 알게되는 게 있으시다면 제게 꼭 알려주십시오! 저는 마을 중심에 있는 주점에서 머무르고 있습니다. 그곳에서 좋은 소식을 "
"기다리고 있겠습니다!\" {n}윌라스는 당신에게 인사하고는 허리를 숙인채 뒤로 물러났습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0114_Text
#. Speaker : WillasGunderson
msgctxt "5eb5a726-68eb-4cee-bcf0-c696ac2da244"
msgid ""
"\"I'm staying at the tavern in the center of town. I beg you, if you change "
"your mind… if you decide to look into it... I'll wait.\" {n}Willas gives you "
"an awkward bow and leaves.{/n}"
msgstr ""
"\"마을 중심부에 있는 주점에서 머무르고 있습니다. 청하건데, 그곳에 가시고자...마음이 바뀌신다면...저는 기다리도록 하겠습니다.\""
"{n}윌라스는 당신에게 어색한 인사를 건내고는 떠났습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0117_Text
#. Speaker : WillasGunderson
msgctxt "4e0317f2-7f0c-4076-9fff-5206c5865f47"
msgid ""
"{n}Willas's jaw drops.{/n} \"What?! But... I just...\" {n}The man seems to "
"shrink in terror.{/n} \"No! Of course not, Your Grace... I'll... I'll "
"compensate you... now... Here, Your Grace.\" {n}Willas digs a pouch full of "
"coins from his pocket and hands it to you, barely avoiding dropping it on "
"the ground.{/n} \"Here... this must be enough.\""
msgstr ""
"{n}윌라스의 입이 떡 벌어졌습니다.{/n}\"뭐라구요?! 하지만...저는 단지...\"{n}이 남성은 공포에 떠는 듯 했습니다.{/n} "
"\"아닙니다! 당연히 아니지요, 나리...저는...저는 보상토록 하겠습니다...지금...여기있습니다, 나리.\"{n}윌라스는 그의 "
"주머니에서 꽉찬 동전 주머니를 꺼내서는 그것이 땅에 떨어질까 조심스럽게 당신 손에 건냅니다.{/n} \"여기있습니다...이 정도면 충분할 "
"것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0118_Text
#. Speaker : WillasGunderson
msgctxt "a4a4e3b5-d330-47c7-b479-5e8437007e10"
msgid ""
"{n}Willas looks shocked at first, but he soon regains his composure.{/n} \"I "
"suppose, Your Grace, that the cause of all the troubles must have been "
"something else... Maybe weather conditions were unfavorable, or... actually, "
"I think you have nothing to worry about.\" {n}He casts an unkind glance "
"toward you and digs out a pouch of money.{/n} \"Here is your reward. As "
"promised.\""
msgstr ""
"{n}윌라스는 충격받은 표정이었다가 곧 그의 평정을 되찾았습니다.{/n} \"추측하건데, {mf|영주님|영주님|전하|전하}, 모든 문제의 "
"원인은 분명 다른 것이었을 것입니다...아마도 날씨가 좋지 않았거나, 아니면...사실, 당신께서 염려하실 만한 것은 없다 생각합니다.\""
"{n}그는 친절하지 않은 눈길로 당신을 바라보더니 동전 주머니를 꺼냅니다.{/n} \"여기 약속했던 보상이 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0120_Text
#. Speaker : WillasGunderson
msgctxt "cb7b7324-cc12-4ac4-a487-ba7601c06ced"
msgid ""
"{n}Willas looks around, slapping his pockets.{/n} \"Seems I've had no luck "
"with this island — no profits at all! I guess I should move further to the "
"east. People say the {g|Tors of Levenies}Tors of Levenies{/g} have plenty of "
"places where an inquisitive mind might find something of value. And right "
"now, if you don't mind, I could use a drink.\""
msgstr ""
"{n}윌라스는 주변을 돌아보고는 그의 주머니를 탁 털었습니다.{/n}\"이 섬에는 제 운이란게 없었던 것 같군요. 득이 된게 하나도 "
"없습니다! 좀 더 동쪽으로 이동해 보아야 할 것 같습니다. 사람들은 {g|Tors of Levenies}레베니스 바위산맥{/g}에는 "
"탐구심이 강한 이들이 무언가 가치있는 것을 찾을 만한 많은 곳들이 있다고 이야기하더군요. 그리고 지금 당장은, 상관없으시다면 저는 한 잔 "
"해야겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0122_Text
#. Speaker : WillasGunderson
msgctxt "847f16bd-0b02-4c9f-8a39-ba08c59ed426"
msgid ""
"{n}Willas purses his lips, obviously dissatisfied with such a short answer. "
"He digs a pouch of coins out of his pocket and gives it to you.{/n} \"Here, "
"Your Grace. I keep my word.\""
msgstr ""
"{n}윌라스는 이런 짧은 답변에 명백하게 불만족스러워 입을 오므렸습니다. 그는 그의 주머니에서 동전 주머니를 꺼내더니 당신에게 "
"전해줍니다.{/n} \"여기있습니다, 나리. 제가 한 말은 지키겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0124_Text
#. Speaker : WillasGunderson
msgctxt "69edd756-4738-471d-89fe-da3bac9d30f9"
msgid ""
"{n}Willas opens his mouth, then closes it, then opens again, as if failing "
"to find the right words. It seems that your answer sent him into a "
"stupor.{/n} \"You... you really think so?\" {n}Gunderson's face lights up, "
"as if you've removed a huge invisible burden from his shoulders.{/n} \"Your "
"words are the balm for my soul! Everyone around keeps talking about "
"obligations and promises, and the truth is, anyone should do whatever they "
"feel like!\""
msgstr ""
"{n}윌라스는 적당한 말들이 떠오르지 않는지 그의 입을 열었다 닫았다 하고 있습니다. 당신의 대답이 그를 당황시킨 듯 보입니다.{/n} "
"\"당신은...당신은 정말로 그렇게 생각하십니까?\"{n}건더슨의 표정이 마치 그의 어깨에서 보이지 않던 커다란 짐을 내려놓은 것처럼 "
"밝아집니다.{/n}\"당신의 말씀은 제 영혼을 치료하는 약입니다! 주변 모든 사람들이 의무와 약속에 대해 이야기 합니다만, 실은, "
"누구든지 자신의 마음이 내키는 대로 해야 하는 법입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0125_Text
#. Speaker : WillasGunderson
msgctxt "9d0061e4-d045-4e18-b01a-ddcb0d5e7261"
msgid ""
"{n}Willas digs out a pouch of coins.{/n} \"Here is your reward, {mf|my baron|"
"my baroness}. And this...\" {n}He takes a parcel out of another pocket.{/n} "
"\"This is a small gift from a kindred spirit. It's a true rarity, to meet "
"such a wise person as yourself! This is something I snatched up at... Well, "
"the location isn't important. I think it may be of use to you.\""
msgstr ""
"{n}윌라스는 동전 주머니를 꺼냅니다.{/n} \"여기 보상이 있습니다, {mf|남작님|여남작님}. 그리고 이것은...\"{n}그는 다른 "
"주머니에서 꾸러미를 꺼내었습니다.{/n}\"이것은 친절한 이를 위한 작은 선물입니다. 당신과 같이 현명한 사람을 만다는 일은 매우 드문 "
"일입니다! 이것은 제가 낚아챈 것입니다...예, 어디서 한 것인지가 중요한 것은 아니지요. 당신에게 쓸모가 있을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0130_Text
msgctxt "f151c552-bd8b-4f37-8191-1a22fdf74549"
msgid ""
"{n}It seems like Willas is talking about will-o'-wisps — malevolent "
"creatures made of light that feed on fears and other negative emotions.{/n}"
msgstr ""
"{n}윌라스는 윌 오 위스프에 대해 이야기하는 것 같습니다. 공포와 다른 부정적인 감정을 먹고 사는 빛으로 된 악의적인 "
"생명체입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0131_Text
msgctxt "b398f0f8-4f9d-4c90-82b2-9f1ab66665c7"
msgid ""
"{n}You're not sure what Willas is talking about. Maybe the island is really "
"haunted with the spirits of the deceased?{/n}"
msgstr ""
"{n}당신은 윌라스가 말하는 것이 무엇인지 확신하지 못했습니다. 정말로 그 섬이 죽은 이들의 혼들에 사로잡혀 있는 것일까요?{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0133_Text
#. Speaker : Jubilost_Companion
msgctxt "6479485a-4ce4-4c2c-9e70-3a37478c9019"
msgid ""
"\"Typical for Master Gunderson! I wouldn't be surprised if, after this "
"conversation, our poor timid friend will need a companion to guide him to "
"his own door!\""
msgstr ""
"\"언제나의 마스터 건더슨이로군! 이 대화가 끝나면 우리 불쌍하게도 소심한 친구는 그의 문까지 데려다줄 동료가 필요하다 해도 별로 "
"놀랍지가 않겠군!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0136_Text
#. Speaker : Jubilost_Companion
msgctxt "32f0908d-3d14-4172-94d8-a531e591adc1"
msgid ""
"\"Some rituals, some ancient deities… Now that's what I call getting into "
"details! With deep knowledge like that, you could easily write a book! You "
"could call this opus magnum of yours 'Some Encyclopedia'!\""
msgstr ""
"\"어떤 의식, 어떤 고대 신들이라...저 용어들이야말로 진정한 전문성이구만! 자네가 지닌 이 정도의 상세한 지식이라면, 자네는 한 권의 "
"책도 쉽게 쓰겠다! 그리고는 그 대작 제목을 너의 '어떤 백과사전'이라고 부르면 되겠군!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_0139_Text
#. Speaker : Jubilost_Companion
msgctxt "7324f4f4-4250-4408-8fd4-fc69b698fc32"
msgid "\"…Says the king of dimwits.\""
msgstr "\"....라고 멍청이들의 왕이 말했다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_Candlemere/Cue_CNDLMR_CURSE_REVEAL_Text
#. Speaker : WillasGunderson
msgctxt "05baa2b7-38aa-45f4-a9ba-1299782af1f1"
msgid ""
"{n}Noticing the change in your face, Willas restrains himself.{/n} \"Oops, "
"I'm just talking gibberish! Heard some gossip somewhere — and here I am, "
"spilling it all on you!\" {n}The man utters a phony giggle, then gulps.{/n} "
"\"It's... nothing, Your Grace. Just a big fat load of nothing. Some empty "
"talk about someone sacrificing someone else there... And as for the ghostly "
"lights, I'm sure there's a rational explanation for that... Same with the "
"flash of light over the ruins...\""
msgstr ""
"{n}당신의 표정이 변하자 윌라스는 스스로 자제합니다.{/n} \"이런, 제가 횡설수설했군요! 어디선가 들은 소문들을 이곳에서 제가 "
"당신에게 모두 쏟아낸 것 같습니다.!\"{n}그 남자는 완전히 가식으로 웃더니 침을 꿀꺽 삼킵니다.{/n}\"사실 아무것도 아닙니다. "
"{mf|남작님|남작님|전하|전하}. 아무것도 아닌 허황된 소문들이죠. 누군가가 그곳에서 다른 사람을 제물로 바친다는 허황된 이야기가 "
"있었습니다..그리고 그곳의 유령같은 불빛들에 대한 것도, 분명 합리적인 설명이 있을 것이라 확신합니다...폐허 위로 번쩍이는 불빛을 본 "
"것도 역시 마찬가지죠...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_CandlemereFail/Cue_0001_Text
msgctxt "20404be3-5dc7-449c-9048-29044ef06e41"
msgid ""
"\"Remember that strange Gunderson fellow? The one who kept asking you to go "
"to {g|Candlemere}Candlemere{/g} Lake and get his not-exactly-his treasure? "
"Well, he got peeved with you and left! He said he's headed east — for more "
"treasure again, I'd guess! Here, he asked me to give you this farewell "
"{g|gunderson_farewell}message{/g}.\""
msgstr ""
"\"그 이상했던 건더슨이라는 친구가 기억나세요? {g|Candlemere}캔들미어{/g} 호수에 가서 그의 것이 정확히는 아닌 보물을 "
"가져다 달라고 부탁했던 사람 말이에요? 음, 그는 당신에게 삐져서 떠나갔어요! 그가 말하길 보다 많은 보물을 찾아 또다시 그는 동쪽으로 "
"간다고 했다고 해요! 여기, 그가 저에게 전해달라 부탁한 {g|gunderson_farewell}작별인사{/g}에요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_CandlemereFail/Item/GundersonFarewell_letter_String
msgctxt "cdeabefd-50ed-4da3-93c4-b48fd74d2eec"
msgid ""
"\"Your esteemed Grace!\n"
"It is with deep regret that I must inform you that I can no longer await "
"your decisive action in relation to restoring my right to the valuables "
"located on the island of Candlemere Lake. Please be informed that I shall be "
"leaving the borders of your barony and heading into the dominion of Maegar "
"Varn — a well-respected lord and a valiant warrior, quite worthy of his own "
"chronicle. As I'm sure I can expect to make a name for myself in the ranks "
"of Varn's army, I have decided to magnanimously renounce my claim on the "
"treasure to be found at Candlemere Lake. It is yours to deal with at your "
"sole discretion.\n"
"Warmest regards,\n"
"Willas Gunderson\""
msgstr ""
"\"존경하는 나리!\n"
"더 이상 캔들이머 호수의 섬에 위치한 보물들에 대한 제 권리를 복원시켜주실 단호한 행동을 더 이상 기다리지 못한다는 사실을 당신에게 "
"알려야 한다는 것에 매우 깊은 유감을 전합니다. 저는 당신의 남작령을 떠나 존경받는 영주이자 그 자신의 연대기에 어울릴 만한 용감한 "
"전사인 메이가르 반의 영지로 향하는 것을 알려드립니다. 반의 군대에 제 자신의 이름에 지위를 덧붙일 수 있을 것이라 기대하는 것을 "
"확신하기에, 저는 관대하게도 캔들미어 호수에서 찾을 수 있는 보물들에 대한 제 권리를 포기하기로 결심했습니다. 그것을 처리하는 것은 "
"오롯히 당신의 재량에 달려 있습니다.\n"
"따뜻한 안부를 전하며,\n"
"윌라스 건더슨\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktGunderson_CandlemereFail/Item/GundersonFarewell_letter_name_String
msgctxt "4d021de6-f4d4-4586-9c21-b754105dbbe5"
msgid "Willas Gunderson's Farewell Message"
msgstr "윌라스 건더슨의 작별인사"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Answer_0005_Text
msgctxt "2f175109-b4d8-4e84-818f-1d229d5c31e9"
msgid "\"Do you have any idea where he might be?\""
msgstr "\"그 애가 어디에 있을지 알고 계십니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Answer_0008_Text
msgctxt "c2f42078-3a93-4579-a4a8-5da8b6b4a500"
msgid ""
"\"The witch couldn't have taken your son. I killed her with my own hands.\""
msgstr "\"마녀가 당신의 아들을 납치한 것이 아닙니다. 그녀는 내 손에 죽었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Answer_0009_Text
msgctxt "aa505e01-cae3-4568-a1ac-ffc68890d640"
msgid "\"I paid a visit to the witch. Your son isn't there.\""
msgstr "\"마녀를 찾아가 보았습니다. 당신의 아들은 거기 없었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Answer_0010_Text
msgctxt "513612f6-d46f-442b-b78a-2f00adfa76b1"
msgid "\"I'll try to find him.\""
msgstr "\"그를 찾아보겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Answer_0015_Text
msgctxt "181d04f7-b6ab-4947-b502-f3d0439cab1b"
msgid "\"I don't have time for this.\""
msgstr "\"이 일을 할 시간이 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Answer_0020_Text
msgctxt "5b60e935-8457-4762-8737-0d97d8d1b830"
msgid "\"I couldn't save your son. I'm sorry.\""
msgstr "\"당신의 아들을 구할 수 없었습니다. 미안합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Answer_0028_Text
msgctxt "23a5b856-ef3c-495b-8adf-679f2a4f02b7"
msgid ""
"\"I found your son. He's alive, but the lizardfolk are holding him captive.\""
msgstr "\"당신의 아들을 찾았습니다. 그는 살아있습니다만, 도마뱀 인간들이 그를 포로로 잡아두고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Answer_0030_Text
msgctxt "56b75652-8d0d-4757-8414-a931cc4d7cbf"
msgid "\"I need to go.\""
msgstr "\"이만 가봐야겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Answer_0032_Text
msgctxt "90b2d420-b8eb-470f-9e27-2db00ad6226e"
msgid "\"Do people disappear frequently here?\""
msgstr "\"이곳에서 자주 사람들이 실종됩니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Answer_JennaTellsTruth_Text
msgctxt "e47a8664-844b-41f1-9f19-54c5c4f07575"
msgid "\"Calm down, Jenna. Tell me, what did you hide from me?\""
msgstr "\"진정하세요, 제나. 나에게 무엇을 숨겼는지 말해주시죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0001_Text
msgctxt "bf131388-0b69-4cd0-94a2-bd48ea6ac4e0"
msgid ""
"{n}A peasant woman, her face soaked with tears, approaches you quickly.{/n} "
"\"Oh, Your Grace... woe is me! I've met my darkest hour. You're my last "
"hope! By all the gods ever prayed to, don't leave me in need!\""
msgstr ""
"{n}한 농민 여성이 그녀의 얼굴을 눈물로 채운채 당신에게 달려왔습니다.{/n} \"오, 전하...슬퍼서 견딜 수 없습니다! 정말 혹독한 "
"일이 벌어졌습니다. 당신이 제 마지막 희망입니다! 모든 신께 기도드렸습니다, 저를 곤경에 빠뜨리지 마시라고!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0002_Text
msgctxt "8d88ac14-af20-4ae0-b79d-80b7f76671c1"
msgid ""
"{n}Jenna looks at you with eyes red from tears.{/n} \"Have you found my "
"little boy?\""
msgstr "{n}제나 눈물로 붉게 충혈된 눈으로 당신을 바라봅니다.{/n} \"제 소중한 아이를 찾으셨나요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0007_Text
msgctxt "e7d43e41-bb9b-472b-bea8-2bdb7e0bf22b"
msgid ""
"{n}Jenna looks around cautiously and whispers,{/n} \"There's this old hag in "
"the {g|Narlmarches}Narlmarches{/g}... a swamp witch! I won't say her name "
"out loud, don't you even ask! The mere thought of her chills the blood in my "
"veins! She has the evil eye, and she eats people! She even turns into a "
"black raven and soars in the sky. It's sure as day that she took my boy!\""
msgstr ""
"{n}제나는 조심스럽게 주변을 둘러보고는 속삭였습니다,{/n} \"{g|Narlmarches}날마치(Narlmarches){/g}에 늙은 "
"마귀할멈이 있습니다...늪지의 마녀지요! 이름조차 크게 말할 수 없어요. 묻지도 마세요! 조금이라도 떠올리기만 해도 몸서리가 "
"쳐진다니까요! 그 마녀는 악마같은 눈을 가지고 있고, 사람들을 잡아먹어요! 검은 큰까마귀로도 변신해서 하늘높이도 올라갈 수 있답니다. 그 "
"마귀가 내 아이를 데려간 것이 명백해요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0011_Text
msgctxt "8eff00b0-ba94-40cd-b81d-d6e544c5bb01"
msgid ""
"\"Oh my!\" {n}Jenna flings her hands up in surprise.{/n} \"Good riddance! "
"Thank you, Your Grace. She was a menace to us all! But if it wasn't her...\""
msgstr ""
"\"오 이런!\"{n}제나는 기쁨에 손을 번쩍 들어올렸습니다.{/n} \"잘 쫓아내셨습니다! 감사합니다, 전하. 그녀는 우리 모두에게 "
"위협이었어요! 그런데 그녀가 한게 아니였다면...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0012_Text
msgctxt "8f2d81c7-41f4-45b9-bc50-672e8093ec5f"
msgid "\"How can that be? And I thought... But... But if wasn't her, then...\""
msgstr "\"어떻게 그럴 수가? 그러면....그렇지만...그렇지만 그녀가 한 게 아니라면...그렇다면...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0013_Text
msgctxt "491ecf22-d7fb-4086-aa58-a440c7da32df"
msgid ""
"\"Then that means that... that...\" {n}The peasant woman's face turns pale, "
"and she covers her mouth with both hands.{/n}"
msgstr "\"그렇다면 그것은..그...\" {n}농민 여성의 얼굴이 창백해지더니, 그녀는 양손으로 입을 틀어막았습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0014_Text
msgctxt "73397704-60d2-42b8-ac6d-c5eadb1513de"
msgid ""
"\"My name is Jenna, Jenna Tannersen. Our village is a short way from here. "
"It's been two days since my boy, Tig, ran away — and I haven't seen him "
"since! We've searched and searched, but it's no use! If you don't find him, "
"no one else will!\""
msgstr ""
"\"저는 제나 태너슨이고, 근처의 마을에 살고 있습니다. 제 아들 티그가 벌써 이틀 전, 집에서 달려나간 뒤부터 아직까지 돌아오지 "
"않았습니다! 저희는 찾고 또 찾았지만, 아무 소용이 없었습니다! {mf|영주님|영주님|전하|전하}께서 그 애를 찾아주시지 못한다면, 그 "
"누구도 못찾을 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0018_Text
msgctxt "02108888-cc2a-4228-891d-f8dd09cdf054"
msgid ""
"\"My boy...\" {n}Jenna sobs.{/n} \"He was... He's such a little mischief-"
"maker! That day... that day he was especially loud, kept running around the "
"house... He flipped a tub of dough... And, well, I... Oh gods, what have I "
"done!\""
msgstr ""
"\"제 아들...\"{n}제나는 흐느낍니다.{/n} \"그 애는...그애는 아주 장난꾸러기였지요! 그 날... 그 애가 특별히 시끄럽게 "
"굴고 온 집안을 뛰어다니던 그 날... 그 애가 반죽 그릇을 엎어버렸지요.... 그리고, 저는... 오 신이시여, 제가 무슨 짓을 한 "
"건가요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0022_Text
msgctxt "fce68aca-d12a-45d8-ba57-2cdfcdc558ab"
msgid ""
"{n}For a long time, Jenna stands still, staring in front of her. Then, "
"without a single word, she slowly walks away.{/n}"
msgstr ""
"{n}긴 시간동안, 제나는 멀뚱히 서서 그저 앞을 바라보고 있었습니다. 그리고는, 한 마디 말 없이, 그녀는 느리게 걸어나갔습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0023_Text
msgctxt "0f87db00-74e5-4ae4-adf3-08bbdc94e159"
msgid ""
"\"I lost my temper and I shouted at him. I told him he can go drown himself "
"in {g|Candlemere}Candlemere{/g} Lake! His own mother, wishing he was dead! "
"But how could I have known it would all come true?\""
msgstr ""
"\"저는 성질을 참지 못하고 소리쳤어요. {g|Candlemere}캔들미어{/g} 호숫가에 빠져 죽어버렸으면 좋겠다고요! 자식이 죽기를 "
"바라는 엄마라니! 하지만 제가 어떻게 이게 현실이 되리란 걸 알 수 있었겠어요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0024_Text
msgctxt "fb70a104-e0ef-412e-a5a6-1eff83c1784f"
msgid ""
"\"If you find him, I beg you — tell him I love him more than life itself! "
"Never, never again shall I say anything mean to him, just bring him back "
"home safe and sound!\""
msgstr ""
"\"그 애를 찾으신다면, 제발 부탁이니 제가 그 아이를 제 목숨보다 더 사랑한다고 꼭 말해주세요! 온전하게만 집으로 돌려보내주신다면, "
"다시는 절대 그 아이에게 못된 말을 하지 않을텐데요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0025_Text
msgctxt "92731ab9-2615-4493-b5c4-40ac1a9d3d40"
msgid ""
"{n}As soon as the peasant woman sees you, she falls to her knees, trying to "
"kiss your hand.{/n} \"Oh! Your Grace! Our deliverer! You saved him, you "
"rescued my little one! What would we ever do without you! Every day until "
"the day I die, I shall pray to all the gods for your health!\""
msgstr ""
"{n}농부 여성은 당신을 보자마자 무릎 꿇고 당신 손에 입을 맞추려고 합니다.{/n} \"아! 영주님! 저희의 구원자! 영주님께서 "
"구해주셨어요, 우리 아이를요! 오로지 영주님 덕분이에요! 죽는 날까지 매일 영주님의 건강을 위해 모든 신들에게 기도하겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0026_Text
msgctxt "f52ad1a1-8de3-4425-8c42-d065718fb7e8"
msgid ""
"{n}Jenna looks at you with eyes red from tears.{/n} \"Have you changed your "
"mind? Will you look for my boy?\""
msgstr "{n}제나가 울다 못해 붉게 충혈된 눈으로 당신을 바라봅니다.{/n} \"마음을 바꾸셨나요? 제 아이를 찾아주실건가요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0027_Text
msgctxt "fa734138-78ed-4cb7-a358-c4187514fb2a"
msgid ""
"\"Of course, of course, you're so busy... But if you find the time... I "
"still have a bit of money left to pay for a room in the tavern... Please, I "
"beg you, don't leave us in need!\""
msgstr ""
"\"당연히, 물론 당신께선 바쁘시지요... 그러나 시간을 내 주신다면... 저에게 이 주점에 방을 잡고 남은 돈이 있습니다... 제발, "
"부탁드립니다, 저희를 외면하지 말아주세요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0029_Text
msgctxt "a954262d-00a4-466b-95dc-fb5407baf3dd"
msgid ""
"\"Goodness gracious! Lizardfolk! But they... they eat people! Oh, in "
"{g|Erastil}Erastil{/g}'s name, I beg you, save him before those lizards... "
"before they...\" {n}The peasant woman cries uncontrollably.{/n}"
msgstr ""
"\"아아 세상에! 도마뱀인간이라니! 그들은...그들은 사람을 잡아먹잖아요! 오, {g|Erastil}에라스틸{/g}의 이름으로 "
"간청드립니다, 제발 그 애를 구해주세요. 그 전에... 도마뱀들이... 그러기 전에...\"{n}농민 여성이 감정을 주체하지 못하고 "
"울부짖습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0031_Text
msgctxt "1335a39e-8d2f-4f5b-93b6-2936f0a9905d"
msgid "\"May {g|Erastil}Erastil{/g} help you...\" {n}The woman sobs.{/n}"
msgstr "\" {g|Erastil}에라스틸{/g}께서 당신을 굽어살피시기를...\"{n}여성이 흐느낍니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0033_Text
msgctxt "fc81d80c-dce2-4b16-af2d-9c635a619a37"
msgid ""
"\"They sure do! There are so many hazards around, it's hard to name them "
"all! Wild beasts in the forest, and monsters, and some troblins, and "
"bandits, and whatever... Even adults have hard time surviving here, and for "
"a little kid... Oh!\""
msgstr ""
"\"그렇겠죠! 위험 요소가 너무 많아서 이름을 나열하기도 어려울 지경이라구요. 숲 속을 돌아다니는 야생동물은 물론이고, 괴물들과 "
"트로블린, 도적떼까지... 그것 말고도 조심해야 할 게 엄청 많아요. 다 큰 어른도 살아남기 힘들 텐데, 하물며 어린애는... 아아!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktMissingChildMother_Lizardmen/Cue_0034_Text
msgctxt "a1cbef96-ee0a-4bae-9843-b46bed1849b7"
msgid ""
"\"Oh, Your Grace... Thank you, thank you so much! I'll be praying to "
"{g|Erastil}Erastil{/g} to grant you long life! If there's any news, I'll be "
"nearby, in the tavern... May the good gods help you!\" {n}The sobbing woman "
"leaves.{/n}"
msgstr ""
"\"오, 전하... 감사합니다, 너무 감사합니다! {g|Erastil}에라스틸{/g}께 당신의 장수를 기도할게요! 혹시 무슨 소식이라도 "
"있으면, 제가 바로 근처, 이 주점에 있을테니까요... 모든 선한 신들께서 당신을 도우시길!\"{n}흐느끼던 여인은 떠나갔습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-1TrollTroubleStart/Answer_78319_AlignmentShift.Description
msgctxt "cf2fcce6-f770-4492-9bc4-10f0e2ee1b1a"
msgid "Hurried to investigate the report of strange troll activity."
msgstr "트롤들의 이상한 동향에 대한 보고를 조사하기 위해 서둘렀습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-1TrollTroubleStart/Answer_78319_Text
msgctxt "a6464154-e05b-4700-bb8c-39b29fc385c8"
msgid ""
"\"A baron{mf|'s|ess'} duty is to {mf|his|her} people. I'll head south and "
"look into the situation.\""
msgstr "\"백성을 지키는 것이 남작의 사명이지. 남쪽으로 가서 이 사안을 조사하도록 하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-1TrollTroubleStart/Answer_88261_AlignmentShift.Description
msgctxt "a9fb8f2b-4e8b-4ac2-9e9f-b810b5838678"
msgid "Ignored the report of strange troll activity."
msgstr "트롤들의 이상한 동향에 대한 보고를 무시했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-1TrollTroubleStart/Answer_88261_Text
msgctxt "35e80fff-cb64-4013-8dae-e93fe25d1689"
msgid ""
"\"You believe trudging through swamps and chasing rumors to be part of a "
"baron{mf||ess}'s duties?\""
msgstr "\"늪지대를 뚫고 소문따위나 조사하는 것이 남작이 할일이라고 생각하나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-1TrollTroubleStart/Answer_96058_Text
msgctxt "669910b4-5210-4a81-9062-9584934b8a44"
msgid "\"I may have time for this later.\""
msgstr "\"다음에 처리하도록 하지\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-1TrollTroubleStart/Cue_02047_Text
#. Speaker : Capital_Kesten
msgctxt "5727ac07-f041-40d1-b798-d0ef6c4d75ca"
msgid ""
"\"Thank you, Your Grace.\" {n}Kesten sighs with relief.{/n} \"When you "
"decide to go, please remember that trolls can only be killed with fire or "
"acid.\""
msgstr ""
"\"감사합니다, 영주님.\" {n}캐스턴은 안도의 한숨을 내쉰다.{/n} \"가기로 결정하셨다면, 트롤은 산과 불로만 죽일 수 있다는 "
"것을 명심해주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-1TrollTroubleStart/Cue_26603_Text
#. Speaker : Capital_Kesten
msgctxt "aeb60a29-e70f-488c-af8b-500614299d89"
msgid ""
"\"Forgive me, Your Grace. However, if this problem isn't handled now, by "
"next month there may be no one left to save.\" {n}Kesten shifts uneasily.{/n}"
" \"So, if you do decide to go, please remember that trolls can only be "
"killed with fire or acid.\""
msgstr ""
"\"송구하옵니다만 영주님, 만일 이 문제를 지금 해결하지 않는다면, 그곳은 다음달이 지나가기도 전에 폐허가 될 것입니다. {n}캐스턴의 "
"안색이 거북하게 바뀐다.{/n} \"그러니, 출발하기로 결정하셨다면, 트롤은 산성과 불로만 죽일 수 있다는 것을 명심해 주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-1TrollTroubleStart/Cue_65308_Text
#. Speaker : Capital_Kesten
msgctxt "26fab9ce-31ae-4aaf-bb73-a9a8d41e49ab"
msgid ""
"\"Your Grace, I...\" {n}Kesten has a troubled look on his face.{/n} \"I fear "
"there's another matter that requires your attention. There have been "
"reports, many of them, from settlements across the "
"{g|Narlmarches}Narlmarches{/g}. There are trolls in the forest, seemingly "
"hordes of them.\""
msgstr ""
"\"영주님, 저...\" {n}케스턴은 심각한 표정이 역력합니다.{/n} \"신경 쓰셔야 할 또다른 문제가 생겼습니다. 날마치 주변 "
"정착민들의 보고에 의하면 근처 숲에 트롤들이 무리짓고 있는 것이 발견됐다고 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-1TrollTroubleStart/Cue_88886_Text
#. Speaker : Capital_Kesten
msgctxt "88755c4d-9ff9-4ff5-8dbe-0191b6dcda2b"
msgid ""
"\"The common folk will hardly heed any simple exhortation — someone will "
"need to go to the {g|Narlmarches}Narlmarches{/g} to investigate the matter. "
"I was considering the matter when it hit me: what if you were to take on "
"this investigation yourself, Your Grace?\""
msgstr ""
"\"정착민들은 간단한 경고만으로는 귀기울여 듣지 않을 것입니다. 누군가 {g|Narlmarches}날마치{/g}로 가서 이 사안에 대해 "
"조사해봐야 합니다. 상황을 고려해 보았을때 이 조사를 영주님께서 직접하시면 어떻겠습니까 \""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-1TrollTroubleStart/Cue_90572_Text
#. Speaker : Capital_Kesten
msgctxt "c3790ce4-2547-429b-b88b-c30c85fdbee4"
msgid ""
"\"Rumors claim they're more than the typical savage beasts. They almost seem "
"to show reason and tactics — they form groups, attack all at once, plunder "
"the villages, and carry away the peasants. Even stranger, kobolds have been "
"spotted among their ranks, when usually they would be attacked on sight.\" "
"{n}Kesten falls silent for a moment.{/n} \"I'm not certain any of this is "
"reliable — fear builds mountains of molehills. Some of the rumors even say "
"these trolls carried torches and burned down houses, seemingly unafraid of "
"open flames. It's entirely possible the rest of the reports could be "
"exaggerated as well.\""
msgstr ""
"\"소문으로는 그들은 전형적인 야만적인 괴수 이상이라고 합니다. 그들은 동기와 전술적인 면모를 지니고 있는 것으로 보입니다. - 무리지어 "
"다니며, 동시에 공격하고, 마을을 약탈한 후 농민들을 납치해 갑니다. 보통 눈에 띄는대로 공격해 오는데 그들 무리 안에는 낯선 사람과 "
"코볼트들도 발견 되었다고 합니다.\" {n}케스턴은 잠시 침묵합니다.{/n} \"소문들은 정착민들의 공포로 인해 부풀려졌을 수도 있으므로 "
"믿을 수 있는 정보인지는 확실치 않습니다. 트롤들이 불을 두려워 하지 않고 횃불을 들고다니며 마을을 태우고 있다는 소문조차 있으니까요. "
"이밖에 다른 보고들도 전부 부풀려지고 과장된 정보일 가능성도 있습니다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-1TrollTroubleStart/Cue_96059_Text
#. Speaker : Capital_Kesten
msgctxt "e9885eac-b39c-4333-85a9-111b6c864c21"
msgid ""
"\"If you would be so kind, Your Grace.\" {n}Kesten rubs his neck.{/n} \"Just "
"be sure to provision yourself properly before you go. Remember, trolls can "
"only be killed with fire or acid.\""
msgstr ""
"\"사려깊으십니다. 영주님\" {n}케스턴은 목덜미를 문지릅니다.{/n} \"조사를 진행 하시기 전에 적합한 준비가 되었는지 꼭 "
"확인하셔야 합니다. 기억하십시오, 트롤은 오직 불과 산으로만 죽일 수 있습니다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-2TrollTroubleRampage/Cue_96362_Text
#. Speaker : Capital_Kesten
msgctxt "81b86d63-11d6-43c1-a6ee-8aab8fb90abd"
msgid ""
"\"Your Grace!\" {n}Kesten's face looks worried and fearful.{/n} \"Your "
"Grace, ill news from the {g|Narlmarches}Narlmarches{/g} — again!\""
msgstr ""
"\"영주님!\" {n}케스턴의 얼굴은 걱정과 두려움이 가득해 보입니다.{/n} \"영주님, {g|Narlmarches}날마치{/g}"
"로부터의 소식이 있습니다 - 또말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-2TrollTroubleRampage/Cue_96363_Text
#. Speaker : Capital_Kesten
msgctxt "7f94bb2d-608b-47b5-bb46-dc03f48c90f0"
msgid ""
"\"There were already many trolls there, but now people are afraid to leave "
"their houses! The wilds are said to be swarming with them. The hunters were "
"the first ones to notice, then came the merchants delivering packages and "
"food to the outskirts of the barony. Now there are more and more reports of "
"trolls attacking villages\"."
msgstr ""
"\"그 지역엔 이미 많은 트롤들이 있었다지만 이제는 시민들이 집을 나서는것조차 두려워하고 있다고 합니다! 트롤들이 야생에 우글우글하다고 "
"합니다. 사냥꾼들이 처음 알려왔고 다음으로 영지 외곽으로 물품과 음식을 배달하러온 상인들로부터도 같은 소식을 접하였습니다. 이제 트롤들이 "
"마을을 공격한다는 보고가 점점 늘어나고 있습니다\"."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-2TrollTroubleRampage/Cue_96364_Text
#. Speaker : Capital_Kesten
msgctxt "4da1e86f-57be-460d-9bb7-60f6d9943b73"
msgid ""
"\"At first, I took the reports for gossip. Thought it was just the fear "
"talking. But a local group of merchants recently reported that most of the "
"trolls seem to be lurking around the house of one Bartholomew Delgado — an "
"odd mage living out in the wilds all by himself. They're saying there are so "
"many trolls out there, nobody can reach Bartholomew for fear of the beasts!\""
msgstr ""
"\"처음엔, 소문으로 보고를 들었습니다. 그냥 두려움 때문에 과장한 말인줄 알았습니다. 하지만 최근, 현지 상인들이 보고하길 대부분의 "
"트롤들이 바솔로뮤 델가도라는 혼자 야생에서 살고있는 괴짜 마법사의 집 주변으로 숨어드는 것 같다고 합니다. 이를 목격한 상인들은 밖에는 "
"트롤들이 너무 많아서 바솔로뮤에게 따로 연락할 수 없다고 합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-2TrollTroubleRampage/Cue_96365_Text
#. Speaker : Capital_Kesten
msgctxt "0f0c60d0-dca0-4bc1-9d70-2443b0c65910"
msgid ""
"{n}Kesten's face goes dark.{/n} \"Those trolls are up to something, and this "
"strange Bartholomew fellow is clearly tangled up in it somehow. If the "
"wizard's gotten some idea in his head to conspire with the trolls, we should "
"make the first move and hit them with a preemptive strike. However, if the "
"trolls are coming FOR him rather than TO him...\" {n}Kesten sighs.{/n} \"It "
"would be an enormous help if you could pay a visit to Bartholomew and figure "
"out what's going on. I recommend haste — if nothing is done soon, there may "
"be a grisly fate in store for your subjects!\""
msgstr ""
"{n}케스턴의 얼굴이 어두워집니다.{/n} \"저 트롤들이 뭔가 일을 꾸미고 있는것 같은데, 이 괴상한 바솔로뮤란 작자가 어떻게든 얽혀 "
"있는것으로 보입니다. 만약 마법사가 트롤들과 공모할 생각을 가지고 있다면, 우리는 먼저 선제공격을 해야 합니다. 하지만 만약 트롤들이 "
"그를 '위해' 오는 것이 아니라 그를 '잡으러' 오는 것이라면..\" {n}케스턴은 한숨을 내쉽니다.{/n} \"바솔로뮤를 방문하여 무슨 "
"일이 일어나고 있는지 알아낸다면 큰 도움이 될 것입니다. 아무래도 서두르셔야 할 듯합니다. 빠른 시일안에 조치가 없다면 시민들에게 끔찍한 "
"운명이 닥쳐올지도 모릅니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-2TrollTroubleRampage/Cue_96366_Text
#. Speaker : Capital_Kesten
msgctxt "fa2cb339-41ec-494c-b557-5415e4731e29"
msgid ""
"\"Local merchants reported lots of trolls lurking around the house where "
"Bartholomew Delgado lived — you know, that suspicious wizard you... Well, no "
"need to bring that back up. Anyway, I sent some reliable people there. They "
"searched his house and found a torture chamber in the basement, with a troll "
"tied to a rack. The poor beast died of hunger. Seems that's how the wizard "
"amused himself...\" {n}Kesten shakes his head grimly.{/n}"
msgstr ""
"\"지역 상인들이, 많은 트롤들이 바솔로뮤 델가도가 살던 집 주변에 숨어 있다고 알려왔습니다 — 아시겠지만, 이상한 마법사였... 아, "
"아닙니다. 지난 일을 다시 끌어올 필요는 없겠죠. 아무튼, 믿을만한 부하들 몇 명을 보내봤습니다. 그들이 바솔로뮤의 집을 수색했고, "
"지하에 트롤을 묶어둔 형틀이 있는 고문대를 발견했습니다. 그 불쌍한 야수는 굶어 죽었습니다. 그 마법사가 얼마나 즐거워했을지...\" "
"{n}케스턴은 우울한듯 그의 머리를 가로젓습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-2TrollTroubleRampage/Cue_96367_Text
#. Speaker : Capital_Kesten
msgctxt "80ded5c5-d2ee-4cfd-8cd6-fc048f6b1380"
msgid ""
"\"We're used to trolls lurking in deep marshes and forests. There were a "
"surprising amount of them around Bartholomew's house, and now we know why... "
"But whether the lack of response has made them bold or they're just avenging "
"their kin's torture, they're now attacking in broad daylight. They pillage, "
"plunder, and drag away cattle and people alike. Survivors say they seem to "
"be taking all the loot in the same direction, somewhere around here — that "
"must be where their lair is!\" {n}Kesten makes a mark on your map.{/n}"
msgstr ""
"\"트롤들이 숲와 늪지대 깊숙히 숨어있는 건 평범한 일입니다. 바솔로뮤의 집 근처에서 발견된 놈들에게서 특별한 점이라면, 이미 그 이유가 "
"알려졌습니다만... 아무튼 놈들의 둔감함이 그들을 용감하게 만들었는지 아니면 동족의 고문에 대해 분개했는지 몰라도, 밝은 대낮에 공격을 "
"하고 있습니다. 부수고, 약탈하고, 가축과 인간을 똑같이 끌고 가고 있습니다. 생존자들은 놈들이 모든 전리품을 같은 방향으로 데려가고 "
"있다고 증언했습니다, 이쪽 근방입니다 — 근처에 반드시 놈들의 소굴이 있을 겁니다\" {n}케스턴이 당신의 지도에 표시를 했습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_05515_Text
msgctxt "5c9877f6-4c15-4c2f-9f7f-8859683bbaba"
msgid "\"Why did you bring this matter to me, Jhod?\""
msgstr "\"조드. 왜 이 문제를 나에게 가져온거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_17230_AlignmentShift.Description
msgctxt "92fabe5e-63af-441f-b846-7f6dde65ccc2"
msgid "Tried to intimidate the doomsayer."
msgstr "종말의 예언자를 위협하려 했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_17230_Text
msgctxt "f8e20f6b-0d5c-43ed-8c6d-4d86f7e96536"
msgid "\"Stop talking nonsense, you old fool, or I'll cut out your tongue!\""
msgstr "\"헛소리는 그만해. 이 늙은이, 안 그러면 혀를 잘라내주겠어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_18536_AlignmentShift.Description
msgctxt "b2e8a139-35af-4cc6-924b-b2b5422bb745"
msgid "Imprisoned the doomsayer."
msgstr "종말의 예언자를 수감시켰다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_18536_Text
msgctxt "edd4a7d2-cf3d-491f-b92d-f91533daf7de"
msgid ""
"\"Give him thirty lashes for his blasphemy, then put him in chains. I won't "
"have him running free and causing more trouble.\""
msgstr ""
"\"이 자에게 신성모독의 죄로 30번의 채찍질을 내려라. 그리고 나서 족쇄를 걸어라. 이 자가 멋대로 돌아다녀 문제를 일으키게 하고 싶지 "
"않다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_24487_AlignmentShift.Description
msgctxt "c0a65b72-fd5a-44d0-a40f-56783801147c"
msgid "Exiled the doomsayer."
msgstr "종말의 예언자를 추방했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_24487_Text
msgctxt "9aa45a5a-1218-41b4-8a27-773bb9d5acfe"
msgid ""
"\"Drive the heretic from the barony — and use the whip to encourage him to "
"make haste.\""
msgstr "\"우리 영지에서 이 사교도를 쫓아내라. 빨리 나가도록 채찍질도 해주어라\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_24992_Text
msgctxt "0a85a7c1-45cb-4c60-a5fa-33179c39d750"
msgid "\"I would know more about your prophecy, Remus.\""
msgstr "\"레무스, 너의 예언에 대해 더 알고 싶군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_26909_AlignmentShift.Description
msgctxt "120df392-2ce2-4fd4-a203-3638482dd4cc"
msgid "Executed the doomsayer."
msgstr "종말의 예언자를 처형했다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_26909_Text
msgctxt "1eb61d3c-a0d1-42f1-8e30-7960b43dd3a9"
msgid ""
"\"Remus, by insulting the gods and defying your ruler, you have committed "
"treason. The sentence is death. Take him away!\""
msgstr "\"레무스, 너는 신을 모욕하고 나에게 거역했으니 반역죄를 저질렀다. 따라서 사형을 내리겠다. 끌고 가라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_33447_Text
msgctxt "32c6869d-117d-4ec3-9ea3-da130ea751c3"
msgid "\"Let's talk about your prophecy, Remus.\""
msgstr "\"레무스, 네 예언에 대해 말해보자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_38302_Text
msgctxt "472a0cdb-c47c-43e8-8a1b-1e36a79e4bc2"
msgid "\"Enough about your visions.\""
msgstr "\"네 환영 얘기는 이쯤하자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_40421_Text
msgctxt "4c8f262d-0af7-4669-ba2e-811abb4f5d6c"
msgid ""
"\"What is this 'other world' you speak of? And what will happen to this city?"
"\""
msgstr "\"당신이 말한 '다른 세계'라는 건 뭐지? 그리고 이 도시에 무슨 일이 일어난다는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_48183_AlignmentShift.Description
msgctxt "779a3989-99b4-4041-9b31-dfede518666d"
msgid "Tried to calm the doomsayer down."
msgstr "종말의 예언자를 진정시키려 했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_48183_Text
msgctxt "28db5e80-42d9-48f2-80f8-a96df57291a6"
msgid ""
"\"So an angry goddess will lay our city to waste because we drained her "
"swamp? She must be a petty Goddess indeed, if she takes part in the affairs "
"of mortals even on such insignificant occasions. Perhaps you simply had a "
"dream, and it merely seemed real.\""
msgstr ""
"\"그러니까 성난 여신께서는 우리가 그분 늪을 매마르게 했기 때문에 우리 도시를 황폐화 시키겠다는 건가? 그런 하찮은 일에도 필멸자들의 "
"일에 참여한다면, 그녀도 정말 하찮은 여신임에 틀림없군. 아마 당신은 정말 현실처럼 느껴지는 그냥 꿈을 꾼걸지도 몰라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_54140_Text
msgctxt "0a7ec7ad-3bd0-4623-a480-16ef236d72cf"
msgid "\"Tell me about this goddess — I would know more about her.\""
msgstr "\"그 여신에 대해 말해봐. 더 알고 싶군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_78311_Text
msgctxt "e3e567d7-12f4-460a-90a1-f48f9596396e"
msgid "\"How do you know about that?\""
msgstr "\"그걸 어떻게 알지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_88771_AlignmentShift.Description
msgctxt "5cab23fb-ca41-480b-b3bd-10d818327e10"
msgid "Let the doomsayer go free."
msgstr "종말의 예언자를 놓아주었다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_88771_Text
msgctxt "7193125f-d2e7-4aea-8cf1-9117b1115b2b"
msgid "\"We'll let him go, Jhod. One may speak freely in our streets.\""
msgstr "\"보내주자, 조드. 우리 거리에서는 누구나 자유롭게 말할 수 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_97895_Text
msgctxt "589fe774-7a39-4e65-8b14-83a364e2ed4b"
msgid "\"We've already met, just outside of Oleg's Trading Post. Remember?\""
msgstr "\"우린 예전에 올렉의 교역소 앞에서 만난 적이 있어. 기억하고 있나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Answer_97898_Text
msgctxt "5cc5f70b-8684-4b9a-a5f3-11a7d28c00de"
msgid ""
"\"I know you, old man. I met you near Oleg's Trading Post. And killed you.\""
msgstr "\"나는 널 알아, 늙은이. 올렉의 교역소 근처에서 만나고 내가 죽여버렸잖아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_05493_Text
#. Speaker : Capital_Doomsayer
msgctxt "4d6d3677-ef8d-436c-97d2-ff7bf614851d"
msgid ""
"\"…and another world shall swallow the ugly city and its careless dwellers. "
"And only the rain shall weep for the emptiness left in their place.\""
msgstr ""
"\"… 그리하여 다른 세계가 이 추악한 도시와 이 경솔한 정착민들을 집어삼키리라. 그리고 오직 빗소리만이 이 땅에 남겨진 공허함을 위해 "
"울게 될지니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_20628_Text
#. Speaker : Capital_Doomsayer
msgctxt "5c2d7e30-11e7-49c9-b9a6-674687d686fb"
msgid ""
"\"But… but…\" {n}Remus' gaze becomes clear for a moment. His shoulders slump "
"and he looks even older now, more tired.{/n} \"Maybe you are right. I… I "
"need to lie down.\""
msgstr ""
"\"하지만… 하지만…\" {n}레무스의 초점이 한순간 정상으로 돌아왔다. 어깨를 움츠리는 그의 모습은 심신에 지치고 늙어 보였다.{/n} "
"\"어쩌면 당신이 맞을지도. 나... 난 좀 누워야 겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_22599_Text
#. Speaker : Capital_Jhod
msgctxt "cc2236cb-5017-4ae1-9552-c9d54558bec9"
msgid "\"Your Grace, you have to deal with this madman!\""
msgstr "\"{mf|영주님|영주님|전하|전하}, 이 미치광이를 어떻게든 해야합니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_25730_Text
#. Speaker : Capital_Doomsayer
msgctxt "4941f6f6-72fb-48c7-8292-38bcc8d98a18"
msgid "\"You don't understand! You are blind! But I'll make you see!\""
msgstr "\"이해를 못하는군! 눈이 멀었어! 허나 내가 눈을 뜨게 해주지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_35041_Text
#. Speaker : Capital_Doomsayer
msgctxt "0955c7b0-2755-4045-a5a7-bbcf412ae17f"
msgid ""
"\"Her fury is like a river after a storm! Her voice, thunder in a summer "
"sky, Her touch, as cold and sharp as a sliver of ice. She is beautiful as a "
"dream...\" {n}Remus stutters, then blushes.{/n} \"It's been forty years "
"since I last longed for a woman, but Her...\""
msgstr ""
"\"그녀의 분노는 폭풍우 속 강물과도 같아! 그녀의 목소리는 여름 하늘의 천둥과도 같고, 그녀의 손길은 얼음 조각처럼 차갑고 날카롭다. "
"그녀는 꿈처럼 아름다워..\" {n}레무스는 말을 더듬더니 볼을 붉게 물들였다.{/n} \"여자를 안은지 40년이나 지났지만 그녀는..."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_38133_Text
#. Speaker : Capital_Doomsayer
msgctxt "b833454a-799a-427a-bc52-c8ac9d2e57b3"
msgid ""
"\"The Goddess showed it to me in my visions! She whispered about a beautiful "
"new world, told me She would heal nature's wounds. But I don't want it!\" {n}"
"He shakes his fist, threatening someone invisible.{/n} \"She must be "
"stopped! Sacrifices, we must offer up sacrifices. Goats, or cows, or "
"horses... that will be enough. It must be enough!\""
msgstr ""
"\"여신이 환영을 보여주었다! 자연에 난 상처를 치유하고, 아름다운 새 세상을 가져오겠다고 말했지. 난 그런 세상은 원치 않아!\" {n}"
" 그는 보이지 않는 누군가를 위협하듯 주먹을 휘두릅니다.{/n} \"여신을 막아야 해! 제물, 제물을 바치자. 말이나 소, 염소를... "
"그 정도면 충분할 거야. 분명!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_45717_Text
#. Speaker : Capital_Jhod
msgctxt "3b2476ec-3b1f-4167-8626-30262f06faa6"
msgid ""
"\"You are kind, Your Grace… perhaps too kind.\" {n}Jhod bows.{/n} \"However, "
"your word is law. I shall escort Remus from the castle grounds.\""
msgstr ""
"\"영주님, 너그러우시군요... 너무 과하게 너그러우십니다.\" {n}조드가 머리를 숙인다.{/n} \"하지만, 영주님의 말이 곧 "
"법이죠. 레무스를 보내주겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_53214_Text
#. Speaker : Capital_Doomsayer
msgctxt "52f3b612-0111-4e0e-8a91-d671c005713f"
msgid ""
"{n}The old man before you is clad in tattered rags. His gray hair and beard "
"are filthy and matted. Judging by the smell, he has not bathed in some time, "
"perhaps years, and you have to fight the urge to cover your nose. Oblivious, "
"the old man picks at his beard in silence, as if trying to catch lice. "
"You're not certain he even knows where he is.{/n}"
msgstr ""
"{n}당신 앞에 서 있는 노인은 해진 넝마조각을 걸치고 있습니다. 그 자의 회색 머리와 수염은 더럽고 엉켜 있었으며, 냄새로 미루어보아 "
"몇년은 안 씻은 것 같습니다. 황급히 코를 막으려는 충동을 억제하는 것이 겨우 할 수 있는 일입니다. 벼룩을 잡으려는 듯이, 노인은 "
"말없이 수염을 콕콕 찝어대고 있습니다. 이 노인은 지금 자신이 어디에 와 있는지도 모르는 것 같습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_56806_Text
#. Speaker : Capital_Jhod
msgctxt "42366d6f-71d0-4ccf-ac26-517131973ab9"
msgid ""
"\"It's up to you to decide this homegrown {g|Aroden}Aroden's{/g} fate, "
"{mf|Baron|Baroness}. I await your command.\""
msgstr "\"이 자칭 {g|Aroden}아로덴{/g}의 운명은 영주님께 달렸습니다. 명을 내려주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_66094_Text
#. Speaker : Capital_Jhod
msgctxt "2b350013-4d92-4a1a-b844-81e92b395492"
msgid ""
"\"It's a harsh penalty, Your Grace… but a just one. Anyone who preaches fear "
"and causes discord must face the consequences.\" {n}Jhod bows, signaling the "
"end of the conversation.{/n}"
msgstr ""
"\"처음 저지른 행위 치고는 가혹한 형벌이시군요. {mf|영주님|영주님|전하|전하}. 하지만 불화를 조장하고 공포심을 심어주는 자에게는 "
"마땅한 벌을 주어야 하지요.\" {n}얘기는 끝났다는 듯이 조드는 머리를 숙입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_72819_Text
#. Speaker : Capital_Jhod
msgctxt "fba0b517-2dc5-476b-b192-2c4c31f00d23"
msgid "\"{g|Erastil}Erastil{/g} have mercy, will you be silent, you fool?!\""
msgstr "\"{g|Erastil}에라스틸{/g}이시여, 자비를 베풀어 주옵소서. 입을 좀 다물거라, 이 정신나간 자가?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_73666_Text
#. Speaker : Capital_Doomsayer
msgctxt "b375898d-02c0-4456-aed1-b6e79731d53d"
msgid ""
"\"A different world, fierce and wild. Where mountains impale the sky, where "
"rivers change direction, where the very trees talk to the stars.\" {n}Remus "
"swallows and stares ahead, as though lost.{/n} \"The wild world will consume "
"this city, shape it in its own image. It will be the end of all.\""
msgstr ""
"\"산이 하늘을 찌르고 강물이 거꾸로 올라가고 나무들이 별들에게 속삭이는, 야생의 흉포함이 들끓는 다른 세계지..\" {n}레무스는 숨을 "
"삼키고는 멍하니 앞을 바라봅니다.{/n} \"야생의 세계가 이 도시를 집어삼키고 본래 모습으로 되돌려 줄 것이다. 모든 것이 끝나게 될 "
"꺼야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_74190_Text
#. Speaker : Capital_Jhod
msgctxt "382f06fc-9525-4a2e-be84-3b596f978010"
msgid ""
"\"Who else can I turn to, Your Grace? This fool's words were frightening the "
"people, but alas — the crowds tend to love false prophets.\" {n}Jhod "
"sighs.{/n} \"In a sense, I saved him by bringing him here before things got "
"out of hand — just a while longer, and your subjects would have beaten him "
"up!\""
msgstr ""
"\"제가 누구를 의지할 수 있겠습니까? {mf|영주님|영주님|전하|전하}. 이 정신나간 노인의 말은 사람들을 겁먹게 하고있지만, 군중들은 "
"이런 거짓 예언에 쉽게 빠져들기도 합니다.\" {n}조드는 한숨을 내쉰다.{/n} \"한편으로는, 일이 걷잡을 수 없게 되기 전에 제가 "
"이 자를 이곳에 데려와서 구한 셈이기도 합니다. 조금만 더 냅두었다면 {mf|영주님|영주님|전하|전하}의 부하들이 죽도록 때렸을 것입니다!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_81587_Text
#. Speaker : Capital_Jhod
msgctxt "c0068532-9e92-4cf1-adde-9c9008a943b2"
msgid ""
"{n}Jhod straightens, his face flushing.{/n} \"As if that wasn't enough, this "
"— {g|Erastil}Erastil{/g} forgive my words — 'prophet' blasphemed against the "
"deities, proclaiming we must bow to some false god!\""
msgstr ""
"{n}조드는 얼굴을 붉히며 자세를 바로 합니다.{/n} \"그 뿐만 아니라,.. {g|Erastil}에라스틸{/g}이시여, 제가 입에 "
"담을 이 단어를 용서하옵소서.. 이 '선지자'라는 자는 신들을 모독하며 어떤 거짓 신 앞에 무릎 꿇어야한다고 외치고 있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_85997_Text
#. Speaker : Capital_Doomsayer
msgctxt "ce60f822-8451-40de-8c5b-0a8c47abafe1"
msgid ""
"\"I'm the only sane person in this city — this hideous, ugly city. Its stone "
"buildings claw into the soil, and thinks themselves safe. But the sky shall "
"open, the earth shall tremble, and this city shall crumble beneath its pride…"
"\""
msgstr ""
"\"나는 이 흉측하고 추악한 도시에서 유일하게 제정신인 사람이다. 땅에 상처를 내 돌벽을 쌓고 자신들이 안전하다고 생각하지. 하지만 "
"하늘은 열리고 땅은 요동치며 이 도시는 그 오만함 아래 무너질 것이야..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_86906_Text
#. Speaker : Capital_Doomsayer
msgctxt "6e0436ba-ca89-4349-84c8-2ae6c034bd78"
msgid "{n}Remus looks at you silently, nervously pulling at his beard.{/n}"
msgstr "{n}레무스가 당신을 조용히 바라보더니, 이내 초조하게 수염을 잡아당긴다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_87194_Text
#. Speaker : Capital_Jhod
msgctxt "5a07e02e-3324-4769-ac72-a1c17d50b23f"
msgid ""
"{n}Judging by his flared nostrils and furrowed brow, something has upset "
"Jhod greatly.{/n} \"Your Grace! I have here one of your subjects — he goes "
"by the name ‘{d|Remus}Remus{/d}' — we caught him spreading false prophecies, "
"sowing fear among your people!\""
msgstr ""
"{n}조드가 코를 빨갛게 물들이고 눈살을 찌푸린 모양새로 보아, 무슨 일인가 조드를 크게 화나게 한듯합니다.{/n} \""
"{mf|영주님|영주님|전하|전하}! 저희 백성 중 한 명인 이 {d|Remus}레무스{/d}라 불리는자가 거짓 예언을 퍼트려 백성들에게 "
"공포를 불러일으키는 것을 보고 잡아왔습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_87737_Text
#. Speaker : Capital_Doomsayer
msgctxt "bc49ba7a-00dc-4cd2-bed3-27476aff3244"
msgid ""
"{n}At the mention of \"god\" the old man shudders and his eyes go wild, "
"almost feverish.{/n} \"The Goddess will rise from the forests! From the "
"swamps! You've cut down Her trees and drained Her marshes, but She will take "
"no more of this! Fall to your knees and repent, and She will grant you a "
"swift death!\""
msgstr ""
"{n}\"신\"이라는 단어에 노인은 몸서리를 치고 눈은 뜨겁게 달아오를 정도로 거칠어집니다.{/n} \"여신께서 깨어 나신다! 숲에서! "
"그리고 늪에서! 그녀의 나무를 잘라내고 늪을 매마르게 하는 네놈의 만행을 여신께서는 용서치 않으신다! 무릎을 꿇고 회개하라. 그리하면 "
"그분께서 빠른 죽음을 허락해 주시리라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_90327_Text
#. Speaker : Capital_Doomsayer
msgctxt "8af57711-a3b3-4017-a87a-a8326fcece0b"
msgid ""
"\"You don't understand! Nobody does! Only I do! Only I can stop what comes!\""
msgstr "\"너는 아무것도 몰라! 아무도 몰라! 나만 알고 있어! 나만이 미래를 막을 수 있어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_97894_Text
#. Speaker : Capital_Jhod
msgctxt "660e3d3d-0006-450c-a811-9b06800bb6b5"
msgid ""
"\"Praised be {g|Erastil}Erastil{/g}! Is that a glimpse of reason? I thank "
"you, Your Grace, you have turned this poor man towards the light! I'll find "
"him a place to sleep and make sure he's fed and sent back where he came from "
"once he wakes. I think we should expect no more trouble — and no new "
"'prophecies'.\" {n}Jhod smiles and bows, signaling the end of the "
"conversation.{/n}"
msgstr ""
"\"{g|Erastil}에라스틸{/g}을 찬양하라! 제정신이 돌아온건가? 감사드립니다. {mf|영주님|영주님|전하|전하}. 이 불쌍한 "
"사람을 빛으로 인도하셨군요! 이 자에게 잘 곳을 마련하고 잘 먹여주겠습니다. 그리고 일어나는대로 돌려보내도록 하겠습니다. 이젠 더이상 "
"문제가 되진 않을듯합니다. 더이상 새 '예언'도 없을겁니다. {n}조드는 얘기가 끝났다는 듯이 미소지으며 고개를 숙입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_97896_Text
#. Speaker : Capital_Doomsayer
msgctxt "d2f94057-cf12-4a8e-9535-ecff2dba7a90"
msgid "{n}Remus gives you an absentminded look. It seems he's at a loss.{/n}"
msgstr "{n}레무스는 멍한 표정을 짓습니다. 또 정신이 나간 것처럼 보입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-Doomsayer/Cue_97899_Text
#. Speaker : Capital_Doomsayer
msgctxt "a543872b-8a28-4b9b-9956-7ae7a5b1a4ce"
msgid ""
"{n}Remus shrugs.{/n} \"It's possible... Oh, yes, it's possible... I remember "
"a hundred deaths of mine, and I've forgotten a hundred more. But the goddess "
"always returns me to life. I'm Her voice!\""
msgstr ""
"{n}레무스가 어깨를 으쓱입니다.{/n} \"해보거라... 마음껏 해보거라... 백 번을 넘게 죽었지만, 여신께선 언제나 나를 "
"부활시켜주셨다. 내가 그분의 목소리이기 때문이지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-KavkenBringsArticle/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "3cdcee46-4b05-4414-af66-f65045236839"
msgid ""
"{n}Jhod looks to be puzzled and amused at the same time.{/n} \"Your Grace! "
"I've brought you an extremely unusual message.\""
msgstr "{n}조드는 당혹스러워 하면서도 기뻐 보입니다.{/n} \"영주님! 엄청 특이한 전갈이 왔습니다 .\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-KavkenBringsArticle/Cue_0003_Text
msgctxt "c5b1199c-a88e-4199-b236-e23de915f42b"
msgid ""
"\"It's — how should I put it? — {g|JubilostReview_neutral}an essay on your "
"barony{/g}. Written by Jubilost Narthropple, and published only recently. I "
"thought you might like to see it for yourself.\" {n}Jhod hands you a "
"magazine.{/n}"
msgstr ""
"\"이건 — 뭐라고 표현해야 하지? — {g|JubilostReview_neutral}남작령에 대한 평가{/g}입니다. 저자는 주빌로스트 "
"나스로플이고 최근에 출판되었군요. 직접 보고 싶으실 겁니다.\" {n}조드가 잡지를 건네준다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-KavkenBringsArticle/Cue_0004_Text
msgctxt "d96d3488-bb89-4c78-8c48-56714cc31900"
msgid ""
"\"It's — how should I put it? — {g|JubilostReview_good}an essay on your "
"barony{/g}. Written by {d|c21 Jubi pleased}Jubilost Narthropple{/d}, and "
"published only recently. I thought you might like to see it for yourself.\" "
"{n}Jhod hands you a magazine.{/n}"
msgstr ""
"\"이건 — 뭐라고 표현해야 하지? — {g|JubilostReview_good}남작령에 대한 평가{/g}입니다. 저자는 주빌로스트 "
"나스로플이고 최근에 출판되었군요. 직접 보고 싶으실 겁니다.\" {n}조드가 잡지를 건네준다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-KavkenBringsArticle/Cue_0005_Text
msgctxt "4bccae60-8c5c-46e4-935a-95524663169d"
msgid ""
"\"It's — how should I put it? — {g|JubilostReview_bad}an essay on your "
"barony{/g}. Written by {d|c21 Jubi displeased}Jubilost Narthropple{/d}, and "
"published only recently. I thought you might like to see it for yourself.\" "
"{n}Jhod hands you a magazine.{/n}"
msgstr ""
"\"이건 — 뭐라고 표현해야 하지? — {g|JubilostReview_bad}남작령에 대한 평가{/g}입니다. 저자는 주빌로스트 "
"나스로플이고 최근에 출판되었군요. 직접 보고 싶으실 겁니다.\" {n}조드가 잡지를 건네준다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-KavkenBringsArticle/Items/Article_Neutral_String
msgctxt "cfe6d824-c0a4-4013-81ae-55c2d5ffa4ce"
msgid ""
"Between the dense bogs of the River Kingdoms and the infertile clay soil of "
"Brevoy lies a region known as the Stolen Lands — a picturesque area "
"combining the worst features of the aforementioned countries. It's a "
"woodland in which herds of deer, swarms of mosquitoes, and gangs of bandits "
"range and forage. The latter have significantly decreased in numbers thanks "
"to the efforts of the local baron{mf||ess} — a protégé of the Restov "
"Swordlords who's promised to bring some semblance of order to these lands. "
"Hoping to discover to what degree {mf|he|she} succeeded, your faithful "
"servant traveled to the Stolen Lands himself.\n"
"While I certainly preceded my visit with a letter, as is common courtesy, "
"the mailing service in this new barony seems to operate with zero "
"efficiency. The only party who came to greet me was a horde of hungry "
"kobolds — which, in these lands, can be found with more regularity than any "
"guards or, let's say, street cleaners. After barely managing to fend off "
"those pests, I narrowly escaped drowning while crossing the river ford. It "
"seems the only sight more rare than a paved road in these parts would be a "
"sturdy, well-maintained bridge. Every ruler should remember that their "
"realm's roads are akin to their face to the traveling public, and here "
"they're filthy and in desperate need of some good stone.\n"
"After those misadventures, I finally found my way to the capital. Compared "
"to other parts of the barony, the city looks to be in relatively good shape, "
"despite the smell. I must credit the ruler's efforts — there are buildings "
"in progress everywhere. Passing traders praised the baron{mf||ess} for "
"eliminating the bandits, and they expressed hopes that {mf||s}he'll "
"eventually deal with the wildland monsters as well.\n"
"Due to some odd climatic anomaly, the Stolen Lands have become a land of "
"never-ending summer, though I wouldn't recommend choosing the destination "
"for your summer vacation. On the other hand, if you're tough and "
"unpretentious, if you can work hard and defend yourself, you might try your "
"luck here — working hands are in great demand in the capital. There are also "
"plenty of jobs for free adventurers and sellswords — after all, the local "
"baron{mf||ess} was one {mf|him|her}self not so long ago. As for me, I think "
"I'll stay for a while to watch how this new barony grows. If I don't end up "
"drowned in some swamp, snacked on by an owlbear, or dead of dysentery, we'll "
"meet again in the next issue!"
msgstr ""
"강의 왕국에 널린 질척한 늪지대와 브레보이의 척박한 진흙 토양 사이에는 두 나라의 가장 끔찍한 특징만을 모아 놓은 듯한 도둑맞은 땅이 "
"있다. 사슴 무리와 모기떼, 도적단이 목초지를 두고 다투는 이 삼림 지대는, 레스토프 소드로드가 이 땅에 질서를 세우고자 후원한 현지 "
"남작의 노력으로 그나마 수가 감소했다. {mf||여}남작 성공이 어느 정도인지 알아내기 위해, 독자 여러분의 충실한 종인 내가 직접 "
"도둑맞은 땅으로 가보았다.\n"
" 분명히 방문에 앞서 예의상 편지를 보냈건만, 이 신생 남작령에서 우편 제도는 없다고 봐야 할 것 같다. 나를 환영하기 위해 나온 유일한 "
"존재들은 굶주린 코볼트 무리뿐이었다. 이 땅에서는 환경 미화원에 가까운 경비대보다 자주 만날 수 있을 것이다. 간신히 이 해충들을 "
"쫓아내는 중에는, 강기슭에서 거의 익사할 뻔했다. 이곳에서는 포장도로만큼 보기 힘든 것이 잘 정비된 다리다. 모든 통치자는 영지로 통하는 "
"길이 곧 그 자신의 얼굴이라는 점을 명심해야 한다. 지저분한 길바닥과 제대로 된 포석조차 없는 도로라니.\n"
" 이런 시행착오 끝에, 나는 수도에 도착할 수 있었다. 남작령의 다른 지역과 비교하면, 냄새를 제하고는 비교적 잘 만들어진 도시다. "
"통치자의 노력에 찬사를 보낸다. 도시 여기저기에서는 공사가 진행 중이다. 행상인들은 도적 떼를 처치한 {mf||여}남작을 찬양하며, "
"언젠가 {mf||여}남작이 다른 괴물까지 처리해주길 바라고 있다.\n"
" 기후 이변 때문에 도둑맞은 땅은 여름이 끝나지 않는 땅이 되었지만, 이곳을 여름 휴양지로 선택하지는 않았으면 한다. 반대로 신체 "
"건강하고, 가식 없으며, 근면하고 스스로를 지킬 수 있는 사람이라면, 이 땅에서 당신의 행운을 시험해 볼 수 있을 것이다. 수도에는 많은 "
"인력이 필요하며, 모험가와 용병을 위한 일거리 또한 많다. {mf||여}남작도 얼마 전까진 용병이었으니 말이다. 나는 이곳에 머무르며 "
"신생 남작령이 어떻게 성장하는지 지켜볼 생각이다. 내가 늪에 빠져 죽거나, 아울베어의 간식이 되거나, 이질로 죽지 않는다면, 다음 호에서 "
"만나도록 하자!"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Answer_05634_AlignmentShift.Description
msgctxt "d80cca21-0694-492b-9a42-25e6754a4870"
msgid "Left Oleg's Trading Post for Brevoy."
msgstr "올렉의 교역소를 브레보이 통치령으로서 남겼습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Answer_05634_Text
msgctxt "086a0993-a2cf-48bb-9b89-d1aa1d3a6dce"
msgid ""
"\"Our barony owes much to Restov's Swordlords. We'll allow them to collect "
"taxes from Oleg's Trading Post — it's only fair.\""
msgstr ""
"\"우리 영지는 레스토프의 소드로드들에게 많은 빚을 지고 있다. 그들이 올렉의 교역소에서 세금을 징수할 수 있도록 허용하겠다. 그것이 "
"진정 공평한 것이겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Answer_11823_Text
msgctxt "97627b83-8242-42dc-98c5-c580baf544f6"
msgid ""
"\"Oleg, which would you rather swear allegiance to? Restov, or myself?\""
msgstr "\"올렉, 어느 쪽에 충성을 맹세할꺼지? 레스토프에게? 아니면 나에게?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Answer_33896_Text
msgctxt "e2121585-97f9-45a9-ad56-9bdf9c78db3d"
msgid "\"Advisors, thoughts?\""
msgstr "\"보좌관들의 생각은?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Answer_66132_AlignmentShift.Description
msgctxt "b3ee03a8-1a24-403d-bcf0-67ffec2c78ce"
msgid "Sent the guards to secure Oleg's Trading Post."
msgstr "올렉의 교역소를 지키기 위해 경비를 파견했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Answer_66132_Text
msgctxt "2a9bf533-0ed6-444d-8a29-b58688b46962"
msgid ""
"\"Kesten — send guards to Oleg's Trading Post. Take what's due, then guard "
"our new subject and his goods from any further Restovic claims.\""
msgstr ""
"\"케스턴, 올렉의 교역소에 경비대를 보낼 수 있도록. 받을 건 받되, 레스토프의 어떠한 더 이상의 요구에도 우리의 새 백성과 그의 "
"물건들을 지킬 수 있도록하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Answer_74920_AlignmentShift.Description
msgctxt "c5b0912b-b7b8-431e-9659-624a7b0ef86b"
msgid "Forgave Oleg's undercollected taxes."
msgstr "올렉의 미납세금을 면제하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Answer_74920_Text
msgctxt "da82b31f-6a87-400b-ad07-1078761dc3be"
msgid ""
"\"We won't collect any taxes from Oleg this month. Let him go. I'll discuss "
"the matter of Oleg's fealty with the Swordlords in {g|Restov}Restov{/g} so "
"we can determine whether he should be bound to them or to me.\""
msgstr ""
"\"우리는 이번달 올렉에게서 어떠한 세금도 걷지 않을 것이다. 그를 보내 주어라. 나는 {g|Restov}레스토프{/g}의 소드로드들에게 "
"올렉의 충성서약에 대한 문제를 추후 논의할 것이며, 그에 따라 나에게 속할지 그들에게 속할지 결정할 수 있을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Answer_95055_Text
msgctxt "0f4660f2-c012-4e4a-850c-f2bd63046ad2"
msgid "\"What's the matter, Oleg?\""
msgstr "\"무슨 문제입니까, 올렉?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Answer_95057_Text
msgctxt "29c43e2b-d098-434d-a9ca-5b13313373c5"
msgid ""
"\"I don't recall granting permission to waste my time on such trivial "
"matters.\""
msgstr "\"이런 사소한 일로 내 시간을 낭비하도록 허락 한 적이 없는걸로 아는데..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Answer_95059_Text
msgctxt "147a69d3-c883-4576-b277-ade245ea57e3"
msgid ""
"\"There can be no justification for tax evasion. There's nothing to talk "
"about here.\""
msgstr "\"세금 회피에 관해서는 어떠한 정당화도 불가능합니다. 더 이상 이에 대해 할 말은 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Barks/KestenAboutOleg_String
msgctxt "675ea1d6-266d-443d-aac8-9f947350b4a4"
msgid "\"Hey, take it easy on him!\""
msgstr "\"이봐, 그를 진정시켜!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_21170_Text
#. Speaker : Capital_Oleg
msgctxt "23672c9b-25ed-416f-9862-342e589468eb"
msgid ""
"\"When you brought down the Stag Lord, I thought my troubles were over. But "
"no!\" {n}Oleg shakes his head.{/n} \"My whole life, I've paid taxes to "
"{g|Restov}Restov{/g}. Now, on top of that, YOUR tax collectors darken my "
"doorstep!\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}께서 숫사슴 군주를 끌어내렸을때, 저는 모든 문제들이 사라졌다고 생각했습니다. 그러나 아니였습니다!\""
" {n}올렉은 머리를 가로저었습니다.{/n} \"제 일생동안, 저는 {g|Restov}레스토프{/g}에 세금을 내왔습니다. 이제, 거기에 "
"더해, 당신의 세금징수원이 저의 집 문앞을 지키고 서 있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_27096_Text
#. Speaker : Capital_Oleg
msgctxt "571b4a54-e8a1-4cb4-ab55-45e4a6837534"
msgid ""
"{n}Oleg smiles faintly.{/n} \"Well... I... I thank you, Your Grace.\" {n}He "
"bows awkwardly, then rises, embarrassed.{/n} \"That's most just of you.\""
msgstr ""
"{n}올렉은 희미한 미소를 짓습니다.{/n} \"아..저...감사합니다. {mf|영주님|영주님|전하|전하}.\"{n}그는 어설프게 허리를 "
"굽히더니, 쑥쓰러운듯 허리를 폈습니다.{/n} \"{mf|영주님|영주님|전하|전하} 다우십니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_28905_Text
#. Speaker : Capital_Lander
msgctxt "d7b85e8e-a756-45fe-a561-5bcbf5125c88"
msgid ""
"\"I'd certainly think twice before just giving subjects away to a rival "
"kingdom, especially a subject that could keep coins in our coffers.\""
msgstr ""
"\"나는 경쟁하는 왕국들에 백성을 넘겨주기 전에 한번 더 생각해 보아야 합니다. 특별히 그 백성이 우리 금고에 돈을 내줄이라면.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_47381_Text
#. Speaker : Capital_Jhod
msgctxt "e4984eda-df27-48dd-8da8-dce2cd12cc16"
msgid "{n}Jhod sighs quietly, studying Oleg with a worried expression.{/n}"
msgstr "{n}조드는 올렉의 근심하는 표정을 살피더니, 가볍게 한숨을 쉬었습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_62404_Text
#. Speaker : Capital_Oleg
msgctxt "7dfc81d9-dfbe-40bb-8262-d1d4eef06fa6"
msgid ""
"{n}Oleg grimaces, making a clear effort to not spit on the floor.{/n} \"Since"
" the moment you founded this barony, Your Grace, I became your subject...\" "
"{n}He grits his teeth.{/n} \"But I'm still also a subject of the Aldori in "
"{g|Restov}Restov{/g}.\""
msgstr ""
"{n}올렉은 바닥에 침을 뱉지 않으려고 분명 노력하며 얼굴을 찡그립니다.{/n} \"{mf|영주님|영주님|전하|전하}, "
"{mf|영주님|영주님|전하|전하}께서 이 남작령을 세운 이후, 저는 당신의 백성이 되었습니다...\" {n}그는 이를 악물었습니다.{/n}"
" \"그러나 저는 여전히 알도리의 {g|Restov}레스토프{/g} 백성이기도 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_63855_Text
#. Speaker : Capital_Jhod
msgctxt "40379567-6357-4a19-80f6-ac32750eff1a"
msgid ""
"\"The fool didn't realize he should have come to you immediately, but even "
"so, please lend him your ear!\""
msgstr ""
"\"올렉 이 멍청이가 당장 {mf|영주님|영주님|전하|전하}께 왔어야 한다는 것을 미처 몰랐나봅니다. 그래도 그의 말에 귀를 기울여 "
"주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_69961_Text
#. Speaker : Capital_Lander
msgctxt "d8214e75-99c8-4761-b6e9-225dcd18108f"
msgid ""
"\"Oleg's Trading Post is within our borders. We have the right to collect "
"taxes from him. As for the {g|Swordlords}Swordlords{/g} — to Hell with them. "
"They won't start a full-scale conflict over some backwater trading post.\""
msgstr ""
"\"올렉의 교역소는 우리 영토 안에 있지. 그에게 세금을 걷을 권리도 우리쪽에 있어. {g|Swordlords}소드로드{/g}들쪽은 "
"꺼지라고 해. 어차피 그들도 오지의 교역소를 위해 전력으로 싸우려 하진 않을거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_71952_Text
#. Speaker : Capital_Jhod
msgctxt "e5eafca1-f6c5-490f-8df6-65041567323c"
msgid ""
"\"Oleg is more important than a few months' worth of taxes. Collecting now "
"would ruin a kind and honest — if somewhat clueless — man. Please keep this "
"in mind, Your Grace.\""
msgstr ""
"\"올렉은 몇 달치 세금보다 더 중요합니다. 지금 세금을 징수하는건 친절하고 정직한 사람을 망치게 할 것입니다. 다소 멍청한 구석이 "
"있긴해도 말이죠. 이 점을 명심해 주십시오, {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_74497_Text
#. Speaker : Capital_Lander
msgctxt "af700e2b-ab1a-4495-95fd-1f203d59911e"
msgid ""
"\"We could have just given Jamandi a rap across the knuckles. Oh well. "
"Diplomacy it is.\""
msgstr "\"우리가 자만디에게 한 방 먹일 수도 있었을 텐데. 오, 맞아. 그게 외교지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_74751_Text
#. Speaker : Capital_Jhod
msgctxt "4b67f194-14f0-49e3-b580-34153502d3f3"
msgid "\"A bad peace is better than a good war.\""
msgstr "\"비굴한 평화가 의로운 전쟁보다 낫습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_75014_Text
#. Speaker : Capital_Oleg
msgctxt "4257b670-8115-4ccf-8daf-5b7df010acb9"
msgid ""
"{n}You can hear Oleg's teeth clench. His hands ball into fists. While he was "
"clearly angry before, his face has turned red with fury, but he holds his "
"tongue.{/n}"
msgstr ""
"{n}당신은 올렉의 이가 갈리는 소리를 들었습니다. 그의 주먹은 꽉 쥐어져 있습니다. 얼마나 화가 났는지 그의 얼굴은 분노로 새빨개져 "
"있지만, 아무말도 하지는 않습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_81611_Text_String
#. Speaker : Capital_Shandra
msgctxt "89640e91-71cb-431e-bd02-8f6a46f105bd"
msgid ""
"\"A problem demands your personal attention, Your Grace. Your acquaintance, "
"Oleg, has been refusing to pay his taxes for months now, even though his "
"trading post is located in your lands.\""
msgstr ""
"\"이 문제는 {mf|영주님|영주님|전하|전하}의 개인적인 관계와도 연관이 있습니다. {mf|영주님|영주님|전하|전하}. "
"{mf|영주님|영주님|전하|전하}의 지인인 올렉은 비록 교역소가 {mf|영주님|영주님|전하|전하}의 영지에 위치하고 있음에도 불구하고 "
"지금 몇 달째 세금 납부를 거부하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_84267_Text
#. Speaker : Capital_Jhod
msgctxt "c1a56208-580d-48e0-b10a-2d2f16bf5ae1"
msgid ""
"\"I'm certain we can reach an agreement with Jamandi and acquire the trading "
"post in short order without any direct conflict with the "
"{g|Swordlords}Swordlords{/g}.\""
msgstr ""
"\" {g|swordlords}소드로드{/g}와 직접적인 충돌 없이 자만디 공과 합의하고 단기적으로 교역소를 취득할 수 있을 것으로 "
"확신합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_87470_Text
#. Speaker : Capital_Oleg
msgctxt "ed9396c7-43fe-4adf-ba31-4c708170b631"
msgid ""
"{n}Oleg looks like he's surprised to be asked. He thinks for a moment, and "
"you realize he's making an extraordinary effort to be polite.{/n} \"Forgive "
"me, Your Grace, but regardless of what banner they fly, all tax collectors "
"are little more than bandits to me.\""
msgstr ""
"{n}올렉은 질문을 받고 놀란 것 같습니다. 그는 잠시 생각합니다. 당신은 그가 예의를 갖추기 위해 애써 노력 하고 있다는 것이 "
"느껴집니다.{/n} \"용서해 주십시오. {mf|영주님|영주님|전하|전하}. 하지만 어떤 문양의 깃발을 휘날리던 모든 세금 징수원들은 "
"제게는 도적이나 다름없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_95054_Text
#. Speaker : Capital_Lander
msgctxt "5e240b0d-bd5f-4a98-ab2c-b4aa99bb4788"
msgid ""
"\"A harsh decision, but the right one. A good ruler can't afford to fool "
"around.\""
msgstr "\"가혹한 처사로군, 하지만 옳은 결정이기도 해. 좋은 통치자는 다른 사람들을 속여서는 안되니까.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_95058_Text_String
#. Speaker : Capital_Kassil
msgctxt "318c8fb9-d321-4bb8-b0c3-414dc046a653"
msgid ""
"\"I fear this matter may be more complicated than you expect. Oleg, please "
"explain your situation.\""
msgstr "\"이 문제가 당신의 예상보다 더 복잡한 일일 수도 있을 것 같습니다. 올렉, 당신이 처한 상황을 설명해주세요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_95066_Text
#. Speaker : Capital_Kassil
msgctxt "5b4dd9dd-dad2-40eb-9a06-61e64c5bd565"
msgid ""
"\"Your Grace, the Aldori {g|Swordlords}Swordlords{/g} are true allies and "
"the backbone of the barony. I would hope you still value Lady Jamandi's "
"support and won't let such short-term interests undermine our alliance.\""
msgstr ""
"\"{mf|영주님|영주님|전하|전하}, 알도리 {g|Swordlords}소드로드{/g}는 진정한 우방이자 저희 영지의 중추입니다. 저는 "
"{mf|영주님|영주님|전하|전하}께서 여전히 자만디 공의 지지를 소중히 여기고 이런 단기적 이익 때문에 우리의 동맹이 훼손하지 않도록 "
"바랄뿐입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_95067_Text
#. Speaker : Capital_Shandra
msgctxt "6a2d49bb-b51a-4922-9a76-23a78bfd5cc4"
msgid ""
"\"It's high time we let the Aldori know who truly rules this realm. A coach "
"with two coachmen cannot travel a straight road.\""
msgstr ""
"\"알도리에게 이 {mf|영지를|영지를|왕국을|왕국을} 진정으로 지배하는 자가 누구인지 알릴 때가 되었다. 마부가 두명이나 있는 마차는 "
"똑바르게 나갈 수 없는 법.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_95071_Text
#. Speaker : Capital_Shandra
msgctxt "c294b86e-e354-4492-af4b-08b5ef47fb06"
msgid ""
"{n}Shandra shakes her head mournfully.{/n} \"This is unwise. You're within "
"your rights to do this, Your Grace, but please remember — in the politics "
"game, the one who knows how to bite is the first to be eaten by the others.\""
msgstr ""
"{n}산드라는 애절하게 고개를 가로젓습니다.{/n} \"이것은 현명하지 못한 일입니다. 물론 {mf|영주님|영주님|전하|전하}께선 어떤 "
"결정이든 내리실 권한이 있으십니다. 다만 명심하십시오. 정치 게임에선 물 줄 아는 사람이 다른 사람들에게 가장 먼저 먹히는 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_95072_Text
#. Speaker : Capital_Kassil
msgctxt "0768043d-912c-4692-8d11-0be80058199a"
msgid "\"Thank you, Your Grace. The Aldori will not forget this.\""
msgstr "\"감사합니다. {mf|영주님|영주님|전하|전하}. 알도리는 이 결정을 잊지 않을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_95075_Text
#. Speaker : Capital_Kassil
msgctxt "3264a70d-1493-4192-a6bd-346a6c37e0eb"
msgid ""
"{n}Kassil bows his head.{/n} \"A wise decision. Should you wish, I will "
"write Lady Jamandi myself and explain the matter to her. Perhaps she'll "
"agree to a sensible sharing of taxes between the barony and "
"{g|Restov}Restov{/g}.\""
msgstr ""
"{n}카실은 고개를 숙입니다.{/n} \"현명한 결정이십니다. 원하신다면 제가 직접 자만디 공에게 편지를 써서 그 문제를 설명하겠습니다. "
"아마도 자만디 공은 저희 영지와 {g|Restov}레스토프{/g} 사이의 합리적인 세금 분담에 동의할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_95076_Text
#. Speaker : Capital_Shandra
msgctxt "6d55ce62-5561-493a-98d1-ea5ab47fbb16"
msgid ""
"\"You should be more forceful in your negotiations, Your Grace. You purged "
"the lands of bandits. You brought order to the realm. You should be the one "
"collecting taxes from the populace.\""
msgstr ""
"\"전하, 협상을 하실 땐 더 강하게 나가실 필요가 있습니다. 당신께선 이 땅에서 도적들을 몰아내셨습니다. 당신께선 이 지역에 질서를 "
"세우셨습니다. 당신께선 주민들에게 세금을 걷을 수 있는 유일한 분이십니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_95079_Text
#. Speaker : Capital_Kassil
msgctxt "0a5265d9-7663-4ca3-aee8-b49fc22b2d4b"
msgid ""
"{n}Kassil's face darkens, but he maintains his composure.{/n} \"I hope you "
"know what you're doing, Your Grace. An ally's trust costs a fortune, and a "
"trust betrayed may cost even more.\""
msgstr ""
"{n}카실의 표정이 어두워졌으나, 평정심을 잃지는 않습니다.{/n} \"전하, 당신께서 무슨 일을 하시는지 확실히 아시길 바랍니다. "
"동맹의 신뢰를 얻는 데는 돈이 들지만, 배신당한 믿음에는 그보다 훨씬 많은 비용이 들 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegFirst/Cue_95080_Text
#. Speaker : Capital_Shandra
msgctxt "f593d8ee-6a1b-4c0e-89c9-f0274bb934e4"
msgid ""
"{n}Shandra nods approvingly.{/n} \"It wouldn't hurt the Aldori to learn a "
"lesson in manners. Jamandi may give an overdramatic gasp of offense, but the "
"Aldori are in no position to retaliate.\""
msgstr ""
"{n}샨드라가 동의의 뜻으로 고개를 끄덕입니다.{/n} \"예의을 갖춰 훈계하신다면 알도리에게도 큰 상처로 남진 않을겁니다. 자만디가 "
"과도하게 공격적인 언행을 저지를 순 있지만, 알도리가 보복할 수 있는 상황 또한 아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Answer_31464_Text
msgctxt "309d6004-51a4-4597-bdad-163cf4a12938"
msgid ""
"\"We'll accept their offer and send Restov the year's taxes from Oleg's "
"Trading Post. We'll also improve the road between Restov and the post.\""
msgstr ""
"\"그들의 요구를 받아들이며, 레스토프로 올렉의 교역소 세금을 보내라. 우리는 또한 레스토프와 교역소간 도로의 보수공사를 진행하고 싶다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Answer_82092_Text
msgctxt "0119492d-2272-45b8-a41d-c04bd95de03b"
msgid ""
"\"In that case, we'll have to permanently station guards at Oleg's Trading "
"Post. Perhaps even turn it into a military checkpoint.\""
msgstr "\"그렇다면, 올렉의 교역소에 경비대를 상주시키도록 하라. 아마 군사 거점으로 전환할 수도 있을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Answer_91273_Text
msgctxt "46a658fe-d0b6-4e25-a64d-0e5a88a3cdc2"
msgid ""
"\"I've no interest in crossing the Swordlords over Oleg's Trading Post. "
"Perhaps we could send them a sum of gold as compensation.\""
msgstr "\"올렉의 교역소를 두고 소드로드와 분쟁하고 싶지는 않다. 보상금으로써 금화를 어느정도 보내야 할 것 같군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Answer_91277_Text
msgctxt "f4ae12d0-b328-4eb8-8ed7-fd60b777013c"
msgid "\"This is no time to be pressuring our allies.\""
msgstr "\"지금은 동맹국들을 압박할 때가 아니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Answer_91278_Text
msgctxt "c123f646-55ad-4819-9c82-bec12daae3c8"
msgid ""
"\"So be it. I'll suggest the Aldori renovate the road to Oleg's post, since "
"they want to continue collecting taxes for the Restov treasury from him.\""
msgstr ""
"\"그렇게 하라. 레스토프가 올렉에게서 계속 세금을 걷길 원한다면, 알도리에서 그의 교역소까지 향하는 길을 개축하도록 제안하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Answer_91282_Text
msgctxt "b03fde10-18d6-402b-996d-4135d05be851"
msgid ""
"\"We can't openly confront Jamandi. We'll bide our time — declare we've "
"begun working on the road. There was no mention of a specific time line for "
"the renovation, was there?\""
msgstr ""
"\"공개적으로 자만디와 맡설 수는 없지. 시간을 벌자. 도로 공사를 시작했다고 공표하라. 공사를 언제까지 끝내야 할지 날짜를 정한건 "
"아니잖나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Answer_91310_Text
msgctxt "f2f2287b-1854-4187-b94e-1d65d857a1d6"
msgid "\"Thank you, Kassil. We'll repair the road.\""
msgstr "\"고맙다, 카실. 도로 공사는 우리가 맡지\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Answer_91316_Text
msgctxt "ea2ee0bb-c4c3-46df-8e10-99e39348633c"
msgid "\"I value what the Aldori have done for me.\""
msgstr "\"나는 알도리가 내게 해준 것들을 소중히 여긴다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Answer_91317_Text
msgctxt "f33e1c05-bc88-451f-ac85-68a712bf45fc"
msgid ""
"\"That's all well and good, but perhaps the Swordlords should consider doing "
"something for the trading post they want to collect taxes from.\""
msgstr "\"다 좋은데, 소드로드가 교역소에서 세금을 떼고 싶다면 그에 상응하는 뭔가를 줘야 할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_02134_Text
#. Speaker : Capital_Lander
msgctxt "386de9d4-f836-4674-a2b2-71368bb72061"
msgid ""
"{n}Lander purses his lips and shrugs.{/n} \"Pay them off? Not the wisest "
"decision, but... suit yourself.\""
msgstr ""
"{n}랜더가 그의 입을 삐죽 내밀고 으쓱합니다.{/n} \"그들에게 보상하라고? 현명한 결정은 아니야, 하지만... 네가 그러라면.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_03294_Text
msgctxt "7adaa6cd-3668-4d7c-bf71-4b4b2d6559ff"
msgid ""
"\"The {g|Swordlords}Swordlords{/g} are most satisfied by your decision to "
"leave Oleg's Trading Post under {g|Restov}Restov's{/g} jurisdiction, even "
"though it formally belongs to our barony. Here, {g|oleg_leftforbrevoy}read "
"for yourself{/g}.\""
msgstr ""
"\"{g|Swordlords}소드로드{/g}들은 올렉의 교역소를 {g|Restov}레스토프{/g} 관할 구역으로 유지하겠다는 당신의 "
"결정에 매우 만족했습니다, 그곳이 지리적으로는 당신의 남작령에 있는데도 불구하고 말입니다. 여기, {g|oleg_leftforbrevoy}"
"편지가 왔습니다{/g}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_13001_Text
#. Speaker : Capital_Lander
msgctxt "4d949698-db0e-4b1f-89bf-17db6ca8ebb5"
msgid ""
"\"The {g|Swordlords}Swordlords{/g}' reaction to your request for "
"jurisdiction over Oleg's Trading Post is... rather cold, as though they'd "
"never considered that {g|Restov}Restov{/g} shouldn't be collecting taxes "
"from the subjects of other rulers. Now they are demanding compensation — not "
"only in gold, but also in form of repairing a road from the Trading Post to "
"Restov.\" {n}Lander rolls his eyes.{/n} \"{g|oleg_forgiven}Read for "
"yourself,{/g} if you wish. It's quite entertaining.\""
msgstr ""
"\"올렉의 교역소에 대한 관할권을 요구한데 대해 {g|Swordlords}소드로드{/g}들의 반응이... 냉담하네. 마치 "
"{g|Restov}레스토프{/g}에서 다른 통치자의 주민에게 세금을 걷을 수 없을 거라곤 생각도 못한 것처럼 말이야. 이제 그들은 보상을 "
"요구하고 나섰어 — 금화뿐만 아니라, 레스토프에서 교역소까지 이어지는 길에 대한 수리 비용까지.\" {n}랜더는 그의 눈알을 "
"굴립니다.{/n} \"원한다면, {g|oleg_forgiven}읽을거리가 있어.{/g} 꽤 재밌는 내용이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_14816_Text
#. Speaker : Capital_Lander
msgctxt "e6449391-5be5-4e51-a3bb-04d4bc388f57"
msgid ""
"\"Predictably, the {g|Swordlords}Swordlords{/g} are furious that "
"{g|Restov}Restov{/g} couldn't collect Oleg's taxes for the month.\" {n}A "
"satisfied grin curves Lander's mouth.{/n} \"Also unsurprisingly, there's "
"little they can do about it beyond stomp their feet and rattle their "
"scabbards. Here, read for yourself — it's a light but entertaining "
"{g|oleg_secured}read{/g}.\""
msgstr ""
"\"예상한대로, {g|Swordlords}소드로드{/g}들은 {g|Restov}레스토프{/g}가 올렉에게서 이번 달 세금을 걷지 "
"못했다는데 분개하고있어.\" {n}만족스러운듯 비웃는 소리가 랜더의 입에서 나옵니다.{/n} \"게다가 놀랍지 않게도, 발을 동동 구르며 "
"칼자루를 딸그락대는것 말곤 아무것도 못했지. 여기, 읽을거리가 왔어 — 가벼우면서도 재밌는 {g|oleg_secured}편지{/g}야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_27578_Text
#. Speaker : Capital_Lander
msgctxt "4ead92a2-4d4d-4535-8bf9-66aeb5ed4e67"
msgid ""
"{n}Lander doesn't even try to pretend he isn't gloating.{/n} \"I'm positive "
"the {g|Swordlords}Swordlords{/g} will hate this. I'm all for it!\""
msgstr ""
"{n}랜더는 만족감을 숨기려는 시도조차 하지 않습니다.{/n} \"{g|Swordlords}소드로드{/g}들이 싫어할 거라는 게 너무 "
"즐거워. 완전 찬성이야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_38007_Text_String
#. Speaker : Capital_Shandra
msgctxt "6ddd13af-61d7-49e7-8a9a-cb4b0ee6951f"
msgid ""
"\"We've received a letter from {g|Brevoy}Brevoy{/g} concerning Oleg's "
"Trading Post.\""
msgstr "\"{g|브레보이}브레보이{/g}에서 올렉의 교역소에 관해 편지를 받았습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_38727_Text
msgctxt "49aad8c0-e1a9-4bea-8678-cf37c902fcd4"
msgid ""
"\"I'm still amazed by your decision, but what's done is done. A bit of "
"advice: squeeze anything you can out of Jamandi for this — anything at all. "
"If the Aldori are so proud of this alliance, make them actually contribute "
"to it rather than just keep hoarding YOUR tax money.\""
msgstr ""
"\"당신의 결정이 여전히 놀랍지만, 끝난 건 끝난 일입니다. 조언을 드리자면: 당신이 자만디에게서 뜯어낼 수 있는건 뭐든지 짜내십시오 — "
"뭐든지 말입니다. 만일 알도리가 이 동맹에 대해 만족스러워한다면, 단순히 '당신의' 세금을 뺏어가는 것 이상으로 실질적인 기여를 하도록 "
"만들어야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_43883_Text
#. Speaker : Capital_Lander
msgctxt "e0c03080-3b6c-4967-aa57-bd09480afc15"
msgid ""
"\"I would advise you to be more... resolute, let's say, in your dealings "
"with the {g|Swordlords}Swordlords{/g}. Don't fall for their diplomatic "
"frills.\" {n}Lander gives a dissatisfied cough.{/n}"
msgstr ""
"\"네게 조언을 좀 해준다면, 너는 좀 더... 단호해야해, 내 말은, {g|Swordlords}소드로드{/g}들과 문제를 처리할 때 "
"말이야. 그들의 외교적 겉치레에 속지 말라고.\" {n}랜더는 불만스러운듯 기침합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91279_Text
#. Speaker : Capital_Lander
msgctxt "fcd41b7c-5df6-4e16-ba66-d49fa4be61f5"
msgid "\"Perfect! The road will be of great use to us as well.\""
msgstr "\"완벽해! 그 도로는 우리에게도 큰 도움이 될 거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91280_Text
#. Speaker : Capital_Lander
msgctxt "30313765-eb1b-49a2-82cb-9226dbb9f12d"
msgid ""
"\"Of course, of course!\" {n}Lander spreads his arms in conciliation, though "
"he doesn't seem to be convinced.{/n}"
msgstr "\"물론이지, 물론이야!\" {n}납득한 것으로 보이진 않았지만, 그래도 랜더는 달래듯 그의 팔을 활짝 펼칩니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91283_Text
#. Speaker : Capital_Lander
msgctxt "3d5e6aea-08c5-4516-b74f-df17d7514b3d"
msgid ""
"\"You just leave that to me! They'll get their renovation, don't you doubt. "
"Believe me, I know all there is to know about showing a flurry of activity "
"without actually doing anything.\" {n}Lander smiles, a rare sight indeed — "
"he finally looks less arrogant than usual.{/n}"
msgstr ""
"\"그건 나에게 맡겨둬! 의심할 필요도 없이, 그들도 보수 공사에 착수할거야. 믿어봐. 난 실제로는 아무것도 안하면서 보여주기식 활동을 "
"하는데 도가 텄으니까!\" {n}랜더는 미소짓습니다, 보기 드문 광경이죠 — 덕분에 이전만큼 거만해보이진 않습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91284_Text
#. Speaker : Capital_Kassil
msgctxt "60804f31-8922-4f02-b1c4-6026384c40fb"
msgid ""
"\"As expected, Swordlord Jamandi is both perplexed and grieved by your {d|"
"c21 Capture OTP}decision{/d} to take the trading post away from "
"{g|Restov}Restov{/g}. Still, you should probably read {g|oleg_secured}the "
"letter{/g} for yourself.\""
msgstr ""
"\"예상대로, 소드로드 자만디는 {g|Restov}레스토프{/g}로부터 교역소를 탈환하기로 한 당신의 {d|c21 Capture "
"OTP}결정{/d}에 당혹감을 감추지 못했습니다. 또한, 아마도 당신이 직접 읽어보셔야 할 {g|oleg_secured}편지{/g}를 "
"보냈습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91285_Text
#. Speaker : Capital_Kassil
msgctxt "58d02fb6-d79d-4433-9239-2488ace03dfa"
msgid ""
"\"I must admit, Lady Jamandi wasn't pleased by your {d|c21 Claim "
"OTP}request{/d} to surrender jurisdiction {g|oleg_forgiven}over Oleg's "
"Trading Post to you.{/g} The Aldori take matters of allegiance and loyalty "
"very seriously. Nevertheless, I was able to convey your position and clear "
"the air. I believe I'll be able to persuade the Aldori to not demand a "
"year's worth of Oleg's taxes from you. However, repairing the road falls "
"entirely to us.\""
msgstr ""
"\"자만디 공이 {g|oleg_forgiven}올렉의 교역소의 사법령을 이관해달라{/g}는 영주님의 {d|c21 Claim "
"OTP}요구{/d}에 그다지 호의적이지는 않았습니다. 알도리 가문은 충성과 의무에 매우 엄격하기 때문이죠. 그렇지만, 제가 영주님의 "
"입장을 분명히 밝히고 의혹을 풀어냈습니다. 알도리 가문이 영주님께 올렉의 세금을 요구하지 못하도록 잘 설득시킬 수 있을 거라 전망합니다. "
"그러나 도로 공사는 저희가 책임지기로 했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91286_Text
#. Speaker : Capital_Kassil
msgctxt "90922950-6940-4a27-b1d8-634059eebe69"
msgid ""
"\"Lady Jamandi truly appreciates your {d|c21 Left OTP}decision{/d} to not "
"lay claim on the taxes from Oleg's Trading Post. Here's "
"{g|oleg_leftforbrevoy}the letter{/g}. I was also instructed to express the "
"lady's most sincere gratitude for your loyalty to our alliance, as well as "
"the wisdom you showed in your decision.\""
msgstr ""
"\"자만디 공은 올렉의 교역소에서 세금을 걷지 않겠다는 당신의 {d|c21 Left OTP}결정{/d}을 진심으로 기뻐했습니다. 여기, "
"{g|oleg_leftforbrevoy}편지{/g}가 왔습니다. 또한 저는 그녀로부터 당신의 동맹에 대한 충성심과 당신의 결단에서 보여준 "
"지혜에 대해 진심으로 감사한다는 뜻을 전해달라는 부탁을 받았습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91287_Text
#. Speaker : Capital_Shandra
msgctxt "2e9a01d3-fe01-49ae-a4aa-41eac746bbde"
msgid ""
"\"Lady Jamandi, in her typical sensationalist manner, expresses her extreme "
"dissatisfaction with your decision to take Oleg's Trading Post from "
"{g|Restov}Restov{/g}. Here's {g|oleg_secured}the letter{/g} — I hope you "
"enjoy the wording.\""
msgstr ""
"\"자만디 공은, 그녀가 문제에 대응하는 평소 방식대로, {g|Restov}레스토프{/g}로부터 올렉의 교역소를 강탈한 결정에 대해 깊은 "
"유감을 표현했습니다. 여기 {g|oleg_secured}편지{/g}가 도착했습니다 — 내용을 즐기시길 바랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91288_Text
#. Speaker : Capital_Shandra
msgctxt "a7238521-82b6-44f5-8981-55bac4758437"
msgid ""
"\"Lady Jamandi is, to put it lightly, puzzled by your request for "
"{g|Restov}Restov{/g} to surrender Oleg's Trading Post. She's demanding "
"compensation — not only in gold, but also in form of repairing a road from "
"the Trading Post to Restov. Go ahead and {g|oleg_forgiven}read it{/g} — it's "
"marvelous.\""
msgstr ""
"\"자만디 공은, 간단히 말하자면, {g|Restov}레스토프{/g}가 올렉의 교역소를 포기하길 원하는 당신의 요청에 의문을 "
"표현했습니다. 그녀는 보상을 요구하고 나섰습니다 — 금화뿐만 아니라, 교역소에서 레스토프까지 이어지는 도로의 수리 비용까지 말입니다. "
"당신께서 읽어보셔야 할 {g|oleg_forgiven}편지{/g}입니다 — 뻔뻔하더군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91289_Text
#. Speaker : Capital_Shandra
msgctxt "e35b77cf-f90e-41cf-a624-c6388f171192"
msgid ""
"\"Lady Jamandi has written a {g|oleg_leftforbrevoy}whole two lines{/g} "
"expressing her gratitude for deciding to not take back taxation rights for a "
"trading post located in your own lands. How typical of the Aldori!\""
msgstr ""
"\"자만디 공은 {g|oleg_leftforbrevoy}단 두 줄{/g}짜리 편지로 당신의 영지에 위치한 교역소로부터 세금 걷을 권리를 "
"포기한데 대해 감사 인사를 전했습니다. 어찌나 전형적인 알도리인지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91303_Text
#. Speaker : Capital_Kassil
msgctxt "8ed80375-9682-4b81-92d9-8c6ae9fc6a4f"
msgid ""
"{n}Kassil's face brightens.{/n} \"I'm glad to hear that you still value the "
"friendship of the Aldori, Your Grace. {g|Restov}Restov{/g} is bound to "
"accept a financial compensation.\""
msgstr ""
"{n}카실(Kassil)의 표정이 밝아졌습니다.{/n} \"저는 알도리 가문과의 우정을 여전히 높게 평가하신다는 이야기에 기쁩니다, "
"전하. {g|Restov}레스토프{/g}는 재정적 배상금을 받아들일 의무가 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91304_Text
#. Speaker : Capital_Shandra
msgctxt "cf6a1053-7ad2-4bda-9efb-e596a35d5d10"
msgid ""
"\"What, you've decided to go back on the issue after all?\" {n}Shandra "
"purses her lips.{/n} \"Well then. I suppose sending Jamandi a few coppers "
"might help settle her down, at least.\""
msgstr ""
"\"뭐라고요, 그 문제를 다시 논의하기로 결정하셨습니까?\" {n}샨드라는 입술을 삐죽 내밉니다.{/n} \"그러시겠다면. 최소한, 동전 "
"몇 푼 쯤 던져주면, 자만디가 화를 가라앉히는데 도움이 될 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91305_Text
#. Speaker : Capital_Kassil
msgctxt "e3546714-d910-4cb2-b085-528bc83aed3a"
msgid ""
"\"I cannot adequately express my worry over this decision, Your Grace. I can "
"only repeat myself: it is unwise to squander one's friends.\""
msgstr ""
"\"이번 결정에 대한 걱정을 자제할 수가 없습니다, 전하. 한 번만 다시 간언하겠습니다: 당신의 친구를 버리는 일은 현명한 처사가 "
"아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91306_Text
#. Speaker : Capital_Shandra
msgctxt "227b53c1-085d-4592-b1d2-1a19e199e138"
msgid "\"Hard times call for hard measures.\" {n}Shandra nods in approval.{/n}"
msgstr "\"어려운 시기에는 힘든 결정을 내려야합니다.\" {n}샨드라는 동의의 뜻으로 끄덕입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91307_Text
#. Speaker : Capital_Kassil
msgctxt "8a372e06-44f7-4ab1-a280-2917b763fd30"
msgid ""
"{n}Kassil sighs.{/n} \"I would advise you to not put on a show in a matter "
"where honesty would be both more appropriate and more profitable. However, "
"the matter is yours to decide. Your lands, your roads.\""
msgstr ""
"{n}카실이 한숨을 쉽니다.{/n} \"정직한 쪽이 양 측 모두에게 더 적절하고 이득이 되는 상황이니, 굳이 보여주기식 처리를 하지 "
"말아달라 조언드리고 싶습니다. 하지만, 당신께서 결정하실 일입니다. 당신의 땅이고, 당신의 길이니.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91308_Text
#. Speaker : Capital_Shandra
msgctxt "7b5dbd17-a161-4147-951c-d9121ab09619"
msgid ""
"\"I did warn you that the Aldori would find a way to turn a profit on this "
"issue, didn't I? In politics, softness is always taken as weakness.\""
msgstr ""
"\"제가 전에 알도리쪽은 이 문제에서 이득을 볼 방안을 찾을거라 주의드렸습니다, 안그랬나요? 정치판에서, 관대함은 항상 약점이 되어 "
"돌아온답니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91311_Text
#. Speaker : Capital_Kassil
msgctxt "a22dc95e-64d2-44c7-8f76-9439912067da"
msgid ""
"\"My pleasure, Your Grace. The new road will increase trade with "
"{g|Restov}Restov{/g}, which should profit everyone involved.\""
msgstr ""
"\"천만의 말씀입니다, 영주님. 개척된 도로는 {g|Restov}레스토프{/g}와의 교역을 활발화시킬겁니다. 모두가 이익을 얻게 되겠지요."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91312_Text
#. Speaker : Capital_Shandra
msgctxt "72478c85-27e5-48d9-a6b2-08f247ee37ac"
msgid ""
"\"Half-measures.\" {n}Shandra winces.{/n} \"It would have been easier to "
"just give Jamandi a slap on the wrist at the start. But this will do as well."
"\""
msgstr ""
"\"미봉책이라.\" {n}샨드라가 움찔합니다.{/n} \"시작부터 자만디에게 모든 책임을 전가하는게 더 쉬울 수 있겠지만, 그런 접근법도 "
"괜찮을것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91313_Text
#. Speaker : Capital_Shandra
msgctxt "d28c40fe-a00c-4068-95b4-8ed983d3e20c"
msgid ""
"\"Some allies can become a stone tied around one's neck. Nevertheless, if "
"you wish to play nice with Lady Jamandi, I can simply shrug my shoulders.\""
msgstr ""
"\"우리 동맹 중 일부가 당신의 목에 걸린 돌덩이가 되었습니다. 그럼에도 불구하고, 당신이 자만디 공과 친하게 지내고 싶으시다면 제가 할 "
"수 있는건 어깨를 으쓱하는것 말곤 없겠군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91314_Text
#. Speaker : Capital_Shandra
msgctxt "7658f1a7-0b1a-4fb9-8332-d61331caf694"
msgid "\"That should prove useful to our friends in {g|Restov}Restov{/g}.\""
msgstr "\"{g|Restov}레스토프{/g}에 있는 우리 친구들에게도 유용할겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91318_Text
#. Speaker : Capital_Kassil
msgctxt "cec46d1a-6264-4c18-9e19-582d68530ae0"
msgid ""
"\"Just as the {g|Swordlords}Swordlords{/g} value you and your friendship. "
"You can rest assured of that.\""
msgstr ""
"\"{g|Swordlords}소드로드{/g}가 당신과의 동맹에 매기는 가치와 같은 무게입니다. 당신께서도 이젠 확신하실 수 있으실 겁니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91319_Text
#. Speaker : Capital_Kassil
msgctxt "299fca44-0c07-4a28-98bf-558670d842ac"
msgid ""
"\"If it's so important to you... I'll send a letter to {g|Restov}Restov{/g} "
"suggesting they repair the road leading to Oleg's Trading Post. Both sides "
"should benefit from that.\""
msgstr ""
"\"그것이 당신께 그렇게 중요하시다면... {g|Restov}레스토프{/g}로 전령을 보내 올렉의 교역소와 이어지는 도로를 고칠 것을 "
"제안하겠습니다. 양 측 모두에게 이득이 될겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-OlegSecond/Cue_91320_Text
#. Speaker : Capital_Shandra
msgctxt "829a57ef-be29-4b1d-8bca-bf4ba1a90352"
msgid ""
"\"I strongly recommend you find some way to rip her off, just to return the "
"favor.\""
msgstr "\"저는 자만디에게 바가지를 씌울 방안을 모색하시길 강력히 권합니다, 받은 만큼 돌려줘야죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_18491_Text
msgctxt "3676b47e-d72b-4ad0-a6bc-dca773d30d82"
msgid ""
"\"I don't like the direction this conversation is taking. We'll speak again "
"later.\""
msgstr "\"이 대화가 진행되는 방향이 마음에 들지 않습니다. 다음에 다시 이야기하죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_68453_Text
msgctxt "72cdfc9f-7a68-4dbd-954b-0c2b7fc504af"
msgid "\"What brings a Pitaxian noble to my barony?\""
msgstr "\"피탁스의 귀족께서 우리 영지에 무슨 일로 오셨을까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_78913_Text
msgctxt "bf6d7fb7-e776-406a-8b60-7ef2277b1b79"
msgid ""
"\"Ah, yes — King Irovetti. Worry not. I'll be sure I send him a melancholic "
"missive relaying news of your tragic fate.\""
msgstr ""
"\"아, 그래. 이로베티 왕. 걱정하지 말라. 나는 그에게 너의 비참한 운명을 알리기 위해 음울한 서신을 보낼 것을 약속하마.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_82592_Text
msgctxt "79fd16e1-6428-4dd9-ac3e-d29f68810a00"
msgid ""
"\"Now, allow me to — personally — tax your cortege, so as to help improve my "
"economy. And as taxes are especially high this year, I do hope you'll be "
"able to pay — the punishment for failure to pay is imprisonment.\""
msgstr ""
"\"이제, 내가 '개인적'으로 내 장례행렬에 세금을 거둘 수 있게 해주게, 내 경제 상황을 보다 풍족하게 도움이 되게 말이지. 그리고 "
"이번 해에는 특별히 세율이 높다네, 자네가 낼 수 있기를 바라지. 세금을 내지 않는 것에 대한 처벌은 투옥이거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_87492_AlignmentShift.Description
msgctxt "d6dc602d-ddab-41e0-8048-c10b97afeb6f"
msgid "Put the rude Pitaxian guest in his place."
msgstr "무례한 피탁스의 손님을 그에 맞는 곳에 넣었습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_87492_Text
msgctxt "bf2c6da9-fc64-4490-957a-f5dd9db037f7"
msgid ""
"\"Sir Stefano, please be frank with me — have you ever had the pleasure of "
"being acquainted with the hooves of a jackass? Other than your own feet, I "
"mean.\""
msgstr ""
"\"스테파노 공, 솔직히 대답해주시오 — 혹시 당나귀 발굽에 대해 알아보는 기쁨을 누리고 싶지 않소? 당신 발 애기는 아니오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_89722_Text
msgctxt "b1cadce0-5cd2-41f3-8a13-9fb2b49a9019"
msgid "\"What news of Pitax?\""
msgstr "\"피탁스에는 어떤 새로운 소식이 있나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98143_AlignmentShift.Description
msgctxt "3749d07e-6f99-4910-8292-4edcc2af02a5"
msgid "Met the Pitaxian guest's insult with an insult of your own."
msgstr "피탁스 손님의 모욕에 똑같이 모욕으로 응대했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98143_Text
msgctxt "d69e5470-08f5-4e3a-994d-a9a4467ed8ad"
msgid ""
"\"I'd watch my tone, were I you, lest I send you back to Pitax sooner than "
"you'd planned.\""
msgstr "\"계획했던 것보다 빨리 피탁스로 돌아가고 싶지 않다면 말조심하는게 좋을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98144_AlignmentShift.Description
msgctxt "011ff0a9-bbf7-41da-b3aa-cab78479d875"
msgid "Threatened to kill the Pitaxian guest for his rudeness."
msgstr "피탁스에서 온 손님의 무례함에 대해 죽이겠다 위협했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98144_Text
msgctxt "45ae6cdb-d152-428c-ae38-b4fbf5f2ec00"
msgid ""
"\"I'd watch my tone, were I you, lest I send you back to Pitax in a box — or "
"perhaps several boxes.\""
msgstr "\"상자 속에 담아 피탁스로 돌려보내기 전에 말조심하는게 좋을 겁니다. 어쩌면 하나가 아니라 여러개 상자일수도 있겠죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98145_Text
msgctxt "05b964ad-b7d8-417d-9b3b-709dff8751cc"
msgid ""
"\"Yes, the tragic fate you met after attempting to escape your chains. Now, "
"if there's nothing more, I'd suggest you go replaster your face with "
"whatever makeup you've been using — your cheeks are so bright, the red glow "
"must be visible from Absalom.\""
msgstr ""
"\"그래, 너의 사슬에서 벗어나려고 시도한 끝에 마주한 비극적 운명이군. 이제, 더 할 게 없다면, 뭘로 한건지는 모르겠지만 너의 화장을 "
"다시 하는 걸 추천하지. 네 놈의 볼을 너무 밝고 붉게 빛나서 압살롬에서도 보일만 하거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98152_AlignmentShift.Description
msgctxt "76096759-1407-4de7-aaf7-f7f6da0b5b84"
msgid "Reacted moderately to the Pitaxian guest's rudeness."
msgstr "피탁스에서 온 손님의 무례에 부드럽게 대응했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98152_Text
msgctxt "81492b70-11e3-443c-944e-5b8e12b1ffaa"
msgid ""
"\"A five-year-old could tell you're deliberately trying to offend me, Sir "
"Stefano. Perhaps you could just tell us directly what it is you came here "
"for?\""
msgstr ""
"\"다섯살짜라도 당신이 날 모욕하려고 한다는 걸 말할 수 있습니다, 스테파노 경. 여기 온 목적이 무엇인지 솔직히 말할 수도 있지 "
"않겠습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98153_AlignmentShift.Description
msgctxt "c5e5ea84-dd4b-475a-a645-8b0e0002ce2b"
msgid "Told the Pitaxian guest that you are always open to fair criticism."
msgstr "피탁스에서 온 손님에게 당신은 항상 정당한 비판을 받아들일 수 있다고 말했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98153_Text
msgctxt "24be8ade-5a04-4050-a4c1-6d182195fd0e"
msgid "\"I'm always open to criticism, so long as it's fair and reasonable.\""
msgstr "\"공정하고 합당하다면 나는 언제나 비판을 받아들일 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98155_AlignmentShift.Description
msgctxt "2a30bcaf-dc86-4f88-bee5-ba868ef93bd5"
msgid "Gently answered the Pitaxian guest's criticism."
msgstr "피탁스에서 온 손님의 비판에 부드럽게 답했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98155_Text
msgctxt "2c28e9eb-1468-48f9-9212-bbbb0d0e72e4"
msgid ""
"\"Perhaps there's a touch of truth to your words, but my barony is still "
"very young. Everything will be different soon.\""
msgstr "\"당신이 한 말이 사실일지라도 나의 남작령은 아직 매우 젊습니다. 모든 것은 곧 바뀔 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98156_AlignmentShift.Description
msgctxt "49d29eb4-e7f9-4f8b-81be-8c747fb8387a"
msgid "Threatened to kill the Pitaxian guest for being rude."
msgstr "피탁스에서 온 손님이 무례하게 군 것에 죽이겠다 위협했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98156_Text
msgctxt "60e7cc8c-ec36-44cb-be98-c7ddc5699cfd"
msgid "\"Another word and I'll send you to the gallows.\""
msgstr "\"한 마디만 더 하면 널 교수대로 보낼 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98158_AlignmentShift.Description
msgctxt "cad769ab-8352-42e8-8d2a-c81771aa948c"
msgid "Responded moderately to the Pitax guest's rude criticism."
msgstr "피탁스에서 온 손님의 무례한 비판에 적당히 응했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98158_Text
msgctxt "b68db8b2-a447-4f38-ac2f-3e7c48690471"
msgid ""
"\"No matter how weak my barony may be, you have no right to speak to me in "
"such a tone.\""
msgstr "\"나의 남작령이 얼마나 미약하건 간에, 당신은 나에게 그런 식으로 말할 수 없소.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98159_Text
msgctxt "44cda5e2-88bb-4525-9881-e383dfe7f8aa"
msgid "\"I hope you've taken the hint. Get out.\""
msgstr "\"당신이 일말의 눈치를 차렸으면 좋겠군. 나가시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98160_Text
msgctxt "fe9091a7-b46c-47a2-8016-b82450d829e5"
msgid "\"Run along, then — go back and cry in your king's lap. Move along.\""
msgstr "\"뛰어, 돌아가서 너의 왕의 무릎 위로 올라가 실컷 울라고. 움직여.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Answer_98162_Text
msgctxt "6ae76810-6239-44a7-bcc3-5425a2f61a4b"
msgid "\"I'll leave that to your imagination. This audience is over.\""
msgstr "\"당신의 상상에 맡기겠소. 접견은 이제 끝났소.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_00270_Text
#. Speaker : Capital_Stefano
msgctxt "005ab4a9-f082-4a07-bf97-d10327071ef8"
msgid "{n}Sir Stefano opens his mouth, then immediately closes it.{/n}"
msgstr "{n}스테파노경은 입을 열려 했다가, 금새 다물어 버렸습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_11459_Text
#. Speaker : Capital_Stefano
msgctxt "667eacdd-7dfd-40f0-a2b8-382eb32fe64a"
msgid ""
"\"Life in {g|Pitax}Pitax{/g} is splendid, thank you! All thanks to the work "
"of my king and sovereign, Castruccio Irovetti. Our city definitely prospers."
"\" {n}Sir Stefano grins, staring unabashedly into your eyes.{/n} \"A stark "
"contrast to your own crumbling hamlet.\""
msgstr ""
"\"{g|pitax}피탁스{/g}에서의 삶은 훌륭합니다, 감사하죠! 나의 왕이시자 통치자이신 카스트루치오 이로베티 전하의 업저에 감사할 "
"따름입니다. 우리의 도시는 확실하게 번영하고 있습니다.\"{n}스테파노 경은 미소를 띄고 당신을 당당한 눈길로 응시합니다.{/n} "
"\"당신의 무너져 가는 조그만 마을과는 완벽한 대조로군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_21090_Text
#. Speaker : Capital_Stefano
msgctxt "fe008dc6-cb2c-46cc-b1b0-fb743d35cf2e"
msgid ""
"\"What do you mean? A noble dignitary from a neighboring state visits your "
"capital — a close friend to King Castruccio Irovetti, at that — and you "
"can't make time for a short conversation? A true host would never think to "
"treat their guests so.\" {n}Sir Stefano grins, staring unabashedly into your "
"eyes.{/n} \"Indeed, this hamlet seems to be faring even more poorly than I'd "
"initially suspected.\""
msgstr ""
"\"무슨 말입니까? 이웃국가로부터 귀족 고위관리가 당신의 수도을 방문했습니다. 카스트루치오 이로베티 왕의 가까운 친구가요. 그런데 당신은 "
"짧은 대화를 나눌 시간조차 못 내겠다는겁니까? 진정한 주인이라면 그 손님을 그렇게 대하지 않는 법입니다.\"{n}스테파노 경은 미소지으며 "
"당당히 당신의 눈을 노려보았습니다.{/n}\"물론, 이 비참한 조그만 마을은 내가 처음에 생각했던 것보다는 훨씬더 비참하게 보이지만 "
"말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_21268_Text
#. Speaker : Capital_Stefano
msgctxt "25d04c01-4158-4bbe-8e2b-58d0e2dc194f"
msgid ""
"\"Nothing. You have absolutely nothing to offer.\" {n}Sir Stefano continues "
"on without giving you a chance to respond.{/n} \"Military — weak. Culture — "
"weak. Economy — weak. You'd best pray to all the gods that my King Irovetti "
"doesn't declare war on you. On the other hand, maybe you should pray he "
"conquers you — this mess of a barony could use the rule of a proper king.\""
msgstr ""
"\"아무것도. 당신이 제공할 만한 것은 아무것도 없습니다.\"{n}스테파노 경은 당신이 답할 기회를 주지않고 계속했습니다.{/n}\"군사"
", 부실함. 문화, 부실함. 경제, 부실함. 당신은 모든 신들께 나의 이로베티 왕께서 당신에게 전쟁을 선포하지 않게끔 해달라고 기도하는 "
"것이 좋을 겁니다. 다른 한편으로는, 어쩌면 당신은 그가 당신을 정복해달라고 바라는게 나을 수도 있겠군요. 이 엉망진창인 남작령 따위는 "
"차라리 정당한 왕의 지배를 필요로 할 테니 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_25215_Text
#. Speaker : Capital_Stefano
msgctxt "274d0129-805d-4969-928d-f7b1cb39a68a"
msgid ""
"\"And now we resort to insults. Hardly surprising.\" {n}Sir Stefano lets out "
"a long sigh, tapping his rapier.{/n} \"Well, you aren't worth the glove it "
"would take to challenge you. Besides, you'd probably just run off and hawk "
"it — it's easily worth twice what you've got in this throne room.\""
msgstr ""
"\"이제 우리는 모욕에 의지하는 군요. 놀랍지도 않습니다.\"{n}스테파노 경은 긴 한숨을 내쉬고는 그의 레이피어를 툭 쳤습니다.{/n}"
"\"음, 당신에게 도전하기 위해 장갑을 던질 가치조차 없지요. 거기에다 당신은 그저 도망쳐서는 떠들고 다닐거 아니겠습니까. 그게 당신이 "
"이 왕좌의 방을 지키고 있는 것보단 두 배는 가치있겠군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_35268_Text
#. Speaker : Capital_Stefano
msgctxt "127ead89-4135-488d-adf3-70e2e0d8d5c6"
msgid ""
"\"Well, then, I'll gladly give you my report.\" {n}Sir Stefano's voice takes "
"on a condescending tone.{/n} \"Follow along on your fingers, assuming you "
"can count. One — your army is weak. You lack the guards to properly defend "
"your lands, so you must choose between the villages, the towns, and the "
"trade routes.\""
msgstr ""
"\"그렇다면, 기꺼이 제 보고를 올리죠.\"{n}스테파노 경의 목소리가 거들먹거리기 시작했습니다.{/n}\"셀 수 있다면, 손가락으로 셈 "
"해가시지요. 첫째, 당신의 군대는 약합니다. 영토를 방어하기에 적절한 경비대가 부족하여 마을, 소도시와 교역로 중 어떤 곳을 방어할지를 "
"골라야만 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_36625_Text
#. Speaker : Capital_Stefano
msgctxt "802c8fb9-da88-4425-8d1c-16c04bab9982"
msgid ""
"{n}As he approaches, a mean, sly smile appears on his face — clearly "
"practiced and prepared in advance.{/n} \"Ah, the ruler of this 'barony.' I'm "
"flattered by your attention. Sir Stefano Moskoni of {g|Pitax}Pitax{/g}, at "
"your service.\" {n}The man performs a derisive bow.{/n}"
msgstr ""
"{n}스테파노 경이 능글맞은 미소를 지으며 다가옵니다. 사전에 연습이라도 해본 듯한 교활한 표정이 만면에 떠오릅니다.{/n}\"아, "
"'남작령'의 통치자시군요. 이리도 신경 써주시니 몸 둘 바를 모르겠습니다. {g|pitax}피탁스{/g}의 스테파노 모스코니, 부름에 "
"대령했습니다.\"{n}남자는 조롱하듯 허리를 숙입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_40808_Text
#. Speaker : Capital_Stefano
msgctxt "c0fd6eaf-446d-4010-acaf-000910f5ff73"
msgid ""
"\"Oh, I'll be on my way, don't you worry. If I were to stay any longer, I "
"fear I might pick up fleas, or lice, or whatever else passes for subjects in "
"this place. Take care! No need to see me off.\""
msgstr ""
"\"오, 제 갈 길을 갈 것이니, 걱정 마시지요. 여기 더 오래 머물다간, 벼룩이나 이, 아니면 이곳의 백성이 되기 위한 어떤 것이든지에 "
"물릴까 걱정되니까요. 건강하시길! 바래다 줄 필요는 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_45578_Text
#. Speaker : Capital_Stefano
msgctxt "153a0759-e7f1-49c8-a948-4762d34e3d55"
msgid ""
"\"Two — your economy is a shambles. You have to personally resolve an issue "
"of tax collection from some lowly inn — and it seems your treasury even "
"depends upon this handful of coins.\""
msgstr ""
"\"두번째, 경제가 엉망진창입니다. 당신은 질 낮은 몇몇 여관으로부터 세금 징수 문제를 해결해야 합니다. 그리고 심지어 당신네 국고는 이 "
"동전 한 줌에 의지하는 것 같더군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_56193_Text
#. Speaker : Capital_Stefano
msgctxt "dc7b5367-18c3-4d21-bab6-2c41b75b0054"
msgid ""
"{n}The man before you reeks of vanity. His black hair is curled, styled, and "
"generously waxed, from the hair atop his head to the points of his "
"moustache. His cheeks and forehead are powdered white, giving him a pallid "
"look. His hand rests casually on the golden hilt of his rapier.{/n}"
msgstr ""
"{n}당신 앞의 남자에게선 자만심이 풍겨납니다. 그의 검은 머릿결은 그의 머리 꼭대기부터 그의 콧수염에 이르기까지 풍성하고 잘 정돈되어 "
"있으며, 후하게 왁스를 발라 두었습니다. 그의 양 볼과 이마에는 흰 칠이 되어 있어 그에게 창백한 모양새를 내줍니다. 그의 손은 그의 "
"레이피어의 황금 자루위에 느긋히 올려져 있습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_56367_Text
#. Speaker : Capital_Stefano
msgctxt "7c4cb2c2-3bb0-40fa-8187-19f6a4d1e4fc"
msgid ""
"{n}Sir Stefano, furious, starts to speak.{/n} \"My king will not stand for-\""
msgstr "{n}스테파노 경은 분노해서 말하기 시작했습니다.{/n}\"나의 왕께서는 그냥 두고 넘어가지 않으실거요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_58807_Text
#. Speaker : Capital_Stefano
msgctxt "c40ea05f-88cd-4fee-91bd-309d92be4eb8"
msgid ""
"\"I was just traveling back home to glorious {g|Pitax}Pitax{/g} after paying "
"a visit to {g|Restov}Restov{/g} — all in service to King Castruccio "
"Irovetti. I thought I might take a day to visit the capital of "
"{g|Pitax}Pitax{/g}'s bold new neighbor...\" {n}Sir Stefano sniffs, then "
"grins.{/n} \"I must say, I really should have spared myself the trouble. "
"It's hardly worth seeing.\""
msgstr ""
"\"{g|Restov}레스토프{/g}를 방문한 뒤에 아름다운 {g|pitax}피탁스{/g}의 집으로 돌아가려 여행하던 중이었습니다. 모두 "
"카스트루치오 이로베티 전하께 봉사하기 위함이지요. 하루 정도 {g|pitax}피탁스{/g}의 대담한 새 이웃의 수도에 머물 수 있을 거라 "
"생각했지요...\"{n}스테파노 경은 코를 훌쩍이더니 미소를 지었습니다.{/n}\"정말로 수고를 덜었다고 말해야만 겠군요. 이곳은 볼 "
"가치가 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_64248_Text
#. Speaker : Capital_Stefano
msgctxt "b6a2c7b2-ed78-4b4d-9992-d52e0d5835cc"
msgid "\"Wha-\" {n}Sir Stefano pauses mid rant.{/n} \"My... tragic fate?\""
msgstr "\"뭐!\"{n}스테파노 경은 고함을 치다 잠시 멈추었습니다.{/n}\"내...비극적인 운명이라고?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_65235_Text
#. Speaker : Capital_Stefano
msgctxt "85dd57d8-26d9-44ff-8037-9cf87986cb37"
msgid ""
"{n}Sir Stefano stares at you and snorts.{/n} \"You know, the initial goal of "
"my visit was to take measure of your so-called 'barony,' to see if you had "
"anything of value to offer to {g|Pitax}Pitax{/g}. And do you know what I "
"found?\""
msgstr ""
"{n}스테파노 경은 당신을 노려보더니 코웃음을 쳤습니다.{/n}\"아시다시피, 제 방문의 최초 목적은 당신네들이 소위 말하는 '남작령'을 "
"평가해서 {g|pitax}피탁스{/g}에 제공할만한 가치있는 것이 있는지를 보는 것이었습니다. 그리고 제가 무엇을 찾아냈는지 아십니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_98142_Text
#. Speaker : Capital_Stefano
msgctxt "5f597d01-e84b-40b6-a22a-f7c15c7f127a"
msgid ""
"\"And three — your culture is... well, nonexistent, really. What do you even "
"have? No art galleries. No universities.\" {n}Sir Stefano waves his hand "
"dismissively.{/n} \"Your capital may as well be a cowshed, with you a donkey "
"sitting atop a heap of hay.\""
msgstr ""
"\"그리고 세번째, 당신네의 문화는...음, 정말로, 존재한다고 볼 수 없지요. 무엇이 있습니까? 미술관도 없습니다. 대학도 없지요.\""
"{n}스테파노 경은 무시하듯 손을 흔들었습니다.{/n}\"당신네 수도는 흡사 건초더미 위에 당나귀 한 마리만 앉아있는 외양간과도 같습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_98147_Text
#. Speaker : Capital_Stefano
msgctxt "2f7a4c1c-2e01-406c-a95b-67f162ddcb77"
msgid "\"I... I'll take my leave now.\""
msgstr "\"저는...저는 지금 바로 가봐야겠군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_98157_Text
#. Speaker : Capital_Stefano
msgctxt "2d8ca749-aee2-4bfe-9534-50f7b8f0f258"
msgid ""
"\"If anything ever changes here, it'll be the number of dung flies — and "
"that will only grow. Ah, well, I shan't continue this slaughter — no use "
"battling someone who can't even fight back. All the best!\" {n}Sir Stefano "
"performs a mocking bow.{/n}"
msgstr ""
"\"이 곳에서 바뀌는 게 있다면 고작 똥파리의 숫자겠군요. 그건 계속 늘어갈테지요. 아, 그렇군, 제가 이처럼 도륙내는 걸 계속할 필요는 "
"없지요. 맞서 싸우지 않는 사람과 싸워봤자 소용이 없지 않겠습니까. 안녕히 계시길!\"{n}스테파노 경은 조롱하듯 인사하였습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-StefanoOfPitax/Cue_98163_Text
#. Speaker : Capital_Stefano
msgctxt "ef8f577c-9104-4786-929f-0ee30a313aab"
msgid ""
"\"Indeed, what was I thinking? What value could there be in speaking to "
"someone who can barely understand the words of an educated noble? I've "
"learned what I wished to know — I bid you farewell.\""
msgstr ""
"\"정말, 내가 무슨 생각이었는지 원? 교육받은 귀족의 말을 겨우 알아듣는 사람에게 이토록 말하는 게 무슨 가치가 있겠습니까? 제가 "
"알고자 했던 것은 모두 알았습니다. 이만 가보도록 하지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-VarnSaysHello/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "e3a34ed8-eaf3-443a-ab2a-1c8895c7c044"
msgid ""
"\"Great news, Your grace! {d|Varn}Maegar Varn{/d}, lord of Varnhold, wants "
"to form an alliance with you and establish a trade route between your lands. "
"Here is {g|VarnHello}Lord Varn's letter{/g}, see for yourself!\""
msgstr ""
"\"좋은 소식입니다, 전하! 반홀드의 영주 {d|Varn}메이가르 반{/d}이 당신과 동맹하기를 원하며 두 땅 사이에 교역로를 건설하고자 "
"합니다. 여기 {g|VarnHello}반 남작의 편지{/g}입니다. 읽어보시지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-VarnSaysHello/Cue_0002_Text
#. Speaker : Capital_Shandra
msgctxt "794562d8-462c-4821-acb6-e6f4b0c1ddc8"
msgid ""
"\"Good day, Your grace. A courier has delivered a {g|VarnHello}letter{/g} "
"from {d|Varn}Maegar Varn{/d}, the ruler of the colony to the east of our "
"capital. If the messenger's words are to be believed, he has a lucrative "
"offer for you: he wants to establish a trade route between your realms.\""
msgstr ""
"\"좋은 날입니다, 전하. 배달부가 우리 수도 동쪽 식민지의 통치자인 {d|Varn}메이가르 반{/d}으로부터 "
"{g|VarnHello}편지{/g}를 전달해 왔습니다. 전령의 말을 믿을 수 있다면 그는 당신에게 유리한 제안을 해 왔습니다. 그는 "
"당신의 영토와 교역로를 건설하기를 바랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-VarnSaysHello/Cue_0003_Text
#. Speaker : Capital_Lander
msgctxt "5023b13f-af54-4af7-b734-f4d4d9b5bfb8"
msgid ""
"\"Oh, look: {g|VarnHello}a letter for you{/g}! Looks like it's from one of "
"the go-getters doing Aldori's bidding. Have you ever heard of a {d|Varn}"
"Maegar Varn{/d}? No? That's funny — he sure knows a lot about you. Enough to "
"try to sweet talk you into building a trade route.\""
msgstr ""
"\"오, 봐봐. {g|VarnHello}당신에게 온 편지야{/g}! 알도리의 명령을 받는 놈들 중 하나가 보낸것 같군. {d|Varn}"
"메이가르 반{/d}에 대해 들어 본 적 있나? 없다고? 재밌군. 그는 너에 대해 많이 알테니 말야. 교역로를 건설하게 만들 만큼 아주 "
"달콤한 말들이 적혀있더군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-VarnSaysHello/Items/VarnSaysHelloLetter_Name_String
msgctxt "eae2a5ff-0184-46be-8a7b-793274b4a4fc"
msgid "Maegar Varn's Letter"
msgstr "메이가르 반의 편지"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21-VarnSaysHello/Items/VarnSaysHelloLetter_String
msgctxt "26a41d97-2079-441c-a2aa-de0aa8f5a7df"
msgid ""
"\"Most Honorable {mf|Baron|Baroness} {name}!\n"
"This is Maegar Varn, the ruler of the neighboring city of Varnhold, writing. "
"You might remember meeting me at the reception — our encounter had a "
"powerful effect on me. You are a brave warrior and a wise ruler, which is "
"why I hope to enlist your support and, in the future, form a firm "
"friendship. No matter whether the gods or the Swordlords have contributed to "
"us becoming neighbors, I believe that our alliance will be as steadfast as a "
"rock.\n"
"To signify the formation of our alliance, I invite you to visit Varnhold and "
"see for yourself that my intentions are good. The city is still young, but "
"we have a lot to show our guests. Our cellars are full of wine barrels, and "
"our storehouses of grain and cheese. It is easy to reach my city: the path "
"to Varnhold lies in the east, past Lake Silverstep, and over the ridge of "
"the Tors of Levenies. Hard to get lost in these parts.\n"
"Whether you accept my invitation or not, I ask of you one more thing: "
"consider building a route and developing trade between our lands. I am "
"convinced that both of us would only benefit from this union.\n"
"I anxiously await your visit.\n"
"Respectfully yours,\n"
"Baron Maegar Varn\""
msgstr ""
"\"가장 명예로운 {mf|남작|여남작} {name}!\n"
"이웃하는 도시 반홀드의 통치자 메이가르 반이오. 연회에서 만났었던 것을 기억할지 모르겠소. 우리 만남은 나에게 중대한 영향을 끼쳤지. "
"당신은 용감한 전사이자 현명한 통치자이며, 그래서 나는 당신의 지지를 얻고자 희망하며 장래에는 굳건한 우정을 다지고 싶소. 신들께서나 "
"소드로드들이 우리가 이웃하게끔 하는데에 어떠한 영향을 미쳤던 간에, 나는 우리의 동맹이 바위와 같이 굳건해 지리라 믿소.\n"
"우리의 동맹이 형성되었음을 나타내기 위해 당신을 반홀드에 초대하여 내 의도가 선하다는 것을 당신 스스로 확인해 주었으면 하오. 도시는 "
"아직 작지만 우리 손님에게 보일 것은 많다오. 우리의 지하창고에는 와인통이 가득하고, 곡물과 치즈 창고 또한 있다오. 우리의 도시에 오는 "
"길은 간단하오, 실버스텝 호수를 지나, 레베니스 바위산맥(Tors of Levenies)의 산등성이를 넘어 동쪽으로 놓인 길이 반홀드로 "
"오는 길이라오. 길을 잃을 염려가 없지.\n"
"나의 초대를 받아주던 혹은 그렇지 않던 한 가지 더 질문할 것이 있소. 우리들의 땅 사이에 교역로를 놓고 무역을 발전시키는 것이 "
"어떻겠소. 우리 모두 이러한 결합으로 이익을 볼 것이라는 것을 확신할 수 있소.\n"
"당신의 방문을 간절히 기다리겠소.\n"
"경의를 표하며,\n"
"남작 메이가르 반\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21_LinziComesBack/Cue_0001_Text
msgctxt "b5ba5834-0b70-44ed-8b98-a09117ee9083"
msgid ""
"\"Miss me?\" {n}Whistling to herself, Linzi enters the throne room. The bard "
"is thinner than you recall. She seems to have acquired a few scars, and her "
"clothes look no better than rags. Nevertheless, she seems as cheerful as "
"ever, and her smile as carefree.{/n}"
msgstr ""
"\"제가 그리웠나요?\"{n}휘파람을 부르며, 린지가 왕좌의 방에 들어섰습니다. 바드는 당신이 알던 것보다 말랐습니다. 그녀는 몇몇 "
"상처를 더 얻은 듯 보였고, 그녀의 옷가지는 누더기나 다름없었습니다. 그럼에도 불구하고, 그녀는 언제나처럼 기운 넘치고 그녀의 미소는 "
"근심이 비치지 않습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21_LinziComesBack/Cue_0002_Text
msgctxt "824f68b7-1002-4df5-a59a-e0cf4d5d612a"
msgid ""
"\"Well, I had quite an adventure in {g|Numeria}Numeria{/g}! Enough material "
"to fill a whole separate book, and then some! All those barbarians, metallic "
"monsters, {g|Technic League}Technic League{/g} agents... How I managed to "
"make it out, only {g|Shelyn}Shelyn{/g} knows!\""
msgstr ""
"\"음, {g|Numeria}누메리아(Numeria){/g}에서 대단한 모험을 했지요! 책 한 권 완성하고도 남을 만큼 소재를 잔뜩 "
"얻었어요! 바바리안, 금속 괴물, {g|Technic League}기술 연맹(Technic League){/g} 요원들... 제가 어떻게 "
"살아 나왔는지는 오직 {g|Shelyn}셸린(셸린){/g} 님만이 아실걸요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc21_LinziComesBack/Cue_0003_Text
msgctxt "8cc960c4-d3d9-468d-a022-34b99cffd4c0"
msgid ""
"\"So, how've things been here without me? Seems you've become a "
"baron{mf||ess}! You'll have to tell me later how you managed to defeat the "
"Stag Lord, and all the rest of your adventures. I'm starving for details! My "
"book isn't going to write itself, you know!\""
msgstr ""
"\"그럼, 저 없이 어떻게 지냈어요? {mf|남작|여남작}이 되신 것 같은데요! 나중에 저한테 어떻게 수사슴 군주를 패배시킬 수 "
"있었는지, 그리고 다른 모험들은 어땠는지 알려주세요. 자세하게 알고 싶어요! 아시다시피, 제 책이 저절로 써지는 건 아니거든요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Answer_0008_Text
msgctxt "73dbd96e-9876-4abe-b6e1-bb3a85096435"
msgid ""
"\"Who are these Embeth Travelers, and what would they ask for their help?\""
msgstr "\"이 엠베스 여행자는 누구이고, 무엇을 도와주겠다는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Answer_0009_Text
msgctxt "b3867ae2-5b30-40c2-b299-22525d7f6f3e"
msgid "\"Whom will we invite for the hunt?\""
msgstr "\"누구를 사냥에 초대할 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Answer_0010_Text
msgctxt "3fecd415-2118-4df6-b5f0-183e87aa64fa"
msgid "\"Why not invite Irovetti himself?\""
msgstr "\"이로베티를 직접 초대하는건 어때?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Answer_0011_Text
msgctxt "51948bea-edaf-40de-9dad-d7b0873949e1"
msgid "\"Aldori from Mivon? I thought Swordlords were from Brevoy.\""
msgstr "\"미본 출신 알도리? 나는 소드로드들은 브레보이 출신일꺼라 생각했어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Answer_0012_Text
msgctxt "ff8f232c-3292-4fd0-99ca-833e9c6ca4e5"
msgid "\"How would you describe the relations between Mivon and Pitax?\""
msgstr "\"미본과 피탁스 간의 관계는 어떻다고 생각하지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Answer_0013_Text
msgctxt "9b5eba29-42b5-4e5f-8c94-5156d9b92e2a"
msgid "\"Good idea. Invite the guests.\""
msgstr "\"좋은 생각이야. 손님들을 초대합시다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Answer_0014_Text
msgctxt "87f73019-de5c-4caf-b59f-29ec5f8d22f2"
msgid "\"We don't need external help. This is our issue to deal with.\""
msgstr "\"외부의 도움은 필요 없다. 이건 우리가 해결해야 할 문제야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "db00829b-c18b-4423-9d47-2a9ba72db556"
msgid ""
"\"I beg pardon for the intrusion, Your Grace, but I'm afraid I have bad "
"news. Magic beasts are attacking people across the country. No one know "
"where they come from, but if the situation continues to develop as it has, "
"it may pose a serious problem.\""
msgstr ""
"\"방해를 용서해 주십시오, 전하. 하지만 나쁜 소식이 있습니다. 환수들이 나라 곳곳에서 사람들을 공격하고 있습니다. 어느 누구도 그들이 "
"어디에서 왔는지 알지 못합니다만, 이 상황이 이대로 계속된다면 심각한 문제가 될지 모릅니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Cue_0002_Text
#. Speaker : Capital_Kassil
msgctxt "ca695afd-816f-4c41-ba40-d42d43097e75"
msgid ""
"\"Fortunately, there is good news as well. The {g|Embeth Travelers}Embeth "
"Travelers{/g} have offered their help to fight the monsters. I expect this "
"would be a good opportunity to invite some guests from neighboring countries "
"to join the hunt. Would you mind that?\""
msgstr ""
"\"다행스럽게도, 좋은 소식 또한 있습니다. {g|Embeth Travelers}엠베스 여행자{/g}가 괴물들과 싸우는 데 도움을 "
"주겠다고 제안했습니다. 이것은 이웃 국가 손님들을 몇명 초대하여 사냥에 동참시킬 수 있는 좋은 기회라고 생각됩니다. 어떠신지요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Cue_0003_Text
#. Speaker : Capital_Shandra
msgctxt "226d4b47-5506-4860-9ed4-9bd80fef87bb"
msgid ""
"\"Your Grace, we've received troubling reports. Magic creatures are "
"attacking your subjects at an increasingly alarming rate. No one knows where "
"they come from, but if we don't nip this in the bud, it could become a real "
"disaster.\""
msgstr ""
"\"전하, 저희는 문제들에 대한 보고를 받았습니다. 마법 생명체들이 당신의 백성들을 공격하는 것이 점차 위험한 수준으로 증가하고 "
"있습니다. 누구도 그들이 어디로부터 왔는지를 알지 못하지만, 이를 미연에 방지하지 못한다면 그것은 진정한 재앙이 될 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Cue_0004_Text
#. Speaker : Capital_Lander
msgctxt "d784b351-020d-4c10-b667-202d4b62a8a5"
msgid ""
"\"Has anyone told you the bad news? No? I guess I have that honor. We have a "
"new problem: an invasion of wild and hungry magic creatures. There have "
"already been casualties, and if we dally, there'll be more. We have to find "
"the hellhole they're crawling out of and seal it. Otherwise, you risk "
"becoming a ruler with no subjects, I'm afraid.\""
msgstr ""
"\"누군가 너한테 나쁜 소식을 들려준게 있어? 없다고? 그렇다면 내가 그 영예를 안겠군. 우리에게 새 문제가 생겼어. 난폭하고 굶주린 "
"마법 생명체들의 침략이지. 이미 희생자들이 생겼고, 우리가 꾸물거리면 더 늘어나겠지. 우리는 그 놈들이 기어올라오는 지옥구덩이를 찾아서 "
"막아버려야 해. 그게 아니면, 유감이지만 넌 백성없는 지배자가 될 위험을 무릅써야겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Cue_0005_Text
#. Speaker : Capital_Shandra
msgctxt "b4133f0d-5d35-482e-819d-85d41a80a2ab"
msgid ""
"\"{g|Embeth Travelers}Embeth Travelers{/g} have offered their assistance "
"after learning of the problem. We could invite some guests from neighboring "
"countries and turn the hunt into a diplomatic affair. What do you think?\""
msgstr ""
"\"{g|Embeth Travelers}엠베스 여행자{/g}가 문제를 파악하는데에 도움을 제공하겠다고 하였습니다. 우리는 이웃 "
"국가들로부터 손님들을 초대해 이 사냥을 외교적으로 전환할 수 있습니다. 어떻게 생각하십니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Cue_0006_Text
#. Speaker : Capital_Lander
msgctxt "853e9089-4056-4344-9593-b2aa2624b530"
msgid ""
"\"The bright side is we've got an unexpected ally. {g|Embeth Travelers}"
"Embeth Travelers{/g} have offered to help us thin the monsters' ranks. I "
"suggest combining business with pleasure and inviting some guests from "
"neighboring countries to participate in our little hunt. How does that sound?"
"\""
msgstr ""
"\"좋은 면을 보자면 우리는 기대치 못했던 동맹을 얻었습니다. {g|Embeth Travelers}엠베스 여행자{/g}가 괴물들의 "
"군대를 약하게 하는데에 도움을 주겠다고 제안했습니다. 일과 즐거움을 엮어 이웃국가들로부터 손님들을 초대해 우리의 작은 사냥에 참가시키는 "
"것을 제안합니다. 어떻게 생각하십니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Cue_0015_Text
msgctxt "d8c597a3-233a-40f4-8e48-a2d15e4d2ef1"
msgid ""
"\"Embeth Forest is south of your domain. It's a dangerous place, swarming "
"with wicked fey and other magical creatures. {g|Embeth Travelers}Embeth "
"Travelers{/g} are renowned for their mastery of eliminating such threats. "
"They don't ask for much — compensation for traveling expenses, and the right "
"to keep any trophies they hunt down. This seems a fair price to me.\""
msgstr ""
"\"엠베스 숲은 당신의 영지의 남부입니다. 위험한 곳으로, 사악한 페이들과 다른 마법적 생명체들이 들끓고 있습니다. {g|"
"Embeth Travelers}엠베스 여행자{/g}는 이런 위협들을 말살하는 것에 전문가들로 잘 알려져 있습니다. 그들은 많은 것을 "
"요구하지 않습니다. 여행 경비에 대한 보상과 그들이 사냥한 것을 기념품으로 삼게끔 해주면 됩니다. 제가 보기엔 적당한 비용이라 여겨집니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Cue_0016_Text
msgctxt "d70167fc-f57e-417c-a30e-b90831b20ca6"
msgid ""
"\"We need to establish connections with our closest neighbors: "
"{g|Pitax}Pitax{/g} and {g|Mivon}Mivon{/g}. I'll invite someone from King "
"Irovetti's inner circle, as well as some Aldori {g|Swordlords}Swordlords{/g} "
"from Mivon.\""
msgstr ""
"\"우리는 가장 가까운 이웃인 {g|pitax}피탁스{/g}와 {g|Mivon}미본{/g}과 관계를 맺을 필요가 있습니다. 이로베티 왕의 "
"핵심층 중의 누군가와 미본의 알도리 {g|Swordlords}소드로드들{/g} 중 누군가를 초대토록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Cue_0017_Text
msgctxt "175ff5f4-63bb-4a7e-a4bd-f4b3e81998ab"
msgid ""
"\"He would most likely reply with a polite refusal. Once he stepped foot on "
"your lands, he'd find himself at your mercy. Irovetti is a treacherous old "
"fox, and he'd expect nothing but similar treachery from others.\""
msgstr ""
"\"분명 정중하게 거절할 것입니다. 영주님의 영토에 발을 들이면 불리해질 걸 알고 있을겁니다. 이로베티는 배신을 일삼는 늙은 여우입니다. "
"다른 이들도 자신처럼 배신을 할 거라 생각합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Cue_0019_Text
msgctxt "62221700-9c90-412f-ba73-649adfe58736"
msgid ""
"\"Typical for the {g|River Kingdoms}River Kingdoms{/g}. They have an armed-"
"to-the-teeth truce, with regular skirmishes along the border. They have many "
"mutual issues, but they won't grab for their swords as soon as they see each "
"other. Especially not on neutral ground.\""
msgstr ""
"\"{g|River Kingdoms}강의 왕국들{/g}끼리의 외교상황을 보여주는 전형적인 예시라 할 수 있습니다. 휴전 상태이지만 무장을 "
"잘 갖추고 있고 국경지역에서 작은 분쟁만 일어나는 수준입니다. 분쟁요소는 많지만 정작 칼을 뽑지는 않습니다. 특히나 중립지역에서는 "
"말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Cue_0020_Text
msgctxt "33c33513-d979-40d1-8b82-06ae1f8767c2"
msgid "\"I'll give the necessary orders immediately.\""
msgstr "\"저는 즉시 필요한 명령을 내리도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Cue_0021_Text
msgctxt "c98b9c2e-e32a-4a3f-888c-2d3324ab7dc5"
msgid "\"As you say.\""
msgstr "\"말씀하신 데로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-1EnvoyIntro/Cue_EnvoyMivoni_Text
msgctxt "a2dc1c87-7653-459e-8501-dbd240dcdcc0"
msgid ""
"\"{g|Mivon}Mivon{/g} is mostly controlled by the Aldori exiles — they "
"descend from those who preferred to flee when {g|Choral}Choral the "
"Conqueror{/g} arrived in {g|Restov}Restov{/g} with his dragons. I would "
"advise against reminding them of that shameful story.\""
msgstr ""
"{g|Mivon}미본{/g}은 대부분 망명한 알도리에 의해 통치되고 있습니다. {g|Choral}정복자 코랄{/g}이 드래곤과 함께 "
"{g|Restov}레스토프{/g}를 습격했을 때 도망친 알도리의 후손들이죠. 저는 그들에게 이 수치스러운 역사를 떠올리지 말라고 충고하고 "
"싶습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Answer_0007_Text
msgctxt "0358945e-3202-459d-9eed-3239852cc59a"
msgid "\"Lamashtu? What do we know about her?\""
msgstr "\"라마슈투? 우리가 그녀에 대해 알고 있는 것은 무엇이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Answer_0008_Text
msgctxt "69d2b155-3454-45d7-a58a-1d02279510dd"
msgid "\"The goblins are behind this disaster, then?\""
msgstr "\"그렇다면, 고블린들이 이 재앙에 배후에 있는건가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Answer_0011_Text
msgctxt "b9ab51e7-6dda-489e-b75f-fc73d4f0ffea"
msgid ""
"\"So we need to find a goblin leader and press them for information. Any "
"idea where to begin the search?\""
msgstr ""
"\"그러면 우리는 고블린 우두머리를 찾아내고 그들에게 정보를 얻어낼 필요가 있겠군. 어디서부터 수색을 시작할지 짐작가는 곳이 있나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Answer_0013_Text
msgctxt "74cf77b9-03b9-4255-8ec3-650f068ac62b"
msgid "\"Thank you for the information.\""
msgstr "\"정보를 알려줘서 고맙다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "756f21c7-b3a2-4f00-8abe-cac1952b14b9"
msgid ""
"\"The epidemic continues. More and more people die — more and more monsters "
"roam your lands. Some of your subjects have alread fled in search of safer "
"havens. Your barony's very existence is in danger.\""
msgstr ""
"\"전염병이 그치질 않습니다. 점점 더 많은 사람들이 죽어가고, 점점 더 많은 괴물들이 당신의 땅 위를 돌아다닙니다. 몇몇 백성들은 이미 "
"안전한 피난처를 찾아 떠나갔습니다. 당신의 남작령의 존속이 경각에 달렸습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Cue_0002_Text
#. Speaker : Capital_Shandra
msgctxt "08638767-8495-42f9-853c-f4e4f188b778"
msgid ""
"\"Whoever started this epidemic, there's no doubt their goal was to destroy "
"your young barony. As the number of monsters increases, people panic and "
"flee to other countries.\""
msgstr ""
"\"누가 이 전염병을 시작하였던건 간에, 그들의 목적이 당신의 젊은 남작령을 파괴하겠다는 것임에는 의심의 여지가 없습니다. 괴물들의 수가 "
"늘어갈수록, 사람들은 공황에 빠지고 다른 나라들로 피신할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Cue_0003_Text
#. Speaker : Capital_Lander
msgctxt "f930cb5d-d5e8-4630-bc4a-49f0b7f1b27e"
msgid ""
"\"If we don't do something about this epidemic, and soon, you'll have only "
"hydras and wyverns to rule over! The more folks get eaten, the more other "
"folks panic, and the more they're tempted to flee to our neighbors.\""
msgstr ""
"\"우리가 이 전염병을 두고 아무것도 하지 않는다면, 곧, 당신께선 히드라와 와이번 따위를 지배해야만 할 것입니다! 더 많은 사람들이 "
"먹혀갈 때마다, 다른 많은 사람들은 공황에 빠지고, 더 많은 이들은 우리의 주변국으로 도망가고자 할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Cue_0004_Text
msgctxt "aba26cc8-7109-4280-b136-1c5fdaada1bd"
msgid ""
"\"We do have good news, too. I managed to gather some information that, I "
"hope, will help you eliminate the threat before it's too late.\""
msgstr ""
"\"우리에겐 좋은 소식 또한 있습니다. 제가 몇가지 정보를 모을 수 있었습니다. 이 정보가 너무늦기 전에 이 위협을 제거하는데 도움을 줄 "
"수 있을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Cue_0005_Text
msgctxt "5b8df195-8798-466f-94ea-49e2c27c7a3e"
msgid ""
"\"Shortly after the epidemic started, goblins began appearing everywhere. "
"The locals report that these goblins have been celebrating and shouting "
"something about the 'day of glory for {g|Lamashtu}Lamashtu{/g},' when all "
"humans would be eaten by monsters and only goblins would remain. Sounds "
"disturbing, does it not?\""
msgstr ""
"\"전염병이 시작된지 얼마 안되어서, 고블린들이 도처에서 모습을 드러내기 시작했습니다. 주민들의 보고에 의하면 이 고블린들은 모든 "
"인간들이 괴물들에게 잡아먹히고 오직 고블린들만 남게되는 '{g|Lamashtu}라마슈투{/g}를 위한 영광의 날'에 대해 떠들며 "
"기념한다고 합니다. 문제있는 이야기지 않겠습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Cue_0009_Text
msgctxt "98ff7077-e1db-4035-9005-f27f43662a2a"
msgid ""
"\"Behind it? Doubtful. Benefiting from it? Quite likely. I'd surmise that "
"the true cause of this disaster is either human cultists of "
"{g|Lamashtu}Lamashtu{/g} or, even worse, some supernatural creature related "
"to her. In any case, the goblins likely know enough to provide some clue.\""
msgstr ""
"\"배후에 있다? 의심스럽습니다. 그로부터 이득을 취하는가? 어쩌면 그럴지도요. 제가 추측컨데 이 재앙의 진짜 원인은 "
"{g|Lamashtu}라마슈투{/g}의 인간 종교 집단이거나, 더 나쁘게는 그녀와 관련된 어떤 초자연적 생명체일 수 있습니다. 어느 "
"경우든, 고블린들은 우리에게 제공하기에 충분한 단서들을 알고 있을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Cue_0010_Text
msgctxt "fac5732f-39fe-4ae5-bed0-21c6e6d5cccf"
msgid ""
"\"She's called the Mother of Monsters. Her symbol is the three-eyed jackal "
"head. She's an ancient and extremely evil goddess, who spreads nightmares, "
"insanity, and — perhaps of most interest to us — monsters. Her worshipers "
"are mostly of the more monstrous races, like goblins, lamias, and gnolls. "
"That said, there's no short supply of secret followers and cults among more "
"civilized peoples, too — including the people of the {g|River Kingdoms}River "
"Kingdoms{/g}.\""
msgstr ""
"\"그녀는 괴물들의 어머니라고 불리웁니다. 그녀의 상징은 세 개의 눈을 한 자칼의 머리입니다. 그녀는 극도로 사악한 고대의 여신으로, "
"악몽과 광기, 그리고 괴물들을 퍼뜨린다고 합니다. 아마 우리가 가장 주목해야 할 부분이겠죠. 그녀의 숭배자들은 대부분 고블린, 라미아, "
"놀 같은 괴물 종족들입니다. 그렇긴 하지만, 더 문명화된 사람들 사이에서도 비밀 추종자들과 광신도 집단은 적지 않은 편입니다. 물론 {g|"
"River Kingdoms}강의 왕국들{/g} 사람들을 포함해서 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Cue_0012_Text
msgctxt "d7bc2cdc-a51f-482b-83e7-62312efc4cfc"
msgid ""
"\"Yes. You were wise to prevent widespread panic by keeping the epidemic "
"secret. Due to that, my agents caught several goblins and learned the "
"location of their village. I'll mark it on your map.\""
msgstr ""
"\"그렇습니다. 전염병을 기밀로 유지한 것은 공황이 퍼져나가는 것을 방지한 현명한 결정이었습니다. 그로 인하여, 제 요원들이 몇몇 "
"고블린들을 붙잡아 그들의 마을의 위치를 알아내었습니다. 지도에 표시를 해두도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Cue_0014_Text
#. Speaker : Capital_Kassil
msgctxt "6b5afb44-0021-4beb-93ae-36be63afee06"
msgid "\"I hope it helps you to save the lives of your people.\""
msgstr "\"백성들의 생명을 구하는 데 도움이 되기를 바라겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Cue_0015_Text
#. Speaker : Capital_Shandra
msgctxt "2686e2fd-0b87-4969-a5f3-93ef37aba33f"
msgid ""
"\"Happy to help. Take care, though — there's no doubt your enemies still "
"have plenty of tricks up their sleeves. If you value your throne, take them "
"down as soon as possible.\""
msgstr ""
"\"도움이 되어 기쁩니다. 그러나 조심하십시오. 당신의 적들은 여전히 많은 속임수를 가지고 있음이 틀림없습니다. 왕좌를 영예롭게 "
"여기신다면 그들을 가능한 빨리 물리쳐야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Cue_0016_Text
#. Speaker : Capital_Lander
msgctxt "311af08d-3bc0-4fd9-80e1-afb4ce8316f2"
msgid ""
"\"You're welcome! Be sure to make those goblins talk, though, or you may "
"risk both your crown and your head!\""
msgstr "\"천만에! 아무튼, 고블린들과 확실히 얘기해보라고. 아니라면 네 왕관과 머리 둘 다 위험해질 테니까!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Cue_0017_Text
msgctxt "0726ef27-d4cf-4c16-884a-86ea2a74cdd4"
msgid ""
"\"Alas, nothing more than vague speculations. Once you alerted your subjects "
"to the danger, they began defending themselves as best they could — my "
"agents couldn't catch even a single goblin alive. But rumor has it that the "
"goblin village lies somewhere in the {g|Kamelands}Kamelands{/g}.\""
msgstr ""
"\"아아, 막연한 추측에 지나지 않습니다. 백성들에게 위험을 알리자 그들은 자신들이 할 수 있는 최대한 자신들을 방어하고 있습니다. 제 "
"요원들은 단 한마리의 고블린도 생포하지 못했습니다. 그러나 소문에 의하면 고블린들의 마을은 {g|Kamelands}케임랜드{/g}의 "
"어딘가에 위치하고 있다고 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuests/Cue_0018_Text
msgctxt "4a6928f0-2129-478f-968b-449152989ba5"
msgid ""
"\"I'm sorry, no. Panic spread everywhere — my agents had to run for their "
"lives after villagers mistook them for spies and well poisoners. They were "
"almost lynched on the spot. All we know for sure is that there's a large "
"goblin village somewhere within the barony. You'll have to locate it "
"yourself, I'm afraid.\""
msgstr ""
"\"죄송합니다만, 아닙니다. 공황상태가 도처에 퍼졌습니다. 제 요원들을 염탐꾼이나 우물에 독을 푼 자로 마을 사람들이 오해하여 그들은 "
"목숨을 걸고 도망쳐야 했습니다. 그들은 현장에서 폭행을 당할뻔까지 했습니다. 우리가 아는 것은 단지 남작령 안에 커다란 고블린들의 마을이 "
"있다는 것 뿐입니다. 염려스럽게도 직접 위치를 찾으셔야만 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Answer_0005_Text
msgctxt "70cee091-3bed-4f73-9c3d-e752174a35de"
msgid "\"What do we know about this disease?\""
msgstr "\"이 질병에 대해 우린 무엇을 알고있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Answer_0006_Text
msgctxt "2d531ba1-56d9-4dcc-a61c-b32b962200fd"
msgid "\"Can't you handle this without me?\""
msgstr "\"나 없이 이 일을 처리할 수는 없나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Answer_0007_Text
msgctxt "edcdbf36-4005-48b9-94a1-2a869266cf8d"
msgid "\"Any progress curing the disease?\""
msgstr "\"이 질병의 치료에 진전이 좀 있나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Answer_0008_Text
msgctxt "4f01e6a7-a21a-48f2-807f-9de5be8d12ff"
msgid "[Follow Jhod] \"I see. Let's go.\""
msgstr "[조드를 따라갑니다]\"알겠다. 자 갑시다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Answer_0013_Text
msgctxt "5171b79e-f2c9-4f63-87c8-056b90219925"
msgid "\"Vivisection? What exactly are you going to do?\""
msgstr "\"생체 해부? 정확히 무엇을 하려는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Answer_0015_AlignmentShift.Description
msgctxt "abd81a72-cad1-4c94-a402-00850be2434b"
msgid ""
"Advised Jhod to operate on a random patient without waiting for a volunteer."
msgstr "자원자를 기다리지 말고 아무 환자에게나 수술할 것을 조드에게 권했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Answer_0015_Text
msgctxt "779334dd-8f51-41c5-a4bc-47dce12a1925"
msgid ""
"\"Why wait for volunteers? You could perform the surgery on a random patient "
"without waiting for them to explode.\""
msgstr "\"왜 자원자를 기다린거지? 자네는 환자가 폭발하기를 기다리지 않고 아무 환자에게나 수술을 할 수 있었을텐데.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Answer_Invite_sadist_Text
msgctxt "7ffca607-e434-4b28-b9e4-8c0c169dc161"
msgid ""
"\"We happen to have a master vivisectionist available. Send for Bartholomew "
"Delgado.\""
msgstr "\"마침 우리에게는 생체 해부의 대가가 있다. 바솔로뮤 델가도에게 도움을 청합시다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Cue_0001_Text
msgctxt "6a5a888f-ed8d-42dc-9bd5-371e1e84f7b6"
msgid ""
"{n}Jhod's eyes are bloodshot and his posture is slack. The wrinkles on his "
"face have deepened, and his sparse hair has gone gray.{/n} \"It's a "
"disaster, Your Grace. We have an epidemic developing in the country. The "
"afflicted first get a fever, then a bloody cough, then several hours later..."
"\" {n}The cleric shakes his head and grimaces.{/n} \"And that's just half "
"the trouble. Afterward, the bodies of the afflicted become like some kind of "
"cocoon, and monsters hatch out of them. People keep dying, and we haven't "
"the slightest clue what's causing it or how to deal with it!\""
msgstr ""
"{n}조드의 눈은 충혈되고 그의 몸가짐은 맥이 빠져있습니다. 그의 얼굴의 주름은 더 깊어졌으며, 그의 드문 머리카락은 회색이 되어 "
"있었습니다.{/n}\"재앙입니다, 전하. 전염병이 온 사방에 퍼지고 있습니다. 감염자는 처음에는 열이 나다가, 피와 함께 기침을 하고는 "
"몇 시간 뒤에는...\"{n}이 클레릭은 그의 고개를 가로젓더니 얼굴을 찡그렸습니다.{/n}\"이것은 단지 문제의 절반일 뿐입니다. 그 "
"뒤에, 감염된 사람의 몸은 마치 고치의 일종이 되어 그들을 찢고 괴물들이 나타납니다. 사람들이 계속 죽어가고 있지만 우리는 원인에 대한 "
"조그만 단서조차도, 어떻게 처리해야 할지조차도 모릅니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Cue_0002_Text
msgctxt "20f1e96a-0a38-47c7-b9c7-d9eeece7d327"
msgid ""
"\"Tristian and I established a field hospital in the building of the former "
"prison. Don't look at me like that — there were no better places to choose "
"from! Frankly, we were lucky to find this one. To cut a long story short, we "
"have a female patient who's volunteered for vivisection. It means cutting "
"into her living body to look for the source of this disease.\" {n}Jhod "
"frowns.{/n} \"After the surgery — {g|Erastil}Erastil{/g} forgive us — we'll "
"be lucky if we can close her up and let her go alive and well. However, we "
"don't want to do it without your presence, Your Grace, so please try to find "
"some time to attend.\""
msgstr ""
"\"트리스티안과 저는 일전에 감옥이었던 건물에 야전 병원을 차려놓았습니다. 그렇게 보지 말아주십시오. 선택할만한 더 나은 곳이 "
"없었습니다! 솔직하게 말씀드리자면 저희가 이 곳을 찾은것조차 운이 좋은 것이었습니다. 긴 이야기를 짧게 말하자면, 생체 해부에 한 여성 "
"환자가 자원하였습니다. 그 말인즉슨, 우리가 그녀의 살아있는 몸을 갈라 질병의 원인을 찾아볼 수 있다는 것입니다.\"{n}조드는 눈살을 "
"찌푸렸습니다.{/n}\"수술이 끝나면. {g|Erastil}에라스틸{/g}이여 우릴 용서하소서. 우리는 운이 좋다면 그녀를 건강히 "
"살려보낼 수 있을 것입니다. 그러나 전하께서 참석하시지 않는 다면 저희는 이를 행하고 싶지 않습니다. 그러니 시간을 내서 참석해 주셨으면 "
"합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Cue_0009_Text
msgctxt "f2b65a25-52f5-44c3-b2af-a5e3e70fe93a"
msgid ""
"\"Not much — just primary symptoms, actually. We're not even sure if it's a "
"disease, a curse, or some magic parasite. Perhaps with your help we'll "
"manage to learn more.\""
msgstr ""
"\"실은 일차적인 증상만을 알뿐, 많지 않습니다. 심지어 우리는 이것이 질병인지, 저주인지 아니면 마법적 기생충에 의한 것인지도 확신하지 "
"못하고 있습니다. 당신의 도움이 있다면 더 많은 걸 알 수 있을 지 모릅니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Cue_0010_Text
msgctxt "8729594f-9cf6-4b77-8629-45551ca1c071"
msgid ""
"\"Your Grace, we're not playing games here. Do you wish to keep your barony? "
"That requires taking care of its people. Whatever you may think, you have no "
"more important business at this time.\""
msgstr ""
"\"전하, 우리는 놀이를 하는 것이 아닙니다. 남작령을 지키고 싶으십니까? 그렇다면 사람들을 보살펴야 합니다. 어떤 일을 생각하시던 간에 "
"지금은 이보다 더 중요한 일은 당신께 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Cue_0011_Text
msgctxt "6a3c511f-5cf9-4781-9b45-dcbf9c5f2248"
msgid ""
"\"How should I put it...? We've got none! We haven't been able to save a "
"single patient yet. We're like blind kittens bumping against a wall, and we "
"have nothing to show for it!\""
msgstr ""
"\"어떻게 표현하면 좋을까요...? 우리에겐 아무것도 없습니다! 우리는 아직까지도 단 한 명의 환자조차 구해내지 못하고 있습니다. 마치 "
"눈이 멀어 벽에 부딪히는 고양이처럼 말입니다. 게다가 보여줄만한 것조차 없습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Cue_0014_Text
msgctxt "acf80a90-a04b-4271-985b-7e49e9510a2e"
msgid ""
"\"What...? We're going to find the source of the disease, that's what! Once "
"the monster emerges, the body of the afflicted is torn to pieces, making it "
"impossible to learn anything from the remains. But we found one brave woman "
"who gave us permission to cut her open. The straits are dire — we don't know "
"exactly what we're looking for, and the vivisection is extremely dangerous "
"for the patient. But we're left with no other choice.\""
msgstr ""
"\"무엇이라구요...? 우리는 이 질병의 원인을 찾아낼 것입니다. 그게 바로 무엇입니다! 괴물들이 나타나기 시작하면, 감염된 신체는 "
"조가조각 찢겨서 그 남은것으로부터는 어떤 것도 이 원인에 대해 알아낼 것을 찾는것이 불가능합니다. 그러나 우리는 스스로의 해부를 허락한 "
"한 명의 용감한 여성을 찾았습니다. 지금의 곤경은 대단히 어려운 것입니다. 우리는 정확히 우리가 찾는 것조차 알지 못하며 신체 해부란 그 "
"환자에게는 극도로 위험한 것입니다. 그러나 우리에게는 더 이상 다른 선택지가 남아있지 않습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Cue_0016_Text
msgctxt "3f84758f-d54a-4893-aaff-d2b3d863a2f2"
msgid ""
"\"Bite your tongue! I'm a cleric, not some... butcher! My duty is to save "
"and comfort people not... Not...\" {n}Jhod goes silent and just shakes his "
"head, frowning.{/n}"
msgstr ""
"\"그 입을 다무시오! 나는 성직자이지, 도살자가...아니란 말이오! 내 의무는 사람들을 구하고 편안케 하는 것이지...그런게..."
"아니란...\"{n}조드는 침묵하더니 눈살을 찌푸리며 그의 머리를 가로저었습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Cue_0018_Text
msgctxt "93c14d54-d97d-4d50-9c49-f6b77668a71b"
msgid ""
"{n}Jhod frowns at the wizard's name, but then nods.{/n} \"Fine. You're "
"right. He's certainly... peculiar, but none can deny his knowledge. He may "
"be able to help us.\""
msgstr ""
"{n}조드는 마법사의 이름을 듣고는 눈살을 찌푸렸지만 이내 고개를 끄덕였습니다.{/n}\"좋습니다. 당신이 맞습니다. 그는 "
"확실히...이상한 자이지만, 그의 지식까지 부정할 수는 없겠지요. 그는 우리에게 도움이 될 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Cue_0019_Text
msgctxt "0635fc24-3f03-47e6-b1a7-2e81dc19b467"
msgid ""
"\"There's one more thing.\" {n}Jhod hands you a battered letter.{/n} \"Kesten"
", that dunce, sent {g|WitchHuntKesten}a message{/g}. He rambles from place "
"to place — these letters are all we ever receive. Well, just read it. I "
"guess it's urgent.\""
msgstr ""
"\"한 가지가 더 있습니다.\"{n}조드는 닳아버린 편지 한 장을 당신에게 건냈습니다.{/n}\"케스턴, 그 머저리가 "
"{g|WitchHuntKesten}이 서신{/g}을 보내왔습니다. 그는 이곳 저곳을 돌아다니면서 오직 이 한장의 편지만 보내왔습니다. "
"그럼, 한번 읽어보시기를. 매우 급한일인것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Items/WitchHuntKestenLetter_Name_String
msgctxt "afe6d7f4-1a46-4bc9-99f8-49ff3e7735eb"
msgid "Kesten's Letter"
msgstr "케스턴의 편지"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-2threeQuestsJhod/Items/WitchHuntKestenLetter_String
msgctxt "d2326dac-bbd6-4d05-821d-2e573aadddab"
msgid ""
"\"Your Grace,\n"
"Please, forgive me my sudden disappearance. I deemed myself of more use "
"among your subjects than at court.\n"
"The people are afraid, Your Grace. They believe that they've been forgotten, "
"that their ruler couldn't care less about the simple folk, even as they "
"perish each and every day. For this reason, those who can bear arms are "
"starting to take matters into their own hands. A wild mob is a force to be "
"reckoned with, and you already have enough to worry about. Fortunately, I "
"was able to convince these people that I'm on their side. In the end, I have "
"decided to lead this militia myself, in order to be the first one to know "
"whenever the people learn something new and to protect them from making rash "
"decisions. I've led troops before, and your subjects view me as one of their "
"own, so they trust me and are willing to follow me.\n"
"It was with a heavy heart that I left your castle, but my hope was that once "
"among the common people, I would be able to track down the source of the "
"disease that struck the barony. I was recently informed that one of the "
"squads scouring the outlying regions of Kamelands had encountered a "
"mysterious shrine. Our spies report that at the beginning of each week, "
"cultists gather there to worship the dark goddess Lamashtu, the patroness of "
"all manner of hideous creatures.\n"
"I know little of the gods and their affairs, but the appearance of the "
"Mother of Beasts and her followers in a land teeming with monsters can "
"hardly be a coincidence. As soon as I've finished writing this letter, I "
"shall lead a squad of my best men there and await your arrival. I ask for "
"your help, Your Grace, for I shall need it to strangle this filth in its "
"cradle. Who knows — perhaps, we'll capture one of the cultists alive and "
"find out if they and their goddess are behind the misfortunes of your barony."
"\n"
"Your loyal servant,\n"
"Kesten Garess\""
msgstr ""
"\"전하,\n"
"제가 갑자기 사라진 것을 부디 용서해주십시오. 저는 제 자신이 궁전에서보다 당신의 백성들 사이에서 더 쓰임이 많을 것이라 생각합니다.\n"
"사람들이 두려워하고 있습니다, 전하. 그들은 그들의 통치자가 자신들과 같은 평범한 사람들이 매일매일 비참하게 죽어나가고 있음에도 신경을 "
"쓰지 않으며 그래서 잊혀졌다고 믿고 있습니다. 이런 이유 때문에 무기를 들 수 있는 사람들은 그들 스스로의 손으로 문제를 해결하기 "
"시작했습니다. 난폭한 폭도들은 무시할 만한 세력이 아니며, 당신께선 이제 충분히 염려해야 할 지경입니다. 다행히도 그들에게 제가 그들의 "
"편이라고 설득할 수 있었습니다. 결국, 저는 그들이 새로이 알게 되는 것을 더 먼저 알고 경솔한 결정을 내리는 것을 막기 위하여 이 "
"민병대를 이끌게 되었습니다. 저는 이미 군대를 지휘한 적이 있으며, 당신의 백성들은 저를 이미 그들 가운데 한 사람으로 여겨 주기에 "
"그들은 저를 밑고 기꺼이 저를 따르고 있습니다.\n"
"당신의 성에서 떠나올 때 저는 매우 무거운 마음이었습니다만, 이 평범한 사람들 곁에서 다시금 희망을 찾게 되었으며, 저는 남작령을 덮친 "
"이 질병의 원인을 추적할 수 있을 것 같습니다. 최근 케임랜드 지역을 샅샅히 수색하던 분대원들 중 하나가 신비한 사원을 찾아내었다는 "
"소식을 전달받았습니다. 우리의 첩자는 매주의 첫날, 모든 흉측한 생명체들의 보호자인 어두운 여신 라마슈투를 추종하는 사교도들이 그곳에 "
"모인다는 보고를 했습니다.\n"
"저는 신들과 그들이 행하는 것에는 많은 것을 알지 못합니다만, 괴물들의 어머니와 그의 추종자들의 등장과 이 땅에 괴물들이 득실거리는 것이 "
"단순한 우연은 아닐 것입니다. 이 편지쓰는 것을 마치는 데로 저는 가장 우수한 대원들로 꾸며진 분대를 이끌고 그곳으로 가서 당신의 도착을 "
"기다리겠습니다. 이 요물들을 그 요람에서 제압하기 위해서는 당신의 도움이 필요합니다, 전하. 어쩌면 우리가 그들 사교도 가운데 하나를 "
"사로 잡아 당신의 남작령에 닥친 불운의 배경에 그들과 그들의 여신이 있다는 것을 찾아낼지도 모르는 일입니다.\n"
"당신의 충실한 종,\n"
"케스턴 가레스\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0006_Text
msgctxt "57c90600-4c75-4b94-91fc-6e9e63c68d64"
msgid ""
"\"Jhod, the surgery showed that it was magic seeds causing the disease, "
"correct?\""
msgstr "\"조드, 수술을 해본 결과, 마법 씨앗들이 질병을 일으키는 것으로 드러났다는거지? 맞는가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0007_Text
msgctxt "a9e5bb2b-be63-4ef8-a29a-045c1952dec2"
msgid ""
"\"Kesten, we discovered that the Lamashtu cultists weren't involved with the "
"monster infestation.\""
msgstr "\"케스턴, 우리는 라마슈투의 사교도들이 이 괴물 침공과는 관계없다는 것을 발견했어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0008_Text
msgctxt "82536692-eb45-4492-84c6-a610506709f1"
msgid ""
"\"Goblins obviously like having all these monsters around. To them, it's "
"like a sign of Lamashtu's benevolence.\""
msgstr ""
"\"고블린들은 분명 이 모든 괴물들이 자신들 주변에 있는 것을 좋아하고 있다. 그들에게는, 이것이 라마슈투의 자비의 징조로 여겨지고 있어."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0011_Text
msgctxt "d3068886-f163-4f97-8acc-ad9bbeefa994"
msgid ""
"\"So, the Bloom's essential properties are strange seeds getting into "
"people's bodies, which causes their disease and eventually creates magic "
"portals. Now we just need to discover where the seeds are coming from.\""
msgstr ""
"\"그러면, 이 개화의 본질적인 특성은 사람들의 몸에 침입하는 이상한 씨앗들이라는건데, 이 씨앗이 질병을 유발하고 결국 마법 포탈을 "
"만들어낸다는 거군. 이제 우리는 이 씨앗이 어디서부터 왔는지를 밝혀내야만 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0017_Text
msgctxt "c22fdd00-f8c9-4958-bc37-c6743bf1ccfe"
msgid "\"Kesten, the militia most often finds monsters by the river, right?\""
msgstr "\"케스턴, 민병대는 강 주변에서 가장 빈번하게 괴물들을 발견하고 있어. 그렇지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0025_Text
msgctxt "86b1d559-3076-49ed-a09e-bd4a4279be6c"
msgid ""
"\"There are dozens of villages along the riverbanks — hundreds of people. "
"How many are likely already infected?\""
msgstr "\"강둑을 따라 수십여개의 마을과 수백명의 사람들이 있어. 벌써 몇 명이나 감염되었을까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0026_Text
msgctxt "1941a35d-8ccb-446b-a6e8-3d3293eb6bf9"
msgid "\"We have to go upstream and find the source of this blight.\""
msgstr "\"우리는 상류로 가서 이 질병의 원인을 찾아내야해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0031_Text
msgctxt "a07813e9-df90-4c75-b69e-fda86add1c58"
msgid "\"Can we keep people calm? Persuade them to wait a bit longer?\""
msgstr "\"사람들을 계속 진정시킬 수 있겠나? 그들에게 조금 더 기다려 달라 설득할 순 없을까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0034_Text
msgctxt "f06a3867-1353-4332-bd11-b88748226520"
msgid "\"Kesten, are you still with the militia?\""
msgstr "\"케스턴, 아직 민병대와 함께 하고 있나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0042_Text
msgctxt "7407b9cd-0344-4364-bd83-a4d93a3318e5"
msgid "\"Jhod, how are the patients in the prison doing?\""
msgstr "\"조드, 감옥의 환자들은 어떻게 지내고있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0043_Text
msgctxt "81c476cc-8e61-40b6-8732-f59802c0922d"
msgid ""
"\"Tristian, how did you find the link between the disease and the river?\""
msgstr "\"트리스티안, 어떻게 강과 이 질병이 연관되어 있다는 것을 찾아낸거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0049_Text
msgctxt "b22118b2-76fd-4ca8-801a-5af969784844"
msgid "\"Nok-Nok, what can you tell me of your brethren?\""
msgstr "\"녹-녹, 네 동족들에 대해 말해 줄 것은 없나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0070_AlignmentShift.Description
msgctxt "70fa2469-f758-4adc-8f21-4dc48adf31f1"
msgid "Allowed Kesten and the militia to take justice in their own hands."
msgstr "케스턴과 민병대가 그들의 손으로 정의를 행하는 것을 허락했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0070_Text
msgctxt "76de8660-6c6d-48a1-b4e4-9c45236c2366"
msgid ""
"\"You have my permission, Kesten. I won't deprive people of the opportunity "
"to find the cause of their troubles.\""
msgstr "\"허락하겠어, 케스턴. 나는 사람들 스스로 문제의 원인을 찾을 기회를 빼앗지 않겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0071_AlignmentShift.Description
msgctxt "227efacd-abdf-46e9-8978-bbe422750b64"
msgid "Forbid Kesten and the militia to take justice in their own hands."
msgstr "케스턴과 민병대가 그들의 손으로 정의를 행하는 것을 금지하였습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0071_Text
msgctxt "0ea3edb1-ceed-4ca3-86c8-480c463da8b8"
msgid ""
"\"No, Kesten, we have to deal with this carefully and rationally. Go to your "
"people and await my arrival.\""
msgstr ""
"\"아니, 케스턴. 우린 이 일을 신중하고 이성적으로 처리해야만 해. 사람들에게 간 후, 내가 도착할 때까지 기다리도록.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0072_Text
msgctxt "e6429ac3-127b-4f9d-845e-6a0e4b3935ed"
msgid "\"I need some time to think over your offer.\""
msgstr "\"자네 제안에 대해 생각할 시간이 좀 필요해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0073_Text
msgctxt "cb5804d2-0e26-4922-86bf-488d2bee69fa"
msgid ""
"\"Can you tell me where these monsters come from, Tristian? The ones that "
"appear because of this... Bloom?\""
msgstr "\"이 괴물들이 어디로부터 왔는지 말해 줄 수 있나, 트리스티안? 이...개화..라는 걸 일으키는 것들 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0081_Text
msgctxt "e2f9f689-ec5e-45d1-8811-2861b9367ccc"
msgid "\"Let's summarize what we've found up to this point.\""
msgstr "\"지금까지 우리가 찾아낸 것들을 한번 정리해봅시다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0083_AlignmentShift.Description
msgctxt "bb32c757-ea0e-4cf2-87a3-92766a60be05"
msgid "Threatened to execute all rebels."
msgstr "반란에 가담한 모든 자들을 처형하겠다 위협했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0083_Text
msgctxt "cf6e4568-3e32-4e4f-b83a-f8617d4ae407"
msgid ""
"\"The duty of the people is to obey the laws and orders of their ruler. I'll "
"hang any rebels I find and banish their families.\""
msgstr ""
"\"백성들의 의무는 통치자의 법과 명령에 복종하는 것이다. 어떤 반란군이라도 발견되는 즉시 교수형에 처하며, 가족들은 추방시키겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0085_Text
msgctxt "3f455434-c8d5-413e-81fc-fc54be239b08"
msgid "\"That's all I need to know about the results of the research.\""
msgstr "\"연구에 결과에 대해서는 충분히 알았다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Answer_0088_Text
msgctxt "1ba1ecb4-f9bf-4d70-acd7-c6b629e79aef"
msgid "\"Jhod, how did you come about these rumors of a curse?\""
msgstr "\"조드, 저주에 대한 소문은 어떻게 알게되었나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "086fc883-bb43-4db3-ad25-fc74ca7c13b5"
msgid ""
"{n}Jhod folds his hands on his chest.{/n} \"Well, now that we're all here, "
"let's sum up what we know. We've each spent a lot of time and effort to "
"learn what we can about where the monsters come from and what's causing this "
"strange disease. I hope this conversation can help shed some light on the "
"situation.\""
msgstr ""
"{n}조드는 가슴 위에 손을 얹습니다.{/n} \"이제 모두 여기 모였으니, 우리가 알게 된 것을 종합해 보겠습니다. 우리는 각자 이 "
"괴물들이 어디로부터 왔으며 무엇이 이 이상한 질병을 발생시키는 지 알아내려고 많은 시간과 노력을 들였습니다. 이 대화를 통해서 현 상황에 "
"조금이나마 빛을 밝힐 수 있기를 바랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0003_Text
#. Speaker : Capital_Kesten
msgctxt "ea9dd983-3e85-44c9-90db-be487b7e230f"
msgid ""
"{n}Kesten shakes his head slowly.{/n} \"We need to hurry. If we don't find "
"the source of this blight and eliminate it, we may end up with a rebellion "
"on our hands.\""
msgstr ""
"{n}케스턴은 천천히 고개를 가로젓습니다.{/n}\"우리는 서둘러야만 합니다. 이 전염병의 원인을 찾아 제거하지 못한다면, 결국 우리 "
"손에 반란이 일어날지도 모릅니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0004_Text
#. Speaker : NokNok_Companion
msgctxt "11a696a6-5f6e-4029-8bdd-9aa5f413b7a4"
msgid ""
"{n}Hearing the name {g|Lamashtu}Lamashtu{/g} draws Nok-Nok's attention.{/n} "
"\"Mother is not to blame here! Told you, but who listens to me?\""
msgstr ""
"{n}{g|Lamashtu}라마슈투{/g}의 이름이 들리자 녹-녹이 관심을 보였습니다.{/n}\"이건 어머니 탓이 아니야! 말했었잖아, "
"하긴 누가 내 말을 듣겠어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0009_Text
#. Speaker : Capital_Jhod
msgctxt "e94a25b1-3e0c-4195-9b8c-ecd0716da2cd"
msgid ""
"\"Right. Judging from the location in the patients' bodies, these seeds were "
"ingested. It seems likely that they're initially extremely small, almost "
"invisible, and people simply swallow them with their food. Once the seed is "
"in the stomach, it begins to grow and cause the symptoms we've seen in our "
"patients.\""
msgstr ""
"\"맞습니다. 환자들의 몸 속에 있는 위치로 미루어보았을때, 이 씨앗들은 삼켜진 것입니다. 그것들은 극도로 작아서 거의 보이지 않으며 "
"사람들은 단순히 음식물을 통해 이것들을 삼킨 것으로 보입니다. 일단 씨앗이 한번 뱃속에 자리 잡으면 점차 자라나기 시작하여 우리가 본 "
"환자들과 같은 증상을 일으킵니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0012_Text
#. Speaker : Tristian_Companion
msgctxt "e94f66fe-31f1-4e6d-8617-b182023edf47"
msgid ""
"{n}Tristian, who'd been examining the map on the table from the shadows, "
"gives a small cough.{/n} \"If I may... I've noticed an interesting detail. "
"Well, two details, to be precise.\""
msgstr ""
"{n}어둠 속에서 테이블 위에 놓은 지도를 살피던 트리스티안은 작게 기침을 했습니다.{/n}\"저 잠시만...흥미로운 정보를 "
"찾아냈습니다. 음, 정확히는 두 가지 정보입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0013_Text
#. Speaker : Tristian_Companion
msgctxt "888819f5-2dcf-436c-8734-da7eef08394a"
msgid ""
"\"First, the seeds afflict mostly the villagers. There have been no recorded "
"cases of disease within the city limits, except for those who came here "
"looking for the cure.\""
msgstr ""
"\"첫번째로, 씨앗은 대부분 마을 사람들에게 감염되었습니다. 치료를 받으러 온 사람을 제외하고는 도시 내에서 질병이 발생한 사례가 없습니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0014_Text
#. Speaker : Capital_Kesten
msgctxt "309ef4da-0269-49ff-a6d0-f2fac0b6ae31"
msgid ""
"{n}Kesten nods.{/n} \"It doesn't mean they're innocent of other crimes, but "
"the monster invasion at least is not their work.\""
msgstr ""
"{n}케스턴이 끄덕였습니다.{/n}\"그들이 다른 범죄에 대해서도 무고하다는 뜻은 아닙니다만, 적어도 괴물들의 침공은 그들의 탓이 "
"아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0015_Text
#. Speaker : NokNok_Companion
msgctxt "5c63fab7-1c6e-4499-a519-f7bf168e2ff6"
msgid ""
"{n}Nok-Nok raises his head.{/n} \"Know what I think? I think goblin-king is "
"rotten lice-scratchter! Shaman plays him like reedpipe, babbles about "
"{g|Lamashtu}Lamashtu{/g}, then plots behind his back!\""
msgstr ""
"{n}녹-녹이 그의 머리를 들었습니다.{/n}\"내가 무슨 생각하는지 알아? 고블린 왕은 썩어빠진 머저리일 뿐이야! 주술사가 갈대피리처럼 "
"놈을 마음대로 휘두른 거지. {g|Lamashtu}라마슈투{/g}에 대해 주절거리게 말이야. 그리고는 그의 등 뒤에서 음모를 짠거지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0018_Text
#. Speaker : Capital_Jhod
msgctxt "31f9d5ee-8862-47dc-b864-568a31d3d309"
msgid ""
"{n}Jhod nods.{/n} \"That's right. Thus, we can assume a common factor in how "
"people are exposed to these seeds: many villages get their food from the "
"same territory.\""
msgstr ""
"{n}조드가 고개를 끄덕였습니다.{/n}\"맞습니다. 그렇다면 우리는 사람들이 어떻게 씨앗에 노출되었는지 공통 요소를 가정해 볼 수 있을 "
"것입니다. 많은 마을 사람들이 음식을 같은 지역으로부터 얻고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0019_Text
#. Speaker : Capital_Kesten
msgctxt "51aed43d-528f-4749-ad06-44889d273164"
msgid ""
"\"Hmm... We used to think the monsters were just coming to the river to "
"drink.\" {n}Kesten rubs his forehead.{/n} \"But if what the cleric says is "
"right...\""
msgstr ""
"\"흐음...괴물들이 단순히 강에 물을 마시러 오는 것으로만 생각했었습니다.\"{n} 케스턴은 그의 이마를 문지릅니다.{/n} \"그러나 "
"사제분의 말씀이 맞다면...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0021_Text
#. Speaker : Capital_Kesten
msgctxt "3e6400cd-1d64-411a-85f5-1022441e65b6"
msgid ""
"{n}Kesten grunts.{/n} \"I'd say they're just excited by anything new that "
"happens. I wouldn't be surprised if they're linked to this story somehow. "
"But I doubt the seeds were created by goblin shamans. Besides, a plan like "
"this seems a little... beyond the local goblin chief's intelligence.\""
msgstr ""
"{n}케스턴이 푸념합니다.{/n}\"그들은 그저 뭔가 새로운 일이 벌어지니 흥분하는 것뿐입니다. 이 이야기에 그들이 어떤 식으로든 "
"연관되어 있다고 해도 전혀 놀랄만한 일이 아닙니다. 그러나 고블린 샤먼이 이 씨앗을 만들었는지는 의문입니다. 게다가, 이런 계획을 "
"세웠다는건...이 지역 고블린들 대장의 지능을 넘어서는 행동 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0029_Text
#. Speaker : Capital_Jhod
msgctxt "95256a4f-8aa4-43bd-b608-69c1e3b69b40"
msgid ""
"{n}Jhod looks at you closely.{/n} \"Are you suggesting we wait for them all "
"to succumb to this Bloom, {mf|Baron|Baroness}? Let's pray we can deal with "
"the situation before that happens!\""
msgstr ""
"{n}조드는 당신을 유심히 바라봅니다.{/n}\"모두가 이 개화에 굴복할 때까지 기다리자는 말씀이십니까, {mf|영주님|영주님|전하|전하}"
"? 그런 일이 벌어지기 전에 상황을 해결할 수 있기를 기도합시다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0030_Text
#. Speaker : Capital_Kesten
msgctxt "d017abf3-b633-45cd-9c77-d7c7d1677909"
msgid ""
"{n}Kesten straighten up and flexes his shoulders.{/n} \"If you allow me, "
"{mf|Baron|Baroness}, I'd like to take the lead on this. I'll take the best "
"members of the militia with me and sweep the woods along the river. We'll "
"look under each and every rock, if needed.\" {n}Kesten muffles a cough.{/n} "
"\"After everything they've been through, these people deserve a chance to "
"discover the source of their misfortunes.\""
msgstr ""
"{n}케스턴은 몸을 바로 하고는 그의 어깨를 풀었습니다.{/n}\"{mf|영주님|영주님|전하|전하}, 허락해주신다면, 제가 이 일에 "
"앞장서고 싶습니다. 민병대 최고의 정예들과 함께 강을 따라 숲을 조사하겠습니다. 필요하다면 우리는 하나하나 모든 바위 아래까지 살필 "
"것입니다. \"{n}케스턴은 헛기침을 했습니다.{/n} \"그들이 모든 일을 겪고 나면, 이 사람들은 자신들의 불행의 근원이 무엇인지 "
"스스로 발견할 기회를 얻을 수 있을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0032_Text
#. Speaker : Capital_Kesten
msgctxt "266aaeac-fc9e-4cd7-8849-3c06ecff09e9"
msgid ""
"{n}Kesten frowns.{/n} \"Your Grace... it's hard to expect loyalty and "
"obedience from people in times like this. They're looking for something — or "
"someone — to blame. I... I didn't want to be the one to say it, but...\""
msgstr ""
"{n}케스턴은 눈살을 찌푸렸습니다.{/n}\"{mf|영주님|영주님|전하|전하}...이런 시기에 사람들로부터 충성과 복종을 기대하기는 "
"어렵습니다. 그들은 비난할 무언가 또는 누군가를 찾고 있습니다. 저...저는 이런 말씀까지 드리고 싶진 않습니다만...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0033_Text
#. Speaker : Capital_Jhod
msgctxt "e0c8181f-ce02-4e9d-952a-8c2b6851ab91"
msgid ""
"{n}Jhod cuts Kesten off with a gesture.{/n} \"People think you're cursed, "
"Your Grace. And it would be in your own best interests to quickly discover "
"the cause of the disaster that keeps claiming the lives of your subjects.\""
msgstr ""
"{n}조드가 손짓으로 케스턴을 제지합니다.{/n}\"{mf|영주님|영주님|전하|전하}, 사람들은 당신이 저주받았다 여깁니다. 그러니 "
"백성들의 목숨을 앗아가는 이 재앙의 원인을 빨리 찾아내는 것이, {mf|영주님|영주님|전하|전하} 스스로를 위해서도 최선일 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0035_Text
#. Speaker : Capital_Kesten
msgctxt "44b76b18-297c-4f6b-8d0d-b6c5d4d6a56d"
msgid ""
"{n}The guard hesitates, furrowing his brow.{/n} \"Your Grace... I understand "
"these people very well. They're tired of just waiting and hoping. But for "
"now, I can guide their eagerness for action in a positive direction. I'm "
"glad to help them avoid hasty decisions that could cause more trouble.\""
msgstr ""
"{n}경비대장은 조금 망설이며, 눈쌀을 찌푸립니다.{/n} \"영주님... 저는 이 사람들에 대해 잘 알고 있습니다. 백성들은 그저 "
"기다리고 바라기만 하는 이 상황에 지쳐가고 있습니다. 하지만 일단 지금은 제가 나서서 긍정적인 방향으로 이끌어 줄 수 있습니다. 더 큰 "
"문제를 일으킬만한 성급한 결정을 피할 수 있도록 기꺼이 그들을 돕겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0036_Text
#. Speaker : Capital_Kesten
msgctxt "023e585e-10d4-4fcc-8562-40902ed1365d"
msgid ""
"\"At the same time, I'm convinced that a crowd of terrified villagers who've "
"armed themselves can't truly be our salvation. This barony has a chance only "
"so long as it has authorities and laws. My top priority is helping you "
"remain that authority and that law.\" {n}Kesten takes a deep breath after "
"the unusually long speech.{/n} \"I just... wanted to assure you that I'm on "
"your side.\""
msgstr ""
"\"이와 동시에, 겁에 질린 백성들이 무기를 들었다는 상황이 좋다고는 할 수 없습니다. 법과 권력의 통제 하에 있어야 남작령의 유지가 "
"가능합니다. 따라서 저의 최우선 임무는 그 권력과 법이 당신의 통제 하에 있도록 도와드리는 것입니다.\" {n}오랜만에 길게 말을 "
"해서인지 캐스턴은 깊게 숨을 들이 마십니다.{/n} \"그저...제가 영주님의 아군이라는 것만 기억해 주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0044_Text
#. Speaker : Capital_Jhod
msgctxt "1968662b-ebc5-40df-846e-942f38ac7798"
msgid ""
"{n}The cleric smiles, satisfied.{/n} \"After finding the source of the "
"disease, we've been working to remove the seeds from people day and night. "
"We've saved so many...\" {n}Jhod's face falls.{/n} \"But, for each patient "
"we cure, we receive two newly infected...\""
msgstr ""
"{n}사제는 만족한 듯 미소 짓습니다.{/n} \"이 질병의 근원을 찾은 뒤, 밤낮으로 사람들에게서 씨앗을 제거하는 작업을 하고 "
"있습니다. 정말 많은 사람들을 구했습니다... {n}조드가 고개를 떨굽니다.{/n} \"하지만, 우리가 환자 한명을 치료할때마다, 새롭게 "
"감염된 환자 두 명을 받고 있는 형편입니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0046_Text
#. Speaker : Tristian_Companion
msgctxt "d755e2f3-d53c-461a-9dc6-2d70c87acbce"
msgid ""
"{n}The cleric glances pensively at the map.{/n} \"You see, "
"{mf|Baron|Baroness}, these seeds are not the only sign of something... "
"abnormal at work. Remember the ruins, where we first met? The glade near "
"those ruins, full of huge flowers?\""
msgstr ""
"{n}사제는 생각에 잠겨 지도를 쳐다봅니다.{/n} \"영주님, 이 씨앗들만이 비정상적인 징조가 아닙니다. 우리가 처음만난 유적을 "
"기억하십니까? 거대한 꽃으로 가득찼던 유적 근처의 빈터말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0047_Text
#. Speaker : Tristian_Companion
msgctxt "149e5492-0946-4d2e-9a1e-fcbfe118d454"
msgid ""
"\"Glades such as that tend to appear all over the Stolen Lands. Seems "
"strange, does it not? Especially if we take into account that the magic "
"seeds and the portals they create look like flowers themselves. Jhod even "
"called this disaster 'the Bloom.' I'd like to research this natural "
"phenomenon, and perhaps...\" {n}Tristian stops talking as loud, hasty steps "
"are heard from the main entrance.{/n}"
msgstr ""
"\"그러한 빈터는 도둑맞은 땅 곳곳에 나타나고 있습니다. 뭔가 이상하지 않습니까? 특히 마법의 씨앗과 그것들이 만들어내는 포탈은 그 "
"자체로 꽃처럼 보입니다. 조드는 심지어 이 재앙을 '개화'라고 불렀습니다. 저는 이 자연 현상을 연구해볼까 합니다. 그러면 아마도..\" "
"{n}트리스티안은 대문에서 들려오는 크고 급한 발자국 소리에 말을 멈추었습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0048_Text
#. Speaker : Capital_Kesten
msgctxt "c928a5fc-a5cb-41ab-a336-308ce8be060c"
msgid ""
"{n}Kesten runs into the room.{/n} \"Your Grace! We have trouble! The "
"peasants are rioting!\""
msgstr "{n}케스턴이 알현실로 뛰어왔습니다.{/n} \"영주님! 문제가 생겼습니다! 농민들이 폭동을 일으켰습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0050_Text
#. Speaker : NokNok_Companion
msgctxt "315befa6-7d9b-4e75-95dd-d3c98f39d228"
msgid ""
"{n}Nok-Nok grimaces.{/n} \"Dangle-eared fool-holes! They be trusting any "
"word shaman says. They not think with their ownheads! See only big beasts, "
"not see big truth!\" {n}The goblin scratches behind his ear with a "
"dagger.{/n} \"Great {g|Lamashtu}Lamashtu{/g} may be happy of all big-"
"beasties around, but it not be her doing...\" {n}After mentioning the "
"goddess, Nok-Nok stops talking, rounds his shoulders, and looks around "
"nervously.{/n}"
msgstr ""
"{n}녹-녹은 얼굴을 찡그립니다.{/n} \"팔랑귀 멍청이들! 주술사가 말이면 뭐든 믿어. 자기 머리가 있는데 생각이란 걸 안 해. 커다란 "
"괴물 볼 줄만 알지, 거대한 진실을 볼 줄 몰라!\" {n}고블린은 단검으로 귀 뒤를 긁적입니다.{/n} \"위대한 라마슈투도 거대한 "
"괴물 보면 기뻐하지만, 그분은 거대한 진실을 못 보진...\" {n}여신을 언급하고나서, 녹-녹은 황급히 말을 멈춥니다. 그리고 몸을 낮추고는 "
"주변을 초조하게 두리번거립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0053_Text
#. Speaker : Capital_Jhod
msgctxt "d6000822-2433-4c06-9d3f-3c8bc271b6ef"
msgid ""
"\"Ugh! That's the only solution these nitwits could come up with...? Don't "
"worry, {mf|Baron|Baroness}. As long as they're not setting fire to the "
"streets, we still have a chance of coming to a peaceful resolution. If you "
"allow me, I'll go and speak with them, do my best to calm the crowd down.\""
msgstr ""
"\"윽! 그 멍청이들이 내놓은 해결책이라는게 고작 그거란 말입니까? 걱정 마십시오, 영주님. 그들이 거리에 불을 지르지 않는 이상, "
"평화롭게 해결할 기회가 있습니다. 허락하신다면 제가 가서 그들과 얘기를 나누고, 군중을 진정시키도록 해보겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0054_Text
#. Speaker : Capital_Kesten
msgctxt "774d6a6c-5d61-4195-9bcb-651f2cdb628d"
msgid ""
"\"And if peace doesn't prevail... your guards and I will stand with you. "
"Let's go. I can hear their shouting even from here.\""
msgstr "\"만약 평화롭게 해결되지 않으면... 저와 경비대들이 당신과 함께하겠습니다. 가시죠. 그들의 고함소리가 여기까지 들립니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0056_Text
msgctxt "59048746-6b4e-4dfa-b5fb-1ed52eb9e3b4"
msgid ""
"{n}The throne room is full of people. Your allies stand around the throne, "
"waiting in silence as you approach. The atmosphere is tense. Today, you'll "
"be discussing the strange and deadly blight that's recently struck your "
"barony.{/n}"
msgstr ""
"{n}알현실이 사람들로 가득찼습니다. 당신이 다가가자 동료들이 침묵을 지키며 왕좌 주위에 서있습니다. 공기가 무겁습니다. 오늘, 당신은 "
"남작령을 덮친 괴이하고 치명적인 질병에 대해 토의할 것입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0058_Text
#. Speaker : NokNok_Companion
msgctxt "c8ed466d-e4e4-4382-a0bf-a5278d991be7"
msgid ""
"{n}The gloomy silence is only penetrated by loud chewing — Nok-Nok has "
"grabbed a whole fried chicken from the table and is busily devouring it, "
"ignoring everyone else completely.{/n}"
msgstr ""
"{n}쩝쩝거리는 소리가 어두운 침묵을 깹니다. 녹-녹이 모두를 완전히 무시한 채 탁자위의 치킨을 통째로 붙잡고 황급히 먹어치웁니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0061_Text
#. Speaker : Tristian_Companion
msgctxt "c5ee4802-34be-4370-887f-b05e4eae40ed"
msgid ""
"{n}Tristian slowly shakes his head.{/n} \"I don't think food is the problem. "
"Take a look.\" {n}He points at the map.{/n} \"We have the most cases of the "
"disease here, here, and over here. Monsters mostly attack here and here...\" "
"{n}The cleric's finger travels down the map, tapping points along a fluid "
"line.{/n} \"You see? The situation is most dire along the banks of the {g|"
"Gudrin River}Gudrin River{/g}.\""
msgstr ""
"{n}트리스티안은 천천히 고개를 가로젓습니다.{/n} \"제 생각에 음식은 문제가 되지 않습니다. 한 번 보십시오.\" {n}그는 지도를 "
"가리킵니다.{/n} \"우리에게 질병이 가장 많이 발병한 곳은 이곳, 이곳, 그리고 여기입니다. 대부분의 괴물들은 이곳과 이곳을 "
"공격했습니다...\" {n}사제의 손가락이 지도를 내려가면서, 강줄기 선을 따라 점을 찍어 나갑니다.{/n} \"알아차리셨습니까? 지금 "
"가장 상황이 심각한 곳은 {g|Gudrin River}구드린 강{/g}의 둑을 따라 가고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0062_Text
#. Speaker : Capital_Jhod
msgctxt "f7d2e31b-141f-4b2e-8f7a-04f999edeaea"
msgid ""
"{n}Everyone examines the map closely.{/n} \"{g|Erastil}Erastil{/g} have "
"mercy...\" {n}Jhod exhales slowly.{/n} \"Exactly! Along the river! That must "
"be where the seeds come from. From their drinking water!\""
msgstr ""
"{n}모두가 지도를 유심히 관찰합니다.{/n} \"{g|Erastil}에라스틸{/g}님이시여 자비를...\"{n}조드는 천천히 숨을 "
"내쉬었습니다.{/n} \"정확합니다! 강을 따라갑니다! 여기가 씨앗이 나오는 곳임에 틀림없습니다. 바로 사람들의 식수에서 말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0064_Text
#. Speaker : Capital_Jhod
msgctxt "27c597d5-3e40-4c4a-9562-6b46dd70eeac"
msgid ""
"\"As soon as the seed gains enough strength, it sprouts and turns into a "
"magic portal. Just like a bud turning into a flower, {g|Erastil}Erastil{/g} "
"forgive me.\" {n}Jhod stares into the distance a moment.{/n} \"Something "
"must have possessed me to say that — it really does look like blooming. Each "
"seed tears the body of it's victim, just as a flower tears its bud.\""
msgstr ""
"\"씨앗이 힘을 충분히 얻으면 싹을 틔어 마법 포탈로 변하게 됩니다. 마치 꽃 봉오리가 꽃으로 변하듯 말입니다. "
"{g|Erastil}에라스틸{/g}이여 절 용서해주소서.\"{n}조드는 잠시 먼 곳을 바라봅니다.{/n} \"차마 말씀드리기 "
"힘들지만... 이건 개화 과정같습니다. 꽃이 봉오리를 열고 나오듯 씨앗이 희생자의 몸을 찢고 나옵니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0074_Text
#. Speaker : Tristian_Companion
msgctxt "e88acd1c-06de-455d-a8bc-05859443c4ff"
msgid ""
"{n}Tristian raises his eyes from the papers on the table.{/n} \"Undoubtedly "
"from some world alien to our own. All the monsters appearing from the Bloom "
"are exceptionally large and strong — it would be rare to encounter such "
"specimens in the {g|Stolen Lands}Stolen Lands{/g}, or even on most of "
"{g|Golarion}Golarion{/g}. But it's impossible to say what it is that lies on "
"the other side of the portals that's intent on killing your people.\""
msgstr ""
"{n}트리스티안은 테이블 위의 서류로부터 시선을 옮깁니다.{/n} \"분명 어떤 외차원체가 우리에게 왔다는 것은 의심할 여지가 없습니다. "
"이 개화로부터 나온 모든 괴물들은 유난히 크고 강합니다. {g|Stolen Lands}도둑맞은 땅{/g}이나 심지어 "
"{g|Golarion}골라리온{/g} 전체에서도 이런 표본들은 접하기 힘듭니다. 하지만 차원문 반대편에서 저희 백성들을 죽이는 것이 대체 "
"무엇인지는 알 수가 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0075_Text
#. Speaker : Capital_Kesten
msgctxt "9ff7a53d-1d40-4794-9a18-2acb2041c873"
msgid ""
"\"I thank you, {mf|my baron|my baroness}. I hope you'll join us soon.\" {n}"
"Kesten gives a short bow, turns around, and leaves.{/n}"
msgstr ""
"\"감사드립니다, {mf|영주님|영주님|전하|전하}. 금방 합류하실 수 있다면 좋겠군요.\" {n} 짧게 인사하고 돌아서며, 캐스턴은 "
"떠나갑니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0076_Text
#. Speaker : Capital_Kesten
msgctxt "6aa17a63-364e-41f0-8586-bd9fbf87fab0"
msgid ""
"{n}Kesten casts his eyes down.{/n} \"You... you're right, of course, Your "
"Grace. I'll order my men to get ready immediately. We'll await your arrival "
"and then make our move.\" {n}Kesten gives a short bow, turns around, and "
"leaves.{/n}"
msgstr ""
"{n}케스턴은 시선을 아래로 향했습니다.{/n} \"당신의 말씀이 맞습니다... 제 부하들에게 즉시 대기하라고 하겠습니다. 저희는 당신의 "
"도착을 기다리고 움직이겠습니다.\" {n}케스턴은 가볍게 묵례하고 뒤돌아 떠났습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0077_Text
#. Speaker : Capital_Kesten
msgctxt "225f2f5b-7a28-4126-b377-5888cec131bc"
msgid ""
"{n}Kesten bites his lip and shifts his shoulders.{/n} \"Time is precisely "
"what we lack... Please, don't delay too long. I'll go to my men immediately. "
"I hope you'll choose to join us soon.\" {n}Kesten gives a short bow, turns "
"around, and leaves.{/n}"
msgstr ""
"{n}케스턴은 입술을 깨물며 자세를 바로합니다.{/n} \"주어진 시간이 촉박합니다... 부디 너무 늦지는 마십시요. 저는 즉시 "
"부하들에게 가보겠습니다. 곧 저희와 합류하시길 바라겠습니다.\" {n}케스턴은 가볍게 묵례하고 뒤돌아 떠났습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0079_Text
#. Speaker : NokNok_Companion
msgctxt "897e3b07-b1c4-4ad4-8b22-0700ded1c9e5"
msgid ""
"{n}Nok-Nok jumps at your words.{/n} \"Take me! Me!\" {n}The goblin bares his "
"sharp, crooked teeth.{/n} \"I want to settle the score with the king!\""
msgstr ""
"{n}녹-녹은 당신의 말에 방방 뛰었습니다.{/n} \"데려가줘! 나!\" {n}고블린이 그의 날카롭고 구부러진 이빨을 드러냅니다.{/n} "
"\"나는 왕과 사건 해결하고싶다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0082_Text
msgctxt "84b76472-c1cb-4261-ab85-f26d2070b3d9"
msgid "{n}Jhod, Kesten, and Tristian look at you closely.{/n}"
msgstr "{n}조드, 케스턴 그리고 트리스티안이 당신을 쳐다봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0086_Text
msgctxt "f8e86e61-a1b0-443f-b145-9173a9cbbdaa"
msgid ""
"{n}Kesten and Jhod exchange glances. Tristian continues to dig through his "
"papers.{/n}"
msgstr "{n}케스턴과 조드는 눈빛을 교환합니다. 트리스티안은 여전히 서류들을 검토하고 있습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0087_Text
#. Speaker : Capital_Jhod
msgctxt "03473928-8611-4763-9baf-a071f5f7cfae"
msgid ""
"\"That's a strong statement. But while you ride your high horse in here, "
"your people are dying out there, and new monsters continue to arrive. Duty "
"of the people or no, you must deal with this threat — that is the duty of a "
"ruler.\""
msgstr ""
"\"강경한 결정이로군요. 하지만 당신께서 이곳에 앉아 권력을 뽑내는 동안에도, 당신의 백성들은 죽어가고 있고, 새로운 괴물들도 계속해서 "
"오고 있습니다. 백성들의 의무이든 아니든, 당신께선 이 위협에 대처해야만 합니다. 그것이 통치자의 의무입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0089_Text
#. Speaker : Capital_Jhod
msgctxt "f379c20a-d998-4d7e-9fda-8d1074cbff0a"
msgid ""
"{n}Jhod bows his head.{/n} \"Each day, I see dozens of infected, Your Grace. "
"Many people have lost their loved ones or fear they soon will. They all want "
"to know what's going on, who deserves the blame, whose sins brought this "
"blight upon them. Trust me, every day, the number of people willing to pin "
"the blame on you grows. They say you and your barony are cursed.\""
msgstr ""
"{n}조드는 고개를 숙입니다.{/n} \"저는 매일같이 수십명의 감염자를 봅니다. 영주님. 많은 이들이 사랑하는 이를 잃거나 곧 "
"잃을거라는 두려움에 빠져있습니다. 그들이 알고자 하는 것은, 일이 어떻게 돌아가는 것인지, 누구를 비난해야 하는지, 누구의 죄로 인해 "
"이런 전염병이 일어났는지 입니다. 저를 믿으시길, 매일같이 당신께 책임을 지우려는 사람들이 늘어가고 있습니다. 그들은 당신과 당신의 "
"남작령이 저주받았다고 이야기들하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-3BloomDiscussion/Cue_0090_Text
#. Speaker : Capital_Jhod
msgctxt "1ec8b98a-53df-4b38-9f0e-20dd91871f05"
msgid ""
"\"Of course, I don't believe a word of it. This isn't a curse, but some... "
"disease, which has somehow manifested itself in your barony.\" {n}Jhod "
"raises his eyes to meet yours.{/n} \"Trust me. I won't leave you until I "
"find the source of this disease — regardless of what these poor people may "
"say in their delirium.\""
msgstr ""
"\"물론, 저는 그 말을 믿지 않습니다. 이것은 저주가 아닙니다. 단지... 남작령에 알 수 없는 원인으로 퍼져버린 질병이지요.\"{n}조드는 "
"눈을 들어 당신 눈과 맞춥니다..{/n}\"저를 믿어주십시오. 저는 이 질병의 근원을 찾을때까지 떠나지 않을 것입니다. 이 불쌍한 "
"사람들이 해대는 어떠한 헛소리에도 상관없이 말이지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/Barks/New_Clinic_String
msgctxt "cf33b4d2-2a04-4d18-82fc-6b655298b880"
msgid "Jhod Kavken's Clinic"
msgstr "조드 카브켄의 진료소"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/Barks/New_GuardAcademy_String
msgctxt "06fffa66-8fe6-48d2-9e61-f91b21b42a6b"
msgid "Kesten Garess's Guard Headquarters"
msgstr "케스턴 가레스의 경비대 본부"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/Barks/Old_Prison_String
msgctxt "e1f439f1-f6be-4472-8082-de7c80315220"
msgid "An old prison — the one the Stag Lord was using for his wine cellar."
msgstr "오래된 감옥, 한 때 숫사슴 군주가 그의 와인 저장고로 쓰던 곳입니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Answer_0006_Text
msgctxt "83ffcc1e-61e3-4323-a222-dff57f82e827"
msgid "\"What has you so excited, Jhod?\""
msgstr "\"무슨 일로 그렇게 흥분한 것입니까, 조드?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Answer_0007_Text
msgctxt "c92e68a0-00f0-4635-9be6-cab82d60ad10"
msgid "\"I don't have time right now.\""
msgstr "\"나는 지금 시간이 없소.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Answer_0008_Text
msgctxt "5ae40006-fa72-46db-9662-741d399b33ef"
msgid "\"First tell me how the barony's recovery is going.\""
msgstr "\"먼저 남작령이 복구가 어떻게 되어가는지 말해 주시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Answer_0014_Text
msgctxt "44a5ac7f-097a-4c85-8596-6a7a39d9950f"
msgid "\"The capital could use a clinic.\""
msgstr "\"수도에선 진료소를 운영할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Answer_0015_Text
msgctxt "96a47d94-59c1-4ab0-be30-31bb1d7bae65"
msgid "\"The capital could use a guards headquarters.\""
msgstr "\"수도에선 경비대 본부를 운영할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Answer_0016_AlignmentShift.Description
msgctxt "b3b2b9cb-ea0b-4924-881c-d3e4e853634f"
msgid "Decided to leave the old prison as it is."
msgstr "오래된 감옥을 그대로 두기로 결정하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Answer_0016_Text
msgctxt "972600cc-5564-41ec-9dd2-408c1eec5523"
msgid ""
"\"We can't afford extra expenditures right now. Forget about the old prison —"
" I'm sure there are other matters in need of your attention.\""
msgstr "\"우리에게 지금 추가적인 재정지출을 할 여력이 없소. 오래된 감옥은 있으시오. 우리가 주목해야 할 다른 문제들이 있소.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Answer_0026_AlignmentShift.Description
msgctxt "dae701f3-1926-4412-b7a0-02c701992035"
msgid "Decided to leave the prison as it is."
msgstr "오래된 감옥을 그대로 두기로 결정하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Answer_0026_Text
msgctxt "e906cce0-6e7e-4e25-8f9b-570f7b5687a2"
msgid ""
"\"Leave the prison as it is. I'll need a place to chain you both when my "
"patience runs out.\""
msgstr "\"감옥을 그대로 두시오. 내 인내심이 한계에 달하면 당신 둘을 매달 곳이 필요하거든.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "4cbb60c5-ac4b-4267-be63-a90387846cad"
msgid ""
"\"Your Grace, do you have a moment? {d|c22 both saved}Kesten and I{/d} have "
"a matter to discuss with you.\""
msgstr "\"잠시 시간 되시는지요? {d|c22 both saved}케스턴과 제가{/d} 당신과 상의드릴 문제가 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Cue_0002_Text
#. Speaker : Capital_Jhod
msgctxt "375adf72-e5de-41e7-b1a3-918ccf52b792"
msgid ""
"\"A wise decision, Your Grace. I'll begin the search for proper healers "
"immediately.\""
msgstr "\"현명한 결정이십니다, 전하. 적당한 치료사들을 즉시 찾아보도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Cue_0003_Text
#. Speaker : Capital_Jhod
msgctxt "219199fc-c5de-4a63-bb60-5d1a08bb76f2"
msgid "\"Agreed. I'll give the necessary orders.\""
msgstr "\"동의하오. 나는 필요한 명령을 내릴 것이오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Cue_0004_Text
#. Speaker : Capital_Jhod
msgctxt "c7f983f6-15dd-482b-8928-67e7828fdb47"
msgid ""
"\"We've argued in circles on the matter, Your Grace, but it is ultimately "
"your decision anyway. We'll abide by your orders.\""
msgstr ""
"\"저희는 문제에 대해 계속해서 평행선을 달리는 논쟁을 하고 있습니다, 전하. 그러나 최종적인 결정은 당신의 것입니다. 저희는 당신의 "
"명령을 따를 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Cue_0009_Text
#. Speaker : Capital_Jhod
msgctxt "101e9880-048e-4a34-8780-ea32a006fbd0"
msgid ""
"\"The losses were staggering. Many have died, and others have lost their "
"homes. However, life is slowly returning to normal. We've almost finished "
"clearing debris from the city, and we have guards patrolling the main routes "
"again to help refugees return home. There's still much to do, of course, but "
"the situation is improving.\" {n}Jhod takes a deep breath and folds his "
"hands on his chest.{/n} \"Now, if I may, I'd like to discuss the issue "
"Kesten and I came to you with.\""
msgstr ""
"\"손실이 엄청났습니다. 많은 이가 죽고, 다른 이들은 그들의 집을 잃었습니다. 그러나 삶은 천천히 정상으로 돌아오고 있습니다. 저희는 "
"도시의 잔해들을 치우는 것을 거의 끝마쳤고 경비대들은 다시금 주요 도로를 순찰하며 피난민들이 집으로 돌아가게끔 돕고 있습니다. 물론 아직 "
"해야할 것들이 많습니다만, 상황은 점차 나아지고 있습니다.\" {n}조드는 깊이 숨을 들이쉬며 그의 손을 그의 가슴에 포갰습니다. {/n}"
" \"이제, 가능하다면, 케스턴과 저 사이에 있었던 일에 대해 당신과 의논하고자 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Cue_0010_Text
#. Speaker : Capital_Kesten
msgctxt "1194521d-6ef6-4841-a514-76b25bcb1d5d"
msgid ""
"\"In my opinion, Your Grace, our top priority should be securing the safety "
"of the people returning to the city. I believe we should convert the old "
"prison into guards headquarters.\""
msgstr ""
"\"제 생각에는, 전하, 저희의 가장 중요한 일은 다시금 안전을 정비하여 사람들이 도시로 귀환하게끔 하는 것입니다. 저는 오래된 감옥을 "
"경비대 본부로 바꾸어야 한다고 믿습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Cue_0011_Text
#. Speaker : Capital_Jhod
msgctxt "9dccfa77-5414-4763-81ef-b0f98c10adbf"
msgid ""
"\"I'm afraid we won't be able to resolve the situation without your help. We "
"won't take much of your time, Your Grace, we just need your input on a "
"matter we've been arguing about.\""
msgstr ""
"\"당신의 도움 없이는 이 상황을 저희가 해결할 수 없다는 것이 염려스럽습니다. 저희가 당신의 시간을 많이 빼았을 수 없습니다, 전하, "
"저희는 단지 저희가 논쟁하고 있는 문제에 대해 당신의 결정을 필요로 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Cue_0012_Text
#. Speaker : Capital_Jhod
msgctxt "74818ad7-371b-4185-9ec6-d52a802186a5"
msgid ""
"\"It's about the old prison. The one we were using as a field hospital. Now "
"that the Season of Bloom has passed, the field hospital is unnecessary. "
"However, the capital would certainly benefit from having a clinic. Right "
"now, those harmed in the attack have nowhere to go to receive medical aid.\""
msgstr ""
"\"오래된 감옥에 관한 것입니다. 한 때 저희가 야전 병동으로 이용했던 것이지요. 이제 개화의 계절은 지나갔고, 야전 병동은 "
"불필요합니다. 그렇지만, 수도가 진료소를 보유함으로서 충분한 이득이 있을 것입니다. 바로 지금, 그 공격으로 인해 상처입은 자들이 치료를 "
"받기 위해 갈 곳이 어디에도 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Cue_0023_Text
#. Speaker : Capital_Kesten
msgctxt "8292a1ea-fe2b-4ad8-9083-3944823cca5b"
msgid "\"But, Your Grace, shouldn't we put the building to good use?\""
msgstr "\"그러나, 전하, 좋은 목적을 위해 그 건물을 써야 하지 않겠습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Cue_0024_Text
#. Speaker : Capital_Jhod
msgctxt "ecbdc511-e99d-4ff9-8c14-275adec969d3"
msgid ""
"\"The baron{mf||ess} is right, come to think of it. After all the horrors "
"that took place within those walls, the building would be ill-suited to be a "
"center for healing. It would only dredge up bad memories.\""
msgstr ""
"\"생각하건데, 남작{mf||여남작} 전하가 옳습니다. 모든 참상이 이 성벽안을 휩쓸었습니다, 그 건물은 그러한 고통들에 맞는 회복의 "
"공간이 되어야 합니다. 그대로는 나쁜 기억만 들추어 낼 따름입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/BothAlive/Cue_0025_Text
#. Speaker : Capital_Jhod
msgctxt "c2bf8b74-a8fa-4173-b995-46d748827744"
msgid ""
"\"I suppose that gives us our answer, then. We won't bother you with the "
"issue any further, Your Grace.\""
msgstr "\"그것이 저희에게 해답을 준다고 생각합니다. 이 문제로 더 이상 논의치 않도록 하겠습니다, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Answer_0002_Clinic_AlignmentShift.Description_String
msgctxt "ad4c6469-296d-4d83-a3ad-1c3d2bc3838d"
msgid "Founded a clinic in place of the old prison."
msgstr "오래된 감옥이 있던 곳에 진료소를 설립하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Answer_0002_Text
msgctxt "721af72f-6d38-4ebc-b375-f39da25638d7"
msgid ""
"\"We could turn the old prison into a clinic and name it after him. Would "
"that suffice?\""
msgstr "\"오래된 감옥을 그의 이름을 딴 진료소로 만들도록 하겠습니다. 그것으로 충분할지요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Answer_0010_AlignmentShift.Description
msgctxt "50ca8e39-1722-4f9e-8617-0581dcbc26aa"
msgid ""
"Preferred to save resources for the barony's sake instead of honoring Jhod."
msgstr "조드를 예우하기보다 남작령의 자원을 절약하기로 하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Answer_0010_Text
msgctxt "4fd46732-4309-44dc-8ed0-a979ff4f8b87"
msgid ""
"\"Now isn't the best time to be looking at spending treasury funds on "
"something like a memorial.\""
msgstr "\"지금은 추모와 같은 것을 위해 국고를 쓰기에 좋은 때가 아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Answer_0011_AlignmentShift.Description
msgctxt "68108830-d55d-49fe-a061-4ea278395110"
msgid "Derided Jhod's death and refused to honor the fallen."
msgstr "조드의 죽음을 비웃고, 희생자들을 예우하기를 거부하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Answer_0011_Text
msgctxt "7dbfa36a-fa14-4f9d-a648-7f4c7b19a0fe"
msgid ""
"\"Jhod, that useless old fool? Why would I pay for a memorial to someone "
"I've already forgotten?\""
msgstr "\"조드, 그 쓸모없는 멍청한 늙은이말인가? 왜 내가 이미 내 기억속에서 잊혀진 자를 위한 기념비에 돈을 써야 하지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Cue_0001_Text
#. Speaker : Capital_Kesten
msgctxt "b64cd5db-f302-4c07-87cd-ddcc6be4984a"
msgid ""
"\"Reporting in, Your Grace!\" {n}Kesten stands straight and salutes you.{/n} "
"\"The capital's rebuilding efforts are well under way. We've set part of the "
"militia to patrolling routes in and out of the city in search of any "
"remaining monsters, while others are currently assigned to helping clear "
"debris from the city. The good news is that the people are starting to "
"recover from their shock and start to get back to their normal lives. The "
"bad news... well...\""
msgstr ""
"\"보고드립니다, 전하!\"{n}케스턴은 굳게 서서 당신에게 경례했습니다.{/n} \"수도를 재건하는 노력은 계속 진행 중입니다. "
"민병대를 나누어 일부는 도시 밖의 정찰로를 따라 남은 괴물들이 있는지를 수색하며 다른 일부는 도시에 잔해를 치우는 일을 돕고 있습니다. "
"좋은 소식은 이제 사람들은 이 충격에서 벗어나 다시 정상적인 삶으로 복귀하기 시작했다는 것입니다. 나쁜 소식은...저...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Cue_0003_Text
#. Speaker : Capital_Kesten
msgctxt "12516926-fc46-4067-b0ef-20e371c2c4b1"
msgid ""
"\"We suffered heavy losses — both among the militia and the civilians. It "
"will take a long time for the barony to regain its former strength.\" {n}"
"Kesten hesitates a moment.{/n} \"I... do have one other issue that's been on "
"my mind, Your Grace...\""
msgstr ""
"\"우리는 민병대와 시민들 모두 심각한 손실을 겪었습니다. 남작령이 이전 만큼의 위세를 가지기 위해선 오랜 시간이 걸릴 것입니다.\" "
"{n}케스턴은 잠시간 망설였습니다.{/n} \"제...마음에 걸리던 문제가 하나 더 있습니다, 전하...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Cue_0004_Text
#. Speaker : Capital_Kesten
msgctxt "aa2fb910-12b0-4a38-953b-b147dd579a95"
msgid ""
"\"Jhod Kavken, your advisor and a cleric of {g|Erastil}Erastil{/g}, was "
"among those who perished. He was... {d|c22 Kesten saved}torn apart{/d} by "
"monsters. He died helping the diseased and wounded to his last breath. We "
"weren't close, but I believe honoring his memory would be the right thing to "
"do.\""
msgstr ""
"\"당신의 보좌관이자 {g|Erastil}에라스틸{/g}의 클레릭이던 조드 카브켄도 이번에 비명횡사한 사람들 중 하나입니다. "
"그를...괴물들이 {d|c22 Kesten saved}산산조각내었습니다{/d}. 마지막까지 질병에 걸린 자와 다친자들을 돕다가 "
"사망했습니다. 우리가 서로 가까운 것은 아니였으나, 그를 기리는 것이 반드시 해야 할 일이라고 믿습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Cue_0005_Text
#. Speaker : Capital_Kesten
msgctxt "b386a42c-9756-4555-90e8-151037e3cc9c"
msgid ""
"\"I'd like for you to find some way to help the barony that can do so in "
"Kavken's name. The man spent his entire life serving {g|Erastil}Erastil{/g} "
"and his congregation — and the people of this city. It would be nice to have "
"his name associated with the good he spent his life performing.\""
msgstr ""
"\"카브켄의 이름아래 당신을 위하여 남작령을 도울 수 있는 방법을 찾고자 합니다. {g|Erastil}에라스틸{/g}과 그의 신도들 "
"그리고 이 도시의 사람들을 위해 평생을 바친 남자입니다. 그가 평생을 바쳐 보여준 것 선의를 그의 이름과 함께한다면 좋을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Cue_0012_Text
#. Speaker : Capital_Kesten
msgctxt "0d233a57-bc2a-4adf-9d80-4ecd48fd05d8"
msgid ""
"\"Yes, that's a great idea, Your Grace. I... I think Jhod would appreciate "
"that.\""
msgstr "\"그렇습니다, 좋은 생각이십니다, 전하. 저는...조드도 이것을 감사하게 생각했을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Cue_0016_Text
#. Speaker : Capital_Kesten
msgctxt "615697fc-5ef4-4aae-ba6e-7dcefddb1bae"
msgid ""
"{n}Kesten bites his lip.{/n} \"You're... right, of course, Your Grace. There "
"are certainly more efficient ways to use those funds. Forgive my poor "
"judgment.\""
msgstr ""
"{n}케스턴은 입술을 세게 깨뭅니다.{/n}\"물론... 옳으신 결정입니다, 전하. 기금을 보다 유용하게 사용할 방법이 분명 있을 "
"것입니다. 제 어리석은 판단을 용서하십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Cue_0017_Text
#. Speaker : Capital_Kesten
msgctxt "6651e98f-f17e-4f47-b5d3-8f0e0b1e97f5"
msgid ""
"{n}Kesten's face turns red.{/n} \"I never thought I'd say something like "
"this, but you're...\" {n}Kesten clenches his teeth, inhales deeply, then "
"exhales loudly.{/n} \"I must go.\""
msgstr ""
"{n}케스턴의 얼굴이 붉어졌습니다.{/n} \"저는 제가 이 말을 내뱉으리라고 생각해 본 적이 없습니다. 그러나 당신은....\"{n}"
"케스턴은 그의 이를 꽉 악물더니, 깊게 숨을 들여마시고는 또다시 크게 내쉽니다.{/n}\"가봐야겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Cue_0018_Text
#. Speaker : Capital_Kesten
msgctxt "14d2e685-5085-4653-9dd3-9cc61ad776c4"
msgid ""
"\"If you have no objections, I'll take care of the arrangements personally — "
"I believe you already have enough to worry about right now. I won't take any "
"more of your time.\" {n}Kesten bows deeply.{/n}"
msgstr ""
"\"반대치 않으신다면 저는 개인적으로 준비를 갖출 것입니다. 지금 당장은 이미 충분히 염려스러우시리라 생각합니다. 더 이상 당신의 시간을 "
"빼앗지 않겠습니다.\"{n}케스턴은 깊이 허리 숙였습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/JhodDead/Cue_0019_Text
#. Speaker : Capital_Kesten
msgctxt "9e8b56cb-c475-4cf1-b6d4-fa53bb5e938a"
msgid ""
"\"I won't take any more of your time then. I have to get back to my duties.\""
" {n}Kesten steps back and bows.{/n}"
msgstr "\"더 이상 시간을 뺏지 않겠습니다. 제 의무로 돌아가 보도록 하겠습니다.\"{n}케스턴은 뒤로 물러서 인사했습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Answer_0006_GuardAcademy_AlignmentShift.Description_String
msgctxt "be51db1c-1635-4100-ba0a-b30fc3a84e52"
msgid "Founded a guard academy in place of the old prison."
msgstr "오래된 감옥이 있던 자리에 경비대 아카데미를 설립하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Answer_0006_Text
msgctxt "0164a721-d9bc-4eac-a9e9-635f17052846"
msgid ""
"\"Why don't we convert the old prison into a guard headquarters. We could "
"name it after Kesten.\""
msgstr "\"오래된 감옥을 경비대 본부로 바꾸면 어떤가. 케스턴의 이름을 따서 짓도록 하자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Answer_0015_AlignmentShift.Description
msgctxt "5cf2ef91-448b-4ab7-ad84-682515e59f92"
msgid ""
"Preferred to save resources for the barony's sake instead of honoring Kesten."
msgstr "케스턴을 기리는 대신에 남작령의 자원을 아끼는 것을 택했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Answer_0015_Text
msgctxt "0e2a9d0f-e9c7-4ff3-a997-e6c0e1914403"
msgid ""
"\"We don't have the resources right now, Jhod. It's going to take all we "
"have to finish rebuilding the capital.\""
msgstr "\"지금 당장은 자원이 없군, 조드. 수도를 재건하는데 총력을 기울여야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Answer_0016_AlignmentShift.Description
msgctxt "44316f35-6d0c-492d-9f36-e6fb33b847d8"
msgid "Derided Kesten's death and refused to honor the fallen."
msgstr "케스턴의 죽음을 조롱하고 희생된 자들을 기리는 것을 거부했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Answer_0016_Text
msgctxt "883c59f2-f991-4041-9948-c6e061468f50"
msgid ""
"\"Kesten's death was his own fault. I won't spend our limited resources "
"glorifying such a failure.\""
msgstr "\"케스턴의 죽음은 그 스스로의 잘못이야. 그런 실패를 미화하고자 한정된 자원을 낭비 할수는 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Cue_0001_Text
#. Speaker : Capital_Jhod
msgctxt "e5a38f2d-7a43-445e-85a1-c8f438f14e21"
msgid ""
"{n}Jhod's sorrow is plain on his face.{/n} \"Your Grace, if I may? I just "
"need a moment of your time.\" {n}He takes a deep breath.{/n} \"I feel it "
"only proper to honor the fallen.\""
msgstr ""
"{n}조드의 표정에 슬픔이 역력합니다.{/n} \"전하, 제가 잠시? 제게 잠시만 시간을 내 주십시오.\" {n}그는 깊은 숨을 "
"들이쉽니다. {/n} \"희생된 자들을 기리는 것이 합당하다고 생각합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Cue_0002_Text
#. Speaker : Capital_Jhod
msgctxt "a21057a9-213f-4d13-8ff7-487e626f4984"
msgid ""
"\"Things have gone horribly wrong in our barony of late. The victims are "
"counted in hundreds — it will take a long time for the barony to return to "
"its former state. We can make it, of course. But we must remember that it "
"won't be due to our efforts alone — there are those who fought and died, "
"sacrificed themselves, to make this possible. One in particular, especially —"
" {d|c22 Jhod saved}Kesten{/d} Garess.\""
msgstr ""
"\"최근의 우리 남작령에서 일들은 끔찍하게도 잘못되었었습니다. 희생자들은 수백을 헤아리고 님작령이 이전과 같이 되려면 수많은 시간이 "
"필요할 것입니다. 물론 우리는 해낼 것입니다. 그러나 우리는 그것이 우리만의 노력이 아니라는 것을 반드시 기억해야 합니다. 이를 가능케 "
"했던 사람들, 싸우고 죽어간 자들, 스스로를 희생한 자들. 특별히 한 명을 이야기 하자면 {d|c22 Jhod saved}케스턴{/d} "
"가레스입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Cue_0003_Text
#. Speaker : Capital_Jhod
msgctxt "9e2bb32d-ef29-448a-a1d6-bf89367fd9cd"
msgid ""
"\"In our darkest hour, he stood at the head of the militia and spared the "
"barony from popular unrest. If not for him, the crowd at the square would "
"have been much bigger... and much angrier. Kesten fell defending this city, "
"and I believe it's our duty to honor his memory.\""
msgstr ""
"\"우리의 가장 어려웠던 때에, 그는 민병대의 대장이 되어 민중들의 불안으로부터 남작령을 구해내었습니다. 그가 아니었다면 광장의 군중들은 "
"훨씬 더 많고...더 성이 나 있었을 것입니다. 케스턴은 이 도시를 지키다 쓰러졌고 그를 기리는 것이 이제 우리의 의무라고 생각합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Cue_0004_Text
#. Speaker : Capital_Jhod
msgctxt "a033c6ea-f3ca-40e6-bf7c-def59edce55e"
msgid ""
"\"Now, with the capital finally returning to a semblance of normalcy, I "
"think we should consider commemorating Kesten. I think the people would "
"appreciate knowing that we don't forget those who fight alongside us.\""
msgstr ""
"\"이제, 마침내 수도의 상황이 정상에 가까워졌으니, 캐스턴을 위한 추모회를 열도록 합시다. 우리와 함께 싸워주었던 전우들을 기억할 "
"것임을 공고히 한다면 백성들이 감사해 할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Cue_0010_Text
#. Speaker : Capital_Jhod
msgctxt "0a3e84b5-c796-44df-8e5a-a6b2011dbc74"
msgid ""
"\"A brilliant idea, Your Grace. Kesten would have been proud to know his "
"example will inspire new generations of the barony's defenders.\""
msgstr ""
"\"현명한 생각이십니다, 영주님. 남작령 경비대의 역사에 길이 남을 행동을 한 캐스턴은 새로운 세대의 동경의 대상과 자랑이 될 것입니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Cue_0014_Text
#. Speaker : Capital_Jhod
msgctxt "0d42ec0d-796a-4e93-aef5-02d113d4aca0"
msgid ""
"{n}Jhod bows.{/n} \"Thank you. I will personally attend to all matters "
"related to this decision you've made.\""
msgstr "{n}조드가 고개를 숙인다.{/n} \"감사드립니다. 이제 제가 개인적으로 영주님께서 내리신 결정을 처리하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Cue_0017_Text
#. Speaker : Capital_Jhod
msgctxt "d557cd14-2b5d-4b1d-9410-bf80d51076c3"
msgid ""
"{n}Jhod is silent for a moment, then sighs.{/n} \"There's truth to what you "
"say, Your Grace. We must think of the barony, not just our lost associates.\""
msgstr ""
"{n}조드는 잠시 침묵하였고, 이내 한숨쉽니다.{/n} \"당신의 말씀이 맞습니다, 전하. 저희는 이미 떠난 동료가 아니라, 남작령의 "
"미래에 대해 생각해야 할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Cue_0018_Text
#. Speaker : Capital_Jhod
msgctxt "b791b4b7-a348-4c21-966d-b92793b23b29"
msgid ""
"\"You ungrateful... That 'failure' didn't hesitate to give is life defending "
"you and this barony of yours!\" {n}Jhod shakes his head, his face red.{/n} "
"\"I... have to go. I'm sorry to take your time.\""
msgstr ""
"\"이 무슨 배은망덕한... 그 '실패'는 주저없이 목숨을 바쳐 당신과 남작령을 구했습니다!\" {n}조드는 얼굴을 가로저었고, 그의 "
"얼굴을 빨갛게 달아오릅니다.{/n} \"저는... 가보겠습니다. 당신의 시간을 뺏어 죄송합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-4HonorTheFallen/KestenDead/Cue_0019_Text
#. Speaker : Capital_Jhod
msgctxt "2abaa8a3-1ff9-42e6-bdc2-fb6912f834e7"
msgid ""
"\"I'll return to my regular duties, then. Thank you for your time.\" {n}Jhod "
"bows and turn to leave.{/n}"
msgstr "\"그렇다면 제 평소 업무로 돌아가겠습니다. 시간 내주셔서 감사합니다.\" {n}조드는 인사를 한 뒤 물러납니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-BrevisDenunciation/Answer_0007_Text
msgctxt "5ed5da95-0ddb-46c6-831e-17274f08642d"
msgid ""
"\"A potential threat or slander cannot be taken lightly. I will deal with "
"this.\""
msgstr "\"잠재적인 위협을 그냥 둘 수는 없다. 내가 해결하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-BrevisDenunciation/Answer_0008_Text
msgctxt "fa2d7288-ba73-4af1-9773-dd9df84a5c32"
msgid "\"If I happen to be in those parts, I will find out what is going on.\""
msgstr "\"그 지역에 갈 일이 생긴다면 한번 알아보도록 하지 .\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-BrevisDenunciation/Answer_0009_Text
msgctxt "77954f7f-6e81-47b1-8c17-052331ddb9a5"
msgid ""
"\"This is not a baron's concern. Tell me if you face a real rebellion, and "
"not just foolish rumors.\""
msgstr "\"이딴 일은 남작의 직무가 아니다. 반란이라도 생기지 않는 한 고작 뜬소문가지고 나를 귀찮게 하지 마라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-BrevisDenunciation/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "1a410542-6eea-42cb-a632-cb5b23521260"
msgid ""
"\"Your Grace, a while ago we received a message from the village of {g|Lake "
"Silverstep}Silverstep{/g}. More a denunciation, to be precise. A certain "
"Brevis informs us that the local settlers started believing in a creature "
"called a Silver Dragon.\""
msgstr ""
"\"영주님, 몇일 전에{g|Lake Silverstep}실버스탭{/g} 마을로부터 전갈이 도착했습니다. 사실 성토문에 가깝습니다만. "
"어떠한 정보에 의하면 지역 주민들이 실버 드래곤을 믿기 시작했다고 합니다\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-BrevisDenunciation/Cue_0002_Text
#. Speaker : Capital_Shandra
msgctxt "76c4d0ab-ef45-435b-ab26-c9189d36023a"
msgid ""
"\"Greetings, baron{mf||ess}! I will get right to the point. We've received a "
"complaint from Brevis from the {g|Lake Silverstep}Silverstep{/g} settlement. "
"He claims that a troublemaker, a hunter named Ivar, is discrediting you "
"among the local population.\""
msgstr ""
"\"안녕하십니까, {mf||여}남작님! 바로 본론으로 들어가겠습니다. 저희는 {g|Lake Silverstep}실버스텝{/g} 정착지에 "
"사는 브레비스에게 민원을 받았습니다. 문제를 일으킨 사람은 이바르라는 사냥꾼이며, 그가 지역 주민들 사이에서 당신의 평판을 떨어뜨리고 "
"있다는 내용이었죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-BrevisDenunciation/Cue_0003_Text
#. Speaker : Capital_Lander
msgctxt "e698ab78-1ddb-47d9-bc43-2de6fe18996f"
msgid ""
"\"It is my pleasure to bring a most joyous piece of news to your attention! "
"It seems we now have a rebel in our barony. That's right — one rebel! Or at "
"least we have one informer, trying to get his annoying neighbor hung from "
"the gallows.\""
msgstr ""
"\"네가 들어봐야만 하는 재밌는 소식을 전하는건 항상 즐거운 일이야! 이제는 우리 남작령에 반역자가 하나 생겼나봐. 들은대로야 — 딱 한 "
"명! 아니면 최소 한 명의 정보 제공자가, 그의 짜증나는 이웃을 교수대에 매달고 싶어하는 것일수도 있고.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-BrevisDenunciation/Cue_0004_Text
msgctxt "b142c814-d4f5-4791-abf6-d0d19a0f9905"
msgid ""
"\"A certain Brevis from a settlement on {g|Lake Silverstep}Silverstep "
"Lake{/g} informs us in a letter that a local huntsman is openly defying the "
"authority of the baron{mf||ess}. He's encouraging the settlers to worship "
"some Silver Dragon — whose representative the hunter, naturally, claims "
"himself to be. Being your most loyal subject, this Brevis could not but "
"inform you of this flagrant act of baron-bashing.\""
msgstr ""
"\"{g|Lake Silverstep}실버스텝 호수{/g} 정착지에서 찾아온 브래비스가 편지를 보냈는데, 지역 사냥꾼이 {mf||여}"
"남작님의 권위에 공개적으로 도전하고 있다고 합니다. 사냥꾼은 자신을 실버 드래곤의 대변자라 칭하며 정착민에게 실버 드래곤 신앙을 "
"설파한답니다. 이 브레비스라는 자로서는 사냥꾼의 반역 행위를 당신께 알리는 것이 최선이었겠군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-BrevisDenunciation/Cue_0005_Text
msgctxt "99845a56-71f5-4aae-955e-4529cb87b729"
msgid ""
"\"Our own messengers who have been to {g|Lake Silverstep}Silverstep{/g} "
"recently made inquiries after this hunter, but learned nothing. He rarely "
"comes to the village, and the villagers don't know anything. As for me, this "
"nonsense is not worth your attention — but it's up to you to decide, of "
"course.\""
msgstr ""
"\"최근 {g|Lake Silverstep}실버스텝{/g}으로 파견된 전령이 사냥꾼에 대해 조사를 진행했으나, 아무것도 알아내지 못했다고 "
"합니다. 그는 매우 드물게 마을로 찾아오며, 마을 사람들 또한 아무것도 모른다고 하는군요. 제 의견으로는, 그런 미신들에 일일이 신경쓰지 "
"않으셔도 될 것 같습니다 — 다만, 결정은 당신께서 하시는 것이지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-BrevisDenunciation/Cue_0010_Text
msgctxt "d172e513-14f5-42e1-a9f4-c41581c99882"
msgid ""
"\"This Ivar is persuading the villagers that the true sovereign of the lands "
"is the mighty Silver Dragon. This Dragon is stands as patron to the people, "
"and of course possesses far greater strength and power than a mere mortal "
"ruler.\""
msgstr ""
"\"이 이바르란 사람은 마을 사람들에게 이 땅의 진짜 주인이 강력한 실버 드래곤이라 설파하고 다닌다고 합니다. 이 드래곤은 민중의 편에 "
"선 후견인이며, 당연히 모든 필멸자 군주들보다 훨씬 강한 힘을 갖고있다고 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-BrevisDenunciation/Cue_0011_Text
msgctxt "728b700b-9781-4e27-a0e3-b001c0672921"
msgid ""
"\"The Dragon allegedly claims dominion over all the {g|Stolen Lands}Stolen "
"Lands{/g}, thus compromising your authority. The author of the letter "
"reports that this belief is being spread by a local huntsman named Ivar.\""
msgstr ""
"\"이 드래곤이 {g|Stolen Lands}도둑맞은 땅{/g} 전역의 지배권을 주장한답니다. 따라서 영주님의 권위에 위협이 되겠지요. "
"편지를 보낸 이는 이 드래곤에 대한 믿음을 퍼트린 사람으로 마을 사냥꾼 이바르를 지목했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-BrevisDenunciation/Cue_0012_Text
msgctxt "dc845a78-69c2-4506-a47a-43906fb5727b"
msgid ""
"\"I took the liberty of sending a few people to verify this information, but "
"they found nothing to report. The settlers wouldn't discuss it, and the "
"huntsman wasn't in the village at the time. Your Grace, the decision is "
"yours.\""
msgstr ""
"\"이 정보를 확인하기 위해 제 판단 하에 이미 사람 몇명을 보내봤습니다만, 아무 단서도 찾지 못했습니다. 마을 주민들은 언급하기를 "
"꺼려하고, 그 사냥꾼은 마을에 없었지요. 결단은 영주님께 맡기겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-BrevisDenunciation/Cue_0013_Text
msgctxt "ccd2c748-4f6f-49ca-bd6c-ef910f2824ce"
msgid ""
"\"I deeply regret that our people were unable to verify this information. "
"But I would not recommend leaving it unattended. In {g|Brevoy}Brevoy{/g} "
"know very well how quickly rebel seeds may sprout.\""
msgstr ""
"\"저는 백성들이 이 정보를 확인할 수 없었다는것이 진심으로 유감스럽습니다. 하지만 그냥 내버려두시는 것도 추천드리지는 않습니다. "
"{g|Brevoy}브레보이{/g}에서는 반란의 씨앗이 얼마나 빨리 터질 수 있는지 잘 알고 있으니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-VarnSendsHelp/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "d82b9b8c-777d-465b-bde4-f46460f4c058"
msgid ""
"\"Finally good news, Your Grace! {d|Varn}Maegar Varn{/d}, the ruler of "
"{g|Varnhold}Varnhold{/g}, has sent aid! Together with goods came a messenger "
"with {g|VarnHelp}a letter for you{/g}. Here, please, take it!\""
msgstr ""
"\"드디어 좋은 소식이 왔습니다, 영주님! {g|Varnhold}반홀드{/g}의 영주 {d|Varn}메이가르 반{/d}님이 구호물품을 "
"보내왔습니다! 물품을 전해주러 온 전령이 {g|VarnHelp}편지{/g}도 건네주었습니다. 자, 받으십시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-VarnSendsHelp/Cue_0002_Text
#. Speaker : Capital_Shandra
msgctxt "a763ff66-5d57-4721-a06c-d36d17ef69df"
msgid ""
"\"Wagon trains from {g|Varnhold}Varnhold{/g} have arrived in the capital. "
"{d|Varn}Maegar Varn{/d} sends you his regards and asks you to accept the "
"humble aid that he hopes will last you through these tough times. I think "
"there are more details in {g|VarnHelp}his letter{/g}.\""
msgstr ""
"\"{g|Varnhold}반홀드{/g}에서 온 마차 행렬이 수도에 도착했습니다. {d|Varn}메이가르 반{/d}이 당신께 안부 인사와 "
"함께, 어려운 시기를 잘 넘기길 바란다는 뜻으로 소정의 구호 물품을 보냈군요. 자세한 사항은 {g|VarnHelp}그의 편지{/g}에 "
"적혀있을겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-VarnSendsHelp/Cue_0003_Text
#. Speaker : Capital_Lander
msgctxt "b365a819-7bc5-4d57-9d6d-ba802fd83174"
msgid ""
"\"Hmm... looks like {d|Varn}Maegar Varn{/d} wants something from you, "
"{mf|Baron|Baroness}. Otherwise, why would he send you several wagon trains "
"laden with bundles and sheafs? Here's {g|VarnHelp}the letter{/g} — I think "
"it'll tell you the reason for Varn's fit of generosity.\""
msgstr ""
"\"흠... 아무래도 {d|Varn}메이가르 반{/d}이 너에게 뭔가 바라는 것 같아, {mf|남작|여남작}님. 그렇지 않다면, 왜 "
"구호품과 볏짚을 가득 실은 마차 행렬을 보내왔겠어? 여기 {g|VarnHelp}편지{/g}도 왔어 — 반이 왜 이런 관대한 선물을 "
"보냈는지 이유가 적혀있겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-VarnSendsHelp/Items/VarnSendsHelpLetter_Name_String
msgctxt "3d727ff4-0e25-476f-80cf-650852eff50f"
msgid "Message from Maegar Varn"
msgstr "메이가르 반으로부터의 전갈"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc22-VarnSendsHelp/Items/VarnSendsHelpLetter_String
msgctxt "7a79d504-f051-4c32-9b93-58e87ea04939"
msgid ""
"\"Most Honorable {mf|Baron|Baroness} {name}!\n"
"This is your good neighbor Maegar Varn, the ruler of Varnhold, writing. The "
"terrible news that your lands are being swarmed by loathsome monsters has "
"just reached me. Without wishing to cast any doubt on your valor and combat "
"prowess, I nevertheless dare suggest my help in these dark times.\n"
"Unfortunately, I cannot lend you my sword: all my warriors are busy "
"protecting our roads — there have just been too many bandits in Dunsward. "
"But as a sign of my utmost respect, I send some valuable resources along "
"with this letter. Let them serve you and your people well in these harsh "
"days.\n"
"I am sure that you would do the same in my place and would never leave "
"Varnhold without help. Therefore, do not perceive this as an attempt to "
"indebt you to myself. My help is free — I offer it of my own volition. "
"Baronies like ours need to stick together, in a steadfast alliance. If one "
"falls, the other will follow. Together, we can withstand any menace — even "
"the likes that the Stolen Lands are famed for.\n"
"P.S.: I dare not insist, knowing of your hardship, but I do remind you that "
"I would be delighted to welcome you in Varnhold at any time.\n"
"Respectfully yours,\n"
"Baron Maegar Varn\""
msgstr ""
"\"가장 명예로운 {mf|남작|여남작} {name}!\n"
"당신의 좋은 이웃이자 반홀드의 통치자 메이가르 반이오. 당신의 남작령이 혐오스러운 괴물들에게 휩쓸렸다는 끔찍한 소식을 들었다오. "
"당신의 용기와 전투력에 대해서는 어떠한 의심도 하지 않소만 그럼에도 나는 이 힘든 시기에 감히 내 도움을 제안하고자 하오.\n"
"불행히도, 나의 검을 빌려줄 수는 없소. 나의 모든 전사는 던스워드에 많아진 도적 떼들로부터 길을 지켜내느라 바쁘다오. 그러나 내 경의를 "
"표하기 위하여 나는 값진 자원들과 함께 이 편지를 보내오. 이 엄혹한 시기에 그것들을 당신과 당신의 사람들을 위해 잘 쓰기를 바라오.\n"
"나는 당신이 내 자리에 있었더라도 반드시 이처럼 했을 것이며, 반홀드를 구원치 않을 리 없다고 확신하오. 그러므로 이를 갚아야 할 "
"것으로 염려치 마시오. 나의 도움은 댓가가 필요 없고 내가 자진한 것이라오. 우리와 같은 남작령들은 함께 뭉쳐 굳건한 동맹 아래 있어야 "
"하오. 하나가 떨어지면 다른 하나도 따르게 되는 법이지. 함께, 우리는 어떤 위협도 견뎌낼 수 있소. 이 악명높은 도둑맞은 땅에서 조차 "
"말이오.\n"
"추신. 당신을 고충을 알고 있기에 감히 강권할 수 없소만, 언제든지 반홀드에 방문한다면 기쁘게 환영하리라는 것을 다시 한번 기억해 "
"주시오.\n"
"당신을 존경하는,\n"
"남작 메이가르 반\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Answer_0007_Text
msgctxt "0e90b4ce-6216-4765-8887-e5fb0e5063d0"
msgid "\"Why would the Swordlords care about Varnhold?\""
msgstr "\"왜 소드로드들이 반홀드에 관심을 가지는 것이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Answer_0008_Text
msgctxt "5bc42616-17a9-4d5f-bd40-dbfe32cb1c8d"
msgid "\"What do we know of Varnhold?\""
msgstr "\"우리가 반홀드에 대해 아는 것은 무엇인가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Answer_0009_AlignmentShift.Description
msgctxt "49bf0ee1-b141-481f-8315-f0dd81ca3b72"
msgid ""
"Demanded an explanation from Jamandi Aldori about her order to visit "
"Varnhold."
msgstr "반홀드를 방문하라는 자만디 알도리의 명령에 대하여 설명을 요구했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Answer_0009_Text
msgctxt "5c583cd8-3ed0-4a4d-bd52-1418336d463c"
msgid ""
"\"And why should I drop everything and rush to help the Swordlords? I "
"suppose that question would be better addressed to Lady Aldori. Prepare the "
"letter and send it immediately — I won't let some Restovic upstarts tell me "
"what to do, as if I were some servant.\""
msgstr ""
"\"왜 내가 모든 것을 제쳐두고 소드로드들을 돕기 위해 서둘러야 하나? 이 질문이 알도리 여사에게 더 잘 전달될 것이라 생각한다. 서신을 "
"준비해서 바로 보내도록 해. 마치 나를 하인처럼 여기는 레스토프의 건방진 자들이 나에게 뭘 하라고 말하도록 그냥 두지 않을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Answer_0010_Text
msgctxt "c1e36225-c8ea-4c04-9e44-8aba96abe0b9"
msgid ""
"\"Varnhold isn't far off. We should find out what happened there before the "
"same fate befalls us too.\""
msgstr "\"반홀드는 멀지 않다. 우리에게도 같은 운명이 닥치기 전에 그곳에서 무슨 일이 생긴 건지 알아보도록 하자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Answer_0014_Text
msgctxt "ac33eb90-36eb-4ffe-93b5-b160a0a1383d"
msgid "\"What do you think has happened to Varnhold?\""
msgstr "\"반홀드에 무슨일이 생긴거라고 생각하나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Answer_0019_Text
msgctxt "65e191f8-2457-4d15-b9a7-51cf2638a57d"
msgid "\"Maybe Varn simply decided to stop dealing with Restov?\""
msgstr "\"어쩌면 반이 레스토프와의 거래를 중단하기로 결정한 것일까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "ba81152e-4e23-4162-bb75-c72e94849776"
msgid ""
"\"Your Grace, we have urgent news from Jamandi Aldori! The Swordlord is "
"asking for aid with an unusual problem. Here is {g|JamandiVarnholdTrouble}"
"her letter{/g} — please read it when you have a moment.\""
msgstr ""
"\"나리, 자만디 알도리님으로부터 급한 소식입니다! 소드로드께서는 흔치 않은 문제에 도움을 요청하고 있습니다. "
"{g|JamandiVarnholdTrouble}그녀의 편지{/g}입니다. 시간을 내어 읽어주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0002_Text
#. Speaker : Capital_Shandra
msgctxt "fa358e07-0270-4a56-9c19-79ab6ef93c6c"
msgid ""
"\"Greetings, Your Grace. I have {g|JamandiVarnholdTrouble}an urgent "
"message{/g} from Jamandi Aldori. It seems the {g|Swordlords}Swordlords{/g} "
"have — again — proved their inability to rule their subjects. See for "
"yourself — here's the message from Jamandi.\""
msgstr ""
"\"안녕하십니까, 전하. 자만디 알도리로부터의 {g|JamandiVarnholdTrouble}급한 전갈{/g}입니다. "
"{g|Swordlords}소드로드{/g}들이 '또 다시' 그들의 백성을 다스기엔 부족하다는 사실을 증명하는 것 같습니다. 여기 자만디의 "
"전갈입니다. 직접 보시지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0003_Text
#. Speaker : Capital_Lander
msgctxt "eb650d79-dfaf-4e67-9a01-52913623ec2b"
msgid ""
"\"I bring tidings in good measure — and bad. As for the good, it seems the "
"{g|Restov}Restov{/g} Swordlord Jamandi Aldori honors us with her attention. "
"She jotted you {g|JamandiVarnholdTrouble}a nice little letter{/g}. The bad "
"tidings? She wants us to prove ourselves worthy of such recognition.\""
msgstr ""
"\"좋은 소식과 나쁜 소식이 있어. 좋은 소식은, {g|Restov}레스토프{/g}의 소드로드 알도리 자만디는 우리를 나름 예우하지. "
"그녀는 직접 당신에게 {g|JamandiVarnholdTrouble}이 작고 예쁜 편지{/g}를 썼어. 나쁜 소식은? 그녀는 "
"우리가 그러한 인식에 걸맞은지 증명하기를 원해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0004_Text
#. Speaker : Capital_Shandra
msgctxt "cbf082d5-5904-4f05-a7c2-da36b9de314d"
msgid ""
"\"She writes that a while ago she stopped receiving reports from "
"{g|Varnhold}Varnhold{/g} — a neighboring barony, established by the "
"Swordlords' protege, {d|Varn}Maegar Varn{/d}. But it is not only letters "
"that stopped coming — trade caravans, couriers, all traffic from Varnhold "
"has ceased. It is as if the barony has disappeared.\""
msgstr ""
"\"그녀는 얼마전에 {g|Varnhold}반홀드{/g}로부터 그녀에게 보고하는 것이 중단되었다고 썼습니다. 소드로드들이 후원하는 "
"{d|Varn}메이가르 반{/d}이 세운 이웃하는 남작령 말이죠. 그러나 서신만이 오는 것이 중단된 게 아니라 반홀드로부터의 교역 마차, "
"배달부, 모든 교통들이 중단되었습니다. 마치 남작령이 사라진 것처럼 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0005_Text
msgctxt "467267f9-a9cc-48fa-b99b-bd525d3f9a63"
msgid ""
"\"Jamandi Aldori expects your help with this matter, for she knows of your "
"good relations with Maegar. She asks you to go to {g|Varnhold}Varnhold{/g} "
"and find out why they have fallen silent.\""
msgstr ""
"\"자만디 알도리는 당신이 메이가르와 좋은 관계를 가지고 있다는 것을 알고 있다며 이 문제에 대한 도움을 기대하고 있습니다. 그녀는 "
"{g|Varnhold}반홀드{/g}로 가서 왜 침묵하고 있는지를 알아봐 달라고 부탁했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0011_Text
msgctxt "29a3068a-0ef9-4987-930c-c27f0f1db46f"
msgid ""
"\"Jamandi Aldori seeks allies with anyone who has proven to be trustworthy — "
"even if only a little. Considering that {g|Varnhold}Varnhold{/g} is the "
"closest thing to an outpost on the east edge of the {g|River Kingdoms}River "
"Kingdoms{/g}, it's also useful to her in keeping an eye on "
"{g|Dunsward}Dunsward{/g} and the surrounding area.\""
msgstr ""
"\"자만디 알도리는 조금이라도 신뢰할 수 있는 사람이라면 누구와도 동맹을 맺으려 합니다. {g|Varnhold}반홀드{/g}가 {g|River "
"Kingdoms}강의 왕국들{/g} 중 동쪽 끝의 전초기지와 가장 가까운 곳이라는 점을 고려하면, 그곳은 그녀가 "
"{g|Dunsward}던스워드{/g}와 그 주변 지역을 감시하는 데도 유용합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0012_Text
#. Speaker : Capital_Shandra
msgctxt "9fb0140e-fe28-4af1-95ac-eb24740ae454"
msgid ""
"\"I appreciate your determination in solving diplomatic issues — though, in "
"my opinion, you may wish to massage your wording somewhat. I'll send the "
"letter to {g|Restov}Restov{/g} immediately.\""
msgstr ""
"\"외교적 문제 해결에 있어 당신의 결심에 감사드립니다. 그런데, 제 의견을 드리자면, 좀 더 당신의 표현을 완화하는 것이 좋지 않을까 "
"합니다. 저는 서신을 바로 {g|Restov}레스토프{/g}로 보내겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0013_Text
msgctxt "70b2889d-85a3-4be2-bcbc-57615119cbd7"
msgid ""
"\"This barony is much alike your own. It was also established by a "
"mercenary, {d|Varn}Maegar Varn{/d}. He got his title at the same event you "
"did.\""
msgstr ""
"\"이 남작령은 당신의 남작령과 매우 유사합니다. 그곳 또한 용병이었던 {d|Varn}메이가르 반{/d}에 의해 설립되었습니다. 그도 "
"당신과 같은 행사에서 작위를 받았습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0015_Text
msgctxt "b682fa72-3ce2-4238-87ea-f5a3d36da83f"
msgid ""
"\"Then it's time to gather a party and head to {g|Varnhold}Varnhold{/g}, "
"Your Grace.\""
msgstr "\"그렇다면 이제 일행을 모아 {g|Varnhold}반홀드{/g}로 향할 때입니다, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0017_Text
msgctxt "ebc3a856-8dee-48da-98cb-f40b757e8df0"
msgid ""
"\"{d|Varn}Maegar Varn{/d} is third or fourth son in the family, so he "
"couldn't claim his father's inheritance. Looks like he hoped to establish a "
"settlement of his own and gain wealth and prosperity that way.\""
msgstr ""
"\"{d|Varn}메이가르 반{/d}은 그의 가문의 셋째 또는 넷째 아들이기 때문에, 그는 그의 아버지의 상속권을 주장할 수 없었습니다. "
"그는 자신만의 정착지를 세우고 부와 번영을 그 방식으로 얻기를 희망하는 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0018_Text
msgctxt "dd930a13-1afb-400a-a998-7bf86456601f"
msgid ""
"\"Hmmm... a riot? A rebellion? But if that were the case, there would be "
"refugees. Whatever happened there, it must have been sudden indeed — perhaps "
"a bandit attack, barbarians, a plague… whatever it was, no one outside "
"{g|Varnhold}Varnhold{/g} seems to know what happened.\""
msgstr ""
"\"흐으음...폭동? 반란? 만약 그런 경우라면, 피난민들이 있었어야 할 것입니다. 그곳에서 무슨 일이 벌어졌건, 갑작스러운 일이었을 "
"것입니다. 아마도 도적떼의 공격이나, 야만인들, 전염병… 무슨 일이었건 간에, {g|Varnhold}반홀드{/g}의 밖에서 누구도 "
"무슨 일이 있었는지를 알지 못하는 것 같습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0020_Text
msgctxt "5ac54445-2088-4991-be8f-97f70f6f1c5b"
msgid ""
"\"Judging by Aldori's letter, the silence doesn't seem voluntary. Otherwise "
"at least one person would have reached a neighbor and spoken about what had "
"happened there.\""
msgstr ""
"\"알도리의 편지를 보면, 이 침묵은 자발적인 것이 아닌 것으로 보입니다. 그렇지 않았다면 적어도 한 명은 이웃에게 연락하여 "
"그곳에서 일어난 일에 대해 이야기했을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0021_Text
#. Speaker : Capital_Lander
msgctxt "a767dd3d-2943-4c82-831b-4950d52b1a78"
msgid ""
"\"You really know how to talk to those insolent {g|Swordlords}Swordlords{/g}"
"! I'll just go ahead and add some lines of my own to your letter.\""
msgstr ""
"\"당신은 이 무례한 {g|Swordlords}소드로드{/g}들과 어떻게 대화할지를 아는군! 내가 가서 네 편지에 몇 줄을 추가해 두지."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0022_Text
#. Speaker : Capital_Kassil
msgctxt "ca272084-50b1-4c54-8391-41a6d0feb38a"
msgid ""
"\"How dare you, {mf|baron|baroness}?! You owe much to Lady Jamandi, yet you "
"repay her with insults? Fine, I'll compose the letter, though I'll use "
"milder expressions — as for you, you should go and solve the mystery of "
"{g|Varnhold}Varnhold{/g}!\""
msgstr ""
"\"{mf|남작|여남작}, 어떻게 감히?! 당신은 레이디 자만디에게 많은 것을 빚 졌는데, 이렇게 그녀를 모욕하는 것으로 답하다니? "
"좋소, 내가 좀더 유한 표현으로 당신을 위해, 편지를 작성하겠소, 당신은 {g|Varnhold}반홀드{/g}로 가서 그 수수께끼를 "
"해결하시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0023_Text
#. Speaker : Capital_Kassil
msgctxt "50f2f9c7-d0c1-43b5-a7b0-4cee012c9523"
msgid ""
"\"Lady Aldori asks you to head to {g|Varnhold}Varnhold{/g} at once — it's a "
"barony led by {d|Varn}Maegar Varn{/d}, a brave soul who carved out the "
"settlement from the wilderness. Until recently he eagerly... and "
"frequently... relayed to the {g|Swordlords}Swordlords{/g} his many "
"successes, but then the letters suddenly ceased. As you may expect, this is "
"a matter of some concern!\""
msgstr ""
"\"알도리 경께서는 당신이 황무지에서 정착지를 쌓아올린 용감한 {d|Varn}메이가르 반{/d}이 이끄는 남작령인 "
"{g|Varnhold}반홀드{/g}로 단번에 향하기를 요청하셨습니다. 최근까지 그는 열성적으로...그리고 "
"자주...{g|Swordlords}소드로드{/g}들께 그의 많은 성공들을 전달하고 있었습니다, 그런데 갑작스레 그 편지들이 끊겼습니다. "
"당신이 예상하시듯이, 이는 다소 중요한 사건입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Cue_0024_Text
#. Speaker : Capital_Lander
msgctxt "c1af8cd6-e9f1-41eb-8b71-55d020a49d26"
msgid ""
"\"Remember that annoying {d|Varn}Maegar Varn{/d}, who couldn't stop "
"pestering you? Seems like he grew tired of Aldori's leash, so he stopped "
"answering the {g|Swordlords}Swordlords{/g}' letters. But Varn alone wouldn't "
"raise so much concern — according to the letter, the settlement itself seems "
"to have vanished!\""
msgstr ""
"\"귀찮고 성가신 {d|Varn}메이가르 반{/d}을 기억하나? 아무래도 그는 "
"알도리의 목줄에 지쳐서, {g|Swordlords}소드로드{/g}의 편지에 답장하는 것을 멈춘 모양이야. 그러나 반 그 "
"혼자라면 별로 걱정할 거리가 아니겠지. 편지에 따르면, 그 정착지 자체가 사라져 버렸다고 하는군!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Item/JamandiLetter-VarnholdTroubleName_String
msgctxt "0782f22f-1ba9-4d36-a41b-ac0c9b6ced44"
msgid "Letter from Jamandi Aldori"
msgstr "자만디 알도리로부터의 편지"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-EnvoyVarnholdIntro/Item/JamandiLetter-VarnholdTrouble_String
msgctxt "4eed37ab-073f-41ac-a5d5-548e06736d4a"
msgid ""
"\"{name},\n"
"I have a problem, and no one else to turn to but you. I need someone to "
"travel to a town south of Restov, Varnhold. The town was founded by Maegar "
"Varn — you met him at the reception to celebrate your new title.\n"
"Recently, I've stopped getting reports from him. I didn't pay much attention "
"to it, but in the past week, not a single traveler, merchant, or messenger "
"from Varnhold has showed up in Restov. No one knows what has happened to the "
"town.\n"
"If I were you, I would make sure I was ready for this journey: the plains of "
"Dunsward are dangerous. Also, we have yet to find out what was it that cut "
"off communication with Varnhold: an attack, arcane magic, or some epidemic "
"or plague. I would have gladly investigated the matter, but the current "
"state of affairs dictates I refrain from dealing with this personally. I am "
"counting on you and your help: head out for Dunsward and find out what — or "
"who — stands behind the vanishing of Varnhold.\n"
"Your friend and ally,\n"
"Swordlord Jamandi Aldori\""
msgstr ""
"\"{name},\n"
"문제가 생겼는데, 당신 말고는 의지할 사람이 없습니다. 레스토프 남쪽에 있는 마을 반홀드까지 다녀올 사람이 필요합니다. 그 마을은 "
"메이가르 반이 세운 곳입니다 — 당신의 새 작위를 기념하는 연회에서 만났었죠.\n"
"최근에, 그로부터 보고받지 못하였습니다. 별로 신경을 쓰지 않았는데, 지난 일주일 동안 레스토프에 반홀드에서 온 "
"여행자, 상인 또는 전령이 단 한명도 나타나지 않았습니다. 그 마을에 어떤 일이 있었는지 아무도 모릅니다.\n"
"나라면 이 여정에 대한 준비를 단단히 할 것입니다. 던스워드의 평원은 위험한 곳입니다. 그리고, 우리는 계속해서 습격이나, 비전 마법, "
"또는 천재지변이나 전염병 등과 같은 어떤 것이 반홀드와의 연락을 끊어버렸는지를 찾아내고 있습니다. 기꺼이 이 문제를 조사하고 "
"싶지만, 현재의 상황은 제가 개인적으로 이 문제를 해결하지 못하게끔 하고 있습니다. 나는 당신과 당신의 도움을 믿겠습니다. "
"던스워드로 가서 반홀드가 갑자기 사라진 배후에 무엇이 — 혹은 누가 — 있는지 알아내 주세요.\n"
"당신의 친구이자 동맹,\n"
"소드로드 자만디 알도리\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-JamandiAnswersReinforcedChaotic/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "db81358e-3f2e-4aa5-af38-efc45f3b838e"
msgid ""
"\"Your Grace, Lady Jamandi sent {g|JamandiExcuses}an answer{/g} to your "
"hasty message. Luckily, the Swordlord took your quick temper into account, "
"and decided to resolve the situation peacefully. Furthermore, a caravan has "
"come from {g|Restov}Restov{/g}, carrying resources for the barony! I hope "
"now you will be able to appreciate the generosity of the Aldori!\""
msgstr ""
"\"전하, 레이디 자만디께서 당신의 성급한 메세지에 대한 {g|JamandiExcuses}답신{/g}을 보내오셨습니다. 다행히도, "
"소드로드께선 당신의 급한 성미를 염두해 두시고, 상황을 평화롭게 해결하시기로 결정하셨습니다. 나아가, {g|Restov}레스토프{/g}"
"로부터 남작령을 위한 자원을 실은 캐러반이 오고 있습니다! 이제 당신께서 알도리의 관대함에 감사를 표하기를 바랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-JamandiAnswersReinforcedChaotic/Cue_0002_Text
#. Speaker : Capital_Shandra
msgctxt "420037a7-6903-4023-b963-93ad2c132e98"
msgid ""
"\"Your Grace, {g|JamandiExcuses}a letter{/g} from Jamandi Aldori arrived. It "
"seems the {g|Swordlords}Swordlords{/g} have their tails between their legs: "
"they sent a whole caravan of valuable goods along with the letter. Jamandi "
"Aldori must be in a perilous situation, if she's inducing Your Grace with "
"gifts. Here, take the letter.\""
msgstr ""
"\"전하, 레이디 자만디의 {g|JamandiExcuses}답신{/g}이 도착하였습니다. {g|Swordlords}소드로드{/g}들은 "
"풀이 죽은 것 같습니다. 그들은 편지와 함께 값나가는 상품들을 실은 캐러반 전체를 보내었습니다. 자만디 알도리가 선물로 당신을 유도하는 "
"것이라면 그녀는 위험한 상황에 처하게 될 것입니다. 여기, 편지가 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-JamandiAnswersReinforcedChaotic/Cue_0003_Text
#. Speaker : Capital_Lander
msgctxt "454afd1c-0d8c-4c56-a98a-3b0dadd0d692"
msgid ""
"\"You won't believe it, Your Grace! Today a caravan entered the city, filled "
"with generous gifts from {g|Restov}Restov{/g}! I wonder who could have sent "
"it. Maybe a certain lady was impressed by our determination? Bravo, Your "
"Grace — I salute your {d|c31 Jamandi Chaotic}aggressive diplomacy{/d} "
"skills! Here, see for yourself — it's {g|JamandiExcuses}a letter{/g} from "
"Jamandi Aldori!\""
msgstr ""
"\"아마 내 얘길 들어도 믿지 못할 거야. {g|Restov}레스토프{/g}에서 선물이 담긴 마차를 보냈어! 대체 마차의 주인이 누군지 "
"궁금하군. 당신의 결단력에 탄복한 여느 귀부인이려나? 세상에, 전하. 당신의 {d|c31 Jamandi Chaotic}공격적인 외교("
"aggressive diplomacy){/d} 기술에 경의를 표하지! 자, 직접 봐 자만디 알도리로부터 온 "
"{g|JamandiExcuses}편지{/g}야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-JamandiAnswersReinforcedChaotic/Item/JamandiLetter-ExcusesName_String
msgctxt "5d8a5fac-026e-4bf0-927b-4d89aae5d2a8"
msgid "Letter from Jamandi Aldori"
msgstr "자만디 알도리로부터의 편지"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-JamandiAnswersReinforcedChaotic/Item/JamandiLetter-Excuses_String
msgctxt "394187fe-e2e0-453c-9b6e-9fc311ea208f"
msgid ""
"\"{name},\n"
"I knew the day would come when you began to doubt me. At least you didn't "
"proceed immediately to bite the hand that feeds you. It is a fair question, "
"what reasons led me to write to you when I could have traveled to Varnhold "
"myself. Well then, let me lay my cards on the table.\n"
"There are reasons for this, grave reasons indeed. The threat of Numeria "
"looms over Rostland. More and more, barbarians make their way into our lands "
"and attack our caravans. Our scouts report that barbarian tribes gather on "
"our borders. I would have gladly turned from this crisis and dealt with "
"Varnhold myself, were it not for my sentimental attachment to my country, my "
"city and its people, who are about to be swallowed up by the Numerian hydra "
"that crawls towards us from the east. Of course, Restov does have a ruler — "
"but it would be ignoble to leave Lord Mayor Sellemius without my support in "
"such a difficult time.\n"
"There was no one I could ask for help but you. I ask of you, as an old "
"comrade in arms: gather your men and discover what has happened in Varnhold —"
" at least so that whatever devoured its inhabitants doesn't find its way to "
"your own subjects.\n"
"P.S. I've sent some resources along with this letter. Consider them a sign "
"of my good will, and an expression of my gratitude for your help.\n"
"Your friend and ally,\n"
"Swordlord Jamandi Aldori\""
msgstr ""
"\"{name},\n"
" 당신이 저를 의심하는 순간이 조만간 찾아올거라 생각했습니다. 최소한 당신은 먹이를 주는 손을 곧바로 물지는 않았지만요. 어떤 이유 "
"때문에 제가 직접 반홀드로 가지 않고 당신에게 편지를 쓰는지 궁금하다면, 공정한 질문입니다. 그러면, 이제 제 손의 카드를 먼저 "
"공개하겠습니다.\n"
" 제게도 문제가 하나 생겼습니다, 사실 중대한 문제죠. 누메리아의 위협이 로스틀랜드까지 뻗쳐왔습니다. 점점 더, 많은 야만인들이 우리 "
"영토로 넘어와 행상인들을 공격하고 있습니다. 정찰병들이 보고하길 야만인 부족들이 우리 국경까지 몰려왔다고 하더군요. 저는 기꺼이 이 "
"위협으로부터 떨어져서 제 스스로 반홀드의 문제를 해결했을겁니다, 제 국가, 제 도시, 동쪽으로부터 기어온 누메리아의 히드라에게 삼켜지기 "
"직전인 제 국민들과의 유대가 없었다면 말입니다. 물론, 레스토프에도 통치자가 있습니다 — 하지만 이런 어려운 시점에 셀레미우스 시장을 "
"돕지 않고 떠난다는 것도 비열한 짓일 겁니다. \n"
" 당신의 도움 말고는 어떤 선택지도 남아있지 않았습니다. 옛 전우로써, 요청드립니다: 동료들을 모아 반홀드에서 무슨 일이 일어났는지 "
"확인해 주십시오 — 최소한 그곳의 주민들을 삼켜버린 무언가가 당신의 백성들을 향해 다가가지 않도록 하기 위해서라도 말입니다.\n"
" P.S. 편지와 함께 약간의 구호 물품을 보냅니다. 제게 나쁜 뜻이 없다는, 또한 당신께 도움을 받는데 대한 감사의 표현이라는걸 "
"고려해주시길.\n"
" 당신의 친구이자 동맹,\n"
" 소드로드 자만디 알도리\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Answer_0004_Text
msgctxt "2746ff87-8c47-4708-9399-b11214418589"
msgid ""
"\"I thank you for honoring me with your visit. To what do I owe the pleasure?"
"\""
msgstr "\"그대의 방문은 내게 영광이오. 어떤 즐거움을 주려고 오셨습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Answer_0005_Text
msgctxt "33f52db2-2793-42f2-a81f-cc208109fdfa"
msgid "\"What happened? Be quick — I don't have much time.\""
msgstr "\"무슨 일이지? 빨리 말하라, 난 시간이 많지 않다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Answer_0006_Text
msgctxt "b1992993-4818-44ea-9297-ea4b5f040826"
msgid "\"I have no time for this. Come visit me next time.\""
msgstr "\"이 일을 처리할 시간이 없소. 다음번에 내게 오시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Answer_0011_Text
msgctxt "67372c34-fb01-4513-b266-9f2c2af764cf"
msgid "\"Tell me about your brother.\""
msgstr "\"당신의 형제에 대해 말해보시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Answer_0014_Text
msgctxt "2d0417ab-a0db-43db-a060-de505ae95e52"
msgid "\"Tell me about your family.\""
msgstr "\"당신의 가문에 대해 말해보시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Answer_0015_Text
msgctxt "623d9ba4-e7d6-495a-9e07-dea1ba39ab5b"
msgid ""
"\"I have bad news for you. Your brother is dead. I found this letter on his "
"body.\""
msgstr "\"좋지 않은 소식이 있소. 당신의 형제는 죽었소. 나는 그 시체에서 이 편지를 찾아냈소.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Answer_0016_Text
msgctxt "923626c3-364d-4ee6-9bbf-b17527c62fe4"
msgid "\"Tell me about your great-grandfather.\""
msgstr "\"당신의 증조부에 대해 말해보시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Answer_0017_Text
msgctxt "72f93049-3994-4d79-ac2c-e52a4e18a46e"
msgid ""
"\"Take a look at this letter. It's related to your family. I found it on a "
"dead body lying in an ancient cyclops's tomb.\""
msgstr "\"이 편지를 한번 보시오. 당신의 가족에 관한 것이오. 이 편지를 고대의 사이클롭스의 무덤에 뉘여 있던 시체로부터 찾았소.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Answer_0018_AlignmentShift.Description_1
msgctxt "a70c01e9-3e8a-4325-9b5d-658c90893d2a"
msgid "Executed the noble from Gralton."
msgstr "그랄튼으로부터 온 귀족을 처형하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Answer_0018_Text
msgctxt "6fbc1ed3-7b5f-49b3-9afc-703149b072ef"
msgid ""
"\"Seems to me that you're not a noble, but rather a spy. Guards, come here! "
"Execute him!\""
msgstr "\"나에게 당신은 귀족이 아니라 첩자로 보이는군. 경비병, 이자를 처형하라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Answer_0019_Text
msgctxt "40ceed9e-3806-46c8-8a26-b4ecffd36610"
msgid "\"I'll see what I can do for you. Farewell.\""
msgstr "\"당신을 위해 할 수 있는 일을 찾아보겠소. 안녕히 가시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Answer_0031_Text
msgctxt "6e8c797d-4220-408f-9f90-35be4cb4e21a"
msgid "\"Farewell.\""
msgstr "\"안녕히 가시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Answer_0034_Text
msgctxt "2696d4ec-9ff6-47b7-9484-395245c98ac8"
msgid "\"I have bad news for you. Your brother is dead.\""
msgstr "\"나쁜 소식이오. 당신 형제는 죽었소.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0001_Text
msgctxt "d9252515-fcab-4679-872c-ddd86b3c8143"
msgid ""
"{n}A young man wearing fancy clothes, with delicate features and perfect "
"posture, gives you a precisely measured light bow.{/n} \"Your Grace, allow "
"me to introduce myself. I'm Edrist Hanvaki. I beg you to give me a moment of "
"your precious time.\""
msgstr ""
"{n}우아한 외모에 멋진 옷을 입은 반듯한 자세의 젊은이가 당신에게 정중하게 인사를 합니다.{/n}\"전하, 제 소개를 하겠습니다. 저는 "
"에드리스트 한바키라고 합니다. 제게 귀중한 시간을 내어 주시기를 간청합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0002_Text
msgctxt "bf588b05-9621-4181-890b-707b8c61d284"
msgid "\"Did you manage to find anything?\""
msgstr "\"무어라도 찾았습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0008_Text
msgctxt "2e249006-5dda-49bd-b7d7-42baa9c9c380"
msgid ""
"{n}A surprised expression appears on the young man's face, but he conceals "
"it behind a polite smile.{/n} \"Such flawless courtesy! I can see you are a "
"true noble, unlike some imposters from the {g|River Kingdoms}River "
"Kingdoms{/g}... Let me get straight to the point of my visit, for it is the "
"matter of utmost importance.\""
msgstr ""
"{n}젊은이의 얼굴에 놀란 표정이 나타났지만, 그는 공손한 미소 뒤에 이를 감추었습니다.{/n} \"이토록 흠잡을 데 없는 예법이라니! "
"당신이 {g|River Kingdoms}강의 왕국들{/g}의 다른 사기꾼들과는 달리 진정한 귀족이시군요... 매우 "
"중요한 문제이니 제가 알현을 한 이유부터 말씀드리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0009_Text
msgctxt "21d573d6-537f-4dc7-959d-154f57aeff55"
msgid ""
"{n}The young man winces, but he forces a polite smile on his face.{/n} \"As "
"you wish.\""
msgstr "{n}이 젋은이는 움찔거렸으나, 공손한 미소를 얼굴에서 놓지 않았습니다.{/n} \"원하시는 대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0010_Text
msgctxt "720a4ae3-d778-4a62-aa36-f2ed401ae97b"
msgid ""
"\"Your Grace! I beg you to hear me out! It's a matter of life and death!\""
msgstr "\"전하! 제 말을 들어주시시옵소서! 사느냐 죽느냐의 문제입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0012_Text
msgctxt "2122fc28-a516-490a-be84-c5404aeed30f"
msgid ""
"\"A tragedy has brought me here — one that has been looming over my family "
"for a while, or perhaps one that has already come to pass. You see, Your "
"Grace, two months ago my elder brother, Tomin Hanvaki, went missing. After "
"leaving Gralton, where our family resides, he headed northwest. His "
"destination, as we found out later, was a village called "
"{g|Varnhold}Varnhold{/g}, but he never arrived there. Your capital is the "
"last place he was seen alive.\""
msgstr ""
"\"이미 죽어 있을지도 모르는 제 가족의 행방을 여쭙기 위해 이렇게 찾아왔습니다. 전하, 두 달 전 제 형님인 토민 한바키가 실종되었습니다. "
"저희의 고향인 갈톤을 떠나 북서쪽으로 향했습니다. 나중에 알게 된 바에 따르면 형님의 목적지는 {g|Varnhold}반홀드{/g}"
"라는 마을이었는데, 그는 그곳에 도착하지 못했습니다. 영주님의 수도가 마지막으로 형님이 목격된 곳입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0020_Text
msgctxt "17dc3d1f-4b3d-49c2-9bed-858baedb87eb"
msgid ""
"\"Our family, no matter how venerable, has always carried a spirit of... "
"adventurousness, if you will, in our blood — a thirst for risk and exploits. "
"Each generation has had its own daredevil who left all he owned and went "
"chasing after some ghostly treasures, completely ignoring the tears of his "
"loved ones... I'm afraid this family curse has befallen my brother now. If "
"only I knew what exactly he was looking for, or where exactly he was going! "
"Sadly, all I've managed to learn was the name of some village out in the "
"middle of nowhere, {g|Varnhold}Varnhold{/g} — along with the fact that my "
"brother never arrived there.\""
msgstr ""
"\"저희 가문은 유서가 깊지만, 저희 혈통에는 조금... 괴상한 본능이 있습니다. 위험을 감수하고 위업을 이루려는 모험심이 바로 "
"그것입니다. 한 세대에 꼭 한 명씩은 보물을 찾아 모험을 떠나곤 했지요. 가족들의 눈물을 못 본 척하면서 말입니다... 안타깝게도 이 "
"가문의 저주가 이제는 제 형님을 현혹했나 봅니다. 형님의 목적이 무엇이고 어디로 갈 건지 미리 알았더라면 얼마나 좋았을까! 유감스럽게도 "
"북쪽 어딘가에 있는 {g|Varnhold}반홀드{/g}라는 마을 이름과 그곳에 형님은 없다는 정보 말고는 알 수 있는 것이 없었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0021_Text
msgctxt "293522d7-05e8-49e3-8dfa-642335b029e0"
msgid ""
"\"The Hanvakis are an ancient family with a long history, hailing back to "
"the days before Gralton's founding. Unfortunately, our wealth has been "
"depleted by a series of reckless ventures — like the one my brother is "
"partaking in right now. Family archives, some heirlooms, and our honor — "
"these are all the treasures our once influential house has come to possess.\""
msgstr ""
"\"한바키 가문은 오랜 역사를 지닌 유서 깊은 가문입니다, 갈톤이 생기기도 전에 존재했었지요. 안타깝게도 저희의 재산은 꽤 줄어든 "
"상태입니다. 지금의 형님처럼 모험을 좋아하는 가문의 일원들이 재산을 탕진했기 때문이죠. 한 때 영광스러웠던 가문은 이제 업적, "
"유산, 명예밖에 남지 않았습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0022_Text
msgctxt "0efb6559-b432-4fb5-8c2f-e4c35645f651"
msgid ""
"\"Mathian Hanvaki was known for his bravery and recklessness. When our "
"family was dealing with some financial difficulties, his best idea was to "
"leave his family estate, his wife, and his children in the care of his "
"brother and go off treasure hunting with a group of... daredevils of the "
"same kind, let's say. No one has seen him since. Unfortunately, stories like "
"this aren't unusual in our family. Stories about the exploits of my great-"
"grandfather have become legends, the bards praised his courage... Too bad no "
"one wrote any songs about his widow and everything the poor woman had to "
"endure.\""
msgstr ""
"\"마티안 한바키는 용감함과 무모함으로 유명했습니다. 우리 가문이 재정적인 위기를 겪을 때, 그가 도출해낸 최고의 결론은 영지와, "
"아내와, 아이들을 동생의 손에 맡기고 무리를... 말하자면, 같은 종류의 무모한 모험가들을 모아 보물 사냥을 떠나시는 거였죠. 그 뒤로는 "
"아무도 그를 보지 못했습니다. 불행히도, 이런 이야기는 저희 가문에서 드물지 않습니다. 증조부의 업적들에 관한 이야기는 전설이 되었고, "
"음유시인들이 그의 용기를 찬양했습니다... 나쁜 소식은 아무도 그가 두고 떠난 과부와, 불쌍한 여성이 견뎌내야 했던 모든 것들에 대한 "
"이야기는 만들지 않았다는거죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0023_Text
msgctxt "4a5a72a9-5aff-4177-b866-c27cd48a275d"
msgid ""
"\"Is that so... My poor father won't be able to cope with such a loss... "
"What have you done, Brother! And for what?\" {n}After reading the letter, "
"Edrist sighs bitterly and shakes his head in dismay.{/n} \"So, that's how it "
"all started. My brother found our great-grandfather's letter in the family "
"archives, and he decided to follow his example... And most unfortunately, he "
"did.\""
msgstr ""
"\"그렇습니까... 제 불쌍한 아버지는 그런 손실을 감당할 수 없으셨을겁니다... 너는 무엇을 해낸 것이냐, 형제여! 그리고 무엇을 위해 "
"떠났느냐?\" {n}편지를 읽은 뒤, 에드리스트는 슬픔에 차 한숨을 쉬었으며, 실망감으로 고개를 가로젓습니다.{/n} \"그래서, 이렇게 "
"모든 게 시작되었군요. 제 형제는 가문의 서재에서 증조부의 편지를 찾아냈고, 그의 전철을 밟기로 결정했습니다... 그리고 더 불행하게도, "
"그는 죽었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0024_Text
msgctxt "30a8be46-3736-42e2-aa81-796082b1233d"
msgid ""
"{n}Edrist grabs the letter eagerly and starts reading it line by line, faded "
"though it is with time.{/n} \"A tomb of cyclopes! Looks like you shed light "
"on one of the secrets of our family. The bones you found were the remains of "
"my great-grandfather, Mathian Hanvaki.\""
msgstr ""
"{n}에드리스트는 열정적으로 편지를 낚아챘고, 세월에 젖어 희미해진 편지를 한 줄 한 줄 읽어나가기 시작합니다.{/n} \"사이클롭스의 "
"무덤이라니! 당신께서 저희 가문의 비밀 하나를 밝히신것 같군요. 거기서 발견한 뼈들은 제 증조부이신 마티안 한바키의 것이었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0025_Text
msgctxt "30fa1272-d66c-46ef-880c-d9b594e19629"
msgid ""
"\"No! No, wait! I beg you…\"{n}Ignoring his shouts, the guards drag Edrist "
"away.{/n}"
msgstr "\"안됩니다! 제발, 기다려주세요! 부탁드립...\" {n}그의 절규를 무시한 채, 경비병은 에드리스트를 끌어냅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0026_Text
msgctxt "70b46d4e-cb0e-41e7-a8a6-9078683cb954"
msgid ""
"\"We don't know where he is or whether he's still alive. Our poor father is "
"losing his head in grief. Please, help us to learn something about the fate "
"of my brother, and you'll gain an eternally loyal ally.\""
msgstr ""
"\"형님이 살았는지 죽었는지도, 어디있는지도 모르는 상황입니다. 저희의 아버지는 큰 비탄에 빠진 채 지내고 계십니다. 제발 간청하옵니다, "
"제 형님의 생사에 대해 알아내 주신다면 저희 가문이 영원한 충성을 바치겠습니다 .\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0028_Text
msgctxt "4348d8d0-b962-45e1-8aec-127289cdaeb9"
msgid ""
"\"This means I'm the heir of the title now... But this doesn't give me the "
"tiniest trifle of joy, believe me. Well. I'll have to stay in your capital "
"for a while. If during your travels you happen find yourself in this ill-"
"fated tomb, do me a favor and tell me what two Hanvaki daredevils died for.\""
msgstr ""
"\"이로써 지금부터 제가 가주로군요... 하지만 아주 작고 하찮은 기쁨조차도 얻지 못하겠습니다, 믿으십시오. 그렇게 되었군요. 저는 "
"얼마간 당신의 수도에 머무르겠습니다. 만약 여행중에 저 끔찍한 비밀을 간직한 무덤을 발견하게 되신다면, 자비를 베푸시어 두 명의 무모한 "
"한바키들이 뭘 위해 죽었는지 알려주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0029_Text
msgctxt "0b7075a3-8381-4b8f-ba05-3e6bf4a7e2b3"
msgid ""
"\"Well, the picture's perfectly clear now. Oh, if only this ill-conceived "
"letter had been lost to time, if my poor brother hadn't found it and been "
"infected with this deadly craving for adventure! Well, Your Grace... Today "
"I'll leave for Gralton — the city in which, from this day on, you will have "
"a loyal friend and ally.\""
msgstr ""
"\"그러면, 이제 모든것이 명확해졌군요. 오, 이 잘못된 운명의 편지가 시간과 함께 사라졌었다면, 내 불쌍한 형제가 이 편지를 찾지 "
"못하고 모험을 향한 치명적인 갈망에 전염되지 않았더라면! 감사합니다, 전하... 오늘 그랄튼으로 떠나겠습니다 — 오늘부로, 당신께서 "
"충성스러운 친구이자 동맹을 얻게 된 도시죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0030_Text
msgctxt "64542711-f880-4cdb-9b4b-ccf7d0073f76"
msgid ""
"\"All I can do is pray my brother has been spared the same fate. I beg you "
"to find him!\""
msgstr "\"제가 할 수 있는건 형님이 같은 운명을 맞이하지 않았길 바라는것 뿐입니다. 제발 그를 찾아주십시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0032_Text
msgctxt "a114229c-bd74-4ba6-aa48-2eb80fbdfb8b"
msgid "{n}Edrist gives you a bow and leaves the room.{/n}"
msgstr "{n}에드리스트는 당신에게 인사한뒤 선술집을 나갔습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0033_Text
msgctxt "24699496-ab88-48af-9562-115a908ab280"
msgid "\"I look forward for any news you may find.\""
msgstr "\"좋은 소식을 기다리고 있겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc31-LostNoble/Cue_0035_Text
msgctxt "a44bc63b-2700-45df-b07a-196b2e7e5bf8"
msgid ""
"\"Is that so... Do you have any proof of his death that I could present to "
"our father?\""
msgstr "\"그렇습니까... 혹시 제 아버지께 드릴만한 어떤 증거물이라도 찾으셨습니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Answer_0006_Text
msgctxt "cc9b8840-578b-46d0-9851-6849e2ece6e9"
msgid "\"What's going on at Candlemere?\""
msgstr "\"캔틀미어에 무슨일이 일어나고 있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Answer_0010_Text
msgctxt "7ed15a4b-4bed-4776-a467-cb10784fb422"
msgid "\"What's happening in Brevoy?\""
msgstr "\"브레보이에 무슨 일이 일어나고 있지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Answer_0011_Text
msgctxt "7f82f4c3-6cc2-4d98-a803-0d5b352d1242"
msgid "\"Which one should I do first?\""
msgstr "\"무엇을 먼저 해야겠나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Answer_0012_Text
msgctxt "a3ab7643-226b-4eea-8235-6f72e87de436"
msgid "\"I must return to my own concerns.\""
msgstr "\"나는 내 관심사로 돌아가야만 한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Answer_0019_Text
msgctxt "ded3176e-6f7c-4f08-b06e-64970256e66d"
msgid ""
"\"I cannot go with you right now, but you have every right to go to Rostland "
"without me, Amiri. Go.\""
msgstr "\"지금 바로 너와 함께 할 수 없지만, 너는 나를 두고 로스틀랜드로 향할 수 있는 모든 권리가 있어, 아미리. 가도록 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Answer_0020_Text
msgctxt "5e0dc3e9-c291-45e3-93e9-1adc7f405ab8"
msgid "\"I cannot let you go! I need you here!\""
msgstr "\"널 보낼 수 없어! 니가 여기 있었으면 해!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Answer_0021_Text
msgctxt "3018c662-204a-4fce-9968-4fa079fa9259"
msgid "\"I forbid it. You are to remain here.\""
msgstr "\"그걸 허락하지 않겠어. 넌 여기 남아있어야 해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Answer_0027_Text
msgctxt "e6ff71a7-2205-4b88-a722-ec6c7453fd08"
msgid ""
"\"You are right. The threat is too serious to be ignored. We're heading "
"there right now!\""
msgstr "\"네 말이 맞아. 이 위협은 매우 심각해서 무시할 수 없어. 우리는 바로 그곳으로 향할거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "e0fa0ac8-1b32-4c94-bb85-24eedf88e5d3"
msgid ""
"\"Your Grace! We need to head to {g|Brevoy}Brevoy{/g} immediately! Swordlord "
"Jamandi requires your help in fighting off a sudden attack on "
"{g|Rostland}Rostland{/g}! A treacherous invasion of barbarians has caught "
"the {g|Swordlords}Swordlords{/g} off guard — it is presently only "
"skirmishes, but very soon there will be a major battle on the {g|Glenebon}"
"Glenebon Uplands{/g}. Restov is calling for help — and I trust you won't "
"turn your back on your old allies when they need your aid more than ever!\""
msgstr ""
"\"남작님! 어서 {g|Brevoy}브레보이{/g}에 가셔야 합니다! 소드로드 자만디가 {g|Rostland}로스틀랜드{/g}의 기습 "
"공격에 대해 지원이 필요합니다! 위험한 야만인의 침략이 {g|Swordlords}소드로드{/g} 경비병을 붙잡았습니다. 아직은 작은 분쟁 "
"수준이지만, 머지않아 {g|Glenebon}글레네본 고지대{/g}에서 큰 전투가 일어날것으로 보입니다. 레스토브경이 도움을 요청합니다. "
"저 역시 당신이 오랜 동맹이 도움이 절실할 때 등돌리지 않을 것이라 믿고 있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0002_Text
#. Speaker : Capital_Shandra
msgctxt "6b8ea757-f544-4692-bdb6-ac4f8b6b9aad"
msgid ""
"\"Ill news, Your Grace. Your subjects are once again beset by monster "
"attacks. If you don't want another Season of Bloom, you must investigate. I "
"would start your search at {g|Candlemere}Candlemere{/g} Lake — there was "
"another strange flash of light seen on the island, then shortly after, "
"monsters began attacking nearby villages.\""
msgstr ""
"\"나쁜 소식입니다, 전하. 백성들이 또다시 괴물들의 공격을 받고있습니다. 또 다른 개화의 계절을 원하시는게 아니라면, 서둘러 "
"조사해보셔야 할겁니다. 저라면 {g|Candlemere}캔들미어{/g} 호수부터 조사하겠습니다 — 섬에서 또 다른 이상한 빛이 번쩍였고, "
"얼마 지나지 않아, 괴물들이 근처 마을을 공격하기 시작했으니까요. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0003_Text
#. Speaker : Capital_Lander
msgctxt "e739595a-374b-45ec-9d12-554c45d79a7a"
msgid ""
"\"We've so much to report, Your Grace, I don't know where to begin. First, "
"the {g|Swordlords}Swordlords{/g} have requested your aid against the "
"barbarians. Secondly, monsters have started to appear within our barony "
"again, as they did during the Bloom. According to reports, most of creatures "
"have been sighted at Candlemere Lake.\""
msgstr ""
"\"보고할게 많아, 전하. 어디서부터 시작해야겠는지 모르겠네. 먼저, {g|Swordlords}소드로드{/g}가 야만인들과의 전투를 위해 "
"도움을 요청했어. 두번째로, 괴물들이 또 남작령에 나타나기 시작했어, 개화 때와 비슷하게 말이야. 보고서에 따르면, 대부분의 괴물들이 "
"캔들미어 호수 근처에서 발견되었다는군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0004_Text
#. Speaker : Capital_Kassil
msgctxt "b27cc38f-af21-4e58-aa79-975aa3f6b376"
msgid ""
"\"There's one more thing... I'm afraid the Bloom is back, Your Grace. "
"Monsters have started appearing in the barony again. Fortunately, they have "
"been spotted only near {g|Candlemere}Candlemere{/g} lake. Of course, this is "
"highly disturbing, but, my {mf|baron|baroness}, without immediate action on "
"our part, the {g|Swordlords}Swordlords{/g} may be defeated!\""
msgstr ""
"\"한 가지가 더 있습니다...개화가 다시 돌아온 것이 아닌지 걱정스럽습니다, 전하. 괴물들이 남작령에 다시금 모습을 드러내기 "
"시작했습니다. 다행히도, 그들은 오로지 {g|Candlemere}캔들미어{/g} 호수 근처에서만 발견되고 있습니다. 물론 이것은 매우 "
"혼란스럽습니다만 남작님, 우리 편에 대해 즉각적인 조치가 없이는 {g|Swordlords}소드로드{/g}들은 패배할지도 모릅니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0007_Text
#. Speaker : Capital_Shandra
msgctxt "569855c4-1f35-47be-b62d-5890f60e7fe6"
msgid ""
"\"There's one more thing, before I forget — Jamandi Aldori requests your "
"help. The {g|Swordlords}Swordlords{/g} are readying themselves for war "
"against the {g|Numeria}Numerian{/g} barbarians. Lady Aldori hopes for a "
"timely aid... But let me tell you a secret: lady {g|House Surtova}Surtova{/g}"
" would be pleased if you didn't hurry too much with the reinforcements. Why "
"waste your soldiers' lives? Leave this honor to the Aldori troops.\""
msgstr ""
"\"잊어버릴 뻔했는데, 한 가지 더 있습니다 — 자만디 알도리가 당신의 지원을 요청했습니다. {g|Swordlords}소드로드{/g}들이 "
"{g|Numeria}누메리아{/g} 야만인들과의 전투를 준비하고 있다더군요. 자만디 공은 시기적절한 지원을 바라고 있습니다... 하지만 "
"비밀을 하나 말씀드리죠: {g|House Surtova}서토바{/g} 부인은 당신이 지원을 위해 서두르지 않는 편을 좋아하실겁니다. 왜 "
"당신의 병사들 생명을 걸어야 하죠? 알도리 병사들을 위해 그 영광을 남겨둡시다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0008_Text
#. Speaker : Capital_Lander
msgctxt "f3abb959-91cd-46d7-a49b-0a97a7ac888c"
msgid ""
"\"I hope, Your Grace, you will decide which action to take first. Either "
"way, you should choose quickly — either deal with the tribes from "
"{g|Numeria}Numeria{/g} who are marching to us through {g|Brevoy}Brevoy{/g}, "
"or try to discover where this new Bloom originates from. Or, in other words: "
"will you honor your alliance with the Aldori? Or would you rather leave them "
"to their fate, to the {g|House Surtova}Surtova's{/g} delight?\""
msgstr ""
"\"바라는데, 전하, 먼저 처리할 일을 정해야 할거야. 어느쪽이든, 한 쪽을 빨리 정해 — {g|Brevoy}브레보이{/g}를 건너 "
"우리에게 진격해올 {g|Numeria}누메리아{/g} 부족들을 처리하던지, 아니면 새로운 개화가 어디서 시작됐는지 알아내던지. 아니면, "
"다른 방식으로 말해줄게: 알도리와 당신의 동맹을 견고히 하러갈거야? 아니면 {g|House Surtova}서토바{/g}를 기쁘게 하기 "
"위해 그들 스스로 운명을 결정하도록 둘거야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0009_Text
msgctxt "7b399673-6e6a-4475-87d0-3f8f638f0c17"
msgid ""
"\"Not long ago, a bright flash was spotted on the center of the island. "
"After that, monsters started to appear in the area, attacking fishermen and "
"travelers. Someone should travel to the {g|Candlemere}Candlemere{/g} and "
"discover where these monsters are coming from — and why.\""
msgstr ""
"\"최근, 밝은 빛이 섬 한가운데에서 관측되었습니다. 그 후 괴물들이 나타나 어부와 여행객들을 공격중입니다. 누군가 "
"{g|Candlemere}캔들미어{/g}로 가서 괴물들이 어디서 왜 출몰하는지 알아내야만 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0013_Text
#. Speaker : Capital_Kassil
msgctxt "6a53356f-ac30-4ca6-93c2-4cb87782428d"
msgid ""
"\"War in {g|Brevoy}Brevoy{/g}, of course! Lady Jamandi's request is "
"pressing, the future of {g|Rostland}Rostland{/g} and "
"{g|Swordlords}Swordlords{/g} depend on you!\""
msgstr ""
"\"{g|Brevoy}브레보이{/g}에 전쟁이 발발했습니다! 자만디 경이 긴급히 요청중이며 {g|Rostland}로스틀랜드{/g}와 "
"{g|Swordlords}소드로드{/g}들의 미래는 당신에게 달려있습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0014_Text
#. Speaker : Capital_Shandra
msgctxt "401a174b-37c2-4a52-9acc-a82d34015645"
msgid ""
"\"The Bloom, of course! The barony won't survive another monster invasion. "
"As for the {g|Swordlords}Swordlords{/g}, let's be honest — are you ready to "
"shed your blood and the blood of your people at Jamandi's whistle? The "
"Swordlords are strong enough to match the barbarians' 'offensive' and keep "
"them from your borders.\""
msgstr ""
"\"개화 쪽입니다, 당연하죠! 남작령에 또다시 괴물들의 침공이 일어나면 살아남을 수 없습니다. {g|Swordlords}소드로드{/g}"
"쪽이라면, 솔직히 말씀드릴 수 있습니다 — 자만디의 호각 소리에 따라 당신과 당신 백성들의 피를 흘리시겠습니까? 소드로드들에겐 야만인들의 "
"'공세'에 맞서 그들을 당신의 국경 너머에 붙잡아둘 충분한 힘이 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0015_Text
#. Speaker : Capital_Lander
msgctxt "c178d27a-fcd6-4af1-bca2-2dc3481b8662"
msgid ""
"\"Are you suggesting I take the throne? If I were you, I'd pay attention to "
"what's happening with our neighbors to the north. I'll send my people to "
"{g|Brevoy}Brevoy{/g} — and you should go to {g|Rostland}Rostland{/g} to give "
"the {g|Swordlords}Swordlords{/g} your support.\""
msgstr ""
"\"나보고 왕좌에 앉으라 제안하는건가? 내가 너라면, 북쪽에서 우리 이웃들이 뭘 하고 있나 살피러 북쪽으로 갈거야. 나는 "
"{g|Brevoy}브레보이{/g}로 사람을 보낼게 — 그리고 넌 {g|Rostland}로스틀랜드{/g}로 가서 "
"{g|Swordlords}소드로드{/g}에게 지원의 손길을 내미는거지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0016_Text
msgctxt "ec0c1b45-26d9-4092-8b92-8c5055625764"
msgid ""
"\"The Kellid Barbarians, Your Grace. The {g|Tiger Lords}Tiger Lords{/g} "
"tribe — they sometimes serve as mercenaries in the {g|River Kingdoms}River "
"Kingdoms{/g}. Not long ago a new chieftain rose among them, and inspired the "
"tribe to conquer new lands. His name is Armag the Twice-born, and it is said "
"his tribe honor him as a living legend. Looks like {g|Brevoy}Brevoy{/g} "
"became his first target. {g|Rostland}Rostland{/g}, to be more specific.\""
msgstr ""
"\"켈리드 야만족입니다 남작님. 때때로 {g|River Kingdoms}강의 왕국들{/g}에서 용병일을 하는 {g|Tiger Lords}"
"호랑이 군주{/g} 부족입니다. 최근 새 족장이 새 땅을 정복하기 위해 그들을 일으켜세웠습니다. 그의 이름은 두 번 태어난 아르막이고, "
"부족은 그를 살아있는 전설로 대합니다. {g|Brevoy}브레보이{/g}가 첫번째 목표가 된 것 같습니다. 구체적으론 "
"{g|Rostland}로스틀랜드{/g}죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0018_Text
#. Speaker : Amiri_Companion
msgctxt "2936da1e-c514-4af2-bcf0-317ea4fde7a4"
msgid ""
"{n}Amiri raises her head, her eyes blazing.{/n} \"{g|Tiger Lords}Tiger "
"Lords{/g}?! So, they decided to come to fight? I've heard, my... former "
"tribe is with them now — hiding from the evil spirit that haunts them. I bet "
"the Tiger Lords brought the cowardly worms here with them! If so, I'll give "
"them what they deserve!\""
msgstr ""
"{n}아미리가 눈을 활활 태우며 고개를 들었습니다.{/n} \"{g|Tiger Lords}호랑이 군주{/g}?! 그래서 그들이 싸우러 "
"온다고? 내가 듣기론... 내가 원래있던 부족이 함께 하는 중이라는군. 악귀를 피해서 말이야. 호랑이 군주가 겁쟁이 벌래새끼들을 "
"데려왔다고 내기하지! 맞다면 직접 값을 톡톡히 치뤄줄거야!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0022_Text
#. Speaker : Amiri_Companion
msgctxt "98729b04-25ff-4585-b25b-8b5a82d32d29"
msgid ""
"{n}Amiri's jaw drops in surprise.{/n} \"You, giving me orders? Listen, the "
"horde of barbarians is cutting through an ally's lands, and you choose this "
"moment to show how strong and tough you are! Pah! I'll go north and scout "
"around. You'll see for yourself — by the time you join me, the battle will "
"be over, I'll see to that! Until then, 'chieftain'!\""
msgstr ""
"{n}아미리의 턱이 놀라서 빠질 지경이 됩니다.{/n} \"내게 그렇게 명령하려고? 들어봐, 야만인들 무리가 동맹국의 땅을 침략했어, "
"그리고 너는 그들에게 네가 얼마나 강하고 튼튼한지 보여줄 이 기회를 잡아야 해! 하! 내가 북쪽으로 가서 주변을 둘러볼게. 너도 따로 "
"둘러봐 — 네가 나에게 합류하면 전투는 끝날거야, 내가 알아서 할게! 그 때까진 안녕, '족장'!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0023_Text
#. Speaker : Amiri_Companion
msgctxt "a6601b3d-2aa5-40d6-957e-264e3469d7de"
msgid ""
"{n}Amiri gives you a crooked grin.{/n} \"Oh no, you are a chieftain, tough "
"and strong. Don't pretend you can't do without me! Sure, it would be better "
"if we went together, but as long as you're stuck here... fine, you can think "
"I'm gone scouting! And as soon as you sort things out here, you go to "
"{g|Rostland}Rostland{/g} — together we'll strike these barbarians down so "
"hard they'll join their mothers in their graves! Till then, {name}\"."
msgstr ""
"{n}아미리는당신을 향해 낄낄댑니다.{/n} \"오 아니지, 너는 강하고 튼튼한 족장이야. 나 없이는 아무것도 못하는척 하지마! 확실히, "
"우리가 같이 가면 더 좋겠지만, 네가 여기에 박혀있는 동안엔... 좋아, 내가 정찰하러 갔다고 생각해! 여기 일을 정리하고 난 다음, "
"{g|Rostland}로스틀랜드{/g}로 와 — 함께 야만인들을 때려부수면 걔들은 제 엄마랑 나란히 무덤에 눕게 되겠지! 그 때까진 "
"안녕, {name}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0024_Text
#. Speaker : Amiri_Companion
msgctxt "c6c901b3-7b7d-49dc-8b50-aa4e1ea60a65"
msgid ""
"{n}Vexed, Amiri spits on the ground.{/n} \"Pah, it all seems wrong — to go "
"alone, without you!... But I can't wait. I can't.\" {n}Amiri winces.{/n} "
"\"Fine. You finish what you're doing here. I'll wait for you at the "
"battlefield. It will be an honor for me — to fight these "
"{g|Numeria}Numerian{/g} dogs side by side with you.\""
msgstr ""
"{n}성가신듯, 아미리는 땅에 침을 뱉었습니다.{/n} \"하, 내키지 않았어 — 널 두고 혼자 가는 것 말야!... 하지만 더는 못 "
"기다려. 도저히 안 돼.\" {n}아미리가 움찔합니다.{/n} 좋아. 여기서 할 일을 마무리해. 나는 전장에서 기다릴게. 너와 나란히 "
"{g|Numeria}누메리아{/g} 강아지들과 싸운다면 — 내겐 영광이지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0026_Text
#. Speaker : Amiri_Companion
msgctxt "523c1808-3bb5-4377-a194-61d331ba4866"
msgid ""
"{n}She shakes her head, as if trying to cast off something unpleasant, then "
"she glares at you... but her words are carefully controlled.{/n} \"What I "
"wanted to say, chieftain... we need to go there, and we need to hurry. I'm "
"going now — to scout around, maybe find some help... come with me! Or else "
"we'll live to see this Armag smash the brevans and come knocking at our main "
"gate.\""
msgstr ""
"{n}그녀는 불쾌감을 표현하듯 머리를 흔들었습니다. 그런다음 당신을 쳐다봤습니다... 그래도 어투는 조심스러웠습니다.{/n} \"그래서 "
"말인데 족장... 우린 가야한다고, 서둘러야해. 난 도움이 될만한 것을 찾아 주변을 정찰하겠어! 아니면 아르막이 브레보이를 처부수고 "
"우리의 성 대문까지 두드리는 꼴을 보게 될거야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0028_Text
#. Speaker : Amiri_Companion
msgctxt "e67b24dd-b530-4dc4-b842-63c4c8fac6fd"
msgid ""
"{n}Amiri raises her hand, as if trying to stop you.{/n} \"Easy! If we go in "
"a huge group, there's no way we can scout unnoticed! In short, I go first — "
"to see their numbers, maybe smash several heads. And you come join me later."
"\" {n}She grins.{/n} \"Just don't make me wait too long, or I'll kick all "
"their asses without you!\""
msgstr ""
"{n}아미리는 당신을 제지하려는 것처럼 손을 들어올렸습니다.{/n} \"진정해! 무리지어 가면 들키지 않게 정찰할 방법이 없어! 다시 "
"말해, 내가 먼저 가서 사람수도 세어보고 몇놈의 대가리를 박살낼게. 그런 다음 너가 나중에 합류하라고.\" {n}그녀는 히죽 "
"웃었습니다.{/n} \"그냥 내가 오래 기다리게 하지만 마. 아니면 나 혼자 그 놈들 엉덩이를 걷어차러 갈테니까!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0029_Text
#. Speaker : Capital_Lander
msgctxt "f6bd8c08-ccba-4c02-80ed-6fd84193ea6a"
msgid ""
"{n}Lander smiles slightly, submerged in his own thoughts.{/n} \"We are "
"decided, then. You are going to deal with the business at hand, which leaves "
"me to find someplace to put my efforts and talents as well. So Your Grace — "
"until next we see each other.\""
msgstr ""
"{n}랜더는 자기 생각에 파묻힌 채 살짝 미소짓습니다.{/n} \"그러면, 결정됐네. 난 적당한 장소를 찾아내서 노력과 재능을 발휘할 "
"곳을 찾을 테니까, 너도 그쪽 일을 처리하러가. 그러면 남작님 — 다음에 다시보자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0030_Text
#. Speaker : Capital_Shandra
msgctxt "42d29729-d191-4560-9de1-c4d90104f531"
msgid ""
"\"And the last thing, Your Grace. This morning I received a letter that "
"demands my presence back home.\" {n}She pauses.{/n} \"My presence at your "
"court was proof that you value good relations with the {g|House "
"Surtova}Surtovas{/g}. Now you can confirm your loyalty by heeding my advice. "
"Mind the problems of your own barony and don't hurry to solve the issues "
"outside your borders.\" {n}Shandra bows before you with dignity.{/n} \"Till "
"we meet again, Your Grace.\""
msgstr ""
"\"마지막입니다, 남작님. 오늘 아침, 저는 고향으로 돌아와야 한다는 편지를 받았습니다.\" {n}그녀는 잠시 멈췄습니다.{/n} "
"\"당신의 궁궐에서 제 존재는 당신이 {g|House Surtova}서토바{/g}와 좋은 관계를 위해 값을 매기고 있다는 증거였습니다. "
"이제 당신은 제 조언에 따라 어디에 충성할지 결정하셔야합니다. 당신의 남작령 내부의 문제만 신경쓰시고, 경계 너머의 문제를 푸는데는 "
"조급해하지 마십시오.\" {n}샨드라가 먼저, 품위있게 인사했습니다.{/n} \"다시 뵐 수 있기를, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-1BrevoyEnvoyStart/Cue_0031_Text
#. Speaker : Capital_Kassil
msgctxt "20346e02-3371-46a1-9f2b-dc9b4c8d8c0d"
msgid ""
"{n}Kassil bows his head before you.{/n} \"And one last thing, Your Grace. "
"Now, in this darkest hour, I must hurry to help my countrymen. I'm heading "
"to {g|Rostland}Rostland{/g} immediately to join the "
"{g|Swordlords}Swordlords{/g}. I hope we'll meet again — and in this world!\""
msgstr ""
"{n}카실은 당신에게 고개를 숙입니다.{/n} \"마지막으로 남작님. 저는 이런 암흑기에 제 고향사람들을 도우러 가야 합니다. "
"{g|Rostland}로스틀랜드{/g}에 가서 {g|Swordlords}소드로드{/g}들에게 즉시 합류하러 가겠습니다. 다시 살아서 "
"만나길 바라겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-2-PitaxBardTrouble/Answer_0005_Text
msgctxt "b006b2ea-19b9-4f1a-8fcd-c191849f1406"
msgid "\"Let's hurry to the square.\""
msgstr "\"어서 광장으로 가자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-2-PitaxBardTrouble/Answer_0006_Text
msgctxt "cc36fff2-eaf8-4e6f-ba9b-ea64257acdc7"
msgid "\"Remind me, who's Annamede again?\""
msgstr "\"다시 알려줘, 안나미데가 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-2-PitaxBardTrouble/Answer_0007_Text
msgctxt "58373492-398f-4123-956c-a066341d64e2"
msgid "\"Let her sing whatever she likes. It's none of my concern.\""
msgstr "\"원하는대로 노래하게 하라. 내가 신경쓸 일은 아니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-2-PitaxBardTrouble/Cue_0001_Text
#. Speaker : Capital_Kassil
msgctxt "583277f1-56b6-4c7f-a3c4-b7fef3ac3407"
msgid ""
"\"Your Grace, forgive my intrusion! We have a matter that demands your "
"urgent attention. Right now, Annamede Belavarah, the bard from "
"{g|Pitax}Pitax{/g}, is singing in the middle of our main square. And her "
"songs are… seditious, to say the least.\""
msgstr ""
"\"전하, 갑작스럽게 죄송합니다! 긴급히 살펴보셔야할 일이 있습니다. 지금 {g|Pitax}피탁스{/g}에서 온 음유시인 안나미데 "
"빌라바라가 우리 광장 한 가운데에서 노래하고 있습니다. 그리고 그 노래는... 좋게 말해줘도 선동적입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-2-PitaxBardTrouble/Cue_0002_Text
#. Speaker : Capital_Shandra
msgctxt "dd9d20dc-b91a-4a2f-a5af-192ee0039262"
msgid ""
"\"{mf|Baron|Baroness}, you must intervene immediately! Annamede Belavarah, "
"one of King Irovetti's… favored artists... is singing in tour main square "
"right now. Her songs are far from innocent, they can plant dangerous ideas "
"in your subjects' heads.\""
msgstr ""
"\"{mf|영주|영주}님, 즉시 개입하셔야 합니다! 안나미데 빌라바라는 이로베티 왕의... 총애받는 예술가가... 지금 여행자 광장에서 "
"노래하고 있습니다. 그녀의 노래는 순진함과는 거리가 있어서, 백성들의 머리에 위험한 생각을 심어줄 수 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-2-PitaxBardTrouble/Cue_0003_Text
#. Speaker : Capital_Lander
msgctxt "bbc256cd-07df-4cef-8090-7447b9507082"
msgid ""
"\"{mf|Baron|Baroness}, we have a situation on our hands! You need to act!\" "
"{n}Lander is furious, his face red.{/n} \"Annamede, an annoying little "
"skylark from {g|Pitax}Pitax{/g}, is giving a show in the main square, and "
"her songs are highly seditious!\""
msgstr ""
"\"{mf|영주|영주}님, 해결해야할 일이 생겼습니다! 행동을 취해야 합니다!\" {n}랜더는 분노에 차서 얼굴이 붉게 "
"물들었습니다.{/n} \"안나미데라는 짜증나는 {g|Pitax}피탁스{/g}의 작은 종달새가 광장에서 공연을 하고 있습니다. 그리고 그 "
"노래는 아주 선동적이지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-2-PitaxBardTrouble/Cue_0008_Text
msgctxt "ea4d7804-4bfa-492c-8f4a-56ace2051e56"
msgid ""
"\"She's among the most talented bards of {g|Pitax}Pitax{/g}. But more "
"importantly, she's one of King Irovetti's most favored singers. Anything she "
"sings almost certainly promotes his agenda.\""
msgstr ""
"\"그녀는 {g|Pitax}피탁스{/g}에서 가장 재능있는 음유시인 중 하나입니다. 하지만 더 중요한 사실은, 그녀가 이로베티 왕의 가장 "
"총애하는 가수라는 것이지요. 그녀가 노래하는건 거의 대부분 이로베티 왕의 어젠다를 옹호하는 내용입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "924f8c9a-1eb4-4a99-8987-a00448e98fb2"
msgid ""
"\"Your Grace… Ha, I just realized that I won't be calling you that much "
"longer! I just wanted to tell you that everything is ready for the "
"celebration: your guests have arrived, the capital is fully decorated for "
"the festivities, and the people can't wait for you to make your entrance!"
msgstr ""
"\"전하... 하, 그렇게 부르는 것도 부르는 것도 오래가지는 않을것 같네요! 축하를 위한 준비가 모두 끝났다고 얘기하려고 했어요. "
"손님들은 도착했고, 수도는 축제를 위해 완전히 장식되었고, 이제 모두 전하가 입장하는 것만을 기다리고 있어요!"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0002_Text
#. Speaker : Linzi_Companion
msgctxt "b2c2eca2-cb7b-4dc3-b2cd-136eae43e2ed"
msgid ""
"\"All right, then, now we can definitely start celebrating... it's just so "
"incredible, I'm so excited: a new kingdom is about to appear — right here, "
"before my very eyes! It's long overdue, if you ask me: my book of our "
"adventures is desperately lacking in episodes where the heroes are properly "
"rewarded!\""
msgstr ""
"\"좋아요, 이제 축하연을 시작할 수 있겠네요... 정말이지, 이게 현실이라니. 너무 신이 나요! 지금 이 자리에서, 바로 제 눈앞에서 "
"새로운 왕국이 세워지는 거잖아요! 이날을 손꼽아 기다렸어요. 실은 제 책에서 주인공이 제대로 된 보상을 받는 부분이 거의 없었거든요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0003_Text
#. Speaker : Capital_Jhod
msgctxt "5f58e6f1-2913-4474-8bb9-2d73662fd97d"
msgid ""
"\"Shush, girl, stop babbling, would you? You've been hammering our ears for "
"long enough! It's time to let others speak.\""
msgstr ""
"\"쉿, 아가씨, 그만 조잘거림을 멈춰주시겠습니까? 당신은 우리 귀에 충분히 망치질을 했습니다! 다른 사람에게도 말할 기회좀 주시지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0004_Text
#. Speaker : Capital_Kesten
msgctxt "a48b2cb4-19ee-41b0-a46d-41270297327e"
msgid ""
"{n}Kesten finds a suitable moment to interrupt the bard's speech.{/n} \"Linzi"
", I would like to have a word with the {mf|baron|baroness}.\""
msgstr "{n}케스턴은 음유시인의 말을 끊을 적절한 순간을 기다립니다.{/n} \"린지, {mf|영주|영주}님과 얘기를 하고싶습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0005_Text
#. Speaker : Capital_Jhod
msgctxt "de2f6f73-9a4b-44c1-9c27-994296059c42"
msgid ""
"\"Enough, girl, let us say a word or two as well!\" {n}Jhod takes a deep "
"breath, filling his chest.{/n} \"So, Your Grace, are you ready to put a "
"proper crown upon your head? You have no need to answer, I can read it in "
"your eyes: you simply cannot wait!\""
msgstr ""
"\"좋아, 아가씨, 우리도 한두 마디 합시다!\" {n}조드는 가슴을 메우며 심호흡을 합니다.{/n} \"그럼 전하, 머리에 정당한 "
"당신의 왕관을 쓸 준비가 되셨습니까? 대답할 필요는 없습니다. 각하의 두 눈을 보면 알지요. 기다리기 힘들어 보이시는군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0006_Text
#. Speaker : Capital_Jhod
msgctxt "9d325927-a417-444a-a930-b25d6ee14656"
msgid ""
"\"Well, {name}. I didn't expect to live long enough to witness this: the {g|"
"Stolen Lands}Stolen Lands{/g} have finally gained a proper {mf|king|queen}! "
"Now, after the other monarchs have recognized you, no one will challenge "
"your right to the throne.\""
msgstr ""
"\"글쎄, {name}. 저는 이런 일을 볼 만큼 오래 살리라고는 예상하지 못했습니다: {g|도둑맞은 땅}도둑맞은 땅{/g}이 마침내 "
"제대로 된 {mf|왕|여왕}을 얻었습니다! 이제 다른 군주들이 당신을 알아보고 나면, 아무도 당신의 왕권에 도전하지 않을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0007_Text
#. Speaker : Capital_Jhod
msgctxt "0e755434-8383-447a-b905-6d7a7d2e4c34"
msgid ""
"\"May {g|Erastil}Erastil{/g} guard your kingdom. Rule wisely, don't be too "
"harsh to your people without reason, and remain on friendly terms with your "
"neighbors. That won't work with all of them, unfortunately — may demons take "
"the cursed Irovetti... but if someone offers you a hand — don't reject it! "
"All right, that's enough idle talk. I see Linzi here is getting antsy!\""
msgstr ""
"\"{g|에라스틸}에라스틸{/g} 께서 당신의 왕국을 지켜주시길. 지혜롭게 다스리십시오. 이유 없이 당신의 백성에게 너무 가혹하게 대하지 "
"마시고, 당신의 이웃들과 친밀한 관계를 유지하십시오. 불행하게도, 모든 이웃이 다 그렇진 않을 겁니다. -악마가 저주받은 이로베티를 "
"데려가 버리길... 하지만 누군가 당신에게 손을 내민다면, 거절하지 말고 수락하십시오! 좋습니다. 지루한 얘기는 이걸로 충분합니다. 여기 "
"린지가 안절부절 못하고 있는 게 보이는군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0008_Text
#. Speaker : Capital_Kesten
msgctxt "289da087-5cc4-45ab-9694-be7dcc7e8a94"
msgid ""
"\"Pardon me for my attire — all these recent events were a bit unexpected... "
"But before the politicians from distant lands start crowding around you, I'd "
"like to tell you this: many people before you tried to win the {g|Stolen "
"Lands}Stolen Lands{/g}, and all of them ended up buried in its swamps, "
"fields and hills. You're the first one who didn't get {mf|him|her}self "
"killed here, the first to bend the Stolen Lands to {mf|his|her} will.\""
msgstr ""
"\"제 옷차림을 용서해 주십시오. — 최근의 모든 사건들은 좀 예상치 못한 일이었습니다... 그러나 먼 나라에서 온 정치인들이 당신 "
"주위로 몰려들기 전에 이 말을 해드리고 싶습니다: 많은 사람들이 당신 이전에 {g|도둑맞은 땅}도둑맞은 땅{/g}}을 얻으려 했고, 그들 "
"모두는 결국 늪이나 들판, 언덕에 묻혔버렸죠. 여기서 자멸하지 않은 것은 당신이 처음이고, 각하야말로 도둑맞은 땅을 본인의 의지로 꺾은 "
"첫 사람입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0009_Text
#. Speaker : Capital_Kesten
msgctxt "ef480062-d227-4d32-b7b3-f61b5de40def"
msgid ""
"\"Don't let anyone to snatch away the slightest bit of what now belongs to "
"you. No outsider \"Stag Lords\", no upstarts like Irovetti. If I could have "
"known who I'd end up serving after House Garess disowned me — well, I would "
"never have believed it. But I am happy to be your vassal, my "
"{mf|Baron|Baroness}. May your reign last a hundred years!\" {n}Kesten bows "
"before you and steps aside.{/n}"
msgstr ""
"\"그 누구도 지금 당신에게 속한 것을 조금도 가로채지 못하게 하십시오. 외부인 \"숫사슴 군주\"도 , 이로베티 같은 벼락출세한 자들도 "
"안되지요. 만약 제가 가레스 가문이 저와 의절한 후에 누군가를 섬기게 될지 알 수 있었다면- 글쎄요, 저는 결코 그 사실을 믿지 않았을 "
"겁니다. 그러나 저는 당신의 신하가 되어 기쁩니다, 저의 {mf|남작|여남작}이시여. 당신의 통치가 백 년간 계속되기를!\" {n}"
"케스틴은 당신의 앞에 절을 하고 옆으로 물러섭니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0011_Text
#. Speaker : Capital_Kesten
msgctxt "f47bd5b6-2d2e-447a-a437-0b241ecc79f4"
msgid ""
"{n}Kesten nods.{/n} \"After everything we've been through to reach this "
"moment... Remember the Season of Bloom? What about the monster that almost "
"killed Jhod and me right in the middle of our own capital? And you even "
"managed to avert a simmering war! Yes, it's high time you get something you "
"deserve — even more than all these {g|House Surtova}Surtovas{/g} and Aldori: "
"a kingdom of you own, and indeed, your own independence.\""
msgstr ""
"{n}케스턴이 고개를 끄덕입니다.{/n} \"지금 이 순간까지 도달하기 까지 우리가 겪은 모든 일들 후에... 개화의 계절을 "
"기억하십니까? 우리 수도 한복판에서 조드와 저를 거의 죽일 뻔한 괴물은 어떻고요? 그리고 각하께선 심지어 임박한 전쟁도 어렵게나마 "
"비껴갔지요! 예, 이제 각하께서 마땅히 받으셔야 할 것을 얻을 바로 그 때입니다. 이 모든 {g|서토바 가문}서토바{/g}와 알도리의 "
"사람들보다도: 당신이 소유하고 있는 왕국, 그리고 실로 당신의 자립말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0012_Text
#. Speaker : Capital_Jhod
msgctxt "dba6e977-8a8f-4094-b4f0-6d48942b7424"
msgid ""
"{n}Jhod gives you a tight smile and shakes his head.{/n} \"So much has "
"happened, and much more is still to come, mark my words... You may have "
"dealt with the barbarians, but there remain more than a few threats nearby. "
"Take {g|Pitax}Pitax{/g} for instance — a basket of snakes in our back yard!\""
" {n}Jhod waves his hand.{/n}"
msgstr ""
"{n} 조드는 당신에게 억지 웃음을 짓으며 고개를 가로젓습니다.{/n} \"너무 많은 일이 일어났고, 아직도 더 많은 일이 남아 "
"있습니다. 제 말을 명심하십시오... 야만인들을 어찌어찌 처리했을지 모르지만, 근처에는 몇 가지 위협이 남아 있습니다. "
"{g|피탁스}피탁스{/g}를 예로 들어보지요. 우리 뒷마당에 있는 바구니 속의 뱀이지요!\" {n}조드가 손을 젓습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0013_Text
#. Speaker : Capital_Jhod
msgctxt "6e59837f-c4c5-4c37-acd3-bdee383e9892"
msgid ""
"\"But never mind. Let's stop this dark talk, at least for today. Here's what "
"I should like to say instead: though you change your baron's coronet for the "
"royal crown, stay humble. Rule wisely. Don't be too harsh to your people, "
"and don't let us down, for we believed in you from the very beginning. All "
"right, that's it, enough lecturing for today.\" {n}Jhod and Kesten give you "
"a bow and allow Linzi to jump back into the conversation.{/n}"
msgstr ""
"\"하지만 신경 쓰지 마십시오. 적어도 오늘만큼은 이런 어두운 이야기는 그만둡시다. 대신 하고 싶은 말이 있습니다: 비록 왕관을 위해 "
"남작의 화관을 바꾸더라도 겸손하게 있으십시오. 현명하게 통치하시고.. 당신의 백성에게 너무 가혹하게 대하지 말고, 우리를 실망시키지 "
"마십시오. 우리는 처음부터 각하를 믿었으니까. 좋습니다. 이제 됐어요. 오늘의 강의는 이걸로 충분합니다.\" {n}조드와 케스턴은 "
"당신에게 절을 하고 린지가 다시 대화에 끼도록 허락합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0014_Text
#. Speaker : Linzi_Companion
msgctxt "9d11a615-9b37-4fd7-a0fd-3570f8fdb203"
msgid ""
"\"Well, it's time to talk to our current ally, Lady Aldori! Jamandi wishes "
"to have a word with you before the ceremony begins. There are still some "
"things I must arrange, so I can't linger any longer. The coronation will "
"commence as soon as you arrive at the square.\""
msgstr ""
"\"음, 이제 현재 동맹인 레이디 알도리와 얘기를 해야겠네요! 자만디는 대관식 전에 당신과 대화를 나누기를 원했어요. 아직 처리할 일이 "
"많이 있으니, 더는 지체할 시간이 없네요. 대관식은 당신이 광장에 도착하자마자 시작될 테니까 알고계세요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0015_Text
#. Speaker : Linzi_Companion
msgctxt "b19a233f-3584-4219-aadf-433855f2578b"
msgid ""
"\"Our new ally can't wait to exchange a word with you. Lady {g|House "
"Surtova}Surtova{/g} requests a brief audience before the ceremony starts. "
"After you're done receiving your congratulations, follow me: the coronation "
"will commence as soon as you arrive at the square.\""
msgstr ""
"\"우리의 새 동맹이 당신과 얘기를 나누길 원하고 있어요. 레이디 {g|House Surtova}서토바{/g}가 대관식이 시작하기전 "
"간단히 알현하길 요청했어요. 축하를 다 받았으면 날 따라와요: 대관식은 당신이 광장에 도착하자마자 시작할 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0016_Text
#. Speaker : Linzi_Companion
msgctxt "09adfe46-fb5f-474f-8370-16dca9579b5b"
msgid ""
"\"Our esteemed guests, Jamandi Aldori and Natala {g|House Surtova}Surtova{/g}"
", would like to speak with you before you greet the crowd. Have a nice "
"conversation — meanwhile, I must go and prepare for the ceremony! The "
"coronation will commence as soon as you arrive at the square.\""
msgstr ""
"\"지체높은 손님인 자만디 알도리와 나탈라 서토바{g|House Surtova}{/g}가 당신이 대중 앞에 서기 전에 대화를 나누고 싶다 "
"하네요. 즐거운 시간 보내요 - 그동안, 전 대관식을 준비해야 겠어요. 대관식은 당신이 광장에 도착하자마자 시작할 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0017_Text
#. Speaker : Linzi_Companion
msgctxt "a4c3121e-a923-40cc-8e5d-3022e193b94d"
msgid ""
"\"That's it, the ceremony is prepared. I'll wait for you outside — brace "
"yourself and emerge in full splendor! The coronation will commence as soon "
"as you arrive at the square.\""
msgstr ""
"\"다 됐어요, 대관식 준비를 다 끝냈어요. 전 밖에서 기다릴께요 - 마음 단단히 먹고 최고로 멋있게 나타나셔야 해요! 대관식은 당신이 "
"광장에 도착하자마자 시작할 거예요..\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0018_Text
msgctxt "6c9bf903-a1b6-4f67-8e4c-89419c263c18"
msgid ""
"\"Oh, I almost forgot! Look what I have here — something about a former "
"associate of yours, {d|c41 Lander Lives}Lander{/d}! You better "
"{g|Coronation_Lander}read it{/g} right away and then promptly forget about "
"it. You wouldn't want your mood to sour before the coronation!\""
msgstr ""
"\"오, 깜빡할뻔 했네! 여기 당신 옛 친구... {d|c41 Lander Lives}랜더{/d}에 관한 편지에요! 바로 "
"{g|Coronation_Lander}읽고{/g}, 빨리 치워버리세요. 대관식 전에 기분 상하면 좋을 것 없잖아요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0023_Text
#. Speaker : Linzi_Companion
msgctxt "5d9b28d2-0ee8-48f6-a49c-0eb7e76b1e2d"
msgid ""
"\"Oh, I almost forgot! Look what I have here — something about a former "
"associate of yours... {d|c41 Lander Money}Lander{/d}! You'd better "
"{g|Coronation_Sarrona}read it{/g} right away, then promptly forget about it. "
"You wouldn't want your mood to sour before the coronation!\""
msgstr ""
"\"오, 깜빡할뻔 했네! 여기 당신 옛 친구... {d|c41 Lander Money}랜더{/d}에 관한 편지에요! 바로 "
"{g|Coronation_Sarrona}읽고{/g}, 빨리 치워버리세요. 대관식 전에 기분 상하면 좋을 것 없잖아요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Cue_0024_Text
#. Speaker : Linzi_Companion
msgctxt "e9203c00-34f1-461b-87c1-debe4b2cfec5"
msgid ""
"\"Oh, I almost forgot! Look what I have here — something about a former "
"associate of yours... {d|c41 Lander Dead}Lander{/d}! You'd better "
"{g|Coronation_Broadsheet}read it{/g} right away, then promptly forget about "
"it. You wouldn't want your mood to sour before the coronation!\""
msgstr ""
"\"오, 깜빡할뻔 했네! 여기 당신 옛 친구... {d|c41 Lander Dead}랜더{/d}에 관한 소식이에요! 바로 "
"{g|Coronation_Broadsheet}읽고{/g}, 빨리 치워버리세요. 대관식 전에 기분 상하면 좋을 것 없잖아요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Item/Broadsheet_Dead_Name_String
msgctxt "c53f172b-1f4d-40b9-87e6-42fc2ee43be4"
msgid "A Broadsheet from New Stetven"
msgstr "뉴 스테트벤(New Stetven)에서 발행된 신문"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Item/Broadsheet_Dead_String
msgctxt "f1cb0850-8bd4-41e0-b77e-60643293f6bd"
msgid ""
"\"Tragedy in House Lebeda!\n"
"According to our latest reports, tragedy has recently befallen House Lebeda. "
"The house's heir, Lord Lander, has been reported missing. The Dowager Head "
"of House and mother of the missing man, Sarrona Lebeda, publicly announced "
"this only a few days ago. Further details about abduction, and the names of "
"any suspects, are yet unknown.\n"
"According to rumor, shared by servants of House Lebeda, Lord Lander was "
"captured during a hunt, or abducted directly from his sleeping chamber. "
"However, another source claims that the heir ran away from his house of his "
"own volition, and was last seen in the southernmost part of Brevoy. Many "
"agree that the prolonged silence, maintained by House Lebeda after the "
"heir's disappearance, could be explained by the sensitive political "
"situation.\n"
"Sarrona Lebeda urged the abductors to listen to the voice of reason and "
"return her son to her before she takes decisive steps to find him and return "
"him home herself. It is yet unknown if Sarrona will take matters into her "
"own hands, and if she knows anything about the abductors. In the meantime, "
"the heir's disappearance remains an absolute mystery, and a challenge to the "
"best detectives of Brevoy.\""
msgstr ""
"\"레베다 가문의 비극!\n"
"최근 발표에 따르면, 레베다 가문에 비극이 일어났다고 합니다. 가문의 적장자, 랜더 경이 실종되었다고 전해집니다. 가문의 미망인이자 "
"실종자의 어머니인 사로나 레베다(Sarrona Lebeda)는 이 사실을 몇일 전 공식적으로 발표했습니다. 납치에 관한 자세한 사항이나 "
"용의자의 성명은 아직 알려지지 않았습니다.\n"
"레베다 가문의 시종들 사이에 나도는 소문에 의하면 랜더 경은 사냥 중에 잡혔거나 침실에서 납치되었다고 합니다만, 또다른 정보원은 랜더 "
"경이 스스로 집에서 나갔으며 브레보이의 최남단에서 마지막으로 목격되었다고 말합니다. 레베다 가문이 적장자의 실종 건을 두고 오랫동안 "
"침묵을 유지한 것으로 추측컨데, 많은 사람들은 이 납치가 민감한 정치적 사안과 엮여 있다 보고 있습니다. \n"
" 사로나 레베다는 아들을 찾아내기 위한 특단의 조치를 취하기 전에 납치자들이 이성에 귀기울여 아들을 돌려보내 줄 것을 촉구했습니다. "
"사로나가 이 문제를 손수 다루고 있는지, 납치자들에 무엇을 알고 있는 지는 알려지지 않았습니다. 현재까지 랜더의 실종은 완전한 미스터리로 "
"남아있으며 브레보이 최고의 탐정들의 도전과제로 남아있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Item/LanderLetter_Resurrected_Name_String
msgctxt "07455257-cca4-4b98-be71-d1aa42a59c0c"
msgid "A Letter from Lander Lebeda"
msgstr "랜더 레베다가 보낸 편지"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Item/LanderLetter_Resurrected_String
msgctxt "f7c4530c-9eb1-4dbe-aa9a-ed0ffd9eaa24"
msgid ""
"\"{mf|Baron|Baroness} {name},\n"
"first of all, I would like to thank you for your mercy, and for the lesson "
"you've taught to me. No one has ever done me such an honor. I hope our "
"little conflict won't cause you to reject your better memories of me. Just "
"think about all the difficulties I've helped you through, and all the heroic "
"deeds I inspired you to pursue. I dread to think how long it will take you "
"to find a suitable replacement for me. As for me, I can assure you I don't "
"hold a grudge, and will do everything in my power to avoid crossing your "
"path again.\n"
"Forever grateful,\n"
"Lord Lander Lebeda\""
msgstr ""
"\"{mf|남작|여남작} {name},\n"
"우선, 관대한 처사에 감사를 표하고 싶어. 내게 교훈이 되었어. 당신은 내 명예를 지켜주었지. 우리 사이의 작은 불화가 좋은 추억까지 "
"망치지 않았으면 해. 네가 곤경에 처했을 때 내가 나타나 구해준 적 많잖아. 당신이 이룬 영웅적인 업적에, 나도 약간은 영감을 주었다고 "
"해두자고. 물론 나를 대신할 인물을 찾는데 오랜 시간이 걸리겠지만. 우리 사이에 은원은 모두 정리되었으니, 혹여라도 네 앞길을 막지 "
"않도록 최선을 다하지. \n"
"감사하는 마음을 담아,\n"
"랜더 레베다 경\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Item/SarronaLetter_Ransom_Name_String
msgctxt "c308ce1d-2486-478d-8874-55febe94fb15"
msgid "A Letter from Sarrona Lebeda"
msgstr "사로나 레베다(Sarrona Lebeda)가 보낸 편지"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-3Coronation_Start/Item/SarronaLetter_Ransom_String
msgctxt "6011114f-f255-47e0-9313-a2ae4ee3ce9c"
msgid ""
"\"{mf|Baron|Baroness} {name},\n"
"I have received your demands and accept your terms and conditions. Along "
"with this letter, I send you the entire ransom for the body of my son. Also, "
"I wish to use this opportunity to offer you a formal apology, on behalf the "
"noble House Lebeda, for the insult that my son inflicted upon you and your "
"family. There's no doubt that what Lander did was inexcusable. However, if "
"he really had intended to stab you in the back, you would surely be dead by "
"now. Apparently, my son took pity on you, so you shouldn't harbor any "
"resentment against him.\n"
"I must confess, I am surprised by your nobleness. I sincerely hope that your "
"mother will likewise be allowed to recover your body, after you perish. If "
"the family of the highly esteemed {mf|baron|baroness} lacks the necessary "
"financial surety, I shall purchase your body personally, to repay for your "
"kindness. Be assured, your remains shall fall into good hands.\n"
"Unfortunately, I will not be able to visit your lands in person — my doctors "
"recommend against travel in damp climates. But be assured that if I learn of "
"your presence in our realm, I shall prepare a solemn welcome for you without "
"delay.\n"
"With best regards,\n"
"Sarrona Lebeda, head of House Lebeda\""
msgstr ""
"\"{mf|남작|여남작} {name},\n"
" 요구 사항을 받아들이겠습니다. 편지와 함께 아들의 시신에 대한 몸값을 동봉합니다. 또한 이 기회를 빌어 레베다 가문은 제 아들이 당신 "
"가문에 안긴 모욕에 정식으로 사과하는 바입니다. 랜더는 용서받을 수 없는 짓을 저질렀지요. 하지만 랜더가 진실로 배신하고자 했다면, "
"당신은 이미 죽은 목숨이었을지도 모릅니다. 이런 사정을 참작하여, 제 아들에 대한 분노를 거두어주시기 바랍니다. \n"
" 솔직히 말씀드리건대, 저는 그대의 고결함에 놀랐습니다. 당신의 어머니께도 먼저 간 자식이 있다면 그 시신을 온전히 돌려받을 수 있기를 "
"바랍니다. 혹여 {mf|남작|여남작} 가문에서 몸값을 지불할 수 없는 상황에 처한다면 말씀해주십시오. 제가 친히 당신이 보여준 친절에 "
"보답하겠습니다. 당신의 유해를 정성스레 다룰 터이니 이 점에 대해선 걱정하지 마십시오.\n"
" 주치의가 습한 기후로 여행을 떠나는 것을 반대했기에, 안타깝게도 당신 봉토에 직접 방문하진 못합니다. 언젠가 우리 영토에 방문하신다면, "
"지체 없이 최고의 예를 갖춘 환영식을 준비토록 하겠습니다.\n"
"진심을 담아, \n"
"사로나 레베다, 레베다 가문의 당주\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Answer_0005_Text
msgctxt "4854453e-e68b-4c12-80df-b5cc564e6ff3"
msgid "\"Tell me about the Order of the Rack.\""
msgstr "\"형벌 기사단에 대해 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Answer_0006_Text
msgctxt "626c7e36-0c1d-4028-86e4-2fea10ba008a"
msgid "\"Who is this fugitive you're looking for?\""
msgstr "\"당신이 찾는 이 도망자는 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Answer_0007_Text
msgctxt "855c8fa4-1227-413a-ad73-a2c36ec6f01b"
msgid "\"Can I help you with your investigation?\""
msgstr "\"당신 수사를 위해 내가 해줄 게 있겠나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Answer_0008_AlignmentShift.Description
msgctxt "9fe2e8fd-9335-49b6-a938-5ede4706af33"
msgid "Allowed Linxia to carry out her investigation in the barony."
msgstr "린시아가 남작령 내에서 수사를 진행하도록 허락했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Answer_0008_Text
msgctxt "8323bb6c-9cbb-4ff3-befa-b8bcf812d7e9"
msgid ""
"\"I authorize you to conduct your investigation within my "
"{mf|barony|barony|kingdom|kingdom}.\""
msgstr "\"내 {mf|남작령|남작령|왕국|왕국}에서 당신이 수사하는 것을 허락하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Answer_0009_AlignmentShift.Description
msgctxt "d2ba4d57-1997-4da2-aa33-91bffada0899"
msgid "Forbade Linxia's investigation."
msgstr "린시아의 수사를 금지했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Answer_0009_Text
msgctxt "8ca5944c-d938-4db0-9ab2-68e693e359be"
msgid "\"Get out of my {mf|barony|barony|kingdom|kingdom}.\""
msgstr "\"내 {mf|남작령|남작령|왕국|왕국}에서 나가라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Answer_0019_AlignmentShift.Description
msgctxt "f62fc4cb-da5b-4bb7-a845-949d3de8653a"
msgid "Doubted the necessity of burning all books."
msgstr "모든 책들을 불태울 필요성에 대해 의구심을 가졌습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Answer_0019_Text
msgctxt "7904222a-15b6-4b6b-90d3-54dfd9a1bf6c"
msgid "\"Catching criminals is one thing, but burning books is too much!\""
msgstr "\"범좌자의 검거와는 별개로, 책들을 불태우는 건 너무한데!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Answer_0020_AlignmentShift.Description
msgctxt "e0cfe026-81d3-4cc9-a40c-f46cb7daae44"
msgid "Tried to reason with Linxia."
msgstr "린시아를 논리적으로 설득하려 시도했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Answer_0020_Text
msgctxt "d767665a-c0be-46ab-9ffa-13f7a658bc78"
msgid ""
"\"Your actions in Cheliax do not concern me. But while you are on my land, I "
"demand you to refrain from such... extreme measures.\""
msgstr ""
"\"첼리악스에서 당신이 뭘 하든 나와는 상관없어. 하지만 당신이 내 땅에 있는 동안에는, 당신의 그런... 극단적인 조치들을 자제할 것을 "
"요구하겠어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Answer_0021_AlignmentShift.Description
msgctxt "7cd53958-6d43-40bd-80bb-b57497eb8e87"
msgid "Agreed with Linxia."
msgstr "린시아의 말에 동의했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Answer_0021_Text
msgctxt "af8a6e8c-aa98-4b9f-8170-653f64d78c5b"
msgid "\"I entirely share your opinion.\""
msgstr "\"당신의 의견에 전적으로 동의해.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Answer_0022_Text
msgctxt "27168606-8429-4cb9-8462-1284aaf3df4b"
msgid "[Remain silent]"
msgstr "[침묵하다]"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0001_Text
msgctxt "0d0d09c8-e33e-4b87-9d66-8b9da2e9f5f6"
msgid ""
"\"The {g|Order of the Rack}Order of the Rack{/g} welcomes you, "
"{mf|baron|baroness|king|queen}.\" {n}The black-skinned woman slightly bows "
"her carefully shaved head.{/n} \"My name is Linxia. I come from the distant "
"land of {g|Cheliax}Cheliax{/g} in search of a dangerous criminal who is "
"hiding in your barony.\""
msgstr ""
"\"{g|Order of the Rack}형벌 기사단{/g} 모두가 폐하께 인사를 올립니다.\" {n}갈색 피부의 여성이 당신을 향해 잘 "
"다듬어진 머리를 약간 숙인다.{/n} \"제 이름은 린시아입니다. 폐하의 영지에 숨어든 흉악범을 잡기 위해 "
"{g|Cheliax}첼리악스{/g}라는 먼 땅에서 왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0002_Text
msgctxt "08a25f41-02e8-4193-9a8f-0d91c1a2fdb2"
msgid ""
"{n}She stands tall and almost motionless. The reflected torch light dances "
"on the surface of her polished black armor and in the depths of her watchful "
"black eyes.{/n}"
msgstr "{n}그녀는 거의 미동도 하지 않고 고개를 올렸다. 그녀의 잘 닦인 검은 갑옷과 검은 눈동자에 반사된 빛이 반짝거린다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0003_Text
msgctxt "3e1e42d1-fd28-47e4-b293-e9bb66723abc"
msgid ""
"\"I am glad that we have met, and I believe the rule of law in your "
"{mf|barony|barony|kingdom|kingdom} is not just empty phrases. I hope for the "
"cooperation from your subjects and you personally.\" {n}Contrary to her "
"words, Linxia's face does not express any gladness. The corner of her mouth "
"twitches slightly, betraying carefully-concealed discontent.{/n}"
msgstr ""
"\"이렇게 만나 뵙게 되어 기쁩니다. 필시 이 영지의 법이 그저 장식은 아닐 것이라 믿습니다. 따라서 개인적으로 폐하께 협조를 요청하는 "
"바 이옵니다.\" {n}그녀의 말과는 다르게, 린시아의 표정에는 어떠한 기쁨도 찾아볼 수 없다. 마치 품고 있는 불만을 참고 있는 것처럼 "
"입꼬리를 약간 경련시키고 있다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0010_Text
msgctxt "2393e064-b28a-45ea-aa6c-63926d49603d"
msgid ""
"{n}Linxia's face remains as stony as ever. Only the corner of her mouth "
"expresses displeasure with your decision.{/n} \"You misunderstand me, "
"{mf|baron|baroness|king|queen}. The investigation will continue, with or "
"without your permission. The {g|Order of the Rack}Order of the Rack{/g} "
"always collects. No one should stay in its way.\""
msgstr ""
"{n}린시아의 표정이 어느 때보다 딱딱해진다. 입꼬리만이 당신의 결정에 불만이라는양 경련을 일으킨다.{/n} \"뭔가 오해가 있으신 "
"모양이군요, 폐하. 당신의 허락이 있든 없든 수색은 진행될 것입니다. {g|Order of the Rack}형벌 기사단{/g}은 누가 "
"길을 막든 앞으로 나아갑니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0011_Text
msgctxt "0b510764-06d1-4771-9d2d-49cadffdd2ea"
msgid ""
"\"A dangerous pirate, a murderer, and a rebel named Darven \"the Dashing\" "
"Fairwood. He was found guilty of inciting a rebellion and murdering a noble "
"lord in {g|Cheliax}Cheliax{/g}. The law of my Order is unwavering. The "
"punishment for such crimes is death.\""
msgstr ""
"\"위험한 해적이자 살인자, 반란분자인 그 놈의 이름은 \"질주\"의 다르벤 페어우드입니다. 첼리악스에서 영주를 살해하고 모반을 일으킨 "
"죄를 지었지요. 저희 기사단의 규정에 의하면 그런 범죄는 사형으로 다스려야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0012_Text
msgctxt "e0942171-3ee1-4932-8bd8-336d4244fa8f"
msgid ""
"\"Darven's rebellion took place in {g|Cheliax}Cheliax{/g} three years ago. "
"The {g|Order of the Rack}Order of the Rack{/g} quickly suppressed it, the "
"participants were jailed, and the instigators quartered — but their leader "
"Darven managed to escape. I have followed his trail for a long time, and now "
"it has led me here.\""
msgstr ""
"\"다르벤의 모반은 3년 전에 일어났습니다. {g|Order of the Rack}형벌의 기사단{/g}이 재빨리 모반을 진압해, 반란군의 "
"대부분은 감옥에 보내졌습니다. 하지만 우두머리인 다르벤만이 탈출에 성공했습니다. 오랜 시간의 추적 끝에 이 장소에 오게 된 것이지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0013_Text
msgctxt "8686925b-3db3-4cb0-a9d9-ca41159283a9"
msgid ""
"{n}The shadow of a smile crosses Linxia's face.{/n} \"I and my knights are "
"perfectly capable of finding and eliminating one criminal. Your help... is "
"unnecessary.\""
msgstr ""
"{n}린시아의 얼굴에 그림자가 드리웁니다.{/n} \"저와 제 기사들이 그 범죄자를 잘 처리할 것입니다 전하의 도움은... 불필요합니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0014_Text
msgctxt "1749dc76-413b-4ee2-a91f-ead0f0346c72"
msgid "\"If you want to help, do not interfere.\""
msgstr "\"정말 돕고 싶다고 하신다면, 방해만 하지 말아주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0015_Text
msgctxt "e9392ab9-e4f4-4b2d-92b0-a40541f471da"
msgid ""
"\"We are the {g|Hellknights}Hellknights{/g}. We guard law and order. "
"Legitimate authorities can rely on us entirely. Criminals tremble when they "
"hear our footsteps.\""
msgstr ""
"\"저희는 {g|Hellknights}헬나이트{/g}입니다. 법과 질서를 준수하지요. 저희는 정의를 위해 태어났고 범죄자들은 저희의 "
"발소리만 들어도 벌벌 떱니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0016_Text
msgctxt "91f2323b-1b65-4a40-b3ae-b74073146c95"
msgid ""
"{n}Linxia sizes you up.{/n} \"It is in your best interest to maintain "
"friendly relations with us. Trust me, {mf|baron|baroness|king|queen}.\""
msgstr "{n}린시아가 당신을 평가하는 눈으로 쳐다 본다.{/n} \"저희와 좋은 관계를 유지하시는 것이 유익하실 것입니다. 폐하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0017_Text
msgctxt "9f53ad6f-ffaf-4776-b6fa-fc0d24ed19ab"
msgid ""
"\"The Order of the Rack is a union of the knights of {g|Cheliax}Cheliax{/g}, "
"led by hatred of idleness, worthless philosophy, and useless knowledge. "
"Indulgence leads to lawlessness and insurrection. We seek out any "
"manifestations of dissent and burn them — be they books, scientific "
"treatises... or those who create them.\""
msgstr ""
"\"형벌 기사단은 나태함, 의미없는 철학, 쓸모없는 지식을 향한 증오를 바탕으로 설립된 {g|Cheliax}첼리악스{/g}의 "
"기사단입니다. 방종은 무법과 반란을 가져옵니다. 우리는 어떠한 이견의 징후든 찾아내 그것들을 불태워버립니다. 그것이 책이든, 과학적 "
"논문이든...혹은 그것들을 만든 사람이든 간에...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0023_Text
msgctxt "c7ecb6e2-6540-4899-b478-0b8538254769"
msgid ""
"{n}For a moment, Linxia stares at you with an intense look, but then blinks "
"as if suddenly relaxed.{/n} \"We stand on the side of legitimate authority. "
"You need not be afraid, {mf|baron|baroness|king|queen}.\""
msgstr ""
"{n}잠시동안, 린시아는 당신을 강렬한 눈길로 쏘아보았습니다, 그러나 이내 눈을 깜빡임과 함께 표정이 풀어집니다. {/n} \"저희는 "
"정의의 편에 서 있습니다. 당신께선 염려하실 필요가 없습니다, 폐하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0024_Text
msgctxt "329ba244-3e9c-4dd3-a811-0c9986c8cd3f"
msgid ""
"\"We do not burn all books, only those that can harm society and place "
"dangerous thoughts in weak-willed minds. It's better to burn a book today "
"than quarter its reader tomorrow.\""
msgstr ""
"\"저희가 모든 책을 불태우는 것은 아닙니다, 오직 사회에 해악을 끼치고 의지가 박약한 이들에게 위험한 생각을 품을 수 있게끔 하는 "
"것들을 불태우는 것입니다. 오늘 책을 태워 버리는 것이 내일 그것을 읽은 자들을 오체분시하는 것보다 낫습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0025_Text
msgctxt "deffc211-6fa2-4aec-9c7e-bcd87a6d5195"
msgid ""
"\"I... will try to fulfill your request.\" {n}She gives you a little "
"grin.{/n} \"At least — we'll let you know before we decide to burn someone.\""
msgstr ""
"\"저는....당신의 요청을 이행하도록 노력하겠습니다.\" {n}그녀는 작은 웃음을 지여보였습니다.{/n} \"적어도, 저희는 누군가를 "
"화형시키기로 결정하기 전에 당신에게 알리도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0026_Text
msgctxt "7b31d6be-710a-499c-b304-dcb0ddae2e24"
msgid ""
"{n}Linxia raises her eyebrow for a moment, as if she never expected such an "
"answer.{/n} \"I'm pleased to see that our judgments coincide. We will inform "
"you if, in the process of our investigation, we stumble upon any "
"manifestations of dissent in your {mf|barony|barony|kingdom|kingdom}.\""
msgstr ""
"{n}린시아는 마치 그런 대답을 전혀 기대하지 않았다는 것처럼, 잠시 그녀의 눈썹을 들어올려보였습니다.{/n} \"저는 우리의 판단이 "
"일치하는 것을 보아 기쁘게 생각합니다. 우리의 조사 과정 가운데, 당신의 {mf|남작령|남작령|왕국|왕국}에서 어떠한 이견의 징후를 "
"우연히 발견하게 된다면, 저희는 이를 당신에게 알릴 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaAppears/Cue_0027_Text
msgctxt "9a169683-77b6-4765-a2cc-4415ef8146d3"
msgid ""
"\"Thank you, {mf|baron|baroness|king|queen}. Your good will means a lot to "
"us.\""
msgstr "\"감사합니다, {mf|남작|여남작|왕|여왕}. 당신의 선한 의지는 우리에게 많은 것을 의미합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Answer_0006_Text
msgctxt "c1db6cba-03b1-4461-8441-2a1a67a09d9d"
msgid "\"Please don't read my letters anymore.\""
msgstr "\"제발 내 편지를 더는 읽지 말아줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Answer_0008_Text
msgctxt "9b3550d9-62bf-4555-a0fa-a751667220e2"
msgid "\"Fine, we'll go there as soon as we have time to spare.\""
msgstr "\"좋아, 우리가 여유가 되는데로 그곳으로 향하도록 하지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Answer_0010_Text
msgctxt "2270ad81-713c-4c5e-9d6a-c2393b757c25"
msgid "\"I don't want to have anything to do with those two.\""
msgstr "\"그 둘과 더 이상 어떤 일도 하고 싶지 않아.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Answer_0012_Text
msgctxt "3e052604-eafc-4e37-867d-50d996e54caa"
msgid "\"I'm absolutely sure. Let them both go to Hell — or worse.\""
msgstr "\"나는 전적으로 확신한다. 그 둘을 지옥으로 아니 더 나쁜 곳으로 보내라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Cue_0001_Text
msgctxt "788c3a66-afa2-47fd-957a-06a16ea4ea27"
msgid ""
"\"Looks like we're finally about to see another part of that story about "
"Darven and Linxia. But this time, a peaceful solution seems an unlikely "
"outcome.\" {n}Linzi sighs.{/n}"
msgstr ""
"\"우리가 마침내 다르벤과 린시아의 이야기의 다음 이야기를 보게 될 것 같아요. 그러나 이번에는, 평화적인 해결책이 있을것 같지 않아 "
"보여요.\" {n}린지가 한숨을 쉬었습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Cue_0002_Text
msgctxt "200ed1ac-4a71-4b41-870e-2094c9f75e90"
msgid ""
"\"Our esteemed {d|c41 Linxia Rejected}captain{/d} has sent us a "
"{g|darven_message}message{/g}. Here, take a look. He writes that he's built "
"a city near your border, and invites you to be his guest. But this "
"invitation has a foul smell, if you ask me — Linxia is bound to be there "
"too. I can bet that these two will be at each other's throat even before we "
"show up.\""
msgstr ""
"\"우리의 존경스러운 {d|c41 Linxia Rejected}선장님{/d}이 {g|darven_message}편지{/g}를 보내왔어요. "
"자, 한번 보세요. 우리 영지의 국경 지역에 도시를 세웠는데 전하를 초대한다네요. 그런데 조금 수상한 냄새가 나요. 린시아도 그곳에 "
"있겠죠. 분명 우리가 도착하기도 전에 서로 으르렁 거리고 있을 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Cue_0003_Text
msgctxt "a6985080-2457-49d2-bfbe-cfc59dbc6f0d"
msgid ""
"\"That wretched {d|c41 Linxia Welcomed}book-burner{/d} has sent us a "
"{g|linxia_message}message{/g}. Here you are — I hope you enjoy it. She's "
"softened her tone a bit, and now she's asking us to help her. She writes "
"that Darven has built a city near your border. So she's going to assault it, "
"and she's decided that we'll volunteer to be her reinforcement.\""
msgstr ""
"\"지긋지긋한 {d|c41 Linxia Welcomed}도서 방화범{/d} 린시아가 우리에게 {g|linxia_message}메시지{/g}"
"를 보냈어요. 여기요. 마음에 드시길 바라요. 어조가 좀 누그러지긴 했지만, 우리에게 도움을 청하네요. 편지에는 다르벤이 우리 국경 "
"근처에 도시를 건설했다고 쓰여있어요. 그곳에 공격을 감행할 예정이고, 우리가 증원군이 되어 줄 거라고 확신하는 모양인데요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Cue_0004_Text
msgctxt "7d89df44-b88d-4a62-9685-d676920a9385"
msgid ""
"{n}Linzi suddenly realizes something.{/n} \"You won't be offended that I "
"read your letter, right? It's just that the courier brought in an unsealed "
"paper, so I just...\""
msgstr ""
"{n}린지는 갑자기 무언가를 깨닫습니다.{/n} \"제가 먼저 읽었다고 화내지는 않을 거죠? 개봉된 상태로 전달받아서 그만...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Cue_0007_Text
msgctxt "253bacfd-abd0-48c5-9261-9bddad16e63a"
msgid ""
"\"But I just wanted to make sure that the case was really serious. So you "
"wouldn't get distracted over nothing. Uhh…\""
msgstr "\"그치만 이 사건이 정말 심각하다는 걸 알아주길 바랬을 뿐이에요. 읽는 걸 귀찮아 하실까봐. 히잉…\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Cue_0009_Text
msgctxt "f7f30c7f-bca3-4b7e-85ce-a6921ed0e7b3"
msgid ""
"\"I guess we should hurry, or they'll probably kill each other before we "
"even get there.\""
msgstr "\"빨리 가요, 안 그러면 우리가 도착하기도 전에 서로 살육전을 시작할 걸요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Cue_0011_Text
msgctxt "6f706f80-0b57-4354-addf-f8af351190de"
msgid ""
"\"Well, that's your right. To tell you the truth, I'm not a big fan of "
"either of them.\""
msgstr "\"음, 맞는 말이네요. 사실을 말하자면, 두 놈 다 마음에 안 들었거든요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Cue_0013_Text
msgctxt "2bd2f9b1-2c08-4f09-ba99-e58642bb9418"
msgid ""
"\"Are you sure? Maybe we should at least go and see what's going on there? "
"You know, for the sake of curiosity.\""
msgstr "\"정말요? 적어도 가서 무슨 상황인지 확인해야 하지 않을까요? 궁금하기도 하잖아요\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Items/DarvenMessageName_String
msgctxt "e7fdc669-d213-4e12-aa60-419fd7fe8c98"
msgid "Darven's Invitation"
msgstr "다르벤의 초대장"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Items/DarvenMessage_String
msgctxt "2b180f73-e335-4a6b-92c0-ceef57b46498"
msgid ""
"\"My dearest neighbor!\n"
"Now I have every right to call you so. Brineheart is located on the "
"riverbank in the southern Kamelands — right near the border of your lands. "
"So you can congratulate me now, my dream has finally come true, and I've "
"become a legitimate ruler of my own little kingdom. I strongly recommend you "
"come and congratulate me in person — for our dearest Linxia will most "
"definitely do the same in the nearest future. And I'd love it so much if all "
"three of us could gather near the fireplace and share the latest gossip over "
"a bottle of good wine. Without you, this gathering would be incomplete.\n"
"I'll be happy to cover all your travel expenses.\n"
"Your friend,\n"
"Darven.\""
msgstr ""
"\"나의 친애하는 이웃이여!\n"
"이제 난 자네를 그렇게 부를 권리가 충분히 있다네. 브라인하트는 케임랜드 남부의 강둑에 위치해있고 자네 영토의 경계 바로 근처지. "
"축하해주게나, 내 꿈이 결국엔 현실이 되서, 나만의 작은 왕국의 적법한 통치자가 되었으니. 자네가 찾아와서 날 친히 축하해주기를 열렬히 "
"권하는 바이네. 우리의 친애하는 린시아도 분명 머지않아 그렇게 할거거든. 그렇게 우리 셋이 난로 근처에 모여서, 와인 한 병 마시면서 "
"최근 유행하는 소문이나 떠들어대면 정말 좋겠구만. 그 자리에 자네가 빠져서야 되겠나.\n"
"자네 여행 경비는 전부 내가 기꺼이 부담하도록 하지.\n"
"자네의 친구,\n"
"다르벤.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Items/LinxiaMessageName_String
msgctxt "95ac7c93-d92c-4fc1-afe3-64ffeceb1f05"
msgid "Linxia's Order"
msgstr "린시아의 명령장"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LinxiaDarvenMessage/Items/LinxiaMessage_String
msgctxt "c9f22157-4b9a-4913-a96a-629dd4238285"
msgid ""
"\"We parted ways not on the best terms. But duty demands me to inform you "
"that the well-known criminal called Darven has founded a city in the "
"Kamelands, in the vicinity of your southern border. This hotbed of vice must "
"be stamped out, and Darven brought to justice. I'm heading to this "
"'Brineheart' immediately. If you have even a pinch of decency, you will do "
"the same.\n"
"Fulfill your duty.\n"
"Linxia Benzekri, the Order of the Rack.\""
msgstr ""
"\"우리는 최적의 시기에 작별하지는 못했습니다. 하지만 의무에 따라 고하니 당신 왕국의 남쪽 국경 근처 케임랜드에서 유명한 범죄자인 "
"다르벤이 도시를 건설했다는 사실을 알립니다. 이 악의 온상은 짓밟아야만 하며, 다르벤은 정의의 심판을 받아야 합니다. 저는 지금 즉시 "
"'브라인하트'라는 곳으로 향하고 있습니다. 당신에게 명예라는 것이 존재한다면, 당신도 저와 같이 할 것입니다. \n"
"의무를 다하십시오.\n"
"린시아 벤제크리, 형벌 기사단.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc41-LostNoble-fail/Cue_0001_Text
msgctxt "ebcecac3-048d-440d-80e1-46f2269f5715"
msgid ""
"\"Your Grace, I came to say farewell. Alas, I must return to my homeland — I "
"have responsibilities as family head. Thank you for everything you've done "
"for me. Take care of yourself.\""
msgstr ""
"\"전하, 작별인사를 전하러 왔습니다. 아아, 전 고향으로 돌아가야만 합니다. 가장으로서의 책임이 있기에. 저를 위해 해주신 모든 일에 "
"감사드립니다. 잘 지내십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Answer_0006_Text
msgctxt "767dc6b0-6a1c-4e95-8be1-2b62b73f77a8"
msgid "\"Let's start from the beginning. How did you even come up with this?\""
msgstr "\"처음부터 시작해볼까. 어떻게 이런걸 생각해낸거야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Answer_0007_Text
msgctxt "647b3068-81db-4335-bba9-8bff9d059b9c"
msgid "\"What exactly are you going to do?\""
msgstr "\"정확히 뭘 하려는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Answer_0008_Text
msgctxt "68a91730-14c5-47ac-b6d4-7305436d4bce"
msgid "\"What will we achieve by this?\""
msgstr "\"이걸로 우리가 얻는게 있나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Answer_0009_Text
msgctxt "1e1c7c90-8e9c-47e0-aace-eb61d8b3452e"
msgid ""
"\"Fine. I'll order you to be provided with everything you need. Get me "
"results.\""
msgstr "\"좋아. 네가 필요로 하는걸 모두 제공받을 수 있도록 할게. 결과를 가져와.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "2d08e205-6398-4d15-b125-e5b820ae253d"
msgid ""
"\"And then {mf|King|Queen} {name} proudly said: \"Your evil deeds end now!\" "
"Or is it better as, \"We've uncovered your vile plan!\"? {n}Linzi's trying "
"to write something on the go, but she interrupts herself and looks up.{/n} "
"\"Oh... Your Highness! We have unbelievably, terribly important news! We "
"managed to find out... discover... invent... Well... here,\" {n}Linzi points "
"to the Storyteller.{/n} \"He'll tell you!\""
msgstr ""
"\"{name} {mf|왕|여왕}은 위풍당당하게 말을 이었습니다. \"오늘부로 너의 악행은 끝이다!\" 아님 이게 낫나? \"네 사악한 "
"음모는 이미 알고 있다!\" {n}린지는 쉴 새 없이 무언가를 써 내려가다, 중단하고 위를 올려다봅니다.{/n} \"전하! 믿을 수 없을 "
"정도로 중요한 소식이 있어요! 겨우 찾았... 발견... 발명... 음... 여기.\" {n}린지가 이야기꾼을 가리킵니다.{/n} "
"\"이분이 말해주실 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Cue_0002_Text
#. Speaker : Capital_Collector
msgctxt "014f35cf-6689-4133-a17a-b572f7321edb"
msgid ""
"{n}The Storyteller waits patiently until Linzi finishes her ardent "
"speech.{/n} \"I will have to begin from afar to let you see what I 'saw' "
"with my blind eyes... The {g|Stolen Lands}Stolen Lands{/g} are like a cradle "
"in an abandoned house, in which the wind swings the skeleton of a child. No "
"few newborn kingdoms have died here, just after taking their first breath. I "
"have collected their stories, these precious stars that have been lost in "
"the dust. And I began to notice some commonalities.\""
msgstr ""
"{n}이야기꾼은 린지의 열렬한 발언이 끝낼 때까지 참을성 있게 기다립니다.{/n} \"제가 멀어버린 눈으로 '보는' 것들을 보여드리려면 "
"먼 곳에서부터 시작해야할 것 같군요... {g|Stolen Lands}도둑맞은 땅{/g}은 바람이 아이의 유골을 흔드는, 버려진 집에 "
"있는 요람과 같습니다. 적지 않은 수의 신생 왕국이 이 땅에서 첫 숨을 쉬자마자 죽었습니다. 저는 그 이야기들, 먼지에 묻혀 사라진 "
"소중한 별들을 모아왔습니다. 그리고 일종의 공통성에 대해 깨닫게 되었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Cue_0003_Text
#. Speaker : Capital_Collector
msgctxt "f984cdec-3770-480d-a01f-38f50c468959"
msgid ""
"\"It is like a pattern that repeats across different embroideries. The "
"handwriting of the same author across all their stories. One word here, "
"another hint there... false visions, references to a mysterious patroness, "
"lover, and mentor... Tragic \"coincidences,\" strangely nonrandom... Peoples "
"and countries were brought to destruction along different roads, but behind "
"them, there always stood the same ominous shadow.\""
msgstr ""
"\"이건 마치 다른 자수에 걸쳐 반복되어 나타나는 무늬와 같습니다. 같은 작가가 쓴 모든 이야기들의 필적과도 같지요. 여기에서 하나의 "
"단어가, 저기에서 다른 단서가... 거짓된 환영, 신비로운 여성 후원자, 연인, 그리고 조언자에 대한 언급들... 우연이라고 보기 힘든 "
"비극적인 \"우연들\"... 사람들과 국가들이 다른 길을 거쳐 파괴에 이르게 되지만, 그들 뒤에는, 항상 똑같은 불길한 그림자가 "
"서있었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Cue_0004_Text
#. Speaker : Linzi_Companion
msgctxt "f312335d-3bf5-4860-bf81-9625d59ab206"
msgid ""
"\"And we know what that shadow is! Nyrissa!\" {n}The name sounds ominous "
"even in the mouth of a restless bard.{/n} \"The evil nymph who sent monsters "
"to our lands and did all that stuff to Tristian! But that's not even the "
"most important thing. Most importantly, if you help us a bit — we can get "
"her!\""
msgstr ""
"\"이제 우린 그림자의 정체를 알아요! 나이리사죠!\" {n}음유시인의 경쾌한 어조에도 불길하게 들리는 이름입니다.{/n} \"우리에게 "
"괴물을 보내고, 트리스티안에게 못된 짓을 한 님프죠! 당장은 그게 중요한 게 아니에요. 전하께서 조금만 도와주시면 우리가 나이리사를 잡을 "
"수 있다니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Cue_0010_Text
#. Speaker : Linzi_Companion
msgctxt "9adb005a-a5df-47ae-94ea-ce955820ed47"
msgid ""
"\"Weelll, it all started with the fact that I really wanted to listen to the "
"Storyteller's stories. I've been following him for a long, long time... and "
"asked... and told him about our adventures... and sometimes I just sat "
"beside him and we chatted. Finally, after I told him about the Defaced "
"Sisters and all the horrors of the abandoned castle, he noticed that the "
"story seemed strangely similar to ones he'd heard before.\""
msgstr ""
"\"그게에, 모든건 제가 이야기꾼의 이야기를 정말 듣고싶어했다는 사실에서 시작해요. 저는 그를 오래, 오랫동안 따라다니면서... "
"물어봤어요... 그리고 우리 모험에 대해서 얘기해줬죠... 가끔은 그냥 옆에 앉아서 잡담을 하기도 했어요. 마침내, 제가 얼굴 잃은 "
"자매들과 버려진 성에서의 여러 무서운 일들에 대해 얘기하고나서, 그는 이야기들이 그가 예전에 들었던 것들과 이상할 정도로 닮아있다는 것을 "
"알아냈어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Cue_0011_Text
#. Speaker : Linzi_Companion
msgctxt "19f46f34-e0e4-4b35-a951-a9ff29d341b7"
msgid ""
"\"The bards know how to send messages through dreams. I try not to use it — "
"for some reason, people got mad when I appeared in their dreams to read my "
"new poems! Well, the Storyteller came up with a ritual based on that spell. "
"We'll collect everything connected to Nyrissa. Everything, starting with her "
"every track in the abandoned castle. After gathering everything, we'll unite "
"his ability to tell stories with my ability to travel into dreams. So, we'll "
"be able to enter Nyrissa's dream!\""
msgstr ""
"\"음유시인은 꿈을 통해 메시지를 보낼 수 있어요. 저는 웬만하면 안 하려고 하는데, 그게... 제가 꿈에 나타나 새로 쓴 시를 "
"읽어주려고 하면 사람들이 화를 내더라구요! 아무튼 이야기꾼이 어떤 의식을 발견했어요. 음유시인의 능력과 비슷한 의식이죠. 나이리사에 "
"관련된 물건을 모두 모아야 해요. 전부요. 버려진 성에 남은 흔적부터 시작해요. 다 모으고 나면, 이야기꾼과 제 능력을 합칠 거예요. "
"나이리사의 꿈에 들어갈 수 있게 되는 거죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Cue_0012_DreamsProject_Text_String
#. Speaker : Capital_Collector
msgctxt "2b7b9b41-bed9-48a8-a388-1046ed38ee35"
msgid ""
"\"Come to me after we finish the preparations, and remember that I cannot "
"send anyone except you and Linzi into Nyrissa's dream world. Whatever you "
"have to face, you will have to overcome together. And the path will likely "
"be difficult.\""
msgstr ""
"\"준비를 모두 마치고 나서 제게 오십시오. 다만 나이리사의 꿈에는 전하와 린지, 두 사람만 들어갈 수 있음을 염두에 두시기 바랍니다. "
"안에서 무엇을 마주하든, 함께 극복해야 할 겁니다. 분명 힘든 일이 되겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Cue_0013_Text
#. Speaker : Linzi_Companion
msgctxt "8efa72b2-33e0-4de6-93ab-8c694e2edbbf"
msgid ""
"\"We'll learn all her evil secrets! The ritual will let us see her hidden "
"thoughts and dreams. Well, theoretically... It's not like anyone's ever done "
"this before...\""
msgstr ""
"\"나이리사의 사악한 비밀을 모두 알아내자구요! 의식에 성공하면 나이리사의 숨겨진 계획을 알게 되겠죠. 이론적으로는요... 선례가 있는 "
"일이 아니라...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Cue_0014_Text
#. Speaker : Capital_Collector
msgctxt "a048ee4d-1b31-4827-83b6-c9d886f9994d"
msgid ""
"\"It can be dangerous,\" {n}the Storyteller says quietly.{/n} \"In dreams, "
"monsters are more terrible than those we meet in the real world. But I urge "
"you to not neglect this chance, {mf|King|Queen}. You are opposed by a "
"powerful enemy, one who has destroyed dozens of kingdoms and empires. If you "
"do not meet her face-to-face, do not discover her weaknesses — your country "
"will end up just another of my stories.\""
msgstr ""
"\"위험할 수 있습니다.\" {n}이야기꾼이 조용하게 말합니다.{/n} \"꿈에서의 괴물들은 우리가 실제 세계에서 마주친 것보다 "
"끔찍합니다. 하지만 이 기회를 무시하지 않으셨으면 합니다, {mf|왕|여왕}이시여. 전하는 강력한 적을 상대하고 있습니다. 수십 개의 "
"왕국과 제국을 파괴한 존재이지요. 그녀를 직접적으로 마주치지 않으면, 약점을 찾아낼 수도 없을 겁니다. 그리고 전하의 왕국은 제 이야기 "
"중 하나로 끝나게 되겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Cue_0015_Text
#. Speaker : Linzi_Companion
msgctxt "97a68e39-2fe3-4a1d-a316-3ea79304840e"
msgid ""
"\"Do we still have that amulet with the string of hair that she gave you "
"before the battle with the Stag Lord? That'd be great! That'll let us finish "
"all the preparations much faster and easier!\""
msgstr ""
"\"수사슴 군주와 싸우기 전에 나이리사가 줬던 목걸이, 아직 가지고 계신가요? 그럼 좋을 텐데! 목걸이가 있으면 준비가 빨라질 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_DreamScape/Cue_0016_Text
#. Speaker : Linzi_Companion
msgctxt "771c4a23-8d48-4131-bf75-cd3d133213e6"
msgid ""
"\"It's a pity that we don't have that amulet with the string of hair that "
"Nyrissa gave you before the battle with the Stag Lord — you know, back when "
"she was pretending to be a poor suffering nymph? With that, we could have "
"finished all the preparations much faster and easier!\""
msgstr ""
"\"수사슴 군주와 싸우기 전에 나이리사가 줬던 목걸이가 없다니 아쉽네요. 그, 있잖아요. 나이리사가 불쌍한 님프인 척했을 때 말이에요. "
"그게 있었다면 준비가 훨씬 빨랐을 텐데!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Answer_0002_Text
msgctxt "ae13b296-0ad1-4384-9a3b-de21e70f5007"
msgid "\"What happened, Linzi?\""
msgstr "\"린지, 무슨 일입니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Answer_0003_Text
msgctxt "d5594e6f-8635-4f38-8ce6-fb277a7fe858"
msgid "\"Just take some time to catch your breath and explain what happened.\""
msgstr "\"잠시 숨을 돌리고 무슨 일이 벌어진건지 설명해라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Answer_0004_Text
msgctxt "1de32748-b105-4c0c-83ef-16ba47e056a6"
msgid "\"I don't have time to spare for your nonsense.\""
msgstr "\"네 말도 안되는 일에 쓸 시간이 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Answer_0009_Text
msgctxt "aed77bd1-456a-4566-a95f-298cd295809c"
msgid "\"What happened here?\""
msgstr "\"여기서 무슨 일이 벌어진거야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Answer_0010_Text
msgctxt "756b5899-f150-476a-91bc-dea8c4754617"
msgid "\"This is... unexpected.\""
msgstr "\"이건... 예상 밖인데\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Answer_0011_Text
msgctxt "c1cf116d-b568-428c-b1ed-d8033aac86e2"
msgid "\"Who did this?!\""
msgstr "\"누가 이런 짓을?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Answer_0018_Text
msgctxt "a5ab4654-f8d1-43a7-b020-02368f56c136"
msgid "\"In your opinion, where should I begin this investigation?\""
msgstr "\"네가 보기에는, 어디서부터 조사를 시작해야 좋겠어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Answer_0019_Text
msgctxt "1047f414-53d6-4f56-8a8a-10f540b31365"
msgid "\"Oh, if I manage to catch this thief…\""
msgstr "\"오, 이 도둑을 잡을 수 있다면...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Answer_0020_Text
msgctxt "f8889338-cc5c-45bc-94cf-81d3452b56cc"
msgid "\"Time to get going.\""
msgstr "\"시작하자.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Answer_0025_Text
msgctxt "882599b0-dc1c-42db-9f53-6ab6e16f95c2"
msgid "\"What were my guards doing?!\""
msgstr "\"내 경호원들은 무얼하고 있었나?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Cue_0001_Text
msgctxt "34711514-30f9-48dc-ad9a-9f774b7492a1"
msgid ""
"{n}Linzi's eyes glitter and her nostrils flare with rage, but for some "
"reason she speaks in a whisper.{/n} \"Such... such insolence! Such "
"unforgettable, monstrous, unimaginable insolence!\""
msgstr ""
"{n}린지의 눈은 번뜩이고 그녀의 콧구멍도 분노로 벌름거렸지만, 무슨 이유때문인지 그녀는 나지막히 이야기했습니다.{/n} \"이...이 "
"오만함! 잊을 수 없고, 괴물같은, 상상할 수도 없는 오만함이라니!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Cue_0005_Text
msgctxt "52ed9ee3-50ff-474c-84c9-7220493bc5e8"
msgid ""
"{n}Linzi suddenly and firmly grabs your sleeve.{/n} \"Nonsense? How can it "
"be nonsense if Your Royal Highness now has no place to, pardon my language, "
"sit {mf|his|her} royal ass on?!\""
msgstr ""
"{n}린지가 갑자기 그리고 단단히 당신의 옷소매를 잡아당겼습니다. {/n} \"말도 안된다니? 무례하게 말해서 미안하지만, 전하가 앉을 "
"자리조차 없어졌는데 어떻게 말도 안되는 소리를 할 수 있겠어?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Cue_0006_Text
msgctxt "65dfcff8-34d9-4a19-885e-7c24ce1721d6"
msgid ""
"\"The throne... The royal throne... It...\" {n}Linzi stops whispering and "
"silently points her finger to the far side of the throne room.{/n}"
msgstr "\"왕좌....왕좌가....\" {n}린지는 속삭이는 걸 멈추고는 그녀의 손가락으로 왕좌의 방 저 먼 곳을 가르켰습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Cue_0007_Text
msgctxt "9af6d806-33d0-4d48-8aa8-f9405457ff77"
msgid ""
"{n}Linzi catches her breath and continues to whisper,{/n} \"Your Highness, "
"we've got a problem. A major problem. Look for yourself!\" {n}The bard "
"points her finger toward the far side of the throne room.{/n}"
msgstr ""
"{n}린지는 숨을 들이쉬고는 나즈막히 이야기를 계속했습니다,{/n} \"전하, 우리에겐 문제가 있어요. 아주 큰 문제이지요. 직접 보세요!"
"\" {n}바드는 그녀의 손가락으로 왕좌의 방의 먼 한켠을 가르켰습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Cue_0008_Text
msgctxt "20c402bd-20d8-4427-8038-f20fb2e58a19"
msgid ""
"{n}You raise your eyes. The place where the royal throne once stood is now "
"empty.{/n}"
msgstr "{n}당신은 눈을 들었습니다. 한 때 왕좌가 자리했던 곳은 이제 텅 비어있었습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Cue_0012_Text
msgctxt "ac40ba35-783b-4acc-bb75-600160484863"
msgid ""
"{n}Linzi shrugs.{/n} \"The culprit managed to escape, but I can't imagine "
"how someone could drag the throne out of the palace without being noticed by "
"anyone!\""
msgstr ""
"{n}린지는 어깨를 으쓱거렸습니다.{/n} \"범인은 도망쳐 버렸어요, 하지만 난 도대체 어떻게 아무에게도 눈에 띄지 않고 왕좌를 "
"끌어다가 왕궁 밖으로 나갈 수 있었는지 상상조차 할 수 없어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Cue_0013_Text
msgctxt "6e9dcf2f-33b6-4690-b15d-5bc033cc7f19"
msgid ""
"\"Insidious, shameless robbery — that's what happened here! Who would even "
"think to break into the royal chambers!\""
msgstr "\"남몰래 파렴치한 강도짓을 하다니! 어떻게 감히 알현실에 침입할 생각을 한 걸까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Cue_0014_Text
msgctxt "fe1438c9-bec4-406a-9184-cca3941f5be1"
msgid ""
"\"I'm surprised by your self-control: if I were you, I'd go on a rampage! "
"Shameless scum, how could they go and rob the royal palace with the "
"{mf|king|queen} still alive and well!\""
msgstr ""
"\"놀랍도록 자제력을 잃지 않으시네요. 저 같으면 난동을 부렸을 거예요! 몰염치한 놈들! {mf|왕|왕비}가 버젓이 살고 있는 왕궁에 "
"들어와 왕좌를 털어가다니!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Cue_0015_Text
msgctxt "605a1d5e-039b-45ed-b222-c9904d8901a8"
msgid ""
"\"In fact, our case is blatant and extraordinary, but hardly exceptional. "
"Word on the streets is that the local population has become sick and tired "
"of thieves — they break into people's homes, bypass the locks and latches, "
"and steal everything they can! And now the scum has the guts to meddle with "
"royal property!\""
msgstr ""
"\"사실, 우리에게 일어난 일은 뻔뻔하고 놀라운 일이지만, 이례적인 것은 아니에요. 거리에 떠도는 말들로는 이 지역 사람들이 도둑들 "
"때문에 골머리를 썩히고 있다고 해요. 그들은 사람들에 침입해와서는 자물쇠나 걸쇠를 따고는 그들이 훔칠 수 있는 모든 건 훔쳐간다고 해요! "
"그리고 이제 이 쓰레기들은 왕가의 재산을 건드릴 정도로 대담해진거죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Cue_0016_Text
msgctxt "54dcb5be-0352-42fe-ae57-72fd8dc4b7a9"
msgid ""
"\"We need to sort this out before they steal the whole kingdom one brick at "
"a time... and we need to get back your throne! It's shameful!\" {n}Linzi "
"regains control of herself and continues in a low whisper.{/n} \"I really "
"hope your people here won't go wagging their tongues and spreading filthy "
"rumors.\""
msgstr ""
"\"그들이 왕국의 벽돌 한 장마저 훔쳐가기 전까지 이 일을 정리해 봐야할 것 같아요...그리고 당신의 왕좌도 되돌려 받아야 하구요! 이건 "
"수치스러운 일이라구요!\"{n}린지는 다시금 그녀 스스로를 다스려서 낮은 목소리로 계속 말했습니다.{/n}\"저는 진심으로 당신의 여기 "
"당신의 백성들이 함부로 혀를 놀리고 불경한 소문을 내길 바라지 않아요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Cue_0021_Text
msgctxt "09504c3a-9012-4be3-820d-40828693dcf9"
msgid ""
"\"You should start with interrogating potential witnesses! I think the "
"captain of the guard was in the palace when it happened — he was the one who "
"discovered the throne was missing, at least!\""
msgstr "\"목격자 심문부터 시작해요! 제 생각에는 경비대 대장이 사건 당시 왕궁에 있었을 거예요. 최초 발견자이기도 하고요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Cue_0022_Text
msgctxt "c7f59406-6615-442c-a041-5e3a7477c418"
msgid ""
"\"Then you should go to the city. I heard the smith was robbed recently too. "
"Maybe he can give you some clues? Also, if I were you, I'd talk to the "
"trader — he might have some hints as to who may be selling stolen goods. Oh, "
"and one more thing — don't forget to visit the innkeeper. Who better to "
"glean information from any troubled locals finding themselves in need of a "
"shoulder to cry on?\""
msgstr ""
"\"그리고 도시에 나가보세요. 듣기로는 대장장이도 최근에 강도를 당했대요. 어쩌면 단서가 있을지도 모르죠. 저라면, 상인과도 대화를 해볼 "
"거예요. 훔친 왕좌를 살 만한 사람을 알지도 모르니까요. 한 가지 더. 여관 주인도 꼭 찾아가 보세요. 울고 싶을 때 어깨를 내주는 "
"사람만큼 많은 정보를 알고 있는 사람이 어디 있겠어요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Cue_0023_Text
msgctxt "0e74859f-764b-4ed3-9cd8-5f9c704c521e"
msgid ""
"{n}Linzi shakes her head.{/n} \"Whatever your upcoming plans were, "
"retrieving the throne must be your top priority! I dread to think how loud "
"our neighbors will laugh if they learn of this disgrace!\""
msgstr ""
"{n}린지는 그녀의 머리를 가로져었습니다.{/n}\"계획하고 계신게 무엇이든간에, 왕좌를 되찾는 것이 가장 우선순위에요! 이 치욕을 "
"우리의 이웃들이 알게되면 얼마나 크게 웃어재낄지 상상하기조차 겁나요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_RunawayThrone/Cue_0026_Text
msgctxt "6742b559-8ad9-4abf-9dd9-5863e20ed18b"
msgid ""
"{n}Linzi flings her arms up.{/n} \"Well, you weren't on the throne at the "
"time it was stolen, right? And our guards are trained to guard people, not "
"furniture!\" {n}The bard gives you a faint smile.{/n} \"Sure, if the throne "
"was stolen with you still sitting on it, things would be much worse. That's "
"not much consolation, though...\""
msgstr ""
"{n}린지는 팔을 걷어 붙였습니다.{/n}\"그럼, 왕좌를 도둑맞았을 때 거기에 앉아계셨던 것은 아닌거죠? 그리고 우리 경비대는 사람들을 "
"보호하려고 훈련했죠, 가구가 아니라요!\"{n}이 음유시인은 당신에게 희미한 미소를 건냅니다.{/n}\"물론, 왕좌에 앉아있는데도 "
"도둑맞은 거였다면 일이 더 안좋았겠죠. 이건 별로 위로가 되진 않지만 서도요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Answer_0003_Text
msgctxt "61e6b680-cc8b-4069-92b3-bb9d36446568"
msgid "\"What is this tournament?\""
msgstr "\"이 토너먼트는 뭐지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Answer_0005_Text
msgctxt "db3cf8fd-7b5a-4373-9277-f01c1ff608f3"
msgid ""
"\"If Irovetti holds it once in several years, why did he wait until now to "
"invite me?\""
msgstr "\"이로베티가 몇 년에 한 번씩 그걸 개최한다면, 왜 그는 나를 초대하기 위해 여지껏 기다린걸까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Answer_0007_Text
msgctxt "b4db21d4-2776-4e36-9a24-a6e66c533a9c"
msgid "\"Are you sure this isn't a trap?\""
msgstr "\"이것이 함정이 아니라고 확신해?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Answer_0008_Text
msgctxt "2c4b356c-0a74-4ec2-9fea-454a56b7b1af"
msgid "\"What can you tell me of Pitax and its king?\""
msgstr "\"피탁스와 그 왕에 대해 이야기해줄 수 있어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Answer_0012_Text
msgctxt "939a0f69-35c8-497e-ab21-42c7cbff327a"
msgid ""
"\"Irovetti can go straight to the Abyss with his tournament. Write back that "
"I won't be attending.\""
msgstr "\"이로베티는 그의 토너먼트와 함께 나락으로 직행할 수 있어. 나는 참석치 않는다고 답장해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Answer_0013_Text
msgctxt "eb0d25a7-0225-425e-b25e-868616ce62a8"
msgid "\"Interesting. Well, If I have the time... why not?\""
msgstr "\"흥미롭군. 뭐, 나에게 시간이 있다면... 안 될 이유가 어딨어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Answer_0016_Text
msgctxt "3da546cb-3c59-4127-9c9d-d22e051c631b"
msgid "\"Perhaps you're right... Tell me more about this tournament.\""
msgstr "\"아마도 네가 맞겠지...이 토너먼트에 대해서 더 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Answer_0017_Text
msgctxt "a6d17953-6bc7-496f-b84e-d29463085e50"
msgid "\"I'm sure. I've no interest in seeing Pitax or Irovetti.\""
msgstr "\"난 확실히, 피탁스나 이로베티를 보는 것에 관심이 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Cue_0001_Text
msgctxt "012d390d-d369-44f6-a159-17910fffb461"
msgid ""
"{n}Linzi excitedly waves around {g|RushlightInvitation}a letter{/g} written "
"in neat handwriting on expensive stationery.{/n} \"I have news! Take a look! "
"Irovetti, King of {g|Pitax}Pitax{/g}, sent you an invitation to the "
"Rushlight tournament! We're not going to miss it, right? And you're taking "
"me, of course!\""
msgstr ""
"{n}린지는 비싼 편지지에 깔끔한 필기체로 적힌 {g|RushlightInvitation}편지{/g}를 흔들어 댔습니다.{/n}\"소식이 "
"있어요! 이것 좀 봐요! {g|pitax}피탁스{/g}의 왕 이로베티가 당신께 러시라이트 토너먼트 초대장을 보내왔어요! 우린 거길 꼭 "
"가야되요, 그렇죠? 당연히 저를 데리고 가야되요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Cue_0004_Text
msgctxt "862bb265-b5f8-4b86-9907-7fbd808b5f6e"
msgid ""
"\"Irovetti holds once in several years. Guests come from all the nearby "
"kingdoms — {g|Mivon}Mivon{/g}, Gralton, {g|Brevoy}Brevoy{/g}... I haven't "
"been there personally, but I hear it's always a lot of fun!\""
msgstr ""
"\"이로베티는 몇 년에 한번씩 그걸 개최해요. 모든 주변 왕국들로부터 손님들이 오죠. {g|Mivon}미본{/g}, 그랄튼, "
"{g|Brevoy}브레보이{/g}... 거길 개인적으로 가본 적은 없었지만, 아주 재밌다고 들었어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Cue_0006_Text
msgctxt "152bf7db-8716-4c13-98f4-67bd1b3b712c"
msgid ""
"\"How would I know what goes on in Irovetti's head? Maybe he just thought "
"you weren't important enough as a baron{mf||ess} — but now you're a bona "
"fide {mf|king|queen}! His equal, you could say! There's no reason not to "
"invite you to what he considers the major social event of the year.\""
msgstr ""
"\"이로베티의 머릿속에서 어떤 일이 벌어지는지 어떻게 알 수 있을까요? 어쩌면 그는 당신을 단지 {mf|남작|여남작} 정도로만 여기고 "
"있었다가 이제 당신이 진정한 {mf|왕|여왕}이 되었다고 생각할 수도 있지요! 그와 동등하다고 말할 수 있겠네요! 그가 한 해의 가장 "
"중요한 사회 행사라고 여기는 곳에 당신을 초대하지 않을 이유가 없지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Cue_0009_Text
msgctxt "65ff4a10-d217-4f3f-8126-2e6abb093f69"
msgid ""
"\"Well... Imagine a roadhouse full of pirates, mercenaries, smugglers, "
"spies, and other gentlemen of fortune. They're drinking to their successes, "
"talking business, buying, selling, hiring, choking, burying... Now take this "
"roadhouse, and imagine it's the size of a kingdom — that was "
"{g|Pitax}Pitax{/g} BEFORE Irovetti.\""
msgstr ""
"\"음... 해적들, 용병들, 밀수꾼들, 염탐꾼들 그리고 다른 모든 범죄자들이 가득한 술집이 있다고 상상해자구요. 그들이 자기들의 "
"성공담을 이야기하며 술 마시고, 사업에 대해 떠들고, 사고, 팔고, 고용하고, 목을 조르고, 땅에 파묻고...이제 이 술집을 가져다가 "
"그게 왕국 크기라고 상상해볼까요. 그게 바로 이로베티가 나타나기 전의 {g|pitax}피탁스{/g}였어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Cue_0010_Text
msgctxt "72639bc2-8d09-412b-bd9c-fc25a8023879"
msgid ""
"\"Now imagine some unknown bard enters the roadhouse, pulls off a few shady "
"deals, and suddenly became its owner. Everything is the same as it was, but "
"now the walls are covered with portraits of the owner, a brass band plays "
"music every night, a juggler with a pet bear walks around the room, gnome "
"strippers dance on the tables, barmen sell a variety of racy substances from "
"{g|Numeria}Numeria{/g} beyond its beer... That's {g|Pitax}Pitax{/g} now.\""
msgstr ""
"\"이제 그 술집에 어떤 무명의 바드가 들어갔다고 상상해봐요. 몇 가지 수상한 거래를 하더니, 갑자기 그곳의 주인이 된 거죠. 모든 것은 "
"전과 같지만, 벽에는 그 주인의 초상화가 걸려있고, 금관악단이 매일 밤마다 연주를 하고, 애완 곰을 데리고 묘기꾼이 방 안을 돌고, 노움 "
"스트리퍼들이 테이블 위에서 춤을 추고, 바텐더들이 맥주 뿐만이 아니라 다양한 {g|Numeria}누메리아{/g}산 흥분제들을 "
"파는...그게 지금의 {g|pitax}피탁스{/g}에요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Cue_0011_Text
msgctxt "f9be568e-ad73-4289-b913-2fb8ee3da29e"
msgid ""
"\"It's certainly possible! There's definitely some catch here — this is "
"Irovetti we're talking about, after all! But I doubt he'd try to kill you at "
"his own festival, with business partners from all his neighbors present. "
"He's more likely to try to sell you on some fraudulent deal or another. So "
"keep your eyes and ears open, and don't sign anything!\""
msgstr ""
"\"확실히 가능해요! 확실히 뭔가 잡히는게 있지요. 우리가 이야기했던 이로베티는 어쨌든 그런 사람이거든요! 그렇지만 저는 그가 그의 "
"이웃국가들로부터 온 동업자들이 가득한 축제 한 가운데서 당신을 죽이려고 할까 미심쩍어요. 그는 아마도 당신에게 어떤 엉터리 거래나 다른 "
"걸 시도하지 않을까요. 그러니 눈을 크게 뜨고 잘 들어야 해요, 아무거에나 사인하면 안되구요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Cue_0014_Text
msgctxt "4ce798ad-4982-4d42-a942-6825b4a03862"
msgid ""
"\"Are you sure? I mean, it's certainly a trap... but imagine all the fun "
"you'll miss!\""
msgstr "\"확실한가요? 제 말은, 그건 틀림없이 함정이겠지만...당신이 놓칠 모든 즐거움을 상상해봐요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Cue_0018_Text
msgctxt "ec20a883-d26c-4c4b-a94f-629cdfa039ae"
msgid "\"Of course! What would you like to know?\""
msgstr "\"당연하죠! 무얼 알고 싶으세요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Cue_0019_Text
msgctxt "1688046f-b946-4d8b-b5fd-3a7527886700"
msgid "\"If you say so... I'll pen the response now.\""
msgstr "\"그렇게 이야기하신다면야...바로 답장을 할게요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Cue_0020_Text
msgctxt "e48f35e7-afab-4f7d-9b83-2b8e0941475f"
msgid ""
"\"Great! Trap or no, it'll at least be a ton of fun. You will take me with "
"you, right? Pretty please?\""
msgstr "\"좋아요! 함정일 수도 있지만, 엄청 재미있을 것 같네요. 저 데려가 주실 거죠? 그렇죠? 제발요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Cue_0021_Text
msgctxt "90ba744d-560b-45ac-a6f3-54b051efbae7"
msgid ""
"\"All the high society of {g|Pitax}Pitax{/g} will be there... including "
"people from the {g|Academy of Grand Arts}Academy{/g}! Maybe even Headmaster "
"Atalia Gitaren. I'd love to see her face when she hears about the book "
"Professor Eobald is writing with me!\""
msgstr ""
"\"{g|pitax}피탁스{/g}의 고위층은 다 거기 올 거예요... {g|Academy of Grand Arts}아카데미{/g} "
"사람들도 포함해서 말이죠! 아탈리아 지타렌 학장님도 계실지 몰라요. 이오발드 교수님과 제가 함께 책을 쓰게 되었다는 소식을 들려주면 "
"학장님께서 어떤 표정을 지을지 궁금하네요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Items/Letter_Rushlight-Invite_Name_String
msgctxt "a0fda451-3f59-4533-9e5e-2ca63ace9a53"
msgid "Invitation to the Rushlight Tournament"
msgstr "러시라이트 토너먼트 초청장"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_Rushlight/Items/Letter_Rushlight-Invite_Text_String
msgctxt "d2fbab78-014a-42e6-85cd-4bf573ffdde8"
msgid ""
"\"Your Royal Highness, the much-esteemed and illustrious {Name}, tamer of "
"Dunsward and the Stolen Lands, hero{mf||ine} of the battle against the "
"barbarian hordes on the Flintrock Grassland, et cetera, et cetera, et cetera."
"\n"
"I am happy to hereby invite you to the Rushlight Tournament — the most "
"important social event in the River Kingdoms, where the whole region's upper "
"crust will gather to mingle and have some innocent fun. The Tournament, as "
"always, will take place on the shore of the Rushlight River. I eagerly await "
"your arrival, and look forward to the chance to finally meet you in person!\n"
"Cordially yours,\n"
"Castruccio Irovetti, King of Pitax\""
msgstr ""
"\"던스워드와 도둑맞은 땅을 다스리는 자이자, 부싯 바위 초원에서 바바리안 군세를 막아낸 전투의 영웅이자, 각 다양한 무훈과, 기타의, "
"가장 존경받고 저명한, {Name} 전하. \n"
"강의 왕국들 내에서 가장 중요한 사회적 행사이자, 모든 지역의 고위층이 모여 순수한 즐거움을 맛볼 수 있는 러시라이트 토너먼트에 당신을 "
"초대하게 되어 진심으로 기쁩니다. 언제나 그래왔듯, 토너먼트는 러시라이트 강가에서 개최될 것입니다. 저는 당신의 참석을 열렬히 기다릴 "
"것이며, 마침내 당신과 개인적인 만남을 가질 수 있는 기회를 기다리도록 하겠습니다!\n"
"진심으로 당신을 기다리며, \n"
"피탁스의 왕, 카스트루치오 이로베티\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0004_Text
msgctxt "40f8fc3b-d55e-4d8e-b35c-5d3ae59444a0"
msgid "\"So you think Irovetti is behind all this?\""
msgstr "\"넌 이로베티가 이 모든 일에 배후에 있다고 생각해?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0005_Text
msgctxt "5ad5c853-5d6f-4be8-8116-524ce8006f7e"
msgid "\"What do we know about the monster attacks?\""
msgstr "\"우리가 괴물들의 공격에 대해 알고 있는 것은 무엇이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0006_Text
msgctxt "91f38b0f-7115-4e8f-bcda-67fd3be62a1b"
msgid "\"Do we know who's spreading the propaganda?\""
msgstr "\"이런 찌라시를 퍼뜨리는 것이 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0008_Text
msgctxt "114ddc9c-ae78-464f-bb0e-665af2f79578"
msgid "\"Enough talk, then. There's no time to waste.\""
msgstr "\"이제 그만, 낭비할 시간이 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0010_Text
msgctxt "ad0fa384-d3a7-47c9-a677-24605017b9ce"
msgid ""
"\"Do we have any definitive proof that would allow us to formally expose "
"Irovetti?\""
msgstr "\"우리에게 공식적으로 이로베티를 폭로할 수 있는 어떠한 정확한 증거가 있나?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0012_Text
msgctxt "024b342d-e3c2-4ec1-9f99-9106c1d72542"
msgid "\"What is it, Linzi?\""
msgstr "\"린지, 대체 무슨 일이야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0013_AlignmentShift.Description
msgctxt "a6b86cd1-85ff-403b-98ab-7057c5d0d663"
msgid "Refused to listen to reports of disturbances in the kingdom."
msgstr "왕국 내 소요사태에 대한 보고를 듣기를 거부했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0013_Text
msgctxt "11c1ff2c-754d-4756-ab88-d0544d8e2524"
msgid "\"I don't want to hear it. It's probably more nonsense anyway.\""
msgstr "\"무슨 소식이든 관심 없다. 또 말도 안 되는 소리나 하겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0014_Text
msgctxt "7f756880-171c-42b3-9b00-d5368ec4eb5c"
msgid ""
"\"Ha! 'Fire, Your Highness,' 'plague, Your Highness'... I know I can always "
"count on you for good news, Linzi!\""
msgstr "\"화재예요, 전하, 전염병이에요, 전하... 이번엔 어떤 희소식을 가져왔니, 린지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0016_AlignmentShift.Description
msgctxt "5829d759-d26d-44cc-a020-cfcaea23abcb"
msgid "Joked to lighten the mood when Linzi brought bad news."
msgstr "린지가 나쁜 소식을 가져오자 분위기를 밝게 하기위해 농담했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0016_Text
msgctxt "06d0a437-8bc1-408c-8bf9-145dedf46bfb"
msgid "\"I mean... yes, actually.\""
msgstr "\"내 말은...그래, 정말로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0017_Text
msgctxt "2d933099-a35e-41e1-a498-837575479d15"
msgid "\"Let's get to business, then. What's happened?\""
msgstr "\"그럼, 요점으로 돌아가지. 무슨일이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0018_AlignmentShift.Description
msgctxt "fd221667-6c51-4c67-baa2-df6c0715159e"
msgid "Threatened Linzi when she brought bad news."
msgstr "린지가 나쁜 소식을 가져오자 그녀를 압박했습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0018_Text
msgctxt "364eef86-68b2-4830-aa3f-01d9a0001c8d"
msgid ""
"\"I think the first order of business should be finding more sensible "
"subjects. All right, spill it.\""
msgstr "\"일을 처리하는 데 첫번째는 가장 민감한 주제를 찾아내는 것이라 생각한다. 좋아, 전부 설해명봐라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0021_Text
msgctxt "06752d25-04ae-4e6f-ba54-c68abe90027c"
msgid "\"I thought the Stolen Lands were used to dealing with bandits.\""
msgstr "\"난 도둑맞은 땅은 도적들을 다루는 데에 익숙하다고 생각한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Answer_0024_Text
msgctxt "40468bd7-eed2-4bfa-add7-fd41ec413937"
msgid "\"Why am I just hearing about this now?\""
msgstr "\"왜 내가 지금 이 이야기를 듣고 있는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0001_Text
msgctxt "82488889-622e-4a3d-bc29-a0c9513db022"
msgid ""
"{n}Linzi's cheeks are flushed and she's out of breath — it seems like she "
"must have run all the way to the throne room.{/n} \"Disaster... It's a "
"disaster, Your Highness!\""
msgstr ""
"{n}린지의 볼이 빨갛습니다. 씨근씨근 숨을 몰아쉬는 모습을 보니, 알현실까지 때아닌 달음질을 한 것 같습니다.{/n} \"재앙"
"...재앙이에요, 전하!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0002_Text
msgctxt "059f7a5a-bf4b-4854-8ec5-7e9381047cfc"
msgid ""
"\"The whole kingdom's on fire! Well, metaphorically speaking... And some of "
"it literally. First of all, we've got armed gangs ranging along our border "
"with {g|Pitax}Pitax{/g}, robbing and killing people, destroying food stores, "
"and damaging any property they come across! Second, there are sudden and "
"inexplicable monster attacks being reported all throughout your lands! And "
"third, there are people out sowing dissent with rumors and songs, even "
"handing out pamphlets mocking your failure to fix things — and encouraging "
"the citizens to pledge fealty to Irovetti instead!\""
msgstr ""
"\"왕국이 불길에 휩싸였어요! 실제 상황은 아니고, 말하자면 그렇다는 건데... 진짜 화재가 난 곳도 있으니까... 차근차근 "
"설명해볼게요. 우선 {g|pitax}피탁스{/g} 접경에서 무장 강도가 주민들을 약탈, 살해하고 있어요. 식료품점을 부수고, 농가나 "
"사유지가 눈에 띄는 족족 파괴한대요! 또, 왕국 전역에서 원인 불명의 괴물 습격이 보고되고 있어요! 마지막으로, 당신을 헐뜯는 무리가 "
"있대요. 비방이 담긴 노래를 부르면서 당신이 왕국을 이끌어갈 능력이 되지 않는다고 비꼬는 전단을 뿌린다고 하네요. 그러니 이로베티 왕에게 "
"충성하라는 거죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0007_Text
msgctxt "9a173f92-4261-4292-b7aa-a2b37c3aea0f"
msgid ""
"\"Who else could it be?! Bandit attacks are increasing along our border with "
"{g|Pitax}Pitax{/g}, and the bards spouting negative propaganda against you "
"are singing the praises of Irovetti at the same time! Hell, he even invited "
"you to the Rushlight tournament for the sole purpose of mocking you! Who "
"else would backstab their opponents in such a low, conniving way? This is "
"just like him! That nasty, slimy, fatheaded prick! If he were here right "
"now...\" {n}Linzi clutches the air, as though gripping the throat of an "
"invisible enemy.{/n}"
msgstr ""
"\"그 인간 말고 누가 있겠어요? 도적 떼의 공격은 {g|pitax}피탁스{/g}와의 국경을 따라 점차 거세어지고, 당신에 대해 흑색 "
"선전을 일삼는 바드들은 동시에 이로베티를 찬양하는 노래를 불러요! 젠장, 그는 심지어 당신을 조롱할 목적 그 한가지로 러시라이트 "
"토너먼트에 초대했었어요! 그 말고 누가 자신의 상대를 이렇게 비열하고 저급한 방식으로 모함하겠어요? 그 사람밖에 없어요! 그 못되고, "
"더럽고, 얼뜬 새끼말이에요! 만일 그놈이 여기 있었더라면...\"{n}린지는 마치 보이지 않는 상대의 목을 조르듯이 허공을 "
"휘져었습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0009_Text
msgctxt "48ef4560-d1c6-489b-9d19-264ab1a6edbc"
msgid ""
"\"Yes and no. The bards handing out pamphlets and singing slander about you "
"have been seen in city streets, but none have been caught. Obviously "
"someplace in {g|Pitax}Pitax{/g} is training these people and printing up "
"their pamphlets... and judging by the style and quality of the texts, "
"someone from Pitax's {g|Academy of Grand Arts}Academy of Grand Arts{/g} was "
"tasked with this mudslinging. I'd recognize their style of verse from a mile "
"away. If I were you, that's where I'd start looking for agitators.\""
msgstr ""
"\"맞아요, 한편으론 아니기도 하고요. 광장에서 바드가 우릴 비방하는 노래를 부르고 전단을 나눠주었지만, 잡히진 않았죠. "
"{g|pitax}피탁스{/g} 어딘가에서 이 사람들을 훈련시키고 전단을 인쇄하는 게 분명해요. 문체나 필력으로 보아, 피탁스 {g|"
"Academy of Grand Arts}대 예술 아카데미{/g}를 중상모략에 끌어들였나 봐요. 아카데미 방식을 한눈에 알아볼 수 "
"있었거든요. 저라면, 아카데미 출신부터 조사해볼 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0011_Text
msgctxt "ae0ecdb0-1060-48fa-86f6-482a39ffd1e7"
msgid ""
"\"Not yet. But I'm sure the agents he hired will have something we can use! "
"It's a good idea, though — expose Irovetti, show the whole world the dirty "
"game he's playing... It would definitely help us. When you deal with his "
"spies, be sure to keep your eyes open!\""
msgstr ""
"\"아직은 아니에요. 이로베티 왕이 고용한 요원이라면 뭔가 쓸만한 단서를 가지고 있을 테니까요! 물론 이로베티의 만행을 온 세상에 "
"알리려면 그 방법도 괜찮겠죠. 우리에겐 확실히 도움이 될지도요. 아무튼 이로베티의 밀정을 다룰 땐, 눈을 크게 뜨고 유심히 지켜보셔야 "
"해요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0015_Text
msgctxt "1793d462-0ba9-4c3f-977e-0e9c8d856e35"
msgid ""
"\"What did you think, that you'd become {mf|king|queen} and just get to "
"feast every day, enjoying the fawning of your lords and ladies in waiting, "
"and holding tournaments? You sit on the throne — you could be so kind as to "
"rule!\""
msgstr ""
"\"뭘 생각하셨던 거예요? {mf|왕|여왕}이 된 이유가 고작, 매일 연회를 열고, 신하와 귀부인이 아첨하는 말이나 즐기면서 토너먼트를 "
"개최하고 싶어서였나요? 그 자리는 왕의 자리예요. 왕좌에 걸맞은 사람이 되어주실 수는 없나요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0019_Text
msgctxt "d10f48cb-6a0d-4f8d-b552-b2f0b02ba414"
msgid "\"Nonsense?! Do you have any idea what's happening?!\""
msgstr "\"말도 안된다고?! 무슨 일이 있어났는지나 알고 있는거야?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0020_Text
msgctxt "94e3102b-5f43-470e-b58b-847de8b2a8d7"
msgid ""
"\"Our governors are panicking! They've had to use all the funds we budgeted "
"them from the treasury on preventing riots and mass hysteria. Several "
"provinces have already refused to attempt gathering taxes from the people, "
"claiming that just trying would be tantamount to suicide!\""
msgstr ""
"\"영주들은 공황 상태예요! 소요를 통제하라고 중앙에서 지급한 기금은 바닥났는데, 세금을 징수하지 않고 있어요. 화가 난 백성에게 세금을 "
"걷는 일은 자살 행위나 다름없다면서요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0022_Text
msgctxt "f8a469d3-ba8e-4de5-b653-9cb5f3cf9dab"
msgid ""
"\"Thing is, they may be dressed like bandits, but they're behaving "
"completely differently. Bandits wouldn't decimate the peasant population, "
"burn their fields, and poison their wells — then there wouldn't be anyone to "
"extort next time! Much more profitable to just shake them down every once in "
"a while. That's why local thugs tend to be well known. But nobody recognizes "
"these new ones! And all that's left behind after their raids are corpses and "
"scorched fields. It's gotten to the point that 'our' bandits are fighting "
"these 'outsiders.' Some of the villages are even gathering weapons and "
"supplies to help 'our' bandits, because they at least let them live... but "
"they're still losing.\""
msgstr ""
"\"문제는, 그들이 도적 떼처럼 차려 입었을지 모르지만 행동하는건 완전히 다르다는 점이죠. 도적떼는 농민들을 몰살시키거나, 밭을 "
"태워버리거나, 우물에 독을 풀지 않아요. 그랬다간 다음에는 뜯어낼 누군가도 없을 테니까요! 때때로 그들에게 갈취하는 것이 더 이득이죠. "
"그게 지역의 무뢰배들이 잘 알려지게 되는 이유이기도 하구요. 그런데 아무도 이 새롭게 나타난 녀석들을 알지 못해요! 그들이 습격하고 "
"지나간 곳에는 시체와 불에 탄 밭들만 남게 되니까요. '우리' 도적떼들이 '외부인들'과 싸우는 지경에 이르렀죠. 몇몇 마을들은 심지어 "
"무기와 보급품들을 모아 '우리' 도적들을 돕고 있어요. 그들은 적어도 목숨만은 살려주기 때문이죠... 그러나 그들이 빼앗긴다는 것은 "
"여전해요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0023_Text
msgctxt "e8fa2c7b-5856-4047-9f99-9d5a7c80afa0"
msgid ""
"\"The reports are controversial — they talk about things you wouldn't even "
"hear in fairy tales. Educated wyverns, trolls wearing armor, even "
"undetectable goblin ghosts! But all the testimonies agree on one thing: they "
"emerge in small groups literally from nowhere — in the middle of a field, in "
"the center of a city square, on fortress parapets... One inn reported "
"monsters rushing into the common hall from bedrooms and storerooms. And in a "
"temple nearby, the monsters fell down on the heads of the praying "
"congregation, breaking through the roof with a wild roar!\""
msgstr ""
"\"이 보고들는 논란의 여지가 있어요. 보고서에는 당신조차 들어본 적 없는 동화 이야기가 쓰여있죠. 교육받은 와이번들, 갑옷을 입은 "
"트롤들, 심지어 감지할 수 없는 고블린 유령들까지! 그렇지만 모든 증언들이 한 지점에서 수렴해요. 이들이 작은 규모이며, 말 그대로 "
"갑자기 나타났다는거죠. 밭의 한 가운데서, 도시 광장의 한 가운데서, 요새의 난간에서... 한 여관은 괴물들이 침실과 창고에서부터 공동 "
"현관으로 쏟아져 나왔다고 보고했어요. 그리고 사원 주변에서는괴물들이 괴성과 함께 지붕을 뚫고 들어와 기도하고 있던 성도들을 거꾸러뜨렸다고 "
"하고요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0025_Text
msgctxt "0d3bc894-305a-4fdb-b5a3-b0f2f347514b"
msgid ""
"\"At first, no one thought these isolated events could be part of some "
"conspiracy... even now, it's likely few have figured it out. But these "
"events have all developed too quickly, and in what seems like a concerted "
"effort — as though someone were pulling the strings from behind a curtain. "
"And there's more than enough evidence tying these strings to "
"{g|Pitax}Pitax{/g}!\""
msgstr ""
"\"처음엔 각기 다른 이유로 일어난 사건인 줄 알았죠. 더 큰 그림이 있다고 생각하는 사람은 없었어요... 지금도 이 사실을 깨달은 "
"사람은 드물어요. 하지만 사건사고가 한꺼번에 터지다 보니, 누군가 총공격을 지휘하는 듯한 인상을 받았죠. 장막 뒤에 숨어서 인형 줄을 "
"잡아당기듯이 말이에요. 물론 인형 줄이 죄다 {g|pitax}피탁스{/g}로 연결된다는 증거도 넘치고요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0027_Text
msgctxt "d005e599-cd67-478f-9b56-94c02b3f07ae"
msgid ""
"\"We don't have much time. There may be no troops marching against us, but "
"more of our regions are under attack each day. We may not have catapults "
"firing on the walls of our capital, but there's no doubt we're under siege. "
"There are no battlefronts and no battalions, but there are plenty of "
"victims. We've been attacked — without reason, and without declaration of "
"war. We have only one option...\""
msgstr ""
"\"시간이 없어요. 우리 땅을 밟고 행군하는 적은 없지만, 왕국 전역에서 하루가 멀다 하고 습격이 일어나요. 성벽에 돌덩이가 날아오진 "
"않아도 왕국은 적군에 포위당한 거나 다름없어요. 지금 이 순간에도 전장이 아닌 가정집에서, 군인이 아닌 수많은 민간인이 희생당하고 "
"있는데, 우리 적은 명분도, 선전포고도 없이 계속 공격을 퍼붓네요. 이제 우리에게 남은 선택지는 단 하나예요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0028_Text
msgctxt "a6c9e915-03d5-460d-9888-37eaf84a6b64"
msgid ""
"\"...to kick Irovetti's ass and show everyone in the {g|River Kingdoms}River "
"Kingdoms{/g} just who's the master around here!\""
msgstr ""
"\"... 이로베티의 엉덩이를 걷어차 주고 {g|River Kingdoms}강의 왕국들{/g}에 누가 이 땅에 걸맞은 지배자인지 보여주는 "
"거죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0029_Text
msgctxt "841d251d-fa47-49aa-aee0-af8f5b41bdb5"
msgid ""
"\"Just a few hours ago, a messenger showed up at the castle with a missive "
"offering the services of a group of rangers who specialize in investigating "
"mysterious cases similar to these. For a 'small fee,' they're ready to "
"'facilitate establishing the nature of these inexplicable events'... I "
"suppose we should take them up on it. I have no idea how else we'd go about "
"finding the source of these attacks!\""
msgstr ""
"\"몇 시간 전에, 한 전령이 이러한 신비한 사건들과 유사한 것들을 조사하는데 전문가인 레인저 무리의 서비스를 제공하겠다는 서한을 가지고 "
"성에 나타났어요. 그들은 아주 '적은 비용'으로 '이러한 설명할 수 없는 사건들의 본질을 규명'해 낼 준비가 되어 있다고 해요... 제가 "
"판단하기에는, 그들을 고용해야 할 것 같아요. 이런 공격들의 근원을 어디로 가야 찾을지에 대해 우리는 아무것도 알지 못하니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0030_Text
msgctxt "7c810898-47a8-4d41-984f-710f867eeca8"
msgid ""
"\"Hurry, {name}. Your {d|c51 Rushlight Fail}performance{/d} at the Rushlight "
"tournament... well, frankly, you'd have been better off not going at all. "
"The people are laughing at you — you've completely lost their trust. The "
"seeds of Irovetti's propaganda will be falling on fertile soil.\""
msgstr ""
"\"서둘러요, {name}. 러시라이트 토너먼트에서의 {d|c51 Rushlight Fail}일{/d}은... 음, 솔직히 참가하지 않는 "
"편이 나았을지도 몰라요. 사람들이 당신을 비웃었거든요. 피탁스에서는 완전히 신망을 잃으셨을 거예요. 이로베티의 흑색선전이 비옥한 토양에 "
"뿌린 씨앗처럼 자라나겠죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0032_Text_3
msgctxt "2f20e979-0faa-44b6-ac75-ee4a6fe4df6e"
msgid ""
"\"Fortunately, the situation could be worse. Your decisive victory in the "
"Rushlight tournament really bolstered the people's {d|c51 Rushlight "
"Cool}faith{/d} in you and your abilities. It's funny how such nonsense can "
"affect people's minds more than real feats and atrocities do. But this works "
"out in our favor — thanks to that victory, we'll have a little more time to "
"deal with whatever vile acts that madman from {g|Pitax}Pitax{/g} throws at "
"us...\""
msgstr ""
"\"상황이 더 악화될 수도 있었지만, 다행이에요. 러시라이트 토너먼트에서의 당신의 결정적인 승리는 당신과 당신의 능력에 대한 사람들의 "
"{d|c51 Rushlight Cool}믿음{/d}을 정말로 북돋았어요. 이런 말도 안되는 것들이 진정한 위업과 잔학한 만행보다 더 "
"사람들의 마음을 뒤흔든다는게 정말 웃기지만요. 하지만 이걸로 우리에게 유리하게 되었어요. 이 승리에 감사하죠, 우리는 "
"{g|pitax}피탁스{/g}의 미치광이가 우리에게 내던질 비열한 행위가 무엇이든 간에 조금 더 시간을 벌게 되었어요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0033_Text_3
msgctxt "dabdf574-3e27-43e0-a2cb-67affe537c0d"
msgid ""
"\"One more thing, {name}. Your performance in the Rushlight tournament "
"was... {d|c51 Rushlight Neutral}not the best{/d}. But at least you "
"participated — if not for that, I think it would've been even easier for "
"Irovetti to confuse people and undermine your authority as he tries to push "
"our kingdom into the Abyss. Don't let your guard down, though — we're "
"looking at a matter of months, at best.\""
msgstr ""
"\"한 가지 더요, {name}. 러시라이트 토너먼트에서 공연하셨잖아요... {d|c51 Rushlight Neutral}괜찮은 공연은 "
"아니었죠{/d}. 최소한 참가는 했으니, 이 일로 이로베티가 국민들에게 혼란을 주기는 어려울 거예요. 우리 권력 기반을 약화시켜서 왕국을 "
"심연으로 밀어 넣으려는 계획이잖아요? 아무튼 경계를 늦추지 마세요. 한두 달로 끝날 문제는 아닐 테니까요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0034_Text_3
msgctxt "ac02b658-422a-4e4f-8ee4-62e93e5149c3"
msgid ""
"{n}Linzi's eyes flare.{/n} \"Sometimes I don't know why I even bother coming "
"to you at all!\""
msgstr "{n}린지의 두 눈이 반짝였습니다.{/n}\"가끔은 왜 제가 당신에게까지 와야 하는지 모르겠어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0035_Text_3
msgctxt "c4100fed-d63f-47f8-9804-212f4cba2314"
msgid ""
"{n}Linzi's laughter rings across the room.{/n} \"Ha ha! You dummy! This is "
"no time for jokes!\""
msgstr "{n}린지의 웃음소리가 방안을 울렸습니다.{/n} \"하 하! 바보같이! 이번엔 농담할 시간이 없어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0036_Text_3
msgctxt "8ac2ba98-ba70-422e-808b-a59edfc27142"
msgid ""
"\"I don't want to be a downer, but... the fate of the kingdom really is in "
"your hands here, {name}. I'm afraid to think what might happen if we don't "
"get control of the situation in the next few months...\""
msgstr ""
"\"저는 우울해지고 싶진 않아요, 하지만...왕국의 운명이 정말로 여기 당신 손에 달려있어요, {name}. 다음 몇 달간 우리가 이 "
"상황을 제대로 통제하지 못하면 어떤 일이 벌어질지 정말로 걱정되요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Linzi_WarStart/Cue_0037_Text_3
msgctxt "2822b65b-0e7e-451c-a491-9dc7f01af221"
msgid ""
"\"Hurry, {name}. Your refusal to participate in the Rushlight tournament "
"really hurt your reputation with the populace. They think you were too "
"scared to accept Irovetti's challenge.\""
msgstr ""
"\"서둘러요, {name}. 러시라이트 토너먼트 참가를 거절하셔서 평판이 바닥에 떨어졌어요. 사람들은 당신이 질까 봐 무서워서 이로베티 "
"왕의 도전을 받아들이지 않았다고 생각해요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0008_AlignmentShift.Description
msgctxt "b0345576-36da-4cd0-bc54-c8839cf5e3fd"
msgid "Appointed Gasperre Liacenza as the governor of Pitax."
msgstr "가스페레 리아첸자를 피탁스의 영주로 임명하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0008_Text
msgctxt "51410a76-3685-4a20-8ddb-ac8be06c6b1b"
msgid "\"I appoint Gasperre Liacenza as governor.\""
msgstr "\"가스페레 리아첸자를 영주로 임명하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0009_AlignmentShift.Description
msgctxt "0195f047-dbdb-47b4-895c-593a100c63a7"
msgid "Appointed Kharne Vereel as the governor of Pitax."
msgstr "칸 베릴을 피탁스의 영주로 임명하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0009_Text
msgctxt "de54a00d-6054-4c90-89c3-aa8792b94218"
msgid "\"I appoint Kharne Vereel as governor.\""
msgstr "\"칸 베릴을 영주로 임명하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0010_AlignmentShift.Description
msgctxt "7943ce4c-4f3a-4c4f-9fa2-73c50eee1dff"
msgid "Appointed Stefano Moskoni as the governor of Pitax."
msgstr "스테파노 모스코니를 피탁스의 영주로 임명하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0010_Text
msgctxt "ed4fdc30-b686-4ec9-8716-b9b00dc88470"
msgid "\"I appoint Stefano Moskoni as governor.\""
msgstr "\"스테파노 모스코니를 영주로 임명하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0011_AlignmentShift.Description
msgctxt "153b87fb-ec91-44df-b7b2-e2d8a4b83612"
msgid "Appointed your own viceroy as the governor of Pitax."
msgstr "당신의 총독을 피탁스의 영주로서 지목하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0011_Text
msgctxt "4cd9af7e-9461-487f-bfe5-6f85095abe4f"
msgid "\"None of you will be governor. I will send my own viceroy.\""
msgstr "\"너희들 중엔 영주가 될 수 있는 자는 없다. 나는 이곳에 총독을 보낼 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0035_AlignmentShift.Description
msgctxt "c5e38c80-0d99-4b4f-89dc-bf63c1fb27e6"
msgid "Executed Kharne Vereel."
msgstr "칸 베릴을 처형하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0035_Text
msgctxt "9419b9b2-c78a-4130-a566-873fc925a55c"
msgid "\"Guards! I sentence Kharne Vereel to death. Take him!\""
msgstr "\"경비병! 칸 베릴에게 사형을 선고한다. 그를 끌고가라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0036_AlignmentShift.Description
msgctxt "caee53e8-db91-4a83-b35f-1d7d77f2d320"
msgid "Executed Gasperre Liacenza."
msgstr "가스페레 리아첸자을 처형하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0036_Text
msgctxt "1e1897a6-55f9-4f38-9ed2-5496ad4bbe9f"
msgid "\"Guards! I sentence Gasperre Liacenza to death. Take him!\""
msgstr "\"경비병! 가스페레 리아첸자에게 사형을 선고한다. 그를 끌고가라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0037_AlignmentShift.Description
msgctxt "50f8712f-f2d7-484b-97b4-9de1591db019"
msgid "Executed Stefano Moskoni."
msgstr "스테파노 모스코니를 처형하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0037_Text
msgctxt "72897b7d-d0de-4486-99da-c01c474b5307"
msgid "\"Guards! I sentence Stefano Moskoni to death. Take him!\""
msgstr "\"경비병! 스테파노 모스코니에게 사형을 선고한다. 그를 끌고가라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0056_Text
msgctxt "dafa32ca-050e-4097-9b2d-dc7b3e5661c4"
msgid "\"Linzi, what's next on the agenda?\""
msgstr "\"린지, 다음 안건은 무엇입니까?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0069_Text
msgctxt "3d5ca6d1-91a1-47de-9ef3-02454cbfdbea"
msgid "\"Annamede, I appoint you as the new headmaster of the Academy.\""
msgstr "\"안나미데, 당신을 아카데미의 새 학장으로 임명한다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0070_Text
msgctxt "c1da3991-2645-4c3c-a410-627e65bf5771"
msgid ""
"\"Atalia, I refuse to accept your resignation. The Academy needs a "
"headmaster, and you are the best candidate.\""
msgstr "\"아탈리아, 너의 사임을 반려한다. 아카데미에는 학장이 있어야 하며, 당신은 최고의 후보이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0073_Text
msgctxt "7a795275-a596-4a27-8d40-4264a0c4ef24"
msgid "\"I will trust the teachers to elect a new headmaster of the Academy.\""
msgstr "\"아카데미의 새 학장을 선생들이 선출할 것이라 믿는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0074_Text
msgctxt "63705059-0149-4d6d-becc-90bca6c02680"
msgid "\"No headmaster will be necessary. I am closing down the Academy.\""
msgstr "\"학장은 필요하지 않다. 아카데미를 폐쇄할 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0092_AlignmentShift.Description
msgctxt "c10287a0-3c1b-4017-9f56-01ebdb78d3e7"
msgid "Executed Atalia Gitaren."
msgstr "아탈리아 지타른을 처형하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0092_Text
msgctxt "9fe767fe-7cc8-4ce6-be22-642395b54ba2"
msgid "\"Guards! I sentence Atalia Gitaren to be executed. Take her away!\""
msgstr "\"경비병! 아탈리아 지타른에게 사형을 선고한다. 그녀를 끌고가라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0093_AlignmentShift.Description
msgctxt "d566e857-92e1-4b2d-a5e9-8316c315a055"
msgid "Executed Annamede Belavarah."
msgstr "안나미데 빌라바라를 처형하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0093_Text
msgctxt "bdfad339-1eb9-4e3a-97f6-ecbed7baea31"
msgid ""
"\"Guards! I sentence Annamede Belavarah to be executed. Take her away!\""
msgstr "\"경비병! 안나미데 빌라바라에게 사형을 선고한다. 그녀를 끌고가라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0094_Text
msgctxt "d3aaa4cd-3329-4ea3-b392-99d1d6398af4"
msgid "\"Who else wants an audience?\""
msgstr "\"누가 또 알현을 원하지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0111_AlignmentShift.Description
msgctxt "62542e91-79ca-431c-ad07-b32aa2d486d5"
msgid ""
"Accepted the River Blades gang as your soldiers and made them give up piracy."
msgstr "강의 칼날(River Blades)단을 당신의 병사들로 받아들여 그들이 해적질을 그만두도록 하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0111_Text
msgctxt "e2230904-e2b0-4778-b083-5da20946c520"
msgid ""
"\"I'll hire you, but on one condition. No more robberies. From now on you're "
"a military combat unit within my army.\""
msgstr "\"한 가지 조건 하에 너희들을 고용하겠다. 더 이상 강도질을 해서는 안된다. 이제부터 너희들은 나의 군대의 전투 부대이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0112_AlignmentShift.Description
msgctxt "1ab3afb2-2db7-4ee3-adb0-0436ee858b53"
msgid "Exiled the River Blades gang."
msgstr "강의 칼날(River Blades)단을 추방하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0112_Text
msgctxt "34656f50-8de9-485c-b1e0-aa459ccf1596"
msgid ""
"\"Thank you for your service, but we have different paths to follow. I have "
"no need of pirates in my kingdom.\""
msgstr "\"너희들의 도움이 고맙지만, 우리는 서로 다른 길을 따라야 한다. 내 왕국에는 해적들이 필요치 않다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0113_AlignmentShift.Description
msgctxt "ff9da9dc-845a-4620-97d1-32fbfa26e89c"
msgid "Executed Ilora Nuski."
msgstr "일로라 누스키(IIora Nuski)를 처형하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0113_Text
msgctxt "a59134db-b928-4751-92cd-4f0b47f84baa"
msgid ""
"\"You've helped me, and I appreciate that. But you are pirates, and all "
"pirates must hang. Guards, take her away! Make sure she doesn't suffer.\""
msgstr ""
"\"너는 나를 도왔으며, 나는 그것을 고맙게 생각한다. 그러나 너는 해적이며, 모든 해적들은 목매어져야 마땅하다. 경비병. 그녀를 "
"끌고가라! 그녀가 불필요한 고통을 겪지 않게 한번에 보내라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0127_Text
msgctxt "55de04be-2f9b-4a99-80be-26d9f0f215d6"
msgid ""
"\"Aren't you confused? Why are you pledging allegiance to the city and not "
"to me?\""
msgstr "\"혼동하는 것이 아닌가? 왜 내가 아닌 도시에 충성을 맹세하는가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0128_Text
msgctxt "f581b793-7428-45f2-b2e0-ae90dde83636"
msgid "\"I wish to appoint a new captain of the guard.\""
msgstr "\"나는 경비대의 새 대장을 임명하고 싶다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0130_Text
msgctxt "873962a6-ecac-471f-9b63-400ba6e0cd3e"
msgid "\"I accept your pledge. Serve the city as you have before.\""
msgstr "\"너의 맹세를 받아들이겠다. 이전과 같이 도시를 위해 봉사하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0131_Text
msgctxt "7518e3a6-b961-42d8-bd03-0f0c628da7ae"
msgid ""
"\"The city is now under new leadership. I will retire the city guard, and "
"create a new one, personally loyal to me.\""
msgstr ""
"\"이 도시는 이제 새로운 지도자 아래 있다. 나는 도시 경비대를 모두 물리고, 개인적으로 나에게 충성스러운 새 경비대를 만들 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0135_AlignmentShift.Description
msgctxt "21eef6a9-f537-4408-8d2a-ab9ff92b83d5"
msgid "Executed Irsei Caelysse."
msgstr "얼세이 케일리시를 처형하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0135_Text
msgctxt "5035fafb-8f90-4346-899f-31f49c0d8c86"
msgid "\"Is that a threat? Guards! Arrest that man! I sentence him to death!\""
msgstr "\"협박하는 건가? 경비병! 이 자를 체포하라! 그에게 사형을 선고한다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0136_Text
msgctxt "73bf5669-b28f-4493-a5cd-a3be0d4382f1"
msgid ""
"\"I didn't ask for your advice. Have a good day, former captain Caelysse.\""
msgstr "\"네게 자문을 구하지 않았네. 좋은 하루 되시게, '전' 대장 케일리시(Caelysse)\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0137_Text
msgctxt "f9f5a747-1822-46a5-940e-8f33994851b1"
msgid ""
"\"I've changed my mind, and I accept your pledge. Continue to serve the city "
"as you always have.\""
msgstr "\"생각이 바뀌었다, 네 서약을 받아들이지. 언제나처럼 도시에 대해 봉사하게.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0146_AlignmentShift.Description
msgctxt "e621042d-5644-4e73-9ffe-d2fedae2caf9"
msgid "Prevented Pitax's guards from throwing Kharne's guild out of the city."
msgstr "피탁스 경비대가 칸의 길드를 내쫓는 것을 막다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0146_Text
msgctxt "f5ff8cf4-4071-4c0f-80de-e154f4be807a"
msgid ""
"\"They are under my protection. Do not stand in the way of honest people "
"doing fair business.\""
msgstr "\"그들의 나의 보호 아래 있습니다. 정직한 사람들이 공정한 사업을 하는 길을 막지 마십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0147_AlignmentShift.Description
msgctxt "ea879729-8695-41e8-b8cb-7d898854258b"
msgid ""
"Acknowledged Kharne's right to continue his dealings in Pitax as long as he "
"doesn't disturb the peace."
msgstr "칸이 평화를 어지럽히지 않는 한, 피탁스와의 그의 거래를 유지할 권리를 승인하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0147_Text
msgctxt "658fcdc0-a30d-4262-b3f8-db0031ea2fb6"
msgid "\"They have every right to do business unless they disturb the peace.\""
msgstr "\"그들이 평화를 어지럽히지 않는 한, 그들에게는 사업을 할 모든 권리가 있다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0148_AlignmentShift.Description
msgctxt "81fa2443-93c7-4592-ac0d-bcb4094497ef"
msgid "Allowed Pitax's guards to throw Kharne's guild out of the city."
msgstr "피탁스의 경비대가 칸(Khanre)의 길드를 내쫓는 것을 허락하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0148_Text
msgctxt "73bec803-9853-42a4-9807-26a33f2d1a76"
msgid ""
"\"You can throw them out of the city. I won't lift a finger to protect that "
"scum.\""
msgstr "\"그들은 도시 밖으로 내쫓아라. 나는 그 쓰레기들을 보호하기 위해 손가락 하나 꿈쩍하지 않을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0155_AlignmentShift.Description
msgctxt "13e0f79f-2ca4-4eb2-bad1-304027eb7248"
msgid "Allowed Ilora Nuski to continue with piracy."
msgstr "이로라 누스키(IIora Nuski)가 사략행위를 계속하게끔 허락하다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Answer_0155_Text
msgctxt "184357e9-f8a1-48e0-af86-d4a7233d0382"
msgid "\"You can continue in your usual work – just don't forget to share!\""
msgstr "\"당신은 당신이 해왔던 것을 계속할 수 있소. 단지 내야할 것만 잊지 마시오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0001_Text
#. Speaker : Linzi_Companion
msgctxt "4d1e1268-badf-4f50-b1c5-7ec5a7544433"
msgid ""
"\"There is a whole delegation from {g|Pitax}Pitax{/g} to see you! They're "
"standing by the doors, scowling at each other. It looks like they're about "
"to come to blows!\""
msgstr ""
"\"{g|pitax}피탁스{/g}의 대표단 전원이 알현하러 왔어요! 그들은 문 옆에 서서는 서로를 노려보고 있죠. 꼭 서로에게 한방 "
"먹일것처럼 보이는데요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0003_Text
#. Speaker : Pitax_GasperreLiacenza
msgctxt "7c66a844-3a4c-4ef1-bebc-875a4b33a444"
msgid ""
"{n}{d|Liacenza}Gasperre Liacenza{/d} greets you with a polite bow.{/n} \"Your"
" Highness. The old families, founders of Pitax, are grateful to you for "
"sparing us of the usurper's tyranny. Allow us to assure you in our loyalty. "
"None of the trade houses seek the {g|Pitax}Pitaxian{/g} crown – which is "
"rightfully yours, of course. If it would please you to appoint a governor to "
"oversee the city, all the four families humbly recommend me for this "
"position.\""
msgstr ""
"{n}{d|Liacenza}가스페레 리아첸자{/d}가 허리를 숙여 정중하게 인사합니다.{/n} \"전하. 피탁스의 창립자인 오래된 "
"가문들은 침략자의 폭정으로부터 구해주신 것에 감사드립니다. 저희의 충정을 증명하게 해주십시오. 무역 회사의 누구도 "
"{g|pitax}피탁스의{/g} 왕관을 탐하지 않습니다 – 물론 당연히 전하의 것이지만요. 도시를 감독할 주지사를 임명하실 의향이라면 네 "
"가문들이 모두 저를 추천하였음을 알려드립니다. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0004_Text
#. Speaker : Pitax_KharneVereel
msgctxt "eaf85d75-1070-4f1c-b140-6e6d2a30ad50"
msgid ""
"{n}{d|Vereel}Kharne Vereel{/d} stares at Gasperre with dim, bloodshot "
"eyes.{/n} \"Your Highness... Of course, it wasn't always peaceful between "
"us. – The thieves' guild used to fight against you a little... But that's "
"all water under the bridge, right? Irovetti's rule has ended, and the guild, "
"represented by me, promises you our support and a share of our profits. "
"Speaking of profits... If you appoint me as governor, then your share will "
"make you gasp!\""
msgstr ""
"{n}{d|Vereel}칸 베릴{/d}이 가스페레를 침침하고 핏발선 눈으로 노려보았습니다.{/n} \"전하...물론, 언제나 저희 사이가 "
"평화롭지는 않았습니다. 도둑 길드는 당신과 사소한 다툼이 있었지요...그러나 이제 전부 지나간 일이 아니겠습니까? 이로베티의 통치가 "
"끝나고 제가 대표하는 이 길드는 당신에 대한 저희의 지지와 저희 수익을 나누어 바칠 것을 약속합니다. 수익에 대한 이야기가 나와서 "
"말씀드리는데...저를 영주로 하여주신다면, 당신께서 가져가실 몫은 놀랄만 할 것입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0005_Text
#. Speaker : PitaxTown_Stefano
msgctxt "1ad56887-ad6d-401b-bb96-9067ac5d9687"
msgid ""
"{n}{d|Stefano}Stefano Moskoni{/d} makes an formal low bow, hiding his "
"mischievous smile.{/n} \"Well, justice was served. The usurper is dead, long "
"live the rightful ruler! If my recollection is correct, you mentioned our "
"arrangement in the square, before the whole city – something about the "
"governor's position? I have certainly upheld my end of the agreement. Now "
"it's your turn.\""
msgstr ""
"{n}{d|Stefano}스테파노 모스코니{/d}는 정중히 격식을 차린 인사를 하며 그의 짓굳은 미소를 숨겼습니다.{/n} \"이제, "
"정의가 승리하였군요. 찬탈자는 죽었습니다. 정당한 지배자시여 만수무강하소서! 제 기억이 맞다면, 당신께서는 광장에서 우리의 협의를 "
"언급하셨었습니다. 도시 전체의, 영주 자리에 대해 하신것이 아니었습니까? 저는 확실히 협의를 이행하였습니다. 이제, 당신의 차례입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0016_Text
#. Speaker : Pitax_GasperreLiacenza
msgctxt "042eb050-6e72-4ac9-8bfe-30d15220ae56"
msgid ""
"\"Thank you for your trust. Allow me to pledge our allegiance once again – "
"both mine and that of all the old families.\""
msgstr "\"믿어 주셔서 감사합니다. 저와 다른 모든 옛 가문들의 모두의 충성을 맹세할 수 있도록 허락해주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0017_Text_String
#. Speaker : Pitax_KharneVereel
msgctxt "23f88b10-8e05-4b6f-85e3-ce9939ec046a"
msgid "{n}Kharne grinds his teeth in anger.{/n} \"Is that so? Very well...\""
msgstr "{n}칸은 화가 나 이를 악물었습니다.{/n}\"그렇단 말이지요? 좋습니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0018_Text_String
#. Speaker : PitaxTown_Stefano
msgctxt "687cfa61-afc6-490a-b8e9-8dbdf274afa2"
msgid "\"Well... At least allow me to thank you for sparing my life.\""
msgstr "\"음...적어도 목숨을 살려주어 고맙습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0020_Text
#. Speaker : Pitax_KharneVereel
msgctxt "f4df3d20-4582-419e-9a42-ac44e9ff4132"
msgid ""
"{n}The gnome smiles and rubs his hands together.{/n} \"Sweet, sweet... You "
"will see, Your Highness, you've made no mistake!\""
msgstr ""
"{n}노움은 웃으며 양손을 비벼댔습니다.{/n}\"좋습니다, 아주 좋습니다...보게 되실 겁니다, 전하. 전혀 실수하시지 않으셨다는 "
"것을요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0021_Text_String
#. Speaker : Pitax_GasperreLiacenza
msgctxt "e510afeb-69a1-405e-b559-f24e96aa46c7"
msgid ""
"{n}Gasperre lowers his head and speaks coldly through clenched teeth:{/n} "
"\"As Your Highness wishes.\""
msgstr "{n}가스페레는 고개를 숙이며 이를 꽉 악문 채 차갑게 말했습니다.{/n} \"전하께서 바라시는 대로.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0023_Text
#. Speaker : PitaxTown_Stefano
msgctxt "ce3bface-2e49-486b-a35d-ccbae1ed7699"
msgid ""
"{n}A broad smile blooms on Stefano's face. He bows to the floor again.{/n} "
"\"Thank you from all my heart, Your Highness! I won't let you down.\""
msgstr ""
"{n}스테파노의 얼굴 전체에 미소가 피어오릅니다. 그는 다시 한번 바닥에 넙죽 인사합니다.{/n} \"진심으로 감사합니다, 전하! "
"실망시키지 않겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0033_Text
#. Speaker : Linzi_Companion
msgctxt "9162f68e-c6ea-43e8-a7fd-bfe6e662d962"
msgid ""
"\"Writing this down... I'll find someone suitable from the lords and ladies "
"of the court!\""
msgstr "\"이것을 써두시오...나는 궁중의 귀족과 귀부인들 중에서 적합한 자를 찾을 것이오!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0034_Text
#. Speaker : Linzi_Companion
msgctxt "6339d506-c1c2-46be-b841-81febda4efb6"
msgid ""
"\"So, we've decided on the governor... Would you like to say anything to the "
"visitors or are they free to go? There's a whole crowd of them waiting in "
"the hall!\""
msgstr ""
"\"그러면, 우리는 영주를 결정했군요...방문자들과 나눌 말씀이 있으신가요? 아니면 그들을 보내도 될까요? 그 무리가 홀에서 기다리고 "
"있어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0043_Text
#. Speaker : Pitax_GasperreLiacenza
msgctxt "351e389d-880c-42e8-888c-7a4abe7e1581"
msgid ""
"\"A wise decision, Your Highness. The city will be safer and cleaner without "
"him.\""
msgstr "\"현명한 결정이십니다, 전하. 그가 없다면 이 도시는 안전하고 깨끗해질 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0044_Text
#. Speaker : Pitax_GasperreLiacenza
msgctxt "8cb5bb7f-c7fc-4dac-9f22-8d4795ea6be5"
msgid "\"Your Highness, but why?!\""
msgstr "\"전하, 하지만 왜?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0045_Text
#. Speaker : Pitax_GasperreLiacenza
msgctxt "27b5072e-0f6d-418f-ad8b-d39f642e850b"
msgid "\"That's the fate of all turncoats.\""
msgstr "\"그것이 모든 변절자가 맞이할 운명이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0049_Text
#. Speaker : Pitax_KharneVereel
msgctxt "e524cced-32ec-41bf-b1f2-94906f10c50e"
msgid ""
"\"You won't get away with this – do you hear me?! The guild will find you! "
"You'll be weeping blood! You'll eat your own guts!\""
msgstr ""
"\"도망칠 수 없을거다, 내 말 들리나?! 길드가 널 찾아내고야 말거다! 네 피가 흐르고! 네놈의 내장을 스스로 먹게 될거다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0050_Text
#. Speaker : Pitax_KharneVereel
msgctxt "6700845a-ef7f-463b-8366-7ea64a89c170"
msgid "\"Ha ha... Serves him right!\""
msgstr "\"하 하...그를 제대로 대접하라!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0051_Text
#. Speaker : Pitax_KharneVereel
msgctxt "332ddbd4-365c-4f73-9c71-67012771bb69"
msgid "\"That fop should have hung a long time ago!\""
msgstr "\"저 애송이는 오래 전에 매달렸어야 했어!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0052_Text
#. Speaker : PitaxTown_Stefano
msgctxt "265c243a-fd2d-447f-b3ba-5d80f248015b"
msgid ""
"\"So this is what your promises are worth?! I should have guessed, and fled "
"while I had the chance.\""
msgstr "\"이것이 당신이 한 약속의 가치란 말이오?! 미리 짐작하고 기회가 있을때 도망쳤어야 했는데.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0053_Text
#. Speaker : PitaxTown_Stefano
msgctxt "0122175b-6f16-4829-a41e-c97fef74b3b4"
msgid "\"I see the old families are out of favor!\""
msgstr "\"오래된 가문이 눈 밖에 났다는 것을 알겠군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0054_Text
#. Speaker : PitaxTown_Stefano
msgctxt "79a88d56-68e7-4a69-a457-753c9c0c3f52"
msgid "\"Farewell, Kharne Vereel. No one in Pitax will miss you.\""
msgstr "\"잘 있으시오, 칸 베릴. 피탁스의 누구도 당신을 그리워하지 않을 거요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0055_Text
#. Speaker : Linzi_Companion
msgctxt "b89ae6e8-47dc-4217-b7d9-9eaf94e9a863"
msgid ""
"\"You must decide the fate of the {g|Academy of Grand Arts}Academy{/g}!\""
msgstr "\"{g|Academy of Grand Arts}아카데미{/g}의 향후를 결정지어야만 해요\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0057_Text
msgctxt "564a3381-6d34-4f65-9ef0-ce2b101e1a3c"
msgid "{n}The guards drag away the gnome, kicking and screaming.{/n}"
msgstr "{n}경비병들이 이 발길질하며 소리지르는 노움을 끌고 갔습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0059_Text
msgctxt "b29c26bc-8028-4073-936b-e64c7d94d2d4"
msgid "{n}The guards take away Gasperre, who is as pale as a sheet.{/n}"
msgstr "{n}경비병들이 백지장마냥 창백해진 가스페레를 데리고 갔습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0060_Text
msgctxt "64f5c416-31e0-423c-8825-e27b0b9d9715"
msgid ""
"{n}Stefano is escorted away by the guards, his chin pointed proudly "
"skyward.{/n}"
msgstr "{n}스테파노는 그의 턱을 하늘을 향해 자랑스럽게 치켜올리고는 경비병들의 호위를 받으며 나아갔습니다. {/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0064_Text
#. Speaker : Pitax_AtaliaGitaren
msgctxt "af8be305-06fb-4325-8e38-5e362e29fe80"
msgid ""
"\"Your Highness, {d|Atalia}I{/d} ask that you relieve me from my post as "
"headmaster of the {g|Academy of Grand Arts}Academy{/g}. After all that has "
"happened, I am hardly worthy of keeping it.\""
msgstr ""
"\"전하, {d|Atalia}저{/d}는 당신께 {g|Academy of Grand Arts}아카데미{/g}의 학장 자리에서 면직시켜 "
"달라 부탁드립니다. 이 모든 일이 벌어진 후에 저는 그 자리를 지킬만한 사람이 아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0065_Text
#. Speaker : Pitax_AnnamedeBelavarah
msgctxt "9c4eefec-3311-45ea-b00b-fab0bdb2641f"
msgid ""
"{n}{d|Annamede}Annamede Belavarah{/d}, the most famous bard in all of "
"{g|Pitax}Pitax{/g}, gives you a charming smile.{/n} \"For the first time, I "
"completely agree with my respected colleague. And if you don't have another "
"candidate for the position, please allow me to offer my services!\""
msgstr ""
"{n}피탁스의 모든 바드들 중 가장 유명한 안나미데 빌라바라가 당신에게 매혹적인 미소를 건냅니다.{/n} \"처음으로 저는 제 존경받는 "
"동료에게 완전히 동의합니다. 그 직위에 떠오르는 다른 후보자가 없으시다면, 제가 봉사할 수 있도록 허락해주세요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0066_Text
#. Speaker : Linzi_Companion
msgctxt "5eb7aea0-e2ea-4ed5-bb84-bae032089d56"
msgid ""
"\"It appears we don't have any candidates for the role of {g|Academy of "
"Grand Arts}Academy{/g} headmaster... Why don't we then hold an election "
"among the teachers?\""
msgstr ""
"\"{g|Academy of Grand Arts}아카데미{/g}의 학장 자리에 걸맞는 후보자가 없는 것 같소...교사들 사이에서 선거를 "
"하는 것이 어떻겠소?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0075_Text
#. Speaker : Pitax_AtaliaGitaren
msgctxt "8ef4b76d-a141-4134-9d8f-93c98e63ef6e"
msgid ""
"{n}Atalia looks down and quietly replies.{/n} \"As you wish, Your Highness.\""
msgstr "{n}아탈리아가 시선을 내리고는 조용히 답했습니다.{/n}\"당신이 바라시는 데로, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0078_Text
#. Speaker : Pitax_AnnamedeBelavarah
msgctxt "5840bc9a-9594-46bd-bd97-ae4273ca6787"
msgid ""
"\"Well, I can't say I'm surprised. Lady Gitaren is not only competent, but "
"also extremely pliable, accommodating, and efficient! Let her serve you as "
"diligently as she served Irovetti!\""
msgstr ""
"\"음, 놀랍다고는 말할 수 없겠네요. 지타렌 여사는 유능할 뿐만 아니라, 융통성이 있고 협조성이 있는데다가 효율적으로 일을 처리하지요! "
"그녀가 이로베티를 섬겼던 것처럼 당신을 부지런히 섬기도록 해보죠!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0080_Text
#. Speaker : Linzi_Companion
msgctxt "4cbbffd2-418d-471b-8f4d-976a14d685f0"
msgid "\"Is that all? There is anyone else who can't wait to be seen?\""
msgstr "\"이게 전부인가요? 알현을 기다리는 사람이 더 없나요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0081_Text
#. Speaker : Pitax_AtaliaGitaren
msgctxt "254e3157-d986-4984-af61-33509c542e69"
msgid ""
"\"Thank you, Your Highness. Lady Belavarah, I wish you all success in your "
"new role, from the bottom of my heart.\""
msgstr "\"감사합니다, 전하. 벨라바라 여사, 제 가슴 깊이, 당신의 새 직책을 성공적으로 수행하시길 바랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0082_Text
#. Speaker : Pitax_AnnamedeBelavarah
msgctxt "f7384986-5857-4aa7-a5f4-234d4a712efc"
msgid ""
"\"Thank you, Your Highness – it's a great honor! Apparently I was right "
"about you. I shan't disappoint you either, I promise.\""
msgstr "\"감사합니다, 전하. 큰 영광이에요! 명백히 옳으신 결정이에요. 당신을 실망시키지 않겠다 약속드리죠.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0084_Text
#. Speaker : Pitax_AnnamedeBelavarah
msgctxt "e2335ff7-cca5-4d41-89f2-5e31dd02f308"
msgid ""
"\"Really? Well, that's even better! Let some other candidates have their "
"fair chance.\""
msgstr "\"정말이에요? 음, 그게 더 좋겠어요! 다른 후보자들에게도 공평한 기회를 주어요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0085_Text
#. Speaker : Pitax_AtaliaGitaren
msgctxt "97106c8c-7bc5-42ad-8850-390e7b716e14"
msgid ""
"\"Thank you, Your Highness. That would indeed be the right thing to do.\""
msgstr "\"감사합니다, 전하. 정말 옳은 일을 하셨습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0087_Text
#. Speaker : Linzi_Companion
msgctxt "17698c8c-a352-4b8d-91df-a37ffceaf209"
msgid "{n}Linzi's face becomes a little sad, but then she nods.{/n}"
msgstr "{n}린지의 얼굴이 약간 슬퍼보였지만, 이내 그녀는 고개를 끄덕였습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0088_Text
#. Speaker : Pitax_AnnamedeBelavarah
msgctxt "30afa466-441c-451f-a844-fc4039ab7d47"
msgid ""
"\"That's a big mistake, Your Highness. – An unforgivable mistake. Do you "
"really care nothing of how history will remember you?\""
msgstr "\"전하, 정말 실수하시는 거예요. 용서받지 못할 실수요. 역사가 당신을 어떤 모습으로 기억할지 신경 쓰이지 않으세요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0089_Text
#. Speaker : Pitax_AtaliaGitaren
msgctxt "a93cca59-e784-4980-bb41-85304aa9a042"
msgid "\"It's a pity... But maybe it's the right thing to do.\""
msgstr "\"안타깝지만...그렇게 하는 것이 옳은 일이에요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0097_Text
#. Speaker : Pitax_AtaliaGitaren
msgctxt "696bf48f-c95e-45a0-b169-caa9de74a04a"
msgid "{n}Atalia lowers her head.{/n} \"I... Deserve this.\""
msgstr "{n}아탈리아는 고개를 숙였습니다.{/n} \"저는... 이것을 받아들이겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0098_Text
#. Speaker : Pitax_AnnamedeBelavarah
msgctxt "eaff3967-398c-4da0-86d2-77e07addd161"
msgid "{n}A blissful smile glows on Annamede's face.{/n}"
msgstr "{n}더 없이 행복한 미소가 안나미데의 얼굴에 퍼져갑니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0099_Text
msgctxt "d5918de0-0650-4c11-af3b-070600cdaa50"
msgid "{n}Atalia falls limp and leaves with the guards.{/n}"
msgstr "{n}아탈리아는 축 쳐져서는 경비병들과 함께 나갔습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0100_Text
#. Speaker : Pitax_AnnamedeBelavarah
msgctxt "f7e000bd-6a1a-4542-b012-144bc940e7fb"
msgid "\"What?! No! You wouldn't dare! For what?!\""
msgstr "\"뭐라구?! 안돼! 네가 어찌 감히! 무엇 때문에?!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0101_Text
msgctxt "e5671408-e3da-400c-a3ff-3a6cf76841fd"
msgid "{n}The guards take Annamede away, swearing and kicking.{/n}"
msgstr "{n}경비병들이 욕설에 발길질 하는 안나미데를 끌고 갔습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0102_Text
#. Speaker : Linzi_Companion
msgctxt "e40c5c30-e3a2-4ee2-983d-9873dd456d96"
msgid ""
"\"What a wonderful decision! I'm sure the teachers will elect the most "
"worthy candidate from among themselves!\""
msgstr "\"정말 훌륭한 결정이에요! 교사들이 그들 가운데 가장 충실한 후보자를 선출할 거라고 저는 확신해요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0104_Text
#. Speaker : Linzi_Companion
msgctxt "5bf32067-9a69-429a-b281-72ac297091f9"
msgid "{n}Linzi covers her face and turns away.{/n}"
msgstr "{n}린지는 그녀의 얼굴을 감싸주고는 뒤돌아 섰습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0106_Text
#. Speaker : Linzi_Companion
msgctxt "9d2629ea-8ff4-4b53-9f19-e41d459e5586"
msgid "\"Well, we're done with the guards. Who else is left...\""
msgstr "\"그럼, 경비대가 볼 일은 마쳤군. 또 누가 남았나...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0107_Text
#. Speaker : Linzi_Companion
msgctxt "7c143f89-26ac-43af-9fb1-f0562bba0cc7"
msgid "\"Ah, yes! {d|Ilora}Ilora Nuski{/d} and her River Razors!\""
msgstr "\"아, 맞아요! {d|Ilora}일로라 누스키{/d}와 그녀의 강의 칼날 도적단이에요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0108_Text
#. Speaker : Linzi_Companion
msgctxt "58ded152-9f2d-4b6e-8240-3328b9c5a462"
msgid ""
"\"No one else. Well, what a day! I see it's not easy to rule. I'd rather "
"break up a pack of wyverns than live through another day like this!\""
msgstr ""
"\"더는 없어요. 음, 대단한 날이에요! 통치하는 건 쉽지 않은 일이죠. 오늘 같은 하루를 더 보내느니 차라리 와이번 한 무리를 "
"무찌르겠어요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0109_Text
#. Speaker : IloraNaski_Neutral
msgctxt "ca8e0c59-747e-48bb-a4e2-2a6889acb35f"
msgid ""
"\"Hello, Your Highness! Well, I'm... What's next? To be honest, my fellows "
"and I got so much loot storming the palace that we could live in comfort to "
"a ripe old age. – But I think it's still a little early for us to retire. "
"Will you hire us to serve you? We've shown ourselves in battle, and we "
"promise to serve you faithfully and loyally!\""
msgstr ""
"\"안녕하세요, 전하! 음, 저는... 다음이 뭐냐구요? 솔직히 말하자면, 제 부하들과 저는 이 궁전을 휩쓸면서 우리가 늙어서도 편하게 "
"살 만큼을 노획했지요. 그러나 제 생각에는 아직 은퇴하기는 이른거 같군요. 당신께 봉사하도록 저희를 거두어주시겠어요? 전장에서 우리 "
"스스로를 증명했고, 당신을 충성스럽게 모신다고 약속드리지요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0114_Text
#. Speaker : IloraNaski_Neutral
msgctxt "301f1072-f8b9-4856-bbc2-db3af14f3a8d"
msgid "\"It's a deal! Oh, I mean, at your orders, Your Highness!\""
msgstr "\"약속하신 거예요! 앗, 그러니까 제 말은. 명을 따르겠습니다, 전하!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0115_Text
#. Speaker : IloraNaski_Neutral
msgctxt "e6f37ccc-7888-4a95-a4c0-59b4dd50bb47"
msgid ""
"\"Yes, yes, how could I expect anything else? Very well, no hard feelings. "
"Goodbye and good luck!\""
msgstr "\"그래요, 그래, 더 이상을 어떻게 기대하겠어요? 좋아요, 악감정은 없어요. 잘 지내요, 행운을 빌게요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0116_Text
#. Speaker : IloraNaski_Neutral
msgctxt "72ffd689-5961-48c4-9a80-b9d31ccce6f1"
msgid ""
"\"What?! But I... You scum! Damn you! You and your whole blasted kingdom!\""
msgstr "\"뭐라구?! 그러나 나는... 이 쓰레기! 저주 받아라! 너와 네 빌어먹을 왕국 전부!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0118_Text
#. Speaker : IloraNaski_Neutral
msgctxt "aa8aa4c0-7263-4d7a-b4d4-be106b38fddf"
msgid ""
"\"Ha ha! As you wish, Your Highness! And don't you worry, you'll be getting "
"your share on time!\""
msgstr "\"하 하! 당신의 뜻대로, 전하! 그리고 걱정하지 마세요, 당신의 몫은 제때 챙길 수 있을테니까!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0119_Text
#. Speaker : Pitax_KharneVereel
msgctxt "4d5604d2-1b88-4008-9f24-01c36a6f2102"
msgid ""
"{n}{d|Vereel}Kharne Vereel{/d} stares at Gasperre with dim, bloodshot "
"eyes.{/n} \"Your Highness... I think the thieves' guild fully proved its "
"loyalty, by supporting you against Irovetti. We promise you our complete "
"support – and a share of our profits, of course. If you appoint me as "
"governor, your cut of the profits will leave you gasping!\""
msgstr ""
"{n}{d|Vereel}칸 베릴{/d}은 침침하고 충혈된 눈으로 가스페레를 노려봅니다.{/n}\"전하... 이로베티에 대항하여 당신을 "
"지지함으로써 도둑 길드는 그 충성심을 모두 증명했다고 생각합니다. 저희는 완벽한 당신을 지지함은 물론 저희의 이득도 나누겠다 "
"약속드립니다. 저를 영주로 내정하여 주신다면 당신의 몫은 당신을 놀라게 할 것입니다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0120_Text
#. Speaker : Pitax_AnnamedeBelavarah
msgctxt "32f6eacf-1a33-4f14-9a9e-bcae3a26fedd"
msgid ""
"{n}{d|Annamede}Annamede{/d} bows gracefully and gives you a charming "
"smile.{/n} \"Congratulations, Your Highness. {g|Pitax}Pitax{/g} is at your "
"feet – and as promised, I {d|c51 Annamede Help}contributed{/d} to your "
"victory. Now it's your turn – will you hold up your end of our arrangement?\""
msgstr ""
"{n}{d|Annamede}안나미데{/d}는 우아하게 인사하며 당신에게 매혹적인 미소를 건냈습니다.{/n}\"축하드립니다, 전하. "
"{g|pitax}피탁스{/g}가 당신의 발 아래 놓였습니다. 약속드렸던데로 저는 당신의 승리에 {d|c51 Annamede "
"Help}기여했습니다{/d}. 이제 전하의 차례입니다. 저희가 한 협약을 끝까지 지켜주시겠지요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0121_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "68d39739-0bad-4753-9496-a10a49ecf489"
msgid ""
"\"Because that's the order, as set by the first kings of {g|Pitax}Pitax{/g}. "
"The city guard has always served as a counter-balance to the trade houses – "
"even whichever one presently holds the crown. We exist to guard the city's "
"peace and prevent a bloody power struggle. That's why we answer not to the "
"king, but to the people.\""
msgstr ""
"\"{g|pitax}피탁스{/g}의 초대 왕이 세운 명령이기 때문입니다. 도시 경비대는 언제나 무역 회사들과 대립하여 균형을 맞추어 "
"왔습니다. 심지어 어느 한 쪽이 왕관을 쥐고 있는 순간에도 그러하였습니다. 우리는 도시의 평화를 지키고 피의 권력 투쟁을 막기 위해 "
"존재합니다. 그것이 저희가 왕을 섬기는 것이 아니라 사람들을 섬기겠다 대답한 이유입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0122_Text
#. Speaker : Pitax_AnnamedeBelavarah
msgctxt "e993a93a-69e5-4b1d-acf0-3f6c35028978"
msgid ""
"{n}Annamede listens to your words with a crooked smirk.{/n} \"Well, I can't "
"say I'm surprised. This is the last time I take a job without being paid up "
"front.\""
msgstr ""
"{n}안나미데는 히죽거리며 당신이 하는 말을 들었습니다.{/n}\"이런, 놀랍다고는 할 수 없겠네요. 이번이 제가 선금없이 일하는 "
"마지막이에요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0123_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "f82e685a-accf-4c6e-b6c5-51a8527efd69"
msgid ""
"\"Irsei Caelysse, captain of the guard, comes to pledge allegiance to his "
"{mf|King|Queen}.\""
msgstr "\"경비대의 대장, 얼세이 케일리시. {mf|왕|여왕}과 충성 서약을 맺고자 왔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0124_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "8bd827de-12bf-46ee-9ca7-d5805eb5b716"
msgid ""
"{n}Irsei Caelysse greets you with a reserved bow.{/n} \"Your Highness. "
"According to the traditions set forth by the first kings of "
"{g|Pitax}Pitax{/g}, I have come to pledge my allegiance to the city and its "
"citizens, before you and the crown. I shall serve Pitax faithfully and "
"loyally, to my dying breath, and guard the peace of its streets.\""
msgstr ""
"{n}얼세이 케일리시는 정중한 인사로 당신을 맞이하였습니다.{/n}\"전하, {g|pitax}피탁스{/g}의 초대 왕이 세운 전통에 "
"따라, 저는 당신과 왕관 앞에 도시와 그 시민에 대한 제 충성을 맹세합니다. 저는 제 숨이 멎는 날까지 피탁스를 위해 봉사하는 데에 제 "
"충성을 다 바칠 것이며, 그 거리의 평화를 지킬 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0129_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "191ff08c-d16c-40bc-a2a3-7fcbeb6c2b3d"
msgid ""
"\"This is impossible, Your Highness. The captain of the guard is elected by "
"the citizens, from candidates proposed by the officers. – And only officers "
"of the guard can demote him. This was the arrangement set forth by the first "
"kings – expressly to protect the guard's role.\""
msgstr ""
"\"불가능한 일입니다, 전하. 경비대의 대장은 대원들의 추천을 받은 후보자 가운데 시민들이 선출하는 것입니다. 그리고 오직 경비대원들만이 "
"그를 강등시킬 수 있습니다. 이는 초대왕이 세운 경비대의 지위를 보호하기 위한 협약입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0132_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "efed4926-0f34-47f8-8b97-e98c6bdd765d"
msgid "\"Thank you, Your Highness.\""
msgstr "\"감사합니다, 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0133_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "f70d6508-cb16-4a97-9124-f855bbded8a5"
msgid "\"This is a rash decision, Your Highness. It may cause civil unrest.\""
msgstr "\"성급한 결정입니다, 전하. 이는 시민들의 불안을 야기할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0138_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "e7f84de2-8a7c-4e7e-b51e-7741d4188c22"
msgid ""
"\"I admit it won't be easy with this new governor... But the city has been "
"through worse. We'll be fine.\""
msgstr "\"새로운 영주에게 쉽지 않은 일이 될 것입니다...그러나 도시는 계속 악화되어 왔었습니다. 우리는 괜찮을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0139_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "b1ce93f4-6fdb-45c8-8013-47541010abd6"
msgid ""
"\"I must say, now that you so wisely spared the city of that scoundrel "
"Kharne Vereel, it will be much easier to keep order.\""
msgstr ""
"\"꼭 말씀드려야 겠습니다. 이제 당신께서 도적 칸 베릴로부터 도시를 현명하게 구해내셔서, 질서를 유지하기가 더 수월해졌습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0140_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "f529de95-539b-49e2-a384-24ae80ffb9ab"
msgid ""
"\"I admit, your choice of business {d|c51 Drugs Kingdom}partners{/d} won't "
"make our job any easier... But the city has been through worse. We'll be all "
"right.\""
msgstr ""
"\"사업 {d|c51 Drugs Kingdom}동업자들{/d}을 선택하신 것이 저희의 일을 더 쉽게 하진 않겠지만 받아들이도록 "
"하겠습니다... 도시는 더 심한 고통을 겪고 있습니다. 우리는 괜찮을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0141_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "506957c2-f5d3-45ef-8bf0-ca6d68f40c9f"
msgid ""
"\"Allow me to ask you something. How do you feel about Kharne Vereel's so-"
"called thieves' guild – dealers who, under Irovetti, flooded the city with "
"{g|Numeria}Numerian{/g} drugs?\""
msgstr ""
"\"제게 질문을 허락해 주십시오. 이로베티의 휘하에서 {g|Numeria}누메리아 산{/g} 마약을 도시에 넘처나게끔 한 마약상인 칸 "
"베릴과 소위 도둑 길드에 대해 어떻게 생각하시는지요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0142_AlignmentShift.Description
msgctxt "73846658-c6f3-48b3-ab44-00d696d76664"
msgid "Broke the promise given to Irsei Caelysse."
msgstr "얼세이 케일리시와 한 약속을 어겼습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0142_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "f253ea77-72f5-4ac7-aae8-d4bef388a5ae"
msgid ""
"\"This is not what we arranged before the battle... But I can't say I'm "
"surprised.\""
msgstr "\"전투 전에 우리가 합의했던 것이 아닙니다...하지만 놀랍지는 않군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0143_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "a9d51e82-b8f0-4e27-ba43-78f918bb4906"
msgid ""
"\"Very well, I shall take my leave.\" {n}Saluting you, Irsei Caelysse leaves "
"the throne room.{/n}"
msgstr "\"좋습니다, 그럼 가보겠습니다.\"{n}얼세이 케일리시는 당신에게 경례하고는 왕좌의 방을 빠져나갔습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0144_AlignmentShift.Description
msgctxt "9eb83482-161c-48cc-97c6-738265896800"
msgid "Fulfilled the promise given to Irsei Caelysse."
msgstr "얼세이 케일리시와 한 약속을 지켰습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0144_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "3f191fa6-d28c-464f-ac49-70665b57d244"
msgid ""
"\"It's good to see that the new {mf|King|Queen} is a {mf|man|woman} of "
"honor, and {mf|his|her} {d|c51 Irsei Help}promises{/d} are worth something.\""
msgstr ""
"\"새로운 {mf|왕|여왕}께서 명예로우시고, {d|c51 Irsei Help}약속{/d}의 가치를 아는 {mf|남성|여성}분이셔서 정말 "
"기쁩니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0149_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "8a6be490-8eff-436c-8b29-0a939674b079"
msgid ""
"{n}Pursing his lips, Irsei looks you right in the eye.{/n} \"I understand, "
"Your Royal Highness. It appears that not much will change in the city, "
"despite the change of ruler.\""
msgstr ""
"{n}입술을 오므리면서, 얼세이는 당신의 눈을 똑바로 쳐다봅니다.{/n} \"알겠습니다, 전하. 통치자가 바뀌었어도 도시에는 별반 변화가 "
"없을 것 같군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0150_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "5d8efc8c-70f2-434f-9149-5e65c3bf7fc5"
msgid ""
"{n}Irsei nods, and something remotely resembling a smile shows on his stern "
"face.{/n} \"Thank you, Your Highness.\""
msgstr ""
"{n}얼세이는 고개를 끄덕입니다. 동시에 그의 근엄한 얼굴에 어울리지 않는, 미소와 같은 무언가가 살짝 어려보입니다.{/n} \"감사합니다"
", 전하.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0151_Text
#. Speaker : Pitax_IrseiCaelysse
msgctxt "387eb86a-9a57-4bf5-918b-70f24a3650fd"
msgid ""
"\"Really? And I thought that {g|Pitax}Pitax{/g} had its worst days under "
"Irovetti. Those times will soon seem our golden age...\""
msgstr ""
"\"그렇습니까? 그리고 전 {g|피탁스}피탁스{/g}가 이로베티 밑에서 최악의 나날을 보냈다고 생각했습니다. 그 시간들이 곧 우리의 "
"황금기처럼 보일 겁니다...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0152_Text
msgctxt "3a39e517-a845-445a-9325-4128eaad0679"
msgid ""
"{n}Measuring his pace, Irsei Caelysse leaves, accompanied by the guard.{/n}"
msgstr "{n}자기 속도를 재며, 얼세이는 경비와 함께 떠납니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0153_Text
msgctxt "e4e043c1-4df3-44e9-a3f7-d2519d5bf528"
msgid "{n}With a gap-toothed grin, Ilora leaves the throne room.{/n}"
msgstr "{n}입 벌리고 껄껄 웃으며, 일로라는 왕실을 나섭니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0154_Text
msgctxt "2100af20-86ae-459e-ac37-9da67f16ab91"
msgid ""
"{n}The guards take Ilora away, paying no heed to her screams and curses.{/n}"
msgstr "{n}경비원들은 일로라의 비명소리와 욕설에도 아랑곳하지 않고 그녀를 데려갑니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0156_Text
#. Speaker : Pitax_KharneVereel
msgctxt "af5e972a-c987-4fcd-982b-5b5f08396638"
msgid ""
"{n}The gnome smiles and rubs his hands together.{/n} \"Sweet, yes... There, "
"back in Pitax, you made some promises, Your Highness. Good promises, yes. "
"I'll send my people to work out the details of our deal, heh heh.\""
msgstr ""
"{n}노움은 웃으며 양손을 비벼댑니다.{/n} \"좋습니다, 네... 예전에 피탁스에서 약속을 하셨었지요, 전하. 좋은 약속입죠, "
"그렇습니다. 제 사람들을 보내서 우리 거래의 세부사항에 대해 착수하도록 하겠습니다, 헤헤\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0157_Text
#. Speaker : Linzi_Companion
msgctxt "6e4edc24-6a07-4014-827d-c24cb47fdcd5"
msgid ""
"\"You shouldn't have disbanded the guard. Can you imagine what'll happen to "
"the city without it? Oh, my poor old Pitax!\""
msgstr "\"경비대를 해체해서는 안됐어요. 도시에 무슨 일이 벌어질지 상상해봤나요? 오, 나의 불쌍한 늙은 피탁스!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0158_Text
#. Speaker : Linzi_Companion
msgctxt "8a32faca-0007-4f12-b326-54c420bf4971"
msgid ""
"\"You returned the city to the old Trade Houses. Frankly, under all the "
"velvet clothes and pretty words, they were just plain old bandits — but old "
"and familiar ones, at least. I guess Pitax will soon go back to what it was "
"like before Irovetti!\""
msgstr ""
"\"도시를 옛 무역 회사에 되돌려주었네요. 솔직히, 벨벳옷을 입고 미사여구를 늘어놓기는 해도, 그들은 평범한 옛날 도둑이었을 뿐이었죠. "
"하지만 적어도 친숙한 옛날 도적이었어요. 피탁스는 곧 이로베티 전처럼 돌아갈 것 같네요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0159_Text
#. Speaker : Linzi_Companion
msgctxt "64a051e4-3b9c-4d15-a9a6-ae3c402c1f10"
msgid ""
"\"The old Trade Houses are through. I won't cry for them: under all the "
"velvet clothes and pretty words, they were just plain old bandits. You took "
"the city away from them and gave it to... Well, some new bandits, I guess? I "
"wonder how it'll change the face of Pitax!\""
msgstr ""
"\"옛 무역 회사도 운이 다했군요. 눈물이 나온다고 할 수는 없겠네요. 벨벳을 걸치고 미사여구를 늘어놓긴 해도, 오랫동안 도둑질을 "
"이어왔을 뿐이니까요. 도둑에게 도시를 빼앗아 새로운... 도둑을 앉힌 셈인가요? 어쨌거나 이 일이 피탁스에 어떤 변화를 줄지 궁금하네요!"
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-PitaxAftermath/Linzi_CoreDialogue/Cue_0160_Text
#. Speaker : Linzi_Companion
msgctxt "4c222d76-9757-4355-b8d2-9fd9de08f065"
msgid "\"I wonder: what will happen to the city now?\""
msgstr "\"궁금하네요. 이제 피탁스에는 무슨 일이 벌어질까요?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-Mosconi/Answer_0003_Text_String
msgctxt "f6bf03c3-77d7-4516-ac43-31d8e2baff23"
msgid "\"Very well... Tell Irovetti that I'm coming.\""
msgstr "\"잘 알겠다... 이로베티에게 내가 간다고 전하라.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-Mosconi/Answer_0004_Text_String
msgctxt "8aa836d0-1284-4329-9513-92a4732b9023"
msgid "\"He can wait for as long as he likes. He's not getting my crown.\""
msgstr "\"기다리고 싶다면 얼마든 기다리라지. 내 왕관을 가져갈 수는 없을 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-Mosconi/Answer_0007_AlignmentShift.Description
msgctxt "97dca0ed-ef4c-478f-ac50-e062a9033e55"
msgid "Sent Stefano Moskoni's head to Irovetti as a message."
msgstr "이로베티에게 스테파노 모스코니의 머리를 대답으로 보냈습니다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-Mosconi/Answer_0007_Text_String
msgctxt "2a82edf6-b835-48fe-8c8c-70b17d826eb6"
msgid "\"Guards! Take him. Send his head to Irovetti as our reply!\""
msgstr "\"경비병! 그를 끌어내라. 이로베티에게 답신으로 그의 머리를 보내도록!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-Mosconi/Answer_0012_Text_String
msgctxt "c5595806-26fa-41cd-9140-97e690244138"
msgid ""
"\"I am not keeping up with my responsibilities?! Don't be absurd! You know "
"full well that the disasters that fell upon my lands were the work of "
"Irovetti himself!\""
msgstr ""
"\"내가 내 책임을 다하지 못하고 있다고?! 어리석은 소리! 내 영토에 생긴 재앙이 이로베티 그 자신의 작품임을 잘 알것이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-Mosconi/Cue_0001_Text
msgctxt "2b0cb525-6258-4119-aff4-898f89a7386e"
msgid ""
"{n}Stefano Moskoni is wearing particularly splendid attire for his visit. "
"His doublet is embroidered with precious stones, and decorated with the "
"emblem of {g|Pitax}Pitax{/g}. A disdainful smile is plastered on his "
"powdered face. He bows formally.{/n} \"Your Highness! I am here on behalf of "
"His Highness Irovetti of Pitax.\""
msgstr ""
"{n}스테파노 모스코니는 방문을 위해 특히나 화려한 복장을 입고 있습니다. 그의 더블릿은 값진 보석으로 수놓아져있고, "
"{g|Pitax}피탁스{/g}의 문장으로 장식되어있습니다. 그의 분칠한 얼굴에는 경멸적인 미소가 반죽되어 있습니다. 그는 격식을 차려 "
"고개를 숙입니다. {/n} \"전하! 피탁스의 이로베티 전하의 뜻으로 이곳에 왔나이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-Mosconi/Cue_0005_Text_String
msgctxt "aa6d9cd0-ce8c-427a-80a5-7c3105801673"
msgid ""
"\"I will pass your words to His Highness... But wouldn't it be wiser to "
"accept a helping hand while your country can yet be saved? Think about it.\""
msgstr ""
"\"전하의 말씀을 이로베티 전하께 전하도록 하겠습니다... 하지만 전하의 국가를 구해낼 수 있을 때 도와주려는 손을 받아들이는 것이 "
"현명하지 않을지요 ? 생각해 보십시오.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-Mosconi/Cue_0006_Text_String
msgctxt "2a2c46ab-a99f-4542-8e64-a99462196238"
msgid "\"His Highness is expecting you.\""
msgstr "\"이로베티 전하께서 기다리고 계십니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-Mosconi/Cue_0008_Text
msgctxt "227de27e-dca4-4d03-87e5-93edb12477c6"
msgid "{n}Your guards disarm the screaming Moskoni and drag him away.{/n}"
msgstr "{n}경비병이 비명을 지르는 모스코니를 무장해제하고 그를 끌고갑니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-Mosconi/Cue_0009_Text
msgctxt "8b921471-4159-47e0-8adc-29467d99320a"
msgid ""
"{n}The man who enters the throne room apparently spends a great deal of time "
"and effort on his appearance. His face is powdered, his hair and foppish "
"mustache are generously slicked, and his doublet is embroidered with "
"precious stones and decorated with the emblem of {g|Pitax}Pitax{/g}. He bows "
"formally.{/n} \"Allow me to introduce myself. I am Stefano Moskoni, "
"ambassador of His Royal Highness Irovetti of Pitax.\""
msgstr ""
"{n}알현실로 들어오는 남자는 치장에 많은 시간과 노력을 쏟은 것이 분명합니다. 얼굴에는 하얀 분을 칠했고, 머리와 멋 부린 수염은 "
"기름으로 번들거립니다. 꽉 끼는 조끼에는 값비싼 보석이 달려있고, {g|Pitax}피탁스{/g}의 문장을 수놓았습니다. 남자가 격식을 "
"차려 고개를 숙입니다.{/n} \"만나 뵙게 되어 영광입니다. 저는 스테파노 모스코니, 피탁스에서 온 이로베티 전하의 대사입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-Mosconi/Cue_0010_Text_String
msgctxt "c4a6e77e-64dd-47fc-b663-4ef69ad50e94"
msgid ""
"\"It is an open secret that things are not going too well for your kingdom "
"of late. Bandits and monsters, which you supposedly exterminated, are "
"swarming your countryside once more. You are losing the trust and respect of "
"your subjects. Everyone sees that you are failing to meet the "
"responsibilities of a proper ruler. – It's just that not everyone dares to "
"say this out loud.\""
msgstr ""
"\"최근 전하의 왕국이 잘 되가지 않는다는 것은 공공연한 비밀입니다. 산적들, 괴물들. 전하께서 근절하셨다던 것들이, 또 다시 지방에서 "
"들끓고 있습니다. 전하께서는 백성들의 신뢰와 존경을 잃고 계십니다. 모두가 전하께서 적합한 통치자의 책임을 지지 못하고 있다는 것을 알고 "
"있습니다. 모두가 큰 소리로 이 사실을 말할 용기가 없을 뿐이지요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-Mosconi/Cue_0011_Text_String
msgctxt "d401a9e9-e230-4db6-a621-fbcb4f682666"
msgid ""
"\"His Highness Irovetti is ready to lend you a helping hand. Reject this "
"unbearable burden of power, kneel to him and abdicate the crown. He will "
"rule the {g|Stolen Lands}Stolen Lands{/g} as wisely and fairly as he rules "
"his own country. His Highness is expecting you at his palace in "
"{g|Pitax}Pitax{/g}, ready to accept your oath.\""
msgstr ""
"\"이로베티 전하께서는 도움의 손을 내밀고자 합니다. 이 권력의 견딜수 없는 짐을 거부하고, 그의 앞에 무릎을 꿇어 왕관을 "
"내려놓으십시오. 이로베티 전하께서는 피탁스에서처럼 {g|Stolen Lands}도둑맞은 땅{/g}을 현명하고 공정하게 통치하실 것입니다. "
"이로베티 전하께서는 {g|Pitax}피탁스{/g}의 궁전에서 전하를 기다리며 서약을 받아들일 준비가 되었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-Mosconi/Cue_0013_Text
msgctxt "e90f2c50-beb3-481f-ab36-d3f4e9c5de87"
msgid ""
"{n}Moskoni smiles contentedly.{/n} \"This is slander, Your Highness. My King "
"is famous for his wisdom and fairness. – How could he have woven such a "
"plot?! It is beyond belief!\""
msgstr ""
"{n}모스코니는 만족스럽게 미소짓습니다.{/n} \"모합이니다, 전하. 저의 왕께서는 지혜와 공평함으로 이름이 높습니다. 그런 분이 "
"어떻게 그런 음모를 세울 수가 있겠습니까?! 믿을 수가 없군요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-Mosconi/Cue_0014_Text
msgctxt "8645c396-bc21-4d3f-ab6f-fbeee28cbdf7"
msgid "{n}With a low bow, Moskoni leaves the throne room.{/n}"
msgstr "{n}깊게 절하고, 모스코니는 알현실을 떠납니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-NoMosconi/Answer_0005_AlignmentShift.Description
msgctxt "deec56c6-fdf7-4668-8b66-12df8f88512f"
msgid "Sent the head of Irovetti's messenger back to him as a message."
msgstr "이로베티에게 전령의 목을 돌려보내 뜻을 전한다."

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-NoMosconi/Answer_0005_Text
msgctxt "972b34ac-8134-4139-89f7-3b34c4eaf927"
msgid "\"Guards! Take her. Send her head to Irovetti as our reply!\""
msgstr "\"경비병! 그녀를 끌어내라. 이로베티에게 답신으로 그녀의 머리를 보내도록!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-NoMosconi/Cue_0001_Text
msgctxt "35e1dbb5-36ee-4056-838b-6672e387c349"
msgid ""
"{n}The emblem of {g|Pitax}Pitax{/g} glistens on the messenger's chest. She "
"stands proudly and speaks her words bold and clear:{/n} \"Your Highness, "
"{Name} the First! I have a message for you from Irovetti, King of Pitax.\""
msgstr ""
"{n}{g|Pitax}피탁스{/g}의 문장이 전령의 가슴에서 빛납니다. 그녀는 자랑스러운듯 서서 대담하고 명료하게 말합니다.{/n} \""
"{Name} 1세 전하! 피탁스의 왕 이로베티로부터의 전언을 가지고 왔나이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-NoMosconi/Cue_0008_Text
msgctxt "b55cb268-3e6a-47d9-9900-ae48eb707e6b"
msgid "{n}Your guards disarm the screaming messenger and drag her away.{/n}"
msgstr "{n}경비병이 비명을 지르는 전령을 무장해제하고 그녀를 끌고 나갑니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-NoMosconi/Cue_0012_Text
msgctxt "c7640827-a023-497b-8e90-9067b6c5abc2"
msgid ""
"\"I am sorry, Your Highness, but I do not have authority to negotiate. I was "
"only vested with the task of delivering my King's message and receiving your "
"reply.\""
msgstr ""
"\"죄송합니다, 전하. 저에게는 협상을 할 권한이 없습니다. 저는 단지 제 왕의 전언을 전하고 전하의 답신을 받도록 명 받았을 뿐입니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-NoMosconi/Cue_0013_Text
msgctxt "51504f61-224b-438b-842d-b342b8f2a9ce"
msgid "\"I will pass your words to His Highness.\""
msgstr "\"말씀을 이로베티 전하께 전하도록 하겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51-Surrender-NoMosconi/Cue_0014_Text
msgctxt "bff25da6-9517-4eed-b3fb-01ee6a5a5543"
msgid "{n}After a low bow, the messenger leaves the throne room.{/n}"
msgstr "{n}길게 절한 후, 전령은 알현실을 떠났습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Answer_0003_Text
msgctxt "c02e8749-3237-48b8-8f16-3983763aee27"
msgid "\"Hello. Why are you here?\""
msgstr "\"안녕. 왜 여기에 온거야?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Answer_0004_Text
msgctxt "68ae1d3f-617a-44bb-8f7a-65aabab49525"
msgid "\"Get lost, Nyrissa. We have nothing to talk about.\""
msgstr "\"꺼져라, 나이리사. 얘기할 것은 없다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Answer_0008_Text
msgctxt "40e859a6-d94f-4602-b5fa-932f517e10d9"
msgid "\"You're trying to say that you love me?\""
msgstr "\"나를 사랑한다고 말하려는 건가?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Answer_0012_Text
msgctxt "6eaec577-8e29-4c61-a666-727ec4290352"
msgid "\"That's enough. You're my enemy. I don't care about your feelings.\""
msgstr "\"그만. 넌 나의 적이다. 너의 감정에 대해서는 신경쓰지 않는다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Answer_0014_Text
msgctxt "a0e6c8e4-c5f9-46b8-804b-9793ee57347b"
msgid ""
"\"What if I'm ready to sacrifice the kingdom for you? Take it, it's yours. "
"Let the grain fall into the cup.\""
msgstr "\"만약 내가 너를 위해 왕국을 희생할 준비가 되었다면? 가져가, 왕국은 네 거야. 밀알을 잔에 떨어뜨려.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Answer_0015_Text
msgctxt "ebe0eaf7-f2e9-45cb-aa85-b3391d2fe415"
msgid ""
"\"I am sorry that everything turned out like this. I care about you, but I "
"can't let you destroy my kingdom.\""
msgstr "\"모든게 이런 식으로 흘러가서 유감이야. 넌 나에게 소중하지만, 네가 나의 왕국을 파괴하도록 내버려둘 수는 없어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Cue_0001_Text
msgctxt "c7644727-8d36-40f4-a135-94485d5b506b"
msgid ""
"\"You've broken into my dream. Now it's my turn to enter yours,\" {n}Nyrissa "
"says in lieu of a greeting. You feel the air trembling around you, like in "
"the short moment of still calmness preceding the storm.{/n}"
msgstr ""
"\"네가 내 꿈에 들어왔으니. 이제 내가 너의 꿈에 들어갈 차례다,\" {n}나이리사가 인사 대신으로 말합니다. 당신은 폭풍이 일기 전 "
"짧은 고요함의 순간과 같이 주변의 공기가 떨리는 걸 느낍니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Cue_0005_Text
msgctxt "f358b6ca-4693-404d-8bac-b1cb6732ed53"
msgid ""
"\"I've come to say goodbye. If we meet again, it will be a meeting of sworn "
"enemies on the battlefield.\""
msgstr "\"작별을 하러 왔다. 우리가 다시 만난다면, 숙명의 적으로써 전장에서 마주치겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Cue_0006_Text
msgctxt "dc7542b8-65cd-4f44-a7f3-2442e5bf4fa7"
msgid ""
"\"How sad, the fate of daring souls...\" {n}The nymph speaks in a singsong "
"voice.{/n} \"There are paths that cannot be strayed from, and words that "
"best remain unspoken. I've come to say goodbye. So I'm doing it now. The "
"only thing our next meeting will bring is death.\""
msgstr ""
"\"슬프구나, 용감한 영혼의 운명이란...\" {n}님프는 노래하는 듯한 목소리로 말합니다.{/n} \"벗어날 수 없는 길이 있으며, "
"말하지 않는 편이 가장 좋은 말이 있다. 나는 작별을 건내러 왔다. 그래서 지금 하는거지. 다음 번에 만났을 때의 결과는 죽음 뿐이다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Cue_0009_Text
msgctxt "e95354e1-68bc-4e4b-b619-0862db059f99"
msgid ""
"\"I cannot love,\" {n}says Nyrissa in a cold and even tone.{/n} \"The very "
"essence was ripped from my soul and lost. But when I speak with you, when I "
"watch you facing unthinkable threats, the hole in my soul bleeds, and hurts "
"more than ever.\""
msgstr ""
"\"나는 사랑할 수 없다.\" {n}나이리사가 차갑고 단조로운 음조로 말합니다.{/n} \"나의 정수는 나로부터 찢겨져 나가 잃어버렸다. "
"하지만 너와 이야기를 나눌 때, 네가 생각할 수도 없는 위협에 맞설 때, 내 영혼에 난 구멍에서 피가 흘러, 그 어느 때보다도 아프구나."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Cue_0011_Text
msgctxt "00917bc3-6c3d-488e-91d3-7fa8172ee660"
msgid ""
"\"Do you remember the first time we met? I came to you, disguised as the "
"former Nyrissa, a tender young nymph who hadn't yet spent ages under the "
"yoke of her curse. Deceiving comes easier if your lies are familiar to you. "
"But it seems that I've played myself into a corner. Your words brought me "
"pain. They were like sharp thorns sprouting through my skin. You made me "
"recall who I once was... and who I would never be again. Now, when the end "
"is near, I feel... anxiety. It seems it's no coincidence that the last step "
"to forgiveness must be the only death I could care about.\""
msgstr ""
"\"우리의 첫 만남을 기억하니? 저주를 풀기 위해 몇 천년을 낭비하기 전인 순진한 님프 모습으로 변장했었지. 친절하게 다가가면 속이기도 "
"더 쉬워지는 법이야. 하지만 그게 나 자신을 궁지로 몰아 넣은 것 같구나. 너의 말이 내게 고통을 안겨주었어. 양심의 가책이 가시가 되어 "
"내 살을 파고 들었지. 내가 누구였는지 너가 다시 떠올리게 해주었어... 다시는 돌아갈 수 없지만. 이제 끝이 다가오니까, 난... "
"초조해져. 너를 마지막 제물로 바치는 것이 이렇게 고민이 될 줄이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Cue_0016_Text
msgctxt "0bfd36c1-5d11-4100-a1a4-8da8387a2702"
msgid ""
"{n}It seems you've managed to surprise the nymph. But her surprise is laced "
"with contempt.{/n} \"So that's how you talk.... Well, if you wish to please "
"me so much, just let the peacock finish what he started and destroy your "
"country. But you have surprised me, truly. I didn't expect you to back down "
"so easily. Looks like I was wrong to cry about that missing part of my soul. "
"What's the good in softness and unconditional self-sacrifice, if it makes "
"you pathetic and weak?\""
msgstr ""
"{n}그 말은 님프를 놀라게 한 것 같습니다. 그러나 그녀의 놀라움은 경멸이 섞여 있습니다.{/n} \"그렇게 말하는 건가..... "
"글쎄, 그렇게 나를 기쁘게 하고 싶다면, 공작이 시작한 일을 끝내고 네 나라를 파괴하도록 내버려 둬. 하지만 넌 날 놀라게 했어, "
"정말로. 그렇게 쉽게 물러날 줄은 몰랐어. 내 잃어버린 영혼을 두고 울었던 게 잘못된 것처럼 보일 정도인데. 너 자신을 나약하고 안쓰럽게 "
"만든다면, 그 부드러움과 무조건적인 자기희생이 다 무슨 소용이지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Cue_0017_Text
msgctxt "88bca6f6-6f8d-4e46-acac-a532852a3c21"
msgid ""
"\"I know. Long ago, I refused to back down when the {g|Eldest}Eldest{/g} "
"sent the beast to destroy me and my realm. You and I are similar in that... "
"maybe that's why I... well, never mind. Farewell. Our next meeting, if it "
"happens, will be a very different one — much more bloody and violent, I "
"would expect.\""
msgstr ""
"\"알고 있어. 아주 오래 전에, {g|Eldest}원로{/g}가 짐승들을 보내 내 왕국을 초토화시켰을 때도 나는 절대 굴복하지 않았지. "
"그 점에서는 너와 난 비슷하구나... 이래서 너를... 음, 아무것도 아니야. 잘 있어라. 다음에 만나게 된다면 꽤 상황이 다를 거야. "
"아마 피 튀기는 격렬한 싸움이 되겠지. \""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Cue_0018_Text
msgctxt "60cddb3c-56d7-4602-884a-4f3f0e7aaf60"
msgid ""
"\"Oh, could I ever expect some other answer? You have every right to say so."
"\""
msgstr "\"오, 네게서 다른 대답을 들을 수는 없을까? 넌 그렇게 할 수 있어.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Cue_0019_Text
msgctxt "320c0a40-6312-45a4-8b33-d8ce0cabe425"
msgid ""
"{n}You seem to hear thunder rumble in the distance. The nymph turns to "
"leave, but suddenly raises her eyes to you and speaks again:{/n} \"Do you "
"know why I couldn't immediately recognize the intrusion, when you and the "
"foolish little robin bard broke into my dreams?\n"
"Because it wasn't the first time I dreamt of you, {name}.\"\n"
"{n}With these words, the nymph's silhouette dissolves into thin air.{/n}"
msgstr ""
"{n}허공에서 우레소리가 들리는 것 같습니다. 님프는 몸을 돌렸지만, 홱 고개를 돌려 쳐다보며 말합니다.{/n} \"내가 왜 너와 그 "
"우스꽝스러운 꼬마 바드가 내 꿈에 침입한 걸 바로 눈치 못챘는지 알아?\n"
"꿈에 네가 나온건 처음이 아니였기 때문이야, {name}.\"\n"
"{n}그 말과 함께, 님프의 실루엣은 허공으로 사라집니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc51_NyrissaInRomance/Cue_0020_Text
msgctxt "5a1ade48-14dc-4e7b-b739-de6ee057121c"
msgid ""
"{n}Nyrissa gives you a harsh smile.{/n} \"Thank you, my hound. I feel I am "
"finally rid of all doubt, and all of that excruciating, debilitating "
"weakness. Farewell!\""
msgstr ""
"{n}나이리사는 당신에게 잔혹한 웃음을 보냅니다.{/n} \"고마워, 내 사냥개야. 이제야 그 모든 의심과 고통, 쇠약을 없애버린 "
"기분이야. 작별이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Answer_0019_Text
msgctxt "a4d5395b-5394-4e6c-965e-963843127d0b"
msgid "\"What do we know of the Thousand Voices and what awaits us there?\""
msgstr "\"우리가 '천 개의 목소리'와 그곳에서 기다리는 것에 대해 아는 게 뭐지?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Answer_0027_Text
msgctxt "16449738-3851-4337-b467-3865a2b20133"
msgid "\"Will you travel with us, Evindra?\""
msgstr "\"에빈드라, 우리와 함께 가지 않겠어?\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Answer_0029_Text
msgctxt "df732161-2412-4b7a-a693-18b3941d8e52"
msgid ""
"\"Nyrissa has tormented my kingdom and all of the Stolen Lands for too long. "
"It's our turn now!\""
msgstr "\"나이리사는 내 왕국과 모든 도둑맞은 땅을 길게도 괴롭혔지. 이제 우리가 반격할 차례다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0001_Text
msgctxt "1af38292-20d2-458a-bd4b-6e811a6a0f9a"
msgid ""
"{n}Your comrades and advisors are gathered around the throne in breathless "
"silence. Linzi is the first to dare speak.{/n} \"I guess... I guess... it's "
"about time my book reached its culmination! Or... its finale...\""
msgstr ""
"{n}당신의 동료들과 보좌관들이 숨소리 하나 없이 왕좌 주변으로 모여들었습니다. 린지가 처음으로 말했습니다.{/n}\"제 "
"생각에는...생각에는....이제 제 책이 그 절정부분에 다다른 것 같아요! 아니면 그 대단원이요...\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0004_Text
#. Speaker : Capital_NereidEvindra
msgctxt "835c31db-b007-4205-8c0b-edc185cfa1c0"
msgid ""
"\"It is a time of great woe — but of great hope as well. The path to the {g|"
"First World}First World{/g} is open. This is your chance to reach my fallen "
"sister and settle your dispute over the {g|Stolen Lands}Stolen Lands{/g} "
"once and for all.\""
msgstr ""
"\"큰 슬픔의 시간입니다만 큰 희망의 시간이기도 합니다. {g|First World}태초 세계{/g}로의 길이 열렸습니다. 이것은 저의 "
"타락한 누이에게 가서 {g|Stolen Lands}도둑맞은 땅{/g}에 대한 당신의 논란을 단번에 해결할 기회입니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0005_Text
#. Speaker : Regongar_Companion
msgctxt "13328cfd-f3f4-4090-88ad-1dbface134b1"
msgid ""
"\"Nyrissa, huh? I've been itching to tear the petals off that flower for "
"quite a while!\""
msgstr "\"나이리사라, 허? 한동안 꽃에서 꽃잎을 뜯어내지 못해서 근질거렸는데 말이지!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0006_Text
#. Speaker : Valerie_Companion
msgctxt "a25e5c31-3a15-4ffb-a9bb-86c2cb24bd0a"
msgid ""
"\"A ruler's duty is to end their kingdom's afflictions. And our duty is to "
"follow you, {name}.\""
msgstr "\"지배자의 의무는 그의 왕국의 고통을 끝내는 것입니다. 그리고 우리의 의무는 당신을 따르는 것입니다, {name}.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0007_Text
#. Speaker : Jubilost_Companion
msgctxt "619623d1-ce31-4623-8054-e13ba00cb644"
msgid ""
"\"Seems we have a promising expedition to the depths of the {g|First World}"
"First World{/g} ahead of us. If in the course of our research we render a "
"dozen monsters and one particularly annoying nymph to compost — all the "
"better.\""
msgstr ""
"\"우리에게 눈 앞에 있는 {g|First World}태초 세계{/g}의 깊숙한 곳까지 도달할 장래가 유망한 탐험대가 있는것 같군. 우리 "
"연구 과정 중에 수십 마리의 괴물들과 특별히 짜증나는 님프 한 명을 자양분으로 삼는다면 그보다 좋을 수 없겠지.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0008_Text
#. Speaker : Tristian_Companion
msgctxt "f1fb4b98-0e88-4592-bbc6-325bbd0ee2dd"
msgid ""
"\"I've helped Nyrissa move between planes and portals long enough to assume "
"there must be a door in the {g|Thousand Voices Forest}Thousand Voices{/g} "
"that leads to her own demesne in the {g|First World}First World{/g}.\""
msgstr ""
"\"저는 오랫동안 나이리사가 차원과 포탈 사이를 이동하도록 도왔습니다, 그 경험으로 추측하면, {g|First World}태초 세계{/g}"
"에 있는 그녀의 영역까지 이어지는 문이 {g|Thousand Voices Forest}천 개의 목소리{/g}에 있을거라 생각합니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0009_Text
#. Speaker : Tristian_Companion
msgctxt "fb8d54dd-d18b-4d6a-9038-bdaf55d6a03b"
msgid ""
"\"The time has come to end the thousand-year reign of evil over the {g|"
"Stolen Lands}Stolen Lands{/g}. And I as much as anyone wish to help — and "
"hopefully help repay my debts in the process.\""
msgstr ""
"\"{g|Stolen Lands}도둑맞은 땅{/g}에서 천 년에 걸친 악의 지배를 끝낼 때가 왔습니다. 그리고 저는 누구라도 도울 "
"것입니다 — 그 과정이 제 업보를 갚는 데 도움이 되면 좋겠군요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0010_Text
#. Speaker : Octavia_Companion
msgctxt "86291fe4-dec9-4a89-a90d-bf99087797cc"
msgid ""
"\"It's all in our hands now! The threat may be great, but you've been "
"fighting Nyrissa for a long time now, {name}. You have the best chance of "
"stopping her once and for all.\""
msgstr ""
"\"이제 다 우리 손에 달렸어! 엄청 위험하겠지만, 나이리사와 참 오래도 싸워왔잖아, {name}. 그녀를 막을 최고의 기회를 잡은 거야."
"\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0011_Text
#. Speaker : Jaethal_Companion
msgctxt "9f2ab291-2da7-4374-afc3-88e242bbd15e"
msgid ""
"\"Nyrissa is an interesting foe — powerful, beautiful, and unburdened by "
"boring principles or morals. I can't wait to wade through her blooming "
"meadows with a scythe.\""
msgstr ""
"\"나이리사는 흥미로운 적이야. 강하고, 아름답고, 지루한 원칙이나 도덕 따위에 얽매이지도 않지. 그 여자의 꽃피는 초원을 이 낫으로 "
"훑어 버리고 싶어서 참을 수가 없군.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0012_Text
#. Speaker : Amiri_Companion
msgctxt "91e0ebdd-ea7d-4a7e-86fa-c92a84e496e3"
msgid ""
"\"Yes! That green creep's hunted us for too long — time to trade places.\""
msgstr "\"좋아! 그 녹색 창녀는 우릴 너무 오랫동안 쫓았지, 이제 우리가 쫓을 시간이야.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0013_Text
#. Speaker : Harrim_Companion
msgctxt "740f8090-ed27-47f0-ba91-9c33a75aa15f"
msgid "\"The end times near. My heart rejoices.\""
msgstr "\"마지막 때가 왔도다. 내 심장이 기쁨으로 가득차는구나.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0014_Text
#. Speaker : Ekun_Companion
msgctxt "7af253f7-ffdc-44e1-8f3a-bbae1fff5e94"
msgid ""
"\"Trouble at the gates of peaceful villages. I hear the cries of children, "
"prayers for help, as though there were right here.\""
msgstr "\"평화로운 마을 입구에서의 문제다. 아이들의 울음소리, 도움을 구하는 기도가 들린다, 바로 여기 있는 것처럼.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0015_Text
#. Speaker : NokNok_Companion
msgctxt "e1ad1fb2-2833-4f50-96b6-c21f2afe2ff8"
msgid ""
"\"Linzi again with her big bag of words — and as helpful as ever. I know "
"what to do — go kick that green witch's ass! Bam! She's gone, and we're "
"heroes!\""
msgstr ""
"\"린지는 다시 그 큰 말주머니 — 언제나처럼 도움이 되지 — 와 함께다. 난 뭘 해야 할지 알아. 가서 그 초록색 마녀의 엉덩이를 "
"걷어차! 빵! 그녀는 사라지고, 우리가 영웅이다!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0016_Text
msgctxt "85e9d519-0f73-4c75-8406-94bd9d0cb373"
msgid ""
"\"Messengers have arrived from... well... all over the kingdom, really! The "
"Bloom has started everywhere. Monsters have appeared in every forest, behind "
"every corner, in every nook and cranny! What we went through before was like "
"a bed of roses compared to this. If we don't do something, the kingdom will "
"simply... collapse.\""
msgstr ""
"\"전령들이 도착했습니다... 음... 온 왕국에서요, 정말로! 개화가 어디서나 일어납니다. 모든 숲, 모든 모퉁이, 모든 구석에서 "
"괴물들이 나타났어요! 우리가 전에 겪었던 일은 이거에 비하면 장밋빛 침대 같았죠. 우리가 뭔가를 하지 않으면 왕국은 그냥... 무너져 "
"버릴 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0017_Text
msgctxt "c1c79b02-8d7e-4b9c-988b-2a296ffec2c5"
msgid ""
"\"We learned a lot about Nyrissa while traveling through her dreams. I think "
"she's almost done gathering grains of dust for her damn cup. "
"{g|Pitax}Pitax{/g} has fallen, and your kingdom is the last thing standing "
"in the way of her 'Apology.' She's done waiting. We need to do something — "
"and fast! I think... I think we need to head out on our most heroic campaign "
"yet. We talked it over, and it seems like our best chance to reach Nyrissa "
"is through the {g|Thousand Voices region}Thousand Voices{/g}, on the western "
"border of Pitax. It's been completely overtaken by the Bloom, and it seems "
"to be the place where the {g|First World}First World{/g} is currently the "
"closest to ours!\""
msgstr ""
"\"우리는 나이리사의 꿈을 통해 여행을 하면서 나이리사에 대해 많은 것을 배웠어요. 제 생각에 그녀가 그 망할 잔을 위한 먼지 알갱이들을 "
"다 모은 것 같아요. {g|Pitax}피탁스{/g}가 몰락했고, 당신의 왕국은 그녀의 '사죄'를 가로막는 마지막 존재죠. 그녀는 이제 더 "
"이상 기다리지 않을 거예요. 우리는 무언가를 해야 해요. 빠르게! 제 생각엔... 우리가 이제까지 없었던 영웅적인 모험을 시작할 때인 것 "
"같아요. 우린 그에 대한 논의를 했지만, 나이리사에게 도달할 수 있는 가장 좋은 길은 피탁스 서쪽 국경에 있는 {g|Thousand "
"Voices region}천 개의 목소리{/g}인 것 같아요. 개화에 완전히 덮여버렸고, 현재 {g|First World}태초 세계{/g}"
"에 가장 가까운 지점 같으니까요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0025_Text
msgctxt "c77a3e58-ac2d-4cb7-916b-8517e74973e3"
msgid ""
"\"One thing is clear — it won't be easy! Not for us, or for the kingdom. "
"I... hope something's left to celebrate our... heroic return to...\" {n}"
"Linzi hides a sniffle by pretending to rub her nose.{/n}"
msgstr ""
"\"한 가지는 확실해요. 쉽지 않을 거란거죠! 우리뿐만 아니라 왕국에도요. 저는...우리의...영웅적인 귀환을 위해...무언가 기념할 "
"만한 걸...남겼으면...\"{n}린지는 코를 비비는 시늉으로 훌쩍거리는 것을 감추었습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0026_Text
#. Speaker : Capital_NereidEvindra
msgctxt "f89692fe-5bc9-4068-b970-3c475b0f52b0"
msgid ""
"\"Many beasts serve Nyrissa — and you would be hard-pressed to find more "
"dangerous ones. She has even created some semblance of one of the Tane, the "
"{g|Eldest}Eldest's{/g} chained beasts. You must prepare to meet all these "
"monsters along your way, either in the {g|Thousand Voices region}Thousand "
"Voices{/g}, or in the {g|First World}First World{/g}, should we make it "
"there.\""
msgstr ""
"\"많은 야수들이 나이리사를 섬깁니다. 그것들보다 위험한 것을 찾는 것은 힘들지요. 그녀는 심지어 {g|Eldest}원로{/g}들의 "
"목줄걸린 짐승인 테인 가운데 하나와 유사한 것을 만들기도 했습니다. 당신의 여정 전체에 걸쳐 이 모든 괴물들에 대해 단단히 채비 해야만 "
"합니다. {g|Thousand Voices region}천 개의 목소리{/g}에서만이 아니라, 우리가 갈 수 있다면 {g|First "
"World}태초 세계{/g}에서도요.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0028_Text
#. Speaker : Capital_NereidEvindra
msgctxt "f2f6f7b1-e2ad-46a2-a314-3a5a111194fe"
msgid ""
"{n}The nereid closes her eyes and sighs softly.{/n} \"Yes. Of course. My "
"duty now is to fight the evil that has enslaved Nyrissa. But I will not be "
"traveling in the typical way with you. You are aware that creatures of the "
"{g|First World}First World{/g} return to life in their homeland if they die "
"somewhere the Bloom is especially strong, yes? I'll find such a place and... "
"end my life there, thus returning to the First World. I will meet you there. "
"This way, I'll be able to bypass the portal guards, learn more of Nyrissa's "
"plans, make preparations. Death is not a pleasant prospect, and it will take "
"much of my strength... but it could give us a significant advantage. Take "
"care. And wish me luck.\""
msgstr ""
"{n}네레이드는 눈을 감고 부드럽게 한숨을 쉽니다.{/n} \"그래. 물론이야. 지금 내 임무는 나이리사를 노예로 만든 악과 싸우는 "
"거야. 하지만 나는 함께 흔한 길을 여행하진 않을 거야. {g|First World}태초 세계{/g}의 생명체들이 개화가 특히 강한 "
"어딘가에서 죽으면 고향에서 다시 살아난다는 사실을 알지? 그런 곳을 찾아서... 거기서 죽으면 난 태초세계로 돌아가는 거지. 거기서 "
"만나자. 이렇게 하면 포탈의 수문장들을 우회할 수 있고, 나이리사의 계획을 더 자세히 알아내서 준비도 할 수 있을 거야. 죽음은 즐거운 "
"일도 아니고, 내 힘도 많이 뺏어가겠지... 하지만 우리에게 중요한 이점을 줄 수 있어. 몸 조심해, 그리고 행운을 빌어줘.\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0030_Text
msgctxt "183e04d6-4f3f-4a28-bea5-136b5c8b3a8a"
msgid ""
"\"We'll be fine! We'll return and throw a huge feast — and we'll celebrate "
"for a whole month, and then another month, and then on the next month, we'll "
"just do nothing but rest! I'll finish my book, and they'll read it all "
"across {g|Golarion}Golarion{/g}, and... and... {n}Linzi gestures vaguely.{/n}"
" \"I don't know what then, but it'll be even better!\""
msgstr ""
"\"우린 괜찮을 거예요! 우린 돌아와서 잔치를 열겠죠. 그리고 한 달 내내 축하하고, 한 달 더 축하하고, 다음 달에는 그냥 쭉 쉬는 "
"거죠! 내 책을 다 쓰고, {g|Golarion}골라리온{/g}의 모두가 그 책을 보고, 그리고... 그리고... {n}린지는 애매한 "
"제스처를 취합니다.{/n} \"그러면 어떨지 모르지만, 아무튼 더 좋을 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0031_Text
#. Speaker : Kanerah_Companion
msgctxt "9f152f6b-080d-4a04-8998-63a1592a8094"
msgid ""
"\"Everyone's so serious! Pff! Let me put it simply – we need to do some "
"housekeeping. Cut some lawns, burn some fallen leaves – and get rid of some "
"vermin. Ha ha!\""
msgstr ""
"\"모두 너무 심각하군! 풋! 내가 간단히 해주지. 집안일을 좀 하는 것뿐이야. 잔디를 잘라내고, 떨어진 낙엽들을 태우고, 그리고 "
"해충새끼들을 좀 제거하는 거지. 하하!\""

#. Mechanics/Blueprints/World/Dialogs/KingdomTurns/ktc61-LinziAndAll-BloomInvasion/Cue_0032_Text
#. Speaker : Kalikke_Companion
msgctxt "6d0f35cd-aa25-4231-a80a-deb85812c1fd"
msgid ""
"\"I always thought that evil was ugly and cold. And yet right in front of "
"me, the incredible beauty of the First World is bringing chaos and death to "
"our peaceful lands. Well, we'll stand in its way and hold it back, whatever "
"it takes.\""
msgstr ""
"\"난 항상 악당이 추하고 존재감이 없는 사람일 거라 생각했어. 그런데 바로 눈앞에서, 믿기 어려울 정도로 아름다운 태초 세계 미의 "
"화신이 평화로운 땅에 혼돈과 죽음을 가져온 거야. 뭐, 어떤 대가를 치르더라도 막긴 해야겠지.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/1DLC_Kaessi/Answer_0003_Text
msgctxt "f93f07f4-03c6-42f2-9527-af31259545a0"
msgid "\"I don't think we've met...\""
msgstr "\"우리는 초면인데...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/1DLC_Kaessi/Answer_0004_Text
msgctxt "dfc2b2f8-e0bf-4ec1-9be5-24d12e69effb"
msgid "\"There are assassins on the prowl. We have to go!\""
msgstr "\"암살자가 있다. 어서 가야 해!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/1DLC_Kaessi/Answer_0006_Text
msgctxt "27b19d77-75e6-4d2c-bc72-b5e50e6c36a1"
msgid "\"You sound like a Keleshite. Am I right?\""
msgstr "\"칼레쉬인처럼 말하는군. 내가 맞지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/1DLC_Kaessi/Barks/1DLC_Kaessi_YardBark2_String
msgctxt "754f0463-ea2d-4fcc-b5c2-724b935a332b"
msgid ""
"\"More corpses on the floor here! It's not easy to wash out blood, you "
"know...\""
msgstr "\"바닥에 더 많은 시체가 널부러져있어! 피를 씻어내기는 어려운데...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/1DLC_Kaessi/Barks/1DLC_Linzi_WhereBark_String
msgctxt "1f21f1dd-ef1e-461d-a5c4-85f2a90612d2"
msgid "\"And where is Kaessi? She was supposed to wait for us here!\""
msgstr "\"카에시는 어디에 있어? 우리를 여기서 기다린다고 했는데!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/1DLC_Kaessi/Cue_0001_Text
#. Speaker : Kanerah_Capital_prologue
msgctxt "0257d6ef-f5a8-4ab8-bd28-ed100d2c856a"
msgid ""
"\"Ha! Everything is so much more fun with a little fire!\" {n}The tiefling "
"girl you saw at the reception before the attack stops nearby and waves her "
"tail with excitement.{/n} \"What a night, huh? I thought I was all alone. "
"It's good you're here – it's a bit boring, chasing fool assassins without "
"anyone watching the show...\""
msgstr ""
"\"불이 붙으니 더 재밌어지는군!\" {n}연회장에서 봤던 티플링 소녀가 공격을 멈추고 신나는 듯 꼬리를 흔듭니다.{/n} \"좋은 "
"밤이지? 살아남은 모험가는 나밖에 없는줄 알았는데, 네가 있어서 참 다행이야. 나 좀 심심해... 바보같은 암살자들을 쫓느라 내 불쇼는 "
"안중에도 없나봐...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/1DLC_Kaessi/Cue_0005_Text
#. Speaker : Kanerah_Capital_prologue
msgctxt "9cd80764-1f17-493c-a3f1-be4d81c4c12d"
msgid ""
"{n}The girl gives you a mocking half-bow.{/n} \"I am Kaessi. One of the many "
"here who seek a better fate, answering the call of Lady Jamandi. But unlike "
"the others I never drop my guard, day or night. It's why I'm still alive.\""
msgstr ""
"{n}소녀는 당신에게 조롱하듯 인사합니다.{/n} \"나는 카에시야. 자만디의 부름으로 더 나은 운명을 찾기 위해 왔지. 하지만 나는 "
"다른 녀석들과 달리 경계를 풀지 않아. 그래서 여태 살아있는 거지.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/1DLC_Kaessi/Cue_0007_Text
#. Speaker : Kanerah_Capital_prologue
msgctxt "9f64bd11-b174-4fbb-8e9c-c7953537ecbd"
msgid ""
"\"Of course. I'm from {g|Qadira}Qadira{/g}. But tales of hot deserts and "
"shady oases can wait until the fighting is finished. But if you'd like to "
"share a dinner and pleasant conversation, just say the word... I like making "
"new friends!\""
msgstr ""
"\"물론. 나는 {g|Qadira}카디라{/g} 출신이야. 고향의 뜨거운 사막과 시원한 오아시스 이야기는 싸움이 끝나면 하자고. 나와 "
"저녁 식사를 하며 재밌는 얘기를 하고 싶다면 말만 하라구... 나는 새 친구 사귀는 게 좋으니까!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/1DLC_Kaessi/Cue_0008_Text
#. Speaker : Kanerah_Capital_prologue
msgctxt "7a656e4d-3652-4b55-b19c-9f377e2eadbd"
msgid ""
"\"I don't know where you're heading, but I'll be at the entrance to the main "
"hall. I think I saw some guards there. Join me there if you wish!\" {n}The "
"tiefling salutes you and runs ahead nimbly.{/n}"
msgstr ""
"\"네가 어디로 향하는지 모르겠지만 나는 연회장 입구에 있을게. 저기서 경비를 본 것 같아. 거기서 봐!\" {n}티플링은 당신에게 작별 "
"인사를 하고 민첩하게 달려나갑니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/1DLC_Kaessi/Cue_0009_Text
#. Speaker : Linzi_Companion
msgctxt "314f8b5e-9b6a-4724-b81b-508a73e1163c"
msgid "\"It's not fun at all! Many people have died for nothing...\""
msgstr "\"하나도 재미 없어요! 많은 사람들이 허무하게 죽었다구요...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/1DLC_Kaessi/Cue_0010_Text
#. Speaker : Kanerah_Capital_prologue
msgctxt "e091b999-19c2-4494-9583-6218d640165d"
msgid "\"Pf-f-f!\""
msgstr "\"흥!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/AmiriDialog_1/Cue_0002_Text
#. Speaker : Amiri_Neutral
msgctxt "53afc539-2822-411c-a2b2-4fe0735cc438"
msgid ""
"{n}The barbarian's face is distorted with rage. She grinds her teeth, and "
"sweat drips from her forehead. Noticing Tartuccio, she swings her sword but "
"stops it just in time.{/n} \"Oh, it's you. Stay out from under my feet, or "
"I'll strike you down!\""
msgstr ""
"{n}야만인의 얼굴은 분노로 일그러져있습니다. 그녀는 이를 갈고 이마에는 땀이 맺혔습니다. 타투치오를 보자 그녀는 검을 휘두르지만 이내 "
"멈춥니다.{/n} \"아. 네놈이냐. 다치기 싫으면 내 발치에서 얼쩡거리지 마!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/AmiriDialog_1/Cue_0003_Text
#. Speaker : Amiri_Neutral
msgctxt "e8b29d12-55a6-4238-98ec-c6b3d7d41a0c"
msgid ""
"{n}Amiri takes a deep breath, then barks out,{/n} \"Blood for "
"{g|Gorum}Gorum{/g}!\" {n}Swinging her bloody sword, she runs toward the "
"sound of battle.{/n}"
msgstr ""
"{n}아미리는 심호흡을 한 다음 소리를 지릅니다.{/n} \"{g|Gorum}고룸{/g}을 위하여!\"{n}그녀는 피묻은 검을 휘두르며 "
"뛰쳐나갔습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/AmiriDialog_1/Cue_0004_Text
#. Speaker : Tartuccio_Companion
msgctxt "1ee7432a-2c99-4a63-8965-34bbeaf22348"
msgid "\"Barbarians...\""
msgstr "\"하여튼 바바리안들이란...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/AmiriDialog_1/Cue_0005_Text
#. Speaker : Linzi_Companion
msgctxt "8bbd8908-e0ff-4eaf-b0c6-eb4f252a01d3"
msgid "\"I think that's exactly how heroes should be!\""
msgstr "\"저게 바로 영웅의 표본이죠!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/AmiriDialog_1/Cue_0006_Text
#. Speaker : Tartuccio_Companion
msgctxt "cf39c006-b41d-491f-81b7-df0c1e170835"
msgid ""
"\"What? Stupid, sweaty, and always looking for something to gobble up or lop "
"the head off of? {g|Calistria}Calistria{/g} save me from such 'heroes'!\""
msgstr ""
"\"뭐라고? 멍청하고, 땀냄새나고, 항상 우걱우걱 쳐먹어대는 녀석들이? {g|Calistria}칼리스트리아{/g}시여, 그런 "
"'영웅들'로부터 저를 지켜주시길!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Amiri_fighting_1_String
msgctxt "ee119358-243d-448b-86b5-9fb38cf5578d"
msgid "\"Blood for Gorum!\""
msgstr "\"고룸에게 피를!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Amiri_fighting_2_String
msgctxt "9536f730-daea-4c07-b601-79820e619bc7"
msgid "\"It's the end for you rats!\""
msgstr "\"쥐새끼들. 이걸로 끝이다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Assassin_in_room_String
msgctxt "0158eb90-dcd3-4c5d-9c58-7cdb77c3727e"
msgid "\"You're not going anywhere!\""
msgstr "\"넌 못 도망친다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Assassins_Tartuccio_0-Linzi_String
msgctxt "abe6e997-cba8-4117-a880-5c3dea113a45"
msgid "\"They got someone! We have to help!\""
msgstr "\"누가 붙잡혔어요! 우리가 도와줘야만 해요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Assassins_Tartuccio_1_String
msgctxt "37962967-c5fa-4472-875f-3a14113b730e"
msgid "\"Look, they're running! Get them!\""
msgstr "\"저기 도망치는 녀석들이 있다! 잡아!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Assassins_Tartuccio_2_String
msgctxt "918f6498-2988-4afd-8420-0840238cba82"
msgid "\"And what shall I do with this one?\""
msgstr "\"이 녀석은 어떻게 하지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Assassins_Tartuccio_3_String
msgctxt "0a6ec4d8-6b1f-48fe-b4af-2918b5fd1ebf"
msgid "\"We'll finish him later. He won't get away!\""
msgstr "\"나중에 처리해. 어차피 도망도 못 갈테니까!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Dead_Reactions/Linzi_1_String
msgctxt "74ebefe7-91fe-4304-87e1-b12e62a8eb10"
msgid "\"I can't believe it! That could have been us!\""
msgstr "\"믿을 수 없어! 우리도 이렇게 될 수 있다니!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Dead_Reactions/Linzi_2_String
msgctxt "05759997-d80e-4543-8fee-e246afef00ca"
msgid "\"Oh, no... Is everyone dead?\""
msgstr "\"오. 안돼... 모두 죽은거야?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Dead_Reactions/Tartuccio_1_String
msgctxt "475d3b43-2ed3-4d50-8293-b07b5d4fb1c3"
msgid "\"Well, their adventures have certainly come to an end!\""
msgstr "\"녀석들의 모험도 분명 끝나긴 했군.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Dead_Reactions/Tartuccio_2_String
msgctxt "29c4195e-9972-419d-8769-68c3fef2540f"
msgid ""
"\"Pathetic. They couldn't even defend themselves, but they thought they "
"could conquer the Stolen Lands?\""
msgstr "\"한심한 녀석들. 자신을 지킬 힘조차 없는 주제에 도둑맞은 땅을 정복하려 했다니.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Door_blocked_String
msgctxt "90044051-578f-48ab-a50e-1befaaad1424"
msgid "The door is blocked from the other side."
msgstr "문이 다른 쪽에서 차단되었습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Final_Battle/1_Assassin_leader_String
msgctxt "1d0b3b69-1245-4e5f-b8dc-76cfa05a4a89"
msgid "\"Don't let them through! Jamandi dies tonight!\""
msgstr "\"저놈들 막아! 오늘 자만디는 죽을 것이다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Final_Battle/2_Evil_mages_String
msgctxt "a27ef0cb-685b-4d54-a2d9-ec54e6c0203d"
msgid "\"She's not going anywhere!\""
msgstr "\"그녀는 아무데도 가지 않을 거다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Final_Battle/3_Jamandi_String
msgctxt "fd79b896-63c8-4652-985d-f4dfd00886bd"
msgid "\"Reinforcements are already on the way! Say your prayers, scum!\""
msgstr "\"원군은 이미 오고 있다! 기도나 해라. 쓰레기야!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Final_Battle/Idle_Amiri_String
msgctxt "601f4dc7-40c6-48d6-bc7b-02773a856813"
msgid ""
"\"Not even departed, and we already won our first battle! Seems like a good "
"omen, right?\""
msgstr "\"출발도 안했는데 벌써 첫 번째 전투에서 이겼군! 느낌이 좋네. 그렇지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Final_Battle/Idle_Ezvanki_String
msgctxt "b57020ce-2a43-4cbd-af25-a0d214d08cd8"
msgid ""
"\"An unheard-of atrocity! Mark my words: we'll find out who was behind it!\""
msgstr "\"전례가 없는 잔학행위군요! 배후에 누가 있는지 기필코 밝혀내도록 하겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Final_Battle/Victory_Amiri_String
msgctxt "b5f7f91e-0f09-443d-af91-0e3f09fc57a9"
msgid "\"In your faces, jerks!\""
msgstr "\"꼴 좋다. 멍청아!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Final_Battle/Victory_Ezvanki_String
msgctxt "57ec1fc8-b041-4dd5-b519-686d1fd5c6d9"
msgid "\"Praised be Erastil, we made it!\""
msgstr "\"에라스틸이시여 감사합니다. 우리가 해냈습니다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Final_Battle/Victory_Jamandi_String
msgctxt "e566ec56-02bf-4c8a-8ee3-e55b2f6a6f10"
msgid "\"That's it. Time to count our losses, I suppose.\""
msgstr "\"맞습니다. 이제 피해를 살펴야겠군요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Harrim_Whine_String
msgctxt "14de2466-c31c-4907-9fca-1e884cc56337"
msgid "\"This is it. My time has come... Oh, Groetus, take my soul...\""
msgstr "\"이제 끝이군. 내 시간이 왔어... 오. 그로투스시여. 제 영혼을 가져 가십시오...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/KeyBark_String_1
msgctxt "d0dcf054-27ec-46ca-bde1-6c72f54e26c8"
msgid "The door is securely locked. It cannot be opened without a key."
msgstr "문이 단단히 잠겼습니다. 열쇠 없이는 열 수 없습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Killers_Idle_1_String
msgctxt "13701f98-f22e-46a4-bdbc-43a33160d186"
msgid "\"Is everyone taken care of?\""
msgstr "\"모두 괜찮은건가?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Killers_Idle_2_String
msgctxt "61034822-5bfc-4b40-b627-9d42e100a4a5"
msgid "\"There are more here. Look sharp — no one escapes!\""
msgstr "\"여기에 더 많은 것이 있다. 날카로운 것 봐라. 아무도 도망 칠 수 없어!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Killers_Idle_3_String
msgctxt "df6d052f-8169-402a-a177-3bf24d8f6a7d"
msgid "\"They won't get away from us! Cut them down like sheep!\""
msgstr "\"그들은 우리에게서 떠나지 도망치지 못할 것이다! 양처럼 베어 버려라.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Linzi_in_room_String
msgctxt "3eb19eab-b0b7-4255-9cd1-644ad5721e09"
msgid "\"The assassins are already here! Follow me, quickly!\""
msgstr "\"벌써 암살자들이 여기까지! 빨리 따라오세요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Map_Table_String
msgctxt "64969f9d-b720-4109-9123-49761ed3a0a9"
msgid ""
"A large map of Brevoy and its surroundings, dotted with numerous cryptic "
"marks and notes."
msgstr "브레보이와 그 주변을 그린 커다란 지도. 수많은 숨겨진 표식과 노트가 그려져 있습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Money_stolen_Linzi_String
msgctxt "90e17710-90f9-4142-8d68-3d24e1cd1755"
msgid "\"Don't you think we have enough trouble already?\""
msgstr "\"이미 문제는 충분하다고 생각하지 않나요?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Money_stolen_Tartuccio_String
msgctxt "6b7fb22f-5216-4860-a1fc-7977a123df16"
msgid "\"This'll teach those slovenly guards not to slack off on the job!\""
msgstr "\"이건 경솔한 경비병이 게으름을 피우지 말라는 교훈을 줄 거야.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Monster_Kills/1_Guards_String
msgctxt "940fa42d-2a7e-44ed-9e7f-933aac03df9b"
msgid "\"There they are! The assassins!\""
msgstr "\"암살자들이 저기 있다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Monster_Kills/2_Guards_String
msgctxt "8aa3464b-fd85-4c93-bb1f-6bcf9baf236f"
msgid ""
"\"This is your last chance — drop your weapons, and we'll spare your lives!\""
msgstr "\"마지막 기회다. 무기를 버리면 목숨만은 살려주마!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Monster_Kills/3_AssassinLeader_String
msgctxt "3b84a9e7-545b-4635-a6e2-867f5e822350"
msgid ""
"\"So generous! I'm afraid I can't offer you the same courtesy. Hey, you ugly "
"mug! Get them!\""
msgstr "\"참으로 자비롭군! 미안하지만 우리는 자비롭지 못해서. 어이, 못생긴 녀석아! 저놈들을 죽여!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Monster_Kills/4_Guards_String
msgctxt "e2fd8969-a2fb-4978-9f4d-7714c165bf94"
msgid "\"What in Hell's name is that?!\""
msgstr "\"저게 대체 뭐야?!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/No_way_1_String
msgctxt "ba39204d-2b63-46b1-8348-b43c5963cc28"
msgid "The door is blocked from the inside."
msgstr "문이 안쪽에서 막혔습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/No_way_2_String
msgctxt "2853386b-2cc5-47ec-a854-0c7c9c4013a6"
msgid "The passage is blocked. You can't make it through this way!"
msgstr "통로가 막혔습니다. 이 길로는 지나갈 수 없습니다!"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/No_way_3_String
msgctxt "6a0378d2-60a2-42e5-bcbf-d6858093f299"
msgid "The heavy grate is securely locked."
msgstr "무거운 화격자는 단단히 잠겨 있습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Saved_guard_1_String
msgctxt "37329fe5-32e8-426e-97b5-9f1dd2cda759"
msgid "\"Thank you, Valerie. I owe you my life!\""
msgstr "\"고마워. 발레리. 네게 목숨을 빚졌어!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Saved_guard_2_String
msgctxt "e4b22d96-689f-4346-862a-5f97620ed18d"
msgid "\"Cough, cough! I thought I was a goner...\""
msgstr "\"콜록! 콜록! 괴로워...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Saved_guard_3_String
msgctxt "795ff996-3de0-4dba-a53d-7065de84a319"
msgid "\"If I ever get my hands on that arsonist...\""
msgstr "\"방화범을 잡을 수 있다면...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Barks/Tartuccio_arsenal_String
msgctxt "ce819535-8560-4177-8048-2ffa6cd2ca71"
msgid ""
"\"An armory! I'm sure Jamandi wouldn't mind if we borrowed some weapons!\""
msgstr "\"병기고군! 우리가 무기를 좀 빌려도 자만디는 신경 안 쓸 거야!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Answer_0004_Text
msgctxt "803ba407-db2b-4ff1-b830-e986019b28b1"
msgid "...covered our noses and mouths before we rushed inside!"
msgstr "...안으로 뛰어들기 전에 우리의 코와 입을 가렸습니다!"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Answer_0007_Text
msgctxt "d56037bc-a6e6-4185-8170-f41d7c8c6677"
msgid "...rushed to save the guards from the fire!"
msgstr "...불 속에서 경비병들을 구하려고 서둘렀습니다!"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Answer_0008_Text
msgctxt "c460f36f-72ff-4919-a052-5f8d08d946e3"
msgid ""
"...shouted to Valerie that she should leave them and join us to help Jamandi "
"Aldori."
msgstr "...그들을 내버려 두고 자만디 알도리를 도우러 가자고 발레리에게 소리쳤습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Answer_0012_Text
msgctxt "669e3591-41bc-4123-a83a-d8939e8828e6"
msgid "Close."
msgstr "닫기."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Answer_0014_Text
msgctxt "9a09166d-d76c-4782-b3b6-5cac6ca80b84"
msgid "Close."
msgstr "닫기."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Answer_0016_Text
msgctxt "dc557c15-3064-4012-b21a-1c63e74071d1"
msgid "...tried to find a less dangerous passage."
msgstr "...덜 위험한 통로를 찾으려고 노력했습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Answer_0017_Text
msgctxt "29d9e695-7331-49ed-81c2-3ba12cd75ac4"
msgid "...drenched ourselves with buckets of water."
msgstr "...양동이에 든 물로 몸을 흠뻑 적셨습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Answer_0038_Text
msgctxt "da8bd2d9-73dc-4803-a5df-b25ecad46794"
msgid "Continue."
msgstr "계속하기."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Answer_0040_Text
msgctxt "db88b6bd-250b-4081-b9d0-cffc96eff0ca"
msgid ""
"...we darted away from the wall, attempting to avoid the flaming debris."
msgstr "...우리는 불타는 잔해를 피하려고 벽에서 도망쳤습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Answer_0041_Text
msgctxt "b36477d3-5667-4a9d-96e5-a530e2e7b11b"
msgid ""
"...one of us pressed up against the wall, trying to hold it up just a bit "
"longer."
msgstr "...우리 중 한 명이 벽을 밀어서 조금 더 오랫동안 버티려고 했습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Answer_0042_Text
msgctxt "038cd5fa-0813-42ed-a7e9-eecbfe9c17db"
msgid ""
"...we ran forward, hoping to make it under the wall before everything "
"crashed down."
msgstr "...모든 게 무너지기 전에 통과하길 바라면서 앞으로 달려갔습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Answer_0046_Text
msgctxt "42b540dc-7a85-4632-a97f-d9418e6611dc"
msgid ""
"...one of us heroically pushed the others forward, taking the weight of the "
"blow themselves!"
msgstr "...우리 중 한 명이 영웅적으로 다른 사람들을 앞으로 밀쳤고, 쓰러지는 벽의 충격을 혼자 떠맡았습니다!"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Answer_0055_Text
msgctxt "7e072518-bd10-451c-8f9d-a0e22f59f566"
msgid "Continue."
msgstr "계속하기."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0003_Text
msgctxt "e4bc588a-6b1c-4068-9e93-02a1c2cd6c92"
msgid ""
"And so our adventure started — earlier and much more tragic than we'd "
"expected! The whole team who'd gathered in the hall yesterday had been "
"reduced to but a handful of brave souls, led by {Name} (and not at all by "
"that scoundrel Tartuccio, no matter what he might have imagined of himself!)"
". Jamandi Aldori was waiting for us, but to get to her, we'd have to march "
"through fire — literally! As we approached the burning building, we..."
msgstr ""
"그리고 우리의 모험은 시작되었습니다. 우리가 예상했던 것보다 훨씬 더 일찍, 훨씬 더 비극적이었습니다! 어제 홀에 모였던 팀 전체에서 좀 "
"줄었지만 몇몇 용감한 영혼을 가진 이들이 {Name}의 지휘 아래에서 움직였습니다. (그 악당 타투치오는 결코 용감한 영혼을 가지지 "
"않았어요! 그가 혼자 뭐라고 생각하던 말이죠!) 자만디 알도리는 우리를 기다리고 있었지만 그녀에게 가기 위해서는 말 그대로 불 속으로 "
"행진 해야만 했습니다! 우리가 불타고 있는 건물에 다다랐을 때 우리는..."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0006_Text
msgctxt "cdfd6408-cf18-47b2-b08a-90181dd5777f"
msgid ""
"The hot air burned our lungs, and our eyes watered from the smoke, but {Name}"
" led us stubbornly through the flames (while Tartuccio did nothing useful at "
"all!). We'd made it to the hallway leading to the banquet hall when we heard "
"someone calling for us — it was Valerie, one of the guards I'd chatted with "
"a bit in the banquet hall. Even then, in that calm setting, I'd been stunned "
"by her beauty. But now, amid the smoke and flame, she looked like a "
"celestial avenger — an armored deity, menacing but beautiful and merciful, "
"descending from the higher spheres to help us poor mortals. She held a "
"burned, barely living guard in her arms. \"There are two more!\" she shouted "
"as she passed by us. \"They are wounded! Help me pull them out!\" Tartuccio "
"grumbled something about how Jamandi was waiting for us. Meanwhile, {Name}..."
msgstr ""
"뜨거운 공기가 우리의 폐를 태우고, 우리의 눈은 연기로 인해 눈물이 계속 나왔습니다. {Name}의 노력으로 우리는 (타투치오는 전혀 "
"쓸모가 없었지만!) 불꽃을 뚫으면서 완강하게 뚫으며 나아갔습니다. 연회장으로 통하는 복도로 지나던 도중 누군가 우리를 부르는 소리를 "
"들었습니다. 그 정체는 연회장에서 조금 전 까지만 해도 저랑 이야기를 나눴던 경비병 중에 한 명인 발레리였습니다. 그때까지만 해도 차분한 "
"분위기에서 오는 그녀의 아름다움에 깜짝 놀랐었는데... 하지만 지금 연기와 불꽃 속에서 그녀는 마치 천상의 복수자처럼 보였어요. "
"위협적이지만 아름답고 자비로운, 불쌍한 필멸자들을 돕기 위해 천계로부터 내려온 갑옷입은 여신처럼 말이죠. 그녀는 불에 탄 채 겨우 "
"살아있는 경비병을 안고 있었습니다. \"여기 두 명 더 있습니다!\" 그녀가 우리 옆을 지나치면서 소리쳤습니다. \"그들은 부상을 "
"입었어요! 꺼내는 걸 도와주세요!\" 타투치오는 자만디가 어떤 상황에서 우리를 기다리고 있는지에 대해 투덜거렸습니다. 그러는 동안 "
"{Name}은(는)..."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0022_Text
msgctxt "6d1a2141-94dc-433c-9153-a5e084658c74"
msgid ""
"Alas, there was no safe passage. The villains who'd attacked the mansion "
"knew what they were doing — the only path to the banquet hall led straight "
"through the fire, which kept spreading despite the guards' best efforts! "
"Having ascertained this, we..."
msgstr ""
"아아. 안전한 통로가 없었습니다. 저택을 공격한 악당들은 자신들이 무엇을 하고 있는지 정확히 알고있었습니다. 연회장으로 향하는 유일한 "
"길에는 불이 계속 이어져 있었고 경비병들이 최선을 다했음에도 불구하고 계속 퍼져나갔습니다! 이걸 확인한 후에 우리는..."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0023_Text
msgctxt "7240e0d4-f054-43bb-9f59-314f4172d552"
msgid ""
"Prudence is the key to victory! Before moving through the fire, we "
"thoroughly wet our clothes and hair. After that, we..."
msgstr "신중함은 승리의 열쇠입니다! 불 속을 통과하기 전에 우리는 옷과 머리카락을 철저히 적십니다. 그 후 우리는..."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0026_Text
msgctxt "fa51b598-3f95-4fc4-b82b-a55ced7c7357"
msgid ""
"Saving the poor fellows didn't take long — together, we lifted them up and "
"carried them away from the fire."
msgstr "불쌍한 친구들을 구하는 것은 오랜 시간이 걸리지 않았습니다. 우리는 그들을 데리고 불에서 나왔습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0027_Text
msgctxt "139e2545-0348-4543-a065-7abf49dceac2"
msgid ""
"Saving the poor fellows was harder than it had seemed — we inhaled a lot of "
"smoke and burned ourselves more than once before managing to pull them away "
"from the fire."
msgstr "불쌍한 친구들을 구하는 것은 생각보다 어려웠습니다. 우리는 많은 연기를 들이마시고 불에서 그들을 구하다가 화상을 입었습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0028_Text
msgctxt "42ccda65-2f92-4136-a10b-fd058d7952e0"
msgid ""
"Only then did Valerie pause to catch her breath and wipe the sweat from her "
"face. \"Thank you, that was truly noble of you,\" she said. \"And now, let "
"us rush to Lady Aldori's aid!\"\n"
"Ensuring the guards we'd rescued were (relatively) safe, we made our way to "
"the hall, where the battle was already in full swing."
msgstr ""
"그제서야 발레리는 멈춰서서 숨을 고르고 땀을 닦았습니다. \"감사합니다. 당신의 행동은 정말로 고귀했습니다.\" 그녀가 말했습니다. "
"\"이제 빨리 알도리님을 지원하러 가시죠!\"\n"
"우리는 경비병들을 (비교적!)안전하게 구조했고, 우리는 전투가 이미 한창인 연회장에 도착했습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0030_Text
msgctxt "5a0cb137-d070-4375-a502-1c62327d32df"
msgid ""
"Valerie hesitated — for this valiant warrior, two things came above all else:"
" loyalty to her pledge, and duty to her comrades in arms. Now, she had to "
"choose one over the other."
msgstr ""
"발레리는 주저했습니다. 이 용맹한 전사에게는 무엇보다 우선적으로 고려하는 두 가지가 있었습니다. 그녀의 서약에 대한 충성과 동지들에 대한 "
"의무가 그것들 이었습니다. 이제 그녀는 둘 중 하나를 선택해야만 했습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0031_Text
msgctxt "6414e1dd-9096-445a-b768-bef9aeb32880"
msgid ""
"{Name} showed exceptional eloquence — no easy thing with the flames roaring "
"all around! With a heavy sigh, Valerie stopped arguing and followed us to "
"the dome of the banquet hall, where the battle was already in full swing."
msgstr ""
"{Name}(는)은 기대 이상으로 잘 했습니다. 불길이 타오르는 가운데 소리를 지르며 뛰어다니는 것은 쉬운 일이 아닙니다! 무거운 한숨을 "
"쉬며 발레리는 논쟁을 그만두고 우리를 따라 전투가 한창인 연회장으로 향했습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0032_Text
msgctxt "5b1a16a1-aeed-41ae-a4a6-1916e8bcc6c1"
msgid ""
"A burning house is no place for arguments! While {Name} tried to convince "
"the beautiful guard to join our team, we all inhaled a lot of smoke and "
"received several rather painful burns. But in the end, Valerie agreed, and "
"our small team bravely made our way to the dome of the banquet hall, where "
"the battle was already in full swing."
msgstr ""
"불타는 집 안은 논쟁하고 있을 만한 곳이 아니었습니다! {Name}이(가) 아름다운 경비병을 우리 팀에 합류하도록 설득하는 동안 우리는 "
"많은 연기를 들이마셨고 다소 고통스러운 화상을 입었습니다. 그러나 결국 발레리는 동의했고, 우리 작은 팀은 이미 전투가 한창인 연회장으로 "
"향했습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0034_Text
msgctxt "38b72685-77fb-4bc2-8258-95c6823b09c3"
msgid ""
"We shouldn't have wasted our time looking for another path! While we did, "
"the fire caused extensive damage to the mansion. As soon as we entered, we "
"heard a horrible cracking sound as the flaming wall next to us quickly "
"slanted, threatening to fall on our heads! With no time to think..."
msgstr ""
"다른 길을 찾느라 시간을 낭비하지 말았어야 했습니다! 그러는 동안 화재로 인해 맨션이 막대한 피해를 입었습니다. 우리가 들어서자마자 "
"균열음이 들리며 옆에서 불타는 벽이 빠르게 기울고 있었습니다. 이 벽은 곧 우리의 머리 위로 쓰러질 것만 같았습니다! 생각할 겨를도 "
"없이..."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0035_Text_String
msgctxt "891267b6-5a22-4d36-96c0-8436dd4d7a10"
msgid ""
"I don't know what saved us that day — maybe the gods, or luck, or just our "
"own dexterity, but the flaming logs and red-hot bricks didn't hit any of us."
msgstr ""
"전 아직도 그날 우리를 구한 것이 무엇이었는지 모르겠습니다. 어쩌면 신이나 행운, 아니면 그냥 우리 실력이였든 간에 불타는 통나무와 "
"빨갛게 달아오른 벽돌은 우리를 해치지 못했습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0037_Text
msgctxt "4149cd07-d8cb-4eba-ac97-1a0445236312"
msgid ""
"It was a good thing we hadn't wasted any time. After entering the building "
"and taking just a few steps forward, the wall behind us slanted and crashed "
"down with a terrible crackling sound, blocking the way back. While we may "
"not have planned on going back, if we'd come in a little later, the flaming "
"logs and red-hot bricks would have fallen right on our heads! Regardless, we "
"were left with only one way to go."
msgstr ""
"시간을 낭비하지 않았던 건 천만다행이었습니다. 건물에 들어가서 몇 걸음 앞으로 나아가자마자 우리 뒤에 있던 벽이 무시무시한 균열음과 함께 "
"무너내리면서 돌아갈 길을 막았습니다. 돌아갈 계획은 없었지만 조금만 더 지체했으면 불타는 통나무와 빨갛게 달아오른 벽돌이 머리 위에 "
"무너졌을 것입니다! 놀랄 틈도 없이 우리는 다음 길로 가야만 했습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0048_Text_String
msgctxt "b164f4f2-8554-499d-9e11-408d0aa3303c"
msgid ""
"Avoiding burning logs and red-hot bricks as they fall from above isn't easy, "
"especially with smoke and flames to deal with. Fortunately, we were all "
"alive, but no one made it out without at least a few burns and wounds."
msgstr ""
"머리 위로 떨어지는 불타는 통나무와 빨갛게 달아오른 벽돌을 피하는 것은 쉽지 않습니다. 특히 연기와 화염이 가득하다면 더 그렇겠죠. "
"다행히 우리는 모두 살았지만 화상이나 상처가 없는 사람은 없었습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0049_Text
msgctxt "d0e5dc31-8ea3-486a-bef6-a1f679ccefe8"
msgid ""
"{Name} pressed up against the wall and, tensing {mf|his|her} muscles "
"incredibly, slowed the wall's fall just enough for us to get out of danger! "
"It was a small but true feat!"
msgstr ""
"{Name}이(가) 벽을 밀어붙이자, {mf|그의|그녀의} 근육이 믿을 수 없을 정도로 팽팽해지면서 충분히 위험을 벗어날 시간을 "
"벌어주었습니다. 작지만 진정한 위업이었습니다!"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0050_Text
msgctxt "70e2838b-82d5-4b1c-96b7-4a1203133f91"
msgid ""
"{Name} pressed up against the wall, but not everyone can fight back a force "
"of nature like that. Flaming logs and red-hot bricks began tumbling down "
"around us! Fortunately, we were all alive, but we were far from unscathed. "
"No one made it out without at least a few burns and wounds, especially {Name}"
" {mf|him|her}self."
msgstr ""
"{Name}은(는) 벽을 밀어 지탱하려 했지만 아무나 중력을 상대로 싸울 수 있는건 아니었습니다. 불타는 통나무와 빨갛게 달아오른 벽돌이 "
"우리 주위로 떨어지기 시작했습니다! 다행히도 우리는 모두 살았지만 화상이나 상처가 없는 사람은 없었습니다. 특히 {name}의 상처가 "
"가장 심했습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0053_Text
msgctxt "79b2b39c-93f7-480b-981d-5ecc03d203ae"
msgid ""
"{Name} pushed us all forward, just as the flaming logs and red-hot bricks "
"began tumbling down. Anyone else would have been little more than a burning "
"puddle after that, but a moment later, {Name} walked out of the clouds of "
"smoke — wounded and burned, but alive."
msgstr ""
"불타는 통나무와 빨갛게 달아오른 벽돌이 아래로 굴러떨어지자 {Name}은(는) 우리를 앞으로 밀쳤습니다. 다른 누군가였다면 숯덩이가 "
"되어버렸겠지만, 얼마 지나지 않아 연기 사이로 {Name}이(가) 걸어 나왔습니다. 다치고 화상을 입었지만, 살아있었습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Book_e/Cue_0054_Text
msgctxt "0fba7bca-fad5-415f-9862-ac6946560a9d"
msgid ""
"The way back was blocked, but we weren't turning back anyway. We had only "
"one way to go."
msgstr "돌아가는 길은 막혔지만 어쨌든 우리는 되돌아갈 일이 없었습니다. 우리가 갈 길은 하나뿐이었습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Break_Chest/Answer_0005_Text
msgctxt "0bf69f58-7256-444d-8f95-b05bfacc46a5"
msgid ""
"\"No distractions! If you haven't forgotten, they're trying to kill us!\""
msgstr "\"산만하게 하지마! 혹시 잊었을까봐 말하는데 저 놈들은 우리를 죽이려고 하고 있어!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Break_Chest/Answer_0006_Text
msgctxt "b0f405b0-3af3-41a5-a69b-ca8b588eb6cb"
msgid "\"Gold? Interesting... How much?\""
msgstr "\"금? 흥미롭군... 얼마나 있지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Break_Chest/Answer_0007_Text
msgctxt "83d61080-6110-4093-b1ff-81068f5aaa5d"
msgid "\"Stealing from a swordlord in her own mansion? She'd have our heads.\""
msgstr "\"소드로드인 그녀의 저택에서 뭔가를 훔친다고? 당장 목이 달아날걸.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Break_Chest/Cue_0001_Text
#. Speaker : Tartuccio_Companion
msgctxt "f429edde-1f7d-4b7a-af1d-6716ab0daadc"
msgid ""
"{n}Tartuccio looks at the chest on the table and rubs his hands together.{/n}"
" \"What have we here? This chest is full of gold! I'd guess it's the guards' "
"salaries, all things considered. Well, those freeloaders don't seem to have "
"been working too hard for it — maybe we should pocket it instead!\""
msgstr ""
"{n}타투치오는 탁자 위의 상자를 보고 두 손을 문질렀습니다.{/n} \"이게 뭘까나? 금이 잔뜩 든 상자군! 아무래도 경비병들의 봉급인 "
"것 같아. 흠. 어차피 녀석들 밥만 축내고 일도 제대로 못 하는데 우리가 대신 챙기는 게 좋겠어!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Break_Chest/Cue_0002_Text
#. Speaker : Linzi_Companion
msgctxt "b389ddef-4b1d-4095-9fcf-43fcabbb1854"
msgid "\"What? No! We're heroes, not thieves!\""
msgstr "\"뭐라구요? 안돼요! 우린 영웅이지, 도둑이 아니라구요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Break_Chest/Cue_0003_Text
#. Speaker : Tartuccio_Companion
msgctxt "d3a492fd-09fd-4fbd-9b2a-8dc11587ceed"
msgid ""
"\"Who said we were stealing it? We'll just... take the gold for safety... so "
"the assassins don't get it! And then we can heroically return it to Jamandi "
"when this is all over!\""
msgstr ""
"\"누가 훔친데? 우린 그냥... 안전을 위해 금을 보관하는 것 뿐이야... 암살자들이 못 가져가게 말이지! 그 다음 나중에 자만디에게 "
"영웅처럼 모두 돌려주면 되는 거야!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Break_Chest/Cue_0008_Text
#. Speaker : Tartuccio_Companion
msgctxt "e0662143-e6c6-41b5-bb15-bd9baed86334"
msgid "\"A lot! Take a look!\""
msgstr "\"많아! 한 번 봐 보라고!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Break_Chest/Cue_0009_Text
#. Speaker : Linzi_Companion
msgctxt "659c63db-f78a-4773-b888-7e4658d2d48d"
msgid "\"Finally! A voice of reason!\""
msgstr "\"역시! 말이 통하시네요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Break_Chest/Cue_0010_Text
#. Speaker : Tartuccio_Companion
msgctxt "71e5fdde-d479-42e3-a817-53df9df4d898"
msgid ""
"\"How would she know it was us and not the assassins? Unless someone planned "
"on telling her...\" {n}The gnome throws a sideways glance at Linzi.{/n}"
msgstr ""
"\"암살자들이 아니라 우리라는 것을 그녀가 어떻게 알까? 누군가가 말해주지 않았다면...\" {n}노움은 옆에서 린지를 곁눈질로 "
"봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Break_Chest/Cue_0011_Text
#. Speaker : Linzi_Companion
msgctxt "444dd788-a69c-49b7-8739-40eddccc3600"
msgid ""
"\"Don't drag me into this! You do what you want, but I'm not taking a single "
"coin!\""
msgstr "\"날 끌어들이지 말아요! 하고 싶으면 당신만 하면 되잖아요. 난 한 푼도 가져가지 않을 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Break_Chest/Cue_0012_Text
#. Speaker : Linzi_Companion
msgctxt "d66b4081-3629-4890-81d3-f050b22d2b34"
msgid ""
"\"Are you out of your minds? We're in the middle of a battle, blood flowing "
"in rivers as an army of assassins chases us, and you want to rob our host? A "
"noble feat, to be sure!\""
msgstr ""
"\"제정신이에요? 우리는 전투 중이라구요! 암살자 군대가 우리를 쫓아오고 있고 온통 피바다인데 집주인을 털고 싶으세요? 정말 대단한 "
"업적이시네요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Break_Chest/Cue_0013_Text
#. Speaker : Tartuccio_Companion
msgctxt "0fb4a0ef-6974-47e5-bd48-e13a798c72a7"
msgid ""
"{n}Tartuccio shrugs with ostentatious nonchalance.{/n} \"Do what you want — "
"I don't care. It was just a suggestion... But there's a lot of money in that "
"chest, and with all these bandits running around... It wouldn't be any "
"better if they stole it!\""
msgstr ""
"{n}타투치오는 아무렇지도 않은 듯 어깨를 으쓱합니다.{/n} \"원하는 대로 해. 그냥 제안일 뿐이야. 그래도 궤짝에는 돈이 잔뜩 있고 "
"주변에는 도둑들이 뛰어다니고 있어... 그들이 훔쳐봐야 좋을 것 없잖아!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/HarrimDialog/Answer_0004_Text
msgctxt "94993809-844e-4268-88ee-7ca07406f0fa"
msgid "\"What's wrong?\""
msgstr "\"뭐가 문제지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/HarrimDialog/Answer_0005_Text
msgctxt "7a8ee899-b0b7-4827-81ec-d3e7d3b6344d"
msgid ""
"\"Aren't you being a bit premature? Look at yourself — you've barely got a "
"scratch!\""
msgstr "\"좀 빠르지 않아? 너를 봐. 상처 하나 없어!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/HarrimDialog/Answer_0006_Text
msgctxt "31ea643f-e1da-4456-85b4-a994add754f5"
msgid ""
"\"Quit the act — stand and fight, or I'll really send you to your final rest!"
"\""
msgstr "\"가식 좀 그만 떨고 일어나서 싸워. 그러지 않으면 진짜 영면에 들게 해줄테니까!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/HarrimDialog/Answer_0015_Text
msgctxt "11e5aa67-839c-45ac-b637-eafdf1e6bf9f"
msgid ""
"[Pour one of the dwarf's healing potions into his mouth] \"This should help!"
"\""
msgstr "[드워프의 치료 물약을 입에 부어준다] \"도움이 될 거야!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/HarrimDialog/Cue_0001_Text
#. Speaker : Harrim_Neutral
msgctxt "4b55f32d-30e9-47a3-93c4-1e97f7da7e59"
msgid ""
"{n}A dwarf is lying on the ground, staring into the dark sky. He doesn't "
"seem to have any severe wounds, but his trembling whisper is weak, as though "
"he were at death's door.{/n} \"{g|Groetus}Groetus{/g}... I can sense your "
"silhouette hovering over me... It won't be much longer... Soon, we shall "
"meet, oh lord of oblivion...\""
msgstr ""
"{n}드워프가 어두운 하늘을 쳐다보고 바닥에 누워 있습니다. 그는 큰 상처가 없는 것 같지만 떨리는 속삭임은 마치 죽음의 문앞에 있는 "
"것처럼 약합니다.{/n} \"{g|Groetus}그로투스{/g}... 당신의 실루엣이 저를 맴도는 것이 느껴집니다.. 이제 머지 "
"않았습니다... 곧 만나게 되겠군요... 망각의 신이시어..\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/HarrimDialog/Cue_0002_Text
#. Speaker : Harrim_Neutral
msgctxt "adce6697-2db1-46d5-b9cc-58d853a74b86"
msgid ""
"\"I'm dying... I knew this expedition was doomed... Oh, "
"{g|Groetus}Groetus{/g}, my vision darkens...\""
msgstr ""
"\"나는 죽어가고 있네... 나는 이 원정이 파멸할 것을 알고 있었다고... 오. {g|Groetus}그로투스{/g}시여, 제 시야가 "
"어두워집니다...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/HarrimDialog/Cue_0009_Text
#. Speaker : Harrim_Neutral
msgctxt "9ede8042-ed25-4b67-8cb0-da12a89e005b"
msgid ""
"\"That's impossible!\" {n}The dwarf lifts his head and inspects his body "
"carefully, then tries to move his hands and feet.{/n} \"It... it seems you "
"might be right.\""
msgstr ""
"\"그럴 리가!\" {n}드워프는 머리를 들어서 몸을 조심스럽게 살펴본 다음 손발을 움직여 봅니다.{/n} \"네.. 네 말이 맞는 것 "
"같군.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/HarrimDialog/Cue_0010_Text
#. Speaker : Harrim_Neutral
msgctxt "4d699408-73d0-4fe7-a2a2-ed4663794c73"
msgid ""
"\"You're wrong... Who would know better than I the severity of my own "
"wounds...? I can feel the last drops of vital force leaving me...\""
msgstr "\"아니네... 내 부상이 얼마나 심각한지 나보다 누가 더 잘 알겠나?... 생명력이 끝까지 빠져나가는게 느껴진다네...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/HarrimDialog/Cue_0011_Text
#. Speaker : Harrim_Neutral
msgctxt "88703c8e-fd79-479a-a914-d04a33b268b0"
msgid ""
"\"How rude — speaking to a dying man that way! Look, I can't even move!\" {n}"
"The dwarf moves his hands then looks at them, baffled.{/n} \"It can't be... "
"But I'm gravely wounded! I can't even stand on my own two feet... Watch!\""
msgstr ""
"\"정말 무례하군. 죽어가는 사람에게 그런 식으로 말한다니! 이봐. 나는 움직일 수도 없어!\" {n}드워프가 손을 움직이다가 이내 "
"당황한 표정으로 그들을 봅니다.{/n} \"이럴 리가.. 그래도 난 중상을 입었다고! 두 발로 서있을 수도 없다네... 조심해주게!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/HarrimDialog/Cue_0012_Text
#. Speaker : Harrim_Neutral
msgctxt "6e86af55-80f9-4b3b-bf4a-ebd0a976761f"
msgid "\"I can't hear you... I'm being taken away... into the darkness...\""
msgstr "\"당신 말이 들리지가 않아... 나는... 어둠으로 끌려가고 있네...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/HarrimDialog/Cue_0013_Text
#. Speaker : Tartuccio_Companion
msgctxt "06a99263-bf16-4a1f-a92a-c956bb704675"
msgid ""
"{n}Tartuccio gives the dwarf a swift kick.{/n} \"Up, you faker! Just look at "
"him — dying, he says! What a buffoon! Come on, get up now, or I'll tap-dance "
"on your corpse!\""
msgstr ""
"{n}타투치오는 드워프에게 발길질을 날립니다.{/n} \"당장 일어나, 이 사기꾼아! 얘 좀 봐라, 죽는다고? 별꼴 다 보겠네! 어서 "
"일어나! 그렇지 않으면 내가 네놈의 시체 위에서 탭댄스를 춰주마!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/HarrimDialog/Cue_0014_Text
#. Speaker : Harrim_Neutral
msgctxt "876c9735-a57a-45f7-97f1-eaa9b61c9db5"
msgid ""
"{n}The dwarf grunts as he regains his feet and warily looks down at his "
"bloodstained armor.{/n} \"It... it seems I will live. I suppose I must "
"postpone meeting my god... Not for long, I'm sure. But while we remain in "
"this transient world — Harrim is at your service.\""
msgstr ""
"{n}드워프는 앓는 소리를 내며 일어난 뒤 피투성이가 된 갑옷을 조심스럽게 내려다봅니다.{/n} \"주.. 죽지는 않을 것 같군. 신과의 "
"만남은 미뤄 둬야겠구먼... 그래도 오래 걸리진 않을거야. 확신한다네. 그러나 우리가 이 일시적인 세계에 머무르는 동안 나 하림은 당신을 "
"도울 것이네.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/HarrimDialog/Cue_0016_Text
#. Speaker : Harrim_Neutral
msgctxt "2680a8de-1f56-4365-9186-c51a3137ab67"
msgid ""
"{n}The dwarf's wounds, shallow as they are, begin to heal, but he seems not "
"to notice as he keeps whispering.{/n} \"Too late... Forgive me... Oblivion "
"is calling...\""
msgstr ""
"{n}드워프의 상처는 매우 얕지만 치유되기 시작합니다. 하지만 그는 계속 속삭이느라 눈치채지 못하는 것 같습니다.{/n} \"너무 "
"늦었네... 용서하게... 망각이 부르고 있어...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Items/Tartuccio_Ring_description_String
msgctxt "6cb988b6-9658-4ba3-8f76-7a2c7afb8d0f"
msgid ""
"This ring grants its wearer a +1 bonus to Armor Class. This is a deflection "
"bonus that does not stack with other deflection bonuses."
msgstr "이 반지는 착용자의 방어도에 +1의 보너스를 줍니다. 이 보너스는 굴절 보너스로 다른 굴절 보너스와 중첩되지 않습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Items/Tartuccio_Ring_name_String
msgctxt "6dec83dd-900b-42da-a2c9-7f47cc9fc2ec"
msgid "Tartuccio's Present"
msgstr "타투치오의 선물"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/JathalDialog_trap/Cue_0001_Text
#. Speaker : Jaethal_Neutral
msgctxt "92828486-ae7f-4dc9-aeab-11aa8d0e4a85"
msgid ""
"\"Oh, familiar faces...\" {n}The pale elf looks eerie in the semidarkness, "
"like a ghost given flesh.{/n} \"I hope you're not so frightened as to swing "
"at every shadow. It's me, Jaethal. I don't recommend advancing down the "
"hallway — assuming you value your life, of course. There were a few people "
"with me, and you can see what happened to them.\""
msgstr ""
"\"오. 친숙한 얼굴들이군...\" {n}창백한 엘프는 어둑한 곳에서 보니 으스스해 보입니다. 마치 유령이 시체에 빙의한 듯합니다.{/n}"
" \"보이는 그림자마다 칼을 휘두를 만큼 놀라지 않았으면 좋겠네. 나야. 제이탈. 복도를 따라 나가지 않는 것이 좋을 거야. 물론 네 "
"인생을 소중하게 생각한다면 말이지. 나랑 동행하던 이들이 몇명있었는데.. 걔네가 어떻게 됐는지 보이지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/JathalDialog_trap/Cue_0002_Text
#. Speaker : Tartuccio_Companion
msgctxt "75a181f8-4eb8-46ba-ace7-71eb42e81044"
msgid ""
"\"And just how did they all end up dead while you don't seem to have a "
"scratch?\" {n}Tartuccio eyes Jaethal suspiciously.{/n}"
msgstr "\"그래서 모두가 죽은 와중에 너한텐 왜 상처 하나 없는 거지?\" {n}타투치오는 의심스럽게 제이탈을 봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/JathalDialog_trap/Cue_0003_Text
#. Speaker : Jaethal_Neutral
msgctxt "8d872d54-5fca-42da-9ae0-b9fb247f4ace"
msgid ""
"\"I'll answer, but briefly, and just once. Further scares and explanations "
"will wait until we aren't being hunted by a group of assassins. Deal? All "
"right. I'm...undead. These traps are deadly to the living, but they're "
"harmless to me.\""
msgstr ""
"\"짧게 대답해줄께. 한 번만 할거야. 지금 부터 느낄 공포와 궁금증은 우리가 암살자들에게 쫓기지 않을 때까지 참아줘. 알겠지? 난... "
"언데드야. 이 함정은 살아있는 사람에게는 치명적이지만 나에게는 해가 되지 않아.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/JathalDialog_trap/Cue_0004_Text
#. Speaker : Jaethal_Neutral
msgctxt "2609c6ab-b1e9-43db-81b5-d703e6a2af55"
msgid ""
"{n}Jaethal looks at Linzi as though at an annoying fly.{/n} \"As I said, "
"further explanations will wait until later! All you need to know right now "
"is that we're on the same side, and we have to fight off a small army of "
"hired assassins. Let's get to it!\""
msgstr ""
"{n}제이탈은 성가신 파리를 보는 것처럼 린지를 봅니다.{/n} \"이미 말했듯이 더 자세한 설명은 나중에 하겠어! 당장 너희가 알아둬야 "
"할 건 우리가 같은 편이라는 것과 우리가 작은 군대 규모의 고용된 암살자들과 싸워야 한다는 것 정도야. 가보자고!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/JathalDialog_trap/Cue_0005_Text
#. Speaker : Linzi_Companion
msgctxt "bfa928a0-21c7-4687-86ca-f8e2666ddae6"
msgid ""
"\"What do you mean, 'undead'? Really? Like zombies, or skeletons, or...\""
msgstr "\"'언데드'라니 무슨 뜻이죠? 정말로? 그러니까 좀비, 스켈레톤 같은... \""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Answer_0005_Text
msgctxt "c1580ae4-e8db-4d8d-b148-da6b2ba2531e"
msgid "\"Who are you?\""
msgstr "\"넌 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Answer_0009_Text
msgctxt "308182d8-c8dd-4427-9c73-dfd1c0c09c89"
msgid "\"Do you need help putting out the fire?\""
msgstr "\"불을 끄는 데에 도움이 필요한가?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Answer_0013_Text
msgctxt "de748e5d-36f7-4e3e-a14b-6b75ea6d0cd6"
msgid "\"Where's the hall?\""
msgstr "\"연회장은 어디에 있지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Answer_0020_Text
msgctxt "6f0748a0-c0a0-4c58-b853-eb3e795a4c19"
msgid "\"I'll go immediately!\""
msgstr "\"당장 가겠다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Answer_0024_Text
msgctxt "3efdb93f-daec-4747-b238-4fa139085a12"
msgid "\"What's going on here?\""
msgstr "\"여기서 무슨 일이 일어난 거지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Cue_0002_Text
#. Speaker : Kesten_StartPrologue
msgctxt "81cf70af-1e9c-488b-9dac-baa463c3ee97"
msgid ""
"{n}The stout man's unshaven face is covered with scars. There's blood on his "
"armor, but he doesn't even seem to notice his wounds as he confidently gives "
"orders to the guards.{/n} \"You — run and get an axe. You bring more water. "
"You stay here and hold our defense — those assassins are still around here "
"somewhere!\""
msgstr ""
"{n}면도되지 않은 건장한 남자의 얼굴에는 흉터가 가득합니다. 그의 갑옷에는 피가 묻어 있지만 경비병에게 명령을 내리느라 자신의 상처조차 "
"알아차리지 못하는 것 같습니다.{/n} \"너, 어서 가서 도끼를 가져와. 너, 더 많은 물을 가지고 와라. 넌 여기에서 대기해서 방어에 "
"집중해라. 저 암살범들은 아직 여기 어딘가에 있다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Cue_0003_Text
#. Speaker : Kesten_StartPrologue
msgctxt "f25de136-a48a-4bd5-9afe-080dce0300ac"
msgid ""
"{n}He turns to you.{/n} \"Aha! Some of our guests survived — good. You need "
"to get to the banquet hall and help Lady Jamandi!\""
msgstr ""
"{n}그는 당신을 향해 고개를 돌립니다.{/n} \"아! 손님 몇 분이 살아계셨군요. 좋습니다. 연회장으로 가셔서 자만디 님을 도와주셔야 "
"합니다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Cue_0007_Text
#. Speaker : Kesten_StartPrologue
msgctxt "f16839e4-f9ce-425f-ba80-211953ffe9b5"
msgid ""
"\"Kesten {g|House Garess}Garess{/g}, a fighter in the service of "
"{g|Swordlords}Swordlord{/g} Jamandi Aldori. Right now, I'm in charge of the "
"mansion guards. As you can see, there's a lot to do!\""
msgstr ""
"\"케스턴 {g|House Garess}가레스{/g}. 자만디 알도리님을 섬기는 전사입니다. 지금은 저택의 경비를 맡고 있으며, "
"보시다시피 아주 바쁩니다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Cue_0010_Text
#. Speaker : Kesten_StartPrologue
msgctxt "c9d93971-ac98-46ae-b633-2c28d05c290e"
msgid ""
"\"No, we'll manage! I've got my best people here... those who still live. "
"Your place is by Lady Aldori's side!\""
msgstr ""
"\"아닙니다. 저희가 해결하도록 하겠습니다! 제겐 아직까지도 살아남은 최고의 병사들이 있습니다. 여러분은 알도리님 쪽을 도와주십시오!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Cue_0011_Text
#. Speaker : Linzi_Companion
msgctxt "41885d98-8ee2-4b57-94ea-290b6246fa92"
msgid ""
"\"It doesn't seem right... What if some of the guards are wounded? We need "
"to help them!\""
msgstr "\"그건 옳지 않은 것 같아요... 경비병들이 다치면 어쩌죠? 그들을 도와야 해요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Cue_0012_Text
#. Speaker : Tertuccio_StartPrologue
msgctxt "09233713-cde1-4878-81ed-78d615087493"
msgid ""
"\"Linzi, are you sure you're really a bard? It must be hard, being deaf in "
"both ears! You were told to help Jamandi! Was there a big word in there you "
"didn't understand?\""
msgstr ""
"\"린지. 너 정말 바드맞냐? 양쪽 귀가 먹어서 먹고 살기도 힘들겠네! 자만디를 도와줘라 말 들었잖아! 혹시 이해하기 어려운 긴 단어라도 "
"있었니?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Cue_0014_Text
#. Speaker : Kesten_StartPrologue
msgctxt "79f02d51-5588-42c6-a014-48fd6a6ea199"
msgid ""
"{n}Kesten points to the burning building.{/n} \"You'll have to run through "
"the fire. We've almost put it out at the entrance, so your main concern "
"should be to not inhale any smoke. Hold your breath and take the first "
"right, then head straight down the hallway!\""
msgstr ""
"{n}케스턴은 불타는 건물을 가리킵니다.{/n} \"불 속을 통과해야 합니다. 입구의 화재는 거의 진압했으니 연기만 들이마시지 않으시면 "
"됩니다. 숨을 참고 처음 갈림길에서 오른쪽으로 간 다음 복도를 따라 곧장 가십시오!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Cue_0015_Text
#. Speaker : Kesten_StartPrologue
msgctxt "8f9aa37d-e57a-436b-be5f-e9ee8ad9418a"
msgid ""
"\"What are you waiting for? Get to Lady Jamandi in the banquet hall! Now!\""
msgstr "\"뭘 기다리는 거죠? 연회장에 있는 자만디님에게 가세요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Cue_0021_Text
#. Speaker : Kesten_StartPrologue
msgctxt "61617d58-0f35-4422-ab10-9f82c911f7f0"
msgid "\"May {g|Abadar}Abadar{/g} keep you safe.\""
msgstr "\"{g|Abadar}아바다르{/g}께서 여러분을 보호하시길.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Cue_0025_Text
#. Speaker : Kesten_StartPrologue
msgctxt "4d497fba-9eeb-4ac4-b92a-b46924ff4616"
msgid ""
"\"Someone opened the gate. Let in a group of assassins in the middle of the "
"night. Now they've set the mansion on fire to cut off access to the hall. "
"They don't want Lady Jamandi to get reinforcements. We cleared the passage, "
"so you can get through — just try to avoid inhaling the smoke! We'll be "
"right behind you — we just need to put out the fire first to save the "
"mansion!\""
msgstr ""
"\"한밤중에 누군가 문을 열어 암살자들을 들여보냈습니다. 지금 그들이 불을 질러서 연회장에 접근하는 것을 차단했습니다. 자만디님이 원군의 "
"도움을 받지 못하게 하려고 말입니다. 통로를 확보해두었으니 이쪽으로 가시면 됩니다. 다만 연기를 마시지 않도록 조심하십시오! 저희는 먼저 "
"저택의 화재를 진압하고 바로 뒤따라 가겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Cue_0028_Text
#. Speaker : Kanerah_Capital_prologue
msgctxt "06e0f4de-729f-4349-bbe9-10113341e837"
msgid ""
"\"Fire doesn't frighten me – thanks to {g|Hell}Hell's{/g} blood running in "
"my veins. I'll go ahead and wait for you on the other side. Catch up!\" {n}"
"The tiefling girl starts off and dashes through fire.{/n}"
msgstr ""
"\"불은 두렵지 않아. 내 핏줄에는 {g|Hell}지옥{/g}의 피가 흐르거든. 먼저 가서 너를 기다리고 있을게. 이따 봐!\" {n}"
"티플링 소녀는 자리를 뜨고는 불 속을 달립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Cue_0031_Text
#. Speaker : Kanerah_Capital_prologue
msgctxt "7c657196-9018-40a2-a1fd-ebba5c94f0cf"
msgid ""
"\"Considering Lady Jamandi's fame, I'm not surprised that a whole pack of "
"assassins were unleashed on her – including a giant. But what's at stake? "
"What could anyone hope to gain?\" {n}The tiefling squints, obviously curious "
"and thinking quickly.{/n}"
msgstr ""
"\"자만디의 명성을 생각하면 암살자들이 이렇게 많이 온 것도 무리가 아니야. 거인도 있을 정도니. 하지만 무엇을 위해? 누구의 계획일까?"
"\" {n}티플링은 스스로 물으며 생각에 빠집니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/Kesten_Dialog/Cue_0034_Text
#. Speaker : Kanerah_Capital_prologue
msgctxt "7216bda7-79d6-4e97-b496-f7f9d2e42943"
msgid ""
"{n}The girl casts a coy look at Kesten and remarks sweetly,{/n} \"If I were "
"a rich and influential lady like Jamandi, I'd also get myself a... manly "
"captain of the guard. Or two.\""
msgstr ""
"{n}그 소녀는 케스턴을 수줍게 보고는 달콤하게 얘기합니다.{/n} \"내가 자만디처럼 부유하고 영향력있는 여자였다면.. 남자다운 "
"경비대장을 고용하겠어. 두명도 좋겠지\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/LinziDialog_FirstRoom/Answer_0004_Text
msgctxt "70116074-2469-4595-8930-37bb05baafa9"
msgid "\"What's going on?\""
msgstr "\"무슨 일이야?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/LinziDialog_FirstRoom/Answer_0005_Text
msgctxt "dcc8b3c9-43f0-4b91-b177-0bdf7eccb290"
msgid "\"Is this a joke?\""
msgstr "\"지금 장난치는 거야?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/LinziDialog_FirstRoom/Answer_0006_Text
msgctxt "bb58291e-7fd4-4ea1-a726-ccb5b5434e46"
msgid "\"Get out of my room!\""
msgstr "\"내 방에서 나가!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/LinziDialog_FirstRoom/Cue_0002_Text
#. Speaker : Linzi_Neutral
msgctxt "68ad5fb6-d696-4f9c-88cd-9ccf11d8e281"
msgid ""
"{n}Linzi bursts into your room. She looks scared. Her face is smeared with "
"soot, and she holds a weapon in her hands.{/n} \"Help! Help!\""
msgstr ""
"{n}린지가 당신의 방으로 뛰쳐들어왔습니다. 그녀는 겁에 질려있습니다. 그녀의 얼굴은 그을음으로 얼룩졌고 손에 무기를 들고 "
"있습니다.{/n} \"도와주세요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/LinziDialog_FirstRoom/Cue_0007_Text
#. Speaker : Linzi_Neutral
msgctxt "2f88f3ef-0e4b-44f7-9c71-21887419db41"
msgid "\"The mansion's under attack! We need to help!\""
msgstr "\"저택이 공격받고 있어요! 우리가 도와줘야 해요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/LinziDialog_FirstRoom/Cue_0008_Text
#. Speaker : Linzi_Neutral
msgctxt "16374bf6-1309-4519-8363-c6093948e050"
msgid ""
"\"Some villains broke in and started killing everyone! I barely made it! "
"Hurry, we have to help the guards fight off the attackers, or we'll all be "
"cut down one by one!\""
msgstr ""
"\"웬 악당이 침입해서 사람들을 죽이고 있어요! 전 간신히 도망쳤구요! 서둘러요! 경비원이 침입자를 물리치도록 도와야 해요. 안 그럼 "
"우리도 하나둘씩 죽을 거예요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/LinziDialog_FirstRoom/Cue_0009_Text
msgctxt "e237c711-f9ed-4a03-bc98-ca4432804913"
msgid ""
"{n}As if to lend credence to Linzi's words, a scream echoes from the "
"hallway.{/n}"
msgstr "{n}마치 린지의 말에 신빙성을 부여하려는 것처럼 복도에서 비명 소리가 울립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/LinziDialog_FirstRoom/Cue_0010_Text
#. Speaker : Linzi_Neutral
msgctxt "6dd87dad-54da-430e-9a64-0e1e053aecdc"
msgid "\"No time for jokes! The mansion's under attack!\""
msgstr "\"장난칠 시간 없어요! 저택이 공격받고 있다구요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/LinziDialog_FirstRoom/Cue_0011_Text
#. Speaker : Linzi_Neutral
msgctxt "16534075-6402-4ff4-bf52-ebc96969f846"
msgid "\"You can't stay here! The mansion's under attack!\""
msgstr "\"여기에 있으면 안돼요! 저택이 공격받고 있다구요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/TartuccioAfterFight_Dialog/Cue_0002_Text
#. Speaker : Tertuccio_StartPrologue
msgctxt "a261de7a-631e-48d1-b882-72119b822e28"
msgid ""
"\"You're just in time! A bit longer and I'd have been... ugh, I don't even "
"want to think about it! Can you imagine what a terrible loss that would have "
"been? But it's all right, now. I'm safe, sound, and unscathed — ready to "
"lead you to victory!\""
msgstr ""
"\"딱 맞춰왔군! 조금만 늦었어도 난... 생각도 하기 싫군! 날 잃다니 얼마나 극심한 손해겠어? 하지만 괜찮아. 난 이제 안전하고 "
"상처도 없지. 너희를 승리로 이끌 준비가 돼있다고!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/TartuccioAfterFight_Dialog/Cue_0003_Text
#. Speaker : Tertuccio_StartPrologue
msgctxt "a54908e1-0f9c-4c61-a1bc-2cdc39eea553"
msgid ""
"\"Lady Jamandi's holding the line in the banquet hall — you know, the one "
"she had us gathered in before? We need to make our way to her! And along the "
"way, we'll try to save some of these dummies who were supposed to accompany "
"us to the {g|Stolen Lands}Stolen Lands{/g}!\""
msgstr ""
"\"자만디 여사는 연회장에서 적들을 상대하고 있어. 우리가 전에 모였던 곳 있잖아? 일단 그녀에게 가는게 우선이야! 도중에 {g|"
"Stolen Lands}도둑맞은 땅{/g}으로 동행할 예정이었던 멍청이들 몇 놈을 구할 수도 있겠지!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansion/TartuccioAfterFight_Dialog/Cue_0004_Text
#. Speaker : Tertuccio_StartPrologue
msgctxt "cc1a51ac-b9f7-423f-a357-bbf78a60a37c"
msgid ""
"\"Speaking of dummies...\" {n}The gnome looks back at Linzi and starts "
"whispering as he takes a ring off his finger, handing it to you.{/n} \"Take "
"this ring — quiet now, so that little fool doesn't hear us! She might try to "
"steal it herself... It's magical. It'll protect you. You'll need it while "
"you work to defend me!\""
msgstr ""
"\"멍청이라고 하니까...\" {n}노움은 린지를 힐끔 보곤 자신이 끼고 있던 반지를 당신에게 건네며 속삭입니다.{/n} \"이 반지를 "
"껴. 조용히 해! 저 멍청한 땅딸보가 듣게되면 분명 훔치려들테니까. 이건 마법의 물건이야. 널 지켜줄거라구. 날 지킬 동안 이걸 쓰도록 "
"해. 알겠지!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/1DLC_Barks/1DLC_Kaessi_afterbattle_bark_String
msgctxt "189247d1-20ca-42f6-8c95-f5684dd2df41"
msgid ""
"\"So many deaths... the night stokes our rage. The grief and tears will come "
"at dawn.\""
msgstr "\"너무나 많이 죽었어... 최악의 밤이야. 슬픔과 눈물이 여명에 물들겠어.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/1DLC_Barks/1DLC_Kaessi_beforebattle_bark_String
msgctxt "a75abca2-20d5-421d-8cd8-7d1c6098ecfb"
msgid "\"The help has arrived! Quick, we need to save Lady Jamandi!\""
msgstr "\"지원이 도착했어! 서둘러. 자만디님을 구해야 해!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/1DLC_Barks/1DLC_Kaessi_start_bark_String
msgctxt "2eb0f2e5-0f9f-4e33-8903-3f028e70e347"
msgid ""
"\"Northern architecture is beautiful, but very heavy. In my native land of "
"Qadira, palaces are furnished quite differently...\""
msgstr "\"북부의 건축물은 아름답지만 너무 육중해. 우리 고향 카디라의 건물은 많이 달라...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Adventurer-1_String_1
msgctxt "25fef35e-0804-42ee-997b-1abbb6986a1a"
msgid "\"Just simple bandits? We'll deal with them in no time!\""
msgstr "\"겨우 도적? 그 정도는 식은 죽 먹기지!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Adventurer-2_String
msgctxt "8f0679de-78c2-4c12-8ba7-7cca7024ce12"
msgid "\"It may be difficult, but at least it won't be boring!\""
msgstr "\"어려울 수도 있지만 적어도 지루하지는 않겠지!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Adventurer-3_String
msgctxt "b4ac0ea8-b1d5-464f-903a-75be2e128991"
msgid "\"Our own barony! Now that's a prize worth fighting for!\""
msgstr "\"우리들만의 영지라니! 싸울 가치가 있는 보상이지!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Amiri_String
msgctxt "bbffc92e-b9e4-4295-bd84-03d52db761bd"
msgid "\"Finally, the idle talk's over. Can't wait to set out!\""
msgstr "\"마침내 지루한 이야기는 끝났군. 빨리 출발하자고!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Guard-1_String
msgctxt "d7c3ce31-f03c-4950-9557-9b824cd70d4c"
msgid ""
"\"So many strangers in one night... I hope there are no schemers among the "
"guests!\""
msgstr "\"하룻밤에 낯선 사람들이 너무 많았어... 손님들 사이에 불청객이 없었으면 좋겠군.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Guard-2_String
msgctxt "ef67f8f1-f20d-4647-a57d-2ab4262b029e"
msgid "\"Welcome to the mansion of Swordlord Jamandi Aldori.\""
msgstr "\"소드로드 자만디 알도리님의 저택에 온 것을 환영한다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Guard-3_String
msgctxt "1ed0c46e-18ae-43dd-9695-710586ff10fa"
msgid ""
"\"Please try to avoid soiling the carpets or scratching the furniture.\""
msgstr "\"카펫을 더럽히거나 가구를 훼손하지 말길 바란다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Harrim_String
msgctxt "50083348-35ff-4b82-97e0-5e10afbd03e1"
msgid "\"This expedition is surely doomed...\""
msgstr "\"이 원정은 분명 실패할 걸세...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Jaethal_String
msgctxt "12b781d6-976d-420a-b60c-39f3a9ca0fac"
msgid "\"What game is Jamandi playing? I'm not used to feeling like a pawn!\""
msgstr "\"대체 자만디는 무슨 속셈인거지? 장기말이 된 느낌이군!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Jamandi_String
msgctxt "220157b7-28e0-4ad8-bd3f-326838e5ea71"
msgid ""
"\"Get some rest before the road. You've a difficult journey before you.\""
msgstr "\"길을 나서기 전에 좀 쉬시죠. 힘든 여정을 앞두고 있으니 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Kesten_String
msgctxt "a303819b-94f3-40ca-9d3f-772c9fe54a2a"
msgid "\"I'll double the guard for the night, just as a precaution...\""
msgstr "\"예방 차원에서 야간 경비병을 두배로 늘리겠습니다..\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Linzi_String
msgctxt "ec68981c-e5a8-4e85-88b7-2ec408786d10"
msgid ""
"\"And so begins a glorious story that'll win over all of Golarion! The first "
"page is being written here and now!\""
msgstr "\"골라리온 전역을 지배할 위대한 이야기가 시작된다! 첫장이 지금 여기 쓰여지고 있어!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Optional_puzzle_1_String
msgctxt "7fca0b6c-a3cf-4392-8c2b-b25beae951c5"
msgid "\"What are you dallying for?\""
msgstr "\"뭘 그렇게 꾸물대는 거야?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Optional_puzzle_2_String
msgctxt "2fa1be0c-c3f6-4d96-885d-0063eadc75fe"
msgid "\"I'm telling you, Jamandi's cache has to be here somewhere!\""
msgstr "\"분명 자만디의 비밀창고가 여기 어딘가에 있다고!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Optional_puzzle_3_String
msgctxt "33ac4aba-8a9b-42c8-ad63-eed2ec9e9d17"
msgid "\"Well, hurry it up, before — stop! Someone's coming!\""
msgstr "\"그럼 서둘러. 누가 오기 전... 잠깐! 누가 온다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Optional_puzzle_4_String
msgctxt "9bf403d9-4441-45d0-bf7a-97f59957525b"
msgid "\"What did they say about a cache? Curious...\""
msgstr "\"저 녀석들이 비밀창고니 뭐니 한 것 같은데... 흠. 궁금하군.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Sellemius_String
msgctxt "1434e525-3ab6-4808-9889-428773661b4b"
msgid ""
"\"Such power! Such valor! Such starry eyes! I'm sure the Stag Lord will be "
"unable to resist you!\""
msgstr "\"그런 능력! 그런 용맹함! 그런 별 모양의 눈! 나는 수사슴 군주가 너를 저항할 수 없을 것이라고 확신한다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Tartuccio_String
msgctxt "bc1e55f8-7165-4da8-aa53-6b0d28c70bf7"
msgid ""
"\"Tomorrow, our glorious journey begins! Are you ready? I hope so — I don't "
"need layabouts on my team!\""
msgstr "\"내일 우리의 영광스러운 여행이 시작된다고! 준비됐어? 됐기를 바라. 내 팀에 무능력자는 필요 없으니까!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/Barks/Valerie_String
msgctxt "35610b60-ba3c-4cff-b449-dd9ff33fbde3"
msgid ""
"\"A great deal of trust has been placed in you. Do not let Lady Aldori down!"
"\""
msgstr "\"많은 이들이 너를 신뢰하고 있어. 알도리님을 실망시키지 마!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Answer_0011_Text
msgctxt "72da0cf4-4968-4273-8185-9488e6d2cb02"
msgid ""
"\"Tartuccio's trying to set me up. He's the one who gave me this ring!\""
msgstr "\"타투치오가 나를 속여 먹으려 했어. 나에게 이 반지를 주었다고!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Answer_0012_Text
msgctxt "1d818ee0-e725-4623-b5ac-13fa7c17079a"
msgid ""
"\"I have no connections to Pitax — but Tartuccio's name, accent, and clothes "
"seem like he came straight from there! Which of us looks more like they "
"might be Irovetti's spy?\""
msgstr ""
"\"나는 피탁스와 아무런 연관이 없어. 하지만 타투치오의 이름, 억양 그리고 옷차림은 그가 그곳 출신이라는 걸 말해주지. 우리 중 누가 "
"더 이로베티의 스파이일 가능성이 높겠어?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Answer_0013_Text
msgctxt "c90f242d-e7bc-4884-81e9-5e38dcdce317"
msgid "[Attack] \"Liar!\""
msgstr "[공격] \"거짓말쟁이 같으니!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Answer_0027_AlignmentShift.Description_String
msgctxt "137e7a87-21c6-45c2-9396-0d248f6ad052"
msgid "Explained your actions to Jamandi Aldori."
msgstr "자만디 알도리에게 당신의 행동을 설명했습니다."

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Answer_0027_Text
msgctxt "bd4abbec-22a8-4ce8-b4b3-3fad5a5ea668"
msgid ""
"\"Forgive me for my trespass. In my defense, we were in the middle of a "
"battle and in dire need of weapons.\""
msgstr "\"무단 침입을 부디 용서하십시오. 저희는 전투 중이었고 무기가 절실히 필요했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Answer_0028_Text
msgctxt "fd5ab121-95ae-49f9-ae3b-56556cd21185"
msgid ""
"\"We were in the middle of battle and needed weapons! There was no time to "
"run and ask permission!\""
msgstr "\"우리는 전투 중이었고 무기가 필요했다! 사람을 찾아 허가를 받을 시간 같은 건 없었어!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Answer_0033_Text
msgctxt "7d55c061-c2c1-4ea8-83e2-3e496d96af0f"
msgid ""
"\"We weren't trying to take the money — we just wanted to keep it away from "
"the bandits.\""
msgstr "\"우리는 돈을 가질 생각 따윈 없었다. 단지 도적으로부터 지키고 싶을 뿐이었지.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Answer_0034_Text
msgctxt "a39c39da-eec8-4c06-8073-76cf79894e46"
msgid ""
"\"So what if we did? The guards weren't able to handle their "
"responsibilities, so we decided we should teach them a lesson.\""
msgstr "\"우리가 그랬다면? 경비병이 자신의 책임을 다하지 않았기 때문에 그들에게 교훈을 줘야겠다고 생각했을 뿐이야.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Answer_0046_Text
msgctxt "33c83e1e-34fe-4edc-a6fd-068e3704ef85"
msgid "\"People were dying right in front of me. How could I just walk by?\""
msgstr "\"사람들이 내 앞에서 죽어가고 있는데 어떻게 그냥 지나칠 수 있겠어?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Answer_0047_Text
msgctxt "1940f26e-0078-472d-a37b-b3874554c290"
msgid ""
"\"I wouldn't have saved them without good reason. Dead soldiers are useless, "
"but the wounded could still help Kesten defend the mansion.\""
msgstr ""
"\"적당한 이유가 없었다면 구하지 않았을걸. 죽은 군인들은 어쩔 수 없지만 일단 살려만 놓으면 저택을 지키고 있는 케스턴을 도울 수 "
"있으니까.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Answer_0048_Text
msgctxt "aedfd8b0-a188-495d-978f-afe4f8f72a88"
msgid ""
"\"I regret that I couldn't save everyone — I would have if I could! I'm sad "
"for the perished, but I had to decide between helping them and helping Lady "
"Aldori. Forgive me if I chose wrongly.\""
msgstr ""
"\"모든 사람을 구하지 못한 게 후회돼. 할 수 있었다면 모두를 구했을 테지. 죽은 자들에게는 슬픈 일이지만 그들을 돕는 것과 알도리를 "
"돕는 것 사이에서 결정을 내려야 했어. 내가 잘못 선택한거라면 용서해줘.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Answer_0049_Text
msgctxt "953b7c20-7d45-4358-9100-3fc8a68d60eb"
msgid ""
"\"Heartless? So what? I'm not going to worry about guards' lives when their "
"ruler's life is at stake!\""
msgstr "\"냉정하다고? 그래서? 통치자의 목숨이 경각에 달렸는데 한낱 경비병의 목숨 따위가 그렇게 중요한가?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Answer_0087_Text
msgctxt "5fb6348b-e946-4fff-b8d2-b757521f91ba"
msgid ""
"[Take the ring from your pocket] \"You mean this ring? The one YOU gave me?!"
"\""
msgstr "[주머니에서 반지를 꺼낸다] \"이 반지? '네가' 나에게 준 이 반지를 말하는건가?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Answer_0088_Text
msgctxt "aaf3f28f-5d76-441b-a306-818066e41316"
msgid "[Show your hands] \"What ring? What are you talking about?\""
msgstr "[손을 보여준다] \"반지? 대체 무슨 소리를 하는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0004_Text
#. Speaker : JamandiAldori_Fight
msgctxt "6ef8bba0-c11a-42e0-8622-85d029b9c666"
msgid ""
"{n}As Jamandi catches her breath, she looks over the trashed banquet hall "
"and salutes the survivors.{/n} \"Thank you for your valor and bravery! The "
"enemy was strong, but you were stronger. And that means I made the right "
"choice! Just as I thought, there were worthy leaders among you — {Name} and "
"Tartuccio, to be precise. I'm especially grateful to them for the courage "
"and common sense they showed while defending the mansion... But this attack "
"means we have even less time than I'd thought. Someone already knows of our "
"plans and is acting against us. You'll begin your expedition immediately.\""
msgstr ""
"{n}자만디는 호흡을 가다듬으며 부서진 연회장을 훑어보곤 생존자들에게 경의를 표합니다.{/n} \"그대들의 무용과 용기에 감사합니다! "
"적은 강했지만 그대들은 더 강했습니다. 이로써 제가 제대로 된 사람들을 구했다는 게 확실해졌군요! 제 생각대로, 여러분들 중에 가치 있는 "
"지도자가 있었습니다. 정확히 말하면 {Name}와 타투치오 말입니다. 그들이 저택을 지키면서 보여준 용기와 상식에 대해 큰 감사를 "
"전합니다... 하지만 이 공격은 저희가 예상했던 것보다 훨씬 시간이 촉박하다는 것을 의미합니다. 누군가가 이미 우리의 계획을 알아채고 "
"견제하고 있어요. 즉시 원정을 시작해야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0005_Text
#. Speaker : Valerie_Companion
msgctxt "4a71ddaa-adb5-479a-a322-a51c1ad9a019"
msgid ""
"\"Lady Aldori...\" {n}Valerie bows respectfully to the "
"{g|Swordlords}swordlord{/g}.{/n} \"Most of those who were to set off for the "
"{g|Stolen Lands}Stolen Lands{/g} have been killed. Those who yet live will "
"require help. Please allow me to join the expedition.\""
msgstr ""
"\"알도리님...\" {n}발레리는 공손히 {g|Swordlords}소드로드{/g}에게 고개를 숙입니다.{/n} \"{g|Stolen "
"Lands}도둑맞은 땅{/g}으로 가려던 대부분의 사람들이 죽었습니다. 살아남은 이들에게는 도움이 필요합니다. 제가 이 여정에 참여할 수 "
"있도록 허락해주십시오.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0006_Text
#. Speaker : JamandiAldori_Fight
msgctxt "050dde59-30e5-494d-842c-b4030db2d229"
msgid ""
"\"I'm sad to lose such a talented warrior, but you're right, Valerie. They "
"have greater need of you right now. Go, and may {g|Abadar}Abadar{/g} keep "
"you. Which of the two teams would you prefer to accompany?\""
msgstr ""
"\"재능있는 전사를 잃는 것은 슬프지만.. 발레리, 그대의 말이 옳다. 지금 그대를 더 필요로 하는 것은 이들인 것 같구나. "
"{g|Abadar}아바다르{/g}께서 그대를 지키시기를. 두 팀 중 어느 쪽과 동행하겠나?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0008_Text
#. Speaker : Tartuccio_Companion
msgctxt "312ecf06-6bfc-4bd4-9dff-9d7ff5863951"
msgid ""
"\"Lady Aldori! Please, I know who arranged this attack. The vile king of "
"{g|Pitax}Pitax{/g}, Irovetti! What's more, I know who among us works for "
"him...\" {n}After a dramatic pause, Tartuccio points a finger toward you.{/n}"
" \"{Name}! Show everyone the ring you're wearing! You think I wouldn't "
"recognize Irovetti's seal? That's why {mf||s}he wasn't killed — the bandits "
"recognized {mf|him|her} as one of their own by this signet ring!\""
msgstr ""
"\"알도리님! 이 공격의 주모자가 누구인지 알고 있습니다. {g|pitax}피탁스{/g}의 비열한 왕, 이로베티가 분명합니다! 무엇보다 "
"저는 우리 중 누가 그놈의 앞잡이인지도 알고 있습니다.\" {n}극적인 침묵이 흐르고, 타투치오의 손가락은 당신을 가리킵니다.{/n} \""
"{Name}! 반지를 보여라! 내가 이로베티의 인장을 알아보지 못할 줄 알았더냐? 도적들이 그 인장 반지를 알아봤기 때문에 "
"{mf|그|그녀}가 살아남을 수 있었던 겁니다!“"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0009_Text
#. Speaker : JamandiAldori_Fight
msgctxt "af1d261a-e9b3-4256-9358-aa14bacdeb3a"
msgid ""
"{n}Jamandi draws her sword.{/n} \"Not another move, or I'll kill you where "
"you stand!\""
msgstr "{n}자만디가 검을 뽑는다.{/n} \"한 발짝이라도 움직이면 그 자리에서 죽이겠다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0015_Text
#. Speaker : JamandiAldori_Fight
msgctxt "c063f5ef-1028-4913-9228-d20b7368e24b"
msgid ""
"\"Yes, such a gambit would be typical of Irovetti and his {d|c0 Keep "
"Ring}henchmen{/d}... And yet, it still seems suspicious.\""
msgstr ""
"\"예, 그런 수작은 이로베티와 그의 {d|c0 Keep Ring}하수인{/d}들의 전형적인 수법이죠... 그러나 아직, 여전히 "
"의심스러운 점이 있습니다. \""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0016_Text
#. Speaker : JamandiAldori_Fight
msgctxt "b8979854-1c15-426b-abcc-cfb194c17e09"
msgid ""
"\"In the middle of the attack, he took off the very {d|c0 Keep Ring}ring{/d} "
"that would guarantee his safety just to set you up? Possible, but not "
"convincing.\""
msgstr ""
"\"공격이 한창일 때, 그는 단지 당신을 함정에 빠뜨리기 위해 자신의 안전을 보장할 바로 그 {d|c0 Keep Ring}반지{/d}를 "
"뺐다고? 그럴 수도 있겠지만 설득력이 없군요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0017_Text
#. Speaker : JamandiAldori_Fight
msgctxt "3063a4fd-0996-4384-86c1-9c9831cff024"
msgid "\"Probably, yes, but this evidence is circumstantial at best.\""
msgstr "\"아마 당신 말이 맞을겁니다. 하지만 이 증거는 기껏해야 정황증거일 뿐이죠.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0020_Text
#. Speaker : JamandiAldori_Fight
msgctxt "82d4d4da-37a7-42b0-a2d9-ed07a2c16dcb"
msgid ""
"\"There's definitely a spy among us, but who? Tartuccio, or {Name}? All I "
"have is one word against another. I'm afraid you're both under suspicion.\""
msgstr ""
"\"그렇지만 이 중에 스파이가 있다는건 분명하군요. 그렇다면 누구죠? 타투치오? 아니면 {Name}? 제 생각엔 둘다 의심스럽군요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0021_Text
#. Speaker : Tartuccio_Companion
msgctxt "46dfa11f-ae0f-44fc-865d-1782fd46dd1d"
msgid ""
"\"Lady Aldori, don't listen to this thick-headed barbarian — she doesn't "
"know what she's talking about! During the attack, {Name} showed {mf|his|her} "
"true colors! {mf|He|She} forced us to break into the armory and rob it!\""
msgstr ""
"\"알도리님, 이 무식한 야만인의 말은 듣지 마십시오. 자기가 무슨 말을 하고 있는지도 모를겁니다! 습격이 일어난 와중에 "
"{Name}은(는) {mf|그의|그녀의} 본색을 드러냈습니다. 병기고에 들어가서 그곳을 털라고 강요했지요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0023_Text
#. Speaker : Tartuccio_Companion
msgctxt "10da89e8-d5b0-4804-82df-89867365f4bc"
msgid ""
"\"And not just that, upon finding the guards' salaries in the armory, {mf||s}"
"he immediately {d|c0 took money}pocketed{/d} it all!\""
msgstr ""
"\"그 뿐만이 아닙니다. 병기고에서 경비병의 봉급을 찾아내자 이 녀석은 즉시 모든 돈을 자기 {d|c0 took money}주머니{/d}"
"에 챙겼다구요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0024_Text_String
#. Speaker : JamandiAldori_Fight
msgctxt "a8f9df50-3d9c-49a0-8e8b-1f4cf9f16bf0"
msgid "\"Considering the circumstances, that was more than reasonable.\""
msgstr "\"상황을 고려하면 그것은 합리적인 행동이었다고 봅니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0029_Text_String
#. Speaker : JamandiAldori_Fight
msgctxt "85a61fac-0102-4600-9e78-87127a898150"
msgid ""
"\"An attack is no reason to break into rooms in someone else's house and "
"pocket their property.\""
msgstr "\"공격을 당했다고 누군가의 집으로 가서 재산을 훔치는 게 정당화되지 않아요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0035_Text
#. Speaker : JamandiAldori_Fight
msgctxt "676043c2-10b6-4694-9b5f-d4d51b9ee927"
msgid "\"Any thief caught red-handed would say the same.\""
msgstr "\"현행범으로 잡힌 도둑은 누구나 그렇게 말하겠죠.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0038_Text
#. Speaker : JamandiAldori_StartPrologue
msgctxt "3d26491f-c252-4ee3-8063-76f48c4751d8"
msgid "\"Thank you for trying to help my people.\""
msgstr "\"제 사람들을 도와주셔서 감사합니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0039_Text
#. Speaker : JamandiAldori_Fight
msgctxt "0783906a-4744-4ade-a585-2e5797803844"
msgid ""
"\"I'll be the judge of how my guards have handled their responsibilities. "
"Please return the money now.\""
msgstr "\"경비병이 책임을 다했는지에 대한 판단은 제 몫입니다. 당장 돈을 돌려주세요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0040_Text
#. Speaker : JamandiAldori_Fight
msgctxt "04961f97-8533-485b-a754-6ef38fd08dca"
msgid ""
"\"I see you don't scare easily! You'll do well in the {g|Stolen Lands}Stolen "
"Lands{/g}. But I'm going to have to ask you to return the money.\""
msgstr ""
"\"당신이 쉽게 겁먹지 않는다는건 잘 알겠습니다 ! 당신은 {g|Stolen Lands}도둑맞은 땅{/g}에서도 잘 할 수 있겠죠. "
"하지만 돈은 돌려주셔야겠어요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0041_Text
#. Speaker : Tartuccio_Companion
msgctxt "7e4a58fd-7522-4048-ab9b-ba3d5702c576"
msgid ""
"\"What about that trick {mf||s}he pulled right before we came in here?\""
msgstr "\"그럼 여기 도착하기 직전에 했던 짓은 뭐라고 변명할거지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0042_Text
#. Speaker : Tartuccio_Companion
msgctxt "94d45595-25e2-4d06-80f9-cdd2ae18c410"
msgid ""
"\"{mf|He|She} knew very well you were fighting the enemy, but instead of "
"rushing to help you, {mf||s}he dallied as long as {mf||s}he could! Dropping "
"everything to {d|c0 Saved People}save{/d} people from the fire, even though "
"the guards were handling things just fine! {Name} was obviously hoping to "
"show up too late and find you already dead!\""
msgstr ""
"\"{mf|그|그녀}는 당신이 적과 싸우고 있다는 것을 잘 알고 있었지만 서둘러 도우러 가는 대신 최대한 시간을 끌었습니다. 분명 다른 "
"경비병들이 알아서 처리할 수 있는데도 불구하고 불 속에서 사람을 {d|c0 Saved People}구하는 것{/d}에만 신경을 썼죠. "
"분명 {Name}은(는) 너무 늦게 나타나서 이미 죽어버린 당신을 기대했을겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0043_Text
#. Speaker : Tartuccio_Companion
msgctxt "b005203f-41cb-4da6-88c6-26aef1dbe780"
msgid ""
"\"Some scoundrels set your mansion on fire, and as we were approaching the "
"room, we saw your brave guards — your underlings! — dying in the fire, "
"begging to be saved! And what did {Name} do? {mf|He|She} {d|c0 Let People "
"Burn}passed{/d} right on by, mercilessly leaving them to their fates! Simply "
"heartless!\""
msgstr ""
"\"어떤 악당들이 저택에 불을 질렀고, 저희가 그곳을 지나갈 때 저희는 용감한 경비병들을 봤습니다. 당신의 부하들 말이에요! 그들은 불 "
"속에서 죽어가며 살려달라고 빌었습니다! 하지만 {Name}은 어떻게 했죠? {mf|그|그녀}는 무정하게도 그들을 {d|c0 Let "
"People Burn}지나쳐서{/d} 죽게 두었습니다! 무자비한 냉혈한이죠.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0054_Text
#. Speaker : JamandiAldori_Fight
msgctxt "9db1c32c-1d6e-4511-99ab-83ae6e727e37"
msgid "\"Cruel, but true.\""
msgstr "\"잔인한 말이지만 맞는 말입니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0055_Text
#. Speaker : JamandiAldori_Fight
msgctxt "a797942e-aa99-40c6-a411-ff48e58adc3b"
msgid ""
"\"Really, Tartuccio? You're seriously trying to blame {Name} for saving "
"people from a fire?\""
msgstr "\"진심인가요, 타투치오? 지금 불 속에서 사람들을 구한 {Name}의 행동을 정말로 비난하려고 하는 건가요?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0056_Text
#. Speaker : JamandiAldori_Fight
msgctxt "7de01618-2ad3-4bf8-aa9f-3f10437886f9"
msgid ""
"\"Trying to save others is commendable, but Tartuccio's right — you were "
"needed here more.\""
msgstr ""
"\"타인을 구하기 위해 노력한 것은 칭찬받을 만하지만 타투치오의 말 역시 옳습니다. 당신의 도움이 더 필요했던 것은 여기였으니까요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0057_Text
#. Speaker : JamandiAldori_Fight
msgctxt "fccc83ca-4c62-4950-8399-db35212c0a3d"
msgid ""
"\"You're talking about living people, {Name}, not pawns on a game board.\""
msgstr "\"그대는 지금 살아있는 사람들에 대해 이야기하고 있는 겁니다. {Name}. 게임판의 말이 아니라.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0058_Text
#. Speaker : JamandiAldori_Fight
msgctxt "82d541b0-e18f-483a-b8f9-f465cbbff46d"
msgid ""
"\"Alas, sometimes such decisions must be made. Don't blame yourself — you "
"did the right thing.\""
msgstr "\"때로는 그런 결정이 내려져야 합니다. 스스로를 비난하지 마세요. 옳은 일을 하신 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0059_Text_String
#. Speaker : JamandiAldori_Fight
msgctxt "eafc982b-21ca-40b8-9621-5f2ed4a0da27"
msgid ""
"\"Leaving them to die bought you mere minutes. Believe me, I would have held "
"on until your arrival.\""
msgstr ""
"\"그들을 죽게 내버려 둔 것으로 번 시간은 아주 잠깐에 불과합니다. 병사들을 구했다고 해도 당신이 올 때까지 저는 충분히 버텼을 겁니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0060_Text
#. Speaker : JamandiAldori_Fight
msgctxt "abcf0d05-3dbf-4d8e-b4da-33084fc37613"
msgid ""
"\"It's a cruel reality, but on the battlefield, sometimes such decisions "
"have to be made.\""
msgstr "\"잔인한 현실이지만 전장에서 때로는 그러한 결정을 내려야만 하죠.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0062_Text
#. Speaker : JamandiAldori_Fight
msgctxt "840d2aac-596f-401d-9512-55f755b7c19b"
msgid ""
"\"Enough squabbling. I'm still not sure which of you I can trust. However, "
"the risk of entrusting the whole affair to a spy is too great. Here's what "
"we'll do — two teams will head out. One will be headed by Tartuccio, and the "
"other by {Name}. That way, I'll know at least one group can be counted on to "
"serve my interests in the {g|Stolen Lands}Stolen Lands{/g}!\""
msgstr ""
"\"말다툼은 이제 충분합니다. 아직 둘 중 누구를 믿어야 할지 확신이 서지 않는군요. 그러나 스파이가 이 일을 맡게 될 위험은 너무나도 "
"큽니다. 그러니 두 팀으로 나누죠. 하나는 타투치오가 이끌고, 다른 하나는 {Name}이 이끌 것입니다. 적어도 한 팀은 제 기대에 "
"부응해서 {g|Stolen Lands}도둑맞은 땅{/g}에서 활약하겠죠!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0063_Text
#. Speaker : Valerie_Companion
msgctxt "f14849a3-e24c-4db8-8a4b-a1584e753cd2"
msgid ""
"\"If {Name} allows, I would join {mf|his|her} team. {mf|He|She} seems a "
"worthy commander in my eyes.\""
msgstr ""
"\"{Name}만 허락한다면 {mf|그|그녀}의 팀에 합류하고 싶어요. 내가 보기에 {mf|그|그녀}는 훌륭한 지도자 같으니까요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0064_Text
#. Speaker : Valerie_Companion
msgctxt "76f13c47-398c-4e23-83de-ce832993ac42"
msgid ""
"\"If Tartuccio allows, I would join his team. Forgive me, {Name}, but I "
"don't appreciate your {d|c0 You Chaotic}willfulness{/d}.\""
msgstr ""
"\"타투치오가 허락한다면 그의 팀에 합류하겠습니다. {Name}. 미안하지만 당신의 {d|c0 You Chaotic}제멋대로인 행동{/d}"
"에는 동감할 수가 없군요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0065_Text
#. Speaker : Harrim_Companion
msgctxt "9a81a1f8-22a4-4e13-9cbb-ba95e418cbf3"
msgid ""
"\"And I like {Name}! What wisdom lies in minding orders, laws, and rules in "
"the face of oblivion, knowing not whether you'll be alive tomorrow? I will "
"go with {mf|his|her} team.\""
msgstr ""
"\"나는 {Name}에게 가겠다! 내일 죽을지도 모르는 상황에서 법 따위를 누가 상관하겠어? 나는 {name}의 팀에 합류하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0066_Text
#. Speaker : Harrim_Companion
msgctxt "ad8986d8-6775-4400-92a0-42dbe8405d6c"
msgid ""
"\"Commanders, military leaders... All these {d|c0 You Lawful}laws and "
"rules{/d} are but dust and vanity. I suppose I will accompany Tartuccio.\""
msgstr ""
"\"지휘관이니 전술적 지도자니... 이 모든 {d|c0 You Lawful}법과 규칙{/d}은 그저 먼지와 허영에 불과하네. 난 "
"타투치오와 동행해야겠군.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0067_Text
#. Speaker : Jaethal_Companion
msgctxt "49db7f61-1bad-4ed8-bfda-ca173200d4d7"
msgid ""
"\"I like how {Name} does things — efficient and without unnecessary "
"spiritual agonizing. I'll go with {mf|him|her}.\""
msgstr ""
"\"나는 {Name}의 효율적이고 불필요한 고민을 하지 않는 일처리 방식이 마음에 들어. 난 {mf|그|그녀}와 같이 가겠어.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0068_Text
#. Speaker : Jaethal_Companion
msgctxt "61543dc3-530c-4c77-8404-c0734fad8ab7"
msgid ""
"\"{Name} is good in battle, but I don't like all the {d|c0 You Good}"
"spiritual agonizing{/d}. I prefer those who can act without wasting time "
"helping every little pipsqueak. Those like Tartuccio.\""
msgstr ""
"\"비록 {Name}의 실력은 출중했지만 {mf|그|그녀}가 보인 그런 {d|c0 You Good}불필요한 고민{/d}은 마음에 들지 "
"않아. 나는 매번 하찮은 남들을 구하는데 시간을 낭비하지 않고 행동하는 사람이 더 낫다고 보거든. 예를 들면 타투치오와 같은 자 말이지."
"\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0069_Text
#. Speaker : Linzi_Companion
msgctxt "1d15d26a-fcc8-474d-9ab0-4b3a2117a743"
msgid ""
"\"Oh, Tartuccio's going to take the credit for himself and be done with it! "
"{g|Shelyn}Shelyn{/g} spare me from such allies! {Name}, I'm going with you. "
"You're a hero worthy of my quill!\""
msgstr ""
"\"하. 타투치오는 모든 공을 독차지하고 입을 싹 닫을걸요! {g|Shelyn}셸린{/g}이시여. 제발 그런 동료와 함께 하는 일이 "
"없기를! {Name}. 저는 당신과 갈래요. 당신은 제 이야기에 걸맞는 영웅이니까요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0070_Text
#. Speaker : Linzi_Companion
msgctxt "0bb190e5-4ec4-4793-bfa8-10145f543dc9"
msgid ""
"\"Efficient? I'd say {d|c0 You Evil}heartless{/d}! Would the protagonist of "
"my book do such a thing? No — I guess I'd better go with Tartuccio.\""
msgstr ""
"\"효율적이라구요? 그게 아니라 {d|c0 You Evil}비정{/d}한 거죠! 내 책의 주인공이 그런 일을 하다니 말도 안 돼! 차라리 "
"타투치오와 함께 가는 게 낫겠어요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0071_Text
#. Speaker : JamandiAldori_Fight
msgctxt "d11315f5-8a10-4822-9731-a210a7f53c50"
msgid ""
"\"All right. We have two teams. To avoid unnecessary conflict on the road, "
"you'll each take a different route to the {g|Stolen Lands}Stolen Lands{/g}. "
"Tartuccio's team will go through {g|Nivakta's Crossing}Nivakta's Crossing{/g}"
" — the garrison commandant will provide him all the help he needs. {Name} "
"will take {mf|his|her} team to {g|Oleg's Trading Post}Oleg Leveton's trading "
"post{/g} — he's been complaining about the Stag Lord's bandits for a while "
"now. There, you'll be provided with all the necessary travel supplies.\""
msgstr ""
"\"좋습니다. 두 팀으로 나눠졌군요. 길에서 불필요한 충돌을 피하기 위해 {g|Stolen Lands}도둑맞은 땅{/g}으로 가는 각기 "
"다른 경로를 택하게 할 겁니다. 타투치오 팀은 {g|Nivakta's Crossing}니박타의 교차로{/g}로 가십시오. 주둔군 지휘관이 "
"여러분에게 필요한 모든 도움을 제공할 겁니다. {Name}은(는) 팀을 이끌고 {g|Oleg's Trading Post}올렉의 "
"교역소{/g}로 가십시오. 요즘 수사슴 군주의 도적들 때문에 골머리를 썩이고 있다더군요. 거기서 여정에 필요한 물건들을 제공받을 수 있을 "
"것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0072_Text
#. Speaker : JamandiAldori_Fight
msgctxt "c93f06bb-f884-4211-bb4b-473d2c48dfa9"
msgid ""
"\"{Name}, I'd like to believe you, but I know all too well how convincing "
"traitors and spies can be. If you're truly innocent, I hope you can forgive "
"me this precaution.\""
msgstr ""
"\"{Name}. 당신을 믿고 싶지만 배신자들과 스파이들이 설득에 능하다는건 너무나 잘 알고 있습니다. 당신이 정말 결백하다면, 이런 "
"예방 조치를 취하는 저를 용서하기 바랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0073_Text
#. Speaker : JamandiAldori_Fight
msgctxt "9b3db6d6-ee71-4082-818a-4d3c3cd78f69"
msgid ""
"\"And now — farewell! This battle was but the first ordeal along your path, "
"and you overcame it as true champions of {g|Restov}Restov{/g}. May the "
"obstacles that follow also fall to your feet! Fear nothing, my friends, and "
"return victorious!\""
msgstr ""
"\"그리고 이제 작별 인사를 해야겠군요! 이 전투는 이번 여정의 첫 번째 시련에 불과하지만, 여러분은 {g|Restov}레스토프{/g}의 "
"진정한 챔피언으로서 극복했습니다. 날아오는 화살도 여러분을 피해가기를 빕니다! 두려워하지 마세요. 그리고 승리해서 돌아오십시오!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0074_Text
#. Speaker : Amiri_Neutral
msgctxt "43cddbdb-4c45-4533-be04-003793e737e7"
msgid ""
"\"I don't even need to think! {Name}, I'm coming with you. As for you, "
"purple toad, just wait till we meet along the way — I'll be sure to hang "
"your rotten spy guts from the trees!\""
msgstr ""
"\"생각할 필요도 없어! {Name}, 난 너랑 간다. 그리고 보라색 두꺼비, 넌 조금만 기다리라고. 네놈의 썩어빠진 내장을 나무에 "
"줄줄이 걸어버릴 테니까!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0076_Text 1_String
#. Speaker : Valerie_Companion
msgctxt "1f5a4052-ac70-4678-9aa7-926b0ef4962f"
msgid ""
"\"That was a sound decision. Sometimes one must act at one's own risk and "
"peril. Until crossing the boundaries of what is allowed, showing initiative "
"is no crime.\""
msgstr "\"그건 올바른 결정이었습니다. 때로는 스스로 위험을 감수할 필요가 있죠. 도를 넘지 않는 한, 빠른 결단은 죄가 아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0076_Text_String
#. Speaker : Valerie_Companion
msgctxt "fc539185-1d80-4f02-8b2e-f905378f8aac"
msgid "{n}Valerie nods in approval.{/n} \"Prudent and devoted.\""
msgstr "{n}발레리는 긍정의 뜻으로 고개를 끄덕입니다.{/n} \"신중하고 헌신적이군요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0077_Text_String
#. Speaker : Harrim_Companion
msgctxt "6691c8fb-364f-4b29-9442-99bb87e38f44"
msgid ""
"\"Is it not insane to be faced with death and stop to question whether you "
"may be breaking some law or rule? {Name} acted wisely.\""
msgstr "\"당장 죽을지도 모르는데 법을 어기는 게 그리 미친짓인가? {Name}의 행동은 현명했다네.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0079_Text
#. Speaker : Harrim_Companion
msgctxt "20ed44f4-e97b-4bdf-9b65-881c5702ef84"
msgid ""
"\"Of course, theft is not to be condoned... But when the fire burns around "
"you and you are but one step away from death, would it not be insane to "
"worry about laws and rules? I see this act not as a crime, but as a unique "
"wisdom visiting us as we stood at the face of oblivion...\""
msgstr ""
"\"도둑질은 용서받을 수 없다. 하지만 불이 사방에서 타오르고 죽음에 직면해있을 때 법과 규칙에 대해 걱정하는 것이 정신 나간 짓이 "
"아닌가? 나는 이 행동을 범죄로 보지 않아. 위기에 처한 우리에게 찾아온 지혜라고 해두지...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0080_Text_String
#. Speaker : Jaethal_Companion
msgctxt "33d3e36e-e692-4a1d-89e8-124bb865d23d"
msgid "\"It was perfectly reasonable. Just the way a leader should think.\""
msgstr "\"그가 한 행동은 합리적이었다. 그 누구보다 리더다웠지.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0081_Text_String
#. Speaker : Linzi_Companion
msgctxt "0590a07e-171a-4225-a4f3-42e3f01bf9f9"
msgid ""
"\"May {g|Shelyn}Shelyn{/g} spare me from ever having to make such a "
"choice... But {Name} behaved decently, as a true leader!\""
msgstr ""
"\"{g|Shelyn}셸린{/g}이시여, 부디 저를 그런 가혹한 선택의 기로에 서지 않게 하시길... 그런 선택 앞에서도 {Name}의 "
"행동은 진짜 지도자다웠어요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0083_Text
#. Speaker : JamandiAldori_Fight
msgctxt "e3f5a6ed-674e-4f04-8564-567c0a6a623c"
msgid ""
"\"While you're away, Kesten will investigate the night's events and learn "
"who in {g|Restov}Restov{/g} is working for {g|Pitax}Pitax{/g}. But you "
"should know that it isn't just Pitax we need to worry about — {g|House "
"Surtova}the Royal House of Surtova{/g} may also interfere in our plans. I've "
"managed to keep this affair a secret from them so far, but that can't last "
"long. By my estimations, you have no more than three months. After that, any "
"feats you accomplish will be pointless.\""
msgstr ""
"\"여러분이 떠나 있는 동안 케스턴은 누가 {g|pitax}피탁스{/g}의 스파이인지 조사할 것입니다. 하지만 우리가 걱정해야 할 것은 "
"피탁스뿐만이 아닙니다. {g|House Surtova}서토바 가문{/g}의 방해가 있을지도 몰라요. 지금까지 그들이 이 일에 대해 알지 "
"못하도록 해왔지만 오래가지는 못할 겁니다. 아마 3개월 정도밖에 시간이 없을 거예요. 그들이 알게 된다면, 당신이 어떤 업적을 세웠건 "
"모두 물거품이 될 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0084_Text
#. Speaker : Amiri_Neutral
msgctxt "f0035e8d-1722-4b63-829a-9962df3dc682"
msgid ""
"\"I bet my life the spy's anyone but {Name}! I saw how {mf||s}he dealt with "
"those creeps with my own eyes! A true warrior — I'd go with {mf|him|her} "
"through hell and high water! This purple crook, on the other hand...\" {n}"
"Amiri spits on the floor with contempt.{/n} \"He's got the eyes of a spy! "
"And the mug of a spy!\""
msgstr ""
"\"{Name}이(가) 스파이가 아니라는데에 내 목을 걸지! 나는 {mf|그|그녀}가 암살자 놈들을 쳐죽이는것을 똑똑히 보았어. 진정한 "
"전사의 모습이었지. 이런 전사와 함께라면 지옥 끝까지라도 갈 수 있어! 하지만 이 보라색 사기꾼은... \" {n}아미리는 경멸로 바닥에 "
"침을 뱉습니다.{/n} \"이놈은 스파이의 눈을 가졌어! 얼굴이 딱 스파이상 이라고!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0085_Text
#. Speaker : JamandiAldori_Fight
msgctxt "ca0531fc-12aa-4fb8-85e1-95bab41a98a3"
msgid ""
"\"Tartuccio, your words are quite convincing, but I can't afford to trust "
"words alone. If you're really innocent, I hope you'll prove it with your "
"deeds.\""
msgstr "\"타투치오, 당신의 말은 꽤 설득력이 있지만 말만으로는 믿을 수가 없습니다. 정말로 결백하다면 행동으로 증명하세요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0089_Text
#. Speaker : Tartuccio_Companion
msgctxt "51e97550-9ffe-4ceb-86a3-358a1d4385b8"
msgid ""
"\"Lady Aldori, I saw it all with my own eyes! The ring must be in "
"{mf|his|her} pocket! Search {mf|him|her}, and I'm sure...\""
msgstr ""
"\"알도리님, 제 눈으로 모든 것을 보았습니다! 분명 반지가 {mf|그|그녀}의 주머니 안에 있을 겁니다! 수색해 보면 정말로...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0090_Text
#. Speaker : JamandiAldori_Fight
msgctxt "3e528fae-b56c-4dd3-a2f0-70714f9c8541"
msgid ""
"\"Enough, Tartuccio. I'm still the one giving orders here. We won't be "
"searching anyone.\""
msgstr "\"그만하세요. 타투치오. 나는 여전히 이곳의 명령권자이며, 우리는 그 누구도 수색하지 않을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0091_Text_String
#. Speaker : Linzi_Companion
msgctxt "37e1024f-73a2-41a0-a6bc-83b4e18f67ac"
msgid ""
"\"{Name}, how could you say such a monstrous thing?! Is that the way the "
"hero of my book would talk? You sound more like a villain!\""
msgstr ""
"\"{Name}, 어떻게 그런 끔찍한 말을 할 수가 있죠? 내 책의 주인공이 이런 말을 하다니... 당신의 말은 오히려 악당처럼 들리네요!"
"\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0093_Text
#. Speaker : Harrim_Companion
msgctxt "edd0a527-a830-42b2-8cd6-f391e5d0e872"
msgid ""
"\"Of course, theft is not to be condoned... However, when the fire burns "
"around you and you are but one step away from death, is it not insane to "
"worry about laws and rules?\""
msgstr ""
"\"물론 도둑질은 용서받을 수 없어... 그러나 사방이 타 오르고 죽음이 눈앞에 있을 때 법과 규칙을 걱정하는 것은 정신 나간 짓이 "
"아닌가?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0095_Text_String
#. Speaker : Harrim_Companion
msgctxt "39788a2c-d647-4154-a8a0-36970ca25022"
msgid ""
"\"It is insane when faced with death to stop and question whether you may be "
"breaking some law or rule. Even more insane would be to ask forgiveness for "
"making the right decision. Sorry, {Name}, but your words display a lack of "
"wisdom.\""
msgstr ""
"\"죽을지도 모르는 상황에서 법을 어겼는지 따지고 있는 건 어리석은 짓이 맞네. 하지만 그런 올바른 결정을 내렸음에도 용서를 구하는 것은 "
"더더욱 어리석은 짓이지. 미안하지만, {Name}, 그대의 언행은 이치에 맞지 않네.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0098_Text_String
#. Speaker : Valerie_Companion
msgctxt "532a7e35-5371-4983-a45a-b4ae8dd6495b"
msgid ""
"\"There is a difference between taking initiative in battle and blatant "
"arrogation. How can one who disregards authority be a leader "
"{mf|him|her}self?\""
msgstr "\"전장에서의 결단과 뻔뻔한 도둑질은 분명히 다릅니다. 권위를 함부로 무시하는 사람이 어떻게 지도자가 될 수 있겠습니까?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0100_Text_String
#. Speaker : Jaethal_Companion
msgctxt "e2a4a619-0e7f-483c-b1b1-03a7d5c61db3"
msgid ""
"\"A true leader is someone who has their priorities straight, not someone "
"who would put a valuable ally's life in danger for the sake of some servant."
"\""
msgstr ""
"\"진정한 지도자란 무엇이 중요한지에 대한 지각이 있는 사람이지. 하인들이나 구하기 위해 소중한 아군의 목숨을 거는 사람이 아니야.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0104_Text
#. Speaker : Kalikke_Capital_prologue
msgctxt "27b888ea-7aaa-48b3-830c-7825a8bd3b82"
msgid ""
"\"They both came to your aid, Lady Jamandi... But a liar's cunning knows no "
"bounds. I've never met these two, or their companions. For all I know, "
"they're all conspiring spies.\""
msgstr ""
"\"그 두명 다 당신을 도우러 왔습니다. 자만디. 하지만 거짓말쟁이의 허풍은 끝이 없군요. 여기까지 오는 길에 그 두 사람이나 그들의 "
"동료는 한번도 만나 본 적도 없습니다. 제가 보기에 저들 모두 음모를 꾸미는 스파이들입니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0105_Text
#. Speaker : Linzi_Companion
msgctxt "b8ed8c58-104d-4855-842d-cc67770e148c"
msgid ""
"\"How could you say that?! We fought together... we literally went through "
"fire together! And then you vanished into thin air – after you promised "
"you'd wait!\""
msgstr ""
"\"어떻게 그런 말을 할 수 있어요?! 우리는 함께 싸웠는데... 말 그대로 함께 불을 뚫고 왔다구요!... 당신은 먼저 가서 "
"기다리겠다고 해놓고 대뜸 사라져 버렸잖아요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0106_Text
#. Speaker : Kalikke_Capital_prologue
msgctxt "31a17e27-9761-44bd-9e44-ba54e70758bb"
msgid ""
"{n}The tiefling is obviously embarrassed.{/n} \"My words might be rash...\""
msgstr "{n}티플링은 당황했음이 틀림 없습니다.{/n} \"내 말이 너무 심했나...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/End/Cue_0109_Text
#. Speaker : Kalikke_Capital_prologue
msgctxt "b9bd4183-549e-4a23-8d83-4c0004c0547b"
msgid ""
"\"As for me, I know neither of these two... at least, not well enough. And I "
"have no wish to become an unwitting pawn to a unworthy leader. If Lady "
"Jamandi allows, I'll remain in Restov and help mend the wounds this attack "
"has inflicted. But who knows – the road may bring me to the Stolen Lands... "
"but not yet.\""
msgstr ""
"\"난 둘 다 누군지 몰라... 적어도, 충분히 알지 못하지. 나는 잘 모르는 사람을 생각없이 따라다니고 싶지는 않아. 자만디님께서 "
"허락하신다면 전 레스토프에 남아서 이번 습격의 피해를 수습하는걸 돕고싶어. 도둑맞은 땅은... 아직은 갈 때가 아닌거 같아. 어떻게든 "
"나중에 가게 되겠지.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/FirstDialog_startPrologue/Cue_0001_Text
#. Speaker : Amiri_Neutral
msgctxt "337cb92d-5b21-4b25-848d-af0698f2f30f"
msgid ""
"\"Where are they? This is taking forever! They didn't even say what this was "
"for, just that the Aldori were looking for heroes! Who are the Aldori, "
"anyway? Rich folk?\""
msgstr ""
"\"대체 어디 간거야? 더는 못 기다려! 알도리가 영웅들을 찾고 있다는것 말고는 아무 설명도 못들었다고! 대체 알도리가 누구야? 돈 좀 "
"있는 녀석들인가?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/FirstDialog_startPrologue/Cue_0002_Text
#. Speaker : Tertuccio_StartPrologue
msgctxt "cd58f4ca-940f-45a4-8c14-3c117eb14213"
msgid ""
"\"If you can't be patient, no one's keeping you here — just go back to your "
"mountains, or whatever hole you crawled out of. {g|Swordlords}The Aldori "
"Swordlords{/g} run the premier school for the dueling arts — they're also "
"the richest and most influential group in this part of {g|Brevoy}Brevoy{/g}! "
"Take that tone with them, and they'll teach you some manners pretty quickly!"
"\""
msgstr ""
"\"그렇게 참을성 없게 굴면 누구도 널 여기에 두지 않을걸. 그냥 네 산으로 돌아가거나 원래 있던 동굴 속으로 기어들어가는 게 어때. "
"{g|Swordlords}알도리 소드로드{/g}들은 결투를 위한 최고의 학교를 운영하지. {g|Brevoy}브레보이{/g}에서 가장 "
"부유하고 가장 영향력있는 그룹이기도 하고! 그들 앞에서 입조심하는 게 좋을거야. 안 그러면 그들이 친히 너한테 속성으로 매너를 가르쳐줄 "
"테니!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/FirstDialog_startPrologue/Cue_0003_Text
#. Speaker : Amiri_Neutral
msgctxt "93662454-097b-4872-8de9-793cbbbe176e"
msgid ""
"\"All right, you purple toad, just shut your trap. And if you can't, I'll "
"help you!\""
msgstr "\"좋아. 보라색 두꺼비. 아가리 다물어. 싫다면 내가 직접 닫아주지!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/FirstDialog_startPrologue/Cue_0004_Text
#. Speaker : Linzi_Neutral
msgctxt "36b3f447-0d2e-4f8f-a6cd-3a62b5a180b4"
msgid "\"Hush! Quiet! They're coming.\""
msgstr "\"쉿! 조용히 좀 해요! 그들이 오나 봐요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Answer_0015_Text
msgctxt "c554cb0c-f9e8-4a57-97bd-7bc7eeea45d4"
msgid ""
"\"There's a whole team of us. Who exactly will receive the baron's title?\""
msgstr "\"사람이 이렇게 많은데, 정확히 누가 남작위를 받게 되는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Answer_0021_Text
msgctxt "cc2128b2-8ba0-4bb6-b71b-eb43ae2514b9"
msgid ""
"\"You're helping us found a barony? What do you gain from such generosity?\""
msgstr "\"우리가 남작령을 갖게 도와준다고? 그럼 당신은 무엇을 얻지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Answer_0024_Text
msgctxt "b9c65bf3-dcd8-4cad-a0fe-9580b22feacf"
msgid "\"What rewards can we expect, exactly?\""
msgstr "\"우리가 기대할 수 있는 보상은 무엇이지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Answer_0025_Text
msgctxt "54f818f6-5649-4338-9989-1c0d3a6bbf35"
msgid "\"It's clear as day.\""
msgstr "\"알겠다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Answer_0037_Text_1
msgctxt "968fdc3f-46f4-4652-a369-ecafd9486ae9"
msgid "\"Why not just recognize this Stag Lord as baron?\""
msgstr "\"왜 그냥 수사슴 군주를 남작으로 인정하지 않는 거지?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0003_Text
#. Speaker : IosephSellemius__StartPrologue
msgctxt "d5546c72-da6e-44a9-a507-ec81d6554bbb"
msgid ""
"{n}The mayor — a middle-aged man with bushy sideburns and a monocle — wears "
"a beaming smile.{/n} \"We thank you from the bottom of our hearts for "
"responding to our call. You may be few, but that's unavoidable — we need "
"only the best of the best for this task! And I see true heroes before me, "
"strong and fearless — exactly what {g|Restov}Restov{/g} needs!\""
msgstr ""
"{n}구레나룻이 덥수룩하고 단안경을 쓴 중년 남자 시장은 밝은 미소를 지었습니다.{/n} \"저희의 부름에 응해주신 여러분께 진심으로 "
"감사인사를 드립니다. 수가 많진 않지만, 어쩔 수 없지요. 이 일은 최고 중에 최고가 필요하니까요! 그리고 제 앞에는 강하고 두려움이 "
"없는 진정한 영웅들이 보이는군요. {g|Restov}레스토프{/g}가 필요로하는 그대로입니다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0008_Text
#. Speaker : JamandiAldori_StartPrologue
msgctxt "be9990a8-031f-4a5e-a7de-51d2508eb096"
msgid ""
"\"Greetings, everyone! I am {g|Swordlords}Swordlord{/g} Jamandi Aldori, and "
"this is Lord Mayor Ioseph Sellemius of {g|Restov}Restov{/g}. Welcome to my "
"mansion.\""
msgstr ""
"\"환영합니다, 여러분! 저는 {g|Swordlords}소드로드{/g} 자만디 알도리입니다. 여기는 {g|Restov}레스토프{/g}의 "
"시장이신 요셉 셀레미우스 공입니다. 제 저택에 온 걸 환영합니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0009_Text
#. Speaker : JamandiAldori_StartPrologue
msgctxt "9a4bc5a6-f6db-436a-ab80-9f80f1c763a3"
msgid ""
"\"Thank you, Lord Mayor. Now, to the point. South of here, just beyond "
"{g|Brevoy}Brevoy's{/g} border, lies a region known as the {g|Stolen Lands}"
"Stolen Lands{/g}. This is disputed territory, and while it's long been "
"claimed by nearby states, it's never been truly taken. I won't bore you with "
"the legal technicalities. Suffice to say that anyone with enough courage and "
"power to seize the Stolen Lands and name themselves baron or baroness, "
"claiming dominion — well, none of the neighboring states would be able to "
"challenge it. Of course, {g|Restov}Restov{/g} would be first to recognize "
"the legitimacy of this new state, as well as the noble title of its founder."
"\""
msgstr ""
"\"감사합니다. 시장님. 바로 본론으로 들어가지요. {g|Brevoy}브레보이{/g}의 국경 너머에 있는 {g|Stolen Lands}"
"도둑맞은 땅{/g}이라 불리는 지역이 있습니다. 이곳은 분쟁 지역이며 인근 국가에서 오랫동안 영유권을 주장해 왔지만 진정으로 받아들여지지 "
"않았습니다. 법적인 전문성으로 여러분들을 지루하게 하지는 않겠습니다. 그곳을 점령할 힘과 용기가 있는 자라면 누구나 남작을 지칭하고 "
"그곳의 지배권을 주장하기에 충분합니다. 물론, 그 어떤 주변국도 그것에 대해 이의를 제기하지 않을 것입니다. 당연히, "
"{g|Restov}레스토프{/g}는 가장 먼저 이 새로운 국가의 정당성과 설립자의 고결한 칭호를 인정할 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0012_Text
#. Speaker : JamandiAldori_StartPrologue
msgctxt "dbe9e338-22ae-43bc-b383-f202910c2a01"
msgid ""
"\"Unfortunately, one serious obstacle stands between you and this title — a "
"gang of bandits holds sway in the {g|Stolen Lands}Stolen Lands{/g}. Their "
"chief, who they call the Stag Lord, considers himself the rightful owner of "
"these lands, and no one has yet been able to challenge his power. Bring me "
"his head, and you'll be able to return to the Stolen Lands as their legal "
"ruler. Any questions?\""
msgstr ""
"\"불행히도 당신과 이 작위 사이에는 심각한 장애물이 있습니다. {g|Stolen Lands}도둑맞은 땅{/g}에 있는 수사슴 군주라고 "
"불리는 도적 우두머리는 자신이 이 땅의 정당한 주인이라 자칭하고 있으며, 아직 아무도 그의 권력에 도전하지 못했습니다. 저에게 그의 "
"머리를 가져오면 합법적인 통치자로서 도둑맞은 땅을 지배할 수 있을겁니다. 혹시 질문 있으십니까?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0016_Text
#. Speaker : Tertuccio_StartPrologue
msgctxt "66ddb3ca-691b-4fac-844a-1cd9f309dd51"
msgid ""
"\"I will, of course. I'm the leader of this team, after all! Don't worry, "
"though — I'll make it worth your while to help me!\""
msgstr "\"당연히 내가 되겠지. 내가 바로 이 팀의 리더다. 걱정하지 말도록. 내가 널 쓸모있게 써줄테니!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0017_Text
#. Speaker : Harrim_Neutral
msgctxt "206e8ea7-6901-435b-b958-49fd052671e0"
msgid ""
"\"We haven't yet begun, and you already speak of divvying rewards... What "
"makes you think we'll even succeed? There's little point arguing over who "
"gains the title when we'll most likely lose our lives there...\""
msgstr ""
"\"아직 시작도 안했는데 넌 벌써 보상금 분배에 대해 이야기 하는구만.. 왜 우리가 성공할거라 생각하는 거지? 누가 작위를 받을지는 "
"거기서 죽어갈 때엔 아무런 의미도 없을텐데..\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0018_Text
#. Speaker : JamandiAldori_StartPrologue
msgctxt "377a2987-5899-471b-b9ba-8f3e95b593f8"
msgid ""
"\"We believe you're all equally deserving of a noble title — over the course "
"of your expedition, it will be up to you as a team to decide which of you is "
"best suited to rule.\""
msgstr ""
"\"우리는 당신들 모두 고귀한 칭호를 받을 자격이 있다고 믿습니다. 원정 기간 동안 누가 가장 지도자에 적합한지 결정하는 것은 팀에게 "
"달려있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0022_Text
#. Speaker : Tertuccio_StartPrologue
msgctxt "003bc9d2-7ced-4974-a79d-d2af3c1268e5"
msgid ""
"\"Don't ask stupid questions! Why should you even care? What they have to "
"gain and why... That's for Lady Aldori and I to discuss! It's none of your "
"concern. Your only concern is to swing your sword around, or whatever it is "
"you do!\""
msgstr ""
"\"쓸데없는 질문 좀 하지마! 왜 니가 그걸 신경쓰는거지? 그들이 무엇을 얻을지 왜 얻어야 할지는... 알도리 여사와 내가 논해야 할 "
"것들이다! 네놈이 알아야 할 이유 따윈 없지. 넌 그냥 무식하게 칼만 휘두르면 돼!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0023_Text
#. Speaker : JamandiAldori_StartPrologue
msgctxt "c2b3fd32-7056-4250-abb0-bfb2899ac4e6"
msgid ""
"\"Of course, we stand to benefit from this enterprise. But if you're "
"concerned that we intend to rule your country from afar, using you as a "
"front, please know that these concerns are unfounded. Let's just say that we "
"have a strong interest in the region's stability. We have need of a ruling "
"power we can negotiate with, not bandit gangs and monster hordes.\""
msgstr ""
"\"물론 우리는 이 모험으로부터 이익을 얻을 수 있지요. 하지만 만약 우리가 당신을 앞세워 당신이 세운 국가를 멀리서 통치하는 것이 "
"걱정된다면 이러한 우려는 사실무근이라는 것을 알아두세요. 우리는 그 지역의 안정에만 강한 관심을 가지고 있다는 것만은 알아주셨으면 "
"합니다. 우리는 도적떼나 괴물무리가 아니라 협상할 수 있는 통치 세력이 필요한 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0026_Text
#. Speaker : IosephSellemius__StartPrologue
msgctxt "8c6c976a-f4d3-4083-9ed7-762cb877f0dc"
msgid ""
"{n}The lord mayor's eyebrows rise so far he almost drops his monocle.{/n} "
"\"And what reward would you seek beyond a noble title and your own lands?\""
msgstr ""
"{n}시장의 눈썹은 너무 치켜 올라가서 그의 단안경을 거의 떨어뜨릴뻔했습니다.{/n} \"고귀한 작위와 자신의 땅을 넘는 보상이 있다고 "
"보십니까?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0027_Text
#. Speaker : JamandiAldori_StartPrologue
msgctxt "a824fb0e-ba86-4520-98c0-f37b77db9e3c"
msgid ""
"\"We'll absorb the costs of preparing and equipping your expeditions. Once "
"you return victorious, {g|Restov}Restov{/g} will also allocate you a "
"significant sum to provide financial support for you to establish your "
"country. Essentially, we'll help you build your capital. I hope such a "
"reward is satisfactory?\""
msgstr ""
"\"원정 준비와 필요한 장비에 대한 비용은 저희가 부담할 것입니다. 만약 당신이 승리한다면, {g|Restov}레스토프{/g} 또한 "
"귀하의 국가 설립을 위한 재정 지원을 제공하기 위해 상당한 금액을 귀하에게 할당할 것입니다. 본질적으로 우리는 당신이 스스로 자본을 "
"구축하도록 도울 것입니다. 그러한 보상으로 만족해주셨으면 좋겠군요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0028_Text
#. Speaker : Amiri_Neutral
msgctxt "5e7311fa-330e-4e73-9df9-862b2b45d30a"
msgid ""
"\"Words, words, words... 'Significant,' 'financial'... I can't fill my belly "
"with pretty words!\""
msgstr "\"순전 말뿐이로군... '상당한', '재정'... 이딴 단어들을 들으니 배가 고픈데.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0029_Text
#. Speaker : JamandiAldori_StartPrologue
msgctxt "02a7e689-bf44-4667-a226-afa5832011e6"
msgid ""
"{n}Jamandi smiles.{/n} \"Of course, there will also be an official banquet "
"held in your honor. All of {g|Restov}Restov's{/g} high society will gather "
"to celebrate your feat!\""
msgstr ""
"{n}자만디는 웃습니다.{/n} \"물론 당신의 명예를 위한 공식 연회도 있을 것입니다. {g|Restov}레스토프{/g}의 유명인사들이 "
"모두 모여 당신의 업적을 기릴 것입니다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0030_Text
#. Speaker : Amiri_Neutral
msgctxt "c6cd1e0a-ca20-475f-8560-1895ede082d7"
msgid "\"Now you're talking!\""
msgstr "\"이제 말이 통하는구만!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0036_Text
#. Speaker : JamandiAldori_StartPrologue
msgctxt "ef4b7180-24ca-4114-9eb7-9aaae40af7dc"
msgid ""
"\"Excellent. You venture forth tomorrow. For now, you can take some time to "
"get to know one another better, or you can head straight to your guest rooms "
"to get some rest. You'll find we've already prepared supplies for you there. "
"And thank you again for agreeing to take part in this expedition. I wish you "
"luck!\""
msgstr ""
"\"훌륭합니다. 모험은 내일부터 입니다. 지금은 여러분 서로에 대해 더 잘 알기 위해 시간을 들이시거나, 바로 객실로 가셔서 휴식을 "
"취하시면 되겠습니다. 객실에서 여러분은 저희가 미리 준비한 공급품을 발견하실 겁니다. 이 탐험에 참여하기로 동의해주셔서 다시 한 번 "
"감사드립니다. 행운을 빕니다!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0038_Text_1
#. Speaker : Jaethal_Neutral
msgctxt "74c440fd-e2b9-4f76-8b76-509033cf9b2d"
msgid ""
"\"That's a good point. As I see it, this Stag Lord already holds power over "
"the region with confidence. Many noble bloodlines were started by bandits "
"who just got lucky, weren't they?\""
msgstr ""
"\"좋은 지적이군. 이 수사슴 군주란 녀석은 이미 그 지역에서 상당한 권력을 과시하고 있어. 많은 귀족 혈통들이 사실 운 좋은 도적떼부터 "
"시작하지 않았었나?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0039_Text_1
#. Speaker : JamandiAldori_StartPrologue
msgctxt "75e74cb1-0d7a-4c1e-9089-80a1f945a9a6"
msgid ""
"{n}The {g|Swordlords}swordlord's{/g} gaze is chilling as she responds.{/n} "
"\"Perhaps because we do have standards to maintain. This room has seen many "
"celebrations of adventurers, and even those who 'just got lucky.' But giving "
"a noble title to a bandit lord — that's one thing that's never happened "
"here, and it won't while I still breathe.\""
msgstr ""
"{n}{g|Swordlords}소드로드{/g}는 그녀를 차갑게 쳐다보며 대답합니다.{/n} \"아마도 우리가 유지해야 할 기준이 있기 "
"때문이겠지요. 이 방에는 모험가부터 심지어 '요행을 바라는 승냥이' 까지 많은 이들이 있습니다. 하지만 도적들의 우두머리에게 작위를 "
"준다? 제가 숨이 붙어 있을 때까지는 절대 있을 수 없는 일입니다\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0042_Text
#. Speaker : JamandiAldori_StartPrologue
msgctxt "12e1248c-0ae7-47dd-8a94-5732336b62f6"
msgid ""
"{n}Jamandi clears her throat loudly, interrupting the argument.{/n} \"If I "
"may please answer the question...\" {n}She takes a long pause, waiting for "
"the voices to die down as everyone directs their attention toward her.{/n}"
msgstr ""
"{n}자만디는 크게 헛기침하며 논쟁을 멈춥니다.{/n} \"그 질문에 답하자면...\" {n}그녀는 사람들의 목소리가 잦아들고 그녀에게 "
"주의를 기울일 때까지 기다립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0049_Text
#. Speaker : IosephSellemius__StartPrologue
msgctxt "b6b47c65-83d0-4c9e-9613-7b0d193bba26"
msgid ""
"\"Thank you again, with all my heart, for replying to this call! The flare "
"in your eyes reveals your courage, the unshakable will that distinguishes "
"true heroes! I look at you, oh champions of {g|Restov}Restov{/g}, and doubt "
"not for a second that you'll be victorious. So venture forth toward your "
"feat — go, and return in triumph!\""
msgstr ""
"\"다시 한번 이 부름에 응답한 것에 대해 진심으로 감사드립니다! 여러분의 눈에서 불길이 타올라 용기를 드러내는군요. 진정한 영웅을 "
"구별하는 흔들리지 않는 의지가 여러분에게 보입니다. 오. {g|Restov}레스토프{/g}의 영웅들이여. 여러분을 지켜볼겁니다. 여러분이 "
"승리할 것을 절대로 의심하지 않습니다. 위업을 향해 앞장서서 승리를 거두십시오!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/JamandisDialog_Start/Cue_0052_Text
#. Speaker : Kanerah_Capital_prologue
msgctxt "0d5cd393-4ba9-411c-a4fd-2c77c68f0473"
msgid ""
"{n}A tiefling girl is standing nearby, speaking in a hushed voice.{/n} \"What"
" is that smell in the air? Is it the smell of unspoken words and political "
"intrigue?\"{n} Noticing you've heard her comment, she winks at you coyly.{/n}"
msgstr ""
"{n}티플링 소녀가 옆에 서서 허스키한 목소리로 말합니다.{/n} \"이게 무슨 냄새지? 권모 술수의 냄새인가?\" {n}자신의 말을 "
"듣는 당신을 보자 그녀는 윙크합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Answer_0004_Text
msgctxt "9e5a030d-9d31-4b5f-b9f8-a63444d4dc31"
msgid "\"I'm {Name}. Pleased to meet you.\""
msgstr "\"난 {Name}. 만나서 반가워.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Answer_0005_Text
msgctxt "f8ce078d-fb4d-4efc-b53c-7b755671c0e4"
msgid "\"What do you want from me?\""
msgstr "\"나한테 원하는 게 뭐야?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Answer_0008_Text
msgctxt "d643c7a0-5a16-43f7-8886-13d10c9bfc0c"
msgid "\"We sure will! Just wait — we've plenty of great feats in store!\""
msgstr "\"분명 그럴거야! 그저 기다리라고. 수많은 업적이 우리를 기다리고 있으니까!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Answer_0020_Text
msgctxt "da311e19-6059-4d1d-9021-9cc97f9dcc0f"
msgid "\"Wait, a book?\""
msgstr "\"잠깐, 책이라고?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Answer_0021_Text
msgctxt "f7a687b5-ef63-4304-950a-10230c7cfb6f"
msgid "\"I'm no hero, just a mercenary.\""
msgstr "\"난 영웅이 아냐. 그저 용병일 뿐이라고.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Answer_0022_Text
msgctxt "db424add-0742-4b26-a0e1-8278ab11aef7"
msgid "\"This is nonsense.\""
msgstr "\"말도 안되는군.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Answer_0029_Text
msgctxt "f36734d2-9c02-4ca1-9c9c-0da00aafa86f"
msgid ""
"\"Not a bad plan! It's settled, then — I'll accomplish the feats, and you'll "
"write them down!\""
msgstr "\"괜찮은 생각이군! 좋아. 내가 위업을 달성하면 넌 그걸 쓰라고!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Answer_0030_Text
msgctxt "27d3361b-6754-4da5-a5c0-d476651952b2"
msgid ""
"\"What about that barbarian? She looks pretty heroic. I think her name's "
"Amiri.\""
msgstr "\"저기 있는 바바리안은 어때? 꽤나 영웅 같아 보이는데 말이야. 이름이 아미리였던 것 같은데.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Answer_0033_Text
msgctxt "d62e4b1e-5e1c-44c6-91f8-af2190ecaca5"
msgid "\"I have nothing against Tartuccio.\""
msgstr "\"난 타투치오한테 불만 없는걸.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Cue_0002_Text
#. Speaker : Linzi_Neutral
msgctxt "697bfa18-d801-4374-bb6c-3e535bea212c"
msgid ""
"\"Hi! My name's Linzi! I'm a bard, though this is my first real adventure. "
"So, shall we go teach this Stag Lord a lesson?\""
msgstr ""
"\"안녕하세요! 제 이름은 린지에요! 바드죠. 사실 이게 제 첫 모험이긴 하지만요. 어쨌든, 우리 같이 그 수사슴 군주에게 본때를 "
"보여주러 가지 않을래요?\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Cue_0006_Text
#. Speaker : Linzi_Neutral
msgctxt "747e3d8c-7e2b-4f0f-aa1b-9c5933a2e010"
msgid "\"Likewise! Actually, I also wanted to ask you something...\""
msgstr "\"저도요! 사실 인사 말고도 한 가지 물어보고 싶은 게 있는데...\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Cue_0007_Text
#. Speaker : Linzi_Neutral
msgctxt "934a5ccb-6700-4f68-a905-c58079c0a3ac"
msgid "\"Nothing weird, don't worry! I just wanted to ask you something...\""
msgstr "\"이상한 건 아니니까 걱정 말아요! 그저 한 가지 물어보고 싶은 게 있는데…\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Cue_0009_Text
#. Speaker : Linzi_Neutral
msgctxt "95dcab25-3f35-4260-a8ff-e413ba5c8a58"
msgid ""
"\"Ha ha ha, I have no doubt! Kind of related, I wanted to ask you "
"something...\""
msgstr "\"하하하! 의심의 여지가 없죠! 그거랑 관련해서 묻고 싶은 게 있는데…\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Cue_0010_Text
#. Speaker : Linzi_Neutral
msgctxt "aa2e796e-35af-46e0-84a2-04cf9bf76811"
msgid ""
"\"How do you feel about this Tartuccio fellow? I think he's pretty "
"obnoxious, personally. He appointed himself head of the team, and he's just "
"after the baron's crown... or whatever it is barons wear. Doesn't matter! I "
"don't like him — I think you should be team leader! When I first saw you, I "
"couldn't help but think, 'Now here's a real hero! Someone who'll be praised "
"in poems and songs! This...'\" {n}Linzi blushes a little.{/n} \"'This is the "
"person I'll write my book about!'\""
msgstr ""
"\"저 타투치오란 친구에 대해서 어떻게 생각하세요? 전 꽤 기분 나쁜 녀석인거같아요.. 개인적으로요. 혼자서 팀의 지도자를 자처하지 "
"않나. 그저 남작의 왕관... 남작이 뭘 쓰는지는 잘 모르겠지만, 그것만 탐내고 있질 않나. 아무튼! 별로 맘에 안 들어요. 저는 "
"당신이야말로 팀의 지도자가 되어야 한다고 생각해요! 처음 당신을 보자마자 생각했죠. '와, 이게 진짜 영웅이야! 온갖 시와 노래에서 "
"찬양하는 그런 영웅 말이야! 이 사람이야말로…'\" {n}린지는 조금 얼굴을 붉힙니다.{/n} \"'이 사람이야말로 내가 쓸 책의 "
"주인공이 되어야 해!'라고 말이에요..\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Cue_0023_Text
#. Speaker : Linzi_Neutral
msgctxt "34795ea3-8278-43e0-80ed-6e1cbbabe818"
msgid "\"It's not nonsense! Let me explain.\""
msgstr "\"말도 안되는 게 아니에요! 제가 설명해 드릴게요.\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Cue_0024_Text
#. Speaker : Linzi_Neutral
msgctxt "e51d65c1-ca17-4dea-9bfc-683deef436b9"
msgid "\"Damn, I should have led with that... Please, just let me explain!\""
msgstr "\"이런. 이것부터 먼저 얘기했어야 했는데… 제발, 제 설명 좀 들어주세요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Cue_0025_Text
#. Speaker : Linzi_Neutral
msgctxt "81d48b41-f541-4157-95d6-aac27fafa14f"
msgid ""
"\"And what are you a mercenary for? Is it only riches? Or maybe you want "
"glory, too? Don't you want your feats to be remembered and glorified for "
"centuries? Just listen!\""
msgstr ""
"\"그럼무엇을 위해 용병을 하고 있는 거죠? 그저 부자가 되고 싶어서? 아니면 명예를 얻기 위해서? 당신의 업적이 수세기 동안 기억되고 "
"화자되길 원하지 않아요? 한 번 들어 봐요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Cue_0026_Text
#. Speaker : Linzi_Neutral
msgctxt "ced90b2b-647d-452c-81f5-c832e19ff941"
msgid ""
"\"You know what the trouble with most heroes' biographies is? They're always "
"written years later, based on the tales of — best case — people who saw "
"things from the outside. Worst case? Someone heard about it from their "
"brother, who heard it from their friend, who heard it from their cousin, and "
"so on... adding a new batch of lies each time! Every time I read about a "
"heroic journey, I think to myself, 'Why didn't they just bring a bard with "
"them to write it all down properly?'\""
msgstr ""
"\"혹시 대부분의 영웅 이야기가 지닌 문제점이 뭔지 아세요? 바로 언제나 몇 년 후에나 그 이야기가 쓰인다는 거죠. 게다가 그 이야기란 "
"게 그 일을 멀리서 목격한 사람의 얘기를 토대로 쓴게 겨우 최선이라구요! 최악의 경우요? 형제가 해준 얘기를 들은 사촌이 해준 얘기를 "
"들은 친구가 해준 얘기를 가지고 쓰는 거죠. 매번 새로운 거짓말들로 이야기에 살을 붙이면서 말이에요! 영웅들의 이야기를 읽을 때마다 전 "
"이런 생각을 했어요. '그냥 바드 한 명을 데려가서 제대로 이야기를 쓰면 안 되나?'\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Cue_0027_Text
#. Speaker : Linzi_Neutral
msgctxt "62685a75-e311-41d3-b5ee-d7ba0ae2ceec"
msgid ""
"\"And then I thought, I could be that bard! I just needed to find a suitable "
"hero and volunteer to follow along on their glorious adventure. A great "
"plan, huh? And here we are, with a heroic journey lying before us. Who's "
"going to be the hero? Some dwarf who keeps muttering about how we'll all "
"die? Or maybe that horrific scythe lady? Or, gods forbid, Tartuccio? No way!"
"\""
msgstr ""
"\"그리고 결심했죠. 내가 그 바드가 되어야겠다고! 제가 할 일은 그저 딱 맞는 영웅 한 명을 찾아서 그 영광스러운 모험을 뒤따라 다니는 "
"거죠. 멋진 생각이지 않아요? 지금 우리 앞에는 영웅적인 여정이 펼쳐져 있어요. 과연 누가 그 영웅이 될까요? 결국 우리가 다 죽어버릴 "
"거라면서 투덜대는 저 드워프? 아니면 저기 있는 무서운 낫 든 숙녀분? 그것도 아니면 절대 그럴 일은 없겠지만 타투치오? 말도 안되죠!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Cue_0031_Text
#. Speaker : Linzi_Neutral
msgctxt "1cb0d2e2-2e61-45d7-9560-cdd2ac0e5978"
msgid ""
"\"Oh, yeah, she's fantastic — you can tell she could tear a bear's head off "
"with her bare hands! But...\" {n}Linzi's voice falls to a whisper.{/n} \"She "
"kind of scares me — just a little! But, I mean, her sword's twice as big as "
"I am! She could cut me down without even noticing! Just think on it a bit, "
"all right? I'm sure you'll agree!\""
msgstr ""
"\"아, 맞아요. 저 여성분도 아주 멋져요. 분명 맨손으로 곰의 목도 딸 수 있을걸요? 그치만…\" {n}린지가 목소리를 낮추고 "
"속삭입니다.{/n} \"솔직히 조금 무서워서요.. 아주 조금! 그러니까, 제 말은, 저 칼 좀 봐요, 제 키에 두 배나 크다고요! 자기도 "
"모르는 새에 절 베어버릴지도 몰라요! 아무튼 조금만 더 생각해 봐요. 알겠죠? 틀림없이 이해하실 거라 믿어요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Cue_0032_Text
#. Speaker : Linzi_Neutral
msgctxt "ee0d944d-2f75-48cd-9562-2037882785d4"
msgid "\"Deal!\""
msgstr "\"좋아요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Cue_0034_Text
#. Speaker : Linzi_Neutral
msgctxt "d55dd4dc-f9ee-4be8-804e-2198fce9262a"
msgid "\"Really? Hmm... Well, all right. But I hope you change your mind.\""
msgstr "\"정말요? 음… 네. 알겠어요. 그치만 그 생각이 바뀌면 좋겠네요!\""

#. Mechanics/Blueprints/World/Dialogs/c0_Prologue/JamandisMansionThroneroom/LinziDialog_Start/Cue_0035_Text
msgctxt "ae0e31b6-36f4-4b87-be84-3ed73fb828d1"
msgid ""
"\"All right, I'm going to my room to write about tonight. See you in the "
"morning!\""
msgstr "\"그럼 전 방에 들어가서 오늘밤 일을 써야겠어요. 내일 아침에 봐요!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Amiri_String
msgctxt "2c433aa0-5aa0-47f7-9d83-d189643ec6ff"
msgid ""
"\"Their wine is all right, nice and strong! But the appetizers — pff! Barely "
"a mouthful!\""
msgstr "\"그들의 와인은 모두 좋고 도수도 세! 하지만 전체 요리는... 흥! 한입거리군!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Cassil_String
msgctxt "13312000-9f67-4374-9b0d-72947f27d144"
msgid "\"Today is a historic day for Restov — and maybe for all of Brevoy.\""
msgstr "\"오늘은 레스토프의 역사적인 날입니다. 아마도 브레보이 역시 마찬가지겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Guard_1_String
msgctxt "8d2155e4-7529-4a43-9892-3f45cdf27701"
msgid ""
"\"All of high society is here — even Natala Surtova. There could be an "
"assassination, a provocation... anything!\""
msgstr "\"귀하신 분들이 여기 모두 모였군. 심지어 나탈라 서토바도. 암살이나 도발... 무슨 일이든 벌어질 수 있어!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Guard_2_String
msgctxt "b29bf863-f2a1-419e-976b-b000098c9ef7"
msgid "\"Hail!\""
msgstr "\"충성!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Guard_3_String
msgctxt "2d7aa2ed-2336-4749-bd2e-5227c2c8317b"
msgid "\"What torture... The guests eat and drink, and we can't even move!\""
msgstr "\"이런 고문이... 손님들은 먹고 마시는데 우리는 움직일 수도 없다니!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Guest_1_String
msgctxt "f8dcda11-4480-4f25-a95d-420aef586a33"
msgid ""
"\"Oh, these young heroes... Such bravery, such spirit! Why, I remember when "
"I was your age...\""
msgstr "\"아. 이 젊은 영웅들... 정말 용감하군! 나 때는 말이야...\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Guest_2_String
msgctxt "b86498d6-61c9-46e0-aad7-217df9e990f6"
msgid "\"It's nice to see the beginning of a future noble family...\""
msgstr "\"미래의 고귀한 자들의 시작을 보는 것이 좋다...\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Guest_3_String
msgctxt "e1673278-80ab-467c-afdc-c962cae518ea"
msgid ""
"\"So it was you who dealt with the Stag Lord? Allow me to shake your hand!\""
msgstr "\"그래서 네가 수사슴 군주를 처리한 거야? 악수 한번 하자구!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Harrim_String
msgctxt "1f362313-4abf-42f6-9868-3f97431c3ac9"
msgid ""
"\"A feast in times of pestilence... A ludicrous attempt to sink into "
"reverie, to digress from contemplating one's own insignificance...\""
msgstr "\"이런 것을 가지고 잔치를 벌이는군... 방탕함에 빠져 자신의 무력함을 잊었어...\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Jaethal_String
msgctxt "6b1edaab-d4f8-440d-8fc1-1e9015125a90"
msgid ""
"\"They call this a feast? I'd show them some real festivities, if they'd let "
"me.\""
msgstr "\"이걸 잔치라고 부른 거야? 진짜 잔치가 뭔지 보여주고 싶군.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Jamandi_GoTalk_String
msgctxt "6af494f7-ff3d-48f2-96c4-4f06d39d0973"
msgid ""
"\"It's still too early for the official proceedings. Go, speak with the "
"guests.\""
msgstr "\"공식적인 식순을 진행하기에는 아직 너무 일러요. 가서 손님들과 이야기를 나눠 보세요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Kesten_String
msgctxt "eed837b7-1355-4f1e-8f86-907a9ccfba96"
msgid ""
"\"Well, Tartuccio... Hic! W-well, scum... And how did we... Hmm, maybe I've "
"had one too many...\""
msgstr "\"음. 타투치오... 끅! 이 쓰레기 자식... 우리는... 으... 너무 많이 마셨어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Linzi_String
msgctxt "68514a7e-ac31-4763-b91d-a3f2d264ed03"
msgid ""
"\"Pour up to the brim, so that... So that... Oh, I must be drunk — I forgot "
"the line!\""
msgstr "\"가득 부어줘... 그... 그게... 오! 저 취했나봐요! 대사를 까먹었어요!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Octavia_String
msgctxt "bc50df53-6d3a-46bf-a535-56f1c326f664"
msgid "\"Mmm... Try the eclairs — they're delicious!\""
msgstr "\"음... 그 에클레어를 먹어봐. 정말 맛있어!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Regongar_String
msgctxt "01280867-a462-4a70-97bb-1dd7bb28e0e8"
msgid "\"Ha ha! To victory! To freedom! Bottoms up, bottoms up! Yes!\""
msgstr "\"하하! 승리를 위해! 자유를 위해! 들이켜! 마셔! 그래!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Servant_1_String
msgctxt "d66ec29d-997f-4c91-a174-47301a7960fd"
msgid "\"What would you like?\""
msgstr "\"어떻게 하고 싶어?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Servant_2_String
msgctxt "682b8829-a8a8-405e-91ad-4a9bdb16dc5a"
msgid "\"They'll be serving pot roast after the ceremony.\""
msgstr "\"행사가 끝나면 구이 요리를 대접할 거야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Servant_3_String
msgctxt "7de5090c-a033-41cc-9c2d-e1a21fd70571"
msgid "\"Having you here is a great honor for us!\""
msgstr "\"당신을 여기에 모신 건 큰 영광입니다!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Shandra_String
msgctxt "63abd838-0b1b-4d9e-8b85-e01c972fdf32"
msgid ""
"\"Ah, yes... I see good old Restov hasn't changed a bit. Even the smell in "
"the streets is the same.\""
msgstr "\"아. 그래... 레스토프는 하나도 변하지 않았다고. 길가의 냄새도 여전해.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Tristian_String
msgctxt "41c28190-8a0b-4c19-8e43-6fe79acdfa5f"
msgid ""
"\"These people are not just celebrating. It seems your feat has given them "
"new hope.\""
msgstr "\"이 사람들은 단순히 축하를 하는게 아닙니다. 당신의 위업이 그들에게 새로운 희망을 준 것 같군요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Valerie_String
msgctxt "3a4066fa-1769-4887-a52b-2ad2ec7174e4"
msgid ""
"\"Truth be told, I'm not really comfortable here. I lost my taste for high "
"society.\""
msgstr "\"솔직히 말하자면. 여기가 별로 편하지는 않습니다. 귀족 사회에서 먹던 입맛이 다 바뀐 듯하군요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Barks/Welcome_String
msgctxt "51e806c0-90c8-4433-a784-94a6959ac546"
msgid ""
"\"{Name}, the hero{mf||ine} of the Stolen Lands, the slayer of the Stag Lord!"
"\""
msgstr "\"도둑맞은 땅의 영웅 {Name}. 수사슴 군주를 물리친 자!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ceremony/01_Jamandi_String
msgctxt "92f124ed-2c5f-45e9-a5cb-ff23d1d37b85"
msgid ""
"\"Lords and ladies! Today, we are here to honor three brave people who have "
"done the impossible — they've tamed the Stolen Lands!\""
msgstr ""
"\"귀빈 여러분! 오늘 우리는 불가능한 일을 해낸 세 명의 용사들을 빛내기 위해 이 자리에 섰습니다. 도둑맞은 땅의 정복자들을 소개합니다!"
"\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ceremony/02_Jamandi_String
msgctxt "b6d98219-18d7-4fbc-8feb-d83b651d5f00"
msgid ""
"\"Baron Hannis Drelev, the new master of Glenebon. Captain Maegar Varn, the "
"conqueror of Dunsward. And finally...\""
msgstr "\"글레네본의 새 주인 하니스 드렐레프 남작, 던스워드의 정복자 메이가르 반 단장, 그리고...\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ceremony/03_Jamandi_String
msgctxt "35390082-ecc2-4ba4-ae37-5caa9fc78bdc"
msgid ""
"\"{Name} — the tamer of the Shrike Hills, who put an end to the atrocities "
"of the Stag Lord's bandits!\""
msgstr "\"{Name}, 수사슴 군주와 도적들의 잔학 행위를 종식한 슈라이크 언덕의 정복자!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ceremony/04_Jamandi_String
msgctxt "6b3a79fd-c8c8-4e48-8ef3-4049b38f2886"
msgid "\"Step forward.\""
msgstr "\"앞으로 나오시오.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ceremony/05_Jamandi_String
msgctxt "f6187acd-c3af-41ef-9d58-341e121f19eb"
msgid ""
"\"On behalf of the people of the Free City of Restov, I confer upon you this "
"noble title!\""
msgstr "\"레스토프 자유시의 전 인민을 대표하여, 그대에게 이 고귀한 칭호를 내리노라!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ceremony/06_Jamandi_String
msgctxt "5dddcfec-8530-4700-9649-c2ed648a00f1"
msgid "\"Rise, Your Grace, Baron{mf||ess} {Name} the First!\""
msgstr "\"일어서라. 남작 {Name} 1세!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ceremony/07_Guests_1_String
msgctxt "4b8ddb9e-2e31-44ca-8daf-9b82a2e43746"
msgid "\"Hip-hip, hooray!\""
msgstr "\"만세!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ceremony/07_Guests_2_String
msgctxt "74e4995d-8c42-479f-a09c-8ebfda1fed1e"
msgid "\"Hail to the conquerors of the Stolen Lands!\""
msgstr "\"도둑맞은 땅의 정복자 만세!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ceremony/07_Guests_3_String
msgctxt "c900c56d-6d82-4123-a24f-c0bc58e62717"
msgid "\"To long years and new victories!\""
msgstr "\"오랜 세월을 계속 이겨나가리!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ceremony/07_Guests_4_String
msgctxt "7685e895-fef8-4739-a1db-a6e8ac33736e"
msgid "\"These are the kinds of heroes we've needed!\""
msgstr "\"우리가 원했던 영웅이야!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ceremony/07_Guests_5_String
msgctxt "66da605d-9887-4492-8411-6835c3405288"
msgid "\"Erastil bless you!\""
msgstr "\"에라스틸이여, 축복해주소서!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Drelev/Answer_0004_Text
msgctxt "27884c11-7bdf-4d33-87b4-0a49384b78a5"
msgid ""
"\"Yes, I defeated the Stag Lord. Pray tell, what did you do to deserve your "
"new dominion?\""
msgstr "\"그렇다. 나는 수사슴 군주를 물리쳤다. 통치권을 얻기 위해 너는 무엇을 했지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Drelev/Answer_0006_Text
msgctxt "0517f48f-303d-41c9-9f10-c2fa0acebbb8"
msgid ""
"\"So you have no army, and no special merits — you were just given land for "
"being pretty?\""
msgstr "\"군대도 없고 특별한 공로도 없다... 받은 땅은 그저 장식인가?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Drelev/Answer_0007_Text
msgctxt "c65ddd53-5f9d-4a17-84a8-997c82055512"
msgid "\"You're not very polite for a nobleman.\""
msgstr "\"귀족을 대하는 예의가 부족하군.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Drelev/Answer_0010_Text
msgctxt "97c0090a-eefd-4ea6-b44d-dbee410e5e2c"
msgid "\"Goodbye.\""
msgstr "\"안녕히.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Drelev/Cue_0001_Text
msgctxt "9cca9f27-d924-4fc4-a12c-1c6845c282c2"
msgid ""
"{n}This man's gorgeous clothes hide rippling muscles beneath them. He looks "
"past your ear, obviously bored.{/n}"
msgstr "{n}이 남자의 화려한 옷 아래에서 근육이 꿈틀댑니다. 그는 지루해서 당신 쪽을 무심히 쳐다봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Drelev/Cue_0002_Text
msgctxt "4b544446-d8f2-4f4a-b595-466b565cad7d"
msgid ""
"\"Baron Hannis Drelev,\" {n}he says offhandedly, emphasizing the word "
"'baron.'{/n} \"And you must be... the Stag Lord butcher. I'm sorry, I quite "
"forgot your name. But you took out the Stag Lord and his gang, and so "
"Swordlord Jamandi is granting you permission to take his place, right? Well, "
"congratulations. My lands lie to the west of yours — I suppose we're "
"neighbors, now.\""
msgstr ""
"\"남작 하니스 드렐레프다.\" {n}그는 말하면서 남작이라는 말을 강조했습니다.{/n} \"그리고 너는... 수사슴 군주를 죽인 "
"자겠군. 미안. 네 이름이 기억이 나지 않아. 하지만 너는 수사슴과 그의 부하들을 축출했고 소드로드 자만디는 자신의 땅 일부를 네게 "
"주었다지? 축하한다. 내 영토는 네 땅의 서쪽에 있다. 우리는 이웃이로군.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Drelev/Cue_0005_Text
msgctxt "2d7510d3-b597-4df4-a25d-1c58afd4af4b"
msgid ""
"{n}A smirk appears on the baron's face.{/n} \"I don't need to deserve or "
"prove anything — countless generations of my glorious ancestors have done so "
"for me. If I had a slightly bigger army, {g|Swordlords}Swordlord{/g} Jamandi "
"would have simply given all of {g|Stolen Lands}the Stolen Lands{/g} to me. "
"Alas, I don't have so many soldiers at my disposal, so she had to urgently "
"make 'barons' — heh — of the likes of you and Varn.\""
msgstr ""
"{n}남작의 얼굴에 능글맞는 표정이 나타납니다.{/n} \"나는 그 무엇도 증명할 필요가 없다. 나의 수많은 조상들은 나를 위해 "
"영광스러운 업적을 기렸지. 나에게 군대가 조금 더 많았다면 {g|Swordlords}소드로드{/g} 자만디는 {g|Stolen Lands}"
"도둑맞은 땅{/g} 전체를 나에게 건냈을 것이다. 슬프군. 겨우 그런 이유로 너와 반과 같은 녀석을 남작으로 삼다니.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Drelev/Cue_0008_Text
msgctxt "ebf87fb5-a786-4456-b2c4-7e8f0da80455"
msgid ""
"\"Under other circumstances, I'd have you whipped for such words. But let's "
"not ruin Lady Aldori's celebration, hmm? If you want so badly to measure "
"merits, we can do so another time.\""
msgstr ""
"\"다른 상황이었다면 그런 말을 지껄이는 너를 채찍질했을 것이다. 하지만 알도리의 축하연을 방해하지는 말자구, 흠? 만약 누가 더 많은 "
"공로를 쌓았는지 너무나 재보고 싶다면 다음 기회를 노리지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Drelev/Cue_0009_Text
msgctxt "dafc4e08-e491-4092-8b0f-030873bcc6cd"
msgid "\"Ha! Politeness must be deserved.\""
msgstr "\"하!, 예의를 받을 만 한 자에게는 반드시 그렇게 대해야 하지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Drelev/Cue_0011_Text
msgctxt "76bf61d6-22aa-4903-87d7-51491e828b8d"
msgid ""
"{n}Not even deigning to reply, Baron Drelev turns around and looks away.{/n}"
msgstr "{n}대꾸할 생각도 하지 않은 채 드렐레프 남작은 돌아서 시선을 외면합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Answer_0004_Text
msgctxt "dd3471fc-0899-4f01-b27d-4b5a01d55936"
msgid "\"Do many people in Restov venerate Erastil?\""
msgstr "\"레스토프에 있는 많은 사람들이 에라스틸을 존경하나?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Answer_0006_Text
msgctxt "774c1231-1562-4a98-ad4f-1c9289740fd9"
msgid "\"I worship Erastil as well. Please, may I receive your blessing?\""
msgstr "\"나도 에라스틸을 숭배한다. 나에게 축복을 내려줄 수 있어?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Answer_0008_Text
msgctxt "612a8b17-4009-4d3a-9761-8fcb78cd8a16"
msgid ""
"\"Bringing law into the Stolen Lands is a difficult endeavour. I would be "
"grateful for any help you could spare!\""
msgstr "\"도둑맞은 땅에 법을 제정하는 것은 어려운 일이야. 네 도움이 있다면 정말 고마운 일이겠지!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Answer_0012_Text
msgctxt "b3634c65-628b-456c-9192-7e40303d8c89"
msgid "\"You're dressed surprisingly simply for such a festive occasion.\""
msgstr "\"기념 행사에 놀랍도록 단순한 복장이군.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Answer_0013_Text
msgctxt "39b9560e-99d2-4d39-8c31-6dde13857a4c"
msgid "\"It was an honor to meet you. Goodbye.\""
msgstr "\"만나서 영광이었다. 안녕히.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Answer_0019_Text
msgctxt "6dc5a240-06a9-4de2-a023-621d49bbe42e"
msgid ""
"\"The gods are monsters, priest. Fretful monsters that don't deserve to be "
"worshipped.\""
msgstr "\"신은 괴물이다. 사제. 숭배받을 자격이없는 상냥한 괴물.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Answer_0021_Text
msgctxt "78c6571e-2023-4f6e-9941-eed4d17225e0"
msgid ""
"\"I saw how you fought beside Jamandi that night... Your god granted you "
"impressive power!\""
msgstr "\"네가 그날 밤 자만디와 함께 싸운 모습을 봤어. 신에게서 놀라운 힘을 물려받았구나!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Cue_0001_Text
msgctxt "c44ba120-f1ce-4ba1-acca-0bfe935bd7c2"
msgid ""
"{n}A handsome man with a weather-beaten face grasps your hand tightly in his "
"rough, calloused palms. Unlike the rest of the guests in their festive "
"clothes, he wears a simple robe — the only luxury you see on him is a holy "
"symbol of {g|Erastil}Erastil{/g} made of solid gold. The other guests look "
"at him with respect, some bordering on awe.{/n}"
msgstr ""
"{n}세월의 흔적이 쌓였지만 잘생긴 얼굴의 남자는 거칠고 궂은 살이 박힌 손으로 당신의 손을 단단히 잡습니다. 연미복으로 차려입은 다른 "
"사람들과 달리 그는 간소한 옷을 입었습니다. 그에게서 고급스러워 보이는 것은 금으로 만든 성스러운 {g|Erastil}에라스틸{/g}의 "
"상징이 유일합니다. 다른 손님은 그를 존경의 눈빛으로, 몇몇은 경외감으로 바라봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Cue_0002_Text
msgctxt "f3dfe60e-4cd8-4861-8862-9f43e7b94357"
msgid ""
"\"Congratulations on your victory,\" {n}he says in a deep voice.{/n} \"Allow "
"me to introduce myself. I am Ezvanki Keeg, High Priest of "
"{g|Erastil}Erastil{/g} in {g|Restov}Restov{/g}.\""
msgstr ""
"\"승리를 축하하네.\" {n}그는 깊이 있는 목소리로 말합니다.{/n} \"내 소개를 허락하게. 나는 에즈반키 키크. "
"{g|Restov}레스토프{/g}에서 온 {g|Erastil}에라스틸{/g}의 고위 사제라네.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Cue_0005_Text
msgctxt "37240614-d138-4163-bed7-833ec782a70d"
msgid ""
"\"They revere many gods in {g|Restov}Restov{/g}. They pray to "
"{g|Abadar}Abadar{/g}, patron of cities, and {g|Pharasma}Pharasma{/g}, "
"gatherer of souls... There are also some more rare cults. But there's no "
"denying that the {g|Erastil}Stag God{/g} has the largest congregation here. "
"And no wonder — people here have lived off farming and hunting for centuries."
"\""
msgstr ""
"\"그들은 {g|Restov}레스토프{/g}의 많은 신들을 경배하지. 그들은 도시의 후원자인 {g|Abadar}아바다르{/g}, 영혼을 "
"수집하는 {g|Pharasma}파라즈마{/g}와 같은 신을 숭배한다네. 좀 더 희귀한 종파도 있어. 그러나 {g|Erastil}수사슴 "
"신{/g}의 신도가 가장 많다는 것은 부정할 수 없는 사실이야. 이곳의 사람들은 수세기 동안 농사와 사냥으로 생계를 유지했어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Cue_0007_Text
msgctxt "e557eb56-3841-4e1d-9110-660443ce112c"
msgid ""
"\"It's a pleasure to know the baron{mf||ess} is not only brave, but also "
"pious. Let {g|Erastil}Erastil{/g} keep you in his grace!\""
msgstr ""
"\"남작이 용감할 뿐만 아니라 신앙심 또한 깊다는 것을 알게 되어 기쁘군. {g|Erastil}에라스틸{/g}께서 너를 돌봐주시기를!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Cue_0010_Text
msgctxt "a273c9ac-d359-48e8-85a4-362fa530f7b3"
msgid ""
"\"This is a truly noble undertaking. I believe our community will be able to "
"provide you with reasonable assistance. We will help you construct a shrine "
"in your capital, free of charge.\""
msgstr ""
"\"이것은 진정으로 고귀한 일이야. 지역 사회가 너에게 합당한 도움을 줄 거라고 믿네. 너를 도와 수도에 무료로 성소를 지어주고 싶어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Cue_0011_Text
msgctxt "d0668909-9502-4a61-8733-b9d5f831ea50"
msgid ""
"\"Our most pious aspirations are often hindered. But is it not the case that "
"overcoming such obstacles allows us to become closer to our god? I give you "
"my blessing, and I believe you will be able to overcome these hardships and "
"achieve your goals!\""
msgstr ""
"\"우리의 가장 경건한 열망은 종종 방해를 받지. 그러나 그러한 장애를 극복하여 우리가 신과 더 가까워 질 수 있지 않을까? 네가 역경을 "
"극복하고 목표를 이루리라 믿네!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Cue_0015_Text
msgctxt "79aecf36-2e8d-4ff3-bc29-0a724093630a"
msgid ""
"{n}The corners of the priest's mouth turn up in a faint smile.{/n} \"The "
"nobles dress in silks and satins to stand out from the poor. A priest wears "
"a simple robe to stand out from the nobles.\""
msgstr ""
"{n}사제의 입가에 희미한 미소가 나타납니다.{/n} \"귀족들은 실크와 새틴으로 드레스를 입고 가난한 사람들에게서 돋보이려 하지. "
"사제는 귀족들로부터 구별되기 위해 간소한 옷을 입고.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Cue_0016_Text
msgctxt "d91e2b23-28b8-47a0-80d2-02d6d473bb45"
msgid "\"{g|Erastil}Erastil{/g} keep you.\""
msgstr "\"{g|Erastil}에라스틸{/g}이 그대를 지키길.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Cue_0018_Text
msgctxt "8238c46f-834a-4842-8c31-a4c3de8d2c99"
msgid ""
"\"The higher powers have favored you so far. May they stay with you in the "
"future!\""
msgstr "\"전능하신 이들께서 지금까지 자네를 도왔어. 미래에도 그들이 그대와 함께하길!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Cue_0020_Text
msgctxt "d806ecda-89c0-4e1f-b53b-aadeba678e6a"
msgid ""
"\"Do you really believe that? Well, it saddens me to hear you think so.\""
msgstr "\"정말로 그렇게 생각하나? 그렇게 생각하다니 슬프군.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Ezvanki/Cue_0022_Text
msgctxt "d54bd5ca-30d4-473d-9012-f300160157a1"
msgid ""
"\"Yes, I used to serve {g|Erastil}Erastil{/g} on the battlefield, but those "
"days are long past. Now I call on his power to heal those who've fallen from "
"a roof more often than anyone wounded by a sword! Of course, someone has to "
"roam the forests and slay monsters, but I'm more useful to my congregation "
"here, attending to more mundane affairs, like hospitals, shelters, and "
"charity fairs.\""
msgstr ""
"\"그래. 나는 전장에서 {g|Erastil}에라스틸{/g}을 섬겼지만 그 시절은 옛날이야. 요즘은 칼에 상처를 입은 사람보다 지붕에서 "
"떨어진 사람들을 더 많이 치료하지. 물론 누군가 숲을 떠돌다 괴물을 죽일 수 있겠지만 나는 이곳에 머물며 병원이나 피난처 같은 곳에서 "
"평범한 일을 하는 게 내 신도들에게 더 도움이 된다네.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Answer_0003_Text
msgctxt "8b6bab05-b9cf-4759-9b8c-eb97c3451030"
msgid "\"I am ready for the ceremony.\""
msgstr "\"난 예식을 치를 준비가 되었소.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Answer_0004_Text
msgctxt "fe7dd215-875e-4ef5-bfcc-40f24b22e110"
msgid "\"I'd like to speak with the guests some more.\""
msgstr "\"아직 손님들과 더 이야기하고 싶군요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Answer_0005_Text
msgctxt "803bff4a-d9f0-4fc7-866b-c97510e2699c"
msgid ""
"\"Before we begin, I'd like to talk about the envoy I'll be taking with me.\""
msgstr "\"시작하기 전에 나와 함께 동행할 특사에 관해 이야기하고 싶어요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Answer_0012_Text
msgctxt "1bd5769b-d877-41ae-901b-e2e0069a01e7"
msgid "\"I'll take Kassil.\""
msgstr "\"나는 카실을 데려가겠소.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Answer_0013_Text
msgctxt "5a488884-cf5d-4ee8-9dc0-35ccdd0f2fe6"
msgid "\"Young Lander will come with me.\""
msgstr "\"젊은 랜더가 나와 함께 갈 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Answer_0014_Text
msgctxt "3f26fb58-542a-4868-a584-d7bbfa773735"
msgid "\"Shandra Mervey will be my envoy.\""
msgstr "\"샨드라 머비가 내 특사가 될 거야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Answer_0015_Text
msgctxt "1f4ca44e-b6e0-4022-9e29-22ad03976be3"
msgid "\"Yes, that's my decision.\""
msgstr "\"네, 그게 내 결정입니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Cue_0001_Text
msgctxt "48908fe5-ae73-4d65-83b7-9be555c44742"
msgid ""
"\"So, how do you like our little gathering? I hope you have made some useful "
"connections. Shall we move on to the official proceedings?\""
msgstr "\"연회는 어떠셨는지? 좋은 인맥을 형성했길 바랍니다. 공식 절차를 진행할까요?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Cue_0008_Text
msgctxt "85f3410a-8dfa-40e8-9471-eb5be235972a"
msgid "\"My apprentice, Kassil Aldori, will go with you, won't he?\""
msgstr "\"제 제자 카실 알도리가 당신와 함께 갈 겁니다. 괜찮으신가요?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Cue_0009_Text
msgctxt "b427c1dc-3e3f-4383-b06c-ac27251356a3"
msgid ""
"\"From what I understand, you've decided to take Lander {g|House "
"Lebeda}Lebeda{/g} with you?\""
msgstr "\"그렇다면 랜더 {g|House Lebeda}레베다{/g}와 함께 하고 싶은 건가요?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Cue_0010_Text
msgctxt "074419d8-83dd-4361-abba-06c1a63299c0"
msgid ""
"\"If I'm not mistaken, you've chosen Shandra Mervey, Natala {g|House "
"Surtova}Surtova's{/g} servant?\""
msgstr "\"제가 들은게 맞다면, 나탈라 {g|House Surtova}서토바{/g}의 신하인 샨드라 머비와 함께 하고 싶은 겁니까?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Cue_0016_Text
msgctxt "970b217a-b762-4069-b3cb-04948bc2ae81"
msgid ""
"\"Whatever you choose, I won't argue. But you must choose your inner circle "
"with the utmost care.\""
msgstr "\"당신이 무엇을 선택하든 저는 참견하지 않을겁니다. 하시만 내각은 매우 신중하게 선택해야 합니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Cue_0017_Text
msgctxt "2c30f79c-2167-439e-80f5-5b31bd6e6773"
msgid "\"Of course. Enjoy the feast! You deserve it.\""
msgstr "\"물론이죠. 연회를 즐기시죠! 당신은 그럴 자격이 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Cue_0018_Text
msgctxt "68f0ed7e-0aa6-4150-b51f-c17edd5ddb32"
msgid "\"Excellent. Stand here...\""
msgstr "\"아주 좋아요. 여기 서십시오...\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Cue_0019_Text
msgctxt "95ea1433-9fde-4a8f-9dce-24b5abae7067"
msgid "\"A fine choice. You can trust him as you would myself.\""
msgstr "\"훌륭한 선택입니다. 당신의 분신처럼 그를 믿으셔도 될 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Cue_0020_Text
msgctxt "45124a50-f483-40e4-980f-b7b021d06b67"
msgid ""
"\"Oh, the heir of {g|House Lebeda}House Lebeda{/g} — naive enough to think "
"no one would recognize him here. I wouldn't trust him — who knows what he "
"has in mind!\""
msgstr ""
"\"아. {g|House Lebeda}레베다 가문{/g}의 사람이군요. 아무도 자기를 여기서 알아볼 수 없을 거라고 생각할 만큼 순진한 "
"걸까요? 저라면 그를 믿지 않을겁니다. 꿍꿍이가 뭔지 알 수가 없으니까요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Official/Cue_0021_Text
msgctxt "3624c224-cab5-4e9d-8e85-493f520921d3"
msgid ""
"\"The emissary of {g|House Surtova}House Surtova{/g}? Well, perhaps it's for "
"the best. As they say, keep your friends close, and your enemies closer...\""
msgstr ""
"\"{g|House Surtova}서토바 가문{/g}의 특사요? 아마 좋은 선택일 것 같네요. 이런 말이 있죠. 친구를 가까이하되 적은 "
"더 가까이 하라...\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Answer_0007_Text
msgctxt "763de124-2700-4ca1-be16-c5c5cc64c018"
msgid ""
"\"Jamandi, just what kind of game are you playing? I think I have the right "
"to know.\""
msgstr "\"자만디, 무슨 게임을 하고 있는거죠? 나는 알 권리가 있다고 생각합니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Answer_0010_Text
msgctxt "1e79d58a-91e8-4835-afae-35d60cd03172"
msgid "\"What do I need to know about the history of Brevoy?\""
msgstr "\"브레보이의 역사에 대해 알아야 할 것은 무엇이지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Answer_0011_Text
msgctxt "25f53530-a1cf-417a-b476-bbd8abe548e3"
msgid "\"What do I need to know about the current political atmosphere?\""
msgstr "\"현재의 정세에 대해 내가 알아야 건 뭐죠?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Answer_0012_Text
msgctxt "68f19f06-d5d7-43a5-90e9-51a3774f84cd"
msgid "\"What role do I play in your plans?\""
msgstr "\"당신의 계획 속에서 나는 어떤 역할이지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Answer_0013_Text
msgctxt "dd0f515f-dba6-430e-bded-a64b419650ee"
msgid "\"If Natala is already here, why did she let you grant me the title?\""
msgstr "\"나탈라가 이미 여기에 있다면 왜 당신이 네게 작위를 수여하도록 두는 겁니까?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Answer_0014_Text
msgctxt "daf8f414-5278-4fe4-bcaf-69d12d98fc7d"
msgid "\"I don't need an envoy.\""
msgstr "\"내게 특사는 필요 없습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Answer_0016_Text
msgctxt "364ff95d-bd80-4222-9b0f-aad4a585a62b"
msgid "\"Thank you for the explanation.\""
msgstr "\"설명해주어 고맙군요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Answer_0017_Text
msgctxt "238c919b-6809-45e5-9fee-d0d80796f830"
msgid "\"What happens next?\""
msgstr "\"다음은 어떻게 될까?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Answer_0019_Text
msgctxt "3cad9707-1437-47dc-9092-20078f419946"
msgid "\"Do you already know about my encounter with Tartuccio?\""
msgstr "\"타투치오와의 조우에 대해 이미 알고 있나요?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Answer_0021_Text
msgctxt "ff036eb2-0b48-4ac1-87f1-5f4153735e48"
msgid "\"Thank you. I'm going to speak with the guests.\""
msgstr "\"고마워요. 이제 손님들과 대화를 나누겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Answer_0035_Text
msgctxt "eae9f8ca-f8b7-41bc-bf63-efa4bf87687e"
msgid "\"What part does Restov play in this game?\""
msgstr "\"레스토프는 이 게임에서 어떤 역할을 하죠?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Answer_0038_Text
msgctxt "587b9ca7-3b8c-420e-9966-31e5fb1ba818"
msgid ""
"\"Don't the Swordlords have any other foreign allies capable of playing this "
"role?\""
msgstr "\"소드로드들이 이 역할을 수행할 수 있는 다른 외부의 동맹들을 갖고 있지 않나요?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Answer_0040_Text
msgctxt "9251a461-d32a-41ed-9878-98d4f3e9d8cf"
msgid "\"May Abadar help us bring civilization to this savage land.\""
msgstr "\"아바다르께서 우리를 도와 이 야만적인 땅에 문명을 가져오길.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0001_Text
msgctxt "8c34ae97-60b9-4b0b-b7c2-5334a7a3f5e4"
msgid ""
"\"Good work. Nice to see I haven't lost my intuition for people. Not many "
"would have managed to set out to {g|Stolen Lands}the Stolen Lands{/g} and "
"return with the Stag Lord's head, but I knew you could handle it.\""
msgstr ""
"\"잘하셨습니다. 제가 사람을 정확히 봤군요. {g|Stolen Lands}도둑맞은 땅{/g}으로 떠나서 수사슴 군주의 머리를 가지고 "
"돌아올 수 있는 사람은 많지는 않겠죠. 그러나 당신이 해냈습니다. 당신이 성공할 줄 알고 있었습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0002_Text_String
msgctxt "4fcdc3a6-ef4e-4e1e-a57f-83d64d944d9f"
msgid ""
"\"Congratulations are in order. Today, you'll receive the title of "
"baron{mf||ess} before the high society of {g|Restov}Restov{/g}, and even "
"{g|Natala}Natala Surtova{/g} personally, gods bless her. Tomorrow, you'll be "
"able to return to the Stolen Lands if you wish, but this time as a ruler.\""
msgstr ""
"\"축하합니다. 오늘 당신은 {g|Restov}레스토프{/g}의 귀족들 앞에서 남작의 작위를 받게 될 겁니다. 심지어는 {g|Natala}"
"나탈라 서토바{/g}까지 참석하겠지요. 신들께서 그녀를 축복하시길. 원한다면 내일 도둑맞은 땅으로 돌아갈 수 있을 겁니다. 이번에는 "
"통치자로써 말이죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0003_Text
msgctxt "8879c2ee-c832-43da-adc2-6fdbe89fdb34"
msgid ""
"\"But matters of state can wait. For now, enjoy this feast in your honor. "
"All the city leaders are here. It's a great opportunity to make some useful "
"connections.\""
msgstr ""
"\"그러나 국가의 문제는 시간이 필요하지요. 지금은 연회를 즐기십시오. 이 도시의 여러 지도자들이 이곳에 모여 있습니다. 인맥을 쌓을 "
"좋은 기회입니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0004_Text
msgctxt "7015d7e5-b59c-4d53-a950-7b326c74ec17"
msgid ""
"\"Speaking of connections, let me introduce you to Kassil Aldori. He's my "
"adopted son and apprentice. He's a trustworthy man — I'd like to send him "
"with you as an envoy.\""
msgstr ""
"\"말이 나와서 말인데 카실 알도리를 소개하고 싶군요. 이 아이는 제가 입양한 아들이자 제자입니다. 믿을만한 친구죠. 이 아이를 당신의 "
"특사로 보내고 싶습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0005_Text
#. Speaker : KassilAldori_Private
msgctxt "12cea0f0-5358-4a75-aab7-b40a84706309"
msgid ""
"{n}Kassil, a young half-orc with impeccable poise, performs a textbook-"
"perfect bow.{/n}"
msgstr "{n}흠잡을 데 없는 균형감각을 지닌 젊은 하프오크 카실은 교과서에 나오는 듯한 완벽한 인사를 합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0008_Text
msgctxt "d5b977f3-7037-41c7-9749-ca878b1702b3"
msgid ""
"\"Yes, you certainly have that right. But tell me, how well do you know "
"{g|Brevoy}Brevoy's{/g} history, or the current political atmosphere? It "
"won't be an easy explanation.\""
msgstr ""
"\"물론 그럴 권리가 있죠. 하지만 당신은 {g|Brevoy}브레보이{/g}의 역사나 현재의 정치 분위기에 대해 얼마나 알고 있나요? "
"짧은 설명으로는 힘들 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0015_Text
msgctxt "63114bf1-f763-4f58-92e1-36fe31de8f1d"
msgid ""
"\"Don't think I'm trying to impose a nanny or a spy on you! We're neighbors "
"now. You'll need someone knowledgeable about {g|Brevoy}Brevoy's{/g} politics "
"to act as an ambassador to your court. If you don't like Kassil, you're free "
"to choose someone else, but I won't be able to vouch for the loyalty or "
"trustworthiness of another envoy.\""
msgstr ""
"\"당신께 스파이를 심으려는 건 절대 아닙니다! 우리는 이제 이웃이니까요. {g|Brevoy}브레보이{/g}의 정치에 지식이 있는 자를 "
"보좌관으로 두는 것이 당신이게 이로울 것입니다. 카실이 싫다면 다른 사람을 선택해도 괜찮아요. 하지만 이만한 충성심과 진실함을 가진 "
"특사를 찾기는 쉽지 않을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0018_Text
msgctxt "2ca3a29c-5f6e-43c8-90cd-f18b890cd1f0"
msgid "\"I hope you have a better understanding of what's at stake.\""
msgstr "\"우리가 처한 위기에 대해 더 잘 이해하셨기를 바랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0020_Text
msgctxt "f02e7b16-842c-4b5b-9b95-1a63b8b93aa9"
msgid ""
"\"Of course. Kesten gave me a full report. You dealt with the scoundrel "
"perfectly. It would be naive to think that none of your neighbors will try "
"to stick their hands in your affairs — especially that sly fox Irovetti!\""
msgstr ""
"\"물론. 케스턴이 제게 전부 보고해 주었습니다. 악당을 완벽하게 처리하셨더군요. 인접 국가들의 간섭이 없을 거라고 생각한다면 순진한 "
"겁니다. 특히 교활한 여우 이로베티를 기억하십시오!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0022_Text
msgctxt "70bd1bf6-2799-491b-a09e-5aa29cbea9ce"
msgid ""
"\"What's now called {g|Brevoy}Brevoy{/g} was originally two different "
"countries — {g|Rostland}Rostland{/g} and {g|Issia}Issia{/g}. Two hundred "
"years ago, they were stuck in constant squabbles. Then {g|Choral}Choral the "
"Conqueror{/g} showed up and united the two states into one. Such diplomatic "
"tricks are easy to manage when you have dragons at your disposal.\""
msgstr ""
"\"현재 {g|Brevoy}브레보이{/g}라고 불리는 나라는 원래 서로 다른 두 개의 나라 {g|Rostland}로스틀랜드{/g}와 "
"{g|Issia}이시아{/g}가 합쳐진 것입니다. 이백 년 전에 두 나라는 지속적인 갈등을 빚고 있었지요. 그러던 어느 날 "
"{g|Choral}정복자 코랄{/g}이 나타나 두 나라를 하나로 통일했습니다. 그러한 외교적 트릭들은 드래곤들을 맘대로 부릴 수 있을 "
"때는 쉽게 되는 법이지요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0023_Text
msgctxt "b0020387-cec0-4345-aecb-3c6cf07ff4cb"
msgid ""
"\"The so-called noble Houses of {g|Brevoy}Brevoy{/g} — mainly {g|House "
"Surtova}Surtova{/g}, {g|House Orlovsky}Orlovsky{/g}, and {g|House "
"Lebeda}Lebeda{/g} — once ruled over {g|Issia}Issia{/g}. We, {g|Swordlords}"
"the Aldori{/g}, ruled {g|Rostland}Rostland{/g}. {g|House Rogarvia}The Royal "
"House Rogarvia{/g}, founded by {g|Choral}Choral the Conqueror{/g}, forced us "
"into obedience. But two hundred years isn't long enough to make peace with "
"such a troubled history — even two thousand years wouldn't be enough for us "
"to accept Issian rule! Brevoy is a country held together by a thread, and "
"that thread grows ever weaker.\""
msgstr ""
"\"{g|Brevoy}브레보이{/g}의 귀족인 {g|House Surtova}서토바{/g}와 {g|House "
"Orlovsky}오를로브스키{/g}, {g|House Lebeda}레베다{/g}가문은 {g|Issia}이시아{/g}의 지배를 "
"받았었습니다. 우리 {g|Swordlords}알도리{/g}는 {g|Rostland}로스틀랜드{/g}의 지배를 받았었지요. "
"{g|Choral} 정복자 코랄{/g}이 설립한 {g|House Rogarvia}로가비아{/g} 가문이 모두를 굴복 시켰지만, 이백 "
"년이라는 세월은 평화를 이루기에 충분하지 않았습니다. 심지어 이천년이 지나도 우리는 이시아의 통치를 받아들이지 못할 겁니다. 브레보이는 "
"겨우 실로 묶여진 나라이고, 그 실 마저 끊어지려고 하는 게 현실이죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0024_Text
msgctxt "01390472-3831-47c9-a9ea-a48e03e63d27"
msgid ""
"\"We — {g|Swordlords}the Aldori{/g} and the Great noble Houses — spent two "
"hundred years under the rule of invaders, {g|House Rogarvia}the Royal House "
"Rogarvia{/g}. We plotted, we schemed, we stabbed each other in the back, but "
"open confrontation was out of the question. But a few years ago, House "
"Rogarvia... disappeared. No one knows how or why, but one day, their manors "
"were just... empty. And the force that held {g|Brevoy}Brevoy{/g} together, "
"that kept us from a bloody feud... ceased to be.\""
msgstr ""
"\"우리 {g|Swordlords}알도리{/g}와 많은 귀족 가문들은 침략자 {g|House Rogarvia}로가비아 왕가{/g}의 "
"통치 아래에서 이백 년을 보냈습니다. 서로 수많은 암투가 있었지만, 전면전은 불가능했지요. 하지만 몇 년 전에 로가비아 왕조는... "
"사라졌습니다. 왜, 어떻게 하루아침에 그들의 영지가 비었는지는 아무도 모릅니다. 그리고 {g|Brevoy}브레보이{/g}를 하나로 "
"붙잡아두던, 피비린내 나는 반목으로부터 지켜주던 힘은... 사라졌죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0025_Text
msgctxt "49fafe22-eac5-4eb4-bd71-b437046b7c67"
msgid ""
"\"{g|Brevoy}Brevoy{/g} is currently ruled by {g|House Surtova}the House "
"Surtova{/g} — the former kings of {g|Issia}Issia{/g}. But their power pales "
"in comparison to that of {g|House Rogarvia}House Rogarvia{/g}, when they "
"were here. So now, Surtova and {g|Swordlords}Aldori{/g} stand facing each "
"other, staring each other in the eye, waiting for the other to draw their "
"sword. It's an untenable situation. No one wants a civil war that would "
"drown Brevoy in blood... but peace between us is also out of the question.\""
msgstr ""
"\"{g|Brevoy}브레보이{/g}는 현재 {g|House Surtova}서토바 가문{/g}의 지배를 받고 있습니다. 그들은 "
"{g|Issia}이시아{/g}를 지배했던 가문이었죠. 하지만 그들의 힘은 {g|House Rogarvia}로가비아{/g}와의 전쟁에서 "
"많이 약해졌습니다. 지금은 서토바와 {g|Swordlords}알도리{/g}가 서로를 못 잡아먹어 안달이고 누군가 그들의 칼을 뽑아주기를 "
"기다리고 있습니다. 극도로 긴장된 상황이라고 볼 수 있죠. 아무도 브레보이가 피로 물드는 것을 원하지 않지만... 두 가문 사이에 평화는 "
"불가능한 상태죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0028_Text
msgctxt "9d92ebd7-5eea-4003-a7ae-094d6a2dc85b"
msgid ""
"\"{g|Rostland}Rostland{/g} wants to regain its independence — and we will "
"regain it. The power the {g|Issia}Issians{/g} hold over us is humiliating "
"and costly. And the {g|House Surtova}Surtovas{/g} won't give us our freedom "
"without a fight — that is, unless there's some external power that can force "
"everyone to sit down and talk... Do you see where this is going?\""
msgstr ""
"\"{g|Rostland}로스틀랜드{/g}는 다시 독립하기를 원하고 해내고 말 겁니다. {g|Issia}이시아{/g}의 통치는 굴욕적이고 "
"비용적으로도 큰 문제니까요. {g|House Surtova}서토바{/g}에게서의 자유는 전쟁 없이 이뤄지지는 않을 겁니다... 강제로 "
"협상 테이블에 앉게 할 외부의 압박이 없는 한 말이죠. 이제 대충 상황이 이해가 되시는지요?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0029_Text
msgctxt "18bd13b5-dfcf-41ac-8ff6-0b93d7c2b82e"
msgid ""
"\"{g|Stolen Lands}The Stolen Lands{/g} are disputed territory. "
"{g|Brevoy}Brevoy{/g} can't appropriate them without raising protests from "
"each of the neighboring states. However, if some brave people were to found "
"independent states on that land, it would be another matter entirely. My "
"hope is that you and your future neighbors — Baron Hannis Drelev and Captain "
"{d|Varn}Maegar Varn{/d} — will become our allies. But even your neutrality "
"would introduce a powerful counterbalance to the aggression of the Noble "
"Houses. Maybe, with your help, the inevitable division of Brevoy can occur "
"without too much pain.\""
msgstr ""
"\"{g|Stolen Lands}도둑맞은 땅{/g}은 분쟁 지역입니다. {g|Brevoy}브레보이{/g}는 인접 국가들로부터 지속적으로 "
"이의 제기를 받아왔고 적절히 대처하지 못하고 있었죠. 그러나 용감한 사람들이 그 땅에서 독립 국가를 설립한다면 상황은 완전히 달라질 "
"겁니다. 그래서 당신과 하니스 드렐레프 남작, 메이가르 반 단장이 우리의 동맹이 되기를 바라는 것이죠. 당신이 중립적인 태도만 유지해 "
"줘도 인접 귀족 가문들의 공격성에 강력한 억제력이 될 겁니다. 당신이 도와준다면 브레보이의 갈등은 훨씬 적은 고통으로 해결될 테고요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0030_Text
msgctxt "13284d30-47ef-4e26-9e27-a165d77cbe8e"
msgid ""
"\"Actually, she could still intervene and disrupt the proceedings. But she's "
"a {g|House Surtova}Surtova{/g} — their games are always complex and "
"multilayered. They're always looking for ways to turn defeat into victory. "
"If she's decided to allow you to become a baron{mf||ess}, it means she "
"already has some idea of how she can turn it to her benefit. Let's consider "
"how she could do so.\""
msgstr ""
"\"사실, 그녀는 여전히 절차에 개입하고 방해할 수 있습니다. 하지만 그녀는 {g|House Surtova}서토바{/g}입니다. 그들의 "
"머릿속은 복잡하고 몇 수를 내다본 책략들이 가득하지요. 그들은 항상 패배 속에서 승리를 찾아낼 방법을 찾아냅니다. 그녀가 당신을 남작으로 "
"인정한다는 건 이미 자신의 이익을 챙길 방법을 모두 마련했다고 생각하면 됩니다. 그녀가 어떤 방책을 생각해냈는지 생각해보죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0031_Text
msgctxt "d8f63b4d-797b-4756-8911-c7699173c570"
msgid ""
"\"Maybe she understands that {g|Rostland}Rostland{/g} will inevitably "
"separate, and she doesn't want a war. In that case, new states in {g|Stolen "
"Lands}the Stolen Lands{/g} give the {g|Issia}Issians{/g} a reason to sit "
"down and talk without losing face. But that's an optimistic view, and truth "
"be told, it doesn't quite match up with what we've come to expect from the "
"{g|House Surtova}Surtovas{/g}.\""
msgstr ""
"\"아마 그녀는 {g|Rostland}로스틀랜드{/g}가 독립하는 것이 불가피하다고 생각했고 전쟁을 원하지 않았을 겁니다. 그럴 경우에 "
"{g|Stolen Lands}도둑맞은 땅{/g}은 {g|Issia}이시아{/g}에게 체면을 잃지 않고 협상을 할 좋은 중개자가 되겠죠. "
"물론 이 가정은 낙관적인 얘기고 사실 {g|House Surtova}서토바 가문{/g}은 제 예상을 벗어날 때가 더욱 많습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0032_Text
msgctxt "c7e0078d-63eb-459a-b8e8-a77bc4dfb18b"
msgid ""
"\"The more likely scenario is that Natala wants to win you over to her side. "
"If war breaks out and at least one of you stabs us in the back, "
"{g|Rostland}Rostland{/g} will be surrounded by enemies. That might be enough "
"to bring about our downfall... But you would fall first, and your newly "
"formed states would be left in ruin. The {g|Issia}Issians{/g} always like to "
"have someone around to pull their chestnuts out of the fire for them. A "
"piece of friendly advice: don't do business with {g|House "
"Surtova}Surtovas{/g}, no matter what promises they make you. Any deal with "
"the Noble Houses is a deal with devils.\""
msgstr ""
"\"더 가능성 있는 이야기는 나탈라가 당신을 자기 편으로 포섭하려는 것일 겁니다. 전쟁이 터지고 당신이 우리를 배신한다면 "
"{g|Rostland}로스틀랜드{/g}는 적들에게 포위될 테니까요. 그건 우리의 몰락을 불러올 만큼 치명적이겠죠... 하지만 만약 그렇게 "
"된다면 당신이 우리보다 먼저 멸망하고 당신의 도시는 폐허가 될 겁니다. {g|Issia}이시아{/g}는 항상 불속에서 익은 감자를 대신 "
"꺼내줄 희생자를 곁에 두고 싶어 하죠. 조언 하나 하자면 {g|House Surtova}서토바{/g}가 당신에게 어떤 약속을 해주던 절대 "
"거래하지 마세요. 귀족 가문과의 거래는 데블과의 거래나 마찬가지니까요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0033_Text
msgctxt "baf1cfc5-c906-4768-85d2-790700767027"
msgid ""
"\"How should I know? We're in the middle of a big game — and today you move "
"from being merely a piece on the board to being one of the players.\""
msgstr ""
"\"제가 어떻게 알겠습니까? 우리는 큰 게임의 한가운데에 있습니다. 그리고 오늘 당신은 체스 말에서 체스를 두는 사람으로 바뀌었죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0034_Text
msgctxt "170ec63c-5adf-469a-9eae-4e571fd5434e"
msgid ""
"\"Enjoy your evening! When you're ready for the official part, come to me.\""
msgstr "\"좋은 저녁 되십시오! 공식 절차를 진행할 준비가 되면 저를 찾아오세요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0036_Text
msgctxt "1feaddab-468e-41e8-aee0-e73e768c0f65"
msgid ""
"\"{g|Restov}Restov{/g} is a free city, proud of its independence from "
"everyone, including the {g|Swordlords}Aldori Swordlords{/g}. But when it "
"comes to {g|Rostland}Rostland's{/g} liberation, our goals align. This whole "
"plan is our joint creation with Lord Mayor Ioseph Sellemius.\""
msgstr ""
"\"{g|Restov}레스토프{/g}는 자유 도시로서 {g|Swordlords}알도리 소드로드{/g}를 포함한 모두로부터 독립을 "
"선포했습니다. 하지만 {g|Rostland}로스틀랜드{/g}의 해방에 관해서는 같은 목표를 가지고 있죠. 이 모든 계획은 요셉 시장님과의 "
"합작이죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0037_Text
msgctxt "22d77c96-8497-41e0-8e09-a4f1edc744c9"
msgid ""
"\"You have pulled it off even {d|c11 Fast}faster{/d} than I expected. Very "
"good: we were short of time, and these months you've won for us proved very "
"useful. Lord Mayor Sellemius especially appreciated it, and asked me to give "
"you this little token of gratitude.\""
msgstr ""
"\"제 생각보다 {d|c11 Fast}더 빨리{/d} 완수했더군요. 아주 좋습니다. 저희는 시간이 없었고, 최근 몇 달 동안의 승리로 "
"우리에게 유용함을 입증하셨으니까요. 셀레미우스 시장님이 감사를 표하면서 제게 당신께 이걸 전해달라고 부탁하시더군요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0039_Text
msgctxt "1f92b807-7c17-4010-80b2-262b6555a2a2"
msgid ""
"\"We hope to get some help from the Mivoni Aldori — the descendants of the "
"{g|Swordlords}Swordlords{/g} who have fled from {g|Choral}Choral's{/g} rage "
"to build a new nation in the south. But the {g|Issia}Issians{/g} know this "
"well, and are doing everything they can to deny us this help. I won't go "
"into details, but, if my intelligence is correct, if a civil war starts in "
"{g|Brevoy}Brevoy{/g}, {g|Mivon}Mivon{/g} will be too occupied with its own "
"inner troubles to interfere.\""
msgstr ""
"\"우리는 {g|Choral}코랄{/g}의 위협으로부터 도망쳐 남쪽에 나라를 세운 {g|Swordlords}소드로드{/g}들의 후손, "
"미본 알도리의 도움을 받기를 원합니다. 하지만 {g|Issia}이시아{/g}는 이 사실을 잘 알고 있고 이 도움을 차단하기 위해 온갖 "
"수를 쓰고 있죠. 자세한 설명은 하지 않겠지만 제 예상이 맞는다면, {g|Brevoy}브레보이{/g}에서 내전이 시작되면 "
"{g|Mivon}미본{/g}에도 내부적인 문제들로 바쁠 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Jamandi_Private/Cue_0041_Text
msgctxt "075bdc94-f881-4b76-9d30-d8a916ba1dff"
msgid ""
"{n}Jamandi nods.{/n} \"I will pray to the God of Walls and Ditches that he "
"never leave your side. Though you can definitely expect more support from me "
"than just thoughts and prayers!\""
msgstr ""
"{n}자만디는 고개를 끄덕입니다.{/n} \"벽과 도랑의 신에게 당신을 저버리지 말라고 기도할 것입니다. 제게 생각과 기도보다 더 많은 "
"지원을 바라시겠지만 말입니다!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Answer_0004_Text
msgctxt "36a80d89-a5af-4582-bedf-86dbb6730371"
msgid "\"Just Lander? No last name? No title?\""
msgstr "\"랜더? 성은 없어? 칭호도 없나?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Answer_0005_Text
msgctxt "e0ff6d3e-27cf-4ef4-8af8-c3b0d96793d2"
msgid "\"Are you from Restovic nobility?\""
msgstr "\"너는 레스토프 귀족 출신이야?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Answer_0006_Text
msgctxt "9742a2f4-9974-4c42-b1a8-95b7e0b2e25a"
msgid "\"Please, tell me again what you're doing here?\""
msgstr "\"여기서 뭘 하고 있었다고?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Answer_0010_Text
msgctxt "5274aca2-c759-4f72-a5cd-eaaac57e9cff"
msgid "\"A pleasure meeting you. Goodbye.\""
msgstr "\"만나서 반가웠어. 안녕.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Answer_0013_Text
msgctxt "09cbb9f0-0fa0-43ff-93d7-ad5b43573059"
msgid "\"I'll consider your proposal.\""
msgstr "\"네 제안을 고려해 보지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Answer_0016_Text
msgctxt "bc1905ed-6052-4c1f-9fb4-dc7ca0db8838"
msgid "\"Tell me once more what you want from me.\""
msgstr "\"나에게 무엇을 원하는지 다시 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Cue_0001_Text
msgctxt "a58de0a5-fa87-4e4d-96de-a7e423d64a71"
msgid ""
"{n}A handsome, well-dressed young man of about seventeen years old looks at "
"you with a polite smile.{/n}"
msgstr "{n}17세 정도로 보이는 잘생기고 잘 차려입은 청년이 당신에게 친절하게 인사합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Cue_0002_Text
msgctxt "61786129-073a-4bfb-83a6-402033e45a90"
msgid ""
"\"So, you're the famous slayer of the Stag Lord's gang, soon to be a "
"baron{mf||ess}? Pleased to make your acquaintance. My name is... Lander.\""
msgstr "\"아, 당신이 그 유명한 수사슴 군주를 살해한 신진 남작이신가? 만나서 반갑군. 내 이름은... 랜더야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Cue_0007_Text
msgctxt "b403fd52-6885-476f-88c1-61c5700a4cbc"
msgid ""
"\"Well, let's just say I'm here... incognito. Under my circumstances, it's "
"wise to keep one's lineage to oneself.\""
msgstr "\"그냥 몰라도 돼. 우리 같은 귀족은 혈통을 밝히지 않는 게 현명하거든.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Cue_0008_Text
msgctxt "88cca767-120c-4c1b-8055-15094635a6fe"
msgid ""
"\"Oh, no, I'm not from here. I'm just visiting, you could say. I wanted to "
"see for myself the heroes who managed to conquer the frontier lands, and the "
"Lord Mayor was kind enough to invite me to this wonderful party.\""
msgstr ""
"\"아니야. 나는 여기 출신이 아니야. 그냥 지나다가 들렸어. 나는 기회의 땅을 점령한 영웅을 내 두눈으로 보고 싶었고 시장이 잔치에 "
"초대해서 오게 된 것 뿐이야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Cue_0009_Text
msgctxt "51d38587-a1a8-4849-8b6a-fd7a95999e3e"
msgid ""
"\"Truth be told, that's precisely what I wanted to speak with you about. You "
"see, I am an heir to one of {g|Brevoy}Brevoy's{/g} Noble Houses. I won't say "
"which, but believe me, a newly appointed baron{mf||ess} with no connections "
"would do well to have a friend like me.\""
msgstr ""
"\"사실은 그게 바로 내가 말하고 싶었던 거야. 나는 {g|Brevoy}브레보이{/g} 귀족의 상속자야. 더 말할 수는 없지만 나를 "
"믿어줘. 새로운 남작과 인맥을 만들 때 나와 같은 친구를 두면 이득이야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Cue_0011_Text_String
msgctxt "b7fce405-52e5-422a-899b-7fc9dc321f44"
msgid ""
"\"I travel the country in secret, without servants, so I can see it for "
"myself — not from a carriage window, but face-to-face with the people. My "
"family would never approve, of course — but then, I never asked. I need to "
"know {g|Brevoy}Brevoy{/g} if I'm going to rule a part of it someday.\""
msgstr ""
"\"나는 이 나라를 몰래 여행 중이야, 하인 없이. 그래서 마차 창문을 넘어 보는 것이 아니라 사람들과 직접 면대면으로 만날 수 있지. "
"물론 우리 가족은 절대로 허락하지 않을거라서 요청하지도 않았어. 언젠가 이곳을 통치하려면 {g|Brevoy}브레보이{/g}를 알아둘 "
"필요가 있거든.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Cue_0012_Text_String
msgctxt "b776dbc2-9d35-4628-a1f7-dcbd08c3d606"
msgid ""
"\"I know Jamandi wants to impose her stepson on you as an emissary of "
"{g|Brevoy}Brevoy{/g}. Refuse. Take me instead. Don't look at my age — while "
"they may have trained this half-orc to swing a sword, I've been training to "
"rule since I was a child. I'll be of far greater use to you — both now and "
"in the future, after I have a firm position in my family.\""
msgstr ""
"\"자만디가 자신의 양자를 너의 {g|Brevoy}브레보이{/g} 사절로 임명하기를 바란다는 걸 알아. 하지만 거절해야해. 대신 나를 "
"선택해. 내 나이는 상관하지 마. 그들이 하프오크에게 칼을 휘두르는 방법을 알려주는 동안 난 어렸을 때부터 통치하는 법을 배웠어. 나는 "
"너에게 엄청 더 크게 쓸모가 있을 거야-지금이나 미래에도, 내가 우리 가족 내에서 확고한 지위를 얻게 된 이후에도 말이지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Cue_0014_Text
msgctxt "450093bb-3dd6-43fe-bc21-3ecce428455a"
msgid ""
"\"Wait, we've only just met! This is the whole point of parties such as this "
"— making connections that could eventually grow into alliances!\""
msgstr "\"잠깐, 우리는 방금 만났어! 이 모임의 목적은 이런 거야. 종국에 동맹이 될 만한 인맥을 만드는거라고!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Lander/Cue_0018_Text
msgctxt "f7a93994-c85d-456d-9d35-7621f1469035"
msgid "\"Yes. Do so, and carefully.\""
msgstr "\"그래. 그렇게 해. 하지만 신중히 하라고.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Answer_0003_Text
msgctxt "b636da70-9fbd-47ee-b7d6-199ffcacd670"
msgid "\"Is this a threat?\""
msgstr "\"이건 위협입니까?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Answer_0005_Text
msgctxt "b33bae46-487b-41ef-8509-ed3ef1604a40"
msgid "\"What do you think awaits me?\""
msgstr "\"무엇이 나를 기다리고 있다고 생각하나요?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Answer_0008_Text
msgctxt "0fc1b0fa-1aa0-4528-bc56-14f755d36e92"
msgid "\"What would you propose?\""
msgstr "\"당신의 제안은 뭡니까?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Answer_0010_Text
msgctxt "d7ae103c-5363-496e-8e1b-ae2c3357a86c"
msgid "\"It was a pleasure meeting you. May I take my leave.\""
msgstr "\"만나서 즐거웠어요. 이제 자리를 떠야겠군요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Answer_0011_Text
msgctxt "d30d01fe-cd81-4804-8cd5-75210f6410c3"
msgid "\"I'll consider your proposal.\""
msgstr "\"당신의 제안을 고려해 보지요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Cue_0001_Text
msgctxt "5b8f9235-7af8-401d-a14e-ef735f5f5f6c"
msgid ""
"{n}{d|Natala}Natala{/d} {g|House Surtova}Surtova{/g} is discussing something "
"with an unfamiliar old lady in a low voice. Upon noticing you, she breaks "
"into a sugary sweet smile.{/n} \"You were not only tough, but quick! Well, "
"congratulations on your victory. Enjoy it... while you can.\""
msgstr ""
"{n}{d|Natala}나탈라{/d} {g|House Surtova}서토바{/g}는 낮은 목소리로 낯선 노파와 무언가를 논의하고 "
"있습니다. 당신을 보자 그녀는 달콤한 미소를 짓습니다.{/n} \"강인할 뿐만 아니라 빠르기까지! 승리하신 것을 축하드립니다. 이 순간을 "
"즐기시길 바랍니다... 가능할 때 말이죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Cue_0004_Text
msgctxt "bbff24c5-8a92-4e86-b604-0f64c4f37d22"
msgid ""
"\"I would never. I simply wished to warn you, in case you don't fully "
"realize the fate that awaits you and your barony.\""
msgstr ""
"\"그럴 리가요. 전 그저 당신과 당신의 남작령을 기다리고 있는 운명에 대해 모르고 계실 경우를 대비해서 주의를 드리고 싶었을 뿐입니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Cue_0006_Text
msgctxt "2d5769a9-22f5-48b8-96e2-574e4f31496b"
msgid ""
"\"Nothing good, I fear. The Aldori, our dearest friends, didn't deem it "
"necessary to inform you of their plans, I assume? You see, they're preparing "
"to separate from {g|Brevoy}Brevoy{/g} — it will not be a peaceful process.\""
msgstr ""
"\"좋은 일은 아니죠. 우리의 너무나도 소중한 친구 알도리가 당신에게 자신의 계획을 알려주지 않았나요? 당신도 아시다시피, 그들은 "
"{g|Brevoy}브레보이{/g}에서 독립하길 원하고 있습니다. 그건 평화로운 과정은 아닐 테죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Cue_0007_Text
msgctxt "54e45f67-804e-401c-bc5b-8fb7df2ab96d"
msgid ""
"\"They lack the strength, currently — hence using this legal loophole to "
"create some 'independent' allies. Once the civil war breaks out, your lands "
"will be the first to endure a strike from {g|Brevoy}Brevoy's{/g} forces. "
"Perhaps they'll erect a memorial stone in independent {g|Restov}Restov{/g} "
"to honor you... Well, I wouldn't count on even that, really.\""
msgstr ""
"\"지금 그들은 힘이 부족합니다. 그런 이유로 이런 소유권이 불분명한 분쟁 지역 같은 법적으로 허술한 부분을 이용해서 '독립적인' "
"동맹국을 만들죠. 일단 내전이 발발하면 당신의 땅은 {g|Brevoy}브레보이{/g}의 공격을 견뎌야 하는 첫 번째 나라가 될 것입니다. "
"아마 그들은 당신을 기리기 위해 독립한 {g|Restov}레스토프{/g} 내에 기념비 정도는 세워주겠죠... 뭐, 사실 그조차도 기대하지 "
"힘들겠지만요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Cue_0009_Text
msgctxt "1e23047b-02ce-4d5a-8299-d798f5d02cd6"
msgid ""
"\"In your situation, the most reasonable course of action would be to align "
"yourself with the lawful rulers of {g|Brevoy}Brevoy{/g} — the noble Houses. "
"{g|Swordlords}The Aldori{/g} won't dare to rebel, knowing they will "
"immediately become entrapped. You could help Brevoy avoid a civil war, while "
"simultaneously enjoying some well-deserved peace in your lands.\""
msgstr ""
"\"당신의 상황에서 가장 합리적인 행동은 {g|Brevoy}브레보이{/g}의 합법적인 통치자와 조율을 하는 것입니다. 바로 귀족 가문들 "
"말이죠. {g|Swordlords}알도리{/g}는 즉시 함정에 빠지게 될 것을 알고 반역을 일으킬 엄두조차 내지 못할 것입니다. 당신은 "
"브레보이의 내전을 막는 동시에 당신의 땅에도 어느 정도는 응당한 평화를 누릴 수 있을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Cue_0012_Text
msgctxt "968947f6-a99c-4588-aff0-147e2f3cbc0d"
msgid ""
"\"I believe Jamandi has already attempted to impose a guard on you as an "
"emissary? I'm guessing her lowborn stepson — the green-skinned boy, Kassil. "
"It's up to you, of course, but I would recommend you a different envoy. "
"Please meet Shandra Mervey, an experienced diplomat who's more familiar with "
"Brevoy's politics than any brawler could be.\""
msgstr ""
"\"자만디가 이미 자신의 부하를 당신의 특사로 임명하려 했다는 것을 알고 있습니다. 추측컨데 아마 그녀의 천출 양자인 - 녹색 피부의 "
"소년, 카실이겠지요. 물론 선택은 당신에게 달렸어요. 하지만, 저는 다른 특사를 추천하고 싶습니다. 브레보이의 정치에 그 누구보다 "
"정통하고 경험 많은 외교관, 샨드라 머베이입니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Cue_0013_Text
msgctxt "312eefc8-16e1-4017-877d-68963a5101d3"
msgid "\"Before you leave, please allow me to introduce someone to you.\""
msgstr "\"당신이 떠나기 전에, 소개해 드릴 분이 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Cue_0014_Text
msgctxt "286dba13-ef3a-463c-af16-7c9a9a5b7420"
msgid ""
"\"What a wonderful celebration! One thing is for certain — the Aldori know "
"how to enjoy themselves.\""
msgstr "\"정말 멋진 연회입니다! 한가지는 확실해. 알도리는 즐기는 방법을 알고 있죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Cue_0015_Text
#. Speaker : Shandra_Baronation
msgctxt "4bf15b47-b40e-4e60-be79-ec64fe704091"
msgid ""
"{n}The old woman standing next to Natala gives you a slight bow.{/n} \"I "
"would be happy to help you establish diplomatic relations with "
"{g|Brevoy}Brevoy{/g}.\""
msgstr ""
"{n}나탈라 옆에 서있는 나이 든 여자가 인사를 합니다.{/n} \"{g|Brevoy}브레보이{/g}와의 외교적 관계를 수립할 수 있도록 "
"도울 수 있어 기쁩니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Natala/Cue_0016_Text
msgctxt "7792933a-7fec-487b-9894-2abfb42efd37"
msgid "\"Think on it. Do not make any hasty decisions.\""
msgstr "\"생각해봐주세요. 성급한 결론은 내리지 않길 바랍니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Answer_0004_Text
msgctxt "11a8c978-f265-4241-846b-2a3a37720f7a"
msgid "\"I don't believe we've been introduced.\""
msgstr "\"우리가 만난 적이 있던가요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Answer_0006_Text
msgctxt "007f0cdb-c17e-45ac-bc81-5b9d6153e705"
msgid "\"So, you rule Restov? And what about the Aldori?\""
msgstr "\"그래서 당신이 레스토프를 통치하나요? 알도리는 어쩌고?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Answer_0009_Text
msgctxt "956aa91a-2228-47f5-91b6-b05222bd2938"
msgid "\"How are things in Restov?\""
msgstr "\"레스토프는 요즘 어떻습니까?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Answer_0011_Text
msgctxt "2d58a065-5fca-4ba3-953f-0acf1dd47b17"
msgid "\"It was nice meeting you. Goodbye.\""
msgstr "\"만나서 반가웠어요. 안녕히.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Answer_0016_Text
msgctxt "0fde8e4c-5bab-434d-805d-a4022d2a05b6"
msgid "\"I would be happy to accept your offer.\""
msgstr "\"당신의 제안을 기꺼이 받아들이죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Answer_0017_Text
msgctxt "000181e8-be6d-444e-a74e-56f1415c8ac1"
msgid "\"Thank you for the offer, but I can't accept it.\""
msgstr "\"제안해 주어 고맙지만 받아들일 수 없겠네요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Answer_0021_Text
msgctxt "a990926b-a591-4708-80c8-6c2d12de7329"
msgid ""
"\"I'll probably accept your offer in the end. I'll need resources for "
"construction, after all.\""
msgstr "\"결국 당신의 제안을 받아들여야겠군요. 나에게는 자원이 필요할 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Answer_0022_Text
msgctxt "9f5fd22f-4511-48c8-b769-e1ee0ed652bb"
msgid "\"What kind of 'events' were you talking about?\""
msgstr "\"어떤 종류의 '사건들'에 대해 이야기하고 있는 거죠?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Cue_0001_Text
msgctxt "46504ec6-a25e-4cd0-a478-c7917bb16175"
msgid ""
"{n}An older {d|Sellemius}man{/d} with full sideburns looks at you with "
"interest through a golden eyeglass.{/n} \"Well, now, if it isn't the hero of "
"the festivities, the protege of our dear Jamandi!\""
msgstr ""
"{n}구레나룻이 덥수룩하고 나이 든 {d|Sellemius}남자{/d}가 금테를 두른 외알 안경 너머로 당신을 봅니다.{/n} \"아니. "
"이게 누구십니까. 연회의 영웅, 우리 소중한 자만디님의 손님이 아니십니까!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Cue_0002_Text
msgctxt "ee92332d-236b-4aa5-bd0f-520b296858c9"
msgid ""
"\"You pulled this all off quite cleverly! I confess, I wasn't convinced your "
"enterprise would succeed — I even bet a bottle of my best "
"{g|Pitax}Pitaxian{/g} wine against you! But I'm happy to admit I was wrong. "
"The Aldori have always been adept at finding new talent!\""
msgstr ""
"\"일처리를 영리하게 해내셨더군요! 지금에서야 고백하건대, 사실 저는 당신이 성공할 것이라고 확신하지 못했습니다. 심지어 당신이 질 "
"거라는 데에 고급 {g|pitax}피탁스{/g} 와인을 내기로 걸기도 했습니다! 하지만 제가 틀렸다는 것을 인정하게 되어 기쁩니다. "
"알도리는 항상 새로운 인재를 찾는 데에 능숙했지요!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Cue_0005_Text
msgctxt "cee72367-aefe-48fa-aa4a-a36b0db8d840"
msgid ""
"\"So it would seem. I am {d|Sellemius}Ioseph Sellemius{/d}, Lord Mayor of "
"{g|Restov}Restov{/g} — I rule this town and the adjacent lands. As your "
"northern neighbor, I hope we can look forward to a long and fruitful "
"friendship!\""
msgstr ""
"\"그런 듯하군요. 저는 {d|Sellemius}요셉 셀레미우스{/d}, {g|Restov}레스토프{/g}의 시장입니다. 이 도시 인근의 "
"땅들을 다스리고 있지요. 당신 입장에서는 북쪽의 이웃이 되겠군요. 우리가 부디 돈독한 이웃 관계가 되기를 바랍니다!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Cue_0007_Text
msgctxt "79c71e5d-1287-483e-b955-01b4982144f4"
msgid ""
"\"Ah, {g|Brevoy}Brevoy's{/g} politics seem complex and incomprehensible to "
"many. Here, in this part of {g|Rostland}Rostland{/g}, the spirit of northern "
"freedom still lives. We are loyal to the throne, of course — may the gods "
"prolong the life of {g|King Noleski Surtova}His Highness{/g} — but here, far "
"from the dominions of the great houses, we have our own way of life... It is "
"especially important now, after the certain events that I probably don't "
"need to name.\""
msgstr ""
"\"아. {g|Brevoy}브레보이{/g}의 정치는 복잡하고 이해하기 어렵습니다. {g|Rostland}로스틀랜드{/g}는 북부인의 "
"자유의 정신이 여전히 살아있지요. 우리는 물론 왕위에 충성하고 있습니다. {g|King Noleski Surtova}전하{/g}께서 항상 "
"건강하시겠지만, 하지만 위대한 가문들의 지배권에서 거리가 먼 이곳은 이곳만의 생활방식을 가지고 있습니다... 그건 지금으로서는 특별히 "
"중요하죠. 말할 것도 없이 그런 큰 사건들이 일어난 직후엔 말이죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Cue_0008_Text
msgctxt "03905a63-c625-45cf-a934-4a8ff818ae49"
msgid ""
"\"The Aldori {g|Swordlords}Swordlords{/g} used to rule "
"{g|Rostland}Rostland{/g}. They're still the largest landowners and main "
"military force in the region. But it's not for nothing that "
"{g|Restov}Restov{/g} is called a free city. We're proud to choose the Lord "
"Mayor from among the citizens, considered not by their lineage, but by their "
"own merits.\""
msgstr ""
"\"알도리 {g|Swordlords}소드로드{/g}는 한때 {g|Rostland}로스트랜드{/g}를 지배했습니다. 그들은 아직도 이 "
"지역에서 가장 큰 지주이자 주요 군사력으로서의 역할을 하고 있지요. 하지만 {g|Restov}레스토프{/g}가 자유도시라고 불리는 데에는 "
"그만한 이유가 있답니다. 우리는 혈통이 아닌 시민들 중에서 충분한 공적을 세운 이를 선정하여 시장으로 세웁니다. 이러한 방식이 저는 "
"자랑스럽습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Cue_0010_Text
msgctxt "175913af-0db1-47e1-a0db-9d62bdb72c05"
msgid ""
"\"I don't want to boast, but things have been going well in recent years. "
"Trade prospers, the population grows, and the citizens are happy! Although "
"recently — especially after the disappearance of {g|House Rogarvia}House "
"Rogarvia{/g} — more and more troublemakers have been appearing, and people "
"are talking about the most shocking things... But those sorts of rumors "
"aren't worthy of your attention.\""
msgstr ""
"\"자랑하고 싶지 않지만 최근 몇 년 동안 일이 잘 풀리고 있습니다. 무역이 번성하고 인구가 늘어나고 시민들은 행복해하고 있지요! 최근에 "
"{g|House Rogarvia}로가비아 가문{/g}이 사라지는 일이 발생하고 점점 더 사건이 많아지기는 하지만... 그런 소문까지 "
"당신이 신경 쓰게끔 하는 것은 누가 되겠지요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Cue_0012_Text
msgctxt "d1f69876-49d6-4bf2-bfa3-dd2b06d8fb83"
msgid ""
"\"Please wait a moment... Your young barony will need resources to establish "
"itself, and from what I've been told, you're somewhat in need of financial "
"assistance. I could organize and supply everything you need for the "
"construction, and spread out the cost on extremely favorable terms.\""
msgstr ""
"\"잠시만요... 당신의 남작령은 이제 스스로 발전하기 위한 자원이 필요할 것이고, 어느 정도 재정적인 지원이 필요하다고 들었습니다. "
"제가 공사에 필요한 모든 물자를 공급해드릴 수 있으며, 아주 유리한 조건으로 그에 대한 비용을 처리할 수 있게 해드리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Cue_0013_Text
msgctxt "ab12905e-a45f-4106-9eb1-0b8c2894caae"
msgid ""
"\"The feeling is mutual, I assure you. I look forward to hearing more of "
"your dazzling successes soon!\""
msgstr "\"동감입니다. 제가 장담컨대, 당신의 눈부신 성공에 대해 더 많은 것을 듣기를 기대할겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Cue_0019_Text
msgctxt "060881d5-b6b5-40c0-861d-86c133e12081"
msgid ""
"\"Then it's a deal! I'll get everything in order right away and schedule a "
"delivery immediately!\""
msgstr "\"계약 성사입니다! 즉시 필요한 물자를 준비하고 배송 일정을 조율하겠습니다!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Cue_0020_Text
msgctxt "5f761b92-14f4-4b84-b4ba-99e1e8ed40af"
msgid "\"It's your choice, of course. I just figured I'd mention it.\""
msgstr "\"당신의 선택을 존중합니다. 그저 제안 드린 것뿐이니 괘념치 마십시오.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Cue_0023_Text
msgctxt "0bbce35c-e932-4fb2-9486-3e0941ee0ac0"
msgid ""
"{n}Mayor Sellemius gives you a patronizing smile.{/n} \"Why, an aspiring "
"politician needs to be well-informed! I'm talking, of course, about the "
"disappearance of {g|House Rogarvia}the ruling house Rogarvia{/g}. Can you "
"imagine it? Old man {g|Choral}Choral{/g} conquered our land two centuries "
"ago. It would be a shameless lie to say that nobody wished his royal house "
"could just disappear into thin air. But once that exact thing happened — "
"turned out, nobody was ready for it!\""
msgstr ""
"{n}셀레미우스 시장은 당신에게 잘난 체하듯 웃음을 보냅니다.{/n} \"정치인은 정보가 풍부해야 합니다! 물론 {g|House "
"Rogarvia}로가비아 가문{/g}의 실종에 대해 얘기하는 겁니다. 상상할 수 있으십니까? {g|Choral}코랄{/g}은 2세기 "
"전에 우리의 땅을 정복했고, 지금까지 지배해왔습니다. 아무도 그 왕조가 사라지는 것을 바라지 않았다고 얘기하는 것은 뻔뻔스러운 "
"거짓말이겠지요. 하지만 아무런 징조도 없이 정말로 그런 일이 잃어나 버렸지요!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Cue_0024_Text
msgctxt "6ad94881-46f7-4a2f-8012-22e51f6fa8d9"
msgid ""
"\"Poof! All over the country, every member of the royal house disappeared "
"without a trace! Nobody knows what happened. It is a mystery... But a "
"mystery pregnant with opportunity for everyone!\""
msgstr ""
"\"휙! 하고 전국 각지에서 모든 왕실 사람들이 흔적도 없이 사라졌습니다! 아무도 무슨 일이 일어났는지 알지 못합니다. 그저 미스터리일 "
"뿐이지요... 하지만 모두에게 큰 기회가 될만한 미스터리입니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Sellemius/Cue_0025_Text
msgctxt "54331699-a49d-417c-8faa-754b0c92766f"
msgid ""
"\"I could immediately procure, let's say... five hundred cartloads of "
"building supplies. I'm sure that would give you a good start. In exchange, I "
"would ask a small favor: until you repay the debt in full, you simply assume "
"the obligation of contracting building services through {g|Restov}Restov{/g}"
"'s builders guild. Do we have a deal?\""
msgstr ""
"\"당장 조달할 수 있는 물자는... 건축 자재 500 수레 정도 되겠군요. 이 정도 물자라면 충분히 좋은 출발을 할 수 있을 겁니다. "
"그 대신, 작은 부탁을 하나 드리고 싶습니다. 빚을 모두 상환할 때까지 {g|Restov}레스토프{/g}의 건축가 길드를 통해 건축을 "
"계약할 의무를 져야 합니다. 계약하시겠습니까?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Varn/Answer_0004_Text
msgctxt "bcea09c3-26c3-444e-9abc-d35377f300cb"
msgid "\"How did you earn the title of baron?\""
msgstr "\"자네는 어떻게 남작의 작위를 얻었나?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Varn/Answer_0007_Text
msgctxt "defd7c5c-a039-48e2-84ff-25edfbb808c0"
msgid "\"How do you feel being a noble?\""
msgstr "\"귀족이 되어 보니 어때?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Varn/Answer_0008_Text
msgctxt "028c172b-300d-4fda-8c3d-2a168f5d779c"
msgid "\"It was nice meeting you. Farewell.\""
msgstr "\"만나서 반가웠어. 안녕히.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Varn/Cue_0001_Text
msgctxt "4d032e93-37f2-439a-a1f3-db8df1b51c08"
msgid ""
"{n}This man is obviously more comfortable on the battlefield than in the "
"company of nobles. He's well built, but the expensive waistcoat he's wearing "
"doesn't quite fit properly, as though it was borrowed. He has a few pale "
"scars across his face, and his dark hair is drawn into an unkempt ponytail "
"with a few streaks of gray running through it. He greets you with a broad "
"smile and a firm handshake.{/n}"
msgstr ""
"{n}이 남자는 분명히 귀족들 사이에서 보다 전쟁터가 더 편안해 보입니다. 그는 체격이 좋지만 그가 입고 있는 비싼 양복 조끼는 빌린 "
"옷처럼 잘 맞지 않습니다. 그의 얼굴에는 흉터가 몇 개 있었고 검은 머리는 희끗희끗한 머리가 섞인 포니테일입니다. 그는 넒은 웃음과 "
"단단한 악수로 당신을 맞이합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Varn/Cue_0002_Text
msgctxt "7b9682e3-44e0-4fce-9637-01c30fff5fc9"
msgid ""
"\"Let me introduce myself! I'm {d|Varn}Maegar Varn{/d}, the new ruler of "
"{g|Dunsward}Dunsward{/g}, your neighbor to the east. Like you, I'm about to "
"be a baron. Great job with the Stag Lord, by the way. Not everyone could "
"exterminate a whole gang of bandits with such a small team.\""
msgstr ""
"\"내 소개를 하지! 나는 {g|Dunsward}던스워드{/g}의 새로운 통치자 메이가르 반이라고 하네. 너의 동쪽 이웃이고 자네처럼 "
"이제 막 남작이 되었지. 수사슴 군주의 일은 대단하더군. 그런 소규모 원정대로 도적떼를 토벌하는 일은 아무나 할 수 있는 게 아니라네.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Varn/Cue_0005_Text
msgctxt "7cddc50d-efe1-4446-bc32-3fed7b173617"
msgid ""
"\"Truth be told, my team and I just happened to be in the right place at the "
"right time. Jamandi Aldori needed someone reliable to take and hold the "
"territory. I'm the captain of a mercenary team, if that wasn't clear. "
"Varnling Host — have you heard of us? No? No matter.\""
msgstr ""
"\"진실을 말하자면 우리 팀과 나는 적절한 시기에 적절한 장소에 있었네. 자만디 알도리는 영토를 가져가서 지배할 믿을 만한 사람이 "
"필요했던 것이지. 나는 용병단의 단장이라네. 반링 호스트라고 들어 봤는가? 못 들어 봤다고? 괜찮다네.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Varn/Cue_0006_Text
msgctxt "0869d5d2-73db-472e-b245-3b416b9a0bfe"
msgid ""
"\"We've done work for Jamandi before. This time, the task was simple — we "
"just waltzed into the area, cleared it of the most brazen monsters, and "
"built a small fort to hold the place. And for that — a barony and land to "
"own! It was a dream job!\""
msgstr ""
"\"우리는 자만디를 위해 일을 처리했지. 이번에 할 일은 간단하다네. 그 지역으로 나비처럼 날아서 뻔뻔한 괴물들을 처리하고 작은 요새를 "
"지어 지키면 돼. 그럼 남작의 자리와 영토가 주어지는 걸세! 꿈같은 일이지!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Varn/Cue_0009_Text
msgctxt "4b4691d2-d6c5-4788-b9b0-803541b30314"
msgid "\"Goodbye! Once you've settled in, come pay us a visit!\""
msgstr "\"잘가게! 돌아가면 우리 도시에도 한번 방문해주게!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Varn/Cue_0010_Text
msgctxt "38f0d124-732e-4b4e-b23d-81db6cca59f2"
msgid ""
"{n}Looking at his rich clothes, {d|Varn}Varn{/d} smirks.{/n} \"Like a "
"pheasant on a plate. I've killed all kinds of monsters — but this is the "
"first time I've so strongly felt like turning away could get me eaten.\""
msgstr ""
"{n}자신의 비싼 옷을 보며 반은 피식 웃습니다.{/n} \"접시에 담긴 꿩요리 같군. 나는 다양한 괴물을 죽여왔지만 이렇게 잡아먹힐 "
"듯한 기분은 처음일세.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Baronation/Varn/Cue_0011_Text
msgctxt "fc7e85d7-bcb5-4021-bf3b-c4169410b1d8"
msgid ""
"{n}He nods toward an arrogant man in the other corner of the room.{/n} \"See "
"that lad? Baron Drelev. He's not like us — who knows what generation of "
"baron he is? Didn't even shake my hand. You and me? We're like dirt beneath "
"his boots. That's why those like us — the newly made nobility — need to "
"stick together. Otherwise, he'd take my land and yours in the blink of an "
"eye.\""
msgstr ""
"{n}그는 방의 다른 구석에 있는 거만한 사람에게 고개를 끄덕였습니다.{/n} \"저 사람 보이는가? 드렐레프 남작이라네. 그는 우리와 "
"달라. 대대로 남작 가였지. 그런데 자네나 나는? 저 사람에게 우리는 자기 신발 밑창의 진창 같은 존재라네. 그렇기 때문에 우리 같은 "
"신진 남작들끼리 뭉쳐야 할 필요가 있다고 보네. 그렇지 않으면 눈 깜짝할 사이에 땅을 빼앗길걸.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0006_Text
msgctxt "64724b10-375a-47b3-976c-bbd8a00e13d3"
msgid "\"Who are you?\""
msgstr "\"넌 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0007_Text
msgctxt "78fdc1cc-38f7-423e-b42e-1f11cc926ae5"
msgid "\"What are you doing here?\""
msgstr "\"여기서 뭐하고 있어?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0008_Text
msgctxt "b2bd20e3-e2f2-4296-8bf3-cb4ab4c62d11"
msgid "\"The fog looks visible enough to me.\""
msgstr "\"안개가 끼어도 충분히 보인다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0009_Text
msgctxt "69421d75-fbc7-4d63-bd51-6e135b7a0b30"
msgid "\"I should probably go.\""
msgstr "\"아마도 가야겠어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0015_Text
msgctxt "b0aa1b7f-2884-48f0-8767-8f7a3d6cfc73"
msgid "\"My 'rival'? Do you mean Tartuccio?\""
msgstr "\"내 '경쟁자'라니. '타투치오' 말하는 거야?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0016_Text
msgctxt "d1213bc5-b889-496e-9c25-7e156d9aebed"
msgid "\"What power is he searching for?\""
msgstr "\"그는 어떤 힘을 찾고 있지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0017_Text
msgctxt "54a83bfd-a9b6-4fd4-8500-36420706d5db"
msgid "\"How do you know we're rivals?\""
msgstr "\"우리가 라이벌인지 어떻게 알았지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0019_Text_String
msgctxt "295d0862-bee7-4631-a5ea-f0f72ae4c3d6"
msgid "\"All the more reason not to linger. Farewell.\""
msgstr "\"더 말해봐야 소용이 없겠군. 그럼 이만.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0023_Text
msgctxt "294097f5-84de-498a-98ef-94e878971790"
msgid "\"Invisible fog? Does that mean you can find your way through it?\""
msgstr "\"보이지 않는 안개? 당신은 안개 속에서도 길을 찾을 수 있다는 말인가?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0026_Text
msgctxt "2b8a91d6-94c7-49a9-b3b6-e3c32ff58938"
msgid "\"Can you tell me where he is now?\""
msgstr "\"그가 지금 어디 있는지 말해줄 수 있어?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0028_Text
msgctxt "aa9c9f28-57da-4c97-9714-e84b2509edda"
msgid "\"Thank you.\""
msgstr "\"고마워.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0029_Text
msgctxt "82cea897-37ec-40e0-a428-f76d82e69735"
msgid "\"You actually said something that made sense.\""
msgstr "\"네가 한 말 일리가 있어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0032_Text
msgctxt "b4ae3fb7-a670-40af-ad09-3c0e8a105085"
msgid "\"I see.\""
msgstr "\"알겠어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0033_Text
msgctxt "825743a6-7af6-4ab8-a98b-787bcbedd165"
msgid "\"And why is it you see that so clearly?\""
msgstr "\"왜 그렇게 명확하게 보는 거야?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0042_Text
msgctxt "4111e740-430f-48f9-b52e-5ba83fc84ed3"
msgid "\"I don't have time to listen to an old fools nonsense. Be gone!\""
msgstr "\"나는 바보 같은 멍청이들의 말을 들을 시간이 없다. 사라져라!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0044_Text
msgctxt "ac905514-e293-472d-80bf-9d11195fca82"
msgid "\"One more word — and I'll kill you\"."
msgstr "\"한 마디 더 하면. 너를 죽일 거야\"."

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0047_Text
msgctxt "91d54209-4eac-4347-9055-627214048ba1"
msgid "\"Get out of my sight!\""
msgstr "\"내 눈 앞에서 사라져!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0048_AlignmentShift.Description
msgctxt "2ac2364b-d002-4ffb-86e8-caf77e4d808a"
msgid "Attacked insane old man."
msgstr "미친 노인을 공격했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0048_Text
msgctxt "610ae3dd-f7d0-401b-95c9-f69ca4a95abc"
msgid "[Attack] \"I warned you.\""
msgstr "[공격] \"너에게 경고했다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0050_AlignmentShift.Description
msgctxt "8691f401-34b7-4728-87f6-64e72651dac7"
msgid "Told the old man that you don't care about your rival's actions."
msgstr "노인에게 당신이 라이벌의 행동이 신경 쓰이지 않는다고 말했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Answer_0050_Text
msgctxt "6f874a86-7d57-4df4-b297-124484f60fc3"
msgid "\"I just do what I have to. I don't care about rivals.\""
msgstr "\"나는 해야 할 일을 했어. 라이벌은 신경 쓰지 않는다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0003_Text
msgctxt "43d7ce32-a89f-4b4b-b521-2df64e3d4bef"
msgid ""
"{n}A jittery old man in squalid clothing shuffles up to you. His gray hair "
"is unkempt, and he continually clenches and unclenches his wrinkled, "
"freckled hands. When he stops and looks up at you, his eyes widen, and he "
"tugs at his beard.{/n}"
msgstr ""
"{n}괴상한 옷을 입은 지저분한 노인이 당신에게 다가옵니다. 그의 회색 머리카락은 깔끔하지 않으며 그는 계속 손을 쥐었다 폈다 하는데 "
"주름이 사라졌다가 나타나기를 반복합니다. 그가 멈추고 당신을 바라볼 때 그의 눈은 넓어지고 그는 그의 수염을 쓰다듬습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0004_Text
msgctxt "2b81a693-11ca-4f14-b4a6-c23b0a36d87a"
msgid ""
"\"Strange weather. Invisible fog, creeping out of the woods. Soars beyond "
"the sky, obscures the sun and moon... Strange.\" {n}The old man shakes his "
"head, his eyes shifting about seemingly at random.{/n}"
msgstr ""
"\"이상한 날씨네. 눈에 보이지 않는 안개가 숲에서 기어 나오고. 하늘 너머로 솟아올라 태양과 달을 가리는 게... 이상해.\" {n}"
"노인은 머리를 흔들고 시선은 일정하지가 않습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0010_Text
msgctxt "f3734282-88ae-4910-9738-156db4c455b8"
msgid ""
"{n}The old man stares at you intently.{/n} \"You hasten? You should. Your "
"rival wastes no time. He races, but in another direction. He searches for "
"power. He'll find it.\""
msgstr ""
"{n}노인이 당신을 주의 깊게 쳐다봅니다.{/n} \"바쁜가? 그러겠지. 네 경쟁자는 시간을 낭비하지 않으니까. 그는 다른 방향으로 가고 "
"있네. 힘을 찾고 있지. 그는 곧 찾을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0011_Text
msgctxt "7e76fcce-3f40-4a08-9ace-223c6eac122d"
msgid ""
"\"I see more than ever. I've never seen so much before...\" {n}The old man "
"wipes his hand across his face and sighs wearily.{/n} \"But someone must "
"look, and no one else can.\""
msgstr ""
"\"나는 그 어느 때보다 많은 걸 보고 있다네. 전에는 이렇게 많이 본 적이 없었어...\" {n}노인은 얼굴을 손으로 쓸고는 지친 "
"한숨을 쉽니다.{/n} \"누군가는 봐야 하겠지만 아무나 볼 수 없지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0012_Text
msgctxt "d9d8e131-8e9b-47bc-8847-45ccda5880a9"
msgid ""
"{n}The old man raises a thick eyebrow curiously.{/n} \"I do nothing. "
"Breathe? Walk? Observe?\""
msgstr "{n}노인은 두꺼운 눈썹을 들어올립니다.{/n} \"아무것도 하지 않네. 그저 숨쉬고 걷고 관찰할 뿐이지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0013_Text
msgctxt "d60ba64a-01e1-4432-a312-5ba5f6e3922d"
msgid ""
"{n}The old man freezes for a moment.{/n} \"Remus. But that won't help with "
"the fog.\""
msgstr "{n}노인은 잠시 멈칫합니다.{/n} \"레무스. 하지만 안개에는 별로 도움이 되지 않을 걸세.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0018_Text
msgctxt "c84aac2c-1ec1-4854-bb3e-34140aa9fd7f"
msgid ""
"{n}The old man tugs his beard again.{/n} \"He's not tall, but he wants to "
"climb high. Beside him are those who could stand against him... and might "
"yet still.\""
msgstr ""
"{n}그 노인은 그의 수염을 다시 쓰다듬습니다.{/n} \"그는 키가 크지 않지만 높은 곳을 올라가고 싶어하지. 그의 옆에는 그에게 "
"대항할만한 이들이 있지만... 아직은 아니야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0020_Text
msgctxt "3cdb664b-e0db-4b8d-b1d1-ebf294edd8e9"
msgid ""
"\"Turn your back to the {g|Oleg's Trading Post}trading post{/g} and look "
"south. There's an ancient tomb. Look for him there.\" {n}The old man turns "
"and walks away slowly, muttering softly.{/n} \"Once stolen, the land should "
"be reclaimed... Once reclaimed, bound with the claimer shall it be. Bound, "
"merged, joined by unbreakable ties. Claiming the land, claiming its pain, "
"claiming its death...\""
msgstr ""
"\"다시 {g|Oleg's Trading Post}교역소{/g}로 돌아가서 남쪽을 보게. 고대의 무덤이 있네. 거기서 그를 찾아.\" "
"{n}늙은이는 천천히 돌아서서 걸어갑니다.{/n} \"도둑맞은 이상, 그 땅은 수복되어야만 한다... 수복되면, 그것은 주인에게 귀속될 "
"것이다. 끊을 수 없는 유대에 의해 속박되고, 합병되고, 연결된다. 이 땅을 차지하면, 그 고통을 차지하고, 그 죽음을 차지하리라...\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0021_Text
msgctxt "d16630bb-0d32-43f7-a164-f4fa3627421b"
msgid ""
"\"I don't know — I see. You can choose where you set your eyes... usually. "
"But can you choose what they see?\""
msgstr "\"모르겠네. 자네는 자네가 원하는 곳을 마음대로 볼 수 있지만... 그들이 보고 싶은 곳까지 마음대로 할 수는 없잖은가?\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0022_Text
msgctxt "217030b9-96a7-4cef-af95-3adc525215ef"
msgid ""
"\"Someone else's. Old, but forever young. That which was taken from another. "
"That which gave joy... and now gives death.\""
msgstr ""
"\"남의 것이지. 나이가 많지만 영원히 젊어. 그것은 다른 사람에게서 가져온 것이야. 기쁨을 주었지만... 지금은 죽음을 주겠지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0024_Text
msgctxt "d34d97d9-31b2-4829-8896-9cee875c5bf1"
msgid ""
"\"The fog is... wrong. It hinders your legs, not your sight. I wish not to "
"try.\""
msgstr "\"안개가... 아니, 시야를 방해하는 것이 아니라 다리를 방해하지. 가지 않는 게 좋아.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0027_Text
msgctxt "5920fb8a-f08a-4a3e-9bb8-412b56eb6f8c"
msgid ""
"\"He's in an old tomb. South of the {g|Oleg's Trading Post}trading post{/g}."
"\""
msgstr "\"그는 {g|Oleg's Trading Post}교역소{/g} 남쪽에 있는 오래된 무덤에 있을걸세. \""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0030_Text
msgctxt "b44c20a3-bd91-4571-bf65-2e040ae638b2"
msgid "{n}The old man shrugs.{/n} \"When I see clearly, I speak clearly.\""
msgstr "{n}노인은 어깨를 으쓱합니다.{/n} \"나는 분명하게 보아야 또렷하게 대답하지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0031_Text
msgctxt "766c0567-d20d-4716-8758-efab7f35bbdb"
msgid "{n}The old man nods.{/n}"
msgstr "{n}노인은 고개를 끄덕입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0034_Text
msgctxt "b429feae-7a8f-4fe3-8633-382cbcc7223e"
msgid ""
"{n}The old man's face is blank.{/n} \"I slept there last night. I noticed "
"him as I left.\""
msgstr "{n}노인의 얼굴이 무표정합니다.{/n} \"어젯 밤 거기서 머물렀다네. 내가 떠날 때쯤 그가 보이더군.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0037_Text_3
msgctxt "edfa5556-5588-41c2-aec7-4b365c96bb69"
msgid ""
"{n}The old man turns and walks away slowly, muttering softly.{/n} \"Once "
"stolen, the land should be reclaimed... Once reclaimed, bound with the "
"claimer shall it be. Bound, merged, joined by unbreakable ties. Claiming the "
"land, claiming its pain, claiming its death...\""
msgstr ""
"{n}늙은이는 천천히 돌아서서 걸어갑니다.{/n} \"도둑맞은 이상, 그 땅은 수복되어야만 한다... 수복되면, 그것은 주인에게 귀속될 "
"것이다. 끊을 수 없는 유대에 의해 속박되고, 합병되고, 연결된다. 이 땅을 차지하면, 그 고통을 차지하고, 그 죽음을 차지하리라...\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0039_Text
#. Speaker : Amiri_Companion
msgctxt "641c04a3-7052-4de0-9305-8b049ebf04de"
msgid ""
"\"I don't like this old man. Looks like the kind who can cast the evil eye!\""
msgstr "\"나는 이 늙은이가 싫어. 악마같은 눈으로 쳐다보고 있잖아!\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0041_Text
#. Speaker : Jaethal_Companion
msgctxt "8661afa4-cb22-4286-b487-411cc51e5980"
msgid "\"Move along, old man. We give no alms.\""
msgstr "\"가시오. 노인. 우리는 아무런 도움도 필요 없어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/Disguised_LK_Doomsayer/Dialogue/Cue_0043_RevealTomb_Text_String
msgctxt "3d597cbd-11f2-4c83-8899-c48dd519031f"
msgid ""
"\"Bold dog barks loud... while cunning one readies to bite. Cunning, short, "
"but stubborn. He is now in an ancient tomb that lies south of the {g|Oleg's "
"Trading Post}trading post{/g}. Searching for the great power that once gave "
"joy, and now brings only death. You don't want my nonsense? Then you'll hear "
"sobs and screams.\n"
"Once stolen, the land should be reclaimed... Once reclaimed, bound with the "
"claimer shall it be. Bound, merged, joined by unbreakable ties. Claiming the "
"land, claiming its pain, claiming its death...\""
msgstr ""
"\"용감한 개는 큰 소리로 짖지... 교활한 개는 물기를 기다리고. 교활하고 작지만 완고해. 그는 {g|Oleg's Trading "
"Post}교역소{/g} 남쪽에 있는 고대 무덤에 있네. 한 때 기쁨을 준 위대한 힘을 찾는건 이제 죽음만 가져오지. 내 말을 듣기 "
"싫은가? 그러면 흐느낌과 비명 소리를 들을 걸세.\n"
"도둑맞은 이상, 그 땅은 수복되어야만 한다... 수복되면, 그것은 주인에게 귀속될 것이다. 끊을 수 없는 유대에 의해 속박되고, "
"합병되고, 연결된다. 이 땅을 차지하면, 그 고통을 차지하고, 그 죽음을 차지하리라...\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/Barks/CrossingSign_String
msgctxt "799110ba-dea5-4044-8e39-c404f1b22015"
msgid "\"Five coins to cross the river.\""
msgstr "\"강을 건너려면 다섯닢을 내라.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/Barks/Crossing_HouseRuins_String
msgctxt "6c6a5091-61b5-4e18-8be4-a9e23c4ee9b9"
msgid "This small house burnt down a dozen years ago."
msgstr "이 작은 집은 12년 전에 소실되었습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/Barks/Crossing_RopeBridgeStandpost_String
msgctxt "a9ad9585-461d-4f35-86c3-bd844ec7eadd"
msgid "It appears these posts once held a rope bridge."
msgstr "이 기둥은 한 때 다리를 잇는 역할을 했던 것 같습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0002_Text
msgctxt "3b778a7f-60c1-4088-929b-cfc7c9b38088"
msgid "\"Who are you?\""
msgstr "\"넌 누구지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0005_Text
msgctxt "3b294615-f782-4ce0-89b8-2cdfc362c429"
msgid "\"What do you want from me?\""
msgstr "\"나한테 원하는 게 뭐야?\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0006_Text
msgctxt "2a22e72c-1a23-484b-868f-8090b74e70bd"
msgid "\"How did you die?\""
msgstr "\"너는 어떻게 죽은 거지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0007_Text
msgctxt "8579fd02-344a-48dd-8c27-f74d3784e7b1"
msgid "[Attack] \"No one dares to trespass inside my head. Die, monster!\""
msgstr "[공격] \"아무도 감히 내 머리 속에 침입할 수 없다. 죽어라. 괴물!\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0008_Text
msgctxt "c5a7bd67-426a-4718-92aa-e682b9d6c9b0"
msgid "\"I'd better go.\""
msgstr "\"나는 가야겠어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0019_Text
msgctxt "a196696e-13cb-43f5-9bd3-aab8980a5892"
msgid "\"Why must I be the one who does it?\""
msgstr "\"내가 왜 그 일을 해야 하지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0020_Text
msgctxt "aa8f5a7b-772d-41c3-8cac-1f5344b92ff7"
msgid "\"I don't have time for this.\""
msgstr "\"나는 이럴 시간이 없어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0021_Text
msgctxt "f35ce2fa-4651-46e4-808b-61f560b02f6b"
msgid "\"Very well. I shall mete your vengeance upon the Stag Lord.\""
msgstr "\"좋아. 나는 수사슴 군주에게 네 복수를 대신 갚아줄 거야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0025_Text
msgctxt "3a96e1cb-0323-46f3-8664-f5a5e8d7d819"
msgid "\"Can't you kill the Stag Lord yourself?\""
msgstr "\"스스로 수사슴 군주를 죽일 수는 없어?\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0028_Text
msgctxt "5df76bb9-621c-45a8-bf9e-259e7b38c777"
msgid "\"My answer is the same.\""
msgstr "\"내 대답은 똑같아.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0031_Text
msgctxt "576f0943-1999-41fa-a1a1-6eefd991136e"
msgid "\"So it was you who sent me those nightmares?\""
msgstr "\"그래서 나에게 그 악몽을 보냈던 것은 너였어?\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0046_Text
msgctxt "44436ea8-97a5-4c16-87ee-6d3a03d5f3b9"
msgid "\"I've killed you already. How did you survive?\""
msgstr "\"나는 너를 이미 죽였어. 어떻게 살아남은 거야?\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0058_AlignmentShift.Description
msgctxt "2b943ca0-b9fe-456d-8d71-ecc3b1ba61b4"
msgid "Refused to help Davik Nettle because he annoyed you."
msgstr "그가 당신을 짜증나게했기 때문에 Davik Nettle을 돕기를 거부했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0058_Text
msgctxt "34c3a0a9-8a9b-481d-a37e-62bb8f7cd4d3"
msgid ""
"\"I refuse to help you on principle. You shouldn't have messed with my head!"
"\""
msgstr "\"나는 너를 돕지 않겠어. 내 머리를 아프게 하지 마!\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0059_AlignmentShift.Description
msgctxt "83e2dc87-3e43-484d-8719-44410d8cdcc8"
msgid "Attacked Davik Nettle because he dared to threaten you."
msgstr "당신을 위협한 다빅 네틀을 공격합니다."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0059_Text
msgctxt "739cad07-c2d8-4229-b593-a86252434534"
msgid ""
"[Attack] \"You dare to threaten me? You're no better than the Stag Lord and "
"his bandits. I'll teach you a lesson!\""
msgstr "[공격] \"나를 감히 위협해? 너는 수사슴 군주와 다를 것 없어. 너에게 교훈을 가르쳐주지!\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0060_AlignmentShift.Description
msgctxt "284edcf8-b353-4e1c-a6d4-4bb924cb3115"
msgid "Attacked Davik Nettle for fun."
msgstr "재미로 다빅 네틀을 공격했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0060_Text
msgctxt "5f6dad8a-73d9-418b-ac78-2fe4c89cd833"
msgid ""
"[Attack] \"Killing you may be pointless, but I'll do it again anyway just "
"for fun!\""
msgstr "[공격] \"너를 죽이는 것은 무의미할 수도 있지만 어쨌든 죽여 볼 거야!\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0061_Text
msgctxt "c783d662-4bbb-440f-818a-b239642429c2"
msgid ""
"\"Isn't it beautiful that Urgathoa gifted you with undeath so you could see "
"your death avenged?\""
msgstr "\"우르가쏘아가 너를 언데드로 만들어서 죽음으로 벗어난 것이 아름답지 않아?\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0062_Text
msgctxt "29e7c74b-94b1-47c3-8327-b17c0c358179"
msgid ""
"\"Revenge is a holy pursuit. Calistria would be pleased if I avenged you.\""
msgstr "\"복수는 거룩한 추구다. 내가 너에게 복수한다면 칼리스트리아께서는 기뻐하실 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0063_Text
msgctxt "969b8769-c771-47d7-ac89-f070f32195d9"
msgid ""
"\"Becoming undead — such a horrible fate! Pharasma would want me to help you "
"find peace.\""
msgstr "\"언데드가 되어버리다니 끔찍한 운명이다! 파라즈마께서는 네가 안식을 찾도록 내가 도와주길 원해.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Answer_0076_Text
msgctxt "d26f6e86-0048-4f97-b724-138ad9f9d516"
msgid ""
"\"Becoming undead — such a horrible fate! Sarenrae would want me to help you "
"find peace.\""
msgstr "\"언데드가 되어버리다니 끔찍한 운명이다! 파라즈마께서는 네가 안식을 찾도록 내가 도와주길 원해.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0001_Text
msgctxt "2adb6b4f-77ce-4309-a3b7-cf75c1bc3e7a"
msgid ""
"{n}The corpse's face is bloated from being so long in the water. The stench "
"from its toothless mouth is so foul that your eyes begin to water. The hand, "
"clenching a sinister-looking spear, is covered with scabs.{/n}"
msgstr ""
"{n}시체의 얼굴은 물속에서 너무 오랫동안 있어 부풀어 올랐습니다. 이가 없는 입에서 나온 악취는 너무 지독해서 눈물이 날 지경입니다. "
"불길해보이는 창을 쥔 손은 딱지로 덮여있습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0003_Text
msgctxt "8efb770a-a637-4a7f-991e-1c8073057529"
msgid ""
"{n}Suddenly you feel faint — as if a cold, wet hand is placed heavy on top "
"of your head. Wet hair sticks to skin, and trickles of icy-cold water run "
"down your face and shirt. A hoarse whisper rises inside your head:{/n} "
"\"There you are...\""
msgstr ""
"{n}갑작스럽게 기운이 약해졌습니다. 마치 춥고 젖은 손이 당신의 머리 위에 무겁게 올려진 것처럼 말입니다. 젖은 머리카락이 피부에 달라 "
"붙으며 얼음장처럼 차가운 물방울이 얼굴과 셔츠에서 흘러내립니다. 쉰 속삭임이 당신의 머리에서 들립니다.{/n} \"거기 있었구나...\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0009_Text
msgctxt "ffc1f08b-e9ba-458e-a587-667caa59f1f1"
msgid ""
"{n}The bloated face of the drowned man yawns open at you. You feel once more "
"faint, and the invisible wet hand falls upon your brow again.{/n} \"Greetings"
", {name}...\""
msgstr ""
"{n}익사한 남자의 부풀어오른 얼굴이 당신을 보고 입을 엽니다. 당신은 다시 한번 기절할 것 같았고 보이지 않는 젖은 손이 당신의 머리를 "
"다시 쓰다듬는 기분이 듭니다.{/n} \"안녕. {name}...\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0010_Text
msgctxt "921e7be4-1f84-4a05-9704-4f0d23b28739"
msgid ""
"\"Davik Nettle...\" {n}A storm of bright images flashes before your eyes. A "
"long time ago, this person, then a living man, came here from Brevoy, "
"constructed a rope bridge, built a house, and lived in it, collecting "
"payment from those who crossed the river.{/n}"
msgstr ""
"\"다빅 네틀...\" {n}밝은 폭풍우의 이미지가 눈앞에 번쩍입니다. 오래 전 브레보이에서 이 사람이 산 채로 와서 밧줄 다리를 "
"만들고, 집을 짓고, 살면서 강을 건넌 사람들에게서 이용료를 받습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0011_Text
msgctxt "4c70c1c8-330d-4da8-8bd4-d1f1ce5279b5"
msgid ""
"{n}You see a vision of a man wearing an antlered helm. You hear a muffled "
"groan, and the helm drops to the ground with a loud thud. Your hands are "
"covered with hot blood... too much blood.{/n} \"Death... to the Stag Lord.\""
msgstr ""
"{n}당신은 사슴뿔 투구를 착용한 남자의 환상을 봅니다. 당신은 숨막히는 신음 소리를 듣고 투구가 큰 소리를 내며 땅에 떨어집니다. "
"당신의 손이 뜨거운 피로 덮여있습니다... 피가 너무 많습니다.{/n} \"수사슴 군주에게... 죽음을.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0012_Text
msgctxt "079347ed-07db-47b9-b84b-c7cee079cc01"
msgid ""
"{n}You see a vision of a lovely spring day. Sunbeams shine warm against your "
"cheeks. Three men approach the house by the bridge, one of them wearing an "
"antlered helm.{n}\"The Stag Lord\"...{/n} Angry faces, a quarrel, the glint "
"of an unsheathed sword... Suddenly the Stag Lord's greedy eyes are twisted "
"by surprise. The master of the house has unleashed his hounds!{/n}"
msgstr ""
"{n}당신은 아름다운 봄날의 환상을 보았습니다. 햇빛은 당신의 뺨에 따뜻한 빛을 쬡니다. 3명의 남자는 다리 옆 집에 접근하는데 그들 중 "
"하나는 사슴뿔 투구를 착용했습니다. {n}\"수사슴 군주...\"{/n} 성난 얼굴, 말다툼, 무자비한 칼의 반짝임... 갑자기 수사슴 "
"군주의 탐욕스러운 눈은 놀라움으로 번쩍입니다. 집안의 주인은 사냥개를 풀었습니다!{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0014_Text
msgctxt "97a4592e-2b85-4601-a086-08cfea27dd08"
msgid ""
"{n}A burning smell stirs you awake to the sound of loud barking. Flames are "
"crawling up the walls. The sound of breaking glass, the bitter cold night "
"air... you are outside... Outside the house, and something is wrong. An "
"arrow strikes deep in your shoulder. You hear the guffaw of ten throats. You "
"run, already in the middle of the bridge. The man in the antlered helm cuts "
"one of the ropes. An ear-splitting scream fills the air.{/n}"
msgstr ""
"{n}타는듯한 냄새가 나 당신은 깨어났고 이내 큰 소리로 짖는 소리가 들립니다. 불길이 벽을 타고 올라갑니다. 유리 깨지는 소리, 추운 "
"밤 공기... 당신은 밖에 있습니다... 집 밖에서 뭔가 잘못되었습니다. 어깨에 화살이 깊이 박힙니다. 당신은 피를 토합니다. 당신은 "
"달리는데 이미 다리 한복판 위에 있습니다. 사슴뿔 투구의 남자가 로프 중 하나를 자릅니다. 귀가 찢어지는 비명 소리가 허공을 "
"메웁니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0022_Text
msgctxt "d763a3c9-a45c-4e35-99d6-b435c70b5283"
msgid ""
"{n}You feel invisible fingers, cold as stone, draw aside a wet strand of "
"hair from your forehead.{/n}"
msgstr "{n}당신은 돌처럼 차갑고 보이지 않는 손이 당신의 젖은 머리를 쓰다듬는 느낌이 옵니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0023_Text
msgctxt "e813316b-13ea-4437-af7a-d688a0110d66"
msgid ""
"{n}You are taken in a whirlwind of visions and images, and you see... "
"yourself! You lie with your eyes closed, thrashing in your sleep... finally "
"you scream and wake, drenched in cold sweat.{/n}"
msgstr ""
"{n}당신은 환상과 이미지의 회오리 바람에 휩쓸렸고 당신 자신을 봅니다! 당신은 눈을 감고 누워 잠을 자고 있습니다... 마침내 땀을 "
"흘리며 추위에 떨던 당신은 비명을 지르고 깨어납니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0024_Text
msgctxt "42a167ea-ca5b-47b3-9f0c-4b2e75e39560"
msgid ""
"{n}The drowned man, who'd been sitting motionless, nods his head.{/n} \"Come "
"later... take the spear...\""
msgstr "{n}무표정하게 앉아있던 익사한 남자가 고개를 끄덕입니다.{/n} \"나중에 와서... 창을 가져가라...\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0026_Text
msgctxt "dc66bdcd-6f94-4345-bb0f-4ccbc32d85d5"
msgid ""
"{n}You see the Stag Lord and his cutthroats trying to build a new bridge "
"here... Then running madly away from the rotting monster. The Stag Lord has "
"avoided this place ever since.{/n}"
msgstr ""
"{n}당신은 수사슴 군주와 그의 부하들이 새로운 다리를 짓는 모습을 봅니다... 그리고는 부패한 괴물들이 미친듯이 달려옵니다. 수사슴 "
"군주는 그 후로 이 장소를 피해왔습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0029_Text
msgctxt "7534fd8c-501c-4253-900e-76e3f4465a62"
msgid "{n}The drowned man grins at you with blue lips.{/n}"
msgstr "{n}익사한 남자가 파란 입술로 웃습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0030_Text
msgctxt "73ba586c-4876-43d4-a863-677951eb7d18"
msgid ""
"\"Stag Lord... is dead... {g|Pharasma}Pharasma{/g} awaits... Farewell, "
"{name}...\""
msgstr "\"수사슴 군주가... 죽었다... {g|Pharasma}파라즈마{/g}가 기다리고 있다... 잘가라... {name}...\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0032_Text_2
msgctxt "496580f3-fc70-4743-b21c-d83d9dd92065"
msgid ""
"{n}Gurgling, deep-chested laughter pierces your skull, clouding your vision "
"and flooding your ears. All else becomes muffled, as if you are trapped "
"underwater. You shake your head to cast off the apparition.{/n}"
msgstr ""
"{n}머릿 속에 메아리처럼 울리는 웃음소리가 들리고 눈 앞이 아득해지고 귓속이 어지럽습니다. 순간 물 속에 있는 것처럼 아무것도 들리지 "
"않습니다. 당신은 환상을 떨치기 위해 머리를 흔듭니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0034_Text
#. Speaker : Tristian_Companion
msgctxt "3530a638-3234-4b08-8a6d-e86a41e4ec61"
msgid ""
"\"I sense evil... But not evil committed by this poor soul, no. He arose on "
"account of some evil done to him.\""
msgstr "\"악이 느껴지는군... 이 자가 행한 악은 아닌 것 같군... 이 자가 당한 악인거 같아.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0036_Text
#. Speaker : Jaethal_Companion
msgctxt "e091b6ec-eb05-4966-821d-fd768d3547f3"
msgid "{n}Jaethal winces in disgust.{/n}"
msgstr "{n}제이탈은 혐오로 찡그립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0038_Text
#. Speaker : Valerie_Companion
msgctxt "fc01cdf2-0a09-4d8a-ae8e-1f48b7468c76"
msgid ""
"\"Why not? Isn't this the very mission that brought us here in the first "
"place?\""
msgstr "\"안될 거 있나요? 애초에 이곳에서의 우리의 사명이 그것이잖습니까?\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0040_Text
#. Speaker : Linzi_Companion
msgctxt "85bfbf2a-6f97-45d1-a40c-5ebc7769338c"
msgid ""
"\"Don't you hate it when someone asks you to do something you were going to "
"do anyway? It makes me want to do nothing, just to spite them!\""
msgstr "\"어차피 해야 할 일을 누가 시키면 좀 싫지 않아요? 전 오히려 반대로 안해주고 싶더라구요!\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0042_Text
#. Speaker : Regongar_Companion
msgctxt "b01e6db2-be8d-443e-bf20-b0e430e6520c"
msgid "\"Well, at least we won't be doing it for free.\""
msgstr "\"글쎄... 적어도 공짜는 아니야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0043_Text
#. Speaker : Octavia_Companion
msgctxt "d8eaa400-2ce9-4849-96aa-52e7074133c8"
msgid ""
"\"I would help him even if he wasn't going to pay. He has such a hard "
"life... Well, a hard undeath. That must be even harder!\""
msgstr ""
"\"저라면 보상이 없어도 도울 것 같아요. 굉장히 어려운 삶을 살아온 사람... 아니, 언데드잖아요. 분명 산 사람보다 더 힘들었겠죠!\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0045_Text
#. Speaker : Regongar_Companion
msgctxt "7617c7f7-b0f7-4cc9-9330-85f0a0ed4d07"
msgid ""
"\"You're always helping scum like this for free. As if our own lives are "
"easy!\""
msgstr "\"항상 이런 쓰레기를 보상 없이 도와주는 거야? 우리도 살기 힘들다고!\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0048_Text
#. Speaker : Regongar_Companion
msgctxt "3c56863d-024f-4921-a932-13e78364577a"
msgid ""
"\"Right, no more chatting with corpses! Let's hang him out to dry so he'll "
"stay out of your head!\""
msgstr "\"좋아. 이제 시체와 이야기 하지 말자! 그를 끄집어내서 말리면 네 머릿속에서도 나갈 거야!\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0050_Text
msgctxt "44e150ea-cadd-4cd1-ac77-6467d6cfda94"
msgid "{n}Without a sound, the dead man rushes to attack you.{/n}"
msgstr "{n}아무말 없이 죽은 남자가 당신에게 달려들어 공격합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0053_Text
#. Speaker : Tristian_Companion
msgctxt "114524ba-be34-4bf4-8daf-cc7f81616d3d"
msgid ""
"\"You freed an innocent soul from eternal torment, {name}. Yours is truly a "
"noble soul.\" {n}Tristian lowers his head and begins whispering a prayer.{/n}"
msgstr ""
"\"당신은 영원한 고통으로부터 무고한 영혼을 해방시켰습니다. {name}. 당신은 진정으로 고귀한 영혼입니다.\" {n}트리스티안은 "
"머리를 숙이고 속삭이듯 기도를 올립니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0054_Text
msgctxt "03cf6d66-1eda-4359-bd8e-fcbbe31ee1aa"
msgid "{n}The corpse crumples to the ground.{/n}"
msgstr "{n}시체가 땅에 쓰러집니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0055_Text
#. Speaker : Tristian_Companion
msgctxt "fe816ea6-9323-42ff-bc91-2cb58a8cbf9e"
msgid "\"But why? We may have the power to help him!\""
msgstr "\"하지만 왜? 우리가 그를 도와줄 수 있을지 몰라!\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0064_Text
msgctxt "b03c090a-3ca1-4e0e-bfd5-f43e0a98a3ca"
msgid ""
"{n}A series of visions flash before your eyes — you see the Stag Lord dying "
"in a variety of horrible ways: impaled, beheaded, drowned, immolated... The "
"dead man lets out a moan full of rage and anguish.{/n}"
msgstr ""
"{n}당신의 눈 앞에서 일련의 환상이 번쩍거립니다. 당신은 수사슴 군주가 여러 가지 끔찍한 방법으로 죽어가는 것을 봅니다: 찔림, 참수, "
"익사, 화형... 죽은 남자는 분노와 괴로움으로 가득 찬 신음 소리를 냅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0065_Text
msgctxt "c53b1b6c-890e-404a-8989-543acbb777c2"
msgid ""
"{n}The dead man bows his head. For a moment, a vision of a peaceful rural "
"cemetery appears before your eyes.{/n}"
msgstr "{n}죽은 사람이 머리 숙여 절합니다. 잠시 동안 평화로운 시골 공동 묘지의 환상이 눈앞에 나타납니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0067_Text
#. Speaker : Octavia_Companion
msgctxt "0745c800-0386-43ee-b1cd-e13a2333d4bb"
msgid "{n}Octavia nods without saying a word.{/n}"
msgstr "{n}옥타비아는 한 마디도 없이 끄덕입니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0068_Text
#. Speaker : Regongar_Companion
msgctxt "d11bd660-f7ea-4f6e-a274-fb9d2d73e44d"
msgid "\"Right! Let's go make the goddess proud!\""
msgstr "\"좋아! 여신님을 기쁘게 해드리자!\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0071_Text
#. Speaker : Jaethal_Companion
msgctxt "e6fcada9-cc47-4e98-92ef-4ff09cb44451"
msgid ""
"\"I certainly wouldn't call him beautiful, but you're right — there's a "
"reason the goddess bestows her gifts, even on lowly peasants like him.\""
msgstr ""
"\"확실히 그를 아름답다고 부를 수는 않겠지만, 그래, 네가 맞아. 여신께서 그런 놈 같은 허접한 농부들에조차 재능을 선물하는데는 이유가 "
"있을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/DavikNettleDialog/Cue_0074_Text
#. Speaker : Jaethal_Companion
msgctxt "1c153e65-689a-41e3-a719-d6b2c917bbe9"
msgid "{n}Jaethal turns away, scowling.{/n}"
msgstr "{n}제이탈은 등을 돌려 걸어갑니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/Items/NettlesSpear_String
msgctxt "c1ec1990-d5f2-460e-96e4-b380f485a035"
msgid "The spear's shaft always feels cold and wet to the touch."
msgstr "창의 손잡이는 만지면 항상 차갑고 젖어 있습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/Items/NettlesSpear_name_String
msgctxt "b0521a1b-8fa1-45f2-a61e-678c9f79826c"
msgid "Drowned engineer's spear"
msgstr "익사한 기술자의 창"

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/NightmareBookEvent/Answer_0005_Text
msgctxt "01423b3f-d24c-4445-9c4a-1af2f32a7ee0"
msgid "{mf|He|She} looked out of the window."
msgstr "{mf|그|그녀}는 창 밖을 보았습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/NightmareBookEvent/Answer_0007_Text
msgctxt "a9ea0465-db91-42f2-8bc0-8cf9ac0ceeda"
msgid "{mf|He|She} tried to open the door."
msgstr "당신은 문을 열려고 했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/NightmareBookEvent/Answer_0008_Text
msgctxt "79bbc744-5991-4dba-bc61-c6bd1e16c873"
msgid "{mf|He|She} jumped out of the window."
msgstr "당신은 창 밖으로 뛰어 나갑니다."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/NightmareBookEvent/Answer_0019_Text
msgctxt "2ecec978-49c9-4c7b-96f2-98736234da36"
msgid "Close."
msgstr "닫기."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/NightmareBookEvent/Answer_0028_Text
msgctxt "5ab9a015-f22c-455c-9a68-0701af0f7e68"
msgid "{mf|He|She} yelled: \"I killed the Stag Lord! Get out of my dreams!\""
msgstr "당신은 소리칩니다: \"내가 수사슴 군주를 죽였어. 내 꿈에서 꺼져!\""

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/NightmareBookEvent/Answer_0031_Text
msgctxt "bb87f1eb-c789-462d-b26a-d0f02d7f390e"
msgid "Close."
msgstr "닫기."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/NightmareBookEvent/Cue_0003_Text_String
msgctxt "7b86c4d9-d996-4f24-a301-4e19dab83d90"
msgid ""
"The drowned man's mouth opened slowly, and a hoarse whisper said:\n"
"\"{g|Shrike River}Shrike River{/g}, {name}...\"\n"
"At this moment {name} finally awoke. Drenched in sweat, {mf|he|she} told us "
"what {mf|he|she}'d seen in the dream."
msgstr ""
"익사한 남자의 입이 천천히 열리고 그는 쉰 목소리로 속삭입니다. \n"
"\"{g|Shrike River}슈라이크 강{/g}. {name}...\" \n"
"그 순간 당신은 마침내 깨어났습니다. 땀에 흠뻑 젖은 당신은 꿈에서 무엇을 보았는지 우리에게 알려주었습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/NightmareBookEvent/Cue_0011_Text_String
msgctxt "a7ac3513-3756-446d-a0c3-fcbed9014003"
msgid ""
"...{name}'s skin felt cold. {mf|He|She} heard the murmur of the water and "
"the soft lapping of waves. After opening {mf|his|her} eyes, {mf|he|she} saw "
"a rocky river bottom and a bloated body, tangled in green water-weeds. The "
"drowned man's empty gaze was fixed upon {name}."
msgstr ""
"... {name}은 오한을 느꼈습니다. 잔잔한 물결 소리와 부드럽게 밀려드는 파도 소리를 들려옵니다. 눈을 뜨자 당신은 바위투성이의 "
"강바닥과 녹색 수초에 묶인 채 부풀어 오른 시체를 보았습니다. 익사한 남자의 공허한 눈빛은 {name}에게 고정되어 있습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/NightmareBookEvent/Cue_0024_Text
msgctxt "9746786d-6296-4015-906c-6f0e418179ca"
msgid ""
"The instant {mf|he|she} approached the window, the glass broke and an arrow "
"hit {mf|him|her} in the chest. Falling, {mf|he|she} glimpsed a dozen dark "
"figures standing outside. {mf|His|Her} eyes dimmed..."
msgstr ""
"당신이 창문으로 다가간 순간 유리가 깨지며 화살이 당신의 가슴에 맞았습니다. 넘어지면서 당신은 창 밖에 서 있는 십여 명의 어두운 형체를 "
"보았습니다. 당신의 눈이 희미해집니다..."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/NightmareBookEvent/Cue_0025_Text
msgctxt "a661f2a1-dd20-4975-8214-29d3802cab7b"
msgid ""
"{name} suddenly awoke inside the house. Dogs were howling fiercely, not far "
"away. It smelled like burning, the wooden walls were steaming hot, and smoke "
"was wreathing beneath the low ceiling."
msgstr ""
"{name}은(는) 갑자기 집 안에서 깨어났습니다. 근처에서 개들이 맹렬히 짖는 소리가 들렸습니다. 불타는 듯한 냄새가 나고, 나무 "
"벽에선 뜨거운 열기가 나오며 낮은 천장 아래는 연기가 자욱했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/NightmareBookEvent/Cue_0026_Text
msgctxt "8913c70c-3853-4431-9af8-06f9f2f53f39"
msgid ""
"{name} pushed the door with {mf|his|her} shoulder, but it wouldn't budge. "
"The flames were starting to crawl up the walls. {name} grew short of breath, "
"and {mf|he|she} sat down heavily on the floor..."
msgstr ""
"{name}은(는) 어깨로 문을 밀쳐봤지만, 문은 꼼짝도 하지 않았습니다. 불길이 벽을 타고 기어오르기 시작했습니다. 점점 {name}의 "
"숨은 차올랐고, 이내 바닥에 무겁게 주저앉았습니다..."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/NightmareBookEvent/Cue_0027_Text
msgctxt "4e3eddc9-4a19-4862-823f-e4bcf40fc18b"
msgid ""
"Kicking out the window, {name} jumped out into the darkness. An arrow hit "
"{mf|his|her} shoulder, and {mf|he|she} heard laughter and shouts of triumph. "
"{mf|He|She} surged forward, to the rope bridge. Reaching the middle of the "
"river, {name} cast a glance back and noticed that a young man wearing an "
"antlered helm cut one of the ropes with an axe. The bridge began to collapse "
"as its ropes twisted and snapped..."
msgstr ""
"창을 걷어차고, {name}은(는) 어둠 속으로 뛰쳐나갔습니다. 화살이 어깨에 박혔고, {mf|그|그녀}는 웃음 소리와 승리의 환호성을 "
"듣습니다. {mf|그|그녀}는 앞으로 로프 다리로 달려갔습니다. 강의 한가운데에 닿아서, {name}은(는) 뒤를 흘끗 보았고 사슴뿔 "
"투구를 쓴 젊은 남자가 도끼로 로프를 끊는 모습을 봅니다. 로프가 뒤틀리며 끊어지자 다리가 무너지기 시작합니다..."

#. Mechanics/Blueprints/World/Dialogs/c11/NettlesCrossing/NightmareBookEvent/Cue_0030_Text
msgctxt "a72360ae-59d0-454f-9e25-36a8f0d8d56c"
msgid ""
"Suddenly the dream began to lose its power. \"Farewell,\" whispered someone "
"in {name}'s ear, and {mf|he|she} awakened."
msgstr ""
"갑자기 그 꿈은 힘을 잃기 시작했습니다. \"안녕히.\" 누군가 {name}의 귀에 속삭였습니다. 그리고 {mf|그|그녀}는 깨어났습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/NyrissaRevealingStagFortSE/Answer_0003_Text
msgctxt "5c0c1024-7434-4765-af6f-3b6dcbe1f551"
msgid "\"I'll set off to the Stag Lord's fortress as soon as I'm ready.\""
msgstr "\"나는 준비가 되는 대로 수사슴 군주의 요새로 출발할거야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NyrissaRevealingStagFortSE/Answer_0005_Text
msgctxt "82b27ab0-8f4f-4876-b1a6-686e3c1e2e0d"
msgid "\"Will you help me in the battle?\""
msgstr "\"전투에서 나를 도울 수 있겠어?\""

#. Mechanics/Blueprints/World/Dialogs/c11/NyrissaRevealingStagFortSE/Answer_0006_Text
msgctxt "c6e5ac4d-04b4-4311-9ed7-595f7c878747"
msgid ""
"\"You're still following me? I don't trust you — I won't do as you say.\""
msgstr "\"여전히 나를 따라오고 있어? 나는 너를 믿지 않아. 네가 말한대로 하지 않을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NyrissaRevealingStagFortSE/Answer_0011_Text
msgctxt "b6de3c12-3e1c-4a11-9f55-e7c9d2b926e3"
msgid ""
"\"You can count on me. I'll deal with the Stag Lord and his minions. No one "
"will ever harm you anymore.\""
msgstr "\"날 믿어도 좋아. 내가 수사슴 군주와 그의 부하들을 상대하겠어. 이제 아무도 너를 해칠 수 없을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NyrissaRevealingStagFortSE/Answer_0012_Text
msgctxt "133b044c-7740-453c-bace-7edf71b136f0"
msgid ""
"\"What happens after I defeat the Stag Lord? Will I ever see you again?\""
msgstr "\"내가 수사슴 군주를 물리친다면 어떻게 될까? 너를 다시 만날 수 있을까?\""

#. Mechanics/Blueprints/World/Dialogs/c11/NyrissaRevealingStagFortSE/Cue_0001_Text
msgctxt "85481121-547b-4631-849f-16c64f9c5fe3"
msgid ""
"\"Greetings.\" {n}The nymph's tender voice comes to you softly. The scent of "
"flowers and evening dew is dizzying.{/n} \"In this dark hour, I had not even "
"dreamed of encountering someone in these lands who could stand against the "
"one who blights me. But you appeared, and you brought hope along with you. "
"With the strength of the fog fading, I am able to show you the way to the "
"Stag Lord's fortress. Please, go there — slay our enemy before he can strike "
"another blow.\""
msgstr ""
"\"안녕.\" {n}님프의 부드러운 목소리가 들립니다. 꽃의 향기가 진동하고 저녁 이슬이 떨어지기 시작합니다.{/n} \"이 어둠의 "
"시대에 나를 파멸시키려는 적과 맞서 싸울 누군가를 만나리라고는 생각지도 못했어. 하지만 네가 희망을 가지고 왔지. 안개가 사라졌으니 "
"수사슴 군주의 요새로 가는 길을 보여줄 수 있어. 제발 우리의 적이 또다른 공격을 하기 전에 그를 물리쳐줘.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NyrissaRevealingStagFortSE/Cue_0007_Text
msgctxt "29bba7bf-2b4a-4de2-b749-b69aa223aa7b"
msgid ""
"{n}The nymph leans forward and places something in your hand.{/n} \"Should "
"you lose, my heart will stop with yours. But should you win, the sun shall "
"rise once more over these lands. In its rays, in the ring dance of blooming "
"life, we shall meet again. I leave you a small gift, a token of hope and the "
"reward that awaits you after all these hardships. Farewell... No. Take care!"
"\""
msgstr ""
"{n}님프는 앞으로 몸을 굽히고 당신의 손에 무언가를 놓습니다.{/n} \"네가 지면 내 심장은 너와 함께 멈출거야. 하지만 네가 "
"이긴다면 태양이 다시 한 번 이 땅 위로 솟아 오를 거야. 햇빛 속에서 꽃피는 생명들 사이에서 우리는 다시 만나겠지. 너에게 작은 선물을 "
"남겨둘게. 희망의 징표이자 고난이 지난 후에 너에게 주어질 보상이야. 잘가... 아니. 조심해!\""

#. Mechanics/Blueprints/World/Dialogs/c11/NyrissaRevealingStagFortSE/Cue_0009_Text
msgctxt "60e9d282-cf0b-4079-9f46-f9b10bb7c3de"
msgid ""
"\"I cannot.\" {n}The nymph lowers her head.{/n} \"My power is barely enough "
"to make a slight tear through the veil of fog. Keeping the way open to you "
"is all I can do to help.\""
msgstr ""
"\"나는 할 수 없어.\" {n}님프는 고개를 떨굽니다.{/n} \"내 힘은 간신히 안개의 장막을 조금 찢을 수 있을 정도야 . 너에게 "
"길을 열어주는게 내가 할 수 있는 전부야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NyrissaRevealingStagFortSE/Cue_0010_Text
msgctxt "ffa85d04-cfda-488c-97bc-54e70ad62431"
msgid ""
"\"I expect no kind words or trust. But you are the enemy of my enemy, so I "
"will do all I can to help you fight him. Know that the road to the Stag "
"Lord's fortress is open. If you defeat him, if you allow the sun to reach my "
"flowers and streams again, you can expect a true reward!\""
msgstr ""
"\"나는 어떤 상냥한 말이나 믿음도 기대하지 않아. 하지만 적의 적은 나의 동료라는 말이 있듯이 네가 싸울 수 있도록 모든 도움을 줄 "
"거야. 수사슴 군주의 요새로 가는 길이 열려있다는걸 알길 바래. 만약 그를 쓰러뜨리면, 햇빛이 나의 꽃과 개울에 다시 닿을 수 있도록 "
"해준다면 진정한 보상을 기대해도 좋아!\""

#. Mechanics/Blueprints/World/Dialogs/c11/NyrissaRevealingStagFortSE/Cue_0013_Text
msgctxt "40fbd19a-25b1-46f7-8048-057089806365"
msgid ""
"\"Your words resonate inside my soul. Now I can see that I chose the right "
"person, worthy to hear my pleas…\""
msgstr "\"네 말이 내 영혼에서 울려 퍼지는구나. 내 부탁을 들어줄 사람을 잘 골랐다는걸 알겠어...\""

#. Mechanics/Blueprints/World/Dialogs/c11/NyrissaRevealingStagFortSE/Cue_0014_Text
msgctxt "350bb6b6-34d1-451b-a5b6-ff36e3002508"
msgid ""
"{n}The nymph casts her eyes down for a moment.{/n} \"And you would... would "
"like to see me again? Then yes. Of course. I'll come to you once the "
"tormentor is gone for good. I really hope to have a chance to show you the "
"true beauty of these lands... the meadows, the flowers...\""
msgstr ""
"{n}님프는 잠시 시선을 내립니다.{/n} \"너는... 나를 다시 볼 거야? 그렇다면 좋아. 물론이지. 고통의 근원이 영원히 사라지면 "
"너를 만나러 올게. 너에게 이 땅의 진정한 아름다움을 보여주고 싶어... 초원이며 꽃이며.\""

#. Mechanics/Blueprints/World/Dialogs/c11/NyrissaRevealingStagFortSE/Items/LockOfHair_String
msgctxt "63bdce4f-753e-458f-aefe-516258e2b25f"
msgid ""
"A pendant with a lock of hair, received as a gift from a nymph called the "
"Guardian of the Bloom."
msgstr "꽃의 수호자라는 님프로부터 선물 받은 한 타래의 머리카락이 담긴 펜던트."

#. Mechanics/Blueprints/World/Dialogs/c11/NyrissaRevealingStagFortSE/Items/LockOfHair_name_String
msgctxt "31ea8fa1-345f-4c16-b988-22a45e34448f"
msgid "The Nymph's Gift"
msgstr "님프의 선물"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Answer_0004_AlignmentShift.Description
msgctxt "1b210c4b-ee13-43c9-83ed-89871eaa70d1"
msgid ""
"Intimidated the bandits, but took the money they wanted to collect from Oleg "
"for yourself."
msgstr "도적을 위협했지만 올렉에게서 직접 빼앗으려 했던 돈을 가져갔습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Answer_0004_Text
msgctxt "503b7a54-aa27-47f8-a96a-6b80ebf8f875"
msgid ""
"\"I'll spare you the trouble and just collect this 'tax' from Oleg for "
"myself. You could try to stop me, I suppose... it might even be amusing. The "
"Swordlords sent me to wipe out the filth around here anyway.\""
msgstr ""
"\"굳이 너를 방해하지 않고 올렉으로부터 이 '세금'을 직접 징수하겠다. 날 막으려고 노력할 수도 있지. 꽤 재밌을 거야. 어찌 되었든 "
"소드로드는 나를 보내어 이 근방의 녀석들을 쓸어버리라고 명령했지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Answer_0005_Text
msgctxt "447d61a4-e2a5-4427-b2c8-d9083d09f05c"
msgid "[Attack] \"There's no need for words. To arms!\""
msgstr "[공격] \"더 이상 말은 필요 없다. 공격!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Answer_0006_AlignmentShift.Description
msgctxt "893db23f-17e4-41d1-b973-a9deab9fb432"
msgid ""
"Attempted to conclude an agreement with bandits instead of fighting them."
msgstr "도적과 싸우는 대신에 합의를 시도했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Answer_0006_Text
msgctxt "754154f8-9da4-49a8-81c8-34480bb63e71"
msgid ""
"\"I'm not interested in bloodshed, but I won't let you rob this man. Be on "
"your way, and I'll let you go in peace.\""
msgstr "\"나는 유혈사태는 관심이 없지만 네가 도적질하도록 두지 않을 것이다. 갈길을 가면 건들지 않겠다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Answer_0016_Text
msgctxt "768f91fc-e148-4d4a-9e4e-ea6ac014162a"
msgid "\"What's going on here?\""
msgstr "\"여기서 무슨 일이 일어난 거지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Answer_0025_AlignmentShift.Description
msgctxt "69448026-2476-4ac7-8235-ae42fae82802"
msgid "Attacked the bandits and fulfilled Jamandi's task."
msgstr "도적을 공격하고 자만디의 임무를 완수했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Answer_0025_Text
msgctxt "f1cc0832-1d6d-4618-8f27-4794444fb5ac"
msgid ""
"[Attack] \"My task is to clear this land of bandits. I'll start right now.\""
msgstr "[공격] \"내 임무는 이 땅에서 도적들을 청소하는 거지. 지금부터 시작하겠다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Cue_0001_Text
#. Speaker : KresslePack_Bandit_01
msgctxt "9e9e141b-3081-4997-bfe8-0f00d0eaad40"
msgid ""
"\"In the name of the Stag Lord, the — haha! -'lawful' authority in {g|Stolen "
"Lands}the Stolen Lands{/g}, we demand this week's tax! And some beer.\""
msgstr ""
"\"하하! {g|Stolen Lands}도둑맞은 땅{/g}의, '적법한' 주인 수사슴 군주의 이름으로 이번 주 세금을 받아가겠다! 물론 "
"약간의 맥주도 같이!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Cue_0002_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "c9d18381-675b-4a34-91c9-af5d0a0b4701"
msgid ""
"\"You want to drink some of my blood, too? I'm sick of you — you're like "
"locusts! You think you control everything around here just because you put "
"up that painted rag of yours?! You come here, squeeze us dry, and come ag-\""
"\n"
"{n}Oleg, a large man with a rough face, stops talking when he notices "
"you.{/n} \"Ah, you must be guests from {g|Restov}Restov{/g}!\""
msgstr ""
"\"내 피도 좀 부어주랴? 이 역겨운 메뚜기들아! 너희가 그 잘난 헝겊좀 입었다고 여기 있는 모든 것을 지배한다고 생각해?! 너희는 "
"우리를 쥐어짜고 말려죽이...\"\n"
"{n}거친 얼굴의 덩치 큰 사내 올렉은 당신을 보고 말을 멈췄습니다.{/n} \"아. 당신은 {g|Restov}레스토프{/g}에서 오신 "
"손님이시군요!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Cue_0008_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "c4d6734d-ff1c-4257-8218-eb780ede2233"
msgid ""
"{n}Oleg clenches his fists tightly.{/n} \"It seems guests from "
"{g|Restov}Restov{/g} are even worse than the bandits around here. To the Pit "
"with you, then! Take the money — just leave us be.\""
msgstr ""
"{n}올렉은 주먹을 꽉 쥡니다.{/n} \"{g|Restov}레스토프{/g}에서 오신 손님은 이 주변의 강도들보다 더 질이 나쁜 것 "
"같군. 지옥에나 떨어지길! 이 돈을 받고 우리를 내버려 둬요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Cue_0009_Text
#. Speaker : OTP_Kressle
msgctxt "5360889d-f086-432b-9da2-232d62177965"
msgid ""
"{n}The woman looks you up and down.{/n} \"Stranger, you sure are lucky we "
"don't have more of our crew with us today. Go ahead and keep this fool's "
"money. But you can be sure I'll tell the Stag Lord all about what happened "
"here!\""
msgstr ""
"{n}여자가 당신을 위아래로 흝어봅니다.{/n} \"이방인. 오늘 우리가 더 많은 어깨들을 데려오지 않은 걸 다행으로 여겨라. 저 "
"멍청이들의 돈을 잘 간직해둬. 여기서 어떤 일이 일어났는지 수사슴 군주께서 모두 알게 될 거다!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Cue_0010_Text
#. Speaker : OTP_Kressle
msgctxt "9c8cc812-9b37-44a9-8a66-cf07476cbf3a"
msgid ""
"\"Retreat! We're too few for a fight. Let's call for help from the camp!\""
msgstr "\"후퇴! 우리 수가 딸린다! 야영지에서 애들을 데리고 오자!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Cue_0011_Text
#. Speaker : KresslePack_Bandit_01
msgctxt "23bc0b83-cf78-4e0b-b733-d024679e4c79"
msgid ""
"\"No way! Just means we can rob a few idiots instead of just one! To arms, "
"everyone!\""
msgstr "\"후퇴는 무슨! 우리가 바보를 몇 명이나 털어버릴 수 있는지 보여주지! 모두 전투 준비!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Cue_0012_Text
#. Speaker : KresslePack_Bandit_01
msgctxt "c28c0e36-f91e-4bac-94eb-c608f0be8dd8"
msgid ""
"\"Why would we leave when we've got easy pickings from {g|Restov}Restov{/g} "
"before us? We'll rip out your guts and empty your pockets!\""
msgstr ""
"\"왜 우리가 {g|Restov}레스토프{/g}에서 배달된 돈주머니 앞에서 도망쳐야 해? 저놈의 똥배짱을 찢어버리고 주머니를 탈탈 "
"털어가야지!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Cue_0013_Text
#. Speaker : OTP_Kressle
msgctxt "abaf2007-549a-4f9f-8a77-be369d0802f4"
msgid ""
"{n}The woman smiles coldly.{/n} \"All right, we'll leave. But what makes you "
"think we won't just return with greater numbers?\""
msgstr ""
"{n}여자는 차갑게 웃었습니다.{/n} \"좋아. 이쯤에서 물러가 주지. 하지만 우리가 더 많은 숫자로 돌아오지 않을 거라고 착각하는 건 "
"아니겠지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Cue_0014_Text
#. Speaker : OTP_Kressle
msgctxt "d292131b-a8e7-4505-8049-686758bc9e0d"
msgid ""
"\"Quiet down, dimwit. Oleg, we're just here for the Stag Lord's tax. Hand "
"over the money, and we'll be on our way.\""
msgstr "\"닥쳐. 얼간아. 올렉. 우리는 수사슴 군주께 바칠 세금을 거두러 온 것뿐이다. 돈을 넘겨라. 그러면 조용히 떠나주지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Cue_0015_Text
#. Speaker : KresslePack_Bandit_02
msgctxt "7c82113c-3caa-4ceb-bc60-2aa9318b7757"
msgid ""
"\"And where's that pretty wife of yours, Oleg? She should serve us dinner!\""
msgstr "\"네 이쁘장한 아내는 어디 있지. 올렉? 네 아내가 해준 저녁이 먹고 싶은걸!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Cue_0017_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "5f4150ca-c7df-4d64-b5bd-9619589866ba"
msgid ""
"\"Isn't it obvious? These thugs are robbing us honest settlers! They say "
"they're taking some 'tax' for their leader, the Stag Lord.\" {n}Oleg "
"spits.{/n} \"But I didn't swear allegiance to any stag lords! I pay my taxes "
"to Restov.\""
msgstr ""
"\"뻔하지 않습니까? 이 깡패들은 정직한 정착민들의 돈을 갈취하는 것뿐이라고요! 이놈들은 수사슴 군주에게 바칠 '세금'을 수금하러 온 "
"거라고 지껄이고있지만...\" {n}올렉은 침을 뱉었습니다.{/n} \"나는 수사슴 군주에게 충성을 맹세하지 않았어! 나는 레스토프에 "
"세금을 낼 거야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Cue_0018_Text
#. Speaker : OTP_Kressle
msgctxt "d8268d7b-dfed-4951-800f-4fe218df3296"
msgid ""
"\"But {g|Restov}Restov{/g} is so far away, Oleg. And the Stag Lord is so "
"close. And as for you...\" {n}The young, dark-haired woman squints angrily "
"at you.{/n} \"Get out of here before it's too late. This is our land — we "
"own it!\""
msgstr ""
"\"하지만 올렉. {g|Restov}레스토프{/g}는 멀고 수사슴 군주는 가깝지. 그리고 네놈들은... \" {n}검은 머리칼의 젊은 "
"여인이 화난 듯이 당신을 쏘아 보았습니다.{/n} \"늦기 전에 여기서 꺼져라. 여긴 우리 땅이다. 우리의 소유라고!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Cue_0021_Text
#. Speaker : Jaethal_Companion
msgctxt "08fddbf0-49c2-4b2f-9f02-9ea601b5af6e"
msgid "\"How amusing. I'm starting to enjoy your company.\""
msgstr "\"이 얼마나 즐거운지. 당신과 같이 다니는 게 재미있어지는군.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Bandits_dialog/Cue_0024_Text
#. Speaker : Valerie_Companion
msgctxt "c5813557-9f2e-4fce-bbdd-ac0c092990d6"
msgid ""
"\"Our duty is to protect the {g|Oleg's Trading Post}trading post{/g}. Don't "
"waste your breath on scum like this.\""
msgstr ""
"\"우리의 의무는 {g|Oleg's Trading Post}교역소{/g}를 지키는 것입니다. 저런 버러지들에게 대화는 입만 아플뿐입니다."
"\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/BanditsTar2_String
msgctxt "f49da8ec-52b3-4462-8ff7-9a4cdfe689e8"
msgid "\"I'll rip your heads off!\""
msgstr "\"네 녀석의 머리통을 쪼개주마!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/BanditsTar_String
msgctxt "4685b814-bee1-433e-a52f-c1da37e1b512"
msgid "\"Kobolds eat me alive! What is this?!\""
msgstr "\"코볼트가 날 산 채로 먹는다고! 도대체 뭐야?!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/Banner_Action_String
msgctxt "b2c52646-f34c-4bcf-850a-fb4695420795"
msgid "Pull Down the Banner"
msgstr "현수막 내리기"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/Banner_String
msgctxt "9e332ed0-c9c1-4639-8c04-305335999d7b"
msgid "A banner scribbled with the crest of the Stag Lord."
msgstr "현수막에는 수사슴 군주의 볏이 새겨져 있습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/Bed_DisplayName_String
msgctxt "7211d65d-2ad0-4c1b-a308-3aa92fae4386"
msgid "Bed"
msgstr "침대"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/Bed_ShortDescription_String
msgctxt "020b148b-ba0a-4676-abb7-36b60e87772d"
msgid "Go to Sleep"
msgstr "잠자기"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/BokkenAfterBattle_String
msgctxt "134c17eb-4b01-4923-8153-b0eef99a13cd"
msgid "\"We sure showed them what's what!\""
msgstr "\"저놈들에게 이게 뭔지 보여주겠어!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/BokkenRunningBark_String
msgctxt "1f4d008e-688d-4c05-b8ab-1bdf4f512741"
msgid "\"Save yourselves, fools!\""
msgstr "\"살고싶으면 도망쳐, 바보들아!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/Gates_String
msgctxt "0c3baa67-3a40-4ad7-8f32-3d4d335d7396"
msgid ""
"The gate hinges are deformed, and the deadbolt is broken. It seems someone "
"didn't want this gate to close."
msgstr "문 경첩이 변형되고 걸쇠가 파손되었습니다. 누군가 이 문을 닫을 수 없게 만들고자 했던 것 같습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/OlegBarkAfter_ER_String
msgctxt "9e94c085-c258-4375-8463-457f0befcdab"
msgid ""
"\"We'll speak tomorrow, good {mf|lord|lady}. I need to count the losses.\""
msgstr "\"우리는 내일 좋게 말할 거야. {mf|lord|lady}. 나는 손실을 계산할 필요가 있다. \""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/OlegBarkAfter_String
msgctxt "3e4dfbfd-60cb-410c-a920-7d9b9e86aba7"
msgid ""
"\"We'll talk tomorrow. I still need to clean this mess. Getting rid of all "
"this blood will take forever!\""
msgstr "\"내일 이야기합시다. 이 난장판을 치워야 해서요. 이 피를 전부 치우려면 몇년은 걸릴 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/Store_String
msgctxt "fecbc497-31e2-4f88-a6b0-8febdbeaa8e3"
msgid "This building seems to be a warehouse. It's now tightly locked."
msgstr "이 건물은 창고인 것 같습니다. 이제는 단단히 잠겼습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/SvetlanaAfter_ER_String
msgctxt "8b83705a-c0a1-456a-96ac-4e7123a29558"
msgid ""
"\"I'm glad they left! Now, please excuse me — I have much to do. We'll speak "
"tomorrow.\""
msgstr "\"나는 그들이 떠나 기뻐! 실례. 나는 할 일이 많다. 내일 말하자고.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/SvetlanaAfter_String
msgctxt "72a24e28-5078-4af9-9d82-8cebab8d1e7c"
msgid ""
"\"I'm glad it's all over, even if there was a fight. We'll talk tomorrow, "
"once I've finished working.\""
msgstr "\"싸움이 있었지만 다 끝나서 기뻐요. 내일 일이 끝나면 얘기하도록 해요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/Walls_String
msgctxt "cee54eef-cdf3-4318-a748-b5ffd1568170"
msgid ""
"The walls of the old fort have been renovated recently, but they're not "
"finished yet."
msgstr "오래된 요새의 벽은 최근 개조되었지만 아직 완성되지 않았습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/Well_String
msgctxt "a9ae7033-c190-4c65-9a2c-58d3e181a529"
msgid "The old well has been renovated and cleaned. It even has a new roof."
msgstr "오래된 우물은 개조되고 청소되었습니다. 그것은 심지어 새로운 지붕을 가지고 있습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/tar_ambush_String
msgctxt "663dd8d7-e1e8-4076-875b-7592e6f3656a"
msgid "The tar will help slow the bandits down."
msgstr "타르는 도적을 늦추는 데 도움이 됩니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/tar_empty_String
msgctxt "3d524fbe-4ae6-4d74-b7a3-d34b79d32a51"
msgid "An empty tar pot."
msgstr "빈 타르 냄비."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/tar_normal_String
msgctxt "8decefbf-ba0d-4562-9bb4-e1f05e357012"
msgid "A pot filled with a disgusting-looking slush."
msgstr "냄비에 역겨운 모양의 액체가 가득 찼습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/traps_ambush_String
msgctxt "5b624c43-d4c1-4b89-87f5-eb8139e45255"
msgid "Traps that can be used to help catch the bandits."
msgstr "도적을 잡는데 도움이 되는 함정."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Barks/traps_normal_String
msgctxt "beb0d3a0-d2fc-466e-b8ea-1f220211aebd"
msgid "This box is filled with various household and hunting tools."
msgstr "이 상자에는 다양한 집기와 사냥용 도구가 들어있습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/BokkenFirstDialog/Answer_0003_Text
msgctxt "616e686c-b989-4e83-859c-3c4934bdfbfe"
msgid "\"Tell me about yourself.\""
msgstr "\"너 자신에 대해 말해봐.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/BokkenFirstDialog/Answer_0004_Text
msgctxt "7862c30f-23b4-41e8-bb76-bb48753c5d6a"
msgid "\"We'll talk later.\""
msgstr "\"나중에 다시 이야기 해.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/BokkenFirstDialog/Answer_0005_Text
msgctxt "4acd5643-2935-4c58-b825-33801c13db6f"
msgid "\"We could use your help fighting the bandits.\""
msgstr "\"도적과 싸우는 데 도움이 필요해.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/BokkenFirstDialog/Answer_0007_Text
msgctxt "e20d33cb-bdc7-484e-8c00-2a29685f9d39"
msgid ""
"\"The bandits here bother you as much as Svetlana and Oleg — maybe more. "
"Help us get rid of them for good!\""
msgstr "\"여기 산적들은 스베틀라나와 올렉 만큼 너를 괴롭힐 거야. 어쩌면 더 많이. 그들을 없애도록 도와줘!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/BokkenFirstDialog/Answer_0017_Text
msgctxt "162498df-722e-4e40-8a3d-c356753de9b4"
msgid "\"Coward! Gorum despises people like you!\""
msgstr "\"겁쟁이! 고룸께서는 너희 같은 것들을 경멸한다!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/BokkenFirstDialog/Cue_0001_Text
msgctxt "1cbb6eaf-5171-4a20-9931-0ef29216d985"
msgid ""
"{n}A frail, disheveled old man wearing a stained and tattered robe gives you "
"a gloomy look.{/n} \"I'm Bokken, local herbalist. What brings you here?\""
msgstr ""
"{n}얼룩덜룩하고 너덜너덜 한 낡은 옷을 입은 노인은 우울한 표정을 보입니다.{/n} \"나는 이 지역의 약초상인 보큰이라오. 왜 온 "
"거요?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/BokkenFirstDialog/Cue_0006_Text
msgctxt "8bfc144f-462d-44ea-8eee-b5be9127c4d4"
msgid ""
"\"Where's this coming from? You want an old man like me to fight? Here, take "
"this potion. Consider that my help in your fight.\""
msgstr "\"무슨 생각을 하는거요? 나 같은 노인이 싸우길 원하시오? 여기 이 물약을 가져가시죠. 이게 도움이 되면 좋겠구려.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/BokkenFirstDialog/Cue_0009_Text
msgctxt "a0015ade-c941-43da-8b46-70eade4d6806"
msgid ""
"{n}Bokken scratches his head, then hums to himself and puffs his chest "
"out.{/n} \"Well, all right! I'll show those troublemakers! They'll learn "
"better than to chase an old man around. Someone might even write up some "
"verses about me. Maybe even heroic ones!\""
msgstr ""
"{n}보큰은 머리를 긁으면서 콧바람을 불고 가슴을 부풀립니다. {/n} \"그래, 알았소! 그 말썽 꾸러기들에게 본때를 보여줄거요! "
"노인을 쫓아 다니면 어떻게 되는지 가르쳐 줄 수 있겠지. 누군가 나에 관한 구절을 써도 될거야. 심지어 영웅으로서 불리게 될지도 모르지!"
"\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/BokkenFirstDialog/Cue_0010_Text
msgctxt "92566131-892f-47ae-b157-404d552a0dc0"
msgid ""
"\"I'd rather sit in the bushes and watch you and Oleg beat the daylights out "
"of those thugs. Watching from a distance is more fun, you know?\""
msgstr "\"차라리 덤불에 앉아 당신과 올렉이 그 깡패들을 두들겨 패는 것을 멀리서 지켜 보는 게 더 재미있겠소.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/BokkenFirstDialog/Cue_0011_Bokken_Text_String
msgctxt "841ca727-f5e2-40f8-a37c-a5cef59841d0"
msgid ""
"\"What's there to tell? I'm an herbalist. Make potions and sell them. Gather "
"herbs, roots, berries...\" {n}Bokken sighs.{/n} \"I live in the forest, live "
"off the land. Since leaving {g|Restov}Restov{/g} for these parts, I ended up "
"a merchant here at {g|Oleg's Trading Post}Oleg and Svetlana's post{/g}. They "
"let me in out of kindness. Help me with things. They bring me water, or "
"firewood when it's cold, and the occasional barrel of honey... They're good "
"people.\""
msgstr ""
"\"뭐라고 말해야 하나? 나는 약초상이오. 묘약을 만들고 그것을 팔고. 허브, 뿌리, 열매를 모으지.\" {n}보큰은 한숨을 "
"쉽니다.{/n} \"나는 숲에서 자급자족하며 살고있네. {g|Restov}레스토프{/g}에서 떠난 이후로 나는 {g|Oleg's "
"Trading Post}올렉과 스베틀라나의 교역소{/g}에서 상인이 되었지. 그들은 나를 친절하게 대했소. 나를 도와줬지. 날이 "
"추워질때면 물이나 땔감을 가져다 주고, 가끔씩은 꿀을 가져다 주기도 했지. 그들은 좋은 사람들이오.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/BokkenFirstDialog/Cue_0013_Text
#. Speaker : Jaethal_Companion
msgctxt "bbdbeb3b-8eef-4415-b32b-ab70e8e5f1b7"
msgid "\"A coward's excuse. How predictable.\""
msgstr "\"겁쟁이의 변명. 예상대로군.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/BokkenFirstDialog/Cue_0016_Text
#. Speaker : Linzi_Companion
msgctxt "8df4dc54-2164-496a-940b-d0d671e11d9a"
msgid ""
"{n}Linzi gives you a worried glance, then turns to Bokken.{/n} \"Please be "
"careful. Go ahead and help, but leave the heroics to us, you hear?\""
msgstr ""
"{n}린지는 당신에게 걱정어린 시선을 보내고 보큰에게 시선을 돌렸습니다.{/n} \"부디 몸조심해요. 도움은 고맙지만 영웅심은 우리에게 "
"남겨둬요. 알았죠?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/BokkenFirstDialog/Cue_0018_Text
msgctxt "d4ebfaef-628e-4587-9141-74081515a077"
msgid ""
"\"Good thing I don't worship him, then. Didn't get to my age by picking "
"fights!\""
msgstr "\"나는 그를 숭배하지 않는다. 싸움을 가릴 만큼 나이 먹지는 않았어!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegBeforeFog/Cue_0001_Text
msgctxt "2555d4a3-59d1-4019-932e-1862783844cc"
msgid ""
"{n}Oleg is breathing heavily, but he shakes his fist in the air "
"menacingly.{/n} \"You rats got what you deserved! Now they'll know better "
"than to treat honest people like cattle!\""
msgstr ""
"{n}올렉은 거칠게 숨을 내쉬면서도 허공에 주먹을 위협적으로 흔듭니다.{/n} \"이 쥐새끼들이 응당 받아야할 벌을 받았구나! 선량한 "
"사람을 호구 취급하다간 어떻게 되는지 똑똑히 깨달아라!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegBeforeFog/Cue_0002_Text
msgctxt "41acf79c-db3d-4334-b6eb-09e0bdff0a70"
msgid ""
"\"And our Bokken here taught them {d|c11 Bokken Fight}a thing or two{/d} as "
"well!\""
msgstr "\"물론 여기있는 보큰도 놈들에게 {d|c11 Bokken Fight}한 두가지{/d}정도 가르쳐줬지!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegBeforeFog/Cue_0003_Text
msgctxt "cd434692-1ff3-4d77-b823-6f1be086fff2"
msgid ""
"\"{d|c11 Bokken Dead}Sorry{/d} about Bokken... He was a fierce old man, but "
"I guess not fierce enough. How will I tell Svetlana? She'll probably cry. "
"How tragic...\""
msgstr ""
"\"{d|c11 Bokken Dead}유감이야.../d} 보큰의 일은... 그는 용감한 노인이었다. 하지만 싸움에서 살아남을 만큼 "
"치열하지는 못했어. 스베틀라나에게 뭐라고 말해야 할까? 그녀는 아마 울겠지. 이 얼마나 비극적인 일인지...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegBeforeFog/Cue_0004_Text
msgctxt "ff15197b-84af-4756-9a2f-6ca26351e40c"
msgid ""
"\"Now, my {mf|lord|lady}, head on up to the guest rooms on the second floor. "
"You deserve some rest after such a battle. I need to... clean things up.\""
msgstr ""
"\"자, {mf|나리|나리}께서는 2층에 있는 객실에 가주시길. 이런 전투를 치른 당신은 쉴 자격이 있습니다. 저는...청소를 좀 "
"해야겠네요. \""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegBeforeFog/Cue_0005_Text
msgctxt "f0fc11f9-4a02-4b75-97c0-b0373cd3136c"
msgid ""
"\"And this is for your efforts. Now, don't offend me by trying to turn it "
"down — just take it. An honest fight deserves an honest reward. If that were "
"more common practice in this world, I think life would be so much better...\""
msgstr ""
"\"그리고 이건 당신의 노력에 대한 보상입니다. 거절해서 저의 기분을 상하게 하지 말고 그냥 가져가십시오. 정직한 싸움은 정직한 대가를 "
"받을 자격이 있습니다. 그런 행동이 이 세상에서 더 일반적인 일이 된다면 훨씬 나은 세상이 될 거라고 생각합니다...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegBeforeFog/Cue_0006_Text
msgctxt "8878dd08-952c-4c3b-9e36-abf09179e1c8"
msgid "\"We should call Bokken out before he freezes in those bushes.\""
msgstr "\"우선 보큰이 그 수풀에서 얼어 죽기 전에 다시 여기로 불러와야겠군요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0006_Text
msgctxt "7171cbf1-83f1-4af7-a5bf-c6285ad356f7"
msgid ""
"\"Let's get to the point. You say the bandits are going to attack again? Who "
"are they, and when will they arrive?\""
msgstr "\"이야기를 정리해보자면. 도적들이 다시 여기를 공격할 거라고? 그들은 누구이며 언제 도착할 것 같나?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0007_Text
msgctxt "209c1053-0db2-4505-a13d-bfe38b448fce"
msgid "\"Oleg, I'd like to see your goods.\""
msgstr "\"올렉. 당신이 팔고 있는 걸 보여줘.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0009_Text
msgctxt "13ec18c6-875c-4902-8260-7ac230967c8d"
msgid "\"We'll talk later.\""
msgstr "\"나중에 다시 이야기 해.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0013_AlignmentShift.Description
msgctxt "6d8ee833-0e79-4f3a-98a2-e4098b73b4f3"
msgid "Offered help to Oleg Leveton in defending trading post against bandits."
msgstr "올렉 레베튼에게 도적에 대한 교역소 방어에 도움을 제공했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0013_Text
msgctxt "bf960fa1-bb2b-4f3a-9a83-442921f644ee"
msgid "\"You have nothing to fear. I'll help you deal with the attack.\""
msgstr "\"두려워 할 것 없다. 내가 공격을 막도록 도와줄 거야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0014_Text
msgctxt "1da99ae2-167b-408e-9c6d-35688eeb0d8a"
msgid ""
"\"Tell me as much as you know. How many bandits are there? What do they want?"
"\""
msgstr "\"네가 아는 한 많이 말해줘. 얼마나 많은 도적이 있어? 그들이 뭘 원하는 거야?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0015_Text
msgctxt "83f0146e-bea3-4d41-847e-ae96ce2d9666"
msgid "\"They claimed they were collecting taxes. Why?\""
msgstr "\"그들은 세금을 징수한다고 주장했다. 왜?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0016_AlignmentShift.Description_1
msgctxt "30075979-e547-482c-92a0-12227f7668f7"
msgid ""
"Told Oleg that your agreement with Jamandi is the only reason to protect the "
"trading post."
msgstr "자만디와의 계약이 거래소를 보호할 유일한 이유라고 올렉에게 말했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0016_Text
msgctxt "94bc0cd1-84e0-4a58-9404-b95883e7307d"
msgid ""
"\"The safety of your post may have been one of the conditions Jamandi Aldori "
"placed on granting me barony, but she said nothing about having to listen to "
"your whining.\""
msgstr ""
"\"교역소의 안전은 자만디 알도리가 내게 남작 작위를 허락하는 조건 중 하나였을지 모르지만 그녀는 네놈의 징징 대는 소리에 귀 기울이지 "
"말라는 어떠한 언급도 하지 않았다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0025_Text
msgctxt "15f03403-fbc1-43cd-a920-f2605648e3ef"
msgid "\"Can you answer a few more questions for me?\""
msgstr "\"몇 가지 질문을 해도 괜찮을까?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0028_Text
msgctxt "9ea95b1a-c0fe-4b93-a452-c14356a44cd4"
msgid "\"Enough about the bandits for now.\""
msgstr "\"도적떼에 대한 이야기는 이걸로 충분하다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0033_Text
msgctxt "e2da3af6-0d30-4586-9029-387a20f453fb"
msgid ""
"[Wait for attack] \"I'm prepared for the attack. Get in your positions and "
"wait.\""
msgstr "[공격을 기다린다] \"공격할 준비는 되었다. 자리로 돌아가서 기다려.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0046_Text
msgctxt "054b4207-d8c2-4345-957a-198f972789cd"
msgid "\"Tell me more about yourselves.\""
msgstr "\"너 자신에 관해 더 말해줘.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0049_Text
msgctxt "eda6319f-bc5c-45b8-9743-7819d546decd"
msgid "\"Let's get back to the possible attack...\""
msgstr "\"다가올 공격에 대해 얘기해보자...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0051_Text
msgctxt "1ef0836e-6685-424e-86c6-1b5d145e5ff9"
msgid ""
"\"I'm going to look around, think on the best way to use the tar and traps.\""
msgstr "\"주변을 둘러보고, 타르와 함정을 어떻게 가장 효율적으로 사용할지 생각해보겠다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0055_Text
msgctxt "2fddff11-b9b7-489a-9ba5-9d3115420dfc"
msgid "\"I saw someone run out of the trading post. Do you know who it was?\""
msgstr "\"누군가가 교역소에서 빠져 나가는 것을 보았다. 누군지 알고 있어?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0056_Text
msgctxt "b75ef08a-8271-487a-afd6-a29428389e76"
msgid ""
"\"Alchemist's fire? We could put it by the gate, light it off with a burning "
"arrow when those bandits are nearby.\""
msgstr "\"연금술사의 불? 문 옆에 배치해두면 도적이 근처에 왔을 때 불화살로 불을 붙일 수 있겠군.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0065_Text
msgctxt "8f4fab87-619a-4679-8db5-3840570866ab"
msgid ""
"\"What can you tell me about that man who ran away from the post and came "
"back?\""
msgstr "\"교역소에서 도망가서 돌아온 그 남자에 대해 무엇을 말해 줄 수 있어?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0066_AlignmentShift.Description
msgctxt "d8818fc3-07a9-4106-8f2a-354c9a343395"
msgid "Agreed to defend the trading post because you enjoy a good battle."
msgstr "당신은 좋은 전투를 즐기기 때문에 거래소를 지키기로 합의했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0066_Text
msgctxt "1dea6037-3003-4dda-a3c8-87363fd1b5e8"
msgid ""
"\"I'll help you. I'm not really interested in your post, but I never back "
"down from a good fight.\""
msgstr "\"나는 너를 도울 것이다. 하지만 네 교역소에 정말 관심이 없어. 하지만 좋은 싸움에서 결코 물러서지 않을 거야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0070_Text
msgctxt "e04533b6-f081-4b89-81ef-b84a30512233"
msgid "\"I like your idea.\""
msgstr "\"좋은 생각이야 .\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0071_Text
msgctxt "113eec02-32cf-497e-93c1-e67f99439a2e"
msgid ""
"\"Better give the alchemist's fire to me. We can deal with bandits without "
"it.\""
msgstr "\"연금술사의 불꽃은 그냥 내게 주는 게 어때? 그런 것 없이도 도적들쯤은 처리할 수 있어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Answer_0073_Text
msgctxt "b6f6bea9-8130-4ee3-ba60-825c3775667d"
msgid ""
"\"Alchemist's fire? Could you give it to me? I'm sure I'll find a good use "
"for it!\""
msgstr "\"연금술사의불? 나한테 줄 수 있겠나? 내가 잘 써먹을 수 있을 것 같은데 말이야!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0001_Text
msgctxt "705b97da-da60-4aa4-b6b9-2e2b0ed1fa39"
msgid ""
"{n}Oleg looks at you as though he'd hoped you and the bandits would cut each "
"other to pieces, then he grunts.{/n} \"So, the rats bailed, huh? Better than "
"nothing. But that won't keep them away for long. They'll be back with help, "
"and they'll raze this post to the ground. Now what are we to do?\""
msgstr ""
"{n}올렉은 또 다른 도적을 보는 것처럼 당신을 보며 투덜거렸습니다.{/n} \"그래. 쥐들끼리 거래를 하셨구만? 여기가 없어지는 것보단 "
"낫겠지만 말요. 하지만 놈들이 오랫동안 교역소를 멀리하진 않을 거라는 걸 알아둬요. 결국 그놈들이 떼를 지어 몰려와서 이곳을 박살 내고 "
"말 테니까. 이제 우리 부부는 어떻게 하지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_00029_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "97c85c38-ee4d-4b1b-931d-d87e4b8ccc52"
msgid ""
"\"That must have been Bokken. He sells potions. He lives out in the forest "
"like a hermit, but he comes here every day. He knows every tree and bush in "
"the area and how they can help you. The Stag Lord's gang wants him to work "
"for them. He lacks the courage to fight those bandits, but he won't just "
"walk away from us. He has a good heart, even if he grumbles a lot, "
"especially recently.\""
msgstr ""
"\"그는 보큰이었을 겁니다. 묘약을 판매하는 약초상이죠. 그는 은둔자처럼 숲속에서 살지만 매일 교역소에 찾아옵니다. 그는 이 지역의 모든 "
"나무와 수풀을 알고 있고 어떻게 도와줄 수 있는지를 알고 있어요. 수사슴 군주의 도적들은 그가 자기들을 위해 일해주길 바라죠. 보큰은 그 "
"강도들과 싸울 용기는 부족하지만 우리를 멀리하지 않습니다. 항상 투덜거리긴 해도 선량한 마음씨를 가지고 있죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0002_Text
msgctxt "309b2b61-cb2c-4690-90d0-889b6b675662"
msgid ""
"{n}He notices a fair-haired woman approach.{/n} \"Dove! Why are you here? I "
"told you to stay hidden!\""
msgstr "{n}그는 금발의 여성이 나온 것을 알아차립니다.{/n} \"여보! 왜 나왔어? 내가 숨어 있으라고 했잖아!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0004_Text
msgctxt "174f5476-4bca-49f0-860a-d176a3dd13c3"
msgid ""
"\"It's all over — I saw it. I just needed to be sure you were all right...\" "
"{n}The woman looks at her husband tenderly, if with a hint of sorrow. Oleg "
"mumbles something as he looks away, embarrassed.{/n} \"My name is Svetlana. "
"I'm sorry your arrival to our {g|Oleg's Trading Post}trading post{/g} turned "
"out so... unwelcoming.\""
msgstr ""
"\"다 끝난거 봤어요. 전 그냥 당신이 괜찮은지 확인해야 했어요...\" {n}혹여 남편이 잘못되었는지 여인은 부드럽게, 근심 섞인 "
"눈빛으로 그를 바라봅니다. 올랙은 웅얼거리면서 당황하여 시선을 돌립니다.{/n} \"제 이름은 스베틀라나에요. 당신이 {g|Oleg's "
"Trading Post}교역소{/g}에 왔는데 상황이 이렇게 되어 정말 유감이네요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0005_Text
msgctxt "63fca25d-1c23-4adf-abdd-1406daca9ace"
msgid ""
"\"Take that, you scoundrels!\" {n}Oleg shakes his fist.{/n} \"But now...\" "
"{n}He scratches his head and stares at the ground gloomily.{/n} \"The girl "
"got away, a plague on her. She's certain to complain to the Stag Lord. They "
"came before to 'collect taxes,' but this time they'll come to 'punish "
"treason'... Now what are we to do?\" {n}He sighs heavily.{/n} \"If only I "
"could send Svetlana somewhere safe and show those rats what's what!\""
msgstr ""
"\"어떠냐. 이 악당 놈들아!\" {n}올렉이 주먹을 흔들었습니다.{/n} \"하지만 이제...\" {n}그는 머리를 긁으며 우울하게 "
"당신을 쳐다봤습니다.{/n} \"그 여자가 도망쳤군요. 수사슴 군주에게 이 일을 일러바칠 게 분명합니다. 이번에는 '세금을 징수하러' "
"왔지만 다음번에는 '반역을 처벌하러' 오겠지요... 이제 어떻게 해야 할까요? \" {n}그는 무겁게 한숨을 쉬었습니다.{/n} "
"\"스베틀라나를 안전한 곳으로 보내고... 그 쥐새끼들에게 본때를 보여줄 수만 있다면!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0011_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "e9e58314-74c5-4e23-b690-b9bc162abb62"
msgid ""
"{n}Oleg waves his hand sullenly.{/n} \"Who are they? They're the Stag Lord's "
"gang, that's who! These lands teem with bandits like bedbugs in a beggar's "
"hut, and you just stirred them up. They have a camp not far from here — I "
"expect they'll return in full force in half a day, maybe less. The Stag Lord "
"won't take an insult like this lightly, and his henchmen are more like "
"demons than men...\""
msgstr ""
"{n}올렉은 손을 부들거렸습니다.{/n} \"놈들이 누구냐고요? 수사슴 도적단이죠. 그게 저놈들이라고요! 이 땅은 거지 오두막의 빈대 "
"같은 산적들로 가득 찼고 당신이 놈들을 건드린 거죠. 여기에서 멀지 않은 곳에 놈들의 야영지가 있어요. 놈들은 반나절 만에 머릿수를 불려 "
"돌아올 겁니다. 수사슴 군주는 이런 모욕을 가볍게 넘기지 않을 작자이고 그 부하들은 인두겁을 쓴 악마들입니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0017_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "9c2a33ad-9649-4128-ab49-880e7ce3bd9e"
msgid ""
"{n}Oleg grunts.{/n} \"So, what, I should start calling you 'Your Grace' and "
"kneeling as you pass? I may not be a noble, but I have my dignity — you "
"won't see me crawling on my knees! Let's prepare for the fight, and then "
"we'll see what kind of baron{mf||ess} you are. Let's see... I have some "
"spare traps, some tar... and a box of alchemist's fire. I'd bet some of it "
"could help in the battle.\""
msgstr ""
"{n}올렉은 불편한 심기를 드러냈습니다.{/n} \"당신이 지나갈 때마다 '당신의 은총을' 이라고 지껄이며 무릎을 꿇어야 한다는 건가? "
"난 귀족은 아니지만 내 나름의 존엄이 있어. 나는 당신 앞에 무릎 꿇지 않아! 차라리 강도들과 싸울 준비나 합시다. 그러면 당신도 이 "
"땅을 어떤 종류의 남작이 통치하는지 알게 될 테니까. 어디 보자... 여분의 덫과 약간의 타르... 그리고 연금술사의 불 한 상자가 "
"있군. 이 물건들이 전투에 도움이 되겠지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0021_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "ea32fd8c-d3a6-4b84-a5a2-2f444f4b0860"
msgid ""
"\"Well, I appreciate your good intentions. I may not have the best manners, "
"but Oleg Leveton is the last name you'll hear accused of being ungrateful! "
"If we manage to defend this post, I'll reward you proper.\""
msgstr ""
"\"후우. 당신의 선의에 감사드립니다. 제가 예의는 부족해도, 이 올렉 레베튼은 은혜를 갚기로 둘째가라면 서러운 사람입니다! 이 교역소를 "
"지켜낸다면 제대로 보상을 해드리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0022_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "e3d6cf26-bd48-4d44-b2d4-36bdbae86446"
msgid ""
"\"What do they want? Those bloodsuckers think they own this land — they "
"come, take what they want, and steal the better part of our money every "
"month as a toll for their leader. They even broke our gate so we couldn't "
"try to hide anything from them. No one knows exactly how many there are. "
"Sometimes only five or six come — sometimes, it's a whole gang. I'd have "
"shown them what for long ago, if not for Svetlana.\""
msgstr ""
"\"놈들이 원하는 게 뭐냐고요? 그 거머리들은 자기들이 이 땅을 소유하고 있다고 생각하는 거죠. 여기 와서 원하는 걸 맘대로 집어가고 "
"교역소 수익에서 상당 부분을 수사슴 군주의 몫으로 훔쳐 갑니다. 심지어 우리가 농성하지 못하게 교역소의 문까지 부숴버렸죠. 5~6명이 "
"오기도 하고 떼를 지어 몰려오기도 하더군요. 스베틀라나가 말리지 않았다면 진작에 놈들에게 뭔가 보여줬을 겁니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0023_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "3ec2401e-a9cf-4a58-b79f-84fc0495d1de"
msgid ""
"\"For the Stag Lord and his cronies, of course! That Stag Lord fancies "
"himself a king in these parts. He may have antlers for a crown, but all the "
"troublemakers around here are happy to follow his orders as long as they're "
"paid. So they charge an arm and a leg as 'taxes,' and they call their "
"executions 'punishment for treason,' even those who never swore allegiance "
"to the Stag Lord. They're killed fast, if they're lucky. If not...\" {n}Oleg "
"looks to Svetlana.{/n} \"Dove, why don't you go start supper while we finish "
"our talk?\""
msgstr ""
"\"수사슴 군주와 그의 백성들에게는 당연한 일이죠! 수사슴 군주는 잔혹하기 때문에 자기가 왕이라고 생각합니다. 그는 왕관 대신 뿔을 쓰고 "
"있을 뿐이지만, 그가 부리는 악당들은 돈을 받는 한, 그의 왕명에 따르며 행복해하죠. 그놈들은 자른 팔과 다리를 '세금'이라고 부르고, "
"사형 집행을 '반역에 대한 처벌'이라고 부릅니다. 심지어 수사슴 군주에게 충성을 맹세한 사람들에게도 똑같이 굴죠. 그나마 단숨에 "
"살해당하면 운이 좋은 겁니다.\" {n}올렉은 스베틀라나를 돌아봤다.{/n} \"여보, 우리가 이야기를 끝낼 동안 저녁을 먹는 게 어때?"
"\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0024_Text
#. Speaker : OTP_Svetlana_FirstVisit
msgctxt "da1a43f0-b14f-4c2a-b049-099c6a9c394e"
msgid ""
"\"I've no need to be protected from dark talk. I'm not some blind kitten, "
"you know — I've seen what they do to people.\" {n}Svetlana lowers her "
"head.{/n} \"Most of the gang is made up of simple bandits, but there are a "
"few monsters among the leadership, especially those close to the Stag Lord. "
"Auchs and Dovan from Nisroch come to mind. They like to make a show of their "
"tortures and executions. My husband and I... we saw the bodies.\""
msgstr ""
"\"올렉, 나쁜 얘기로부터 절 보호하려고 하지 마세요. 저는 눈먼 새끼 고양이가 아니에요. 당신도 알다시피 저도 그들이 사람들에게 무슨 "
"짓을 하는지 다 봤는걸요. \" {n}스베틀라나는 고개를 숙였다.{/n} \"수사슴 도적의 대부분은 단순한 산적들이지만, 지도자들, 특히 "
"수사슴 군주의 측근 중에는 잔악무도한 살인마들이 있어요. 니스로크 출신의 옥스와 도반이란 자들입니다. 그 괴물들은 고문과 처형을 "
"보여주기를 좋아하죠. 남편과 저도... 처참히 도살된 시체를 본 적이 있어요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0029_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "fefcfdf3-4a58-47ff-8d4b-6351224368a0"
msgid ""
"\"I'm afraid they'll come back while we're chatting away, but what's to be "
"done...?\" {n}Oleg mumbles.{/n}"
msgstr ""
"\"저희가 대화를 하는 동안 그 놈들이 돌아올까 두렵습니다. 하지만 도대체 뭘 해야 하죠...?\" {n}올렉이 중얼거린다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0031_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "b7824605-dedf-4fb4-8c31-3cc49be3be00"
msgid ""
"\"Don't know what good trading will serve if those bloodsuckers come back "
"and take everything... but all right, have a look.\""
msgstr "\"그 거머리들이 돌아와 모두 쓸어가면 좋은 거래고 뭐고 없겠지만... 알겠습니다. 상품을 보여드리죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0032_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "a077ae6f-2f81-4b5c-8343-01cf986ba7c1"
msgid "\"Meanwhile, they'll never have enough.\""
msgstr "\"이러는 동안에도, 놈들은 충분하지 않을 거란 말입니다..\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0043_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "f26ebfc4-bfe1-4f96-9f82-f551078d4df0"
msgid "\"Svetlana, go hide inside! We're going to go meet our guests.\""
msgstr "\"스베틀라나, 집 안에 숨어있어! 손님들을 맞이해야 하니까.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0045_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "99269c9f-2fb7-448b-88ba-434c8ffae696"
msgid "\"I see you're not easily cowed.\""
msgstr "\"확실히 쉽게 당할 것 같지는 않네요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0047_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "1fdd819a-3c64-4af4-a6ae-c57cc456876b"
msgid ""
"{n}Oleg shifts uncomfortably.{/n} \"Surely there are more important things "
"to discuss... Well, all right. We're just honest people who came here from "
"{g|Restov}Restov{/g}. We fixed up the old fort to house travelers and give "
"merchants a place to trade with the locals. We also deal with the occasional "
"huntsmen in the area. What does any of this matter? When those bandits come "
"back, they'll either drain us dry or just kill us.\""
msgstr ""
"{n}올렉의 표정이 언짢게 바뀐다.{/n} \"지금은 더 중요한 일이... 뭐, 알겠습니다. 우리는 {g|Restov}레스토프{/g}에서 "
"여기로 정착한 정직한 사람들입니다. 우리는 낡은 요새를 여인숙으로 고치고, 상인들에게 이 지역의 주민들과 교역할 장소를 제공했죠. 가끔은 "
"이 지역의 사냥꾼들과도 거래하고요. 근데 이게 다 무슨 소용이랍니까? 어차피 그 도적 놈들이 돌아오면 우리를 말려 죽이거나 그냥 죽일 "
"텐데요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0048_Text
msgctxt "fd24759b-de47-4d63-b4f7-6f3b52f3d7cf"
msgid ""
"{n}Oleg seems to be even gloomier, and Svetlana sorrowful. Both of them look "
"at you intently.{/n}"
msgstr "{n}올렉은 무척 우울해보이고 스베틀라나는 슬퍼보입니다. 둘 다 당신을 골똘히 봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0050_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "f2675c28-017f-4bc7-be34-5a4c23d70a56"
msgid ""
"\"If we keep dallying, we'll end up talking WITH the attackers rather than "
"about them. If they're even willing to talk...\""
msgstr "\"계속 이렇게 꾸물대다간, 제가 아니라 도적놈들과 대화하게 될 겁니다. 물론 그들이 대화할 의향이 있다면 말이죠...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0052_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "aaecfe2b-01cc-458d-9374-9f4f939421f1"
msgid ""
"\"All right. Soon as you're finished, let us know. And don't leave the post —"
" the bandits could return at any time.\""
msgstr "\"알겠습니다. 다 끝나면 저희에게 알려주세요. 그리고 교역소를 떠나지 마세요! 도적들이 언제 돌아올지 모르니까요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0054_Text
msgctxt "51296a49-a2f7-42c1-8fb9-0196f0b77807"
msgid ""
"{n}Oleg and Svetlana are discussing something in low but impassioned "
"whispers. You manage to make out the words 'Forget about it!' before they "
"stop talking and turn to you.{/n}"
msgstr ""
"{n}올렉과 스베틀라나는 낮은 목소리로 열띄게 속삭이고 있습니다. 당신은 '잊어 버려!'라고 얘기할까 했지만 이내 그들은 대화를 마치고 "
"당신을 봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0057_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "273d3169-5be5-4e66-8164-304e6d090032"
msgid ""
"\"But that could set the post on fire!\" {n}Oleg shouts, surprised.{/n} "
"\"Well, maybe if we covered the walls with something to protect them... All "
"right, yes. I think it could work — I'll even shoot the arrow myself. I used "
"to be pretty good with a crossbow, back in my day.\""
msgstr ""
"\"그러다가 교역소에 불이 날수도 있습니다!\" {n}올렉은 놀라서 소리쳤습니다.{/n} \"뭐... 벽을 보호할 무언가를 칠한다면... "
"그래요. 네. 효과가 있을 것 같네요. 제가 직접 화살을 쏘겠습니다. 왕년에는 석궁을 꽤 잘 다뤘으니까요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0058_Text
#. Speaker : OTP_Svetlana_FirstVisit
msgctxt "3377e42a-39a0-4cb3-aeb5-17026b0fd1bd"
msgid ""
"\"I beg you, be careful. And please don't let Oleg do anything too risky.\""
msgstr "\"부디 조심해주시길 바라요. 그리고 올렉이 너무 위험한 일을 하지 않도록 해주세요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0061_Text
#. Speaker : Valerie_Companion
msgctxt "481c3dba-d808-473f-8958-da4e9eb9244c"
msgid ""
"\"Fear not! I'll stand between you and this scum! You're under my protection!"
"\""
msgstr "\"두려워 하지 마세요! 제가 그 쓰레기들로부터 당신을 지키겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0062_Text
#. Speaker : Amiri_Companion
msgctxt "65110b39-2d6d-4caa-acbc-8f8abe292b60"
msgid ""
"{n}Amiri flexes her shoulders.{/n} \"Finally, a fight. Was bored with all "
"that talking.\""
msgstr "{n}아미리는 기지개를 폅니다.{/n} \"마침내 싸움을 시작할 수 있겠군. 수다나 떠는 건 너무 지루하거든.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0063_Text
#. Speaker : Linzi_Companion
msgctxt "36b43af3-b6d4-4355-a0a1-8c24969e7317"
msgid ""
"\"Well, these aren't the heroics I was hoping to write about, but I guess "
"even the greatest heroes had to start somewhere.\""
msgstr "\"음... 내가 쓰고 싶은 영웅담은 이런 건 아니었지만, 위대한 영웅들도 처음이라는 게 있는 거겠죠...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0064_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "c1dfdaf8-bde4-444d-b269-f63cd3ed836c"
msgid ""
"\"We have to hide Svetlana — please don't argue, Dove! Now, we also need to "
"decide on a plan. Go ahead and look around — there may be some tools that "
"can be used for the battle. There are some pretty solid traps around, some "
"tar, and... a box of alchemist's fire, looks like.\""
msgstr ""
"\"우리는 스베틀라나를 숨겨야 합니다. 말싸움은 그만하도록 합시다. 이제 계획을 짜야 합니다. 앞으로 나아가 주변을 둘러보십시오. 전투에 "
"사용될 수있는 도구가 아마 있을 겁니다. 저기에 꽤 튼튼한 함정, 타르 그리고.. 연금술사의 불 포션이 담긴 상자같은 것도 있는거 "
"같군요. \""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0067_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "666a9a61-f4c2-4e6a-bd8d-9be68fcc4ab5"
msgid ""
"{n}Oleg grunts.{/n} \"Well, thanks, I guess. I might even be able to scrape "
"some sort of reward together for you if we manage to defend the post.\""
msgstr ""
"{n}올렉은 말합니다.{/n} \"음. 고맙습니다. 아마도요. 우리가 교역소를 지킬 수만 있다면 가진 것을 긁어 모아서라도 보상하고 "
"싶습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0068_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "6aecda09-fb13-4fc6-9c70-b148ee9a6db9"
msgid ""
"\"I'll help you fight. I've got a box of alchemist's fire we can use. We "
"could put it by the gate, then set it off with a burning arrow when those "
"bandits get close. I'll even shoot the arrow myself. I used to be pretty "
"good with a crossbow, back in my day.\""
msgstr ""
"\"전투를 저도 도와드리겠습니다. 우리가 사용할 수 있는 연금술사의 불이 있습니다. 우리는 그것들을 문 옆에 두고, 도적이 근처에 있을 "
"때 불타는 화살로 불을 붙일 수 있습니다. 저는 화살을 쏘겠습니다. 한 때 석궁을 잘 다루었거든요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0072_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "65ac3237-1a83-4f66-84bf-f7189a6a01d9"
msgid "\"Are you sure? Well, it's your call. Here, take it.\""
msgstr "\"정말이십니까? 뭐 당신 선택이니... 여기 받으세요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/OlegSvetlanaAfterBattle/Cue_0074_Text
#. Speaker : OTP_Oleg_FirstVisit
msgctxt "b40e9c5a-4206-4d57-a2c0-8098e5873b5e"
msgid ""
"\"Here, take it. But should you start throwing it into bandits, please, be "
"careful. Don't set the post on fire.\""
msgstr "\"여기요, 받으십쇼. 하지만 도적들에게 던질 때는, 부탁이니 조심해 주십쇼. 부디 기둥에 불을 붙이진 말아주세요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Tar/Answer_0005_Text
msgctxt "27733e66-9c55-4a2e-ab6f-d4318571ab0f"
msgid ""
"[Spill tar near the trading post entrance to help slow down the bandits]"
msgstr "[타르를 교역소 입구에 뿌려 도적들을 느려지게 한다]"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Tar/Answer_0006_Text
msgctxt "3fb1080e-f926-41b9-86f7-9f697bc4fd97"
msgid "[Leave without touching anything]"
msgstr "[아무것도 하지 않는다]"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Tar/Cue_0002_Text
msgctxt "912f5acc-afef-48f1-8043-a1b39504e2dd"
msgid "{n}This seems to be tar.{/n}"
msgstr "{n}이것은 타르인 것 같습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Tar/Cue_0003_Text
msgctxt "aabdf743-ffc1-4fa3-8743-93ed967d464e"
msgid "{n}You don't know what it is. It seems unlikely to be helpful.{/n}"
msgstr "{n}당신은 그것이 무엇인지 모릅니다. 도움이 될 것 같지 않습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Tar/Cue_0007_Text
msgctxt "80aecd20-950e-440e-b102-9527eaad4e3f"
msgid "{n}There's some disgusting slush in the pot.{/n}"
msgstr "{n}냄비에 역겨운 액체가 들러붙어있습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Traps/Answer_0005_Text
msgctxt "5ca900b1-41f6-4073-b953-aeb6755dfa1e"
msgid "[Use traps to help catch the bandits]"
msgstr "[함정을 뿌려 도적들을 막는데 사용한다]"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Traps/Answer_0006_Text
msgctxt "c0832250-8c56-4b64-b97d-3f982d962917"
msgid "[Leave without touching anything]"
msgstr "[아무것도 하지 않는다]"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Traps/Cue_0001_Text
msgctxt "75be6190-f68c-4dc6-892f-dc37be7b5b0e"
msgid "{n}This rubbish seems unlikely to be helpful in a battle.{/n}"
msgstr "{n}이 쓰레기는 전투에서 도움이 될 것 같지 않습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Traps/Cue_0003_Text
msgctxt "fde91ff3-0b40-4c43-be41-f819ba317adf"
msgid "{n}This box contains various household and hunting tools.{/n}"
msgstr "{n}이 상자에는 다양한 집기와 사냥용 도구가 들어있습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_and_bandits/Traps/Cue_0007_Text
msgctxt "2bbd1d2b-b1e3-4b4e-9682-0ce9e64a2792"
msgid "{n}You notice some good steel traps in the box.{/n}"
msgstr "{n}상자에 좋은 강철 함정이 있는 것을 보았습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Barks/HarrimInjured_String
msgctxt "e2552c20-9bd7-4b74-ba2d-6a141cb0c4be"
msgid ""
"\"I'd like to be alone. I'll have plenty of time to think about a great many "
"things while my wounds heal up.\""
msgstr "\"나는 혼자 있고 싶어. 상처가 치유되는 동안 생각할 시간을 가지고 싶어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Barks/JaethalInjured_String
msgctxt "a0c32d28-465f-489e-b724-f7f1871b308e"
msgid "\"I've no need of your company right now.\""
msgstr "\"지금은 너의 동료가 필요하지 않다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Barks/LinziInjured_String
msgctxt "f16d4776-563c-45ca-80d2-65e8cdc25acb"
msgid ""
"\"I accidentally dropped jam on my draft! That jam was really tasty, though."
"\""
msgstr "\"실수로 내 초안에 잼을 떨어뜨렸어! 하지만 잼은 정말 맛있었어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Barks/OlegAboutJhod_String
msgctxt "a334c5c7-a19d-4a85-968f-49ff16e10948"
msgid ""
"\"We have a visitor — Jhod Kavken, a venerable priest of Erastil. He wants a "
"word with you.\""
msgstr "\"방문자가 있습니다. 에라스틸의 훌륭한 성직자인 조드 카브켄이지요. 당신과 대화를 나누고 싶어하던데요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Barks/OlegAboutKesten_String
msgctxt "a58cc1a0-cb5b-4595-ba11-1e7bce6ce7c6"
msgid ""
"\"Guests from Restov arrived, commander Kesten and his men. They have some "
"news for you.\""
msgstr "\"레스토프의 손님들이 도착했다. 케스턴 장군과 그의 부하들이야. 소식을 알리러 왔다는군.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Barks/OnLeave_Amiri_String
msgctxt "fece7105-2c87-43b1-8feb-83317bd14452"
msgid ""
"\"I'm not some tenderling, but we should take on Oleg's offer. Don't know "
"when we'll be sleeping in proper beds next time.\""
msgstr "\"빈말이 아니라 올렉의 제안을 받아 들여야 해. 다음에는 좋은 침대에서 잘지도 모른다고.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Barks/OnLeave_Harrim_String
msgctxt "41cc8750-4219-46c9-9b73-ff725f471ba6"
msgid "\"The day was long. Shall we rest for a while?\""
msgstr "\"하루가 길었다. 잠시 쉬어야 하지 않겠어?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Barks/OnLeave_Jaethal_String
msgctxt "273edba1-8a04-42be-b090-1a675782ee91"
msgid ""
"\"I can stay awake infinitely. You can't. Get some rest before Oleg changes "
"his mind.\""
msgstr "\"나는 완전히 깨어있을 수 있어. 너는 못하지. 올렉이 마음을 바꾸기 전에 좀 쉬어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Barks/OnLeave_Linzi_String
msgctxt "4184e6c3-a2ea-4cf1-8d97-7881ba491109"
msgid ""
"\"Could we rest on Trading Post's upper floor before continueing our "
"adventure?\""
msgstr "\"모험을 떠나기 전에 교역소에서 쉬면 안될까?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Barks/OnLeave_Valerie_String
msgctxt "9a7fa0ab-07fb-4409-8340-600e4d1036ab"
msgid "\"We'd accept Oleg's invitatin and rest\"."
msgstr "\"우리는 올렉의 초대를 받아들여 휴식을 취할 거야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Barks/PersonalStash_label_String
msgctxt "0e9efcab-4e18-4254-b383-adc13b9df027"
msgid "Personal Belongings"
msgstr "개인 창고"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Barks/SvetlanaLeftAlone_String
msgctxt "53282bfa-d0ee-4424-8f39-d5a2aed7d46c"
msgid "\"I... need some time alone... Sorry.\""
msgstr "\"나는... 혼자만의 시간이 필요해. 미안해.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Barks/TristianInjured_String
msgctxt "a1f9903c-b9e9-4238-b9a3-bdb7d2c1c32d"
msgid "\"Don't worry about me. Jhod says I'll be fine soon.\""
msgstr "\"전 걱정하지 마세요. 조드가 곧 괜찮아질 거라고 했습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Barks/ValerieInjured_String
msgctxt "a09ca1fe-8eee-4c8a-b2f8-241a5fd0b3f4"
msgid ""
"\"Wounds are a matter of course for a fighter. It's not the wounds that "
"bother me, but the forced idleness.\""
msgstr "\"부상은 전사의 문제다. 상처가 그다지 아프지는 않지만 몸을 둔하게 만들긴 하지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0004_Text
msgctxt "3bfed33a-4424-4671-8eb7-eb2a1cc23340"
msgid "\"Remind me what you do here?\""
msgstr "\"뭘 하고 있는지 알려줄 수 있어?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0010_Text
msgctxt "1eac75cb-068f-4dae-889b-2f34c4f6d024"
msgid "\"Show me what you have.\""
msgstr "\"어떤 물건들이 있는지 볼까.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0016_Text
msgctxt "58b1d478-f550-43e1-9eb1-5b01f71952fd"
msgid "\"Can I help you in any way?\""
msgstr "\"내가 너를 도울 수 있을까?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0020_Text
msgctxt "300f7cf6-5013-406d-b89a-899801d96489"
msgid "[Give fangberries] \"Are these the berries you were looking for?\""
msgstr "[팽베리를 건네준다] \"이게 찾고 있던 열매맞나?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0022_Text
msgctxt "ebeaacb9-0c2c-4534-9784-87923f3ea4c8"
msgid "\"All right, I'll try to help.\""
msgstr "\"좋아. 내가 도와주지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0023_Text
msgctxt "a2b10994-36fc-4967-88ee-0ab18e3df541"
msgid "\"I don't have time for this.\""
msgstr "\"나는 이럴 시간이 없어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0024_Text
msgctxt "bb003844-4a59-4f80-91eb-4f780d0a8f6a"
msgid "\"I'll consider it, Bokken.\""
msgstr "\"한 번 생각해 볼게. 보큰.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0025_Text
msgctxt "a1b8659b-4b4c-47c7-a6b9-893b7d1562ed"
msgid "\"Why do you need fangberries and moon radishes, Bokken?\""
msgstr "\"왜 팽베리와 달 무가 필요한 거야. 보큰?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0032_Text
msgctxt "f074f3aa-0858-479e-b9c6-476641675d1d"
msgid "\"What was it you wanted me to do, again?\""
msgstr "\"나한테 뭘 부탁했었지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0034_Text
msgctxt "fd6ef756-9d24-4a73-936b-60445903ca1f"
msgid "\"I should go.\""
msgstr "\"이만 가봐야겠어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0038_Text
msgctxt "ffc3eee9-1d2d-4f77-9b70-7c429013c5b2"
msgid "\"Would you buy more fangberries and moon radishes if I brought them?\""
msgstr "\"팽베리와 달 무를 가져온다면 그걸 살 생각은 있어?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0048_Text
msgctxt "3ab2f647-a9c9-43a0-a267-16f0363c21cc"
msgid "\"What do you use these fangberries for?\""
msgstr "\"이 팽베리를 무엇에 사용할 거야?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0064_Text
msgctxt "2ca6c2ea-c471-40ad-a030-a458c37a1322"
msgid "\"Why do you need moon radishes?\""
msgstr "\"왜 달 무를 원하는 거야?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0066_Text
msgctxt "ec4464da-a34a-4f45-8d47-2baba8aba6c3"
msgid ""
"[Give moon radishes] \"Does this look like the radish you were looking for?\""
msgstr "[달 무를 건네준다] \"이 무가 찾고 있던 거야?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0068_Text
msgctxt "4366618c-6d4a-4cdd-be8a-9795170b2fdc"
msgid "\"About those tasks of yours...\""
msgstr "\"묻고 싶은게 있어...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0071_Text
msgctxt "b413735f-55b8-4987-9696-3486e1183339"
msgid "\"Let's talk about something else.\""
msgstr "\"다른 것에 대해 얘기해 보지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0075_Text
msgctxt "cd4a1a41-0a1b-4c7d-b4db-e918033ca2dd"
msgid "\"Bokken, how would you like to become my court alchemist?\""
msgstr "\"보큰. 궁정 연금술사로 내 밑에 들어오지 않겠나?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0086_Text
msgctxt "87fedee9-c19c-485c-b6ce-c3c4ef87a0c6"
msgid "\"Is this the book you wanted me to find?\""
msgstr "\"이것이 내가 찾기를 원했던 책인가?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0088_Text
msgctxt "1a66617b-0606-420c-aee2-412a1b134813"
msgid "\"Here's the second volume of that book set.\""
msgstr "\"여기 두 번째 책이다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0089_Text
msgctxt "ab082988-edba-45c9-bd33-64b0ad19c3fe"
msgid ""
"\"'Of Transmutations and Bodily Poisons,' volume three. Here you are, Bokken."
"\""
msgstr "3권. 여기 있다. 보큰.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Answer_0093_Text
msgctxt "d8e3c7bb-63e4-479b-98ef-a4d9d131e992"
msgid "\"You're not working on any dangerous new potions, I hope?\""
msgstr "\"위험한 새 물약을 만드는 건 아니겠지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0002_Text
msgctxt "19a61d41-624d-4065-8372-f51d6ccb6c18"
msgid ""
"{n}Bokken frowns as he ostentatiously examines the nearest wall, hands in "
"his sleeves. Without turning to you, the old man finally says in a dull "
"voice,{/n} \"You want some potions?\""
msgstr ""
"{n}보큰은 소매를 걷어 손으로 가까운 벽을 자세히 조사합니다. 돌아보지도 않고 노인은 마침내 무언가를 말합니다.{/n} \"물약이 "
"필요하시오?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0008_Text
msgctxt "0c08a31b-cbf2-4142-9730-212c622fe4a1"
msgid "\"You want some potions?\""
msgstr "\"물약이 필요하시오?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0017_Text
msgctxt "c9956023-c77f-4420-8e47-92a9355091be"
msgid ""
"{n}Bokken glances at you, suddenly interested.{/n} \"Well, since you're "
"asking... There's a cave nearby. I used to pick berries in there, but the "
"place has been overrun by spiders. The berries are red, look a lot like "
"raspberries — fangberries, I call them. I'd be real grateful if you gathered "
"a basket of them and brought them back. Just be quick, if you do — they "
"spoil quickly.\""
msgstr ""
"{n}보큰은 당신에게 관심이 있다는 듯 쳐다봅니다.{/n} \"뭐. 그렇게 듣고 싶다면야... 이 근처에 동굴이 하나 있소. 그동안 "
"거기에서 특별한 열매를 수확해왔지만 거미가 잔뜩 번식해버렸지 뭐요. 그 열매는 붉은색의 라즈베리같이 생겼지. 나는 그 열매를 "
"팽베리(fangberries)라고 부르오. 그걸 바구니에 가득 채워서 가져오면 정말 감사하겠소. 최대한 빨리 가져와 주시오. 팽베리는 "
"무척 빨리 썩으니 말이오.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0018_Text
msgctxt "48fb7f70-8234-4c9b-befa-c86c446837c1"
msgid ""
"\"It's not a huge deal, really. I'd do it myself, if I were younger. But if "
"you're willing, I'll pay you — three potions for the berries, and a purse "
"full of coins for the radishes!\""
msgstr ""
"\"크리 큰 일은 아니지않소? 내가 조금만 더 젊었다면 직접 했겠지만... 자네가 기꺼이해준다면 열매를 찾아준 대가로 포션 3개와 무를 "
"찾은 대가로 동전이 가득한 지갑을 주겠소!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0026_Text
msgctxt "78b51319-efb5-46e5-b8dc-6bb528c2d63c"
msgid "{n}The old man crosses his arms, clearly annoyed.{/n} \"Whatever.\""
msgstr "{n}노인은 짜증을 내며 팔짱을 낍니다.{/n} \"그러든지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0028_Text
msgctxt "57790949-171b-408b-9ab1-3c84006251a3"
msgid ""
"{n}Bokken glances at you hopefully.{/n} \"Just watch out, all right? Don't "
"end up someone's lunch.\""
msgstr "{n}보큰은 당신을 흘끗 봅니다.{/n} \"부디 조심하시오. 괴물한테 먹히지 말고.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0029_Text
msgctxt "eff0c013-2d7f-496f-ad5d-d74b2fcb328b"
msgid ""
"\"You want to know, huh? Well, I'll gladly tell you after you bring some to "
"me.\""
msgstr "\"알고 싶소? 가져다 주면 말해 주겠소.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0030_Text
msgctxt "4ee1fede-5c12-48ac-a4f4-0e7b986f0742"
msgid ""
"{n}After a quick glance at the basket, Bokken grabs a fistful of berries and "
"shoves them into his mouth. A smile of delight brightens his face.{/n} \"Ahhh"
", fangberries! So fresh! You've been good to an old man. Thank you! Here, "
"take these potions. If you need more, feel free to return — I'll even give "
"you a discount.\""
msgstr ""
"{n}바스켓을 한 눈에 보았을 때 보큰은 열매를 한움큼 집어 입으로 밀어 넣습니다. 기쁨의 미소가 그의 얼굴을 밝힙니다.{/n} \"아. "
"팽베리! 신선해! 노인을 공경할 줄 아는구만. 고맙소! 이 약을 가져가시오. 부족하면 이야기하시고. 자네에겐 싸게 주겠소.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0035_Text
msgctxt "a46e5fb9-71cc-4985-8aeb-9ec605a5a83c"
msgid ""
"\"There's a cave filled with spiders. Red berries I call fangberries grow "
"inside. I'd like you to gather a basket full of them and bring them to me as "
"quickly as you can, so they don't go sour.\""
msgstr "\"거미가 득시글거리는 동굴이 있소. 그 안에 팽베리가 있지. 빨리 상하니까 그 전에 가져다 주시오.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0037_Text
msgctxt "ba5640c5-4905-4d74-81db-d5b627faf540"
msgid ""
"{n}Bokken impatiently grabs the basket from you, but his face falls after he "
"examines the berries.{/n} \"Damn it all! These are the right berries, but "
"they've soured. Would you be so kind as to gather some fresh ones for an old "
"man? I'm still willing to repay you with those three potions I mentioned "
"before.\""
msgstr ""
"{n}보큰은 허겁지겁 당신에게서 바구니를 뺏더니 열매를 조사하고는 실망합니다.{/n} \"아이고, 이 열매가 맞긴한데, 이미 다 "
"시어졌군. 이 늙은이를 위해 신선한 열매로 다시 가져다 주면 안되겠소? 전에 얘기한대로 가져다 주기만 한다면 포션 세개를 주겠소.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0039_Text
msgctxt "aa56ea03-0255-4d0d-9b7c-49aa0e67c3c1"
msgid ""
"{n}A sly smile spreads on Bokken face, a glint in his eye.{/n} \"Sorry, my "
"friend, but after you took a walk through that cave, there's nary a spider "
"left. So now it's safe enough for me to gather the berries myself, rather "
"than pay someone else any time I need to cook dinner or make a potion. And "
"that bucket of moon radishes will be plenty for me... ahem, for me to help "
"Oleg for a long time to come, I mean.\""
msgstr ""
"{n}눈을 반짝이며 보큰 얼굴에 교활한 미소가 퍼집니다.{/n} \"미안하오, 친구. 자네가 그 동굴에 다녀온 뒤로 거미가 싸그리 "
"없어졌다오. 그러니 나 혼자서도 열매를 채집하기에 안전해졌고 그게 저녁을 준비하거나 포션을 만들 때마다 도움을 구하는 것보단 나을 것 "
"같소. 그리고 달 무는 한 양동이면 내게는 충분... 크흠, 내가 올렉을 오래오래 도와줄 수 있을거란 말이었소.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0040_Text
msgctxt "f5ef336a-bbcd-4c57-941b-5e03748f28b6"
msgid "{n}Bokken smiles at you.{/n} \"Oh, it's you! Want to buy anything?\""
msgstr "{n}보큰은 당신을 보고 미소 짓습니다.{/n} \"오. 왔소! 뭘 사고 싶소?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0050_Text
msgctxt "8dc7b17f-5df1-4e1d-b36c-38df27a841df"
msgid ""
"\"Truth be told, as I've gotten older, I've gotten kind of particular, and "
"my appetite is almost gone. Everything I eat is practically tasteless to me "
"now — I can barely force myself to swallow a bite. Only thing I can still "
"taste is fangberries, so I add them to my porridge, or to roasted meat. I "
"even add them to my potions. When I ran out of fangberries, I stopped eating "
"entirely. Svetlana tried to help me, the dear — she baked pies for me, "
"cooked me fish soup and stewed venison — but I just couldn't eat any of it. "
"I was desperate. Those damned spiders had sucked the last bit of joy out of "
"my life. If not for you, I'd pretty much have starved to death, miserable to "
"the end.\""
msgstr ""
"\"사실 나이가 드니 입맛이 까다로워졌소. 지금은 무얼 먹어도 맛이 없지. 한입도 먹기가 어려울 정도요. 그래도 여전히 팽베리를 올린 "
"죽이나 팽베리를 곁들인 고기는 맛있더군. 포션에도 팽베리를 넣으면 맛이 좋아진다오. 이제 팽베리 없이는 아무것도 먹을 수 없게 "
"되었소... 스베틀라나가 내게 파이도 구워주고 생선 수프나 조림을 해주지만 먹기가 쉽지 않소. 배고파 죽을 것 같소. 저 망할 거미들이 "
"내 인생의 유일한 즐거움을 앗아간게지... 당신이 아니었으면 나는 비참하게 굶어죽었을거요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0061_Text
msgctxt "5c5ad69d-5add-4f57-b23e-65cb65266266"
msgid ""
"\"I also need a bucket of moon radishes. They're a rare and mysterious "
"plant. I don't know where to find them, but I know that kobolds gather them "
"and value them highly.\""
msgstr ""
"\"또한 달 무도 한 바구니 필요하다오. 희귀하고 신비로운 식물이지만 어디에서 찾아야 할지는 잘 모르겠소... 하지만 코볼트가 달 무를 "
"엄청 좋아한다는 얘기를 들은 적이 있소.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0063_Text
msgctxt "7e19042e-64ac-4676-8020-487b80522cef"
msgid ""
"{n}Bokken blushes heavily and coughs into his fist.{/n} \"That's... for "
"Oleg! He sprained his back last summer, you see, tried to move a heavy chest "
"all by himself. You can't even imagine the healing powers of these radishes! "
"They make a great painkilling ointment! Potent, exquisite, I just... erm.\""
msgstr ""
"{n}보큰은 심하게 얼굴을 붉히고 주먹을 입에 갖다 대어 기침합니다.{/n} \"그건... 올렉을 위한거요! 지난 여름에 무거운 상자를 "
"혼자 옮기려다 허리를 삐어버렸지. 그 무의 치유력은 정말 상상도 하지 못할 거요! 아주 좋은 진통제 연고로 만들 수 있거든! 강력하고, "
"강렬하고... 난 그저... 어어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0065_Text
msgctxt "51a141f2-2f68-4735-96da-260ff4bb9e93"
msgid ""
"\"Oleg would never confess his weakness to anybody, but I see him wince "
"every time he bends over to pick something up.\" {n}The old man sighs, a bit "
"too loudly.{/n} \"Oh, when will the poor man realize he's not fifteen "
"anymore?\""
msgstr ""
"\"올렉은 결코 자신의 아픔을 누구에게도 비치지 않을 테지만 그가 무언가를 집으려 허리를 숙일 때마다 찡그리는 모습이 내게는 보이오.\" "
"{n}노인은 약간은 과장되게 한숨을 쉽니다.{/n} \"오, 이 불쌍한 자는 자신이 나이가 들었다는걸 언제쯤 깨달을고?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0067_Text
msgctxt "daa8e1b1-2738-4af3-82f8-030c1b056f0d"
msgid ""
"{n}Bokken's face brightens, and he rubs his sides in satisfaction.{/n} \"Yes"
", that's it! Heyyy, there's even more than I expected here... Thank you so "
"much! Take this — you deserve it!\""
msgstr ""
"{n}보큰의 얼굴은 밝아지고 그는 만족스럽게 옆구리를 문지릅니다.{/n} \"그래. 그거야! 생각보다 많이 가져왔군... 고맙소! 이걸 "
"가져가시오!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0069_Text
msgctxt "d2fce24b-c81e-460f-9c43-328dd88077b7"
msgid "\"Yes?\""
msgstr "\"음?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0072_Text
msgctxt "5371ac68-2087-44c6-b97e-0c9ef24f7303"
msgid "\"As you wish.\""
msgstr "\"원하는대로.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0073_Text
msgctxt "7a204942-15f2-48a2-a8b2-57e2acfbe59a"
msgid ""
"\"I also asked you to gather a bucket of moon radishes. Rumor has it that "
"kobolds are often found in the places where they grow.\""
msgstr "\"달 무도 한 바구니 모아달라고 했소. 코볼트가 무가 자라나는 장소를 알고 있다는군.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0074_Text
msgctxt "279a5fa1-782e-406b-97ff-3fcfde20e2e2"
msgid ""
"\"I asked you to gather a bucket of moon radishes. Rumor has it that kobolds "
"are often found in the places where they grow.\""
msgstr "\"달 무도 한 바구니 모아달라고 했소. 코볼트가 무가 자라나는 장소를 알고 있다는군.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0077_Text_String
msgctxt "02e20bd1-5a90-4e7b-aa07-13077e3dd2fa"
msgid ""
"{n}The old man peers at you with an inquisitory squint.{/n} \"A court "
"alchemist? Me? That'd be a first...\""
msgstr "{n}노인은 당신을 호기심 어린 곁눈질로 바라봅니다.{/n} \"궁정 연금술사? 내가? 이런 일은 처음이군...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0078_Text
msgctxt "cf294d68-5225-40f9-94d6-909e132ee77d"
msgid ""
"{n}Bokken finally sighs and waves his hand.{/n} \"Gah, fine! Come what may, "
"you've been kind to me — killed those damned spiders and brought an old man "
"some berries... I'll work for you. Just one thing, though — I need a new "
"laboratory! Someplace to keep all my bottles and ingredients. A workshop, "
"yes. And as for me, don't you worry — I'll do my part.\""
msgstr ""
"{n}보큰은 마침내 한숨을 쉬고 손을 흔듭니다.{/n} \"좋아! 어쨌든 자네는 내게 친절하게 대해줬으니까. 저 망할 거미를 죽이고 이 "
"노인네에게 열매를 갔다 주었으니... 당신을 위해 일하지. 하지만 한 가지. 나는 실험실이 필요하오! 내 약병들과 재료들을 보관하고 "
"실험할 수 있는 실험실 말이지. 오. 내 걱정은 하지 마시오. 내 몫은 할 테니.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0079_Text
msgctxt "26bf5cb4-5788-42e9-91ba-09a84a99e135"
msgid ""
"{n}Bokken's eyes light up.{/n} \"Court alchemist, you say? Perhaps, "
"perhaps... But first, I'll need a favor from you. There's a little cave a "
"short way from here. I used to gather berries there — till it got overrun "
"with spiders, that is. Red berries, almost like raspberries — fangberries, "
"they're called. Gather a bunch of them and bring them back. But don't wait "
"around once you have them — they sour very fast. Help me out, and I'll make "
"it worth your time... and become your court alchemist, as well.\""
msgstr ""
"{n}보큰의 눈에 빛이 납니다.{/n} \"궁정 연금술사라 이 말이오? 좋다 이거야... 하지만 먼저 당신의 호의가 필요하오. 저기에 "
"작은 동굴이 있는데. 저기서 열매를 모으고는 했지. 그런데 거미들이 난리를 피웠소. 라즈베리처럼 생긴 빨간 열매가 있는데 팽베리라고 "
"부르오. 한 움큼 모아서 내게 가져다주시오. 하지만 구하면 서둘러야 하오. 금방 시어져 버리니까. 나를 도와주면 내가 보답을 하겠소... "
"궁정 연금술사도 되어주고.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0080_Text
msgctxt "fc6bbe0a-627a-4ada-95aa-68e315914769"
msgid ""
"\"And I'll work for you, I will. Don't know that I'll be any good at court, "
"but you won't find a better alchemist in this neck of the woods. Just one "
"thing, though — I need a new hut! Someplace to keep all my bottles and "
"ingredients. A workshop, yes. As for me, don't you worry — I'll do my part.\""
msgstr ""
"\"그리고 나는 자네를 위해 일하겠소. 궁정에서 잘할 수 있을지는 모르겠지만 이 숲에서 나만한 연금술사를 찾을 수는 없지. 그리고 한가지 "
"더. 나는 새로운 오두만이 필요하오! 내 약병들과 재료들을 보관할 곳 말이야. 실험실 말이지. 오. 내 걱정은 하지마시오. 내 몫은 할 "
"테니.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0082_Text
msgctxt "33f88317-1ca2-4631-b074-93190d4deac4"
msgid ""
"\"Court alchemist, you say? Perhaps, perhaps... I'd have to think on it. "
"Bring me some fangberries like I asked, and we can talk about it more.\""
msgstr "\"궁정 연금술사 말이오? 좋다 이거요... 한번 생각해 보겠소. 내가 부탁했듯이 팽베리를 가져다주면 얘기를 해 보자고.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0087_Text
msgctxt "c5c059d6-f025-4689-b8aa-4693ae6fa53b"
msgid ""
"\"It is, yes. Let's take a look... A bit tattered, isn't it? Seen better "
"days, that's for sure... but it'll do just fine. Thank you!\""
msgstr "\"좋아. 어디 보자... 조금 너덜너덜한 거 같은데? 조금 질이 떨어지는군. 하지만 괜찮소. 고맙소!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0090_Text
msgctxt "ed74905d-90ec-49bb-900c-59d0a1d39707"
msgid ""
"\"Perfect! Hand it over, will you?... wait. I have this one! Well, this is "
"awkward.\""
msgstr "\"완벽해! 내게 넘겨주겠소? ... 잠깐, 이거 갖고있던 거잖아! 음. 이거 곤란하군.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0091_Text
msgctxt "a0c84b53-3470-447f-855a-0ae67937efc4"
msgid "{n}Bokken's eyes glisten.{/n} \"Just what I need!\""
msgstr "{n}보큰의 눈은 반짝입니다.{/n} \"내게 필요한 것이었소!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0092_Text
msgctxt "a33d3f87-21fe-4988-8dba-e8774885ac93"
msgid ""
"\"All three volumes! All that's left now is to read through them, assemble "
"all the necessary ingredients... but I can handle that myself. Thank you for "
"your help! I'll send word once I've found something.\""
msgstr ""
"\"3권 모두! 이제 남은 것은 책을 읽고 재료를 모으는 거요... 하지만 이건 내가 스스로 하지. 도와줘서 고맙소! 무언가 발견하면 "
"알려주도록 하겠소.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0094_Text
msgctxt "3ca8ebae-5fce-42ec-b1ed-22a62fca59ed"
msgid ""
"{n}Bokken squints and mumbles grumpily.{/n} \"So that's how it is now, is "
"it? Don't remember you complaining when I was looking for the potion's "
"formula... Eh, whatever. You were right. I learned my lesson. Won't go so "
"far ever again — be it potions or whatever else.\""
msgstr ""
"{n}보큰은 눈을 가늘게 뜨고는 툴툴거리며 투덜거립니다.{/n} \"그렇단 말이지? 내가 포션의 공식을 찾을 때 불평하던 건 기억이 나지 "
"않나 본데... 뭐 어쨌든. 당신이 옳았습니다. 나는 교훈을 얻었어요. 다시는 그렇게 막나가지 않겠습니다. 물약이든 뭐든 간에.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0095_Text
msgctxt "b2b11416-5aaf-4a30-9d56-9898199adf69"
msgid ""
"{n}Bokken puts his hands on his hips.{/n} \"Ha! Old Bokken still knows a few "
"tricks to impress these bloodsucking dummies! Enough hiding in the damn "
"bushes, I say!\""
msgstr ""
"{n}보큰은 그의 엉덩이에 양손을 댑니다.{/n} \"하! 이 늙은이가 여전히 멍청이들을 놀라게 할 수 있군. 숨기만 하는 것도 이젠 "
"끝이야!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0096_Text
msgctxt "5630a78d-f3e1-4bb6-86a0-06cb381210cf"
msgid ""
"\"Now it's time to get some rest. Come tomorrow if you want some potions. "
"I'll be right here!\""
msgstr "\"이제 좀 쉬어야 할 때가 됐소. 포션을 원하면 내일 나오시오. 나는 여기 있을테니!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Bokken/Cue_0097_Text
msgctxt "070c0e9b-239f-47fb-92a9-621a2c6fe669"
msgid ""
"\"Those spiders in the cave are mean. Here, let me give you some alchemichal "
"fire. Crafted it myself. Burn those spiders to a crisp! That will teach them "
"for taking over my fangberry cave!\""
msgstr ""
"\"동굴에 있는 거미 떼는 매우 성가시지. 내가 연금술사의 불을 몇 병 줄테니 그 거미들을 바싹 태워버리시오! 내 팽베리 동굴을 가로채면 "
"어떻게 되는지 본보기를 보여주시오!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Items/FangberryQuest_DescriptionText_String
msgctxt "2463f274-57d4-439e-8771-5bb3bfb8f992"
msgid "Small red berries resembling a raspberry."
msgstr "라즈베리를 닮은 작은 빨간 열매."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Items/FangberryQuest_DisplayNameText_String
msgctxt "b2c61bc5-1b7f-4c13-817a-efc056b7b86f"
msgid "Fangberries"
msgstr "팽베리"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Items/RadishQuest_DescriptionText_String
msgctxt "b2f2832a-9d74-47bb-b29f-429a7461329b"
msgid "A bunch of Moon Radish."
msgstr "달 무 한무더기."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Items/RadishQuest_DisplayNameText_String
msgctxt "6cc24e2d-ceaf-4cb9-bdaa-0229d48ce4d3"
msgid "Moon Radish"
msgstr "달 무"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Kressle/Answer_0004_Text
msgctxt "e219152f-4faf-4716-8919-12590f083ddc"
msgid "\"Irenna? Why the masquerade?\""
msgstr "\"이레나? 가장무도회라도 하는건가?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Kressle/Answer_0005_Text
msgctxt "71a0ea5c-4014-43ba-bfa9-b8e2f7d437cd"
msgid "\"I see you're settling in just fine.\""
msgstr "\"잘 적응하고 있나보네.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Kressle/Answer_0006_Text
msgctxt "f15db13d-2e91-4410-bfcb-33e400ea215e"
msgid "\"What happened to the rest of the Stag Lord's gang?\""
msgstr "\"수사슴 군주의 나머지 패거리들에게 무슨 일이 일어 났지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Kressle/Answer_0007_Text
msgctxt "55f4fb50-adfe-443a-92b2-db486a715d4a"
msgid "\"I have to go. Farewell.\""
msgstr "\"나는 가야 해. 안녕히!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Kressle/Cue_0001_Text
msgctxt "91b44d3d-caae-4a7a-a068-079e224a6ee5"
msgid ""
"{n}Kressle greets you with a grin.{/n} \"Hi there, stranger! I'm Irenna, "
"Svetlana's sister. I just arrived recently...\""
msgstr ""
"{n}크레슬은 당신에게 미소를 지으며 인사합니다.{/n} \"안녕. 이방인! 나는 이레나야, 스베틀라나의 여동생이야. 난 이제 막 "
"도착했어...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Kressle/Cue_0002_Text
msgctxt "0fc7281c-e5c9-4982-8929-06ed4c5d7c4a"
msgid "\"So, a bright day to you, and all the best...\""
msgstr "\"항상 좋은 날만 가득하길...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Kressle/Cue_0008_Text
msgctxt "99bc5339-1f29-4af4-a07e-15f394aa4f7f"
msgid ""
"\"It's just...\" {n}The former bandit shrugs and looks down.{/n} \"I want to "
"start a new life. To forget everything from before, even my old name.\""
msgstr ""
"\"난 그냥...\" {n}전 도적은 어깨를 으쓱하구 시선을 내립니다.{/n} \"새로운 삶을 시작하고 싶어. 이전의 모든 것을 "
"잊어버리려고해. 내 이름조차도.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Kressle/Cue_0009_Text
msgctxt "00162019-be12-4083-9e6c-bdd37a51334c"
msgid ""
"\"I won't be around here long. Just enough to help Svetlana with her work "
"around the post — I owe her that much. Then I'll be on my way. Still haven't "
"decided where to go, though.\""
msgstr ""
"\"나는 여기 오래 머물지 않을 거야. 스베틀라나를 도와 교역소 일을 하는 걸로 충분해. 그녀에게 빛을 많이 졌어. 그 후에 내 갈 길을 "
"가겠어. 아직 어디로 갈지 결정하지 못했지만.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Kressle/Cue_0010_Text
msgctxt "952df772-e719-411b-a833-07de420600d0"
msgid ""
"\"The remnants of the gang all scattered. I'd wager someone's already "
"announced himself as the new Stag Lord and got a knife in the liver from "
"some other wannabe heir...\""
msgstr "\"도적단의 잔류세력이 모두 흩어졌다. 어떤 녀석이 이미 자기를 새로운 수사슴 군주로 인정한 거 같군...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Kressle/Cue_0013_Text
msgctxt "dbbe4f4a-23ef-4dc6-87eb-59ecc23888d6"
msgid ""
"\"Right after the {d|c11 Akiros ally}battle{/d} in the Stag Lord's fortress, "
"Akiros just... dissolved, like morning fog. I heard him mumble something "
"about repaying old debts as he left. He's no fool — I'd guess he won't show "
"his face in {g|Stolen Lands}the Stolen Lands{/g} again. Too many people "
"recognize him for being the Stag Lord's right hand.\""
msgstr ""
"\"수사슴 군주의 요새에서 {d|c11 Akiros ally}전투{/d}가 벌어진 직후에 아키로스는... 아침 안개처럼 사라졌어. 나는 "
"그가 떠나면서 오래된 빚을 갚겠다고 중얼거리는 걸 들었지. 그는 바보가 아닌 이상 {g|Stolen Lands}도둑맞은 땅{/g}에서 "
"모습을 나타내지 않을 거야. 너무나 많은 사람들이 그가 수사슴 군주의 오른팔인 걸 알고있으니까.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Kressle/Cue_0014_Text
msgctxt "52dfbf97-49c5-400f-b4d6-6ddd61945ebe"
msgid ""
"\"There was a young trader got slaughtered recently on a nearby road. I'd "
"bet anything it was {d|c11 Dovan lives}Dovan's{/d} doing — I recognize his "
"style just from the description. If we're lucky, we won't hear any more from "
"the fellow. Otherwise, well... I, for one, intend to keep a sword at my side "
"during the day and a dagger under my pillow while I sleep.\""
msgstr ""
"\"최근에 근처의 길에서 젊은 상인이 도살당했다. {d|c11 Dovan lives}도반{/d}의 짓이 틀림없어. 설명을 듣자 하니 그의 "
"수법인 걸 알겠더군. 운이 좋다면 그 녀석의 소문은 더 이상 듣지 않을 거야. 그렇지 않으면... 항상 칼을 차고 다니고 베개 밑에 "
"단검을 넣어둬야겠지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/Kressle/Cue_0015_Text
msgctxt "01e97c27-b13f-4b26-948f-2a46ede531c7"
msgid ""
"\"As for Akiros, some investigators all the way from {g|Taldor}Taldor{/g} "
"came here after him. Said they've been trailing him for a long time. And he "
"just {d|c11 Akiros Surrendered}walked out{/d} to them, smiling like they "
"were best friends — said he was tired of running from the past. He just "
"turned himself in. Where they took him and what happened after — no clue.\""
msgstr ""
"\"아키로스와 관련하여 일부 조사원이 {g|Taldor} 탈도르{/g}에서부터 그를 따라왔어. 오랫동안 그를 뒤쫓아 왔다는데. 그 녀석은 "
"마치 그들의 친한 친구인 마냥 {d|c11 Akiros Surrendered} 순순히 걸어나왔다고 해. {/d} 과거로부터 도망치는 것이 "
"질렸다는군. 하지만 그들이 어디서 그를 잡았는지 무슨 일이 일어났는지 아무도 몰라.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Answer_0006_Text
msgctxt "94204bb3-f5c9-46e4-8f26-1232e8bce1ad"
msgid "\"Show me your wares, Oleg.\""
msgstr "\"파는 물건을 보여줘. 올렉.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Answer_0007_Text
msgctxt "26fb5e6a-83d0-4d9d-acf8-24fe7756d15e"
msgid ""
"\"I need to take care of the Stag Lord. Do you know of anything that could "
"help me find him?\""
msgstr "\"나는 수사슴 군주를 처리해야 해. 내가 그를 찾는데 도움이 될만한 것을 알고 있어?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Answer_0010_Text
msgctxt "f82e9daa-0f1a-4435-a01d-6e60b1acee5a"
msgid "\"What else can you tell me about the Stag Lord?\""
msgstr "\"수사슴 군주에 대해 나에게 무엇을 말해 줄 수 있어?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Answer_0015_Text
msgctxt "0e6bf794-21ec-4c2e-9c5a-e3f4745b86a3"
msgid ""
"\"Tell me about the Stag Lord's gang, and any other bandits operating in the "
"area.\""
msgstr "\"수사슴 군주의 무리와 그 지역에서 활동하는 다른 도적들에 대해 말해봐.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Answer_0019_Text
msgctxt "b3b15117-4faa-4e39-8b4d-2828412cb2dc"
msgid "\"We'll speak another time. Farewell!\""
msgstr "\"나중에 다시 이야기 해. 안녕히!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Answer_0020_Text
msgctxt "0ba09a7b-ce62-462c-80a1-596ca1de7702"
msgid ""
"\"The Stag Lord's gone. We found his fortress and sent the villain to "
"oblivion.\""
msgstr "\"수사슴 군주는 사라졌다. 우리는 요새를 발견하고 악당을 저 세상으로 보냈다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Answer_0023_Text
msgctxt "1b511061-be33-48ed-8de9-a90ded3dd1d3"
msgid "\"Restov awaits — I plan to set off right away.\""
msgstr "\"레스토프가 기다리고 있다. 나는 곧바로 갈 생각이야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Answer_0024_Text
msgctxt "16bfb718-5b48-42d0-8017-76a40cb7e304"
msgid "\"I still have some unfinished business here.\""
msgstr "\"아직 못다한 일이 있다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Answer_0026_Text
msgctxt "89a36b36-8dba-48dc-ba4e-7500d5cac039"
msgid ""
"\"Tell me about yourself. Why open a trading post in such a dangerous place?"
"\""
msgstr "\"너 자신에 대해 말해봐. 왜 위험한 곳에서 교역소를 연 거야?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Answer_0030_Text
msgctxt "9d95fc88-6e2e-4c02-9467-33f680f82f75"
msgid ""
"\"Tuskgutter is dead! You could mount his head on the wall as a trophy!\""
msgstr "\"터스크거터는 죽었어! 머리를 전리품 삼아 벽에 걸 수 있을거야!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Answer_0039_Text
msgctxt "786b9150-d4c6-4c17-a345-d106883a908a"
msgid "\"How are things going in the trading post?\""
msgstr "\"요즘 교역소는 어때?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Answer_0043_Text
msgctxt "3b35cb28-7704-4342-9b79-7491c52a75db"
msgid "\"Remind me: what is the problem with Tuskgutter?\""
msgstr "\"다시 말해줘. 터스크거터의 문제점이 뭐라고?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0001_Text
msgctxt "9531d44c-0295-447f-925e-82a0a94cc0d6"
msgid ""
"{n}Oleg greets you with a quick nod.{/n} \"So, the {d|c11 Evil Money}bandit-"
"breaker arrives.{/d}\""
msgstr ""
"{n}올렉은 당신에게 짧게 끄덕임으로 인사합니다.{/n} \"그래서 {d|c11 Evil Money} 도적 토벌대가 도착했군. {/d} "
"\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0002_Text
msgctxt "12a5bb30-332f-4706-8604-d5d50003bb82"
msgid ""
"\"Greetings!\" {n}Oleg seems to be in a good mood and greets you warmly.{/n} "
"\"You certainly ruffled those villains' feathers!\""
msgstr "\"안녕하십니까!\" {n}올렉은 기분 좋고 따뜻하게 인사합니다.{/n} \"악당들에게 한방 먹여주셨었죠!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0004_Text
msgctxt "1e155b99-9d96-47e9-888e-03525b630a82"
msgid ""
"\"Well, anyway, new day, new troubles. Have you seen the fog? Never seen "
"anything like it before. The road to {g|Restov}Restov{/g} looks like someone "
"spilled milk and it just hung in the air. I couldn't see anything through "
"that soup, not even with a torch! Feels like witchcraft to me. I'd bet the "
"Stag Lord's involved somehow. Rumors say he deals with all kinds of bad "
"magic.\""
msgstr ""
"\"어쨌든 새로운 날이 왔고 새로운 문제들도 생겼습니다. 안개 보셨어요? 이런 안개는 생전에 본 적이 "
"없는데,{g|Restov}레스토프{/g}로 가는 길에 누군가 우유를 쏟아 부어 허공에 뿌린 것만 같네요. 안개가 있어서 아무것도 보이지 "
"않고 횃불조차 보이지 않습니다! 마녀가 한 짓 같네요. 아마 수사슴 군주와 연관된 것이 아닐까 하는 생각이 듭니다. 소문에 그가 온갖 "
"나쁜 마법을 부린다고 하더군요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0008_Text
msgctxt "62e73c98-c7bd-44e2-b93f-75863705afab"
msgid ""
"\"You looking to pay for my wares with the same {d|c11 Evil Money}money{/d} "
"you took from me? Is that funny to you?\""
msgstr "\"제게서 가져간 {d|c11 Evil Money}돈{/d}으로 제 물건을 사겠다고요? 이게 웃기십니까?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0009_Text
msgctxt "27f8c807-b041-4485-986c-ff1917f63001"
msgid "\"Nothing's too good for such a good person!\""
msgstr "\"좋은 사람인 당신 만큼 좋은 물건은 없답니다!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0011_Text
msgctxt "6e472e77-9017-47dc-80f8-5610676d3eea"
msgid "\"Of course, Your {mf|Grace|Grace|Highness|Highness}! Take a look!\""
msgstr "\"물론입니다, 나리. 얼마든지 보시지요!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0012_Text
msgctxt "8d59c7bc-eb91-42db-b2c8-e4545ff5eca3"
msgid "\"A fine day to you! What brings you by?\""
msgstr "\"좋은 하루입니다! 무슨 일이십니까?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0013_Text
msgctxt "2cc4ddca-455e-4b98-8cff-042d9f449dd9"
msgid ""
"\"That's quite a task you've set yourself on. The Stag Lord has a fortress "
"somewhere in the area, but only a few chosen from the most trusted of his "
"rabble are ever invited. The location of the fortress is a heavily guarded "
"secret. And with this fog hanging around, I'd imagine it would be even "
"harder to find!\""
msgstr ""
"\"당신이 직접 한다고 하신겁니다? 이 지역 어딘가 수사슴 군주의 요새가 있지만 그의 수하들만 알고 있습니다. 우리 같은 보통 사람들은 "
"아무도 모르지요. 안개 때문에 더 찾기 어려우실 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0014_Text
msgctxt "d7622c58-efa7-4621-afa6-f9514df6f8cf"
msgid ""
"\"I suppose you could try to follow the trail of those bandits who attacked "
"{g|Oleg's Trading Post}the post{/g} before. They came from the southwest, "
"from the side of the {g|Thorn River}Thorn River{/g}. The fortress might be "
"there, or at least some large camp of theirs where you can find information."
"\""
msgstr ""
"\"전에 {g|Oleg's Trading Post} 교역소{/g}를 공격한 도적의 흔적을 따라가 보는건 어떠십니까? 그들은 남서쪽 {g|"
"Thorn River}가시 강{/g} 쪽에서 왔습니다. 분명 요새나, 최소한 큰 야영지가 있을 것이고 거기서 정보도 얻으실 수 있을지도 "
"모릅니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0016_Text
msgctxt "b39178dc-312a-4f42-ad3a-cd25fd42d17f"
msgid ""
"\"Not much. Not like I've sat down and shared a cup of wine with the man, "
"you know? But I think he arrived in {g|Stolen Lands}the Stolen Lands{/g} "
"less than a year ago, from what I've heard. But soon as he got here, he took "
"over everything. I wrote to {g|Restov}Restov{/g}, tried to warn them that "
"the Stag Lord wasn't some typical gang leader, but they didn't listen. The "
"rumors about him are horrible. He'll kill a person if they so much as "
"disagree with him. He never reveals his face. Those who've seen him up close "
"report the same thing — ugly scars cover every inch of his skin not covered "
"by his clothes.\""
msgstr ""
"\"많이 없습니다. 아시다시피 제가 그와 밥 한끼라도 한건 아니잖습니까? 그래도 제가 듣기로는 그는 {g|Stolen Lands}도둑맞은 "
"땅{/g}에 온지 1년도 안된거 같다더군요. 하지만 그가 여기 오자마자 모든 걸 지배하게 됐습니다. {g|Restov}레스토프{/g}에 "
"수사슴 왕이 보통 산적 두목이 아닌거 같다고 편지를 보냈지만 신경도 안쓰더라구요. 그에 대한 소문은 끔찍합니다. 자신에게 반하는 "
"사람이라면 닥치는대로 죽여왔지요. 그리고 절대 얼굴을 보이지 않는다고 합니다. 그를 가까이서 본 사람들은 하나같이 온 몸에 흉한 흉터가 "
"가득하다고 합디다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0017_Text
msgctxt "a85673ff-9e4b-49b4-a3ff-c93061173bec"
msgid ""
"\"The other gangs, if they're still here, try their best to keep a low "
"profile. As for the Stag Lord's men... Well, the most notable of them are "
"his three lieutenants. The oldest one's name is Akiros — he's from somewhere "
"around {g|Taldor}Taldor{/g}. He's fierce in a fight, but from what I hear, "
"he isn't cruel by nature. The other two are Dovan and Auchs — they're "
"usually seen together. Auchs is a mountain of a man with the mind of a five-"
"year-old — albeit a mean and bloodthirsty one. He's quite the fan of torture "
"and bloody executions. Dovan, though, that one's a snake in a man's body. I "
"hope to never meet him in the flesh — the rumors about him are more than "
"enough for me!\""
msgstr ""
"\"다른 도적들이 살아있었다면 아마 목숨이나 부지하고자 빌빌거리고 있었을겁니다. 수사슴 군주의 부하들에 관해서는... 가장 눈여겨 봐야 "
"할 녀석들은 세 명의 간부들입니다. 가장 나이가 많은 녀석은 {g|Taldor}탈도르{/g} 출신인 아키로스입니다. 그는 사나운 "
"싸움꾼이지만 제가 듣기로는 본성은 그리 잔인하지 않다고 하덥디다. 다른 두 녀석은 도반과 옥스입니다. 그 둘은 항상 붙어 다니지요. "
"옥스는 산적 출신으로 교활하고 잔인한 성격을 빼면 5살 어린아이와 다름없다고 합니다. 고문과 잔인한 처형을 좋아해요. 도반은 사람의 탈을 "
"쓴 뱀입니다. 되도록 그와 마주하지 않는 것이 좋다고 생각합니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0018_Text
msgctxt "190f456f-0944-4240-956b-fdc4be368f10"
msgid ""
"\"The Stag Lord's past is a mystery. He just... arrived one day. He was "
"immediately a power to be reckoned with. I guess the most surprising thing "
"about him is that he has as many followers who admire him as he has minions "
"who obey him out of fear. He's got some inner strength in him — or maybe an "
"inner madness. There are many who seem to follow him BECAUSE of that "
"madness, like it was some kind of virtue.\""
msgstr ""
"\"수사슴 군주의 과거를 아는 사람은 아무도 없습니다. 갑자기 어느 날 나타나서는 엄청난 힘으로 이 곳을 지배했지요. 놀라운건 그를 "
"두려워 하는 마음에 따르는 사람 만큼이나 그를 존경해서 따르는 이도 있다는 겁니다. 그가 가진 내면의 광기가 많은 이들에게 일종의 "
"매력처럼 느껴지는 듯 하더군요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0021_Text
msgctxt "013744ac-248b-4b52-9eac-02bbeba67624"
msgid ""
"{n}Oleg looks at you with respect bordering on admiration.{/n} \"And good "
"riddance! Maybe now we'll be able to actually LIVE in {g|Stolen Lands}the "
"Stolen Lands{/g}, rather than just surviving.\" {n}Oleg sighs.{/n} \"Without "
"a doubt, more people will flock here now. It'll surely boost trade, but all "
"the noise they'll bring with them... Well, that's none of your concern. I "
"bet you can't wait to return to {g|Restov}Restov{/g} and report your great "
"victory!\""
msgstr ""
"{n}올렉은 존경심을 가지고 당신을 쳐다 봅니다.{/n} \"잘됐군요! 아마 지금 이 순간부터, 우리는 {g|Stolen Lands}"
"도둑맞은 땅{/g}에서 살아남는 게 아니라, 제대로 거주할 수 있을 것 같습니다.\" {n}올렉은 한숨을 쉬었습니다.{/n} \"의심의 "
"여지 없이 더 많은 사람들이 이곳으로 모여들 겁니다. 분명 교역은 활성화 되겠지만, 사람이 많아지면서 생기는 온갖 시끄러운 소리들은... "
"뭐, 그건 나리가 걱정하실 문제는 아니지요. 나리께서는 {g|Restov}레스토프{/g}로 돌아가 승리를 보고하고 싶어 안달이 났을 "
"테니까요!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0025_Text
msgctxt "239186da-8330-4aa5-b902-30331bd17e8f"
msgid "\"As you wish!\""
msgstr "\"원하시는대로!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0027_Text
msgctxt "96d30fb4-76a3-45b4-94a6-fbcd6d45fb98"
msgid ""
"\"I just... dislike the noise,\" {n}Oleg answers reluctantly.{/n} \"I'm from "
"{g|Restov}Restov{/g}. Cities are... complicated. Lots of people, and each "
"with their place on the shelf — bow before this one, fear this other. Don't "
"do business with a third, but be sure to be extra nice to the fourth... And "
"villages are little better! Everyone likes to stick their noses into each "
"other's business. I just wanted a place where I could be my own master. And "
"so I ended up here.\""
msgstr ""
"\"저는 그저... 시끄러운게 싫었습니다.\" {n}올렉은 마지 못해 대답합니다.{/n} \"저는 {g|Restov}레스토프{/g} "
"출신입니다. 도시는... 복잡하지요. 사람도 많고. 누군가와 일이 잘풀리면 다른 사람과 싸움이 나기도 하고. 괜히 먼저 나서서 피 보지 "
"말라는 말도 있고... 이곳은 점점 좋아지고 있어요! 모두가 서로를 챙겨주니까요. 저는 그저 제가 잘할 수 있는 일이 있는 곳에 머무르고 "
"싶었습니다. 그래서 여기에 오게 된 거지요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0031_Text_1
msgctxt "dfcb6878-18c2-4f28-8c35-14fb9bb6d775"
msgid "\"Good day to you, Your {mf|Grace|Grace|Highness|Highness}.\""
msgstr "\"안녕하십니까. {mf|영주님|영주님|전하|전하}.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0032_Text
msgctxt "c0026810-f911-43b7-a725-bfe481c2f44a"
msgid ""
"{n}Oleg looks at the bloodstained boar's head with respect, touching its "
"tusk with his finger to test how sharp it is.{/n} \"That's one heck of a "
"beast! I'd love to have a trophy like that, but a deal is a deal. The head "
"goes to the old Benzen, and his bounty goes to you!\""
msgstr ""
"{n}올렉은 피 묻은 멧돼지의 머리를 존경심으로 바라보고 손가락으로 엄니를 만지며 얼마나 날카로운지 살핍니다.{/n} \"진짜 짐승 그 "
"자체군요! 저도 이런 전리품을 갖고 싶지만 거래는 거래니까요. 머리는 늙은 벤젠에게 가고 보수는 당신에게 갈 겁니다!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0033_Text
msgctxt "35b38f82-82b1-4b76-bae4-eae2ba81d149"
msgid ""
"\"Jhod mentioned that he needed to speak with you. You should see him before "
"you leave.\""
msgstr "\"조드가 당신과 얘기하고 싶어 하더군요. 떠나기 전에 한번 만나보시는게 어떠십니까.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0036_Text
msgctxt "041ffaa0-5137-406c-9097-7caf93045166"
msgid ""
"\"Just be sure you see Kesten before you go — he was eager to discuss "
"something with you.\""
msgstr "\"가기 전에 케스턴을 보고 가십시오. 당신과 얘기를 하고 싶어하는 거 같았습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0037_Text
msgctxt "8324e996-8a29-46f0-a438-9603000b5673"
msgid ""
"\"In the meantime, I'll gather some supplies for your journey. Come back "
"when you're ready.\""
msgstr "\"그동안 저는 당신을 위해 여행 보급품을 준비하겠습니다. 준비가 되면 다시 오십시오.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0038_Text
msgctxt "58f7cbf2-7add-4a8c-ae95-5d837e6a3d5b"
msgid ""
"\"The fog seems to be thinning, but we should wait until it burns off "
"completely. In the meantime, I'll gather some supplies for your journey to "
"make sure you can enjoy your trip back to {g|Restov}Restov{/g}!\""
msgstr ""
"\"안개가 옅어지는 것 같지만 완전히 사라질 때까지 기다려야 합니다. 그동안 저는 {g|Restov}레스토프{/g}까지 가실 때 필요할 "
"여행 물품을 꾸려 두겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0040_Text
msgctxt "e393ca12-9bb1-4c10-9c22-a6c752a6ea5e"
msgid ""
"{n}Oleg scratches his head.{/n} \"We're doing all right, I'd say. I could "
"even say we're doing pretty well, thanks to the wise {d|c21 Claim "
"OTP}decisions{/d} and protection of Your {mf|Grace|Grace|Highness|Highness}. "
"You know, you had me worried for a moment back in the capital. I almost "
"thought you were going to double our taxes, make a beggar of me...\""
msgstr ""
"{n}올렉이 머리를 긁습니다.{/n} \"다 괜찮다고나 할까요. {mf|영주님|영주님|전하|전하}의 현명한 {d|c21 Claim "
"OTP}결정들{/d}과 보호 덕분이라고 말하고 싶군요. 수도에서 뵈었을땐 잠시 걱정이 들긴 했습니다. 세금을 두배로 늘려서 나를 거지로 "
"만들 줄 알았어요..\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0041_Text
msgctxt "2511eb1f-4dc8-4d46-b9da-26a3842c9f50"
msgid ""
"{n}Oleg inhales loudly through clenched teeth.{/n} \"Why not ask again after "
"your soldiers come back to {d|c21 Capture OTP}collect{/d} more taxes? If "
"there's anyone left to answer, that is...\""
msgstr ""
"{n}올렉은 이빨 사이 구멍을 통해 큰 소리로 흡입합니다.{/n} \"병사들에게 더 많은 세금을 {d|c21 Capture OTP}"
"걷으라 {/d}명령한 후에 다시 물어 보십시오. 대답할 사람이 있다면, 그건...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0042_Text
msgctxt "3f198fd9-d2ee-48e8-9e7b-1718ab4dcb92"
msgid ""
"\"We're fine, I guess. Just, please try not to be too mad about our taxes, "
"Your {mf|Grace|Grace|Highness|Highness}. We {d|c21 Left OTP}send{/d} them to "
"{g|Restov}Restov{/g}, sure, but we still bring trade to your lands. We still "
"benefit you.\""
msgstr ""
"\"저희는 괜찮습니다. 아마도요. 세금 때문에 너무 괘념치 마시길. 우리의 세금은 {g|Restov}레스토프{/g}로 {d|c21 "
"Left OTP}가고 있지만,{/d} 아직 나리의 땅에서 장사를 하고 있습니다. 여전히 당신의 경제에 이바지하고 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0044_Text
msgctxt "c20f2dbf-7715-41ec-b620-4bf862526a84"
msgid ""
"\"It is a giant boar. A terrible beast — he has killed many hunters, and "
"maimed many more. Old Benzen has lost his leg to Tuskgutter, so he has put "
"up a bounty for the animal's head!\""
msgstr ""
"\"거대한 멧돼지입니다. 끔찍한 짐승이죠. 많은 사냥꾼과 많은 사람들이 그 녀석에게 죽었습니다. 늙은 벤젠이 터스크거터에게 다리를 잃어서 "
"그 동물의 머리에 현상금을 걸었습죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/OlegDialog/Cue_0045_Text
msgctxt "7fe8e6af-fd6b-45d0-a4d2-3bee83983cf1"
msgid ""
"\"Greetings!\" {n}Oleg welcomes you warmly, seemingly in a good mood.{/n} "
"\"You certainly ruffled those villains' feathers! I want to thank you — this "
"is for your efforts. Now, don't offend me by trying to turn it down — just "
"take it. An honest fight deserves an honest reward! If that were a more "
"common practice in this world, I think life would be so much better...\""
msgstr ""
"\"안녕하세요!\" {n}올렉은 좋은 분위기로 당신을 따뜻하게 환영합니다.{/n} \"확실히 그 악당들의 꽁무니를 걷어찼군요! 당신들에게 "
"감사하고 싶습니다. 그리고 이건 당신의 노력에 대한 보상입니다. 거절해서 저의 기분을 상하게 하지 말고 그냥 가져가십시오. 정직한 싸움은 "
"정직한 대가를 받을 자격이 있습니다. 그런 행동이 이 세상에서 더 일반적인 일이 된다면 훨씬 나은 세상이 될 거라고 생각합니다...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0004_Text
msgctxt "55578eff-bdc9-4662-b185-4676810cff82"
msgid "\"What did you want to ask me?\""
msgstr "\"나에게 물어보고 싶은게 뭐야?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0005_Text
msgctxt "198deaf4-dc05-4430-b972-deec3bdafedc"
msgid ""
"\"Tell me about yourself. How did you and your husband find the courage to "
"establish a trading post in the Stolen Lands?\""
msgstr "\"당신에 대해서 말해줄 수 있나? 당신과 남편이 빼앗긴 땅에서 교역소를 세운 이유는 뭐지?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0008_AlignmentShift.Description
msgctxt "9680d9a8-0498-4420-924e-f8d6454ea474"
msgid "Told Svetlana that you'll end lawless rule of the Stag Lord."
msgstr "스베틀라나에게 무법자의 지배를 끝내겠다고 말했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0008_Text
msgctxt "8132d427-b7b6-4404-9189-347f9aa44ccc"
msgid ""
"\"It would be a 'kingdom' of lawlessness. Once I've dealt with the Stag "
"Lord, your life will improve.\""
msgstr "\"그것은 무법의 '왕국'이 될 것이다. 일단 내가 수사슴 군주를 쓰러트리면 당신의 삶이 향상 될 것이다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0009_Text
msgctxt "6f69f355-36d2-4dcb-9cc5-4ee58d2fa00a"
msgid "\"I'll deal with the Stag Lord, have no doubt.\""
msgstr "\"내가 수사슴 군주를 막겠다. 의심의 여지가 없이.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0010_AlignmentShift.Description
msgctxt "eaf04597-cc3c-4b10-85c5-bc77165e1a98"
msgid "Told Svetlana that any rulership is based on fear."
msgstr "어떠한 통치든 두려움에 바탕을 두고 있다고 스베틀라나에게 말했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0010_Text
msgctxt "0119496a-57e4-4e28-8ca6-028de182b511"
msgid ""
"\"Fear always follows power. It would be naive to think the Stag Lord is so "
"much different from any other ruler.\""
msgstr "\"두려움은 항상 권력을 따르지. 수사슴 군주가 다른 통치자와 너무 다르다고 생각하는 것은 순진한거 아닌가.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0014_Text
msgctxt "d12ff746-b77b-4ea3-aab1-ad61130d5ab0"
msgid "\"I have to go. Farewell!\""
msgstr "\"가야겠다. 그럼 이만!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0018_Text
msgctxt "1504f51a-f352-489a-a23f-22138d54b8ac"
msgid "\"I'd be happy to help, Svetlana.\""
msgstr "\"기꺼이 도와주겠다. 스베틀라나.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0019_Text
msgctxt "13455505-3ce4-482a-9206-9ba9952013cc"
msgid ""
"\"I can't promise anything, but if I do come across your ring, I'll return "
"it to you.\""
msgstr "\"확언할 수는 없지만 만약 당신의 반지를 찾게된다면, 돌려주겠다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0020_Text
msgctxt "5efda179-75a4-4c4f-a052-38bb98c378cb"
msgid "\"I have more important things to worry about.\""
msgstr "\"더 중요한 일이 있다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0024_Text
msgctxt "24795323-5f29-430e-a6ad-3999053e95fe"
msgid ""
"\"Here's your ring, Svetlana. Kressle gave it to me — I even managed to "
"convince her not to fight me.\""
msgstr "\"여기 당신의 반지야, 스베틀라나. 크레슬이 내게 주었지. 게다가 그녀가 나와 싸우지 않게끔 어찌어찌 설득도 했어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0025_Text
msgctxt "f2d7764b-1dce-4295-8092-f165720b0c7c"
msgid ""
"\"I found your ring, Svetlana. Kressle, the bandit woman who had it, tried "
"to kill me and died in the fight.\""
msgstr "\"당신의 반지를 발견했다. 스베틀라나. 크레슬이 갖고 있던 건데, 날 죽이려 들더군. 그녀는 나와 싸우다 죽었다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0039_Text
msgctxt "ee750a00-c1bd-4ef5-bcd8-301e967a37d8"
msgid "\"What can you tell me about the Stag Lord?\""
msgstr "\"수사슴 군주에 대해 무언가 이야기 해 줄게 있나?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0041_Text
msgctxt "9ab4b576-a762-4d04-bb6b-bfb868e9166a"
msgid ""
"\"The Stag Lord is defeated, Svetlana. Soon, everything will change around "
"here.\""
msgstr "\"수사슴 군주는 패배했다. 스베틀라나. 곧 이 주변의 모든 것이 바뀔 거야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0043_Text
msgctxt "94586ac2-f1f0-47a0-965f-4c8cb20641ae"
msgid ""
"\"The Stag Lord is defeated, Svetlana. You should know that Kressle joined "
"me in fighting him... but she fell in battle.\""
msgstr ""
"\"수사슴 군주가 패배했다, 스베틀라나. 네가 알아야 할 게 있어. 크레슬이 함께 싸우기 위해 합류했지만... 그만 전투에서 전사했어.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0045_Text_1
msgctxt "dca54f6b-e28d-4641-b213-99188f9ea6fa"
msgid "\"How's life at the trading post these days?\""
msgstr "\"요즘 교역소 생활은 어때?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0050_AlignmentShift.Description
msgctxt "6ea826d5-658b-49a4-a8cd-540984691531"
msgid ""
"Told Svetlana that you like adventures that include defeating scoundrels."
msgstr "스베틀라나에게 당신이 모험과 동시에 악당들을 물리치는 걸 좋아한다고 말했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0050_Text
msgctxt "8dd16ca7-8953-4f99-8c62-9a8b15a5ed32"
msgid ""
"\"I like adventures, but I definitely prefer the ones that involve stopping "
"villains and helping people.\""
msgstr "\"나는 모험을 좋아하지만 확실히 악당들을 막고 사람들을 돕는 일을 더 선호하지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0051_AlignmentShift.Description
msgctxt "dd4d1384-bd97-4f1a-a948-7880a644185c"
msgid "Told Svetlana that you like being feared."
msgstr "스베틀라나에게 자신이 두려움을 불러일으키는 존재가 되고 싶다고 말했습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Answer_0051_Text
msgctxt "e7840a4b-b2ba-4a4c-bce6-3e068d54153e"
msgid ""
"\"In life, you either inspire fear or cower from it. I prefer to be the one "
"who's feared!\""
msgstr ""
"\"살면서 당신은 두려움에서 영감을 얻을 수도 혹은 그것으로부터 겁을 먹을 수도 있지. 나는 두려움을 주는 존재가 되는 것을 선호한다!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0002_Text
msgctxt "70f70f5c-a03c-48ca-a057-cb1914e2da57"
msgid ""
"\"Good day! I hope you're feeling all right after that battle. I can't thank "
"you enough for what you've done. I definitely don't want to waste your time, "
"but if you have a moment, I have a request...\""
msgstr ""
"\"좋은 하루에요! 당신이 그 전투가 끝난 후에도 괜찮았으면 좋겠어요. 저희를 도와준 것에 대해서 아무리 감사를 해도 부족할 지경이에요. "
"당신의 시간을 뺏고 싶지 않지만 묻고 싶은 게 있다면 언제든지 물어봐주시길...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0006_Text
msgctxt "7c9bc373-27c2-4a65-b0d5-ba45c3a699df"
msgid ""
"\"It was Oleg's idea, though I supported him in it. We didn't realize how "
"dangerous it was here, of course. In {g|Restov}Restov{/g}, everyone respects "
"the {g|Swordlords}Swordlords{/g}, and everyone's accustomed to relying on "
"them. Even the mention of someone like Lady Jamandi could be enough to fend "
"off a street thug or some other trouble. It could maybe even work in some "
"places here... but not with the Stag Lord's men.\""
msgstr ""
"\"올렉의 생각이었어요, 저도 동의했지만요. 우린 이곳이 얼마나 위험한 곳인지 모르고 있었거든요. {g|Restov}레스토프{/g}에서는 "
"모두가 {g|Swordlords}소드로드{/g}를 존경하고 그분들께 의지하는데 익숙해져 있어요. 자만디 님의 이름만 대도 거리의 폭력배 "
"같은 문제를 해결할 수 있을 정도로요. 이 근방도 대체로 그렇지만, 수사슴 군주의 부하들한테는 통하지 않았죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0011_Text
msgctxt "917e8141-d317-44c8-ac99-b90472ee9572"
msgid ""
"\"I can't thank you enough for the hope you've given me. But please, be "
"careful — the Stag Lord is extremely dangerous.\""
msgstr ""
"\"이미 당신에게 어떤 감사도 충분치 않을 만큼 큰 희망을 주셨지만, 수사슴 군주는 매우 위험합니다. 제발, 제발 조심하세요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0012_Text
msgctxt "e7770b04-6417-4f65-8979-699974e2f7db"
msgid ""
"{n}Svetlana lowers her head.{/n} \"You may be right. But life without hope "
"is just too bitter.\""
msgstr "{n}스베틀라나는 그녀의 머리를 떨굽니다.{/n} \"당신이 맞을지도 몰라요. 하지만 희망없는 삶은 너무 쓰네요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0013_Text
msgctxt "6b6ae291-c098-49a3-bdc0-048995a2efe4"
msgid ""
"{n}Svetlana lowers her head.{/n} \"This... is a very personal request, and "
"maybe not important enough for your time. I'll completely understand if you "
"say no. But the first time the Stag Lord's thugs came here demanding money, "
"they also took my wedding ring. Just tore it off my hand! It's just a "
"trinket, really, but it meant so much to me...\""
msgstr ""
"{n}스베틀라나는 고개를 떨굽니다.{/n} \"이건... 매우 개인적인 부탁이고 당신에게 별로 중요하지 않을 수도 있어요. 거절해도 "
"충분히 이해할 수 있어요. 하지만 수사슴 군주의 부하가 돈을 요구하기 시작한 첫날에 그들은 결혼 반지를 가져갔어요. 아예 제 손을 "
"잡아채서 빼갔다구요! 그냥 작은 반지지만 제게는 큰 의미가 있어서...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0015_Text
msgctxt "8dc8e99f-13ed-458e-b745-720ae07fe59f"
msgid ""
"{n}Svetlana greets you warmly.{/n} \"Good day to you! Do you need anything? "
"I'd be happy to help!\""
msgstr "{n}스베틀라나는 당신을 따뜻하게 맞이합니다.{/n} \"좋은 하루 되세요! 필요한 게 있으시나요? 기쁘게 도와드리겠습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0016_Text
msgctxt "ecbbdb5f-3887-4f98-8fa7-200acd7951de"
msgid ""
"\"I remember every moment of the day Oleg came to me, that ring in hand, to "
"ask if I'd marry him. I was standing in a fancy dress on the stairs of my "
"father's home, fearing that I'd misheard something, or that I'd say "
"something stupid and everyone around would laugh...\" {n}Svetlana interrupts "
"herself, shaking her head gently.{/n}"
msgstr ""
"\"올렉이 나에게 와서 결혼할 것인지 물어보기 위해 왔을 때를 전 기억해요. 저는 아버지의 집 계단에 멋진 의상을 입고 서 있었죠. 나는 "
"뭔가 잘못 들었을까 두려워했죠. 또 저는 바보 같은 말을 하고 주변의 모든 사람들은 웃었... \" {n}스베틀라나는 머리를 부드럽게 "
"흔들면서 정신을 차리려고 합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0021_Text
msgctxt "25d0114b-8338-434d-8674-dbbf29bff43c"
msgid "{n}Svetlana nods.{/n} \"I'm so, so grateful for your help!\""
msgstr "{n}스베틀라나는 고개를 끄덕입니다.{/n} \"당신의 도움에 감사드립니다!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0022_Text
msgctxt "38687751-2318-4e07-8439-2af3e1c3b737"
msgid "\"I understand. I appreciate any effort you put into it.\""
msgstr "\"이해해요. 제 이야기를 들어주신 것만으로도 감사합니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0023_Text
msgctxt "20d41599-73b6-4d70-9e61-81e1175739ce"
msgid "\"Of... of course. Forgive me for wasting your time...\""
msgstr "\"물론.... 시간을 빼앗아서 죄송합니다...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0026_Text_String
msgctxt "47473192-03b0-4e2f-8789-5a140f0d7bbe"
msgid ""
"{n}Svetlana sighs bitterly.{/n} \"I... suppose I should tell you the truth "
"about her... 'Kressle' wasn't her real name. Her real name was Irenna, "
"before all this. She was the daughter of my mother and her second husband — "
"my half-sister. I can't help but feel like everything that happened to her "
"was my fault. She always had a wildness to her — she'd wander the streets, "
"hanging out with a bad crowd. Until the day she passed, mother complained "
"about Irenna constantly... Back then, it was just cruel games and strange "
"escapades. She never really hurt anyone back in {g|Restov}Restov{/g}.\""
msgstr ""
"{n}스베틀라나는 씁쓸하게 한숨을 쉽니다.{/n} \"그녀에 대한 진실을 말해야 할 것 같아요... '크레슬'은 본명이 아니에요. 예전에 "
"그녀의 진짜 이름은 이레나였습니다. 그녀는 제 어머니와 두 번째 남편 사이에 난 딸, 그러니까 제 이복 여동생이었습니다. 나는 그녀에게 "
"일어난 모든 일이 제 잘못인 것처럼 느끼지 않을 수 없어요. 그 아이는 항상 제멋대로 거리를 방황하고 나쁜 사람과 어울렸죠. 어머니는 "
"돌아가시던 날까지 이레나에 대해 끊임없이 불평했어요. 그 당시에 그녀는 그저 괴롭히거나 장난만 칠 뿐이었어요. "
"{g|Restov}레스토프{/g}에서는 누군가를 다치게 한 적은 없었으니까요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0027_Text
msgctxt "146704fa-7f6e-45e9-aa51-06a70e230221"
msgid ""
"\"I don't know if there's any way to set her back on the right path, but I'm "
"grateful for your kindness. Perhaps there's still hope. For the sake of my "
"mother's memory, I'd like to believe that.\""
msgstr ""
"\"이레나를 올바른 길로 되돌릴 방법이 있는지 모르겠지만, 당신의 친절함에 감사드립니다. 아직 희망이 있을지도 모르죠. 어머니를 기리기 "
"위해서라도 그랬으면 해요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0028_Text
msgctxt "f1e836a9-9cab-4e4a-b518-fcd0166357ae"
msgid ""
"\"He's not just some average bandit. If no one puts a stop to him, he'll "
"turn {g|Stolen Lands}the Stolen Lands{/g} into his personal kingdom — a "
"kingdom of fear and oppression.\""
msgstr ""
"\"평범한 도적은 아니에요. 그자를 막지 못하면 {g|Stolen Lands}도둑맞은 땅{/g}은 공포와 압제의 왕국으로 바뀌겠죠. \""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0034_Text_String
msgctxt "f841197d-5bfd-4c29-9c60-2851669913ea"
msgid ""
"\"Her father didn't live much longer than our mother, so I decided to try to "
"help Irenna. I brought her here, to {g|Stolen Lands}the Stolen Lands{/g}, "
"though Oleg was against it. And once here, she immediately fell under the "
"Stag Lord's influence. She never even needed to meet him — the stories and "
"rumors from local hunters and bandits were enough to win her over. She would "
"tell us how he was a real leader, unlike {g|Restov}Restov's{/g} 'softies.' "
"Eventually, she ran away, only to return under a new name with a pack of "
"thugs to 'collect taxes' from us. What's worse, she participated in the "
"torture and execution of prisoners alongside the Stag Lord's minions.\""
msgstr ""
"\"이레나의 아버지는 제 어머니보다 일찍 돌아가셨어요. 돕고 싶은 마음에, 올렉의 반대에도 이레나를 이곳, {g|Stolen Lands}"
"도둑맞은 땅{/g}으로 데려왔죠. 그런데 이곳에 오자마자, 이레나가 수사슴 군주의 부하로 들어가 버린 거예요. 수사슴 군주를 본 적도 "
"없는 아이가, 사냥꾼과 산적이 하는 우스갯소리를 진지하게 받아들인 거죠. 그 아이는 이렇게 말했어요. 수사슴 군주는 "
"{g|Restov}레스토프{/g} 겁쟁이들과는 달리 진정한 지도자의 재목이라고. 결국 우리 품에서 도망쳐버렸어요. 그리고는 수사슴 군주의 "
"이름으로 우리에게 세금을 징수하겠다고 깡패 무리와 함께 돌아왔지요. 더 심한 건, 이레나가 수사슴 군주의 부하들처럼 죄수를 고문하고 "
"처형했다는 거예요.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0035_Text
msgctxt "ac6296d4-1c28-4327-8fde-d6b38ee9f689"
msgid ""
"\"And now, meeting such an end... I realize you did what you had to. Perhaps "
"it's all for the best... but still, I wonder if everything could have turned "
"out differently...\" {n}Svetlana lifts her head.{/n} \"Thank you for "
"returning my ring to me. I truly appreciate it. Now, if you don't mind, I "
"think I'd like to be alone for a little while...\""
msgstr ""
"\"그런 끝을 맞이 한 후 저는 당신이 해야 할 일을 했다는 것을 깨달았죠. 아마도 그게 최선이겠죠. 하지만 여전히 모든 것이 달라질 수 "
"있었는지 궁금해요...\" {n}스베틀라나가 머리를 들어 올립니다.{/n} \"제 반지를 돌려 주셔서 감사합니다. 진심으로 감사드립니다. "
"음, 괜찮으시다면 잠시 혼자 있고 싶네요...\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0037_Text
msgctxt "69518a1e-1c6e-4613-b89b-15290d888900"
msgid ""
"{n}Svetlana sighs, examining a fancy bottle made of iridescent glass.{/n} \"A"
" gift from Bokken. I'll {d|c11 Bokken Dead}miss{/d} that old crank. I still "
"expect to hear him muttering from behind the fence, or see him pop in the "
"door holding a fresh-dug root to his chest like some great treasure. May the "
"gods have mercy on him.\" {n}A bitter smile touches her lips.{/n} \"Let's "
"talk about other matters. I do have something to ask, if you have time...\""
msgstr ""
"{n}스베틀라나는 한숨을 쉬며 무지개 빛깔의 유리로 만든 화려한 병을 검사합니다.{/n} \"보큰의 선물이에요. 그 노인이 {d|c11 "
"Bokken Dead} 그리워요...{/d} 아직도 그가 울타리 뒤에서 속삭이거나 어느 날 문을 열고 약초 뿌리를 보물처럼 안고 나타날 "
"거 같아요. 신이 그에게 자비를 베풀길.\" {n}쓴 미소가 그녀의 입술에 나타납니다.{/n} \"다른 문제에 관해 이야기해 봅시다. "
"시간이 있다면... 물어볼 게 있습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0038_Text
msgctxt "a93c1b66-ec80-487b-ace3-df9b87cdecc5"
msgid ""
"\"If you happen to find my ring among the bandits' possessions, please bring "
"it back to me. It's easy to recognize — my name is engraved inside the band."
"\" {n}Svetlana drops her eyes, lowering her voice.{/n} \"There is... one "
"more thing. Among the bandits, there's a dark-haired woman who wields dual "
"axes. She's not bad in a fight — in fact, she can be extremely dangerous. "
"And cruel. But please, I beg you — show her mercy, if you have the chance.\""
msgstr ""
"\"도적들이 지닌 물건 중에서 제 반지를 발견하면 부디 가져다주세요. 반지 안쪽에 제 이름이 새겨져 있으니 쉽게 알아볼 수 있을 거예요."
"\" {n}스베틀라나는 시선을 떨구고 목소리를 낮춥니다.{/n} \"한 가지만 더 부탁이 있어요. 산적 중에 양손에 도끼를 든 검은 머리 "
"여자가 있습니다. 그녀는 약하지 않아요. 아니. 오히려 매우 위험하고 잔인하죠. 하지만 제발. 기회가 된다면 그녀에게 자비를 보여주세요."
"\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0040_Text
msgctxt "c632a7ae-62d0-4ef4-a077-a2d93bd3fe70"
msgid ""
"\"Now that his rule has ended, I think everything will change for the "
"better. I truly believe that.\""
msgstr "\"이제 그의 통치가 끝났으므로 모든 것이 더 잘 될거라고 믿어요. \""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0042_Text
msgctxt "635a1282-1be7-4108-88ca-9200efdfec75"
msgid ""
"{n}Svetlana sighs.{/n} \"It seems like I've completely forgotten how to hope "
"for the better. But my heart already belongs to these wild lands... Perhaps, "
"in time, they'll grow into a peaceful and prosperous country.\""
msgstr ""
"{n}스베틀라나는 한숨을 쉽니다.{/n} \"저는 더 나은 것을 바랄 수 있는 방법을 완전히 잊어 버린 것 같지만 제 마음은 이미 이곳을 "
"선택했어요. 여기도 아마도 시간이 흐르면 평화롭고 번영하는 나라로 자라겠죠.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0044_Text
msgctxt "c7faf28f-10bc-4aa4-8ce1-0a6bcd43f28e"
msgid ""
"{n}Svetlana is silent a moment as she wrings her hands.{/n} \"Such bitter {d|"
"c11 StagLord Duel}news{/d}... At least she died fighting for a good cause. "
"Our mother wouldn't have been able to bear the thought of her youngest "
"daughter killing and robbing innocent people. Maybe it's wrong, but I feel a "
"bit relieved now. Thank you for sharing the truth with me. And for getting "
"rid of the Stag Lord, of course.\""
msgstr ""
"{n}스베틀라나는 잠깐 침묵을 지키고 있습니다.{/n} \"그런 가슴아픈 {d|c11 StagLord Duel}소식{/d}을...적어도 "
"그녀는 좋은 이유로 싸우다 사망한 거네요. 저희 어머니는 막내 딸이 무고한 사람들을 죽이고 도둑질을 한다는 생각을 견디지 못했을 "
"것입니다. 어쩌면 틀렸을 지 모르지만 조금은 안심이 됩니다. 진실을 저에게 알려주셔서 감사합니다. 그리고 수사슴 군주를 없애주는 것도요. "
"\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0046_Text
msgctxt "fd8cedb7-f4a7-4334-b8ec-e1824081a194"
msgid ""
"\"Much better than it was under the Stag Lord! I'm not sure what we would "
"have done if not for you and your wise decisions, Your "
"{mf|Grace|Grace|Highness|Highness}. My husband is a reserved man, unlikely "
"to express his true feelings, so I'd like to express my sincere gratitude on "
"behalf of us both!\""
msgstr ""
"\"수사슴 군주의 통치하에 있던 때 보다 훨씬 좋아요! 당신의 현명한 결정이 없었다면 우린 어떻게 했을지 모르겠어요. 남편은 내성적인 "
"사람이어서 진심을 표현하지 못할 것 같으니 우리 둘을 대신해서 진심으로 감사를 표하고 싶어요!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0048_Text
msgctxt "b09f22d5-c798-4bcf-a5c0-021729cf4688"
msgid ""
"{n}Svetlana sighs.{/n} \"We're doing better than if we were still struggling "
"under the Stag Lord's reign, of course, but... You have to understand, Your "
"{mf|Grace|Grace|Highness|Highness}, between the doubled taxes and your {d|"
"c21 Capture OTP}dispute{/d} with the Aldori... It's hard for us to relax.\""
msgstr ""
"{n}스베틀라나는 한숨을 쉽니다.{/n} \"우리는 수사슴 군주의 통치 하에 있는 것 보단 훨씬 잘하고 계시다는 걸 알고 있지만... "
"이해해주세요. 두 배의 세금을 내고 당신이 알도리 님과 {d|c21 Capture OTP}분쟁{/d}을 하니... 저흰 긴장을 풀기가 "
"어려습니다. \""

#. Mechanics/Blueprints/World/Dialogs/c11/OTP_normal_state/SvetlanaDialog/Cue_0049_Text
msgctxt "e3aa5f6a-61e5-466b-96ff-c59c7a3306eb"
msgid ""
"{n}Svetlana gives you a slight bow.{/n} \"Greetings, Your "
"{mf|Grace|Grace|Highness|Highness}!\""
msgstr "{n}스베틀라나는 당신에게 살짝 고개를 숙여 인사합니다.{/n} \"안녕하세요. {mf|영주님|영주님|전하|전하}!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/Barks/LoreBark1_String
msgctxt "a0fb3c61-3b43-4e3d-b98c-5e3d195999b3"
msgid ""
"Judging by the outline, this bas-relief once depicted the sun and moon. Now "
"it's almost completely eroded."
msgstr "겉으로 보기에 이 물건은 태양과 달을 묘사한 것 같습니다. 지금은 완전히 침식되었습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/Barks/LoreBark2_String
msgctxt "3568a88c-5752-4293-b12d-20f44cbecb9f"
msgid ""
"A bas-relief of the sun, long eroded. The vague outlines of four strange "
"creatures have been carved over it."
msgstr "태양의 모습으로 만들어졌지만 오랫동안 부식되었습니다. 흐릿한 윤곽이 4개의 괴물을 조각했음을 알 수 있습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/Barks/LoreBark3_String
msgctxt "04fec1b6-7789-4372-8fd7-49139f7dd268"
msgid ""
"On closer inspection, one can discern the outline of a head with a single "
"eye."
msgstr "더 자세히 살펴보니 한 괴물은 눈알이 한개인 머리임을 알 수 있습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/Barks/LoreBark4_String
msgctxt "d53867cc-92bd-4635-8b59-2fe35f29ffae"
msgid ""
"The image carved in the stone has almost completely worn away over the ages. "
"One can still distinguish a sickle, a sword, and a skull with a single eye "
"socket, covered with a coin."
msgstr ""
"돌에 새겨져있는 이미지는 세월에 의해 거의 완전히 사라졌습니다. 간신히 낫, 칼, 눈알 구멍이 한개인 두개골이 새겨진 동전임을 알 수 "
"있습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/Barks/LoreBark5_String
msgctxt "ca841a01-f277-4ef4-b6d0-727cad92b332"
msgid ""
"It seemed from afar to be but cracks in the stone, but turns out to be a "
"faded image of the sun. A grinning jackal's skull has recently been "
"scratched on top of the image."
msgstr ""
"멀리서 보기에는 돌의 균열 같았지만 사실 바래버린 태양의 모습이었습니다. 웃고있는 자칼의 두개골이 이미지 위에 새로 새겨졌습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/Barks/MercenaryBark1_String
msgctxt "f2681631-ff95-4c1d-96d5-e5b64c1fa5b3"
msgid "\"Here's our target!\""
msgstr "\"여기에 우리의 목표가있다!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/Barks/MercenaryBark2_String
msgctxt "ef4ae484-19d8-4f49-b51b-00aa3ed1772f"
msgid "\"To arms!\""
msgstr "\"전투 준비!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/Barks/MercenaryBark3_String
msgctxt "71bc1553-75ee-4e29-b6b9-0de9d606bbec"
msgid "\"Tartuccio greets you, {name}!\""
msgstr "\"타투치오가 너를 반긴다. {name}!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Answer_0011_Text
msgctxt "8cf43caf-b39f-41cc-b303-9fa708502e17"
msgid ""
"\"Don't you have some other pressing business to attend? Perhaps Jamandi's "
"quest — the search for the Stag Lord?\""
msgstr "\"더 급한 임무가 있었던 거 같은데? 수사슴 군주를 찾으라는 임무라던가.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Answer_0012_Text
msgctxt "86c1cce9-731c-4dfd-891f-e0fc27415502"
msgid ""
"\"Get to the point, Tartuccio. I know you're looking for an artifact — and "
"you're planning to use it against me.\""
msgstr "\"본론으로 들어가지. 타투치오. 나는 네가 유물을 찾고 있다는 것을 알고 있어. 그걸 나에게 사용하려는 것도 알고 있지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Answer_0013_Text
msgctxt "ecf60ac0-c26d-4d54-9943-146f359137ba"
msgid ""
"[Attack] \"A barony cannot have two lords. You'll just have to... disappear!"
"\""
msgstr "[공격] \"한 영지에 두 남작이 있을 수는 없지. 너는... 사라져줘야겠어!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Answer_0017_Text
msgctxt "4d330d43-9582-4f82-ab9b-0fe7e21e7426"
msgid ""
"\"Linzi, don't you think it's the perfect time to throw away that silly "
"draft and start a real book? You already have a great protagonist — me!\""
msgstr "\"린지. 지금까지 쓰던 멍청한 연대기는 버리고 새로운 걸 쓰는 게 어때? 여기 훌륭한 주인공이 있어. 나 말이야!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Answer_0018_Text
msgctxt "be32b49c-2193-4c0f-b2f3-dee4eace0192"
msgid ""
"\"Valerie, I would say you and your sword can find greater glory than in "
"service to Tartuccio. He summoned you to fight the Stag Lord's bandits, but "
"now uses you for more questionable dealings.\""
msgstr ""
"\"발레리. 난 네가 타투치오를 섬기는 것 보다 더 큰 영광을 구할 수 있을거라고 생각해. 그는 수사슴 군주와 싸우려 너를 불렀지만 "
"이제는 의심스러운 거래에 너를 이용하려 하지.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Answer_0019_Text
msgctxt "83bdc846-9661-4224-ac57-31017b5cbb83"
msgid ""
"\"Jaethal, isn't Tartuccio's arrogance long past what you can suffer? I can "
"find far better use for a companion such as you.\""
msgstr "\"제이탈. 타투치오의 오만함은 이미 진절머리나지 않았어? 너 같은 동료라면 내가 더 잘 대해줄 수 있는데 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Answer_0020_Text
msgctxt "07ec2903-74f7-4b1f-ab73-046028907ad3"
msgid ""
"\"Harrim, I would be happy to see you among my companions. Your faith does "
"not oblige you to follow fools and liars like Tartuccio.\""
msgstr "\"하림. 네가 내 동료라면 좋겠어. 너의 믿음은 타투치오 같은 거짓말쟁이를 따르라고 가르치진 않잖아.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0001_Text
#. Speaker : Tartuccio_OldCyclopsTomb
msgctxt "2ddcec51-b57d-4388-89df-b3089c4379ab"
msgid ""
"{n}A gnome in gaudy purple garb seizes your attention. Of course — the "
"scoundrel Tartuccio, who you know from your time in {g|Restov}Restov{/g}. "
"The vile gnome is standing on a small hill, expressing his discontentment in "
"every way he can muster.{/n}"
msgstr ""
"{n}화려한 보라색 옷을 입은 노움이 당신의 관심을 사로 잡습니다. 물론 {g|Restov}레스토프{/g}에서 보았던 악명 높은 "
"타투치오입니다. 사악한 노움은 작은 언덕에 서서 할 수 있는 모든 방법으로 자신의 불만을 표현합니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0002_Text
#. Speaker : Tartuccio_OldCyclopsTomb
msgctxt "4042d6d2-53b8-455f-bc95-e2a8c5c5e4dd"
msgid ""
"\"Let me guess — you're still dawdling?\" {n}Tartuccio scoffs at his "
"underlings, unimpressed.{/n} \"Should I make some tea in the meantime? Bake "
"a pie, perhaps? Plant a small garden and harvest some cherries? Perhaps "
"you'd be more comfortable wearing fools' caps and colored trousers? Then at "
"least I'd be able to sell tickets. Come one, come all! Feast your eyes upon —"
" \"The Slowest and Most Ridiculous Buffoons on {g|Golarion}Golarion{/g}!\""
msgstr ""
"\"어디 보자. 너 아직 고민하고 있지?\" {n}타투치오가 비웃습니다.{/n}\"그 동안 차를 좀 만들어야 할까? 파이를 굽거나 작은 "
"정원을 심고 체리 좀 수확할까? 광대 옷을 입어 보는 게 어때? 그러면 내가 티켓을 팔아줄 수 있어. '어서 옵쇼! "
"{g|Golarion}골라리온{/g}에서 가장 멍청한 느림보를 보러 오십쇼!'라고 말이야.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0005_Text
#. Speaker : Harrim_Neutral
msgctxt "8b6acd5d-d8a6-424b-b714-c50d52ab815c"
msgid "\"Why hurry? The same end awaits us all.\""
msgstr "\"뭘 그렇게 서두르는가? 어차피 같은 결말이 우릴 기다리고 있네.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0006_Text
#. Speaker : Valerie_Neutral
msgctxt "88f5c781-d80c-4362-ab97-ca5cfaebc8cc"
msgid ""
"\"Sir Tartuccio, I may serve you, but I am no one's slave. We do what we "
"can, but it is no simple feat to find an unknown object in a vast dungeon.\""
msgstr ""
"\"타투치오. 저는 당신을 따르고 있지만 당신의 노예는 아닙니다. 최선을 다하겠지만 이 넓은 지하 던전에서 알 수 없는 물건을 찾는 일은 "
"간단한 게 아닙니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0007_Text
#. Speaker : Linzi_Neutral
msgctxt "18b7c280-7340-4252-a398-61b570c92a5b"
msgid ""
"\"Achoo! Digging through a dusty dungeon, searching for I-don't-know-what. "
"And all this frowning! Scold, scold, scold. This is not how I imagined "
"adventures with the future baron! What am I ever going write my book about? "
"How we labored to open a chest filled with dust?\""
msgstr ""
"\"에취! 알지도 못하는 물건을 찾으려고 내가 먼지투성이 지하 던전을 파야겠어요? 그리고 계속 짜증이나 내고 말이에요! 이건 내가 "
"상상하던 미래의 남작과의 모험이 아니라구요! 아니, 책에 대체 무슨 내용을 써야 돼? 먼지 범벅이 된 상자를 열려고 얼마나 노력했는지에 "
"대해 써야 하나?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0008_Text
#. Speaker : Jaethal_Neutral
msgctxt "d13b8eb8-55da-427a-9503-8ea65bcb6ced"
msgid ""
"{n}Jaethal stares Tartuccio down.{/n} \"Hold your tongue, gnome. I can "
"hardly tell your twaddle from the buzzing of a fly.\""
msgstr "{n}제이탈은 타투치오를 내려다봅니다.{/n} \"입조심해라. 노움. 네 파리처럼 왱왱거리는 말소리는 참 들어주기 힘들군.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0009_Text
#. Speaker : Tartuccio_OldCyclopsTomb
msgctxt "c42bccb4-6460-4b01-a8e0-d0adafa5de39"
msgid ""
"\"Quickly now. If we don't find that artifact soon, someone else might seize "
"it. Someone... who's standing over there watching you right now, you fools!\""
" {n}Tartuccio turns his angry gaze upon you. He nods to his guards to draw "
"their weapons.{/n}"
msgstr ""
"\"빨리. 만약 우리가 그 유물을 곧 발견하지 못한다면 다른 녀석이 가로챌 거야... 벌써 누가 왔잖아! 이 멍청이들!\" {n}"
"타투치오는 화가 나서 당신을 봅니다. 그는 자신의 용병들에게 눈짓을 해서 무기를 뽑으라는 신호를 보냅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0014_Text
#. Speaker : Tartuccio_OldCyclopsTomb
msgctxt "a186cbc4-35b5-4aff-9775-e172d277ffd3"
msgid ""
"\"I might ask you the very same! Aren't you supposed to be searching the "
"local forest for some bandit boss in a horned hat?\""
msgstr "\"그 질문 똑같이 되돌려 주지! 너야말로 그 뿔 달린 도적 두목을 찾아 숲 속을 뒤지고 있어야 하는거 아냐?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0015_Text
#. Speaker : Tartuccio_OldCyclopsTomb
msgctxt "63a4c88e-a918-4d3b-92d3-ffc6202b8678"
msgid ""
"\"Looks like someone's grown fond of an imaginary crown... Over here, you "
"fools — front and center! Cover my retreat!\""
msgstr "\"누군가 내 몫을 노리려나보군... 어이! 멍청이들! 쟤네를 막아! 난 작전상 후퇴할테니 엄호하고!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0016_Text
#. Speaker : Tartuccio_OldCyclopsTomb
msgctxt "3efe3c4c-4e15-42cd-b203-5e7dee7867d9"
msgid ""
"{n}The gnome grins.{/n} \"What ever did I do to deserve someone like you?! "
"Here, you fools, drop your shovels — we're leaving! The rest of you — cover "
"my retreat!\""
msgstr ""
"{n}노움은 웃습니다.{/n} \"너희 같은 녀석들을 내가 한두번 만난 줄 알아?! 이봐. 삽은 내버려둬. 우리는 떠날 거야! 나머지 "
"너희는 뒤처리를 해!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0022_Text
#. Speaker : Linzi_Neutral
msgctxt "21632622-182b-44f9-8565-5ab983f2f4da"
msgid ""
"{n}The little bard jumps for joy.{/n} \"Yes! I shall overturn a new leaf! "
"And on that leaf I shall pen a wonderful, thrilling story — of the victory "
"of the future baron{mf||ess}! And the bitter defeat of {mf|his|her} "
"malevolent, flatulent rival!\" {n}Linzi sticks her tongue out at "
"Tartuccio.{/n}"
msgstr ""
"{n}작은 바드는 기뻐서 폴짝폴짝 뛰어오릅니다.{/n} \"야호! 새로운 장이 시작되겠네요! 이번 장은 스릴 넘치고 신나는 이야기가 될 "
"거예요! 성질 고약하고 허풍만 가득한 라이벌은 패배하고, 미래의 남작님이 영광스러운 승리를 거두는 이야기가 될 테니까요!\" {n}린지는 "
"타투치오에게 혀를 내밀었습니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0023_Text
#. Speaker : Linzi_Neutral
msgctxt "b489eae1-d5cd-47b1-bec2-c410b318b96b"
msgid ""
"{n}Linzi frowns.{/n} \"Why do you say my story is silly?! You haven't even "
"read it. Ach, a critic is born every minute. Why should I help you anyway?\""
msgstr ""
"{n}린지는 얼굴을 찡그립니다.{/n} \"왜 제 이야기가 우습다고 하시는 거죠?! 아직 읽어보지도 않았잖아요. 참나, 다들 비평가 저리 "
"가라네. 그래서, 당신을 도와야 하는 이유가 뭐라구요?\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0025_Text
#. Speaker : Valerie_Neutral
msgctxt "d0875d09-14aa-4831-a97e-1da2319c2210"
msgid ""
"{n}Valerie folds her arms across her chest.{/n} \"You're right. Tartuccio "
"has deceived us. A warrior who bows to a lie, who humiliates herself — there "
"is no glory in this. I shall aid this scoundrel no more.\""
msgstr ""
"{n}발레리는 팔짱을 낍니다.{/n} \"당신이 맞습니다. 타투치오가 우리를 속였습니다. 거짓에 고개를 숙이는 자는 수치스럽고 "
"불명예스럽습니다. 나는 이 악당을 더 이상 돕지 않을 것입니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0026_Text
#. Speaker : Valerie_Neutral
msgctxt "509d6d36-b017-40c0-a6d2-46cfc52bd6d3"
msgid ""
"{n}Valerie looks unconvinced.{/n} \"There is truth in what you say, but a "
"warrior cannot leave her commander on the easy words of a stranger.\""
msgstr ""
"{n}발레리는 확신하지 못합니다.{/n} \"당신이 하는 말은 일리가 있지만 전사는 타인의 말에 쉬이 자신의 상관을 떠나지 않습니다.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0028_Text
#. Speaker : Jaethal_Neutral
msgctxt "ca496de5-b2d1-433d-ab84-b25e587866a4"
msgid ""
"{n}The elf looks at you for a brief moment, then nods silently. She draws "
"her weapon and eyes Tartuccio coldly.{/n}"
msgstr "{n}엘프는 잠시 당신을 보고 조용히 끄덕입니다. 그녀는 무기를 뽑고 타투치오를 차갑게 쳐다봅니다.{/n}"

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0029_Text
#. Speaker : Jaethal_Neutral
msgctxt "5b37cc1e-27b5-4a91-984f-b2d4f8b0c8fd"
msgid ""
"{n}The elf allows herself a faint smile, unkind and frightening.{/n} "
"\"Flattery cannot buy me, {race}.\""
msgstr "{n}엘프는 희미하지만 오싹하고 불친절한 미소를 짓습니다.{/n} \"아첨으로 나를 사지 못한다. {race}.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0031_Text
#. Speaker : Harrim_Neutral
msgctxt "1ea936c2-6fd0-4645-b07f-40b2bca8c475"
msgid ""
"{n}Harrim strokes his beard, brooding.{/n} \"There is as much vanity in your "
"words, as in the words of all who have not seen the wisdom of "
"{g|Groetus}Groetus{/g}. Yet you seem a worthier leader than the arrogant "
"Tartuccio. Perhaps in serving you I shall open your eyes to the teachings of "
"my faith.\""
msgstr ""
"{n}하림은 웃으며 수염을 쓰다듬습니다.{/n} \"자네 말은 {g|Groetus}그로투스{/g}의 지혜를 보지 못한 것처럼 허영으로 차 "
"있구만. 하지만 자네는 오만한 타투치오보다 더 가치있는 지도자처럼 보여. 자네와 함께 다니면서 자네에게 신앙이 무엇인지 내 직접 가르쳐 "
"주겠네.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0032_Text
#. Speaker : Harrim_Neutral
msgctxt "367bf794-a4b0-41cd-ab5f-0ecc134cb42d"
msgid ""
"{n}Harrim pensively twists the strands of his beard between his fingers.{/n} "
"\"Side with you? I cannot say if there be sense in that. I am satisfied in "
"serving Tartuccio, as much as anyone else. {g|Groetus}Groetus's{/g} peace "
"awaits us all, in the end.\""
msgstr ""
"{n}하림은 손가락으로 수염을 비틀고 꼬읍니다.{/n} \"자네 편으로? 그 말이 일리가 있는지 모르겠네. 나는 타투치오를 섬기는 것에 "
"만족하네. 결국 {g|Groetus}그로투스{/g}의 뜻은 우리 모두에게 찾아오겠지만.\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldCyclopsTomb/TartuccioAndCompanions/Cue_0033_Text
#. Speaker : Tartuccio_OldCyclopsTomb
msgctxt "4b2e078b-36ea-4f5a-8175-51da668cbc1b"
msgid ""
"\"I see my magnificent rival will stop at nothing, even at stealing the "
"servants of {mf|his|her} enemy. Let us see if your fools are even more "
"useless than mine! Draw your swords! And cover my retreat!\""
msgstr ""
"\"내 경쟁자는 {mf|그의|그녀의}아무것도 하지 못하는군. 너네 멍청이들이 내것보다 멍청한지 보자! 칼을 뽑아라! 내 후퇴로를 막아!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldSycamoreDungeon_FirstLevel/Objects/Object_RootsDoorDescription_String
msgctxt "72485d5c-5bc5-4603-be39-d7cc27e03814"
msgid "Sycamore Hall"
msgstr "시카모어 회관"

#. Mechanics/Blueprints/World/Dialogs/c11/OldSycamoreOutdoor/Barks/Bark_FrighteningWispIntroBark2_String
msgctxt "1df08ee0-3f79-47d9-ad6b-4e64073742ef"
msgid "\"Your fear tastes so delicious!\""
msgstr "\"정말 맛있는 공포로구나!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldSycamoreOutdoor/Barks/Bark_FrighteningWispIntro_String
msgctxt "67968b5e-d39c-4ef4-92d9-6780d8d01c4a"
msgid "\"Your fear tastes so delicious!\""
msgstr "\"정말 맛있는 공포로구나!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldSycamoreOutdoor/Barks/Dialogue_AdventurerSuppliesBarks_WhatToBark1_String
msgctxt "c5487bf5-c33a-436c-94b6-f91a22d55068"
msgid "There are enough supplies to encamp once."
msgstr "한 번 야영하기에 충분한 물자가 있습니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OldSycamoreOutdoor/Barks/Dialogue_AdventurerSuppliesBarks_WhatToBark2_String
msgctxt "5868e0a3-6d96-451d-80da-64b62639b06b"
msgid "Your supplies are all but exhausted. You've not enough to set up camp."
msgstr "당신의 소모품은 모두 소모되어 있습니다. 야영지를 세우기에는 부족합니다."

#. Mechanics/Blueprints/World/Dialogs/c11/OldSycamoreOutdoor/Barks/HiddenChest_Mite1_String
msgctxt "eaea33aa-c375-4ddd-8b4c-ea8c962ffcf4"
msgid "\"Hide it! Queen Bdaah never find!\""
msgstr "\"숨겨! 브다 여왕은 절대 찾지 못할 거야!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldSycamoreOutdoor/Barks/HiddenChest_Mite2_String
msgctxt "d061a97f-661d-4df3-9841-5f770e7a01f6"
msgid "\"Treasure heavy!\""
msgstr "\"무거운 보물인데!\""

#. Mechanics/Blueprints/World/Dialogs/c11/OldSycamoreOutdoor/Barks/HiddenChest_MiteAttack_String
msgctxt "b69ff349-3d07-4ae3-8857-224cf6b650cc"
msgid "\"Aiii! Protect treasure!\""
msgstr "\"아아아아! 보물을 지켜라!\""

